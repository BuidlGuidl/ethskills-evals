node_modules/

# executor workspaces are machine-local; records, diffs and transcripts are committed
artifacts/**/workspace/

# repo-shaped runs snapshot the whole scaffold into output/; the result.yaml is the
# record, not hundreds of unchanged boilerplate files
artifacts/**/output/

*.tsbuildinfo
.DS_Store

# yarn berry local state (this repo's; template .yarn dirs are versioned)
/.yarn/

# executor transcripts: AGENTS.md lists these as gitignored alongside workspaces,
# but no rule matched them, so a run that saved one could commit it by accident
artifacts/**/transcript.*
artifacts/**/executor.stderr
