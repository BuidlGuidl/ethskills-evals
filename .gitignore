node_modules/

# workspaces live outside the repo now (see lib/workspace.ts); this keeps runs made by
# older versions of the harness, which put them here, out of git
artifacts/**/workspace/

# and this keeps a repo-internal EVAL_WORKSPACE_ROOT out of it
/.workspaces/

# CODEX_HOME for every codex the harness spawns (lib/codex-home.ts): machine-local state,
# a generated config.toml and a symlink to the operator's live credential. Safe to delete.
/.codex-home/

# machine-local pointer at the workspace: an absolute path carrying the operator's home dir,
# and always dangling for anyone else since verify deletes what it points at
artifacts/**/workspace.path

# raw capture of both streams; transcript.md is assembled from them and is the committed
# transcript. claude puts the session on stdout as stream-json, codex puts it on stderr and
# leaves only the final message on stdout — hence three names for one thing.
artifacts/**/transcript.jsonl
artifacts/**/transcript.log
artifacts/**/executor.err

# a bare task has no template to diff against, so verify snapshots the whole workspace into
# output/: one answer.md for a quiz, a scaffolded tree of hundreds of files for a goal
# (noir-goal-001: 176 files, 760K). Where the snapshot IS the graded deliverable and small,
# force-add it (git add -f) and it stays tracked. See AGENTS.md "What gets committed".
artifacts/**/output/

# the results site is its own yarn project; its install and build stay out of git, and
# index.json is a regenerable view of what artifacts/, tasks/ and reports/ already say.
# site/derived.json is NOT ignored on purpose: it holds the facts that live only in git
# history, and the deploy host clones one branch shallowly and cannot look them up.
site/node_modules/
site/dist/
site/public/index.json
site/.yarn/

# `vercel link` drops the project and org ids here
.vercel/

*.tsbuildinfo
.DS_Store

# yarn berry local state (this repo's; template .yarn dirs are versioned)
/.yarn/
/.pnp.cjs
/.pnp.loader.mjs
