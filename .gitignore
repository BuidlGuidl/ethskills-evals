# executor workspaces are machine-local; the records, evidence and transcripts beside them
# are committed
artifacts/**/workspace/

# raw executor capture, both streams; transcript.md is assembled from them and is the
# committed transcript. claude puts the session on stdout as stream-json, codex puts it
# on stderr and leaves only the final message on stdout — hence three names for one thing.
artifacts/**/transcript.jsonl
artifacts/**/transcript.log
artifacts/**/executor.stderr

