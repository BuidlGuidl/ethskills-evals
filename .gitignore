node_modules/

# executor workspaces are machine-local; records, diffs and transcripts are committed
artifacts/**/workspace/
artifacts/**/executor.err

# the rendered transcript.md is the committed record; the raw stream-json it was
# rendered from is a machine-local intermediate (6.8M for one benchmark)
artifacts/**/transcript.jsonl

# template-seeded runs snapshot the whole scaffold into output/; run.diff is the record
# there, not hundreds of unchanged boilerplate files. Bare-workspace runs have no scaffold:
# their output/ IS the graded deliverable and the only material the judge saw, so those are
# force-added (git add -f) and stay tracked. See AGENTS.md "What gets committed".
artifacts/**/output/

*.tsbuildinfo
.DS_Store

# yarn berry local state (this repo's; template .yarn dirs are versioned)
/.yarn/
/.pnp.cjs
/.pnp.loader.mjs
