node_modules/

# executor workspaces are machine-local; the records, evidence and transcripts beside them
# are committed
artifacts/**/workspace/
artifacts/**/executor.err

# raw executor capture (~1.5MB per run); transcript.md rendered beside it is the
# committed transcript (tool calls, final message, run stats)
artifacts/**/transcript.jsonl
artifacts/**/transcript.log

# a bare task has no template to diff against, so verify snapshots the whole workspace into
# output/: one answer.md for a quiz, a scaffolded tree of hundreds of files for a goal
# (noir-goal-001: 176 files, 760K). Where the snapshot IS the graded deliverable and small,
# force-add it (git add -f) and it stays tracked. See AGENTS.md "What gets committed".
artifacts/**/output/

*.tsbuildinfo
.DS_Store

# yarn berry local state (this repo's; template .yarn dirs are versioned)
/.yarn/
/.pnp.cjs
/.pnp.loader.mjs
