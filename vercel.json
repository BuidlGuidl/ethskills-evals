{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "yarn install --immutable",
  "buildCommand": "yarn build-index --strict && cd site && yarn install --immutable && yarn build",
  "outputDirectory": "site/dist",
  "framework": null,
  "redirects": [
    { "source": "/", "destination": "/evals", "permanent": false }
  ],
  "rewrites": [
    { "source": "/evals/:path*", "destination": "/evals/index.html" }
  ]
}
