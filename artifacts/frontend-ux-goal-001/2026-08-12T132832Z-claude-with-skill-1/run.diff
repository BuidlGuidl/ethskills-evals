index 0000000..31bd0b0
--- /dev/null
+++ b/packages/hardhat/contracts/Staker.sol
@@ -0,0 +1,75 @@
+//SPDX-License-Identifier: MIT
+pragma solidity 0.8.30;
+
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { SafeERC20 } from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+
+/**
+ * @title Staker
+ * @notice Minimal USDC staking vault. Deposit USDC, withdraw any part of your position at any time.
+ * @dev No rewards, no lockup, no owner and no upgrade path: the contract can only ever move tokens
+ * that a user deposited, back to that same user (or an address they name at withdrawal time).
+ *
+ * Accounting assumes the staked token transfers the exact amount requested — true for USDC, which
+ * has no transfer fee and no rebasing. Deploy against a different token at your own risk.
+ */
+contract Staker {
+    using SafeERC20 for IERC20;
+
+    /// @notice The staked token. USDC on Base; a 6-decimal mock on local dev chains.
+    IERC20 public immutable usdc;
+
+    /// @notice Amount of `usdc` each account currently has staked, in USDC base units (6 decimals).
+    mapping(address account => uint256 amount) public stakedBalance;
+
+    /// @notice Sum of all `stakedBalance` entries.
+    uint256 public totalStaked;
+
+    event Staked(address indexed account, uint256 amount);
+    event Withdrawn(address indexed account, address indexed to, uint256 amount);
+
+    error ZeroAmount();
+    error ZeroAddress();
+    error InsufficientStake(uint256 requested, uint256 staked);
+
+    constructor(IERC20 _usdc) {
+        if (address(_usdc) == address(0)) revert ZeroAddress();
+        usdc = _usdc;
+    }
+
+    /**
+     * @notice Stake `amount` of USDC. Caller must have approved this contract for at least `amount`.
+     * @param amount Amount in USDC base units (6 decimals).
+     */
+    function stake(uint256 amount) external {
+        if (amount == 0) revert ZeroAmount();
+
+        stakedBalance[msg.sender] += amount;
+        totalStaked += amount;
+
+        emit Staked(msg.sender, amount);
+        usdc.safeTransferFrom(msg.sender, address(this), amount);
+    }
+
+    /**
+     * @notice Withdraw part or all of the caller's position. Always available; there is no lockup.
+     * @param amount Amount in USDC base units (6 decimals).
+     * @param to Recipient of the tokens. Pass your own address for a normal withdrawal.
+     */
+    function withdraw(uint256 amount, address to) external {
+        if (amount == 0) revert ZeroAmount();
+        if (to == address(0)) revert ZeroAddress();
+
+        uint256 staked = stakedBalance[msg.sender];
+        if (amount > staked) revert InsufficientStake(amount, staked);
+
+        // Balances drop before the transfer, so a hostile token cannot re-enter and double-spend.
+        unchecked {
+            stakedBalance[msg.sender] = staked - amount;
+            totalStaked -= amount;
+        }
+
+        emit Withdrawn(msg.sender, to, amount);
+        usdc.safeTransfer(to, amount);
+    }
+}
