@@ -0,0 +1,23 @@
+//SPDX-License-Identifier: MIT
+pragma solidity 0.8.30;
+
+import { ERC20 } from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+
+/**
+ * @title MockUSDC
+ * @notice Stand-in for USDC on local development chains. Matches the real token where the app can
+ * tell the difference: same name, same symbol, and 6 decimals rather than the ERC20 default of 18.
+ * @dev `mint` is unpermissioned so any local account can fund itself. The deploy script refuses to
+ * deploy this on a live network — see `deploy/01_deploy_staker.ts`.
+ */
+contract MockUSDC is ERC20 {
+    constructor() ERC20("USD Coin", "USDC") {}
+
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    function mint(address to, uint256 amount) external {
+        _mint(to, amount);
+    }
+}
