+        </div>
+        <span style={{ fontSize: 52, fontWeight: 700, letterSpacing: -1 }}>{APP_NAME}</span>
+      </div>
+
+      <div style={{ display: "flex", flexDirection: "column", gap: 20 }}>
+        <span style={{ fontSize: 84, fontWeight: 700, letterSpacing: -2, lineHeight: 1.05 }}>{APP_TAGLINE}</span>
