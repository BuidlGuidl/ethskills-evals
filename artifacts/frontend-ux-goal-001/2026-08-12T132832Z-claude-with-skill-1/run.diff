diff --git a/packages/nextjs/utils/usdc.ts b/packages/nextjs/utils/usdc.ts
new file mode 100644
index 0000000..72332d7
--- /dev/null
+++ b/packages/nextjs/utils/usdc.ts
@@ -0,0 +1,61 @@
+import { formatUnits, parseUnits } from "viem";
+
+/** USDC uses 6 decimals, not the ERC20 default of 18. Every raw value in this app is in base units. */
+export const USDC_DECIMALS = 6;
+export const USDC_SYMBOL = "USDC";
+
+const usdcFormatter = new Intl.NumberFormat("en-US", {
+  minimumFractionDigits: 2,
+  maximumFractionDigits: USDC_DECIMALS,
+});
+
+const usdFormatter = new Intl.NumberFormat("en-US", {
+  style: "currency",
+  currency: "USD",
+  minimumFractionDigits: 2,
+  maximumFractionDigits: 2,
+});
+
+const ethFormatter = new Intl.NumberFormat("en-US", {
+  minimumFractionDigits: 4,
+  maximumFractionDigits: 5,
+});
+
+export const formatUsdc = (value: bigint) => usdcFormatter.format(Number(formatUnits(value, USDC_DECIMALS)));
+
+export const formatUsd = (value: number) => usdFormatter.format(value);
+
+export const formatEth = (value: bigint) => {
+  const asNumber = Number(formatUnits(value, 18));
+  if (asNumber > 0 && asNumber < 0.00001) return "<0.00001";
+  return ethFormatter.format(asNumber);
+};
+
+/** USDC base units multiplied by a USD price, as a plain number for display. */
+export const usdcToUsd = (value: bigint, price: number) => Number(formatUnits(value, USDC_DECIMALS)) * price;
+
+export const weiToUsd = (value: bigint, price: number) => Number(formatUnits(value, 18)) * price;
+
+export type ParsedAmount = { amount: bigint; error?: undefined } | { amount?: undefined; error: string };
+
+/**
+ * Turns raw user input into USDC base units, or into the reason it can't be used. Callers are
+ * responsible for the balance check, which needs context this function doesn't have.
+ */
+export const parseUsdcInput = (input: string): ParsedAmount => {
+  const trimmed = input.trim();
+  if (!trimmed) return { error: "Enter an amount" };
+  if (!/^\d*\.?\d*$/.test(trimmed)) return { error: "Enter a plain number, e.g. 250.50" };
+
+  const [, fraction = ""] = trimmed.split(".");
+  if (fraction.length > USDC_DECIMALS) {
+    return { error: `USDC has ${USDC_DECIMALS} decimals — trim the digits after the decimal point` };
+  }
+
+  const amount = parseUnits(trimmed, USDC_DECIMALS);
+  if (amount === 0n) return { error: "Enter an amount greater than zero" };
+  return { amount };
+};
+
+/** Fills the amount field from a balance without losing precision to a float round-trip. */
+export const toUsdcInputValue = (value: bigint) => formatUnits(value, USDC_DECIMALS);

