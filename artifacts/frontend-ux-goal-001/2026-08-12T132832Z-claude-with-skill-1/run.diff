@@ -0,0 +1,114 @@
+"use client";
+
+import { ReactNode } from "react";
+import { FiatValue } from "./FiatValue";
+import { useFetchNativeCurrencyPrice } from "@scaffold-ui/hooks";
+import { Chain } from "viem";
+import { useUsdcPrice } from "~~/hooks/useUsdcPrice";
+import { USDC_SYMBOL, formatEth, formatUsdc, usdcToUsd, weiToUsd } from "~~/utils/usdc";
+
+type PositionOverviewProps = {
+  stakedBalance?: bigint;
+  walletUsdcBalance?: bigint;
+  ethBalance?: bigint;
+  isConnected: boolean;
+  targetNetwork: Chain;
+};
+
+const Tile = ({
+  label,
+  hint,
+  amount,
+  symbol,
+  fiat,
+  isConnected,
+}: {
+  label: string;
+  hint: string;
+  amount?: string;
+  symbol: string;
+  fiat: ReactNode;
+  isConnected: boolean;
+}) => (
+  <div className="flex flex-col gap-1 rounded-box bg-base-100 border border-base-300 p-5">
+    <span className="text-xs uppercase tracking-wide text-base-content/60">{label}</span>
+    {!isConnected ? (
+      <span className="text-2xl font-semibold text-base-content/40">—</span>
+    ) : amount === undefined ? (
+      <span className="h-8 w-28 animate-pulse rounded bg-base-300" />
+    ) : (
+      <span className="text-2xl font-semibold leading-8 break-all">
+        {amount} <span className="text-base font-normal text-base-content/60">{symbol}</span>
+      </span>
+    )}
+    {!isConnected ? (
+      <span className="text-xs text-base-content/50">{hint}</span>
+    ) : amount === undefined ? (
+      <span className="h-4 w-20 animate-pulse rounded bg-base-300" />
+    ) : (
+      fiat
+    )}
+  </div>
+);
+
+export const PositionOverview = ({
+  stakedBalance,
+  walletUsdcBalance,
+  ethBalance,
+  isConnected,
+  targetNetwork,
+}: PositionOverviewProps) => {
+  const usdcPrice = useUsdcPrice();
+  const {
+    price: nativeCurrencyPrice,
+    isLoading: isNativePriceLoading,
+    isError: isNativePriceError,
+  } = useFetchNativeCurrencyPrice(targetNetwork);
+
+  const hasNativePrice = nativeCurrencyPrice > 0;
+  const nativeSymbol = targetNetwork.nativeCurrency.symbol;
+
+  const usdcFiat = (value?: bigint) => (
+    <FiatValue
+      usd={value !== undefined && usdcPrice.price !== undefined ? usdcToUsd(value, usdcPrice.price) : undefined}
+      isLoading={usdcPrice.isLoading}
+      isUnavailable={usdcPrice.isUnavailable}
+      isStale={usdcPrice.isStale}
+    />
+  );
+
+  return (
+    <div className="grid gap-4 sm:grid-cols-3">
+      <Tile
+        label="Your staked position"
+        hint="Connect to see your position"
+        amount={stakedBalance !== undefined ? formatUsdc(stakedBalance) : undefined}
+        symbol={USDC_SYMBOL}
+        fiat={usdcFiat(stakedBalance)}
+        isConnected={isConnected}
+      />
+      <Tile
+        label={`Wallet ${USDC_SYMBOL}`}
+        hint="Connect to see your balance"
+        amount={walletUsdcBalance !== undefined ? formatUsdc(walletUsdcBalance) : undefined}
+        symbol={USDC_SYMBOL}
+        fiat={usdcFiat(walletUsdcBalance)}
+        isConnected={isConnected}
+      />
+      <Tile
+        label={`${nativeSymbol} for gas`}
+        hint="Connect to see your balance"
+        amount={ethBalance !== undefined ? formatEth(ethBalance) : undefined}
+        symbol={nativeSymbol}
+        fiat={
+          <FiatValue
+            usd={ethBalance !== undefined && hasNativePrice ? weiToUsd(ethBalance, nativeCurrencyPrice) : undefined}
+            isLoading={isNativePriceLoading}
+            isUnavailable={isNativePriceError || !hasNativePrice}
+          />
+        }
+        isConnected={isConnected}
+      />
+    </div>
+  );
+};
