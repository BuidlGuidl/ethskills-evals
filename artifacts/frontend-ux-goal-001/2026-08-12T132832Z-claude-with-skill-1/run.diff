diff --git a/packages/nextjs/app/stake/_components/StakeForm.tsx b/packages/nextjs/app/stake/_components/StakeForm.tsx
new file mode 100644
index 0000000..3890612
--- /dev/null
+++ b/packages/nextjs/app/stake/_components/StakeForm.tsx
@@ -0,0 +1,121 @@
+"use client";
+
+import { useState } from "react";
+import { AmountField } from "./AmountField";
+import { TransactionGate } from "./TransactionGate";
+import { erc20Abi } from "viem";
+import { useWriteContract } from "wagmi";
+import { useScaffoldWriteContract, useTransactor } from "~~/hooks/scaffold-eth";
+import { useStakerPosition } from "~~/hooks/useStakerPosition";
+import { getParsedError } from "~~/utils/scaffold-eth";
+import { USDC_SYMBOL, formatUsdc, parseUsdcInput } from "~~/utils/usdc";
+
+export const StakeForm = ({ position }: { position: ReturnType<typeof useStakerPosition> }) => {
+  const { usdcAddress, stakerAddress, walletUsdcBalance, allowance, targetNetwork, refetchPosition } = position;
+
+  const [input, setInput] = useState("");
+  // Which of the two steps is in flight, so the label can't flip mid-transaction when the allowance
+  // read lands before the button is released.
+  const [pendingAction, setPendingAction] = useState<"approve" | "stake">();
+  const [error, setError] = useState<string>();
+  const isBusy = pendingAction !== undefined;
+
+  const writeTx = useTransactor();
+  const { writeContractAsync: writeErc20Async } = useWriteContract();
+  const { writeContractAsync: writeStakerAsync } = useScaffoldWriteContract({ contractName: "Staker" });
+
+  const parsed = parseUsdcInput(input);
+  const amount = parsed.amount;
+  const exceedsBalance = amount !== undefined && walletUsdcBalance !== undefined && amount > walletUsdcBalance;
+
+  const validationError = !input.trim()
+    ? undefined
+    : (parsed.error ?? (exceedsBalance ? "More than this wallet holds" : undefined));
+
+  // Allowance comes from a fresh onchain read, so a stale local "approved" flag can never strand the
+  // user on a Stake button that reverts.
+  const needsApproval = amount !== undefined && !validationError && allowance !== undefined && allowance < amount;
+  // `allowance === undefined` means the read hasn't landed yet; submitting now could pick the wrong
+  // of the two steps, so wait for it.
+  const canSubmit =
+    amount !== undefined && !validationError && allowance !== undefined && Boolean(usdcAddress && stakerAddress);
+
+  const run = async (action: "approve" | "stake", send: () => Promise<unknown>) => {
+    setError(undefined);
+    setPendingAction(action);
+    try {
+      await send();
+      // Held until the reads behind the button agree with the chain, not just until the receipt.
+      await refetchPosition();
+      return true;
+    } catch (e) {
+      setError(getParsedError(e));
+      return false;
+    } finally {
+      setPendingAction(undefined);
+    }
+  };
+
+  const handleApprove = () =>
+    run("approve", () =>
+      writeTx(() =>
+        writeErc20Async({
+          chainId: targetNetwork.id,
+          address: usdcAddress!,
+          abi: erc20Abi,
+          functionName: "approve",
+          args: [stakerAddress!, amount!],
+        }),
+      ),
+    );
+
+  const handleStake = async () => {
+    const succeeded = await run("stake", () => writeStakerAsync({ functionName: "stake", args: [amount!] }));
+    if (succeeded) setInput("");
+  };
+
+  return (
+    <div className="flex flex-col gap-4">
+      <AmountField
+        label="Amount to stake"
+        availableLabel="Wallet balance"
+        available={walletUsdcBalance}
+        value={input}
+        onChange={setInput}
+        amount={validationError ? undefined : amount}
+        error={validationError}
+        disabled={isBusy}
+      />
+
+      <TransactionGate>
+        <button
+          type="button"
+          className="btn btn-primary w-full"
+          disabled={!canSubmit || isBusy}
+          onClick={needsApproval ? handleApprove : handleStake}
+        >
+          {isBusy && <span className="loading loading-spinner loading-xs" />}
+          {pendingAction === "approve"
+            ? "Approving…"
+            : pendingAction === "stake"
+              ? "Staking…"
+              : needsApproval
+                ? `Approve ${formatUsdc(amount!)} ${USDC_SYMBOL}`
+                : `Stake ${amount !== undefined && !validationError ? `${formatUsdc(amount)} ${USDC_SYMBOL}` : USDC_SYMBOL}`}
+        </button>
+      </TransactionGate>
+
+      {needsApproval && !isBusy && (
+        <p className="m-0 text-xs text-base-content/60">
+          One-time approval for exactly this amount. You&apos;ll confirm the stake in a second transaction.
+        </p>
+      )}
+
+      {error && (
+        <div role="alert" className="alert alert-error text-sm">
+          <span className="whitespace-pre-wrap">{error}</span>
+        </div>
+      )}
+    </div>
+  );
+};
diff --git a/packages/nextjs/app/stake/_components/TransactionGate.tsx b/packages/nextjs/app/stake/_components/TransactionGate.tsx
new file mode 100644
index 0000000..b81bb40
--- /dev/null
+++ b/packages/nextjs/app/stake/_components/TransactionGate.tsx
@@ -0,0 +1,46 @@
+"use client";
+
+import { ReactNode } from "react";
+import { useConnectModal } from "@rainbow-me/rainbowkit";
+import { useAccount, useSwitchChain } from "wagmi";
+import { useTargetNetwork } from "~~/hooks/scaffold-eth";
+
+/**
+ * Keeps a single primary action on screen: connect, then switch network, then whatever the form
+ * wants to do. Rendering all three at once is how people end up clicking a dead Stake button.
+ */
+export const TransactionGate = ({ children }: { children: ReactNode }) => {
+  const { isConnected, chainId } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+  const { openConnectModal } = useConnectModal();
+  const { switchChain, isPending: isSwitching } = useSwitchChain();
+
+  if (!isConnected) {
+    return (
+      <button type="button" className="btn btn-primary w-full" disabled={!openConnectModal} onClick={openConnectModal}>
+        Connect wallet
+      </button>
+    );
+  }
+
+  if (chainId !== targetNetwork.id) {
+    return (
+      <div className="flex flex-col gap-2">
+        <button
+          type="button"
+          className="btn btn-primary w-full"
+          disabled={isSwitching}
+          onClick={() => switchChain({ chainId: targetNetwork.id })}
+        >
+          {isSwitching && <span className="loading loading-spinner loading-xs" />}
+          Switch to {targetNetwork.name}
+        </button>
+        <p className="m-0 text-xs text-base-content/60">
+          Your wallet is on another network. Vaulted only holds positions on {targetNetwork.name}.
+        </p>
+      </div>
+    );
+  }
+
+  return <>{children}</>;
+};
diff --git a/packages/nextjs/app/stake/_components/WithdrawForm.tsx b/packages/nextjs/app/stake/_components/WithdrawForm.tsx
new file mode 100644
index 0000000..ba8a728
--- /dev/null
+++ b/packages/nextjs/app/stake/_components/WithdrawForm.tsx
@@ -0,0 +1,134 @@
+"use client";
+
+import { useState } from "react";
+import { AmountField } from "./AmountField";
+import { TransactionGate } from "./TransactionGate";
+import { Address, AddressInput } from "@scaffold-ui/components";
+import { isENS, useAddressInput } from "@scaffold-ui/hooks";
+import { isAddress } from "viem";
+import { useScaffoldWriteContract } from "~~/hooks/scaffold-eth";
+import { useStakerPosition } from "~~/hooks/useStakerPosition";
+import { getParsedError } from "~~/utils/scaffold-eth";
+import { USDC_SYMBOL, formatUsdc, parseUsdcInput } from "~~/utils/usdc";
+
+export const WithdrawForm = ({ position }: { position: ReturnType<typeof useStakerPosition> }) => {
+  const { connectedAddress, stakedBalance, targetNetwork, refetchPosition } = position;
+
+  const [input, setInput] = useState("");
+  const [sendElsewhere, setSendElsewhere] = useState(false);
+  const [recipientInput, setRecipientInput] = useState("");
+  const [isBusy, setIsBusy] = useState(false);
+  const [error, setError] = useState<string>();
+
+  const { writeContractAsync: writeStakerAsync } = useScaffoldWriteContract({ contractName: "Staker" });
+
+  // AddressInput writes the resolved address back into its value, so anything that survives
+  // `isAddress` here is what we submit — the name itself never reaches the contract call.
+  const { isEnsAddressLoading } = useAddressInput({ value: recipientInput });
+  const resolvedRecipient = isAddress(recipientInput) ? recipientInput : undefined;
+  const recipient = sendElsewhere ? resolvedRecipient : connectedAddress;
+
+  const recipientError = (() => {
+    if (!sendElsewhere || resolvedRecipient !== undefined || isEnsAddressLoading) return undefined;
+    if (!recipientInput.trim()) return "Enter the address to withdraw to";
+    if (isENS(recipientInput)) return `We couldn't resolve ${recipientInput} to an address`;
+    return "Enter an Ethereum address or an ENS name";
+  })();
+
+  const parsed = parseUsdcInput(input);
+  const amount = parsed.amount;
+  const exceedsPosition = amount !== undefined && stakedBalance !== undefined && amount > stakedBalance;
+
+  const validationError = !input.trim()
+    ? undefined
+    : (parsed.error ?? (exceedsPosition ? "More than your staked position" : undefined));
+
+  const canSubmit = amount !== undefined && !validationError && Boolean(recipient);
+
+  const handleWithdraw = async () => {
+    setError(undefined);
+    setIsBusy(true);
+    try {
+      await writeStakerAsync({ functionName: "withdraw", args: [amount!, recipient!] });
+      await refetchPosition();
+      setInput("");
+    } catch (e) {
+      setError(getParsedError(e));
+    } finally {
+      setIsBusy(false);
+    }
+  };
+
+  return (
+    <div className="flex flex-col gap-4">
+      <AmountField
+        label="Amount to withdraw"
+        availableLabel="Staked"
+        available={stakedBalance}
+        value={input}
+        onChange={setInput}
+        amount={validationError ? undefined : amount}
+        error={validationError}
+        disabled={isBusy}
+      />
+
+      <div className="flex flex-col gap-2">
+        <label className="flex cursor-pointer items-center gap-2 text-sm">
+          <input
+            type="checkbox"
+            className="checkbox checkbox-sm"
+            checked={sendElsewhere}
+            disabled={isBusy}
+            onChange={event => {
+              setSendElsewhere(event.target.checked);
+              setRecipientInput("");
+            }}
+          />
+          Withdraw to a different address
+        </label>
+
+        {sendElsewhere && (
+          <>
+            <AddressInput
+              value={recipientInput}
+              onChange={setRecipientInput}
+              placeholder="0x… or an ENS name"
+              disabled={isBusy}
+            />
+            {isEnsAddressLoading && <span className="text-xs text-base-content/60">Resolving name…</span>}
+            {recipientError && <span className="text-xs text-error">{recipientError}</span>}
+          </>
+        )}
+
+        <div className="flex flex-wrap items-center gap-2 text-xs text-base-content/60">
+          <span>Funds go to</span>
+          {recipient ? (
+            <Address address={recipient} chain={targetNetwork} size="xs" />
+          ) : (
+            <span>{sendElsewhere ? "the address above, once it resolves" : "your connected wallet"}</span>
+          )}
+        </div>
+      </div>
+
+      <TransactionGate>
+        <button
+          type="button"
+          className="btn btn-primary w-full"
+          disabled={!canSubmit || isBusy}
+          onClick={handleWithdraw}
+        >
+          {isBusy && <span className="loading loading-spinner loading-xs" />}
+          {isBusy
+            ? "Withdrawing…"
+            : `Withdraw ${amount !== undefined ? `${formatUsdc(amount)} ${USDC_SYMBOL}` : USDC_SYMBOL}`}
+        </button>
+      </TransactionGate>
+
+      {error && (
+        <div role="alert" className="alert alert-error text-sm">
+          <span className="whitespace-pre-wrap">{error}</span>
+        </div>
+      )}
+    </div>
+  );
+};
