+++ b/packages/hardhat/deploy/01_deploy_staker.ts
@@ -0,0 +1,61 @@
+import { artifacts, deployScript } from "../rocketh/deploy.js";
+import { parseUnits } from "viem";
+import { base, baseSepolia, hardhat } from "viem/chains";
+
+/**
+ * Canonical USDC (Circle-issued) per chain. Any chain listed here uses the real token; anything else
+ * must be a local dev chain, where a MockUSDC is deployed instead.
+ */
+const USDC_BY_CHAIN_ID: Record<number, `0x${string}`> = {
+  [base.id]: "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
+  [baseSepolia.id]: "0x036CbD53842c5426634e7929541eC2318f3dCF7e",
+};
+
+/** Chains where deploying an unpermissioned mintable token is acceptable. */
+const LOCAL_CHAIN_IDS = [hardhat.id, 1337];
+
+/** Handed out to the deployer on local chains so there is something to stake immediately. */
+const LOCAL_MINT_AMOUNT = parseUnits("1000000", 6);
+
+export default deployScript(
+  async env => {
+    const { deployer } = env.namedAccounts;
+    const chainId = env.network.chain.id;
+
+    let usdcAddress = USDC_BY_CHAIN_ID[chainId];
+
+    if (!usdcAddress) {
+      if (!LOCAL_CHAIN_IDS.includes(chainId)) {
+        throw new Error(
+          `No USDC address known for chain ${chainId}. Add it to USDC_BY_CHAIN_ID before deploying — ` +
+            `MockUSDC has an open mint and must never reach a live network.`,
+        );
+      }
+
+      const mockUsdc = await env.deploy("MockUSDC", {
+        account: deployer,
+        artifact: artifacts.MockUSDC,
+        args: [],
+      });
+      usdcAddress = mockUsdc.address;
+
+      await env.execute(mockUsdc, {
+        functionName: "mint",
+        args: [deployer, LOCAL_MINT_AMOUNT],
+        account: deployer,
+      });
+      console.log("🪙 Deployed MockUSDC and minted 1,000,000 USDC to the deployer");
+    }
+
+    const staker = await env.deploy("Staker", {
+      account: deployer,
+      artifact: artifacts.Staker,
+      args: [usdcAddress],
+    });
+
+    console.log("🏦 Staker deployed at", staker.address, "staking USDC at", usdcAddress);
+  },
+  {
+    tags: ["Staker"],
+  },
+);
diff --git a/packages/hardhat/test/Staker.ts b/packages/hardhat/test/Staker.ts
new file mode 100644
index 0000000..caef65d
--- /dev/null
+++ b/packages/hardhat/test/Staker.ts
@@ -0,0 +1,109 @@
+import { expect } from "chai";
+import { parseUnits } from "viem";
+import { network } from "hardhat";
+import type { Abi_MockUSDC } from "../generated/abis/MockUSDC.js";
+import type { Abi_Staker } from "../generated/abis/Staker.js";
+import { loadAndExecuteDeploymentsFromFiles } from "../rocketh/environment.js";
+
+const { provider, networkHelpers, ethers } = await network.create();
+
+const usdc = (amount: string) => parseUnits(amount, 6);
+
+async function deployFixture() {
+  const env = await loadAndExecuteDeploymentsFromFiles({ provider });
+  const stakerDeployment = env.get<Abi_Staker>("Staker");
+  const usdcDeployment = env.get<Abi_MockUSDC>("MockUSDC");
+
+  const staker = await ethers.getContractAt(stakerDeployment.abi, stakerDeployment.address);
+  const token = await ethers.getContractAt(usdcDeployment.abi, usdcDeployment.address);
+
+  const [deployer, alice, bob] = await ethers.getSigners();
+  await token.mint(alice.address, usdc("1000"));
+  await token.connect(alice).approve(stakerDeployment.address, ethers.MaxUint256);
+
+  return { staker, token, stakerAddress: stakerDeployment.address, deployer, alice, bob };
+}
+
+describe("Staker", function () {
+  it("stakes against the token it was deployed with", async function () {
+    const { staker, token } = await networkHelpers.loadFixture(deployFixture);
+    expect(await staker.usdc()).to.equal(ethers.getAddress(await token.getAddress()));
+    expect(await token.decimals()).to.equal(6);
+  });
+
+  it("moves tokens in and credits the position", async function () {
+    const { staker, token, stakerAddress, alice } = await networkHelpers.loadFixture(deployFixture);
+
+    await expect(staker.connect(alice).stake(usdc("250")))
+      .to.emit(staker, "Staked")
+      .withArgs(alice.address, usdc("250"));
+
+    expect(await staker.stakedBalance(alice.address)).to.equal(usdc("250"));
+    expect(await staker.totalStaked()).to.equal(usdc("250"));
+    expect(await token.balanceOf(stakerAddress)).to.equal(usdc("250"));
+    expect(await token.balanceOf(alice.address)).to.equal(usdc("750"));
+  });
+
+  it("lets a staker withdraw the full position at any time", async function () {
+    const { staker, token, stakerAddress, alice } = await networkHelpers.loadFixture(deployFixture);
+    await staker.connect(alice).stake(usdc("250"));
+
+    await expect(staker.connect(alice).withdraw(usdc("250"), alice.address))
+      .to.emit(staker, "Withdrawn")
+      .withArgs(alice.address, alice.address, usdc("250"));
+
+    expect(await staker.stakedBalance(alice.address)).to.equal(0);
+    expect(await staker.totalStaked()).to.equal(0);
+    expect(await token.balanceOf(stakerAddress)).to.equal(0);
+    expect(await token.balanceOf(alice.address)).to.equal(usdc("1000"));
+  });
+
+  it("supports partial withdrawals and withdrawing to another address", async function () {
+    const { staker, token, alice, bob } = await networkHelpers.loadFixture(deployFixture);
+    await staker.connect(alice).stake(usdc("250"));
+
+    await staker.connect(alice).withdraw(usdc("100"), bob.address);
+
+    expect(await staker.stakedBalance(alice.address)).to.equal(usdc("150"));
+    expect(await token.balanceOf(bob.address)).to.equal(usdc("100"));
+  });
+
+  it("keeps positions separate between accounts", async function () {
+    const { staker, token, stakerAddress, alice, bob } = await networkHelpers.loadFixture(deployFixture);
+    await token.mint(bob.address, usdc("500"));
+    await token.connect(bob).approve(stakerAddress, ethers.MaxUint256);
+
+    await staker.connect(alice).stake(usdc("250"));
+    await staker.connect(bob).stake(usdc("500"));
+
+    await expect(staker.connect(bob).withdraw(usdc("501"), bob.address))
+      .to.be.revertedWithCustomError(staker, "InsufficientStake")
+      .withArgs(usdc("501"), usdc("500"));
+
+    await staker.connect(bob).withdraw(usdc("500"), bob.address);
+    expect(await staker.stakedBalance(alice.address)).to.equal(usdc("250"));
+    expect(await token.balanceOf(stakerAddress)).to.equal(usdc("250"));
+  });
+
+  it("rejects zero amounts and the zero recipient", async function () {
+    const { staker, alice } = await networkHelpers.loadFixture(deployFixture);
+    await staker.connect(alice).stake(usdc("10"));
+
+    await expect(staker.connect(alice).stake(0)).to.be.revertedWithCustomError(staker, "ZeroAmount");
+    await expect(staker.connect(alice).withdraw(0, alice.address)).to.be.revertedWithCustomError(staker, "ZeroAmount");
+    await expect(staker.connect(alice).withdraw(usdc("10"), ethers.ZeroAddress)).to.be.revertedWithCustomError(
+      staker,
+      "ZeroAddress",
+    );
+  });
+
+  it("reverts when the staker has not approved enough USDC", async function () {
+    const { staker, token, stakerAddress, alice } = await networkHelpers.loadFixture(deployFixture);
+    await token.connect(alice).approve(stakerAddress, usdc("10"));
+
+    await expect(staker.connect(alice).stake(usdc("11"))).to.be.revertedWithCustomError(
+      token,
+      "ERC20InsufficientAllowance",
+    );
+  });
+});
