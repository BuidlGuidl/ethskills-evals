@@ -0,0 +1,78 @@
+"use client";
+
+import { FiatValue } from "./FiatValue";
+import { BaseInput } from "@scaffold-ui/components";
+import { useUsdcPrice } from "~~/hooks/useUsdcPrice";
+import { USDC_SYMBOL, formatUsdc, toUsdcInputValue, usdcToUsd } from "~~/utils/usdc";
+
+type AmountFieldProps = {
+  label: string;
+  availableLabel: string;
+  available?: bigint;
+  value: string;
+  onChange: (value: string) => void;
+  /** Parsed value of `value`, or undefined while the input is empty or unusable. */
+  amount?: bigint;
+  error?: string;
+  disabled?: boolean;
+};
+
+export const AmountField = ({
+  label,
+  availableLabel,
+  available,
+  value,
+  onChange,
+  amount,
+  error,
+  disabled,
+}: AmountFieldProps) => {
+  const usdcPrice = useUsdcPrice();
+
+  return (
+    // BaseInput doesn't take an id, so the group carries the accessible name instead of a `for=` label.
+    <div className="flex flex-col gap-2" role="group" aria-label={label}>
+      <div className="flex items-baseline justify-between gap-2">
+        <span className="text-sm font-medium">{label}</span>
+        <span className="text-xs text-base-content/60">
+          {availableLabel}: {available === undefined ? "—" : `${formatUsdc(available)} ${USDC_SYMBOL}`}
+        </span>
+      </div>
+
+      <BaseInput
+        name="amount"
+        value={value}
+        onChange={onChange}
+        placeholder="0.00"
+        disabled={disabled}
+        error={Boolean(error)}
+        suffix={
+          <div className="flex items-center gap-1 pr-2">
+            <span className="text-sm text-base-content/60">{USDC_SYMBOL}</span>
+            <button
+              type="button"
+              className="btn btn-xs btn-ghost"
+              disabled={disabled || available === undefined || available === 0n}
+              onClick={() => available !== undefined && onChange(toUsdcInputValue(available))}
+            >
+              Max
+            </button>
+          </div>
+        }
+      />
+
+      <div className="flex min-h-5 items-baseline justify-between gap-2">
+        {error ? (
+          <span className="text-xs text-error">{error}</span>
+        ) : amount === undefined ? null : (
+          <FiatValue
+            usd={usdcPrice.price !== undefined ? usdcToUsd(amount, usdcPrice.price) : undefined}
+            isLoading={usdcPrice.isLoading}
+            isUnavailable={usdcPrice.isUnavailable}
+            isStale={usdcPrice.isStale}
+          />
+        )}
+      </div>
+    </div>
+  );
+};
