diff --git a/packages/nextjs/hooks/useStakerPosition.ts b/packages/nextjs/hooks/useStakerPosition.ts
new file mode 100644
index 0000000..bc716d2
--- /dev/null
+++ b/packages/nextjs/hooks/useStakerPosition.ts
@@ -0,0 +1,79 @@
+"use client";
+
+import { useCallback } from "react";
+import { useWatchBalance } from "@scaffold-ui/hooks";
+import { Address, erc20Abi, zeroAddress } from "viem";
+import { useAccount, useReadContract } from "wagmi";
+import { useDeployedContractInfo, useScaffoldReadContract, useTargetNetwork } from "~~/hooks/scaffold-eth";
+import scaffoldConfig from "~~/scaffold.config";
+
+/**
+ * Everything the stake page needs to read about the connected account, in one place so the stake and
+ * withdraw forms always agree and can refresh each other after a transaction.
+ *
+ * The token address comes off the deployed Staker rather than a hardcoded constant: whatever that
+ * contract was deployed against is the only token the UI can usefully approve and stake.
+ */
+export const useStakerPosition = () => {
+  const { address: connectedAddress } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+
+  const { data: staker, isLoading: isStakerLoading } = useDeployedContractInfo({ contractName: "Staker" });
+  const stakerAddress = staker?.address;
+
+  const { data: usdcAddressData } = useScaffoldReadContract({ contractName: "Staker", functionName: "usdc" });
+  const usdcAddress = usdcAddressData as Address | undefined;
+
+  const { data: stakedBalance, refetch: refetchStakedBalance } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "stakedBalance",
+    args: [connectedAddress],
+  });
+
+  const erc20Query = {
+    enabled: Boolean(connectedAddress && usdcAddress),
+    refetchInterval: scaffoldConfig.pollingInterval,
+  };
+
+  const { data: walletUsdcBalance, refetch: refetchWalletUsdcBalance } = useReadContract({
+    chainId: targetNetwork.id,
+    address: usdcAddress,
+    abi: erc20Abi,
+    functionName: "balanceOf",
+    args: [connectedAddress ?? zeroAddress],
+    query: erc20Query,
+  });
+
+  const { data: allowance, refetch: refetchAllowance } = useReadContract({
+    chainId: targetNetwork.id,
+    address: usdcAddress,
+    abi: erc20Abi,
+    functionName: "allowance",
+    args: [connectedAddress ?? zeroAddress, stakerAddress ?? zeroAddress],
+    query: { ...erc20Query, enabled: erc20Query.enabled && Boolean(stakerAddress) },
+  });
+
+  const { data: ethBalance, refetch: refetchEthBalance } = useWatchBalance({
+    address: connectedAddress,
+    chain: targetNetwork,
+  });
+
+  /** Awaited by the forms so a button stays busy until the numbers on screen are the post-tx ones. */
+  const refetchPosition = useCallback(async () => {
+    await Promise.all([refetchStakedBalance(), refetchWalletUsdcBalance(), refetchAllowance(), refetchEthBalance()]);
+  }, [refetchStakedBalance, refetchWalletUsdcBalance, refetchAllowance, refetchEthBalance]);
+
+  return {
+    connectedAddress,
+    targetNetwork,
+    stakerAddress,
+    usdcAddress,
+    isStakerLoading,
+    isStakerDeployed: Boolean(stakerAddress),
+    stakedBalance: stakedBalance as bigint | undefined,
+    walletUsdcBalance,
+    allowance,
+    ethBalance: ethBalance?.value,
+    refetchPosition,
+  };
+};
diff --git a/packages/nextjs/hooks/useUsdcPrice.ts b/packages/nextjs/hooks/useUsdcPrice.ts
new file mode 100644
index 0000000..379ed55
--- /dev/null
+++ b/packages/nextjs/hooks/useUsdcPrice.ts
@@ -0,0 +1,39 @@
+import { useQuery } from "@tanstack/react-query";
+
+const USDC_SPOT_PRICE_URL = "https://api.coinbase.com/v2/prices/USDC-USD/spot";
+const REFETCH_INTERVAL_MS = 60_000;
+
+/**
+ * USDC/USD spot price from Coinbase. USDC tracks the dollar but does not always equal it, and during
+ * a depeg the difference is the whole story — so the number shown to users comes from a real feed
+ * rather than a hardcoded 1.00.
+ *
+ * `isStale` means we have a price but the latest refresh failed; the UI should say so rather than
+ * present an old number as current.
+ */
+export const useUsdcPrice = () => {
+  const { data, isPending, isError, isSuccess } = useQuery({
+    queryKey: ["usdcSpotPrice"],
+    queryFn: async () => {
+      const response = await fetch(USDC_SPOT_PRICE_URL);
+      if (!response.ok) throw new Error(`USDC price request failed with status ${response.status}`);
+
+      const body = await response.json();
+      const price = Number(body?.data?.amount);
+      if (!Number.isFinite(price) || price <= 0) throw new Error("USDC price feed returned an unusable value");
+
+      return price;
+    },
+    staleTime: REFETCH_INTERVAL_MS,
+    refetchInterval: REFETCH_INTERVAL_MS,
+    retry: 2,
+  });
+
+  return {
+    price: data,
+    isLoading: isPending,
+    isUnavailable: isError && data === undefined,
+    isStale: isError && data !== undefined,
+    isSuccess,
+  };
+};
