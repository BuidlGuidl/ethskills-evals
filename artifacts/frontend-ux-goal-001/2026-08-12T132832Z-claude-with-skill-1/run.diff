+"use client";
+
+import { useState } from "react";
+import { PositionOverview } from "./PositionOverview";
+import { StakeForm } from "./StakeForm";
+import { WithdrawForm } from "./WithdrawForm";
+import { ExclamationTriangleIcon } from "@heroicons/react/24/outline";
+import { useStakerPosition } from "~~/hooks/useStakerPosition";
+
+type Tab = "stake" | "withdraw";
+
+export const StakeDashboard = () => {
+  const position = useStakerPosition();
+  const [tab, setTab] = useState<Tab>("stake");
+
+  const { connectedAddress, targetNetwork, ethBalance, isStakerLoading, isStakerDeployed } = position;
+  const isConnected = Boolean(connectedAddress);
+  const hasNoGas = isConnected && ethBalance === 0n;
+  const nativeSymbol = targetNetwork.nativeCurrency.symbol;
+
+  return (
+    <div className="mx-auto flex w-full max-w-3xl flex-col gap-6 px-4 py-10">
+      <header className="flex flex-col gap-2">
+        <div className="flex flex-wrap items-center gap-3">
+          <h1 className="m-0 text-3xl font-bold">Stake USDC</h1>
+          <span className="badge badge-outline badge-sm">{targetNetwork.name}</span>
+        </div>
+        <p className="m-0 text-base-content/70">
+          Deposit USDC into the vault and take it back out whenever you want. No lockup, no rewards, no fees — your
+          position is always exactly what you put in.
+        </p>
+      </header>
+
+      {!isStakerLoading && !isStakerDeployed && (
+        <div role="alert" className="alert alert-warning">
+          <ExclamationTriangleIcon className="h-5 w-5 shrink-0" />
+          <div>
+            <p className="m-0 font-medium">The vault isn&apos;t live on {targetNetwork.name} yet.</p>
+            <p className="m-0 text-sm">
+              Nothing can be staked or withdrawn from this network. Deploy the Staker contract with{" "}
+              <code className="text-xs">yarn deploy --network base</code> and this page picks it up automatically.
+            </p>
+          </div>
+        </div>
+      )}
+
+      {hasNoGas && (
+        <div role="alert" className="alert alert-warning">
+          <ExclamationTriangleIcon className="h-5 w-5 shrink-0" />
+          <span>
+            This wallet has no {nativeSymbol} on {targetNetwork.name}, so transactions can&apos;t pay for gas. Bridge or
+            buy a small amount before staking.
+          </span>
+        </div>
+      )}
+
+      <PositionOverview
+        stakedBalance={position.stakedBalance}
+        walletUsdcBalance={position.walletUsdcBalance}
