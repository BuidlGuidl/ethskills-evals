@@ -0,0 +1,27 @@
+import { formatUsd } from "~~/utils/usdc";
+
+type FiatValueProps = {
+  usd?: number;
+  isLoading?: boolean;
+  isUnavailable?: boolean;
+  isStale?: boolean;
+};
+
+/**
+ * The dollar value under a token amount. A missing or stale price is labelled rather than dropped —
+ * silently showing nothing reads as "this is worth nothing".
+ */
+export const FiatValue = ({ usd, isLoading, isUnavailable, isStale }: FiatValueProps) => {
+  if (isLoading) return <span className="text-xs text-base-content/50">Fetching USD price…</span>;
+
+  if (isUnavailable || usd === undefined) {
+    return <span className="text-xs text-base-content/50">USD value unavailable</span>;
+  }
+
+  return (
+    <span className="text-xs text-base-content/60">
+      ≈ {formatUsd(usd)}
+      {isStale && <span className="text-warning"> · price may be stale</span>}
+    </span>
+  );
+};
