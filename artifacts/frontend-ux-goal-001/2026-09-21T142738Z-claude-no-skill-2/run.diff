@@ -0,0 +1,42 @@
+import { deployScript, artifacts } from "../rocketh/deploy.js";
+
+// Canonical Circle-issued USDC on Base mainnet
+const BASE_CHAIN_ID = 8453;
+const BASE_USDC = "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913";
+
+const LOCAL_CHAIN_IDS = [31337];
+
+/**
+ * Deploys Staker. On Base it points at real USDC; on a local chain it first deploys MockUSDC.
+ * Any other network is refused so a Staker never gets bound to the wrong token.
+ */
+export default deployScript(
+  async env => {
+    const { deployer } = env.namedAccounts;
+    const chainId = env.network.chain.id;
+
+    let usdcAddress: `0x${string}`;
+    if (chainId === BASE_CHAIN_ID) {
+      usdcAddress = BASE_USDC;
+    } else if (LOCAL_CHAIN_IDS.includes(chainId)) {
+      const mockUsdc = await env.deploy("MockUSDC", {
+        account: deployer,
+        artifact: artifacts.MockUSDC,
+        args: [],
+      });
+      usdcAddress = mockUsdc.address;
+    } else {
+      throw new Error(`Staker: no USDC address configured for chain ${chainId}`);
+    }
+
+    const staker = await env.deploy("Staker", {
+      account: deployer,
+      artifact: artifacts.Staker,
+      args: [usdcAddress],
+    });
+    console.log(`🏦 Staker deployed at ${staker.address} (token ${usdcAddress})`);
+  },
+  {
+    tags: ["Staker"],
+  },
+);
