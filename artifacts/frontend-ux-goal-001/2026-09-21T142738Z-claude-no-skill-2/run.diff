index 0000000..5e706fb
--- /dev/null
+++ b/packages/nextjs/app/stake/_components/StakeDashboard.tsx
@@ -0,0 +1,246 @@
+"use client";
+
+import { useState } from "react";
+import { Balance } from "@scaffold-ui/components";
+import { Address, erc20Abi, formatUnits, parseAbi, parseUnits } from "viem";
+import { hardhat } from "viem/chains";
+import { useBalance, useReadContracts, useWriteContract } from "wagmi";
+import {
+  useScaffoldReadContract,
+  useScaffoldWriteContract,
+  useTargetNetwork,
+  useTransactor,
+} from "~~/hooks/scaffold-eth";
+import scaffoldConfig from "~~/scaffold.config";
+
+// USDC uses 6 decimals on every chain (and MockUSDC mirrors that)
+const USDC_DECIMALS = 6;
+const AMOUNT_REGEX = new RegExp(`^\\d*\\.?\\d{0,${USDC_DECIMALS}}$`);
+const LOCAL_MINT_AMOUNT = parseUnits("1000", USDC_DECIMALS);
+const MOCK_USDC_MINT_ABI = parseAbi(["function mint(address to, uint256 amount)"]);
+
+const formatUsdc = (value: bigint) => {
+  const [whole, fraction = ""] = formatUnits(value, USDC_DECIMALS).split(".");
+  return `${BigInt(whole).toLocaleString("en-US")}.${fraction.padEnd(2, "0")}`;
+};
+
+type StakeStep = "idle" | "approving" | "staking";
+
+type StakeDashboardProps = {
+  account: Address;
+  stakerAddress: Address;
+};
+
+export const StakeDashboard = ({ account, stakerAddress }: StakeDashboardProps) => {
+  const { targetNetwork } = useTargetNetwork();
+  const [amountInput, setAmountInput] = useState("");
+  const [stakeStep, setStakeStep] = useState<StakeStep>("idle");
+
+  // Read the token from the Staker itself so the UI can never approve a different token than the one it pulls
+  const { data: tokenAddress } = useScaffoldReadContract({ contractName: "Staker", functionName: "token" });
+  const { data: stakedBalance, refetch: refetchStaked } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "stakedBalance",
+    args: [account],
+  });
+  const { data: totalStaked } = useScaffoldReadContract({ contractName: "Staker", functionName: "totalStaked" });
+
+  const { data: tokenData, refetch: refetchToken } = useReadContracts({
+    contracts: [
+      { address: tokenAddress, abi: erc20Abi, functionName: "balanceOf", args: [account] },
+      { address: tokenAddress, abi: erc20Abi, functionName: "allowance", args: [account, stakerAddress] },
+    ],
+    allowFailure: false,
+    query: { enabled: Boolean(tokenAddress), refetchInterval: scaffoldConfig.pollingInterval },
+  });
+  const [usdcBalance, allowance] = tokenData ?? [];
+
+  const { data: ethBalance } = useBalance({
+    address: account,
+    query: { refetchInterval: scaffoldConfig.pollingInterval },
+  });
+
+  const { writeContractAsync: writeToken, isPending: isTokenTxPending } = useWriteContract();
+  const writeTx = useTransactor();
+  const { writeContractAsync: writeStaker, isMining: isStakerTxPending } = useScaffoldWriteContract({
+    contractName: "Staker",
+  });
+
+  const amount = amountInput && amountInput !== "." ? parseUnits(amountInput, USDC_DECIMALS) : 0n;
+  const needsApproval = allowance !== undefined && allowance < amount;
+  const isBusy = stakeStep !== "idle" || isTokenTxPending || isStakerTxPending;
+  const isLoadingBalances = usdcBalance === undefined || stakedBalance === undefined;
+
+  let amountError: string | undefined;
+  if (usdcBalance !== undefined && amount > usdcBalance) amountError = "Amount exceeds your USDC balance";
+
+  const refetchAll = () => Promise.all([refetchToken(), refetchStaked()]);
+
+  const handleAmountChange = (value: string) => {
+    if (AMOUNT_REGEX.test(value)) setAmountInput(value);
+  };
+
+  const handleStake = async () => {
+    if (!tokenAddress || amount === 0n || amountError) return;
+    try {
+      if (needsApproval) {
+        setStakeStep("approving");
+        // Approve exactly the amount being staked — no lingering unlimited allowance
+        await writeTx(() =>
+          writeToken({
+            address: tokenAddress,
+            abi: erc20Abi,
+            functionName: "approve",
+            args: [stakerAddress, amount],
+          }),
+        );
+      }
+      setStakeStep("staking");
+      await writeStaker({ functionName: "stake", args: [amount] });
+      setAmountInput("");
+    } catch (e) {
+      // useTransactor already surfaced the error to the user
+      console.error("Stake failed", e);
+    } finally {
+      setStakeStep("idle");
+      await refetchAll();
+    }
+  };
+
+  const handleWithdraw = async () => {
+    try {
+      await writeStaker({ functionName: "withdraw" });
+    } catch (e) {
+      console.error("Withdraw failed", e);
+    } finally {
+      await refetchAll();
+    }
+  };
+
+  const handleMintTestUsdc = async () => {
+    if (!tokenAddress) return;
+    try {
+      await writeTx(() =>
+        writeToken({
+          address: tokenAddress,
+          abi: MOCK_USDC_MINT_ABI,
+          functionName: "mint",
+          args: [account, LOCAL_MINT_AMOUNT],
+        }),
+      );
+    } catch (e) {
+      console.error("Mint failed", e);
+    } finally {
+      await refetchToken();
+    }
+  };
+
+  const stakeButtonLabel = () => {
+    if (stakeStep === "approving") return "Approving USDC…";
+    if (stakeStep === "staking") return "Staking…";
+    if (amount === 0n) return "Enter an amount";
+    if (amountError) return "Insufficient USDC";
+    return needsApproval ? "Approve & stake" : "Stake";
+  };
+
+  return (
+    <>
+      <div className="stats stats-vertical sm:stats-horizontal bg-base-200 w-full">
+        <div className="stat">
+          <div className="stat-title">Staked</div>
+          <div className="stat-value text-2xl">
+            {stakedBalance === undefined ? <span className="loading loading-dots" /> : formatUsdc(stakedBalance)}
+          </div>
+          <div className="stat-desc">USDC</div>
+        </div>
+        <div className="stat">
+          <div className="stat-title">Wallet</div>
+          <div className="stat-value text-2xl">
+            {usdcBalance === undefined ? <span className="loading loading-dots" /> : formatUsdc(usdcBalance)}
+          </div>
+          <div className="stat-desc">USDC</div>
+        </div>
+      </div>
+
+      <div className="flex justify-between items-center text-sm">
+        <span className="opacity-70">Gas balance</span>
+        <Balance address={account} chain={targetNetwork} />
+      </div>
+
+      {ethBalance?.value === 0n && (
+        <div role="alert" className="alert alert-warning text-sm">
+          <span>
+            You have no ETH on {targetNetwork.name}. You need a small amount of ETH to pay network fees for staking and
+            withdrawing.
+          </span>
+        </div>
+      )}
+
+      <div className="divider my-0" />
+
+      <div className="flex flex-col gap-2">
+        <label htmlFor="stake-amount" className="flex justify-between text-sm">
+          <span className="font-medium">Amount to stake</span>
+          {usdcBalance !== undefined && (
+            <span className="opacity-70">Available: {formatUsdc(usdcBalance)} USDC</span>
+          )}
+        </label>
+        <div className="join w-full">
+          <input
+            id="stake-amount"
+            type="text"
+            inputMode="decimal"
+            autoComplete="off"
+            placeholder="0.00"
+            className={`input input-bordered join-item w-full ${amountError ? "input-error" : ""}`}
+            value={amountInput}
+            disabled={isBusy}
+            onChange={e => handleAmountChange(e.target.value.trim())}
+          />
+          <button
+            className="btn join-item"
+            disabled={isBusy || !usdcBalance}
+            onClick={() => usdcBalance !== undefined && setAmountInput(formatUnits(usdcBalance, USDC_DECIMALS))}
+          >
+            Max
+          </button>
+        </div>
+        {amountError && <span className="text-error text-sm">{amountError}</span>}
+        {needsApproval && !amountError && stakeStep === "idle" && (
+          <span className="text-sm opacity-70">
+            Staking takes two transactions: approve USDC, then stake. Your wallet will prompt you for each.
+          </span>
+        )}
+        <button
+          className="btn btn-primary w-full"
+          disabled={isBusy || isLoadingBalances || amount === 0n || Boolean(amountError)}
+          onClick={handleStake}
+        >
+          {stakeStep !== "idle" && <span className="loading loading-spinner loading-sm" />}
+          {stakeButtonLabel()}
+        </button>
+      </div>
+
+      <div className="divider my-0" />
+
+      <button
+        className="btn btn-outline w-full"
+        disabled={isBusy || !stakedBalance}
+        onClick={handleWithdraw}
+      >
+        {isStakerTxPending && stakeStep === "idle" && <span className="loading loading-spinner loading-sm" />}
+        {stakedBalance ? `Withdraw all (${formatUsdc(stakedBalance)} USDC)` : "Nothing to withdraw"}
+      </button>
+
+      {totalStaked !== undefined && (
+        <p className="text-center text-sm opacity-70 my-0">Total staked by all users: {formatUsdc(totalStaked)} USDC</p>
+      )}
+
+      {targetNetwork.id === hardhat.id && (
+        <button className="btn btn-ghost btn-sm" disabled={isBusy} onClick={handleMintTestUsdc}>
+          Mint 1,000 test USDC (local only)
+        </button>
+      )}
+    </>
+  );
+};
diff --git a/packages/nextjs/app/stake/page.tsx b/packages/nextjs/app/stake/page.tsx
new file mode 100644
index 0000000..565f7b8
--- /dev/null
+++ b/packages/nextjs/app/stake/page.tsx
@@ -0,0 +1,74 @@
+"use client";
+
+import { StakeDashboard } from "./_components/StakeDashboard";
+import { useConnectModal } from "@rainbow-me/rainbowkit";
+import type { NextPage } from "next";
+import { useAccount, useSwitchChain } from "wagmi";
+import { useDeployedContractInfo, useTargetNetwork } from "~~/hooks/scaffold-eth";
+
+const Stake: NextPage = () => {
+  const { address, chain, isConnected } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+  const { openConnectModal } = useConnectModal();
+  const { switchChain, isPending: isSwitching } = useSwitchChain();
+  const { data: stakerInfo, isLoading: isStakerLoading } = useDeployedContractInfo({ contractName: "Staker" });
+
+  const renderContent = () => {
+    if (!isConnected || !address) {
+      return (
+        <>
+          <p>Connect your wallet to stake USDC.</p>
+          <button className="btn btn-primary" onClick={openConnectModal}>
+            Connect wallet
+          </button>
+        </>
+      );
+    }
+
+    if (chain?.id !== targetNetwork.id) {
+      return (
+        <>
+          <p>Your wallet is on {chain?.name ?? "an unsupported network"}. Staking is available on {targetNetwork.name}.</p>
+          <button
+            className="btn btn-primary"
+            disabled={isSwitching}
+            onClick={() => switchChain({ chainId: targetNetwork.id })}
+          >
+            {isSwitching && <span className="loading loading-spinner loading-sm" />}
+            Switch to {targetNetwork.name}
+          </button>
+        </>
+      );
+    }
+
+    if (isStakerLoading) {
+      return <span className="loading loading-spinner loading-lg mx-auto" />;
+    }
+
+    if (!stakerInfo) {
+      return (
+        <div role="alert" className="alert alert-warning">
+          <span>Staking is not live on {targetNetwork.name} yet. Please check back soon.</span>
+        </div>
+      );
+    }
+
+    return <StakeDashboard account={address} stakerAddress={stakerInfo.address} />;
+  };
+
+  return (
+    <div className="flex flex-col items-center grow px-4 py-10">
+      <div className="w-full max-w-lg">
+        <h1 className="text-3xl font-bold mb-1">Stake USDC</h1>
+        <p className="mt-0 mb-6 opacity-70">
+          Deposit USDC and withdraw your full position at any time. Staking does not earn rewards.
+        </p>
+        <div className="card bg-base-100 shadow-xl">
+          <div className="card-body gap-4">{renderContent()}</div>
+        </div>
+      </div>
+    </div>
+  );
+};
+
+export default Stake;
