diff --git a/packages/nextjs/utils/usdc.ts b/packages/nextjs/utils/usdc.ts
new file mode 100644
index 0000000..d18bcec
--- /dev/null
+++ b/packages/nextjs/utils/usdc.ts
@@ -0,0 +1,29 @@
+import { formatUnits, parseUnits } from "viem";
+
+// Same on real Base USDC and on MockUSDC.
+export const USDC_DECIMALS = 6;
+
+const AMOUNT_REGEX = new RegExp(`^\\d*\\.?\\d{0,${USDC_DECIMALS}}$`);
+
+/** Returns true while the user is typing something that can still become a valid USDC amount. */
+export const isUsdcInput = (value: string) => AMOUNT_REGEX.test(value);
+
+/** Parses user input into base units, or undefined if it isn't a positive amount. */
+export const parseUsdc = (value: string) => {
+  if (!value || value === "." || !isUsdcInput(value)) return undefined;
+  const amount = parseUnits(value, USDC_DECIMALS);
+  return amount > 0n ? amount : undefined;
+};
+
+/** Exact, grouped USDC display: 1234567890n -> "1,234.56789". */
+export const formatUsdc = (amount: bigint) => {
+  const [whole, fraction] = formatUnits(amount, USDC_DECIMALS).split(".");
+  const grouped = BigInt(whole).toLocaleString("en-US");
+  return fraction ? `${grouped}.${fraction}` : grouped;
+};
+
+/** Plain decimal string for putting an amount back into an input. */
+export const usdcToInput = (amount: bigint) => formatUnits(amount, USDC_DECIMALS);
+
+export const formatUsd = (value: number) =>
+  value.toLocaleString("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 2 });

