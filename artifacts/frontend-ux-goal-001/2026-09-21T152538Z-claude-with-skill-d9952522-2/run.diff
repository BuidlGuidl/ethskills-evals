index 0000000..92ac88d
--- /dev/null
+++ b/packages/nextjs/hooks/stake/useUsdcPrice.ts
@@ -0,0 +1,31 @@
+import { parseAbi } from "viem";
+import { mainnet } from "viem/chains";
+import { useReadContract } from "wagmi";
+
+// Chainlink USDC / USD on Ethereum mainnet (8 decimals, 24h heartbeat).
+const USDC_USD_FEED = "0x8fFfFfd4AfB6115b954Bd326cbe7B4BA576818f6";
+const FEED_DECIMALS = 8;
+const STALE_AFTER_SECONDS = 26 * 60 * 60;
+
+const feedAbi = parseAbi([
+  "function latestRoundData() view returns (uint80 roundId, int256 answer, uint256 startedAt, uint256 updatedAt, uint80 answeredInRound)",
+]);
+
+/** USDC/USD from Chainlink. `price` is undefined when the feed can't be read. */
+export const useUsdcPrice = () => {
+  const { data, isLoading } = useReadContract({
+    address: USDC_USD_FEED,
+    abi: feedAbi,
+    functionName: "latestRoundData",
+    chainId: mainnet.id,
+    query: {
+      refetchInterval: 60_000,
+      select: ([, answer, , updatedAt]) => ({
+        price: answer > 0n ? Number(answer) / 10 ** FEED_DECIMALS : undefined,
+        isStale: Date.now() / 1000 - Number(updatedAt) > STALE_AFTER_SECONDS,
+      }),
+    },
+  });
+
+  return { price: data?.price, isStale: data?.isStale ?? false, isLoading };
+};
