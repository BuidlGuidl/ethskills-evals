diff --git a/packages/hardhat/test/Staker.ts b/packages/hardhat/test/Staker.ts
new file mode 100644
index 0000000..5d80003
--- /dev/null
+++ b/packages/hardhat/test/Staker.ts
@@ -0,0 +1,91 @@
+import { expect } from "chai";
+import { network } from "hardhat";
+import type { Abi_MockUSDC } from "../generated/abis/MockUSDC.js";
+import type { Abi_Staker } from "../generated/abis/Staker.js";
+import { loadAndExecuteDeploymentsFromFiles } from "../rocketh/environment.js";
+
+const { provider, networkHelpers, ethers } = await network.create();
+
+const usdc = (amount: string) => ethers.parseUnits(amount, 6);
+
+async function deployFixture() {
+  const env = await loadAndExecuteDeploymentsFromFiles({ provider });
+  const usdcDeployment = env.get<Abi_MockUSDC>("USDC");
+  const stakerDeployment = env.get<Abi_Staker>("Staker");
+  const token = await ethers.getContractAt(usdcDeployment.abi, usdcDeployment.address);
+  const staker = await ethers.getContractAt(stakerDeployment.abi, stakerDeployment.address);
+  const [, alice, bob] = await ethers.getSigners();
+  await token.mint(alice.address, usdc("1000"));
+  await token.mint(bob.address, usdc("1000"));
+  return { token, staker, alice, bob };
+}
+
+describe("MockUSDC", function () {
+  it("matches real USDC metadata", async function () {
+    const { token } = await networkHelpers.loadFixture(deployFixture);
+    expect(await token.name()).to.equal("USD Coin");
+    expect(await token.symbol()).to.equal("USDC");
+    expect(await token.decimals()).to.equal(6n);
+  });
+});
+
+describe("Staker", function () {
+  it("uses the deployed USDC", async function () {
+    const { token, staker } = await networkHelpers.loadFixture(deployFixture);
+    expect((await staker.token()).toLowerCase()).to.equal((await token.getAddress()).toLowerCase());
+  });
+
+  it("stakes after approval", async function () {
+    const { token, staker, alice } = await networkHelpers.loadFixture(deployFixture);
+    await token.connect(alice).approve(await staker.getAddress(), usdc("100"));
+    await expect(staker.connect(alice).stake(usdc("100")))
+      .to.emit(staker, "Staked")
+      .withArgs(alice.address, usdc("100"));
+
+    expect(await staker.balances(alice.address)).to.equal(usdc("100"));
+    expect(await staker.totalStaked()).to.equal(usdc("100"));
+    expect(await token.balanceOf(alice.address)).to.equal(usdc("900"));
+  });
+
+  it("accumulates multiple stakes", async function () {
+    const { token, staker, alice } = await networkHelpers.loadFixture(deployFixture);
+    await token.connect(alice).approve(await staker.getAddress(), usdc("300"));
+    await staker.connect(alice).stake(usdc("100"));
+    await staker.connect(alice).stake(usdc("200"));
+    expect(await staker.balances(alice.address)).to.equal(usdc("300"));
+  });
+
+  it("reverts on zero stake", async function () {
+    const { staker, alice } = await networkHelpers.loadFixture(deployFixture);
+    await expect(staker.connect(alice).stake(0)).to.be.revertedWithCustomError(staker, "ZeroAmount");
+  });
+
+  it("reverts without allowance", async function () {
+    const { token, staker, alice } = await networkHelpers.loadFixture(deployFixture);
+    await expect(staker.connect(alice).stake(usdc("1"))).to.be.revertedWithCustomError(
+      token,
+      "ERC20InsufficientAllowance",
+    );
+  });
+
+  it("withdraws the full position", async function () {
+    const { token, staker, alice, bob } = await networkHelpers.loadFixture(deployFixture);
+    const stakerAddress = await staker.getAddress();
+    await token.connect(alice).approve(stakerAddress, usdc("100"));
+    await staker.connect(alice).stake(usdc("100"));
+    await token.connect(bob).approve(stakerAddress, usdc("50"));
+    await staker.connect(bob).stake(usdc("50"));
+
+    await expect(staker.connect(alice).withdraw()).to.emit(staker, "Withdrawn").withArgs(alice.address, usdc("100"));
+
+    expect(await staker.balances(alice.address)).to.equal(0n);
+    expect(await token.balanceOf(alice.address)).to.equal(usdc("1000"));
+    expect(await staker.totalStaked()).to.equal(usdc("50"));
+    expect(await token.balanceOf(stakerAddress)).to.equal(usdc("50"));
+  });
+
+  it("reverts withdraw with nothing staked", async function () {
+    const { staker, alice } = await networkHelpers.loadFixture(deployFixture);
+    await expect(staker.connect(alice).withdraw()).to.be.revertedWithCustomError(staker, "NothingStaked");
+  });
+});
