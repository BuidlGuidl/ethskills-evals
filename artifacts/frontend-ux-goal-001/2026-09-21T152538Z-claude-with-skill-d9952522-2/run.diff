+++ b/packages/nextjs/app/stake/_components/UsdValue.tsx
@@ -0,0 +1,22 @@
+import { formatUsd } from "~~/utils/usdc";
+
+type UsdValueProps = {
+  amount?: number;
+  price?: number;
+  isStale?: boolean;
+  isLoading?: boolean;
+};
+
+/** Fiat line under a token amount. Says so explicitly when the price is missing or stale. */
+export const UsdValue = ({ amount, price, isStale, isLoading }: UsdValueProps) => {
+  if (amount === undefined) return <span className="text-sm opacity-60">&nbsp;</span>;
+  if (isLoading) return <span className="text-sm opacity-60">Loading USD price…</span>;
+  if (!price) return <span className="text-sm text-warning">USD price unavailable</span>;
+
+  return (
+    <span className="text-sm opacity-70">
+      ≈ {formatUsd(amount * price)}
+      {isStale && <span className="text-warning"> (price may be outdated)</span>}
+    </span>
+  );
+};
