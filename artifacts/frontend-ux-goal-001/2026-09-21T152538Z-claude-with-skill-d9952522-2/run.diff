+import { useState } from "react";
+import { UsdValue } from "./UsdValue";
+import { useConnectModal } from "@rainbow-me/rainbowkit";
+import { useFetchNativeCurrencyPrice } from "@scaffold-ui/hooks";
+import { formatEther, formatUnits } from "viem";
+import { useAccount, useBalance, useSwitchChain } from "wagmi";
+import {
+  useDeployedContractInfo,
+  useScaffoldReadContract,
+  useScaffoldWriteContract,
+  useTargetNetwork,
+} from "~~/hooks/scaffold-eth";
+import { useStakingToken } from "~~/hooks/stake/useStakingToken";
+import { useUsdcPrice } from "~~/hooks/stake/useUsdcPrice";
+import { getParsedError } from "~~/utils/scaffold-eth";
+import { USDC_DECIMALS, formatUsdc, isUsdcInput, parseUsdc, usdcToInput } from "~~/utils/usdc";
+
+type PendingAction = "approve" | "stake" | "withdraw";
+
+const toNumber = (amount: bigint) => Number(formatUnits(amount, USDC_DECIMALS));
+
+export const StakePanel = () => {
+  const { address, chain, isConnected } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+  const { openConnectModal } = useConnectModal();
+  const { switchChain, isPending: isSwitching } = useSwitchChain();
+  const isWrongNetwork = isConnected && chain?.id !== targetNetwork.id;
+
+  const [amountInput, setAmountInput] = useState("");
+  const [pending, setPending] = useState<PendingAction>();
+  const [stakeError, setStakeError] = useState<string>();
+  const [withdrawError, setWithdrawError] = useState<string>();
+
+  const { data: stakerInfo, isLoading: isStakerLoading } = useDeployedContractInfo({ contractName: "Staker" });
+  const stakerAddress = stakerInfo?.address;
+
+  const { balance: usdcBalance, allowance, refetch: refetchToken, approve } = useStakingToken(address, stakerAddress);
+  const { data: staked, refetch: refetchStaked } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "balances",
+    args: [address],
+  });
+  const { data: ethBalance, refetch: refetchEthBalance } = useBalance({
+    address,
+    chainId: targetNetwork.id,
+  });
+
+  const { price: usdcPrice, isStale: isUsdcPriceStale, isLoading: isUsdcPriceLoading } = useUsdcPrice();
+  const { price: ethPrice, isLoading: isEthPriceLoading } = useFetchNativeCurrencyPrice();
+
+  const { writeContractAsync: writeStaker } = useScaffoldWriteContract({ contractName: "Staker" });
+
+  const amount = parseUsdc(amountInput);
+  const hasNoGas = ethBalance !== undefined && ethBalance.value === 0n;
+  const needsApproval = amount !== undefined && allowance !== undefined && allowance < amount;
+  const exceedsBalance = amount !== undefined && usdcBalance !== undefined && amount > usdcBalance;
+
+  // Holds the button busy from click through receipt and the follow-up reads, and always releases it.
+  const run = async (
+    action: PendingAction,
+    tx: () => Promise<string | undefined>,
+    onError: (message: string) => void,
+  ) => {
+    setPending(action);
+    setStakeError(undefined);
+    setWithdrawError(undefined);
+    try {
+      // SE-2 write helpers resolve with undefined (after toasting) when nothing was sent.
+      if (!(await tx())) throw new Error("Transaction was not sent. Please try again.");
+      await Promise.all([refetchToken(), refetchStaked(), refetchEthBalance()]);
+      return true;
+    } catch (e) {
+      onError(getParsedError(e));
+      return false;
+    } finally {
+      setPending(undefined);
+    }
+  };
+
+  const handleApprove = () => amount && run("approve", () => approve(amount), setStakeError);
+
+  const handleStake = async () => {
+    if (!amount) return;
+    const ok = await run("stake", () => writeStaker({ functionName: "stake", args: [amount] }), setStakeError);
+    if (ok) setAmountInput("");
+  };
+
+  const handleWithdraw = () => run("withdraw", () => writeStaker({ functionName: "withdraw" }), setWithdrawError);
+
+  if (!isStakerLoading && !stakerInfo) {
+    return (
+      <div role="alert" className="alert alert-warning max-w-xl">
+        <span>Staking isn&apos;t available on {targetNetwork.name} yet. Please check back soon.</span>
+      </div>
+    );
+  }
+
+  const stakeHint = (() => {
+    if (!isConnected || isWrongNetwork || !amountInput) return undefined;
+    if (!amount) return "Enter an amount greater than 0.";
+    if (exceedsBalance) return "Amount exceeds your USDC balance.";
+    return undefined;
+  })();
+
+  const renderStakeButton = () => {
+    if (!isConnected) {
+      return (
+        <button className="btn btn-primary w-full" onClick={openConnectModal}>
+          Connect wallet
+        </button>
+      );
+    }
+    if (isWrongNetwork) {
+      return (
+        <button
+          className="btn btn-primary w-full"
+          disabled={isSwitching}
+          onClick={() => switchChain({ chainId: targetNetwork.id })}
+        >
+          {isSwitching && <span className="loading loading-spinner loading-sm" />}
+          Switch to {targetNetwork.name}
+        </button>
+      );
+    }
+
+    const disabled = !!pending || !amount || exceedsBalance || allowance === undefined;
+    if (needsApproval) {
+      return (
+        <button className="btn btn-primary w-full" disabled={disabled} onClick={handleApprove}>
+          {pending === "approve" && <span className="loading loading-spinner loading-sm" />}
+          {pending === "approve" ? "Approving…" : `Approve ${formatUsdc(amount)} USDC`}
+        </button>
+      );
+    }
+    return (
+      <button className="btn btn-primary w-full" disabled={disabled} onClick={handleStake}>
+        {pending === "stake" && <span className="loading loading-spinner loading-sm" />}
+        {pending === "stake" ? "Staking…" : amount ? `Stake ${formatUsdc(amount)} USDC` : "Stake"}
+      </button>
+    );
+  };
+
+  return (
+    <div className="flex flex-col gap-6 w-full max-w-xl">
+      <div className="stats stats-vertical sm:stats-horizontal bg-base-100 shadow">
+        <div className="stat">
+          <div className="stat-title">Wallet USDC</div>
+          <div className="stat-value text-2xl">{usdcBalance !== undefined ? formatUsdc(usdcBalance) : "—"}</div>
+          <div className="stat-desc">
+            <UsdValue
+              amount={usdcBalance !== undefined ? toNumber(usdcBalance) : undefined}
+              price={usdcPrice}
+              isStale={isUsdcPriceStale}
+              isLoading={isUsdcPriceLoading}
+            />
+          </div>
+        </div>
+        <div className="stat">
+          <div className="stat-title">ETH (for gas)</div>
+          <div className="stat-value text-2xl">
+            {ethBalance
+              ? Number(formatEther(ethBalance.value)).toLocaleString("en-US", { maximumFractionDigits: 6 })
+              : "—"}
+          </div>
+          <div className="stat-desc">
+            <UsdValue
+              amount={ethBalance ? Number(formatEther(ethBalance.value)) : undefined}
+              price={ethPrice}
+              isLoading={isEthPriceLoading}
+            />
+          </div>
+        </div>
+        <div className="stat">
+          <div className="stat-title">Staked USDC</div>
+          <div className="stat-value text-2xl">{staked !== undefined ? formatUsdc(staked) : "—"}</div>
+          <div className="stat-desc">
+            <UsdValue
+              amount={staked !== undefined ? toNumber(staked) : undefined}
+              price={usdcPrice}
+              isStale={isUsdcPriceStale}
+              isLoading={isUsdcPriceLoading}
+            />
+          </div>
+        </div>
+      </div>
+
+      {isConnected && !isWrongNetwork && hasNoGas && (
+        <div role="alert" className="alert alert-warning">
+          <span>
+            Your wallet has no ETH on {targetNetwork.name}. Unless your wallet sponsors gas, you&apos;ll need a small
+            amount to pay transaction fees.
+          </span>
+        </div>
+      )}
+
+      <div className="card bg-base-100 shadow">
+        <div className="card-body gap-4">
+          <h2 className="card-title">Stake USDC</h2>
+          <label className="form-control w-full">
+            <div className="join w-full">
+              <input
+                type="text"
+                inputMode="decimal"
+                placeholder="0.00"
+                className="input input-bordered join-item w-full"
+                value={amountInput}
+                disabled={!!pending}
+                onChange={e => {
+                  const value = e.target.value.replace(",", ".");
+                  if (isUsdcInput(value)) setAmountInput(value);
+                }}
+              />
+              <button
+                className="btn join-item"
+                disabled={!!pending || !usdcBalance}
+                onClick={() => usdcBalance && setAmountInput(usdcToInput(usdcBalance))}
+              >
+                Max
+              </button>
+            </div>
+            <div className="label">
+              <span className="label-text-alt">
+                <UsdValue
+                  amount={amount !== undefined ? toNumber(amount) : undefined}
+                  price={usdcPrice}
+                  isStale={isUsdcPriceStale}
+                  isLoading={isUsdcPriceLoading}
+                />
+              </span>
+            </div>
+          </label>
+          {needsApproval && !pending && (
+            <p className="text-sm opacity-70 m-0">
+              Step 1 of 2: allow the staking contract to move {formatUsdc(amount)} USDC. Then stake it.
+            </p>
+          )}
+          {renderStakeButton()}
+          {stakeHint && <p className="text-sm text-warning m-0">{stakeHint}</p>}
+          {stakeError && <p className="text-sm text-error m-0 break-words">{stakeError}</p>}
+        </div>
+      </div>
+
+      <div className="card bg-base-100 shadow">
+        <div className="card-body gap-4">
+          <h2 className="card-title">Withdraw</h2>
+          <p className="m-0 text-sm opacity-70">Withdraw your full staked position back to your wallet at any time.</p>
+          <button
+            className="btn btn-outline w-full"
+            disabled={!isConnected || isWrongNetwork || !!pending || !staked}
+            onClick={handleWithdraw}
+          >
+            {pending === "withdraw" && <span className="loading loading-spinner loading-sm" />}
+            {pending === "withdraw"
+              ? "Withdrawing…"
+              : staked
+                ? `Withdraw ${formatUsdc(staked)} USDC`
+                : "Nothing staked"}
+          </button>
+          {withdrawError && <p className="text-sm text-error m-0 break-words">{withdrawError}</p>}
+        </div>
+      </div>
+    </div>
+  );
+};
diff --git a/packages/nextjs/app/stake/_components/UsdValue.tsx b/packages/nextjs/app/stake/_components/UsdValue.tsx
