diff --git a/packages/nextjs/hooks/stake/useStakingToken.ts b/packages/nextjs/hooks/stake/useStakingToken.ts
new file mode 100644
index 0000000..51a7672
--- /dev/null
+++ b/packages/nextjs/hooks/stake/useStakingToken.ts
@@ -0,0 +1,33 @@
+import { Address, erc20Abi } from "viem";
+import { useReadContracts, useWriteContract } from "wagmi";
+import { useScaffoldReadContract, useTargetNetwork, useTransactor } from "~~/hooks/scaffold-eth";
+import scaffoldConfig from "~~/scaffold.config";
+
+/**
+ * The token the Staker accepts (USDC on Base, MockUSDC locally), read from `Staker.token()` so the
+ * frontend can never point at a different token than the contract.
+ */
+export const useStakingToken = (owner?: Address, spender?: Address) => {
+  const { targetNetwork } = useTargetNetwork();
+  const { data: tokenAddress } = useScaffoldReadContract({ contractName: "Staker", functionName: "token" });
+
+  const tokenContract = { address: tokenAddress as Address, abi: erc20Abi, chainId: targetNetwork.id } as const;
+  const { data, refetch } = useReadContracts({
+    contracts: [
+      { ...tokenContract, functionName: "balanceOf", args: [owner as Address] },
+      { ...tokenContract, functionName: "allowance", args: [owner as Address, spender as Address] },
+    ],
+    allowFailure: false,
+    query: { enabled: !!tokenAddress && !!owner && !!spender, refetchInterval: scaffoldConfig.pollingInterval },
+  });
+
+  const { writeContractAsync } = useWriteContract();
+  const writeTx = useTransactor();
+
+  const approve = (amount: bigint) =>
+    writeTx(() =>
+      writeContractAsync({ ...tokenContract, functionName: "approve", args: [spender as Address, amount] }),
+    );
+
+  return { balance: data?.[0], allowance: data?.[1], refetch, approve };
+};
diff --git a/packages/nextjs/hooks/stake/useUsdcPrice.ts b/packages/nextjs/hooks/stake/useUsdcPrice.ts
