@@ -0,0 +1,77 @@
+"use client";
+
+import { ReactNode } from "react";
+import { formatUsdc, formatUsdcExact } from "~~/utils/usdc";
+
+type PositionOverviewProps = {
+  isConnected: boolean;
+  stakedBalance?: bigint;
+  walletBalance?: bigint;
+  ethBalance?: { formatted: string; symbol: string };
+  isLowOnGas: boolean;
+  /** No vault on this network: the position can't be loaded, so don't wait on it forever. */
+  isVaultMissing: boolean;
+};
+
+type StatProps = {
+  label: string;
+  value: ReactNode;
+  hint?: string;
+  title?: string;
+  highlight?: boolean;
+};
+
+const Stat = ({ label, value, hint, title, highlight }: StatProps) => (
+  <div className={`rounded-box border p-4 ${highlight ? "border-primary/40 bg-primary/5" : "border-base-300"}`}>
+    <p className="text-xs uppercase tracking-wide text-base-content/60">{label}</p>
+    <p className="mt-1 text-xl font-semibold tabular-nums break-all" title={title}>
+      {value}
+    </p>
+    {hint && <p className="mt-0.5 text-xs text-base-content/60">{hint}</p>}
+  </div>
+);
+
+/** The three numbers a staker needs before acting: position, spendable USDC, gas money. */
+export const PositionOverview = ({
+  isConnected,
+  stakedBalance,
+  walletBalance,
+  ethBalance,
+  isLowOnGas,
+  isVaultMissing,
+}: PositionOverviewProps) => {
+  const usdc = (value?: bigint, isUnavailable = false) => {
+    if (!isConnected || isUnavailable) return "—";
+    if (value === undefined) return <span className="skeleton inline-block h-6 w-24 align-middle" />;
+    return `${formatUsdc(value)} USDC`;
+  };
+
+  return (
+    <div className="grid grid-cols-1 gap-3 sm:grid-cols-3">
+      <Stat
+        label="Your staked position"
+        value={usdc(stakedBalance, isVaultMissing)}
+        title={stakedBalance === undefined ? undefined : `${formatUsdcExact(stakedBalance)} USDC`}
+        highlight
+      />
+      <Stat
+        label="Wallet balance"
+        value={usdc(walletBalance)}
+        title={walletBalance === undefined ? undefined : `${formatUsdcExact(walletBalance)} USDC`}
+      />
+      <Stat
+        label="Gas balance"
+        value={
+          !isConnected ? (
+            "—"
+          ) : ethBalance === undefined ? (
+            <span className="skeleton inline-block h-6 w-24 align-middle" />
+          ) : (
+            `${Number(ethBalance.formatted).toFixed(4)} ${ethBalance.symbol}`
+          )
+        }
+        hint={isConnected && isLowOnGas ? "Too low to cover a transaction" : "Pays for staking transactions"}
+      />
+    </div>
+  );
+};
diff --git a/packages/nextjs/app/stake/_components/StakeForm.tsx b/packages/nextjs/app/stake/_components/StakeForm.tsx
new file mode 100644
index 0000000..851cdb3
--- /dev/null
+++ b/packages/nextjs/app/stake/_components/StakeForm.tsx
@@ -0,0 +1,109 @@
+"use client";
+
+import { useState } from "react";
+import { AmountField } from "./AmountField";
+import { Address } from "viem";
+import { useScaffoldWriteContract } from "~~/hooks/scaffold-eth";
+import { formatUsdc, parseUsdc } from "~~/utils/usdc";
+
+type StakeFormProps = {
+  walletBalance?: bigint;
+  allowance?: bigint;
+  /** The Staker, i.e. the address that has to be allowed to move the user's USDC. */
+  spender?: Address;
+  disabled?: boolean;
+  onBalancesChanged: () => void;
+};
+
+/**
+ * Staking is two transactions: approve the vault for the exact amount, then move it in.
+ * Both steps are shown up front so the second wallet prompt isn't a surprise.
+ */
+export const StakeForm = ({ walletBalance, allowance, spender, disabled, onBalancesChanged }: StakeFormProps) => {
+  const [amount, setAmount] = useState("");
+
+  const { writeContractAsync: writeUsdc, isMining: isApproving } = useScaffoldWriteContract({ contractName: "USDC" });
+  const { writeContractAsync: writeStaker, isMining: isStaking } = useScaffoldWriteContract({
+    contractName: "Staker",
+  });
+
+  const parsedAmount = parseUsdc(amount);
+  const isBusy = isApproving || isStaking;
+  const exceedsBalance = parsedAmount !== undefined && walletBalance !== undefined && parsedAmount > walletBalance;
+  const needsApproval = parsedAmount !== undefined && (allowance === undefined || allowance < parsedAmount);
+
+  const error =
+    amount !== "" && parsedAmount === undefined
+      ? "Enter an amount greater than 0"
+      : exceedsBalance && walletBalance !== undefined
+        ? `That is more than your wallet balance of ${formatUsdc(walletBalance)} USDC`
+        : undefined;
+
+  const isAmountReady = parsedAmount !== undefined && !exceedsBalance && !disabled && !isBusy;
+
+  const handleApprove = async () => {
+    if (!parsedAmount || !spender) return;
+    try {
+      await writeUsdc({ functionName: "approve", args: [spender, parsedAmount] });
+      onBalancesChanged();
+    } catch (error) {
+      console.error("Failed to approve USDC:", error);
+    }
+  };
+
+  const handleStake = async () => {
+    if (!parsedAmount) return;
+    try {
+      await writeStaker({ functionName: "stake", args: [parsedAmount] });
+      setAmount("");
+      onBalancesChanged();
+    } catch (error) {
+      console.error("Failed to stake USDC:", error);
+    }
+  };
+
+  const stepHint =
+    !parsedAmount || exceedsBalance
+      ? "Staking takes two transactions: first you approve the vault, then you stake."
+      : needsApproval
+        ? `Step 1 approves the vault for exactly ${amount} USDC. Nothing moves until step 2.`
+        : `The vault is approved for ${amount} USDC — you can stake now.`;
+
+  return (
+    <div className="flex flex-col gap-4">
+      <AmountField
+        id="stake-amount"
+        label="Amount to stake"
+        value={amount}
+        onChange={setAmount}
+        max={walletBalance}
+        maxLabel="Wallet"
+        disabled={disabled || isBusy}
+        error={error}
+      />
+
+      <div className="grid grid-cols-2 gap-3">
+        <button
+          type="button"
+          className={`btn ${needsApproval ? "btn-primary" : "btn-outline"}`}
+          disabled={!isAmountReady || !needsApproval || !spender}
+          onClick={handleApprove}
+        >
+          {isApproving && <span className="loading loading-spinner loading-xs" />}
+          {parsedAmount && !needsApproval ? "1. Approved" : "1. Approve"}
+        </button>
+        <button
+          type="button"
+          className={`btn ${needsApproval ? "btn-outline" : "btn-primary"}`}
+          disabled={!isAmountReady || needsApproval}
+          onClick={handleStake}
+        >
+          {isStaking && <span className="loading loading-spinner loading-xs" />}
+          2. Stake
+        </button>
+      </div>
+
+      <p className="text-xs text-base-content/70">{stepHint}</p>
+    </div>
+  );
+};
diff --git a/packages/nextjs/app/stake/_components/StakePanel.tsx b/packages/nextjs/app/stake/_components/StakePanel.tsx
new file mode 100644
index 0000000..7289594
--- /dev/null
+++ b/packages/nextjs/app/stake/_components/StakePanel.tsx
@@ -0,0 +1,168 @@
+"use client";
+
+import { useState } from "react";
+import { PositionOverview } from "./PositionOverview";
+import { StakeForm } from "./StakeForm";
+import { WithdrawForm } from "./WithdrawForm";
+import { Address } from "@scaffold-ui/components";
+import { useWatchBalance } from "@scaffold-ui/hooks";
+import { parseEther } from "viem";
+import { useAccount, useSwitchChain } from "wagmi";
+import { RainbowKitCustomConnectButton } from "~~/components/scaffold-eth";
+import { useDeployedContractInfo, useScaffoldReadContract, useTargetNetwork } from "~~/hooks/scaffold-eth";
+import { formatUsdc } from "~~/utils/usdc";
+
+/** Staking on Base costs a fraction of a cent; below this the user is one tx away from stuck. */
+const LOW_GAS_THRESHOLD = parseEther("0.0005");
+
+type Tab = "stake" | "withdraw";
+
+export const StakePanel = () => {
+  const [activeTab, setActiveTab] = useState<Tab>("stake");
+
+  const { address, isConnected, chain: connectedChain } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+  const { switchChain, isPending: isSwitchingChain } = useSwitchChain();
+
+  const { data: staker, isLoading: isLoadingStaker } = useDeployedContractInfo({ contractName: "Staker" });
+
+  const { data: walletBalance, refetch: refetchWalletBalance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "balanceOf",
+    args: [address],
+  });
+  const { data: stakedBalance, refetch: refetchStakedBalance } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "stakedBalance",
+    args: [address],
+  });
+  const { data: allowance, refetch: refetchAllowance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "allowance",
+    args: [address, staker?.address],
+  });
+  const { data: totalStaked } = useScaffoldReadContract({ contractName: "Staker", functionName: "totalStaked" });
+  const { data: ethBalance } = useWatchBalance({ address, chain: targetNetwork });
+
+  const refreshBalances = () => {
+    refetchWalletBalance();
+    refetchStakedBalance();
+    refetchAllowance();
+  };
+
+  // The wallet is on a chain this app was not configured for; every write would revert.
+  const isWrongNetwork = isConnected && connectedChain !== undefined && connectedChain.id !== targetNetwork.id;
+  const isVaultMissing = !isLoadingStaker && !staker;
+  const gasBalance = ethBalance?.value;
+  const isOutOfGas = gasBalance === 0n;
+  const isLowOnGas = gasBalance !== undefined && gasBalance < LOW_GAS_THRESHOLD;
+  const isFormDisabled = !isConnected || isWrongNetwork || isVaultMissing;
+
+  return (
+    <div className="flex w-full flex-col gap-5">
+      <PositionOverview
+        isConnected={isConnected}
+        stakedBalance={stakedBalance}
+        walletBalance={walletBalance}
+        ethBalance={ethBalance}
+        isLowOnGas={isLowOnGas}
+        isVaultMissing={isVaultMissing}
+      />
+
+      {isWrongNetwork && (
+        <div role="alert" className="alert alert-warning">
+          <div className="grow text-sm">
+            Your wallet is on {connectedChain?.name ?? "an unsupported network"}. Switch to {targetNetwork.name} to
+            stake.
+          </div>
+          <button
+            type="button"
+            className="btn btn-sm"
+            disabled={isSwitchingChain}
+            onClick={() => switchChain({ chainId: targetNetwork.id })}
+          >
+            {isSwitchingChain && <span className="loading loading-spinner loading-xs" />}
+            Switch to {targetNetwork.name}
+          </button>
+        </div>
+      )}
+
+      {isConnected && !isWrongNetwork && isVaultMissing && (
+        <div role="alert" className="alert alert-error text-sm">
+          The staking vault is not deployed on {targetNetwork.name} yet, so staking is unavailable here.
+        </div>
+      )}
+
+      {isConnected && !isWrongNetwork && isLowOnGas && (
+        <div role="alert" className="alert alert-warning text-sm">
+          {isOutOfGas
+            ? `You have no ${targetNetwork.nativeCurrency.symbol} on ${targetNetwork.name}. Transactions need a small amount of it for gas — top up before staking or withdrawing.`
+            : `Your ${targetNetwork.nativeCurrency.symbol} balance is low. Keep a little on ${targetNetwork.name} so you can always pay gas to withdraw.`}
+        </div>
+      )}
+
+      <div className="card border border-base-300 bg-base-100 shadow-md">
+        <div className="card-body gap-4 p-5 sm:p-6">
+          {isConnected ? (
+            <>
+              <div role="tablist" className="tabs tabs-box self-start">
+                <button
+                  role="tab"
+                  type="button"
+                  aria-selected={activeTab === "stake"}
+                  className={`tab ${activeTab === "stake" ? "tab-active" : ""}`}
+                  onClick={() => setActiveTab("stake")}
+                >
+                  Stake
+                </button>
+                <button
+                  role="tab"
+                  type="button"
+                  aria-selected={activeTab === "withdraw"}
+                  className={`tab ${activeTab === "withdraw" ? "tab-active" : ""}`}
+                  onClick={() => setActiveTab("withdraw")}
+                >
+                  Withdraw
+                </button>
+              </div>
+
+              <div role="tabpanel" aria-label={activeTab === "stake" ? "Stake" : "Withdraw"}>
+                {activeTab === "stake" ? (
+                  <StakeForm
+                    walletBalance={walletBalance}
+                    allowance={allowance}
+                    spender={staker?.address}
+                    disabled={isFormDisabled}
+                    onBalancesChanged={refreshBalances}
+                  />
+                ) : (
+                  <WithdrawForm
+                    stakedBalance={stakedBalance}
+                    disabled={isFormDisabled}
+                    onBalancesChanged={refreshBalances}
+                  />
+                )}
+              </div>
+            </>
+          ) : (
+            <div className="flex flex-col items-center gap-3 py-6 text-center">
+              <p className="text-sm text-base-content/70">
+                Connect your wallet to stake USDC and manage your position.
+              </p>
+              <RainbowKitCustomConnectButton />
+            </div>
+          )}
+        </div>
+      </div>
+
+      {staker && (
+        <div className="flex flex-wrap items-center justify-between gap-2 px-1 text-xs text-base-content/60">
+          <span className="flex items-center gap-1">
+            Vault contract: <Address address={staker.address} chain={targetNetwork} size="xs" />
+          </span>
+          <span>Total staked: {totalStaked === undefined ? "—" : `${formatUsdc(totalStaked)} USDC`}</span>
+        </div>
+      )}
+    </div>
+  );
+};
diff --git a/packages/nextjs/app/stake/_components/WithdrawForm.tsx b/packages/nextjs/app/stake/_components/WithdrawForm.tsx
