+++ b/packages/nextjs/app/stake/_components/WithdrawForm.tsx
@@ -0,0 +1,77 @@
+"use client";
+
+import { useState } from "react";
+import { AmountField } from "./AmountField";
+import { useScaffoldWriteContract } from "~~/hooks/scaffold-eth";
+import { formatUsdc, parseUsdc } from "~~/utils/usdc";
+
+type WithdrawFormProps = {
+  stakedBalance?: bigint;
+  disabled?: boolean;
+  onBalancesChanged: () => void;
+};
+
+export const WithdrawForm = ({ stakedBalance, disabled, onBalancesChanged }: WithdrawFormProps) => {
+  const [amount, setAmount] = useState("");
+
+  const { writeContractAsync: writeStaker, isMining } = useScaffoldWriteContract({ contractName: "Staker" });
+
+  const parsedAmount = parseUsdc(amount);
+  const hasPosition = stakedBalance !== undefined && stakedBalance > 0n;
+  const exceedsPosition = parsedAmount !== undefined && stakedBalance !== undefined && parsedAmount > stakedBalance;
+  const isFullWithdrawal = parsedAmount !== undefined && parsedAmount === stakedBalance;
+
+  const error =
+    amount !== "" && parsedAmount === undefined
+      ? "Enter an amount greater than 0"
+      : exceedsPosition && stakedBalance !== undefined
+        ? `You only have ${formatUsdc(stakedBalance)} USDC staked`
+        : undefined;
+
+  const handleWithdraw = async () => {
+    if (!parsedAmount) return;
+    try {
+      // withdrawAll avoids leaving dust behind if the position changed since it was read.
+      if (isFullWithdrawal) {
+        await writeStaker({ functionName: "withdrawAll" });
+      } else {
+        await writeStaker({ functionName: "withdraw", args: [parsedAmount] });
+      }
+      setAmount("");
+      onBalancesChanged();
+    } catch (error) {
+      console.error("Failed to withdraw USDC:", error);
+    }
+  };
+
+  return (
+    <div className="flex flex-col gap-4">
+      <AmountField
+        id="withdraw-amount"
+        label="Amount to withdraw"
+        value={amount}
+        onChange={setAmount}
+        max={stakedBalance}
+        maxLabel="Staked"
+        disabled={disabled || isMining || !hasPosition}
+        error={error}
+      />
+
+      <button
+        type="button"
+        className="btn btn-primary"
+        disabled={disabled || isMining || !hasPosition || parsedAmount === undefined || exceedsPosition}
+        onClick={handleWithdraw}
+      >
+        {isMining && <span className="loading loading-spinner loading-xs" />}
+        {isFullWithdrawal ? "Withdraw everything" : "Withdraw"}
+      </button>
+
+      <p className="text-xs text-base-content/70">
+        {hasPosition
+          ? "Withdrawing is a single transaction and returns your USDC straight to your wallet."
+          : "Nothing staked yet — stake some USDC first and it will show up here."}
+      </p>
+    </div>
+  );
+};
