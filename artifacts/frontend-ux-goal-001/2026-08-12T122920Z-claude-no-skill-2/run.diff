--- /dev/null
+++ b/packages/hardhat/contracts/Staker.sol
@@ -0,0 +1,83 @@
+//SPDX-License-Identifier: MIT
+pragma solidity 0.8.30;
+
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { SafeERC20 } from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+
+/**
+ * Minimal, non-custodial staking vault for a single ERC20 token (USDC on Base).
+ *
+ * Users stake tokens and can withdraw any part of their position at any time.
+ * There are no rewards, no fees, no owner and no upgrade path: whatever is staked
+ * is exactly what can be withdrawn, and nobody can move another user's funds.
+ *
+ * @author BuidlGuidl
+ */
+contract Staker {
+    using SafeERC20 for IERC20;
+
+    /// The staked token. USDC on Base, a mock with the same 6 decimals locally.
+    IERC20 public immutable token;
+
+    /// Staked amount per user, in token units (6 decimals for USDC).
+    mapping(address account => uint256 amount) public stakedBalance;
+
+    /// Sum of all staked balances. Matches the contract's token balance unless tokens are sent in directly.
+    uint256 public totalStaked;
+
+    event Staked(address indexed account, uint256 amount);
+    event Withdrawn(address indexed account, uint256 amount);
+
+    error AmountIsZero();
+    error TokenIsZeroAddress();
+    error InsufficientStakedBalance(uint256 requested, uint256 staked);
+
+    constructor(IERC20 _token) {
+        if (address(_token) == address(0)) revert TokenIsZeroAddress();
+        token = _token;
+    }
+
+    /**
+     * Pull `amount` tokens from the caller into the vault and credit their position.
+     * The caller must have approved at least `amount` on the token first.
+     */
+    function stake(uint256 amount) external {
+        if (amount == 0) revert AmountIsZero();
+
+        stakedBalance[msg.sender] += amount;
+        totalStaked += amount;
+
+        emit Staked(msg.sender, amount);
+
+        // Interactions last: state is already settled when the token contract is called.
+        token.safeTransferFrom(msg.sender, address(this), amount);
+    }
+
+    /**
+     * Withdraw `amount` from the caller's position back to their wallet.
+     */
+    function withdraw(uint256 amount) public {
+        if (amount == 0) revert AmountIsZero();
+
+        uint256 staked = stakedBalance[msg.sender];
+        if (amount > staked) revert InsufficientStakedBalance(amount, staked);
+
+        unchecked {
+            // `amount <= staked <= totalStaked`, so neither subtraction can underflow.
+            stakedBalance[msg.sender] = staked - amount;
+            totalStaked -= amount;
+        }
+
+        emit Withdrawn(msg.sender, amount);
+
+        token.safeTransfer(msg.sender, amount);
+    }
+
+    /**
+     * Withdraw the caller's entire position. Avoids the read-then-send race a UI would
+     * otherwise hit if the balance changed between quoting "max" and sending the tx.
+     */
+    function withdrawAll() external {
+        withdraw(stakedBalance[msg.sender]);
+    }
+}
