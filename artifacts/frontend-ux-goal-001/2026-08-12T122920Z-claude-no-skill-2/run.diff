+//SPDX-License-Identifier: MIT
+pragma solidity 0.8.30;
+
+import { ERC20 } from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+
+/**
+ * Local-development stand-in for USDC (0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913 on Base).
+ *
+ * Mirrors the parts of USDC an integration can observe: name, symbol, and — the one that
+ * bites people — 6 decimals instead of 18. Minting is open so any dev account can fund
+ * itself from the Debug Contracts page.
+ *
+ * Deployed only on local chains; never deploy this to a live network.
+ *
+ * Deliberately not modelled: USDC is an upgradeable proxy with a blocklist, a pause switch
+ * and EIP-2612 permit under an EIP-712 domain of its own ("USD Coin", version "2").
+ * Half-implementing permit here would hand devs signatures that don't match mainnet, so
+ * it is left out entirely.
+ *
+ * @author BuidlGuidl
+ */
+contract MockUSDC is ERC20 {
+    constructor() ERC20("USD Coin", "USDC") {}
+
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    /// Unrestricted on purpose: this is a local faucet, not a real token.
+    function mint(address to, uint256 amount) external {
+        _mint(to, amount);
+    }
+}
