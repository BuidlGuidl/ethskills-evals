+"use client";
+
+import { USDC_INPUT_REGEX, formatUsdc, formatUsdcExact } from "~~/utils/usdc";
+
+type AmountFieldProps = {
+  id: string;
+  label: string;
+  value: string;
+  onChange: (value: string) => void;
+  /** Upper bound offered by the "Max" shortcut; `undefined` while it is still loading. */
+  max?: bigint;
+  maxLabel: string;
+  disabled?: boolean;
+  error?: string;
+};
+
+/**
+ * USDC amount input. Rejects anything that isn't a plain amount with at most 6 decimals
+ * as it is typed, so the value can always be parsed without surprising the user.
+ */
+export const AmountField = ({ id, label, value, onChange, max, maxLabel, disabled, error }: AmountFieldProps) => {
+  const handleChange = (nextValue: string) => {
+    // Accept the comma decimal separator many keyboards produce.
+    const normalized = nextValue.replace(",", ".");
+    if (USDC_INPUT_REGEX.test(normalized)) onChange(normalized);
+  };
+
+  return (
+    <div className="flex flex-col gap-1.5">
+      <div className="flex items-baseline justify-between gap-2">
+        <label htmlFor={id} className="text-sm font-medium">
+          {label}
+        </label>
+        <span className="text-xs text-base-content/70">
+          {maxLabel}:{" "}
+          <span title={max === undefined ? undefined : `${formatUsdcExact(max)} USDC`}>
+            {max === undefined ? "—" : formatUsdc(max)} USDC
+          </span>
+        </span>
+      </div>
+
+      <label className={`input input-bordered flex w-full items-center gap-2 ${error ? "input-error" : ""}`}>
+        <input
+          id={id}
+          className="grow"
+          value={value}
+          onChange={event => handleChange(event.target.value)}
+          placeholder="0.00"
+          inputMode="decimal"
+          autoComplete="off"
+          disabled={disabled}
+          aria-invalid={Boolean(error)}
+          aria-describedby={error ? `${id}-error` : undefined}
+        />
+        <span className="text-sm font-medium text-base-content/70">USDC</span>
+        <button
+          type="button"
+          className="btn btn-xs btn-ghost"
+          disabled={disabled || !max}
+          onClick={() => max && onChange(formatUsdcExact(max))}
+        >
+          Max
+        </button>
+      </label>
+
+      {error && (
+        <p id={`${id}-error`} role="alert" className="text-xs text-error">
+          {error}
+        </p>
+      )}
+    </div>
+  );
+};
diff --git a/packages/nextjs/app/stake/_components/PositionOverview.tsx b/packages/nextjs/app/stake/_components/PositionOverview.tsx
new file mode 100644
