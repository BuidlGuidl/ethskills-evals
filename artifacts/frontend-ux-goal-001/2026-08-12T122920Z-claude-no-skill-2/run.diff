+++ b/packages/hardhat/test/Staker.ts
@@ -0,0 +1,175 @@
+import { expect } from "chai";
+import { network } from "hardhat";
+import { parseUnits } from "viem";
+import type { Abi_MockUSDC } from "../generated/abis/MockUSDC.js";
+import type { Abi_Staker } from "../generated/abis/Staker.js";
+import { loadAndExecuteDeploymentsFromFiles } from "../rocketh/environment.js";
+
+const { provider, networkHelpers, ethers } = await network.create();
+
+const usdc = (amount: string) => parseUnits(amount, 6);
+
+async function deployFixture() {
+  const env = await loadAndExecuteDeploymentsFromFiles({ provider });
+
+  const stakerDeployment = env.get<Abi_Staker>("Staker");
+  const usdcDeployment = env.get<Abi_MockUSDC>("USDC");
+
+  const [deployer, alice, bob] = await ethers.getSigners();
+  const staker = await ethers.getContractAt("Staker", stakerDeployment.address);
+  const token = await ethers.getContractAt("MockUSDC", usdcDeployment.address);
+
+  // Fund the test users and let the Staker pull from them.
+  for (const user of [alice, bob]) {
+    await token.mint(user.address, usdc("1000"));
+    await token.connect(user).approve(stakerDeployment.address, ethers.MaxUint256);
+  }
+
+  return { staker, token, stakerAddress: stakerDeployment.address, deployer, alice, bob };
+}
+
+describe("Staker", function () {
+  describe("Token", function () {
+    it("Should stake USDC with the same 6 decimals as the real token", async function () {
+      const { token } = await networkHelpers.loadFixture(deployFixture);
+      expect(await token.decimals()).to.equal(6);
+      expect(await token.symbol()).to.equal("USDC");
+    });
+
+    it("Should point at the deployed USDC", async function () {
+      const { staker, token } = await networkHelpers.loadFixture(deployFixture);
+      expect(await staker.token()).to.equal(ethers.getAddress(await token.getAddress()));
+    });
+
+    it("Should refuse to deploy against the zero address", async function () {
+      const stakerFactory = await ethers.getContractFactory("Staker");
+      await expect(stakerFactory.deploy(ethers.ZeroAddress)).to.be.revertedWithCustomError(
+        stakerFactory,
+        "TokenIsZeroAddress",
+      );
+    });
+  });
+
+  describe("Staking", function () {
+    it("Should move tokens into the vault and credit the staker", async function () {
+      const { staker, token, stakerAddress, alice } = await networkHelpers.loadFixture(deployFixture);
+
+      await expect(staker.connect(alice).stake(usdc("100")))
+        .to.emit(staker, "Staked")
+        .withArgs(alice.address, usdc("100"));
+
+      expect(await staker.stakedBalance(alice.address)).to.equal(usdc("100"));
+      expect(await staker.totalStaked()).to.equal(usdc("100"));
+      expect(await token.balanceOf(alice.address)).to.equal(usdc("900"));
+      expect(await token.balanceOf(stakerAddress)).to.equal(usdc("100"));
+    });
+
+    it("Should add to an existing position", async function () {
+      const { staker, alice } = await networkHelpers.loadFixture(deployFixture);
+
+      await staker.connect(alice).stake(usdc("100"));
+      await staker.connect(alice).stake(usdc("50.5"));
+
+      expect(await staker.stakedBalance(alice.address)).to.equal(usdc("150.5"));
+    });
+
+    it("Should reject a zero amount", async function () {
+      const { staker, alice } = await networkHelpers.loadFixture(deployFixture);
+      await expect(staker.connect(alice).stake(0)).to.be.revertedWithCustomError(staker, "AmountIsZero");
+    });
+
+    it("Should revert when the staker has not approved enough", async function () {
+      const { staker, token, stakerAddress, alice } = await networkHelpers.loadFixture(deployFixture);
+
+      await token.connect(alice).approve(stakerAddress, usdc("10"));
+
+      await expect(staker.connect(alice).stake(usdc("100"))).to.be.revertedWithCustomError(
+        token,
+        "ERC20InsufficientAllowance",
+      );
+    });
+
+    it("Should revert when the staker does not hold enough USDC", async function () {
+      const { staker, token, alice } = await networkHelpers.loadFixture(deployFixture);
+
+      await expect(staker.connect(alice).stake(usdc("1001"))).to.be.revertedWithCustomError(
+        token,
+        "ERC20InsufficientBalance",
+      );
+    });
+  });
+
+  describe("Withdrawing", function () {
+    it("Should return part of a position and keep the rest staked", async function () {
+      const { staker, token, alice } = await networkHelpers.loadFixture(deployFixture);
+
+      await staker.connect(alice).stake(usdc("100"));
+
+      await expect(staker.connect(alice).withdraw(usdc("40")))
+        .to.emit(staker, "Withdrawn")
+        .withArgs(alice.address, usdc("40"));
+
+      expect(await staker.stakedBalance(alice.address)).to.equal(usdc("60"));
+      expect(await staker.totalStaked()).to.equal(usdc("60"));
+      expect(await token.balanceOf(alice.address)).to.equal(usdc("940"));
+    });
+
+    it("Should return the whole position via withdrawAll", async function () {
+      const { staker, token, stakerAddress, alice } = await networkHelpers.loadFixture(deployFixture);
+
+      await staker.connect(alice).stake(usdc("250"));
+      await staker.connect(alice).withdrawAll();
+
+      expect(await staker.stakedBalance(alice.address)).to.equal(0);
+      expect(await staker.totalStaked()).to.equal(0);
+      expect(await token.balanceOf(alice.address)).to.equal(usdc("1000"));
+      expect(await token.balanceOf(stakerAddress)).to.equal(0);
+    });
+
+    it("Should reject withdrawing more than the position", async function () {
+      const { staker, alice } = await networkHelpers.loadFixture(deployFixture);
+
+      await staker.connect(alice).stake(usdc("100"));
+
+      await expect(staker.connect(alice).withdraw(usdc("100.000001")))
+        .to.be.revertedWithCustomError(staker, "InsufficientStakedBalance")
+        .withArgs(usdc("100.000001"), usdc("100"));
+    });
+
+    it("Should reject withdrawing with nothing staked", async function () {
+      const { staker, bob } = await networkHelpers.loadFixture(deployFixture);
+
+      await expect(staker.connect(bob).withdraw(usdc("1")))
+        .to.be.revertedWithCustomError(staker, "InsufficientStakedBalance")
+        .withArgs(usdc("1"), 0);
+      await expect(staker.connect(bob).withdrawAll()).to.be.revertedWithCustomError(staker, "AmountIsZero");
+    });
+
+    it("Should keep positions isolated between users", async function () {
+      const { staker, token, alice, bob } = await networkHelpers.loadFixture(deployFixture);
+
+      await staker.connect(alice).stake(usdc("100"));
+      await staker.connect(bob).stake(usdc("300"));
+
+      await staker.connect(bob).withdrawAll();
+
+      expect(await staker.stakedBalance(alice.address)).to.equal(usdc("100"));
+      expect(await staker.totalStaked()).to.equal(usdc("100"));
+      expect(await token.balanceOf(bob.address)).to.equal(usdc("1000"));
+    });
+
+    it("Should let a user withdraw their position even if the vault holds donated tokens", async function () {
+      const { staker, token, stakerAddress, alice, bob } = await networkHelpers.loadFixture(deployFixture);
+
+      await staker.connect(alice).stake(usdc("100"));
+      // Direct transfer, bypassing stake(): must not be creditable by anyone.
+      await token.connect(bob).transfer(stakerAddress, usdc("500"));
+
+      expect(await staker.stakedBalance(bob.address)).to.equal(0);
+
+      await staker.connect(alice).withdrawAll();
+      expect(await token.balanceOf(alice.address)).to.equal(usdc("1000"));
+      expect(await token.balanceOf(stakerAddress)).to.equal(usdc("500"));
+    });
+  });
+});
