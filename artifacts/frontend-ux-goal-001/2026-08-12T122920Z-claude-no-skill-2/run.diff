+import { artifacts, deployScript } from "../rocketh/deploy.js";
+
+// Canonical (native) USDC per chain. Deliberately not a full list: deploying the Staker
+// against the wrong token address is unrecoverable, so unknown chains fail loudly.
+const USDC_ADDRESSES: Record<number, `0x${string}`> = {
+  8453: "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913", // Base
+  84532: "0x036CbD53842c5426634e7929541eC2318f3dCF7e", // Base Sepolia
+};
+
+/**
+ * Deploys the Staker against USDC: the real token on live chains, the mock deployed by
+ * 00_deploy_mock_usdc.ts locally.
+ */
+export default deployScript(
+  async env => {
+    const { deployer } = env.namedAccounts;
+    const chain = env.network.chain;
+
+    const usdcAddress = USDC_ADDRESSES[chain.id] ?? env.getOrNull("USDC")?.address;
+    if (!usdcAddress) {
+      throw new Error(
+        `No USDC address known for ${chain.name} (chainId ${chain.id}). Add it to USDC_ADDRESSES in this script.`,
+      );
+    }
+
+    const staker = await env.deploy("Staker", {
+      account: deployer,
+      artifact: artifacts.Staker,
+      args: [usdcAddress],
+    });
+
+    env.showMessage(`🏦 Staker ${staker.address} stakes USDC at ${usdcAddress}`);
+  },
+  {
+    tags: ["Staker"],
+    dependencies: ["MockUSDC"],
+  },
+);
diff --git a/packages/hardhat/test/Staker.ts b/packages/hardhat/test/Staker.ts
