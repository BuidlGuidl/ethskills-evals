diff --git a/packages/nextjs/utils/usdc.ts b/packages/nextjs/utils/usdc.ts
new file mode 100644
index 0000000..972a725
--- /dev/null
+++ b/packages/nextjs/utils/usdc.ts
@@ -0,0 +1,32 @@
+import { formatUnits, parseUnits } from "viem";
+
+/** USDC uses 6 decimals on every chain, including the local mock. */
+export const USDC_DECIMALS = 6;
+
+/** What the user may type into an amount field: digits, one dot, at most 6 decimals. */
+export const USDC_INPUT_REGEX = new RegExp(`^\\d*\\.?\\d{0,${USDC_DECIMALS}}$`);
+
+/**
+ * Human-readable amount, truncated (never rounded up) so a displayed balance is always
+ * something the user actually has.
+ */
+export const formatUsdc = (value: bigint, fractionDigits = 2) => {
+  const [whole, fraction = ""] = formatUnits(value, USDC_DECIMALS).split(".");
+  const grouped = BigInt(whole).toLocaleString("en-US");
+  if (fractionDigits === 0) return grouped;
+  return `${grouped}.${fraction.padEnd(fractionDigits, "0").slice(0, fractionDigits)}`;
+};
+
+/** Full precision, for tooltips where the truncated display could be misread. */
+export const formatUsdcExact = (value: bigint) => formatUnits(value, USDC_DECIMALS);
+
+/** Parses user input into token units, or `undefined` when it isn't a usable amount. */
+export const parseUsdc = (value: string) => {
+  if (!value || !USDC_INPUT_REGEX.test(value)) return undefined;
+  try {
+    const parsed = parseUnits(value, USDC_DECIMALS);
+    return parsed > 0n ? parsed : undefined;
+  } catch {
+    return undefined;
+  }
+};

