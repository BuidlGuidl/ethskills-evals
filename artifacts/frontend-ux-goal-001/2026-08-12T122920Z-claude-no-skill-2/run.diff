+import { parseUnits } from "viem";
+import { artifacts, deployScript } from "../rocketh/deploy.js";
+
+// Chains where a mock stand-in for USDC is deployed. Everywhere else the real token is used.
+const LOCAL_CHAIN_IDS = [31337];
+
+const FAUCET_AMOUNT = parseUnits("1000000", 6);
+
+/**
+ * Deploys MockUSDC on local chains under the name "USDC", so the frontend can look up
+ * `USDC` by name on any network, and mints a starting balance to the deployer.
+ *
+ * Mint more from the Debug Contracts page: MockUSDC.mint is open to anyone.
+ */
+export default deployScript(
+  async env => {
+    if (!LOCAL_CHAIN_IDS.includes(env.network.chain.id)) {
+      env.showMessage(`ℹ️  ${env.network.chain.name} uses the real USDC, skipping the mock`);
+      return;
+    }
+
+    const { deployer } = env.namedAccounts;
+
+    const usdc = await env.deploy("USDC", {
+      account: deployer,
+      artifact: artifacts.MockUSDC,
+      args: [],
+    });
+
+    if (usdc.newlyDeployed) {
+      await env.execute(usdc, {
+        account: deployer,
+        functionName: "mint",
+        args: [deployer, FAUCET_AMOUNT],
+      });
+      env.showMessage(`💵 Minted 1,000,000 mock USDC to ${deployer}`);
+    }
+  },
+  {
+    tags: ["MockUSDC", "Staker"],
+  },
+);
