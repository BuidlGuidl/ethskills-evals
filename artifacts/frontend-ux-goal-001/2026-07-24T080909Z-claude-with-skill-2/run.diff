+//SPDX-License-Identifier: MIT
+pragma solidity >=0.8.0 <0.9.0;
+
+import { ERC20 } from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+
+/**
+ * Mock USDC for local development.
+ *
+ * Kept faithful to real USDC where it matters for the app: same name/symbol
+ * and 6 decimals (OZ's ERC20 defaults to 18). The open `mint` exists only so
+ * local accounts can grab test funds — do NOT deploy this to a live network.
+ */
+contract MockUSDC is ERC20 {
+    constructor() ERC20("USD Coin", "USDC") {}
+
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    /// Freely mint test USDC (local dev faucet).
+    function mint(address to, uint256 amount) external {
+        _mint(to, amount);
+    }
+}
