+import { deployScript, artifacts } from "../rocketh/deploy.js";
+
+/**
+ * Deploys the USDC Staker.
+ *
+ * On networks with real USDC (Base), the Staker points at it directly. On local
+ * dev chains, a faithful MockUSDC is deployed first and used as the staked token.
+ * On any other (live) chain we refuse to deploy — see the guard below — so the
+ * vault is never wired to play-money USDC in production.
+ *
+ * The mock is deployed under the name "USDC" so the frontend can reference a
+ * single `contractName: "USDC"` on every network.
+ */
+
+// Native USDC keyed by chain id (canonical — never trust network names).
+const USDC_BY_CHAIN: Record<number, string> = {
+  8453: "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913", // Base mainnet
+};
+
+// Chains where deploying a MockUSDC is acceptable (throwaway dev chains).
+const LOCAL_CHAIN_IDS = new Set([31337]);
+const LOCAL_NETWORK_NAMES = new Set(["hardhat", "localhost"]);
+
+export default deployScript(
+  async env => {
+    const { deployer } = env.namedAccounts;
+
+    const chainId = Number(env.network?.chainId);
+    const networkName = env.network?.name;
+    const isLocal = LOCAL_CHAIN_IDS.has(chainId) || (networkName ? LOCAL_NETWORK_NAMES.has(networkName) : false);
+
+    let usdcAddress = Number.isFinite(chainId) ? USDC_BY_CHAIN[chainId] : undefined;
+
+    if (!usdcAddress) {
+      // Fail closed: never wire the vault to play-money USDC on a live chain.
+      if (!isLocal) {
+        throw new Error(
+          `No known USDC for network "${networkName ?? "?"}" (chainId ${chainId}). ` +
+            `Add its token to USDC_BY_CHAIN before deploying — refusing to deploy a MockUSDC on a non-local network.`,
+        );
+      }
+      const mockUsdc = await env.deploy("USDC", {
+        account: deployer,
+        artifact: artifacts.MockUSDC,
+        args: [],
+      });
+      usdcAddress = mockUsdc.address;
+      console.log("🪙 Deployed MockUSDC at", usdcAddress);
+    } else {
+      console.log("🪙 Using native USDC at", usdcAddress);
+    }
+
+    await env.deploy("Staker", {
+      account: deployer,
+      artifact: artifacts.Staker,
+      args: [usdcAddress],
+    });
+  },
+  {
+    tags: ["Staker"],
+  },
+);
