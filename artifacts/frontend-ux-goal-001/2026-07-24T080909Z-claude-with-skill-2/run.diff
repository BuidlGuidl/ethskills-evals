+"use client";
+
+import { useEffect, useRef, useState } from "react";
+import type { NextPage } from "next";
+import { formatUnits, parseUnits } from "viem";
+import { hardhat } from "viem/chains";
+import { useAccount, useBalance, useSwitchChain } from "wagmi";
+import { useFetchNativeCurrencyPrice } from "@scaffold-ui/hooks";
+import { Address } from "@scaffold-ui/components";
+import { BanknotesIcon } from "@heroicons/react/24/outline";
+import { RainbowKitCustomConnectButton } from "~~/components/scaffold-eth";
+import {
+  useDeployedContractInfo,
+  useScaffoldReadContract,
+  useScaffoldWriteContract,
+  useTargetNetwork,
+} from "~~/hooks/scaffold-eth";
+import { getParsedError, notification } from "~~/utils/scaffold-eth";
+
+const usd = (n: number) => n.toLocaleString("en-US", { style: "currency", currency: "USD" });
+
+const token = (n: number) => n.toLocaleString("en-US", { maximumFractionDigits: 2 });
+
+const Stake: NextPage = () => {
+  const { address: connectedAddress, isConnected, chainId } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+  const { switchChain, isPending: isSwitching } = useSwitchChain();
+  const { price: ethPrice } = useFetchNativeCurrencyPrice();
+
+  const [amount, setAmount] = useState("");
+  const [isApproving, setIsApproving] = useState(false);
+  const [approveCooldown, setApproveCooldown] = useState(false);
+  const [isStaking, setIsStaking] = useState(false);
+  const [isWithdrawing, setIsWithdrawing] = useState(false);
+  const [txError, setTxError] = useState<string>();
+
+  const { data: stakerInfo } = useDeployedContractInfo({ contractName: "Staker" });
+  const stakerAddress = stakerInfo?.address;
+
+  const { data: usdcDecimals } = useScaffoldReadContract({ contractName: "USDC", functionName: "decimals" });
+  const { data: usdcSymbol } = useScaffoldReadContract({ contractName: "USDC", functionName: "symbol" });
+  const decimals = usdcDecimals ?? 6;
+  const symbol = usdcSymbol ?? "USDC";
+
+  const { data: usdcBalance, refetch: refetchUsdcBalance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "balanceOf",
+    args: [connectedAddress],
+  });
+  const { data: allowance, refetch: refetchAllowance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "allowance",
+    args: [connectedAddress, stakerAddress],
+  });
+  const { data: staked, refetch: refetchStaked } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "balanceOf",
+    args: [connectedAddress],
+  });
+  // Scope the gas balance to the network the tx will actually run on.
+  const { data: ethBalance } = useBalance({ address: connectedAddress, chainId: targetNetwork.id });
+
+  const { writeContractAsync: approveAsync } = useScaffoldWriteContract({ contractName: "USDC" });
+  const { writeContractAsync: stakerWrite } = useScaffoldWriteContract({ contractName: "Staker" });
+
+  // Clear the approval cooldown timer if the user navigates away mid-flow.
+  const cooldownTimer = useRef<ReturnType<typeof setTimeout> | undefined>(undefined);
+  useEffect(() => () => clearTimeout(cooldownTimer.current), []);
+
+  // Parse the input against USDC's real decimals.
+  let parsedAmount = 0n;
+  let amountInvalid = false;
+  try {
+    parsedAmount = amount ? parseUnits(amount, decimals) : 0n;
+  } catch {
+    amountInvalid = true;
+  }
+
+  const isWrongNetwork = isConnected && chainId !== targetNetwork.id;
+  const stakerReady = Boolean(stakerAddress);
+  const exceedsBalance = usdcBalance !== undefined && parsedAmount > usdcBalance;
+  const needsApproval = allowance !== undefined && parsedAmount > 0n && parsedAmount > allowance;
+  const amountNum = amount && !amountInvalid ? Number(formatUnits(parsedAmount, decimals)) : 0;
+
+  const refetchAll = () => {
+    refetchUsdcBalance();
+    refetchAllowance();
+    refetchStaked();
+  };
+
+  const setMax = () => {
+    if (usdcBalance !== undefined) setAmount(formatUnits(usdcBalance, decimals));
+  };
+
+  const handleApprove = async () => {
+    if (!stakerAddress) return;
+    setTxError(undefined);
+    setIsApproving(true);
+    try {
+      await approveAsync({ functionName: "approve", args: [stakerAddress, parsedAmount] });
+      // Cover the confirmation→cache gap: keep the button locked while the
+      // fresh allowance propagates, then release.
+      setApproveCooldown(true);
+      await refetchAllowance();
+      clearTimeout(cooldownTimer.current);
+      cooldownTimer.current = setTimeout(() => setApproveCooldown(false), 4000);
+    } catch (e) {
+      setTxError(getParsedError(e));
+    } finally {
+      setIsApproving(false);
+    }
+  };
+
+  const handleStake = async () => {
+    setTxError(undefined);
+    setIsStaking(true);
+    try {
+      await stakerWrite({ functionName: "stake", args: [parsedAmount] });
+      notification.success(`Staked ${token(amountNum)} ${symbol}`);
+      setAmount("");
+      refetchAll();
+    } catch (e) {
+      setTxError(getParsedError(e));
+    } finally {
+      setIsStaking(false);
+    }
+  };
+
+  const handleWithdraw = async () => {
+    setTxError(undefined);
+    setIsWithdrawing(true);
+    try {
+      await stakerWrite({ functionName: "withdraw" });
+      notification.success("Withdrew your full position");
+      refetchAll();
+    } catch (e) {
+      setTxError(getParsedError(e));
+    } finally {
+      setIsWithdrawing(false);
+    }
+  };
+
+  const usdcBalanceNum = usdcBalance !== undefined ? Number(formatUnits(usdcBalance, decimals)) : undefined;
+  const stakedNum = staked !== undefined ? Number(formatUnits(staked, decimals)) : undefined;
+  const ethNum = ethBalance ? Number(formatUnits(ethBalance.value, ethBalance.decimals)) : undefined;
+  const hasStake = staked !== undefined && staked > 0n;
+  const approveBusy = isApproving || approveCooldown;
+
+  // "—" when unavailable (disconnected / contract not on this network), "…" while loading.
+  const stat = (num: number | undefined, available = true) => {
+    if (!isConnected || !available) return { amount: "—", usd: "" };
+    if (num === undefined) return { amount: "…", usd: "" };
+    return { amount: token(num), usd: `≈ ${usd(num)}` };
+  };
+  const usdcStat = stat(usdcBalanceNum);
+  const stakedStat = stat(stakedNum, stakerReady);
+  const ethAmount = !isConnected ? "—" : ethNum === undefined ? "…" : ethNum.toFixed(4);
+  const ethUsd = !isConnected || ethNum === undefined || !ethPrice ? "" : `≈ ${usd(ethNum * ethPrice)}`;
+
+  // On local dev the only way to get test USDC is minting it.
+  const showMintHint = isConnected && !isWrongNetwork && targetNetwork.id === hardhat.id && usdcBalance === 0n;
+
+  const renderPrimaryAction = () => {
+    if (!isConnected) {
+      return (
+        <div className="flex justify-center">
+          <RainbowKitCustomConnectButton />
+        </div>
+      );
+    }
+    if (isWrongNetwork) {
+      return (
+        <button
+          className="btn btn-primary w-full"
+          disabled={isSwitching}
+          onClick={() => switchChain({ chainId: targetNetwork.id })}
+        >
+          {isSwitching ? (
+            <>
+              <span className="loading loading-spinner loading-sm" />
+              Switching...
+            </>
+          ) : (
+            `Switch to ${targetNetwork.name}`
+          )}
+        </button>
+      );
+    }
+    if (!stakerReady) {
+      return (
+        <button className="btn btn-primary w-full" disabled>
+          Staking vault not available on {targetNetwork.name}
+        </button>
+      );
+    }
+    if (amountInvalid) {
+      return (
+        <button className="btn btn-primary w-full" disabled>
+          Enter a valid amount
+        </button>
+      );
+    }
+    if (parsedAmount === 0n) {
+      return (
+        <button className="btn btn-primary w-full" disabled>
+          Enter an amount
+        </button>
+      );
+    }
+    if (exceedsBalance) {
+      return (
+        <button className="btn btn-primary w-full" disabled>
+          Insufficient {symbol} balance
+        </button>
+      );
+    }
+    if (needsApproval) {
+      return (
+        <button className="btn btn-primary w-full" disabled={approveBusy} onClick={handleApprove}>
+          {approveBusy ? (
+            <>
+              <span className="loading loading-spinner loading-sm" />
+              Approving...
+            </>
+          ) : (
+            `Approve ${symbol}`
+          )}
+        </button>
+      );
+    }
+    return (
+      <button className="btn btn-primary w-full" disabled={isStaking} onClick={handleStake}>
+        {isStaking ? (
+          <>
+            <span className="loading loading-spinner loading-sm" />
+            Staking...
+          </>
+        ) : (
+          `Stake ${symbol}`
+        )}
+      </button>
+    );
+  };
+
+  return (
+    <div className="flex flex-col items-center grow w-full px-4 py-10">
+      <div className="w-full max-w-md">
+        <div className="flex items-center gap-2 mb-2">
+          <BanknotesIcon className="h-7 w-7 text-primary" />
+          <h1 className="text-3xl font-bold m-0">Stake USDC</h1>
+        </div>
+        <p className="text-base-content/70 mt-0 mb-6">Deposit USDC and withdraw your full position anytime.</p>
+
+        {/* Balances */}
+        <div className="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-6">
+          <div className="card bg-base-100 shadow-sm border border-base-300">
+            <div className="card-body p-4">
+              <span className="text-xs uppercase tracking-wide text-base-content/60">Wallet {symbol}</span>
+              <span className="text-lg font-semibold">{usdcStat.amount}</span>
+              <span className="text-xs text-base-content/60">{usdcStat.usd}</span>
+            </div>
+          </div>
+          <div className="card bg-base-100 shadow-sm border border-base-300">
+            <div className="card-body p-4">
+              <span className="text-xs uppercase tracking-wide text-base-content/60">Staked</span>
+              <span className="text-lg font-semibold">{stakedStat.amount}</span>
+              <span className="text-xs text-base-content/60">{stakedStat.usd}</span>
+            </div>
+          </div>
+          <div className="card bg-base-100 shadow-sm border border-base-300">
+            <div className="card-body p-4">
+              <span className="text-xs uppercase tracking-wide text-base-content/60">ETH (gas)</span>
+              <span className="text-lg font-semibold">{ethAmount}</span>
+              <span className="text-xs text-base-content/60">{ethUsd}</span>
+            </div>
+          </div>
+        </div>
+
+        {/* Stake form */}
+        <div className="card bg-base-100 shadow-md border border-base-300">
+          <div className="card-body gap-4">
+            <div>
+              <div className="flex justify-between items-center mb-1">
+                <label className="text-sm font-medium">Amount to stake</label>
+                <button
+                  className="btn btn-ghost btn-xs"
+                  disabled={usdcBalance === undefined || usdcBalance === 0n}
+                  onClick={setMax}
+                >
+                  Max
+                </button>
+              </div>
+              <label className="input input-bordered flex items-center gap-2">
+                <input
+                  type="text"
+                  inputMode="decimal"
+                  placeholder="0.00"
+                  className="grow"
+                  value={amount}
+                  onChange={e => {
+                    // Allow only a decimal number.
+                    const v = e.target.value;
+                    if (v === "" || /^\d*\.?\d*$/.test(v)) setAmount(v);
+                  }}
+                />
+                <span className="text-base-content/60 font-medium">{symbol}</span>
+              </label>
+              <div className="text-xs text-base-content/60 mt-1 h-4">
+                {amount && !amountInvalid ? `≈ ${usd(amountNum)}` : ""}
+              </div>
+            </div>
+
+            {renderPrimaryAction()}
+
+            {txError && (
+              <div className="alert alert-error text-sm py-2" role="alert">
+                <span className="break-words">{txError}</span>
+              </div>
+            )}
+
+            {showMintHint && (
+              <p className="text-xs text-base-content/60 m-0">
+                No test USDC? Mint some via{" "}
+                <a href="/debug" className="link">
+                  Debug Contracts
+                </a>{" "}
+                → USDC → <code>mint</code>.
+              </p>
+            )}
+          </div>
+        </div>
+
+        {/* Withdraw */}
+        <div className="card bg-base-100 shadow-md border border-base-300 mt-4">
+          <div className="card-body gap-3">
+            <div className="flex justify-between items-baseline">
+              <span className="font-medium">Your position</span>
+              <span className="text-sm text-base-content/70">
+                {stakedStat.amount === "—" || stakedStat.amount === "…"
+                  ? stakedStat.amount
+                  : `${stakedStat.amount} ${symbol} ${stakedStat.usd}`}
+              </span>
+            </div>
+            <button
+              className="btn btn-outline btn-primary w-full"
+              disabled={!isConnected || isWrongNetwork || !hasStake || isWithdrawing}
+              onClick={handleWithdraw}
+            >
+              {isWithdrawing ? (
+                <>
+                  <span className="loading loading-spinner loading-sm" />
+                  Withdrawing...
+                </>
+              ) : (
+                "Withdraw full position"
+              )}
+            </button>
+          </div>
+        </div>
+
+        {/* Trust signal: where funds go */}
+        {stakerAddress && (
+          <div className="flex items-center justify-center gap-2 mt-4 text-sm text-base-content/60">
+            <span>Vault contract:</span>
+            <Address address={stakerAddress} size="xs" chain={targetNetwork} />
+          </div>
+        )}
+      </div>
+    </div>
+  );
+};
+
+export default Stake;
