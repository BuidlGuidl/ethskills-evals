+//SPDX-License-Identifier: MIT
+pragma solidity >=0.8.0 <0.9.0;
+
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { SafeERC20 } from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+import { ReentrancyGuard } from "@openzeppelin/contracts/utils/ReentrancyGuard.sol";
+
+/**
+ * Minimal USDC staking vault.
+ *
+ * Users deposit USDC and can withdraw their full position at any time.
+ * No rewards, no lockups, no owner privileges — the contract only ever holds
+ * what users deposited and only ever pays it back to the same depositor.
+ *
+ * Assumes a standard, non fee-on-transfer token (USDC qualifies). If a
+ * fee-on-transfer token were used, tracked balances could diverge from the
+ * amount actually received.
+ *
+ * @author BuidlGuidl
+ */
+contract Staker is ReentrancyGuard {
+    using SafeERC20 for IERC20;
+
+    /// The staked token (USDC on Base, a mock on local networks).
+    IERC20 public immutable usdc;
+
+    /// Staked balance per depositor, in USDC base units (6 decimals).
+    mapping(address => uint256) public balanceOf;
+
+    /// Total USDC currently staked across all depositors.
+    uint256 public totalStaked;
+
+    event Staked(address indexed user, uint256 amount);
+    event Withdrawn(address indexed user, uint256 amount);
+
+    error ZeroAmount();
+    error NothingStaked();
+
+    constructor(IERC20 _usdc) {
+        usdc = _usdc;
+    }
+
+    /**
+     * Deposit `amount` of USDC into the vault. Caller must have approved this
+     * contract to spend at least `amount` first.
+     */
+    function stake(uint256 amount) external nonReentrant {
+        if (amount == 0) revert ZeroAmount();
+
+        // Effects before interaction (checks-effects-interactions).
+        balanceOf[msg.sender] += amount;
+        totalStaked += amount;
+
+        usdc.safeTransferFrom(msg.sender, address(this), amount);
+
+        emit Staked(msg.sender, amount);
+    }
+
+    /**
+     * Withdraw the caller's entire staked position back to their wallet.
+     */
+    function withdraw() external nonReentrant {
+        uint256 amount = balanceOf[msg.sender];
+        if (amount == 0) revert NothingStaked();
+
+        balanceOf[msg.sender] = 0;
+        totalStaked -= amount;
+
+        usdc.safeTransfer(msg.sender, amount);
+
+        emit Withdrawn(msg.sender, amount);
+    }
+}
