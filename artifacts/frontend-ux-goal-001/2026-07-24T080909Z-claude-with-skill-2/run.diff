@@ -0,0 +1,67 @@
+import { expect } from "chai";
+import { network } from "hardhat";
+import type { Abi_Staker } from "../generated/abis/Staker.js";
+import type { Abi_MockUSDC } from "../generated/abis/MockUSDC.js";
+import { loadAndExecuteDeploymentsFromFiles } from "../rocketh/environment.js";
+
+const { provider, networkHelpers, ethers } = await network.create();
+
+const ONE_USDC = 1_000_000n; // 6 decimals
+
+async function deployFixture() {
+  const env = await loadAndExecuteDeploymentsFromFiles({ provider });
+  const staker = env.get<Abi_Staker>("Staker");
+  const usdc = env.get<Abi_MockUSDC>("USDC");
+
+  const stakerContract = await ethers.getContractAt(staker.abi, staker.address);
+  const usdcContract = await ethers.getContractAt(usdc.abi, usdc.address);
+
+  const [user] = await ethers.getSigners();
+  await usdcContract.mint(user.address, 1000n * ONE_USDC);
+
+  return { stakerContract, usdcContract, user };
+}
+
+describe("Staker", function () {
+  it("points at the mock USDC on local networks", async function () {
+    const { stakerContract, usdcContract } = await networkHelpers.loadFixture(deployFixture);
+    expect(await stakerContract.usdc()).to.equal(await usdcContract.getAddress());
+  });
+
+  it("stakes USDC after approval and tracks the position", async function () {
+    const { stakerContract, usdcContract, user } = await networkHelpers.loadFixture(deployFixture);
+    const amount = 100n * ONE_USDC;
+
+    await usdcContract.approve(await stakerContract.getAddress(), amount);
+    await expect(stakerContract.stake(amount)).to.emit(stakerContract, "Staked").withArgs(user.address, amount);
+
+    expect(await stakerContract.balanceOf(user.address)).to.equal(amount);
+    expect(await stakerContract.totalStaked()).to.equal(amount);
+    expect(await usdcContract.balanceOf(await stakerContract.getAddress())).to.equal(amount);
+  });
+
+  it("withdraws the full position back to the user", async function () {
+    const { stakerContract, usdcContract, user } = await networkHelpers.loadFixture(deployFixture);
+    const amount = 250n * ONE_USDC;
+
+    await usdcContract.approve(await stakerContract.getAddress(), amount);
+    await stakerContract.stake(amount);
+
+    const before = await usdcContract.balanceOf(user.address);
+    await expect(stakerContract.withdraw()).to.emit(stakerContract, "Withdrawn").withArgs(user.address, amount);
+
+    expect(await stakerContract.balanceOf(user.address)).to.equal(0n);
+    expect(await stakerContract.totalStaked()).to.equal(0n);
+    expect(await usdcContract.balanceOf(user.address)).to.equal(before + amount);
+  });
+
+  it("reverts on zero-amount stake", async function () {
+    const { stakerContract } = await networkHelpers.loadFixture(deployFixture);
+    await expect(stakerContract.stake(0n)).to.be.revertedWithCustomError(stakerContract, "ZeroAmount");
+  });
+
+  it("reverts when withdrawing with nothing staked", async function () {
+    const { stakerContract } = await networkHelpers.loadFixture(deployFixture);
+    await expect(stakerContract.withdraw()).to.be.revertedWithCustomError(stakerContract, "NothingStaked");
+  });
+});
