+//SPDX-License-Identifier: MIT
+pragma solidity 0.8.30;
+
+import { ERC20 } from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+
+/**
+ * Local-development stand-in for USDC on Base (0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913).
+ *
+ * It mirrors the real token where the dApp can tell the difference: same name, same symbol
+ * and — the one that actually breaks UIs — 6 decimals instead of the ERC20 default of 18.
+ *
+ * `mint` is deliberately unguarded: this is a local faucet. The deploy script only deploys
+ * it on chains that have no canonical USDC, so it never reaches a live network.
+ */
+contract MockUSDC is ERC20 {
+    constructor() ERC20("USD Coin", "USDC") {}
+
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    function mint(address to, uint256 amount) external {
+        _mint(to, amount);
+    }
+}
