index 0000000..d671aa8
--- /dev/null
+++ b/packages/hardhat/contracts/Staker.sol
@@ -0,0 +1,86 @@
+//SPDX-License-Identifier: MIT
+pragma solidity 0.8.30;
+
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { SafeERC20 } from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+import { ReentrancyGuard } from "@openzeppelin/contracts/utils/ReentrancyGuard.sol";
+
+/**
+ * A minimal staking vault for a single ERC20 (USDC on Base).
+ *
+ * Users deposit and can pull their position back out at any time. There are no rewards,
+ * no lockup, no fees and no admin: the contract holds no privileged role, so nobody
+ * (including the deployer) can move a user's tokens but the user.
+ *
+ * @author BuidlGuidl
+ */
+contract Staker is ReentrancyGuard {
+    using SafeERC20 for IERC20;
+
+    /// The staked token. USDC on Base: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
+    IERC20 public immutable token;
+
+    /// Amount each user currently has staked, in the token's own units (6 decimals for USDC).
+    mapping(address => uint256) public stakedBalance;
+
+    /// Sum of all `stakedBalance` entries.
+    uint256 public totalStaked;
+
+    event Staked(address indexed user, uint256 amount);
+    event Withdrawn(address indexed user, uint256 amount);
+
+    error ZeroAddress();
+    error ZeroAmount();
+    error InsufficientStake(uint256 staked, uint256 requested);
+
+    constructor(IERC20 _token) {
+        if (address(_token) == address(0)) revert ZeroAddress();
+        token = _token;
+    }
+
+    /**
+     * Pull `amount` of token from the caller into the vault. Requires an ERC20 allowance.
+     *
+     * @param amount Amount to stake, in token units (e.g. 1_000_000 == 1 USDC).
+     */
+    function stake(uint256 amount) external nonReentrant {
+        if (amount == 0) revert ZeroAmount();
+
+        // Credit what actually arrived rather than what was asked for. USDC takes no transfer
+        // fee today, but it is an upgradeable proxy, so we never assume the two are equal:
+        // over-crediting here would leave the last users unable to withdraw.
+        uint256 balanceBefore = token.balanceOf(address(this));
+        token.safeTransferFrom(msg.sender, address(this), amount);
+        uint256 received = token.balanceOf(address(this)) - balanceBefore;
+        if (received == 0) revert ZeroAmount();
+
+        stakedBalance[msg.sender] += received;
+        totalStaked += received;
+
+        emit Staked(msg.sender, received);
+    }
+
+    /**
+     * Send `amount` of the caller's staked tokens back to them.
+     *
+     * @param amount Amount to withdraw, in token units.
+     */
+    function withdraw(uint256 amount) public nonReentrant {
+        uint256 staked = stakedBalance[msg.sender];
+        if (amount == 0) revert ZeroAmount();
+        if (amount > staked) revert InsufficientStake(staked, amount);
+
+        unchecked {
+            stakedBalance[msg.sender] = staked - amount;
+        }
+        totalStaked -= amount;
+
+        emit Withdrawn(msg.sender, amount);
+        token.safeTransfer(msg.sender, amount);
+    }
+
+    /// Withdraw the caller's entire position, without needing to read the balance first.
+    function withdrawAll() external {
+        withdraw(stakedBalance[msg.sender]);
+    }
+}
