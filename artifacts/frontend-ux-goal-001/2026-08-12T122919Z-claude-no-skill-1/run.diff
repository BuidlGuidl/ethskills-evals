@@ -0,0 +1,139 @@
+import { expect } from "chai";
+import { network } from "hardhat";
+import type { Abi_Staker } from "../generated/abis/Staker.js";
+import type { Abi_MockUSDC } from "../generated/abis/MockUSDC.js";
+import { loadAndExecuteDeploymentsFromFiles } from "../rocketh/environment.js";
+
+const { provider, networkHelpers, ethers } = await network.create();
+
+const USDC = (amount: string) => ethers.parseUnits(amount, 6);
+
+async function deployFixture() {
+  const env = await loadAndExecuteDeploymentsFromFiles({ provider });
+
+  const stakerDeployment = env.get<Abi_Staker>("Staker");
+  const usdcDeployment = env.get<Abi_MockUSDC>("MockUSDC");
+  const staker = await ethers.getContractAt(stakerDeployment.abi, stakerDeployment.address);
+  const usdc = await ethers.getContractAt(usdcDeployment.abi, usdcDeployment.address);
+
+  const [, alice, bob] = await ethers.getSigners();
+  for (const account of [alice, bob]) {
+    await usdc.mint(account.address, USDC("1000"));
+  }
+
+  return { staker, usdc, alice, bob };
+}
+
+describe("Staker", function () {
+  it("stakes the token the deploy script wired up, with USDC's 6 decimals", async function () {
+    const { staker, usdc } = await networkHelpers.loadFixture(deployFixture);
+
+    expect(ethers.getAddress(await staker.token())).to.equal(ethers.getAddress(await usdc.getAddress()));
+    expect(await usdc.decimals()).to.equal(6);
+    expect(await usdc.symbol()).to.equal("USDC");
+  });
+
+  it("credits a stake and moves the tokens into the vault", async function () {
+    const { staker, usdc, alice } = await networkHelpers.loadFixture(deployFixture);
+    const stakerAddress = await staker.getAddress();
+
+    await usdc.connect(alice).approve(stakerAddress, USDC("100"));
+    await expect(staker.connect(alice).stake(USDC("100")))
+      .to.emit(staker, "Staked")
+      .withArgs(alice.address, USDC("100"));
+
+    expect(await staker.stakedBalance(alice.address)).to.equal(USDC("100"));
+    expect(await staker.totalStaked()).to.equal(USDC("100"));
+    expect(await usdc.balanceOf(stakerAddress)).to.equal(USDC("100"));
+    expect(await usdc.balanceOf(alice.address)).to.equal(USDC("900"));
+  });
+
+  it("accumulates repeated stakes", async function () {
+    const { staker, usdc, alice } = await networkHelpers.loadFixture(deployFixture);
+    const stakerAddress = await staker.getAddress();
+
+    await usdc.connect(alice).approve(stakerAddress, USDC("300"));
+    await staker.connect(alice).stake(USDC("100"));
+    await staker.connect(alice).stake(USDC("200"));
+
+    expect(await staker.stakedBalance(alice.address)).to.equal(USDC("300"));
+  });
+
+  it("reverts a stake with no allowance", async function () {
+    const { staker, usdc, alice } = await networkHelpers.loadFixture(deployFixture);
+
+    await expect(staker.connect(alice).stake(USDC("100"))).to.be.revertedWithCustomError(
+      usdc,
+      "ERC20InsufficientAllowance",
+    );
+  });
+
+  it("rejects zero-amount stakes and withdrawals", async function () {
+    const { staker, alice } = await networkHelpers.loadFixture(deployFixture);
+
+    await expect(staker.connect(alice).stake(0)).to.be.revertedWithCustomError(staker, "ZeroAmount");
+    await expect(staker.connect(alice).withdraw(0)).to.be.revertedWithCustomError(staker, "ZeroAmount");
+    // Nothing staked, so `withdrawAll` asks for zero.
+    await expect(staker.connect(alice).withdrawAll()).to.be.revertedWithCustomError(staker, "ZeroAmount");
+  });
+
+  it("withdraws part of a position", async function () {
+    const { staker, usdc, alice } = await networkHelpers.loadFixture(deployFixture);
+    const stakerAddress = await staker.getAddress();
+
+    await usdc.connect(alice).approve(stakerAddress, USDC("100"));
+    await staker.connect(alice).stake(USDC("100"));
+
+    await expect(staker.connect(alice).withdraw(USDC("40")))
+      .to.emit(staker, "Withdrawn")
+      .withArgs(alice.address, USDC("40"));
+
+    expect(await staker.stakedBalance(alice.address)).to.equal(USDC("60"));
+    expect(await staker.totalStaked()).to.equal(USDC("60"));
+    expect(await usdc.balanceOf(alice.address)).to.equal(USDC("940"));
+  });
+
+  it("withdraws the full position in one call", async function () {
+    const { staker, usdc, alice } = await networkHelpers.loadFixture(deployFixture);
+    const stakerAddress = await staker.getAddress();
+
+    await usdc.connect(alice).approve(stakerAddress, USDC("100"));
+    await staker.connect(alice).stake(USDC("100"));
+    await staker.connect(alice).withdrawAll();
+
+    expect(await staker.stakedBalance(alice.address)).to.equal(0);
+    expect(await staker.totalStaked()).to.equal(0);
+    expect(await usdc.balanceOf(alice.address)).to.equal(USDC("1000"));
+    expect(await usdc.balanceOf(stakerAddress)).to.equal(0);
+  });
+
+  it("refuses to withdraw more than is staked", async function () {
+    const { staker, usdc, alice } = await networkHelpers.loadFixture(deployFixture);
+    const stakerAddress = await staker.getAddress();
+
+    await usdc.connect(alice).approve(stakerAddress, USDC("100"));
+    await staker.connect(alice).stake(USDC("100"));
+
+    await expect(staker.connect(alice).withdraw(USDC("100.000001")))
+      .to.be.revertedWithCustomError(staker, "InsufficientStake")
+      .withArgs(USDC("100"), USDC("100.000001"));
+  });
+
+  it("keeps positions isolated between users", async function () {
+    const { staker, usdc, alice, bob } = await networkHelpers.loadFixture(deployFixture);
+    const stakerAddress = await staker.getAddress();
+
+    await usdc.connect(alice).approve(stakerAddress, USDC("100"));
+    await staker.connect(alice).stake(USDC("100"));
+    await usdc.connect(bob).approve(stakerAddress, USDC("250"));
+    await staker.connect(bob).stake(USDC("250"));
+
+    // Bob cannot touch Alice's deposit even though the vault holds enough to cover it.
+    await expect(staker.connect(bob).withdraw(USDC("300"))).to.be.revertedWithCustomError(staker, "InsufficientStake");
+
+    await staker.connect(bob).withdrawAll();
+    expect(await staker.stakedBalance(alice.address)).to.equal(USDC("100"));
+    expect(await staker.totalStaked()).to.equal(USDC("100"));
+    expect(await usdc.balanceOf(stakerAddress)).to.equal(USDC("100"));
+  });
+});
