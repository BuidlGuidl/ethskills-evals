+import { deployScript, artifacts } from "../rocketh/deploy.js";
+
+/**
+ * Canonical USDC per chain. Chains that are not listed (local dev) get a MockUSDC instead,
+ * so the deploy script is the only place that has to know the difference.
+ */
+const USDC_BY_CHAIN_ID: Record<number, `0x${string}`> = {
+  8453: "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913", // Base
+};
+
+// 100k mock USDC (6 decimals) handed to the deployer so there is something to stake locally.
+const LOCAL_MINT_AMOUNT = 100_000n * 10n ** 6n;
+
+/**
+ * Deploys the Staker, pointed at the canonical USDC of the target chain.
+ *
+ * @param env Rocketh environment object.
+ */
+export default deployScript(
+  async env => {
+    const { deployer } = env.namedAccounts;
+    const chainId = Number(env.network.chain.id);
+
+    let usdcAddress = USDC_BY_CHAIN_ID[chainId];
+
+    if (!usdcAddress) {
+      const mockUsdc = await env.deploy("MockUSDC", {
+        account: deployer,
+        artifact: artifacts.MockUSDC,
+        args: [],
+      });
+      usdcAddress = mockUsdc.address;
+
+      await env.execute(mockUsdc, {
+        account: deployer,
+        functionName: "mint",
+        args: [deployer, LOCAL_MINT_AMOUNT],
+      });
+
+      console.log(`🪙 No canonical USDC on chain ${chainId} — deployed MockUSDC at ${usdcAddress}`);
+    }
+
+    const staker = await env.deploy("Staker", {
+      account: deployer,
+      artifact: artifacts.Staker,
+      args: [usdcAddress],
+    });
+
+    console.log(`🔒 Staker at ${staker.address} staking USDC at ${usdcAddress}`);
+  },
+  {
+    // e.g. yarn deploy --tags Staker
+    tags: ["Staker"],
+  },
+);
