+"use client";
+
+import type { ReactNode } from "react";
+import { formatExactAmount, formatTokenAmount } from "../_utils/tokenAmount";
+import { Balance } from "@scaffold-ui/components";
+import type { Address, Chain } from "viem";
+
+const Stat = ({ label, hint, children }: { label: string; hint?: ReactNode; children: ReactNode }) => (
+  <div className="flex flex-col gap-1 rounded-xl border border-base-300 bg-base-100 px-5 py-4">
+    <span className="text-xs uppercase tracking-wide opacity-60">{label}</span>
+    <div className="text-2xl leading-tight">{children}</div>
+    <span className="min-h-4 text-xs opacity-60">{hint}</span>
+  </div>
+);
+
+const Placeholder = () => <span className="opacity-40">—</span>;
+
+const TokenAmount = ({ value, decimals, symbol }: { value?: bigint; decimals?: number; symbol?: string }) => {
+  if (value === undefined || decimals === undefined) return <div className="skeleton h-8 w-28" />;
+
+  return (
+    <span title={`${formatExactAmount(value, decimals)} ${symbol ?? ""}`.trim()}>
+      {formatTokenAmount(value, decimals)}
+      <span className="ml-1 text-sm opacity-60">{symbol}</span>
+    </span>
+  );
+};
+
+/**
+ * The three numbers a staker needs before they can decide anything: what they hold,
+ * what they have already staked, and whether they can afford the gas to change either.
+ */
+export const PositionOverview = ({
+  connectedAddress,
+  chain,
+  decimals,
+  symbol,
+  walletBalance,
+  stakedBalance,
+}: {
+  connectedAddress?: Address;
+  chain: Chain;
+  decimals?: number;
+  symbol?: string;
+  walletBalance?: bigint;
+  stakedBalance?: bigint;
+}) => (
+  <div className="grid grid-cols-1 gap-3 sm:grid-cols-3">
+    <Stat label="In your wallet" hint="Available to stake">
+      {connectedAddress ? <TokenAmount value={walletBalance} decimals={decimals} symbol={symbol} /> : <Placeholder />}
+    </Stat>
+    <Stat label="Staked" hint="Withdrawable at any time">
+      {connectedAddress ? <TokenAmount value={stakedBalance} decimals={decimals} symbol={symbol} /> : <Placeholder />}
+    </Stat>
+    <Stat label={`${chain.nativeCurrency.symbol} for gas`} hint={connectedAddress ? "Tap to switch to USD" : undefined}>
+      {connectedAddress ? <Balance address={connectedAddress} chain={chain} /> : <Placeholder />}
+    </Stat>
+  </div>
+);
diff --git a/packages/nextjs/app/stake/_components/StakePanel.tsx b/packages/nextjs/app/stake/_components/StakePanel.tsx
new file mode 100644
index 0000000..61cc573
--- /dev/null
+++ b/packages/nextjs/app/stake/_components/StakePanel.tsx
@@ -0,0 +1,205 @@
+"use client";
+
+import { type ReactNode, useState } from "react";
+import { useStaking } from "../_hooks/useStaking";
+import { type AmountCheck, checkAmount, formatExactAmount } from "../_utils/tokenAmount";
+import { AmountField } from "./AmountField";
+import { PositionOverview } from "./PositionOverview";
+import { Address } from "@scaffold-ui/components";
+import { parseEther } from "viem";
+import { useSwitchChain } from "wagmi";
+import { ExclamationTriangleIcon } from "@heroicons/react/24/outline";
+import { RainbowKitCustomConnectButton } from "~~/components/scaffold-eth";
+
+type Mode = "stake" | "withdraw";
+
+// Roughly a hundred Base transactions' worth of gas. Below this, a staker is one deposit away
+// from being stuck with a position they cannot withdraw.
+const LOW_GAS_THRESHOLD = parseEther("0.0002");
+
+const Notice = ({ children }: { children: ReactNode }) => (
+  <div className="alert alert-warning alert-soft text-sm">
+    <ExclamationTriangleIcon className="h-5 w-5 shrink-0" />
+    <span>{children}</span>
+  </div>
+);
+
+export const StakePanel = () => {
+  const {
+    connectedAddress,
+    isWrongNetwork,
+    targetNetwork,
+    stakerAddress,
+    isStakerLoading,
+    tokenAddress,
+    hasReadError,
+    decimals,
+    symbol,
+    walletBalance,
+    allowance,
+    stakedBalance,
+    ethBalance,
+    stake,
+    withdraw,
+  } = useStaking();
+
+  const { switchChain, isPending: isSwitchingChain } = useSwitchChain();
+
+  const [mode, setMode] = useState<Mode>("stake");
+  const [input, setInput] = useState("");
+  const [isSubmitting, setIsSubmitting] = useState(false);
+
+  const isStaking = mode === "stake";
+  const available = isStaking ? walletBalance : stakedBalance;
+
+  // Nothing is parsed until we know the token's decimals: guessing them would mean
+  // submitting an amount off by orders of magnitude.
+  const isReady = decimals !== undefined && symbol !== undefined && Boolean(stakerAddress);
+  const amount: AmountCheck = isReady
+    ? checkAmount({
+        input,
+        decimals,
+        symbol,
+        max: available,
+        overMaxError: isStaking ? "More than your wallet balance" : "More than your staked position",
+      })
+    : {};
+
+  const needsApproval = isStaking && amount.value !== undefined && (allowance ?? 0n) < amount.value;
+  const canSubmit =
+    Boolean(connectedAddress) && !isWrongNetwork && isReady && !isSubmitting && Boolean(amount.value) && !amount.error;
+
+  const actionLabel = isStaking ? (needsApproval ? "Approve & stake" : "Stake") : "Withdraw";
+
+  const switchMode = (next: Mode) => {
+    setMode(next);
+    setInput("");
+  };
+
+  const handleSubmit = async () => {
+    if (!canSubmit || amount.value === undefined) return;
+    try {
+      setIsSubmitting(true);
+      const hash = await (isStaking ? stake(amount.value) : withdraw(amount.value));
+      // Only clear the field once a transaction actually went out, so a write that was
+      // refused up front does not look like it succeeded.
+      if (hash) setInput("");
+    } catch (error) {
+      // `useTransactor` and `useScaffoldWriteContract` have already shown this to the user.
+      console.error("Staking transaction failed", error);
+    } finally {
+      setIsSubmitting(false);
+    }
+  };
+
+  if (isStakerLoading) {
+    return <div className="skeleton h-96 w-full" />;
+  }
+
+  if (!stakerAddress) {
+    return (
+      <Notice>
+        The Staker contract is not deployed on {targetNetwork.name}. Run <code>yarn deploy</code> for this network, or
+        switch to a network where it lives.
+      </Notice>
+    );
+  }
+
+  return (
+    <div className="flex flex-col gap-6">
+      <PositionOverview
+        connectedAddress={connectedAddress}
+        chain={targetNetwork}
+        decimals={decimals}
+        symbol={symbol}
+        walletBalance={walletBalance}
+        stakedBalance={stakedBalance}
+      />
+
+      <div className="card border border-base-300 bg-base-100">
+        <div className="card-body gap-4 p-5 sm:p-6">
+          <div role="tablist" className="tabs tabs-box self-start">
+            {(["stake", "withdraw"] as const).map(tab => (
+              <button
+                key={tab}
+                role="tab"
+                type="button"
+                aria-selected={mode === tab}
+                className={`tab capitalize ${mode === tab ? "tab-active" : ""}`}
+                onClick={() => switchMode(tab)}
+              >
+                {tab}
+              </button>
+            ))}
+          </div>
+
+          <AmountField
+            value={input}
+            onChange={setInput}
+            available={available}
+            availableLabel={isStaking ? "In your wallet" : "Staked"}
+            decimals={decimals}
+            symbol={symbol}
+            error={amount.error}
+            disabled={!connectedAddress || isWrongNetwork || !isReady}
+          />
+
+          {!connectedAddress ? (
+            <div className="flex flex-col items-center gap-3 pt-1">
+              <p className="text-sm opacity-70">Connect a wallet to stake.</p>
+              <RainbowKitCustomConnectButton />
+            </div>
+          ) : isWrongNetwork ? (
+            <button
+              className="btn btn-primary"
+              onClick={() => switchChain({ chainId: targetNetwork.id })}
+              disabled={isSwitchingChain}
+            >
+              {isSwitchingChain && <span className="loading loading-spinner loading-xs" />}
+              Switch to {targetNetwork.name}
+            </button>
+          ) : (
+            <button className="btn btn-primary" onClick={handleSubmit} disabled={!canSubmit}>
+              {isSubmitting && <span className="loading loading-spinner loading-xs" />}
+              {isSubmitting ? "Confirm in your wallet" : actionLabel}
+            </button>
+          )}
+
+          {needsApproval && !isSubmitting && (
+            <p className="px-1 text-center text-xs opacity-60">
+              This takes two transactions: one to let the vault move{" "}
+              {amount.value !== undefined && decimals !== undefined ? formatExactAmount(amount.value, decimals) : ""}{" "}
+              {symbol}, one to deposit it.
+            </p>
+          )}
+
+          {hasReadError && (
+            <Notice>
+              We could not read your balances from {targetNetwork.name}. They may be out of date — refresh before
+              relying on the numbers above.
+            </Notice>
+          )}
+
+          {ethBalance !== undefined && ethBalance < LOW_GAS_THRESHOLD && (
+            <Notice>
+              {ethBalance === 0n
+                ? `You have no ${targetNetwork.nativeCurrency.symbol} on ${targetNetwork.name}. You need a small amount to pay for gas before you can stake or withdraw.`
+                : `Your ${targetNetwork.nativeCurrency.symbol} balance is low. Top it up so you can still afford the gas to withdraw later.`}
+            </Notice>
+          )}
+        </div>
+      </div>
+
+      <div className="flex flex-col gap-2 px-1 text-xs sm:flex-row sm:items-center sm:justify-between">
+        <div className="flex items-center gap-2">
+          <span className="opacity-60">Vault</span>
+          <Address address={stakerAddress} chain={targetNetwork} size="xs" />
+        </div>
+        <div className="flex items-center gap-2">
+          <span className="opacity-60">{symbol ?? "Token"}</span>
+          <Address address={tokenAddress} chain={targetNetwork} size="xs" />
+        </div>
+      </div>
+    </div>
+  );
+};
diff --git a/packages/nextjs/app/stake/_hooks/useStaking.ts b/packages/nextjs/app/stake/_hooks/useStaking.ts
new file mode 100644
index 0000000..7298129
--- /dev/null
+++ b/packages/nextjs/app/stake/_hooks/useStaking.ts
@@ -0,0 +1,154 @@
+"use client";
+
+import { useEffect } from "react";
+import { useWatchBalance } from "@scaffold-ui/hooks";
+import { useQueryClient } from "@tanstack/react-query";
+import { type Address, erc20Abi } from "viem";
+import { useAccount, useBlockNumber, useReadContracts, useWriteContract } from "wagmi";
+import {
+  useDeployedContractInfo,
+  useScaffoldReadContract,
+  useScaffoldWriteContract,
+  useTargetNetwork,
+  useTransactor,
+} from "~~/hooks/scaffold-eth";
+
+/**
+ * Everything the /stake page needs: the vault, the token it accepts, the connected user's
+ * position and the two actions they can take.
+ *
+ * The token address is read from the Staker rather than hardcoded, so the same page works
+ * against real USDC on Base and against the mock deployed on a local chain.
+ */
+export const useStaking = () => {
+  const { address: connectedAddress, chain: connectedChain } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+  const chainId = targetNetwork.id;
+
+  const { data: stakerContract, isLoading: isStakerLoading } = useDeployedContractInfo({ contractName: "Staker" });
+  const stakerAddress = stakerContract?.address;
+
+  const { data: tokenData } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "token",
+    // Immutable on the contract, so there is no reason to poll it.
+    watch: false,
+    query: { staleTime: Infinity, gcTime: Infinity },
+  });
+  const tokenAddress = tokenData as Address | undefined;
+
+  const { data: tokenMetadata, isError: isTokenMetadataError } = useReadContracts({
+    allowFailure: false,
+    contracts: [
+      { chainId, address: tokenAddress, abi: erc20Abi, functionName: "decimals" },
+      { chainId, address: tokenAddress, abi: erc20Abi, functionName: "symbol" },
+    ],
+    query: { enabled: Boolean(tokenAddress), staleTime: Infinity, gcTime: Infinity },
+  });
+  const [decimals, symbol] = tokenMetadata ?? [];
+
+  const {
+    data: walletState,
+    queryKey: walletStateQueryKey,
+    isError: isWalletStateError,
+  } = useReadContracts({
+    allowFailure: false,
+    contracts: [
+      {
+        chainId,
+        address: tokenAddress,
+        abi: erc20Abi,
+        functionName: "balanceOf",
+        args: [connectedAddress as Address],
+      },
+      {
+        chainId,
+        address: tokenAddress,
+        abi: erc20Abi,
+        functionName: "allowance",
+        args: [connectedAddress as Address, stakerAddress as Address],
+      },
+    ],
+    query: { enabled: Boolean(tokenAddress && connectedAddress && stakerAddress) },
+  });
+  const [walletBalance, allowance] = walletState ?? [];
+
+  const { data: stakedData, queryKey: stakedBalanceQueryKey } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "stakedBalance",
+    args: [connectedAddress],
+  });
+  const stakedBalance = stakedData as bigint | undefined;
+
+  const { data: ethBalance } = useWatchBalance({ address: connectedAddress, chainId });
+
+  // `useScaffoldReadContract` refreshes itself on every block; the raw ERC20 reads do not.
+  const queryClient = useQueryClient();
+  const { data: blockNumber } = useBlockNumber({ watch: true, chainId });
+  useEffect(() => {
+    queryClient.invalidateQueries({ queryKey: walletStateQueryKey });
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [blockNumber]);
+
+  /** Pull balances forward right after a transaction instead of waiting for the next block. */
+  const refresh = () => {
+    queryClient.invalidateQueries({ queryKey: walletStateQueryKey });
+    queryClient.invalidateQueries({ queryKey: stakedBalanceQueryKey });
+  };
+
+  const writeTx = useTransactor();
+  const { writeContractAsync: writeErc20Async } = useWriteContract();
+  const { writeContractAsync: writeStakerAsync } = useScaffoldWriteContract({ contractName: "Staker" });
+
+  const approve = async (amount: bigint) => {
+    if (!tokenAddress || !stakerAddress) return;
+    await writeTx(() =>
+      writeErc20Async({
+        chainId,
+        address: tokenAddress,
+        abi: erc20Abi,
+        functionName: "approve",
+        // Exactly what is about to be staked: no allowance is left sitting on the vault afterwards.
+        args: [stakerAddress, amount],
+      }),
+    );
+  };
+
+  /** Returns the transaction hash, or undefined if the write never made it out (e.g. wrong network). */
+  const stake = async (amount: bigint) => {
+    if (allowance === undefined || allowance < amount) {
+      await approve(amount);
+    }
+    const hash = await writeStakerAsync({ functionName: "stake", args: [amount] });
+    refresh();
+    return hash;
+  };
+
+  const withdraw = async (amount: bigint) => {
+    // Emptying the position uses the dedicated call, which cannot be off by a rounding unit.
+    const hash =
+      stakedBalance !== undefined && amount === stakedBalance
+        ? await writeStakerAsync({ functionName: "withdrawAll" })
+        : await writeStakerAsync({ functionName: "withdraw", args: [amount] });
+    refresh();
+    return hash;
+  };
+
+  return {
+    connectedAddress,
+    isWrongNetwork: Boolean(connectedChain && connectedChain.id !== chainId),
+    targetNetwork,
+    stakerAddress,
+    isStakerLoading,
+    tokenAddress,
+    hasReadError: isTokenMetadataError || isWalletStateError,
+    decimals,
+    symbol,
+    walletBalance,
+    allowance,
+    stakedBalance,
+    ethBalance: ethBalance?.value,
+    stake,
+    withdraw,
+  };
+};
diff --git a/packages/nextjs/app/stake/_utils/tokenAmount.ts b/packages/nextjs/app/stake/_utils/tokenAmount.ts
new file mode 100644
index 0000000..bf1f8c5
--- /dev/null
+++ b/packages/nextjs/app/stake/_utils/tokenAmount.ts
@@ -0,0 +1,64 @@
+import { formatUnits, parseUnits } from "viem";
+
+/** Digits, with at most one decimal point. Rejects "-", "1e9" and other things `parseUnits` would mangle. */
+const AMOUNT_PATTERN = /^\d*\.?\d*$/;
+
+export const isAmountInputAllowed = (input: string) => AMOUNT_PATTERN.test(input);
+
+const fractionDigitsOf = (input: string) => input.split(".")[1]?.length ?? 0;
+
+export type AmountCheck = {
+  /** The amount in token units, or undefined when the input is empty or unusable. */
+  value?: bigint;
+  /** A problem worth showing the user. Absent while the input is empty. */
+  error?: string;
+};
+
+/**
+ * Turns what the user typed into token units, refusing anything we would otherwise have to
+ * round or truncate behind their back.
+ */
+export const checkAmount = ({
+  input,
+  decimals,
+  max,
+  symbol,
+  overMaxError,
+}: {
+  input: string;
+  decimals: number;
+  max?: bigint;
+  symbol: string;
+  overMaxError: string;
+}): AmountCheck => {
+  const trimmed = input.trim();
+  if (!trimmed || !AMOUNT_PATTERN.test(trimmed)) return {};
+
+  if (fractionDigitsOf(trimmed) > decimals) {
+    return { error: `${symbol} has ${decimals} decimals — that is more precision than it can hold` };
+  }
+
+  let value: bigint;
+  try {
+    value = parseUnits(trimmed, decimals);
+  } catch {
+    return { error: "Enter a valid amount" };
+  }
+
+  if (value === 0n) return { error: "Enter an amount greater than zero" };
+  if (max !== undefined && value > max) return { value, error: overMaxError };
+
+  return { value };
+};
+
+/**
+ * Human-readable balance, e.g. `1,204.50`. Dust is shown as `<0.01` rather than a misleading
+ * `0.00`; use `formatExactAmount` wherever the precise number matters.
+ */
+export const formatTokenAmount = (value: bigint, decimals: number) => {
+  const asNumber = Number(formatUnits(value, decimals));
+  if (value > 0n && asNumber < 0.01) return "<0.01";
+  return asNumber.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
+};
+
+export const formatExactAmount = (value: bigint, decimals: number) => formatUnits(value, decimals);
