+"use client";
+
+import { formatExactAmount, formatTokenAmount, isAmountInputAllowed } from "../_utils/tokenAmount";
+import { BaseInput } from "@scaffold-ui/components";
+
+export const AmountField = ({
+  value,
+  onChange,
+  availableLabel,
+  available,
+  decimals,
+  symbol,
+  error,
+  disabled,
+}: {
+  value: string;
+  onChange: (next: string) => void;
+  availableLabel: string;
+  available?: bigint;
+  decimals?: number;
+  symbol?: string;
+  error?: string;
+  disabled?: boolean;
+}) => {
+  // Without the token's decimals we cannot turn a balance into a number, so MAX stays out of reach.
+  const canUseMax = !disabled && available !== undefined && available > 0n && decimals !== undefined;
+
+  return (
+    <div className="flex flex-col gap-1.5">
+      <BaseInput
+        name="amount"
+        value={value}
+        onChange={next => {
+          // Silently drop keystrokes that could never be an amount, rather than erroring after the fact.
+          if (isAmountInputAllowed(next)) onChange(next);
+        }}
+        placeholder="0.00"
+        error={Boolean(error)}
+        disabled={disabled}
+        suffix={
+          <div className="flex items-center gap-2 pr-3">
+            <span className="text-sm font-medium opacity-60">{symbol}</span>
+            <button
+              type="button"
+              className="btn btn-xs btn-ghost"
+              disabled={!canUseMax}
+              onClick={() => canUseMax && onChange(formatExactAmount(available, decimals))}
+            >
+              MAX
+            </button>
+          </div>
+        }
+      />
+      <div className="flex justify-between gap-3 px-1 text-xs">
+        <span className="opacity-60">
+          {availableLabel}:{" "}
+          {available === undefined || decimals === undefined
+            ? "—"
+            : `${formatTokenAmount(available, decimals)} ${symbol ?? ""}`.trim()}
+        </span>
+        {error && <span className="text-right text-error">{error}</span>}
+      </div>
+    </div>
+  );
+};
