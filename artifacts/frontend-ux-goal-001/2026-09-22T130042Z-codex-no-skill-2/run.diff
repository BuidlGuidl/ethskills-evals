@@ -0,0 +1,46 @@
+import { deployScript, artifacts } from "../rocketh/deploy.js";
+
+const BASE_USDC = "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913";
+const MOCK_USDC_INITIAL_SUPPLY = "1000000000000";
+const LOCAL_NETWORKS = new Set(["default", "hardhat", "localhost"]);
+
+const getNetworkName = () => {
+  const networkIndex = process.argv.indexOf("--network");
+  return networkIndex === -1 ? "default" : process.argv[networkIndex + 1];
+};
+
+export default deployScript(
+  async env => {
+    const { deployer } = env.namedAccounts;
+    const networkName = getNetworkName();
+
+    let usdcAddress = BASE_USDC;
+
+    if (LOCAL_NETWORKS.has(networkName)) {
+      const mockUSDC = await env.deploy("MockUSDC", {
+        account: deployer,
+        artifact: artifacts.MockUSDC,
+        args: [deployer, MOCK_USDC_INITIAL_SUPPLY],
+      });
+
+      usdcAddress = mockUSDC.address;
+      console.log("💵 Mock USDC deployed:", usdcAddress);
+    } else if (networkName !== "base") {
+      console.warn(
+        `⚠️  ${networkName} is using Base USDC (${BASE_USDC}). Only deploy Staker to Base or local networks.`,
+      );
+    }
+
+    const staker = await env.deploy("Staker", {
+      account: deployer,
+      artifact: artifacts.Staker,
+      args: [usdcAddress],
+    });
+
+    console.log("🥩 Staker deployed:", staker.address);
+    console.log("💵 Staker USDC:", await env.read(staker, { functionName: "usdc" }));
+  },
+  {
+    tags: ["Staker", "MockUSDC"],
+  },
+);
