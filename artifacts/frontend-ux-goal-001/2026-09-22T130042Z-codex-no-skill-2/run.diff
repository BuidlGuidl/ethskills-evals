+"use client";
+
+import { useState } from "react";
+import { Address } from "@scaffold-ui/components";
+import type { NextPage } from "next";
+import { Address as AddressType, formatEther, formatUnits, parseUnits, zeroAddress } from "viem";
+import { useAccount, useBalance, useReadContract, useWriteContract } from "wagmi";
+import {
+  ArrowDownTrayIcon,
+  ArrowPathIcon,
+  ArrowUpTrayIcon,
+  BanknotesIcon,
+  CircleStackIcon,
+  WalletIcon,
+} from "@heroicons/react/24/outline";
+import {
+  useDeployedContractInfo,
+  useScaffoldReadContract,
+  useScaffoldWriteContract,
+  useTargetNetwork,
+  useTransactor,
+} from "~~/hooks/scaffold-eth";
+
+const ERC20_ABI = [
+  {
+    type: "function",
+    name: "allowance",
+    stateMutability: "view",
+    inputs: [
+      { name: "owner", type: "address" },
+      { name: "spender", type: "address" },
+    ],
+    outputs: [{ name: "", type: "uint256" }],
+  },
+  {
+    type: "function",
+    name: "approve",
+    stateMutability: "nonpayable",
+    inputs: [
+      { name: "spender", type: "address" },
+      { name: "amount", type: "uint256" },
+    ],
+    outputs: [{ name: "", type: "bool" }],
+  },
+  {
+    type: "function",
+    name: "balanceOf",
+    stateMutability: "view",
+    inputs: [{ name: "account", type: "address" }],
+    outputs: [{ name: "", type: "uint256" }],
+  },
+  {
+    type: "function",
+    name: "decimals",
+    stateMutability: "view",
+    inputs: [],
+    outputs: [{ name: "", type: "uint8" }],
+  },
+  {
+    type: "function",
+    name: "symbol",
+    stateMutability: "view",
+    inputs: [],
+    outputs: [{ name: "", type: "string" }],
+  },
+] as const;
+
+const tokenNumberFormat = new Intl.NumberFormat("en-US", {
+  minimumFractionDigits: 2,
+  maximumFractionDigits: 2,
+});
+
+const ethNumberFormat = new Intl.NumberFormat("en-US", {
+  minimumFractionDigits: 4,
+  maximumFractionDigits: 4,
+});
+
+const formatTokenAmount = (value: bigint | undefined, decimals: number) =>
+  tokenNumberFormat.format(Number(formatUnits(value ?? 0n, decimals)));
+
+const formatEthAmount = (value: bigint | undefined) => ethNumberFormat.format(Number(formatEther(value ?? 0n)));
+
+const parseTokenAmount = (value: string, decimals: number) => {
+  const trimmedValue = value.trim();
+  if (!trimmedValue) return 0n;
+
+  try {
+    return parseUnits(trimmedValue, decimals);
+  } catch {
+    return undefined;
+  }
+};
+
+const StakePage: NextPage = () => {
+  const { address: connectedAddress, chain } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+  const writeTx = useTransactor();
+  const [stakeInput, setStakeInput] = useState("");
+
+  const { data: stakerContract } = useDeployedContractInfo({ contractName: "Staker" });
+  const stakerAddress = stakerContract?.address;
+
+  const { data: stakerUSDC } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "usdc",
+    watch: false,
+  });
+
+  const usdcAddress = stakerUSDC as AddressType | undefined;
+  const hasTokenAddress = Boolean(usdcAddress);
+  const readAccount = connectedAddress ?? zeroAddress;
+
+  const { data: decimalsData } = useReadContract({
+    address: usdcAddress,
+    abi: ERC20_ABI,
+    functionName: "decimals",
+    chainId: targetNetwork.id,
+    query: {
+      enabled: hasTokenAddress,
+    },
+  });
+
+  const decimals = Number(decimalsData ?? 6);
+
+  const { data: tokenSymbolData } = useReadContract({
+    address: usdcAddress,
+    abi: ERC20_ABI,
+    functionName: "symbol",
+    chainId: targetNetwork.id,
+    query: {
+      enabled: hasTokenAddress,
+    },
+  });
+
+  const tokenSymbol = tokenSymbolData ?? "USDC";
+
+  const {
+    data: walletUSDC,
+    refetch: refetchWalletUSDC,
+    isLoading: isWalletUSDCLoading,
+  } = useReadContract({
+    address: usdcAddress,
+    abi: ERC20_ABI,
+    functionName: "balanceOf",
+    args: [readAccount],
+    chainId: targetNetwork.id,
+    query: {
+      enabled: Boolean(connectedAddress && usdcAddress),
+    },
+  });
+
+  const { data: allowance, refetch: refetchAllowance } = useReadContract({
+    address: usdcAddress,
+    abi: ERC20_ABI,
+    functionName: "allowance",
+    args: [readAccount, stakerAddress ?? zeroAddress],
+    chainId: targetNetwork.id,
+    query: {
+      enabled: Boolean(connectedAddress && usdcAddress && stakerAddress),
+    },
+  });
+
+  const {
+    data: stakedPosition,
+    refetch: refetchStakedPosition,
+    isLoading: isPositionLoading,
+  } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "positions",
+    args: [connectedAddress],
+    query: {
+      enabled: Boolean(connectedAddress && stakerAddress),
+    },
+  });
+
+  const { data: totalStaked } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "totalStaked",
+  });
+
+  const { data: ethBalance, refetch: refetchEthBalance } = useBalance({
+    address: connectedAddress,
+    chainId: targetNetwork.id,
+    query: {
+      enabled: Boolean(connectedAddress),
+    },
+  });
+
+  const { writeContractAsync: writeTokenAsync, isPending: isApprovePending } = useWriteContract();
+  const { writeContractAsync: writeStakerAsync, isMining: isStakerMining } = useScaffoldWriteContract({
+    contractName: "Staker",
+  });
+
+  const parsedStakeAmount = parseTokenAmount(stakeInput, decimals);
+  const hasConnectedWallet = Boolean(connectedAddress);
+  const hasStaker = Boolean(stakerAddress);
+  const isWrongNetwork = Boolean(chain?.id && chain.id !== targetNetwork.id);
+  const hasAmount = typeof parsedStakeAmount === "bigint" && parsedStakeAmount > 0n;
+  const hasEnoughBalance = hasAmount && (walletUSDC ?? 0n) >= parsedStakeAmount;
+  const needsApproval = hasAmount && (allowance ?? 0n) < parsedStakeAmount;
+  const canApprove =
+    hasConnectedWallet && hasStaker && hasTokenAddress && hasEnoughBalance && needsApproval && !isWrongNetwork;
+  const canStake =
+    hasConnectedWallet && hasStaker && hasTokenAddress && hasEnoughBalance && !needsApproval && !isWrongNetwork;
+  const canWithdraw = hasConnectedWallet && hasStaker && (stakedPosition ?? 0n) > 0n && !isWrongNetwork;
+  const isSubmitting = isApprovePending || isStakerMining;
+
+  const refetchBalances = async () => {
+    await Promise.all([refetchWalletUSDC(), refetchAllowance(), refetchStakedPosition(), refetchEthBalance()]);
+  };
+
+  let stakeButtonLabel = "Stake USDC";
+  if (!hasConnectedWallet) stakeButtonLabel = "Connect Wallet";
+  else if (isWrongNetwork) stakeButtonLabel = `Switch to ${targetNetwork.name}`;
+  else if (!hasStaker) stakeButtonLabel = "Staker Not Deployed";
+  else if (parsedStakeAmount === undefined) stakeButtonLabel = "Invalid Amount";
+  else if (!hasAmount) stakeButtonLabel = "Enter Amount";
+  else if (!hasEnoughBalance) stakeButtonLabel = "Insufficient USDC";
+  else if (needsApproval) stakeButtonLabel = "Approve USDC";
+
+  const handlePrimaryAction = async () => {
+    if (!parsedStakeAmount || !stakerAddress || !usdcAddress) return;
+
+    if (needsApproval) {
+      await writeTx(
+        () =>
+          writeTokenAsync({
+            address: usdcAddress,
+            abi: ERC20_ABI,
+            functionName: "approve",
+            args: [stakerAddress, parsedStakeAmount],
+          }),
+        {
+          onBlockConfirmation: () => {
+            void refetchBalances();
+          },
+        },
+      );
+      return;
+    }
+
+    await writeStakerAsync(
+      {
+        functionName: "stake",
+        args: [parsedStakeAmount],
+      },
+      {
+        onBlockConfirmation: () => {
+          setStakeInput("");
+          void refetchBalances();
+        },
+      },
+    );
+  };
+
+  const handleWithdraw = async () => {
+    await writeStakerAsync(
+      {
+        functionName: "withdraw",
+      },
+      {
+        onBlockConfirmation: () => {
+          void refetchBalances();
+        },
+      },
+    );
+  };
+
+  const handleMax = () => {
+    setStakeInput(formatUnits(walletUSDC ?? 0n, decimals));
+  };
+
+  return (
+    <div className="grow bg-base-200">
+      <div className="mx-auto flex w-full max-w-6xl flex-col gap-6 px-4 py-6 sm:px-6 lg:px-8">
+        <section className="grid gap-4 lg:grid-cols-[1.2fr_0.8fr]">
+          <div className="bg-base-100 border border-base-300 p-5 sm:p-6">
+            <div className="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
+              <div>
+                <div className="mb-3 flex items-center gap-3">
+                  <div className="flex h-12 w-12 items-center justify-center rounded-full bg-info text-info-content">
+                    <CircleStackIcon className="h-7 w-7" />
+                  </div>
+                  <div>
+                    <h1 className="mb-0 text-3xl font-bold leading-tight">USDC Staking</h1>
+                    <p className="my-0 text-sm text-base-content/70">Base network</p>
+                  </div>
+                </div>
+                <div className="badge badge-outline border-success text-success">
+                  No rewards, full withdrawal anytime
+                </div>
+              </div>
+              <div className="text-left sm:text-right">
+                <p className="my-0 text-xs uppercase tracking-wide text-base-content/60">Total staked</p>
+                <p className="my-1 text-3xl font-semibold">
+                  {formatTokenAmount(totalStaked as bigint | undefined, decimals)} {tokenSymbol}
+                </p>
+              </div>
+            </div>
+          </div>
+
+          <div className="bg-neutral p-5 text-neutral-content sm:p-6">
+            <p className="my-0 text-xs uppercase tracking-wide opacity-70">Connected wallet</p>
+            <div className="mt-3 min-h-8">
+              {connectedAddress ? (
+                <Address address={connectedAddress} chain={targetNetwork} />
+              ) : (
+                <span className="text-sm opacity-80">No wallet connected</span>
+              )}
+            </div>
+            <div className="mt-5 flex items-center justify-between gap-3 border-t border-neutral-content/15 pt-4">
+              <span className="text-sm opacity-80">Network</span>
+              <span className="font-semibold">{targetNetwork.name}</span>
+            </div>
+          </div>
+        </section>
+
+        <section className="grid gap-4 md:grid-cols-3">
+          <div className="bg-base-100 border border-base-300 p-5">
+            <div className="flex items-center justify-between gap-3">
+              <span className="text-sm text-base-content/70">Wallet USDC</span>
+              <WalletIcon className="h-5 w-5 text-info" />
+            </div>
+            <p className="my-3 text-2xl font-semibold">
+              {isWalletUSDCLoading ? "..." : formatTokenAmount(walletUSDC, decimals)}
+            </p>
+            <span className="text-sm text-base-content/60">{tokenSymbol}</span>
+          </div>
+
+          <div className="bg-base-100 border border-base-300 p-5">
+            <div className="flex items-center justify-between gap-3">
+              <span className="text-sm text-base-content/70">ETH for gas</span>
+              <BanknotesIcon className="h-5 w-5 text-warning" />
+            </div>
+            <p className="my-3 text-2xl font-semibold">{formatEthAmount(ethBalance?.value)}</p>
+            <span className="text-sm text-base-content/60">ETH</span>
+          </div>
+
+          <div className="bg-base-100 border border-base-300 p-5">
+            <div className="flex items-center justify-between gap-3">
+              <span className="text-sm text-base-content/70">Staked position</span>
+              <CircleStackIcon className="h-5 w-5 text-success" />
+            </div>
+            <p className="my-3 text-2xl font-semibold">
+              {isPositionLoading ? "..." : formatTokenAmount(stakedPosition as bigint | undefined, decimals)}
+            </p>
+            <span className="text-sm text-base-content/60">{tokenSymbol}</span>
+          </div>
+        </section>
+
+        <section className="grid gap-4 lg:grid-cols-[1fr_0.9fr]">
+          <div className="bg-base-100 border border-base-300 p-5 sm:p-6">
+            <div className="flex flex-col gap-4 sm:flex-row sm:items-end">
+              <label className="form-control w-full">
+                <span className="label">
+                  <span className="label-text font-medium">Stake amount</span>
+                  <button type="button" className="btn btn-ghost btn-xs" onClick={handleMax}>
+                    Max
+                  </button>
+                </span>
+                <div className="join w-full">
+                  <input
+                    className="input join-item input-bordered w-full text-lg"
+                    inputMode="decimal"
+                    placeholder="0.00"
+                    value={stakeInput}
+                    onChange={event => setStakeInput(event.target.value)}
+                  />
+                  <span className="join-item flex min-w-20 items-center justify-center border border-base-300 bg-base-200 px-3 font-semibold">
+                    {tokenSymbol}
+                  </span>
+                </div>
+              </label>
+              <button
+                type="button"
+                className="btn btn-primary min-h-12 min-w-44"
+                disabled={isSubmitting || (!canApprove && !canStake)}
+                onClick={handlePrimaryAction}
+              >
+                {isSubmitting ? (
+                  <ArrowPathIcon className="h-5 w-5 animate-spin" />
+                ) : needsApproval ? (
+                  <ArrowUpTrayIcon className="h-5 w-5" />
+                ) : (
+                  <ArrowDownTrayIcon className="h-5 w-5" />
+                )}
+                {stakeButtonLabel}
+              </button>
+            </div>
+
+            <div className="mt-5 grid gap-3 text-sm sm:grid-cols-2">
+              <div className="flex items-center justify-between gap-3 bg-base-200 px-3 py-2">
+                <span className="text-base-content/70">Allowance</span>
+                <span className="font-medium">
+                  {formatTokenAmount(allowance, decimals)} {tokenSymbol}
+                </span>
+              </div>
+              <div className="flex items-center justify-between gap-3 bg-base-200 px-3 py-2">
+                <span className="text-base-content/70">Staker</span>
+                <span className="font-medium">{hasStaker ? "Ready" : "Missing"}</span>
+              </div>
+            </div>
+          </div>
+
+          <div className="bg-base-100 border border-base-300 p-5 sm:p-6">
+            <div className="flex h-full flex-col justify-between gap-5">
+              <div>
+                <h2 className="mb-2 text-xl font-semibold">Withdraw position</h2>
+                <p className="my-0 text-sm text-base-content/70">
+                  {formatTokenAmount(stakedPosition as bigint | undefined, decimals)} {tokenSymbol} available
+                </p>
+              </div>
+              <button
+                type="button"
+                className="btn btn-secondary min-h-12 w-full"
+                disabled={isSubmitting || !canWithdraw}
+                onClick={handleWithdraw}
+              >
+                {isSubmitting ? (
+                  <ArrowPathIcon className="h-5 w-5 animate-spin" />
+                ) : (
+                  <ArrowUpTrayIcon className="h-5 w-5" />
+                )}
+                Withdraw All
+              </button>
+            </div>
+          </div>
+        </section>
+      </div>
+    </div>
+  );
+};
+
+export default StakePage;
