index 0000000..570dbf9
--- /dev/null
+++ b/packages/hardhat/test/Staker.ts
@@ -0,0 +1,83 @@
+import { expect } from "chai";
+import { network } from "hardhat";
+import type { Abi_MockUSDC } from "../generated/abis/MockUSDC.js";
+import type { Abi_Staker } from "../generated/abis/Staker.js";
+import { loadAndExecuteDeploymentsFromFiles } from "../rocketh/environment.js";
+
+const { provider, networkHelpers, ethers } = await network.create();
+const USDC = 10n ** 6n;
+
+async function deployFixture() {
+  const env = await loadAndExecuteDeploymentsFromFiles({ provider });
+  const { address: stakerAddress, abi: stakerAbi } = env.get<Abi_Staker>("Staker");
+  const { address: mockUSDCAddress, abi: mockUSDCAbi } = env.get<Abi_MockUSDC>("MockUSDC");
+  const staker = await ethers.getContractAt(stakerAbi, stakerAddress);
+  const mockUSDC = await ethers.getContractAt(mockUSDCAbi, mockUSDCAddress);
+  const [deployer, stakerAccount, otherAccount] = await ethers.getSigners();
+
+  return { staker, mockUSDC, deployer, stakerAccount, otherAccount };
+}
+
+describe("Staker", function () {
+  it("deploys with a faithful local USDC mock", async function () {
+    const { staker, mockUSDC, deployer } = await networkHelpers.loadFixture(deployFixture);
+
+    expect(await staker.usdc()).to.equal(await mockUSDC.getAddress());
+    expect(await mockUSDC.name()).to.equal("USD Coin");
+    expect(await mockUSDC.symbol()).to.equal("USDC");
+    expect(await mockUSDC.decimals()).to.equal(6);
+    expect(await mockUSDC.balanceOf(deployer.address)).to.equal(1_000_000n * USDC);
+  });
+
+  it("lets users stake approved USDC and withdraw their full position", async function () {
+    const { staker, mockUSDC, stakerAccount } = await networkHelpers.loadFixture(deployFixture);
+    const stakeAmount = 250n * USDC;
+
+    await mockUSDC.transfer(stakerAccount.address, stakeAmount);
+    await mockUSDC.connect(stakerAccount).approve(await staker.getAddress(), stakeAmount);
+
+    await expect(staker.connect(stakerAccount).stake(stakeAmount))
+      .to.emit(staker, "Staked")
+      .withArgs(stakerAccount.address, stakeAmount);
+
+    expect(await staker.positions(stakerAccount.address)).to.equal(stakeAmount);
+    expect(await staker.totalStaked()).to.equal(stakeAmount);
+    expect(await mockUSDC.balanceOf(await staker.getAddress())).to.equal(stakeAmount);
+    expect(await mockUSDC.balanceOf(stakerAccount.address)).to.equal(0);
+
+    await expect(staker.connect(stakerAccount).withdraw())
+      .to.emit(staker, "Withdrawn")
+      .withArgs(stakerAccount.address, stakeAmount);
+
+    expect(await staker.positions(stakerAccount.address)).to.equal(0);
+    expect(await staker.totalStaked()).to.equal(0);
+    expect(await mockUSDC.balanceOf(await staker.getAddress())).to.equal(0);
+    expect(await mockUSDC.balanceOf(stakerAccount.address)).to.equal(stakeAmount);
+  });
+
+  it("tracks positions independently", async function () {
+    const { staker, mockUSDC, stakerAccount, otherAccount } = await networkHelpers.loadFixture(deployFixture);
+    const firstStake = 100n * USDC;
+    const secondStake = 75n * USDC;
+
+    await mockUSDC.transfer(stakerAccount.address, firstStake);
+    await mockUSDC.transfer(otherAccount.address, secondStake);
+    await mockUSDC.connect(stakerAccount).approve(await staker.getAddress(), firstStake);
+    await mockUSDC.connect(otherAccount).approve(await staker.getAddress(), secondStake);
+
+    await staker.connect(stakerAccount).stake(firstStake);
+    await staker.connect(otherAccount).stake(secondStake);
+    await staker.connect(stakerAccount).withdraw();
+
+    expect(await staker.positions(stakerAccount.address)).to.equal(0);
+    expect(await staker.positions(otherAccount.address)).to.equal(secondStake);
+    expect(await staker.totalStaked()).to.equal(secondStake);
+  });
+
+  it("rejects zero stakes and empty withdrawals", async function () {
+    const { staker, stakerAccount } = await networkHelpers.loadFixture(deployFixture);
+
+    await expect(staker.connect(stakerAccount).stake(0)).to.be.revertedWithCustomError(staker, "ZeroAmount");
+    await expect(staker.connect(stakerAccount).withdraw()).to.be.revertedWithCustomError(staker, "NoPosition");
+  });
+});
