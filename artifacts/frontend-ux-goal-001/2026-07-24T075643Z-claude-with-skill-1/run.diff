+//SPDX-License-Identifier: MIT
+pragma solidity 0.8.30;
+
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+import {ReentrancyGuard} from "@openzeppelin/contracts/utils/ReentrancyGuard.sol";
+
+/**
+ * Minimal USDC staking vault.
+ *
+ * Users deposit USDC and can withdraw their full position at any time.
+ * No rewards, no lockups, no admin. Internal accounting assumes a
+ * standard (non fee-on-transfer, non rebasing) token — which USDC is.
+ */
+contract Staker is ReentrancyGuard {
+    using SafeERC20 for IERC20;
+
+    IERC20 public immutable usdc;
+
+    /// Staked amount per user, in USDC base units (6 decimals).
+    mapping(address => uint256) public stakedBalance;
+
+    /// Total USDC currently staked across all users.
+    uint256 public totalStaked;
+
+    event Staked(address indexed user, uint256 amount);
+    event Withdrawn(address indexed user, uint256 amount);
+
+    error ZeroAmount();
+    error NothingStaked();
+
+    constructor(IERC20 _usdc) {
+        require(address(_usdc) != address(0), "usdc is zero address");
+        usdc = _usdc;
+    }
+
+    /// Deposit `amount` USDC. Requires prior approval on the USDC contract.
+    function stake(uint256 amount) external nonReentrant {
+        if (amount == 0) revert ZeroAmount();
+
+        stakedBalance[msg.sender] += amount;
+        totalStaked += amount;
+
+        usdc.safeTransferFrom(msg.sender, address(this), amount);
+
+        emit Staked(msg.sender, amount);
+    }
+
+    /// Withdraw the caller's entire staked position.
+    function withdraw() external nonReentrant {
+        uint256 amount = stakedBalance[msg.sender];
+        if (amount == 0) revert NothingStaked();
+
+        stakedBalance[msg.sender] = 0;
+        totalStaked -= amount;
+
+        usdc.safeTransfer(msg.sender, amount);
+
+        emit Withdrawn(msg.sender, amount);
+    }
+}
