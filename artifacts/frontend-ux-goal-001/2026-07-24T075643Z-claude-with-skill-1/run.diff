+"use client";
+
+import { useState } from "react";
+import type { NextPage } from "next";
+import { useConnectModal } from "@rainbow-me/rainbowkit";
+import { Address, Balance, BaseInput } from "@scaffold-ui/components";
+import { formatUnits, parseUnits } from "viem";
+import { useAccount, useSwitchChain } from "wagmi";
+import { ArrowDownTrayIcon, BanknotesIcon, WalletIcon } from "@heroicons/react/24/outline";
+import {
+  useDeployedContractInfo,
+  useScaffoldReadContract,
+  useScaffoldWriteContract,
+  useTargetNetwork,
+} from "~~/hooks/scaffold-eth";
+import { getParsedError, notification } from "~~/utils/scaffold-eth";
+
+const usd = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" });
+
+// USDC has 6 decimals — reject any input with more precision than the token supports.
+const USDC_DECIMALS = 6;
+const AMOUNT_REGEX = /^\d*\.?\d{0,6}$/;
+
+// Keep the approve button locked briefly after confirmation while the fresh
+// allowance propagates through the RPC cache, so the user can't double-submit.
+const APPROVE_COOLDOWN_MS = 4000;
+
+// USDC is a dollar stablecoin, so token units map ~1:1 to USD.
+const formatToken = (value: bigint | undefined, decimals: number) =>
+  value === undefined
+    ? "—"
+    : Number(formatUnits(value, decimals)).toLocaleString("en-US", {
+        minimumFractionDigits: 2,
+        maximumFractionDigits: 2,
+      });
+
+const formatUsd = (value: bigint | undefined, decimals: number) =>
+  value === undefined ? "" : usd.format(Number(formatUnits(value, decimals)));
+
+const Stake: NextPage = () => {
+  const { address, chain } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+  const { openConnectModal } = useConnectModal();
+  const { switchChain, isPending: isSwitching } = useSwitchChain();
+
+  const { data: stakerContract } = useDeployedContractInfo({ contractName: "Staker" });
+  const stakerAddress = stakerContract?.address;
+
+  const { data: usdcDecimals } = useScaffoldReadContract({ contractName: "USDC", functionName: "decimals" });
+  const decimals = usdcDecimals ?? USDC_DECIMALS;
+
+  const { data: walletBalance, refetch: refetchWallet } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "balanceOf",
+    args: [address],
+  });
+  const { data: allowance, refetch: refetchAllowance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "allowance",
+    args: [address, stakerAddress],
+  });
+  const { data: staked, refetch: refetchStaked } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "stakedBalance",
+    args: [address],
+  });
+
+  const { writeContractAsync: writeUsdc } = useScaffoldWriteContract({ contractName: "USDC" });
+  const { writeContractAsync: writeStaker } = useScaffoldWriteContract({ contractName: "Staker" });
+
+  const [amount, setAmount] = useState("");
+  const [isApproving, setIsApproving] = useState(false);
+  const [approveCooldown, setApproveCooldown] = useState(false);
+  const [isStaking, setIsStaking] = useState(false);
+  const [isWithdrawing, setIsWithdrawing] = useState(false);
+  const [txError, setTxError] = useState<string | null>(null);
+
+  // Parse the input safely — parseUnits throws on malformed values.
+  let parsedAmount: bigint | null = null;
+  try {
+    parsedAmount = amount ? parseUnits(amount, decimals) : null;
+  } catch {
+    parsedAmount = null;
+  }
+
+  const hasAmount = parsedAmount !== null && parsedAmount > 0n;
+  const exceedsBalance = hasAmount && walletBalance !== undefined && parsedAmount! > walletBalance;
+  const needsApproval = hasAmount && !exceedsBalance && allowance !== undefined && allowance < parsedAmount!;
+  const wrongNetwork = !!chain && chain.id !== targetNetwork.id;
+
+  const handleMax = () => {
+    if (walletBalance !== undefined) setAmount(formatUnits(walletBalance, decimals));
+  };
+
+  const handleApprove = async () => {
+    if (!parsedAmount || !stakerAddress) return;
+    setTxError(null);
+    try {
+      setIsApproving(true);
+      await writeUsdc({ functionName: "approve", args: [stakerAddress, parsedAmount] });
+      // Cover the confirmation → RPC-cache gap: keep the button locked while the
+      // fresh allowance propagates so the user can't double-submit.
+      setApproveCooldown(true);
+      await refetchAllowance();
+      setTimeout(() => setApproveCooldown(false), APPROVE_COOLDOWN_MS);
+    } catch (e) {
+      setTxError(getParsedError(e));
+    } finally {
+      setIsApproving(false);
+    }
+  };
+
+  const handleStake = async () => {
+    if (!parsedAmount) return;
+    setTxError(null);
+    try {
+      setIsStaking(true);
+      await writeStaker({ functionName: "stake", args: [parsedAmount] });
+      notification.success("Staked successfully");
+      setAmount("");
+      await Promise.all([refetchWallet(), refetchStaked(), refetchAllowance()]);
+    } catch (e) {
+      setTxError(getParsedError(e));
+    } finally {
+      setIsStaking(false);
+    }
+  };
+
+  const handleWithdraw = async () => {
+    setTxError(null);
+    try {
+      setIsWithdrawing(true);
+      await writeStaker({ functionName: "withdraw" });
+      notification.success("Withdrew your full position");
+      await Promise.all([refetchWallet(), refetchStaked()]);
+    } catch (e) {
+      setTxError(getParsedError(e));
+    } finally {
+      setIsWithdrawing(false);
+    }
+  };
+
+  const renderPrimaryAction = () => {
+    if (!address) {
+      return (
+        <button className="btn btn-primary w-full" onClick={openConnectModal} type="button">
+          Connect Wallet
+        </button>
+      );
+    }
+    if (wrongNetwork) {
+      return (
+        <button
+          className="btn btn-primary w-full"
+          disabled={isSwitching}
+          onClick={() => switchChain({ chainId: targetNetwork.id })}
+          type="button"
+        >
+          {isSwitching ? (
+            <>
+              <span className="loading loading-spinner loading-sm" /> Switching…
+            </>
+          ) : (
+            `Switch to ${targetNetwork.name}`
+          )}
+        </button>
+      );
+    }
+    if (!stakerAddress) {
+      return (
+        <button className="btn w-full" disabled type="button">
+          Staking not available on {chain?.name ?? "this network"}
+        </button>
+      );
+    }
+    if (needsApproval) {
+      const busy = isApproving || approveCooldown;
+      return (
+        <button className="btn btn-primary w-full" disabled={busy} onClick={handleApprove} type="button">
+          {isApproving ? (
+            <>
+              <span className="loading loading-spinner loading-sm" /> Approving…
+            </>
+          ) : approveCooldown ? (
+            <>
+              <span className="loading loading-spinner loading-sm" /> Confirming…
+            </>
+          ) : (
+            "Approve USDC"
+          )}
+        </button>
+      );
+    }
+    return (
+      <button
+        className="btn btn-primary w-full"
+        disabled={!hasAmount || exceedsBalance || isStaking}
+        onClick={handleStake}
+        type="button"
+      >
+        {isStaking ? (
+          <>
+            <span className="loading loading-spinner loading-sm" /> Staking…
+          </>
+        ) : (
+          "Stake"
+        )}
+      </button>
+    );
+  };
+
+  return (
+    <div className="flex flex-col items-center grow w-full px-4 py-10">
+      <div className="w-full max-w-lg">
+        <h1 className="text-center text-4xl font-bold mb-1">Stake USDC</h1>
+        <p className="text-center text-base-content/70 mb-8">
+          Deposit USDC and withdraw your full position anytime. No lockups.
+        </p>
+
+        {/* Account balances */}
+        <div className="card bg-base-100 shadow-md mb-6">
+          <div className="card-body gap-4">
+            <div className="flex items-center justify-between">
+              <span className="flex items-center gap-2 text-sm font-medium">
+                <WalletIcon className="h-4 w-4" /> Wallet USDC
+              </span>
+              <span className="text-right">
+                <span className="font-semibold">{formatToken(walletBalance, decimals)} USDC</span>
+                <span className="block text-xs text-base-content/60">~{formatUsd(walletBalance, decimals)}</span>
+              </span>
+            </div>
+
+            <div className="flex items-center justify-between">
+              <span className="flex items-center gap-2 text-sm font-medium">
+                <BanknotesIcon className="h-4 w-4" /> ETH{" "}
+                <span className="text-xs text-base-content/60">(for gas)</span>
+              </span>
+              {address ? <Balance address={address} chain={targetNetwork} /> : <span>—</span>}
+            </div>
+
+            <div className="divider my-0" />
+
+            <div className="flex items-center justify-between">
+              <span className="text-sm font-medium">Your staked position</span>
+              <span className="text-right">
+                <span className="font-semibold">{formatToken(staked, decimals)} USDC</span>
+                <span className="block text-xs text-base-content/60">~{formatUsd(staked, decimals)}</span>
+              </span>
+            </div>
+          </div>
+        </div>
+
+        {/* Stake */}
+        <div className="card bg-base-100 shadow-md mb-6">
+          <div className="card-body gap-3">
+            <span className="text-sm font-medium">Amount to stake</span>
+            <BaseInput
+              value={amount}
+              placeholder="0.00"
+              error={exceedsBalance}
+              onChange={next => {
+                // Numbers only, capped at USDC's 6 decimals so nothing is silently rounded.
+                if (next === "" || AMOUNT_REGEX.test(next)) setAmount(next);
+              }}
+              suffix={
+                <button
+                  className="btn btn-ghost btn-sm self-center mr-1"
+                  onClick={handleMax}
+                  disabled={!walletBalance}
+                  type="button"
+                >
+                  MAX
+                </button>
+              }
+            />
+            <div className="flex justify-between text-xs text-base-content/60 min-h-4">
+              <span>{hasAmount ? `~${usd.format(Number(amount))}` : ""}</span>
+              {exceedsBalance && <span className="text-error">Exceeds wallet balance</span>}
+            </div>
+
+            {renderPrimaryAction()}
+
+            {txError && (
+              <div className="alert alert-error text-sm py-2">
+                <span className="break-words">{txError}</span>
+              </div>
+            )}
+          </div>
+        </div>
+
+        {/* Withdraw */}
+        <div className="card bg-base-100 shadow-md">
+          <div className="card-body gap-3">
+            <span className="text-sm font-medium">Withdraw</span>
+            <p className="text-xs text-base-content/60">
+              Withdraws your entire staked position ({formatToken(staked, decimals)} USDC) back to your wallet.
+            </p>
+            <button
+              className="btn btn-outline btn-primary w-full"
+              disabled={!address || wrongNetwork || !staked || staked === 0n || isWithdrawing}
+              onClick={handleWithdraw}
+              type="button"
+            >
+              {isWithdrawing ? (
+                <>
+                  <span className="loading loading-spinner loading-sm" /> Withdrawing…
+                </>
+              ) : (
+                <>
+                  <ArrowDownTrayIcon className="h-4 w-4" /> Withdraw all
+                </>
+              )}
+            </button>
+          </div>
+        </div>
+
+        {stakerAddress && (
+          <div className="flex items-center justify-center gap-2 mt-6 text-xs text-base-content/50">
+            <span>Staking contract:</span>
+            <Address address={stakerAddress} size="xs" chain={targetNetwork} />
+          </div>
+        )}
+      </div>
+    </div>
+  );
+};
+
+export default Stake;
