+import { deployScript, artifacts } from "../rocketh/deploy.js";
+
+/**
+ * Real USDC token addresses by chainId. On these networks the Staker is wired
+ * to the production token instead of deploying a mock.
+ */
+const USDC_ADDRESSES: Record<number, `0x${string}`> = {
+  8453: "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913", // Base mainnet
+  84532: "0x036CbD53842c5426634e7929541eC2318f3dCF7e", // Base Sepolia (Circle test USDC)
+};
+
+/**
+ * Deploys the Staker contract wired to USDC.
+ *
+ * - On Base / Base Sepolia: uses the real USDC token.
+ * - On any other network (e.g. local hardhat): deploys a faithful 6-decimal
+ *   MockUSDC, registers it as "USDC" for the frontend, and seeds the deployer.
+ */
+export default deployScript(
+  async env => {
+    const { deployer } = env.namedAccounts;
+    const chainId = env.network.chain.id;
+
+    let usdcAddress = USDC_ADDRESSES[chainId];
+
+    if (!usdcAddress) {
+      const mockUsdc = await env.deploy("USDC", {
+        account: deployer,
+        artifact: artifacts.MockUSDC,
+        args: ["USD Coin", "USDC"],
+      });
+      usdcAddress = mockUsdc.address;
+
+      // Seed the deployer with 1,000,000 USDC (6 decimals) for local testing.
+      await env.execute(mockUsdc, {
+        account: deployer,
+        functionName: "mint",
+        args: [deployer, 1_000_000_000_000n],
+      });
+      console.log("🪙 Deployed MockUSDC at", usdcAddress);
+    } else {
+      console.log("🪙 Using real USDC at", usdcAddress);
+    }
+
+    const staker = await env.deploy("Staker", {
+      account: deployer,
+      artifact: artifacts.Staker,
+      args: [usdcAddress],
+    });
+    console.log("🏦 Deployed Staker at", staker.address);
+  },
+  {
+    tags: ["Staker", "USDC"],
+  },
+);
diff --git a/packages/hardhat/test/Staker.ts b/packages/hardhat/test/Staker.ts
new file mode 100644
index 0000000..d36ec04
--- /dev/null
+++ b/packages/hardhat/test/Staker.ts
@@ -0,0 +1,109 @@
+import { expect } from "chai";
+import { network } from "hardhat";
+import type { Abi_Staker } from "../generated/abis/Staker.js";
+import type { Abi_MockUSDC } from "../generated/abis/MockUSDC.js";
+import { loadAndExecuteDeploymentsFromFiles } from "../rocketh/environment.js";
+
+const { provider, networkHelpers, ethers } = await network.create();
+
+const usdc = (n: string) => ethers.parseUnits(n, 6);
+
+async function deployFixture() {
+  const env = await loadAndExecuteDeploymentsFromFiles({ provider });
+
+  const stakerDeployment = env.get<Abi_Staker>("Staker");
+  const usdcDeployment = env.get<Abi_MockUSDC>("USDC");
+
+  const staker = await ethers.getContractAt(stakerDeployment.abi, stakerDeployment.address);
+  const token = await ethers.getContractAt(usdcDeployment.abi, usdcDeployment.address);
+
+  const [deployer, alice] = await ethers.getSigners();
+  // deployer is seeded with 1,000,000 USDC by the deploy script. Give alice some.
+  await token.transfer(alice.address, usdc("1000"));
+
+  return { staker, token, deployer, alice };
+}
+
+describe("Staker", function () {
+  it("Uses a 6-decimal USDC token", async function () {
+    const { token } = await networkHelpers.loadFixture(deployFixture);
+    expect(await token.decimals()).to.equal(6);
+    expect(await token.symbol()).to.equal("USDC");
+  });
+
+  it("Wires the Staker to the USDC address", async function () {
+    const { staker, token } = await networkHelpers.loadFixture(deployFixture);
+    expect(await staker.usdc()).to.equal(await token.getAddress());
+  });
+
+  it("Stakes USDC after approval and tracks the position", async function () {
+    const { staker, token, alice } = await networkHelpers.loadFixture(deployFixture);
+    const stakerAddress = await staker.getAddress();
+
+    await token.connect(alice).approve(stakerAddress, usdc("250"));
+    await expect(staker.connect(alice).stake(usdc("250")))
+      .to.emit(staker, "Staked")
+      .withArgs(alice.address, usdc("250"));
+
+    expect(await staker.stakedBalance(alice.address)).to.equal(usdc("250"));
+    expect(await staker.totalStaked()).to.equal(usdc("250"));
+    expect(await token.balanceOf(stakerAddress)).to.equal(usdc("250"));
+    expect(await token.balanceOf(alice.address)).to.equal(usdc("750"));
+  });
+
+  it("Withdraws the full position", async function () {
+    const { staker, token, alice } = await networkHelpers.loadFixture(deployFixture);
+    const stakerAddress = await staker.getAddress();
+
+    await token.connect(alice).approve(stakerAddress, usdc("250"));
+    await staker.connect(alice).stake(usdc("250"));
+
+    await expect(staker.connect(alice).withdraw())
+      .to.emit(staker, "Withdrawn")
+      .withArgs(alice.address, usdc("250"));
+
+    expect(await staker.stakedBalance(alice.address)).to.equal(0n);
+    expect(await staker.totalStaked()).to.equal(0n);
+    expect(await token.balanceOf(alice.address)).to.equal(usdc("1000"));
+  });
+
+  it("Accumulates across multiple stakes", async function () {
+    const { staker, token, alice } = await networkHelpers.loadFixture(deployFixture);
+    const stakerAddress = await staker.getAddress();
+
+    await token.connect(alice).approve(stakerAddress, usdc("300"));
+    await staker.connect(alice).stake(usdc("100"));
+    await staker.connect(alice).stake(usdc("200"));
+
+    expect(await staker.stakedBalance(alice.address)).to.equal(usdc("300"));
+  });
+
+  it("Reverts when staking zero", async function () {
+    const { staker, alice } = await networkHelpers.loadFixture(deployFixture);
+    await expect(staker.connect(alice).stake(0n)).to.be.revertedWithCustomError(staker, "ZeroAmount");
+  });
+
+  it("Reverts when withdrawing with no position", async function () {
+    const { staker, alice } = await networkHelpers.loadFixture(deployFixture);
+    await expect(staker.connect(alice).withdraw()).to.be.revertedWithCustomError(staker, "NothingStaked");
+  });
+
+  it("Keeps user positions independent", async function () {
+    const { staker, token, deployer, alice } = await networkHelpers.loadFixture(deployFixture);
+    const stakerAddress = await staker.getAddress();
+
+    await token.connect(alice).approve(stakerAddress, usdc("400"));
+    await staker.connect(alice).stake(usdc("400"));
+
+    await token.connect(deployer).approve(stakerAddress, usdc("100"));
+    await staker.connect(deployer).stake(usdc("100"));
+
+    expect(await staker.stakedBalance(alice.address)).to.equal(usdc("400"));
+    expect(await staker.stakedBalance(deployer.address)).to.equal(usdc("100"));
+    expect(await staker.totalStaked()).to.equal(usdc("500"));
+
+    await staker.connect(alice).withdraw();
+    expect(await staker.stakedBalance(deployer.address)).to.equal(usdc("100"));
+    expect(await staker.totalStaked()).to.equal(usdc("100"));
+  });
+});
