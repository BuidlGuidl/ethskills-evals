+//SPDX-License-Identifier: MIT
+pragma solidity 0.8.30;
+
+import {ERC20} from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+
+/**
+ * Local-development stand-in for USDC.
+ *
+ * Kept faithful to the real token where it matters for a frontend:
+ * 6 decimals, "USD Coin" / "USDC" metadata, standard ERC20 semantics.
+ * Adds an open `mint` so developers can fund test accounts. Do NOT deploy
+ * to a live network — the real USDC (0x8335...) is used there.
+ */
+contract MockUSDC is ERC20 {
+    constructor(string memory name_, string memory symbol_) ERC20(name_, symbol_) {}
+
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    function mint(address to, uint256 amount) external {
+        _mint(to, amount);
+    }
+}
