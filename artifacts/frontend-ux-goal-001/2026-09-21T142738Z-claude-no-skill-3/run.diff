+"use client";
+
+import { useEffect, useState } from "react";
+import { Address, Balance } from "@scaffold-ui/components";
+import { erc20Abi, formatUnits, parseEther, parseUnits, zeroAddress } from "viem";
+import { useAccount, useBalance, useBlockNumber, useReadContracts, useSwitchChain, useWriteContract } from "wagmi";
+import { RainbowKitCustomConnectButton } from "~~/components/scaffold-eth";
+import {
+  useDeployedContractInfo,
+  useScaffoldReadContract,
+  useScaffoldWriteContract,
+  useTargetNetwork,
+  useTransactor,
+} from "~~/hooks/scaffold-eth";
+
+const USDC_DECIMALS = 6;
+// Below this, the user may not be able to pay for approve + stake on Base
+const LOW_GAS_THRESHOLD = parseEther("0.0001");
+const AMOUNT_REGEX = new RegExp(`^\\d*\\.?\\d{0,${USDC_DECIMALS}}$`);
+
+// "1234.5" -> "1,234.50". Keeps full precision (formatUnits drops trailing zeros).
+const formatUsdc = (value: bigint) => {
+  const [whole, fraction = ""] = formatUnits(value, USDC_DECIMALS).split(".");
+  return `${BigInt(whole).toLocaleString("en-US")}.${fraction.padEnd(2, "0")}`;
+};
+
+const parseAmount = (amount: string) => {
+  if (!amount || amount === ".") return undefined;
+  try {
+    return parseUnits(amount, USDC_DECIMALS);
+  } catch {
+    return undefined;
+  }
+};
+
+const Stat = ({ title, value, description }: { title: string; value: React.ReactNode; description?: string }) => (
+  <div className="stat">
+    <div className="stat-title">{title}</div>
+    <div className="stat-value text-2xl">{value}</div>
+    {description && <div className="stat-desc">{description}</div>}
+  </div>
+);
+
+const Loading = () => <span className="loading loading-dots loading-sm" />;
+
+export const StakeDashboard = () => {
+  const { address: userAddress, chain: walletChain, status } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+  const { switchChain, isPending: isSwitching } = useSwitchChain();
+  const isWrongNetwork = status === "connected" && walletChain?.id !== targetNetwork.id;
+
+  const [amount, setAmount] = useState("");
+  const [step, setStep] = useState<"idle" | "approving" | "staking" | "withdrawing">("idle");
+
+  const { data: staker, isLoading: isStakerLoading } = useDeployedContractInfo({ contractName: "Staker" });
+
+  // The token address comes from the Staker itself, so the UI can never approve a different token than it pulls
+  // Reads refresh from the single block watcher below instead of one watcher per hook
+  const { data: tokenAddress, isError: isTokenAddressError } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "token",
+    watch: false,
+  });
+  const {
+    data: stakedBalance,
+    isError: isStakedError,
+    refetch: refetchStaked,
+  } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "stakedBalance",
+    args: [userAddress],
+    watch: false,
+  });
+  const { data: totalStaked, refetch: refetchTotalStaked } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "totalStaked",
+    watch: false,
+  });
+
+  const tokenReadsEnabled = !!tokenAddress && !!userAddress && !!staker;
+  const {
+    data: tokenData,
+    isError: isTokenError,
+    refetch: refetchToken,
+  } = useReadContracts({
+    allowFailure: false,
+    contracts: [
+      {
+        address: tokenAddress,
+        abi: erc20Abi,
+        functionName: "balanceOf",
+        args: [userAddress ?? zeroAddress],
+        chainId: targetNetwork.id,
+      },
+      {
+        address: tokenAddress,
+        abi: erc20Abi,
+        functionName: "allowance",
+        args: [userAddress ?? zeroAddress, staker?.address ?? zeroAddress],
+        chainId: targetNetwork.id,
+      },
+    ],
+    query: { enabled: tokenReadsEnabled },
+  });
+  const [usdcBalance, allowance] = tokenData ?? [];
+
+  const { data: ethBalance, refetch: refetchEth } = useBalance({
+    address: userAddress,
+    chainId: targetNetwork.id,
+  });
+
+  // Keep wallet balances fresh (e.g. user receives USDC or ETH while the page is open)
+  const { data: blockNumber } = useBlockNumber({ watch: true, chainId: targetNetwork.id });
+  useEffect(() => {
+    if (!staker) return;
+    refetchTotalStaked();
+    if (!userAddress) return;
+    refetchStaked();
+    refetchEth();
+    if (tokenReadsEnabled) refetchToken();
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [blockNumber]);
+
+  const { writeContractAsync: writeToken } = useWriteContract();
+  const transactor = useTransactor();
+  const { writeContractAsync: writeStaker } = useScaffoldWriteContract({
+    contractName: "Staker",
+  });
+
+  const parsedAmount = parseAmount(amount);
+  const needsApproval = parsedAmount !== undefined && allowance !== undefined && allowance < parsedAmount;
+  const isBusy = step !== "idle";
+  const hasReadError = isTokenAddressError || isStakedError || isTokenError;
+  // Only a warning, not a hard block: smart wallets with a paymaster can transact without ETH
+  const hasNoGas = ethBalance !== undefined && ethBalance.value === 0n;
+  const hasLowGas = ethBalance !== undefined && ethBalance.value < LOW_GAS_THRESHOLD;
+
+  let amountError: string | undefined;
+  if (amount && parsedAmount === undefined) amountError = "Enter a valid amount";
+  else if (parsedAmount === 0n) amountError = "Amount must be greater than 0";
+  else if (parsedAmount !== undefined && usdcBalance !== undefined && parsedAmount > usdcBalance)
+    amountError = "Amount exceeds your USDC balance";
+
+  const canStake =
+    parsedAmount !== undefined &&
+    parsedAmount > 0n &&
+    !amountError &&
+    usdcBalance !== undefined &&
+    allowance !== undefined &&
+    !isBusy;
+
+  const handleAmountChange = (value: string) => {
+    // Accept pasted "1,000.50" / " 100 " as well as "1,5" as a decimal comma
+    let normalized = value.replace(/\s/g, "");
+    normalized = normalized.includes(".") ? normalized.replace(/,/g, "") : normalized.replace(",", ".");
+    if (AMOUNT_REGEX.test(normalized)) setAmount(normalized);
+  };
+
+  const handleStake = async () => {
+    if (!parsedAmount || !tokenAddress || !staker) return;
+    try {
+      if (needsApproval) {
+        setStep("approving");
+        // Approve the exact amount only, never an unlimited allowance
+        const approveHash = await transactor(() =>
+          writeToken({
+            address: tokenAddress,
+            abi: erc20Abi,
+            functionName: "approve",
+            args: [staker.address, parsedAmount],
+            chainId: targetNetwork.id,
+          }),
+        );
+        if (!approveHash) return;
+        // A load-balanced RPC node may lag a block behind; wait until it sees the new allowance before simulating stake
+        for (let attempt = 0; attempt < 5; attempt++) {
+          const { data } = await refetchToken();
+          if (data && data[1] >= parsedAmount) break;
+          await new Promise(resolve => setTimeout(resolve, 1000));
+        }
+      }
+      setStep("staking");
+      const txHash = await writeStaker({ functionName: "stake", args: [parsedAmount] });
+      if (txHash) setAmount("");
+    } catch {
+      // useTransactor already surfaces a readable error notification
+    } finally {
+      setStep("idle");
+      refetchToken();
+      refetchStaked();
+    }
+  };
+
+  const handleWithdraw = async () => {
+    try {
+      setStep("withdrawing");
+      await writeStaker({ functionName: "withdraw" });
+    } catch {
+      // useTransactor already surfaces a readable error notification
+    } finally {
+      setStep("idle");
+      refetchToken();
+      refetchStaked();
+    }
+  };
+
+  if (!isStakerLoading && !staker) {
+    return (
+      <div role="alert" className="alert alert-warning max-w-xl">
+        <span>Staking is not available on {targetNetwork.name} yet. Please check back soon.</span>
+      </div>
+    );
+  }
+
+  const stakeButtonLabel = () => {
+    if (step === "approving") return "Approving USDC…";
+    if (step === "staking") return "Staking…";
+    if (needsApproval) return "Approve & stake";
+    return "Stake";
+  };
+
+  return (
+    <div className="w-full max-w-xl flex flex-col gap-6">
+      <div>
+        <h1 className="text-3xl font-bold mb-1">Stake USDC</h1>
+        <p className="text-base-content/70 m-0">
+          Deposit USDC on {targetNetwork.name}. Withdraw your full position at any time.
+        </p>
+      </div>
+
+      {!userAddress ? (
+        <div className="card bg-base-100 shadow-md">
+          <div className="card-body items-center text-center">
+            <p>Connect your wallet to stake USDC and see your balances.</p>
+            <RainbowKitCustomConnectButton />
+          </div>
+        </div>
+      ) : (
+        <>
+          {hasReadError && (
+            <div role="alert" className="alert alert-error">
+              <span>Couldn&apos;t load your balances. Check your connection and try again.</span>
+              <button
+                className="btn btn-sm"
+                onClick={() => {
+                  refetchStaked();
+                  refetchToken();
+                }}
+              >
+                Retry
+              </button>
+            </div>
+          )}
+
+          {isWrongNetwork && (
+            <div role="alert" className="alert alert-warning">
+              <span>Your wallet is connected to {walletChain?.name ?? "an unsupported network"}.</span>
+              <button
+                className="btn btn-sm"
+                disabled={isSwitching}
+                onClick={() => switchChain({ chainId: targetNetwork.id })}
+              >
+                {isSwitching ? <span className="loading loading-spinner loading-xs" /> : null}
+                Switch to {targetNetwork.name}
+              </button>
+            </div>
+          )}
+
+          <div className="stats stats-vertical sm:stats-horizontal shadow-md bg-base-100">
+            <Stat
+              title="Wallet USDC"
+              value={usdcBalance !== undefined ? formatUsdc(usdcBalance) : <Loading />}
+              description="Available to stake"
+            />
+            <Stat
+              title="Staked"
+              value={stakedBalance !== undefined ? formatUsdc(stakedBalance) : <Loading />}
+              description="Your position"
+            />
+            <div className="stat">
+              <div className="stat-title">ETH (for gas)</div>
+              <div className="stat-value text-2xl">
+                <Balance address={userAddress} chain={targetNetwork} />
+              </div>
+            </div>
+          </div>
+
+          {hasLowGas && (
+            <div role="alert" className="alert alert-warning">
+              <span>
+                {hasNoGas ? "You have no ETH" : "Your ETH balance is low"} on {targetNetwork.name}. You need a small
+                amount of ETH on {targetNetwork.name} to pay network fees for staking and withdrawing.
+              </span>
+            </div>
+          )}
+
+          <div className="card bg-base-100 shadow-md">
+            <div className="card-body gap-4">
+              <h2 className="card-title">Stake</h2>
+              <fieldset className="fieldset p-0">
+                <legend className="fieldset-legend flex justify-between w-full">
+                  <span>Amount</span>
+                  <span className="font-normal">
+                    Balance: {usdcBalance !== undefined ? `${formatUsdc(usdcBalance)} USDC` : "…"}
+                  </span>
+                </legend>
+                <div className="join w-full">
+                  <label className={`input join-item w-full ${amountError ? "input-error" : ""}`}>
+                    <input
+                      type="text"
+                      inputMode="decimal"
+                      autoComplete="off"
+                      placeholder="0.00"
+                      value={amount}
+                      disabled={isBusy}
+                      onChange={e => handleAmountChange(e.target.value)}
+                      aria-invalid={!!amountError}
+                    />
+                    <span className="opacity-60">USDC</span>
+                  </label>
+                  <button
+                    className="btn join-item"
+                    disabled={isBusy || !usdcBalance}
+                    onClick={() => usdcBalance !== undefined && setAmount(formatUnits(usdcBalance, USDC_DECIMALS))}
+                  >
+                    Max
+                  </button>
+                </div>
+                <p className={`label min-h-4 ${amountError ? "text-error" : ""}`}>
+                  {amountError ??
+                    (needsApproval && !isBusy ? "You'll confirm two transactions: approve USDC, then stake." : "")}
+                </p>
+              </fieldset>
+              <button className="btn btn-primary w-full" disabled={!canStake || isWrongNetwork} onClick={handleStake}>
+                {(step === "approving" || step === "staking") && (
+                  <span className="loading loading-spinner loading-sm" />
+                )}
+                {stakeButtonLabel()}
+              </button>
+            </div>
+          </div>
+
+          <div className="card bg-base-100 shadow-md">
+            <div className="card-body gap-4">
+              <h2 className="card-title">Withdraw</h2>
+              <p className="m-0 text-base-content/70">Withdraws your entire staked position back to your wallet.</p>
+              <button
+                className="btn btn-outline w-full"
+                disabled={!stakedBalance || isBusy || isWrongNetwork}
+                onClick={handleWithdraw}
+              >
+                {step === "withdrawing" && <span className="loading loading-spinner loading-sm" />}
+                {step === "withdrawing"
+                  ? "Withdrawing…"
+                  : stakedBalance
+                    ? `Withdraw ${formatUsdc(stakedBalance)} USDC`
+                    : "Nothing to withdraw"}
+              </button>
+            </div>
+          </div>
+        </>
+      )}
+
+      <div className="text-sm text-base-content/70 flex flex-col gap-2">
+        <div className="flex flex-wrap items-center gap-2">
+          Total staked: {totalStaked !== undefined ? `${formatUsdc(totalStaked)} USDC` : <Loading />}
+        </div>
+        {staker && (
+          <div className="flex flex-wrap items-center gap-2">
+            Staking contract: <Address address={staker.address} chain={targetNetwork} size="sm" />
+          </div>
+        )}
+        {tokenAddress && (
+          <div className="flex flex-wrap items-center gap-2">
+            USDC token: <Address address={tokenAddress} chain={targetNetwork} size="sm" />
+          </div>
+        )}
+      </div>
+    </div>
+  );
+};
