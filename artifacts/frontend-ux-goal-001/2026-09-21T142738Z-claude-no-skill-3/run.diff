+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.30;
+
+import { ERC20 } from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+
+/**
+ * @notice LOCAL DEVELOPMENT ONLY. Mirrors the parts of Base USDC the app relies on:
+ * name "USD Coin", symbol "USDC", 6 decimals, standard ERC20 approve/transferFrom semantics.
+ * Anyone can mint, so never deploy this to a live network.
+ */
+contract MockUSDC is ERC20 {
+    constructor() ERC20("USD Coin", "USDC") {}
+
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    function mint(address to, uint256 amount) external {
+        _mint(to, amount);
+    }
+}
