+import { deployScript, artifacts } from "../rocketh/deploy.js";
+
+// Circle's native USDC
+const USDC_ADDRESSES: Record<number, `0x${string}`> = {
+  8453: "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913", // Base
+  84532: "0x036CbD53842c5426634e7929541eC2318f3dCF7e", // Base Sepolia
+};
+const LOCAL_CHAIN_IDS = [31337];
+
+/**
+ * Deploys Staker against real USDC on Base (and Base Sepolia).
+ * On the local chain it first deploys MockUSDC; on any other network it refuses to deploy.
+ */
+export default deployScript(
+  async env => {
+    const { deployer } = env.namedAccounts;
+    const chainId = env.network.chain.id;
+
+    let usdcAddress = USDC_ADDRESSES[chainId];
+    if (!usdcAddress) {
+      if (!LOCAL_CHAIN_IDS.includes(chainId)) {
+        throw new Error(`No USDC address configured for chain ${chainId}. Add it to USDC_ADDRESSES.`);
+      }
+      const mockUsdc = await env.deploy("MockUSDC", {
+        account: deployer,
+        artifact: artifacts.MockUSDC,
+        args: [],
+      });
+      usdcAddress = mockUsdc.address;
+      console.log("🪙 MockUSDC deployed. Mint test USDC from the Debug Contracts page.");
+    }
+
+    const staker = await env.deploy("Staker", {
+      account: deployer,
+      artifact: artifacts.Staker,
+      args: [usdcAddress],
+    });
+    console.log(`🥩 Staker deployed at ${staker.address} using USDC ${usdcAddress}`);
+  },
+  {
+    tags: ["Staker"],
+  },
+);
