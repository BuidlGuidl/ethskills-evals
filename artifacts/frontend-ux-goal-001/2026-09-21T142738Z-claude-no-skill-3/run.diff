@@ -0,0 +1,85 @@
+import { expect } from "chai";
+import { network } from "hardhat";
+import { loadAndExecuteDeploymentsFromFiles } from "../rocketh/environment.js";
+
+const { provider, networkHelpers, ethers } = await network.create();
+
+const usdc = (amount: string) => ethers.parseUnits(amount, 6);
+
+async function deployFixture() {
+  const env = await loadAndExecuteDeploymentsFromFiles({ provider });
+  const [, alice, bob] = await ethers.getSigners();
+
+  const token = await ethers.getContractAt("MockUSDC", env.get("MockUSDC").address);
+  const staker = await ethers.getContractAt("Staker", env.get("Staker").address);
+
+  for (const user of [alice, bob]) {
+    await token.mint(user.address, usdc("1000"));
+    await token.connect(user).approve(await staker.getAddress(), ethers.MaxUint256);
+  }
+
+  return { token, staker, alice, bob };
+}
+
+describe("Staker", function () {
+  it("uses a 6-decimals USDC mock", async function () {
+    const { token, staker } = await networkHelpers.loadFixture(deployFixture);
+    expect(await token.decimals()).to.equal(6n);
+    expect(await token.symbol()).to.equal("USDC");
+    expect(await staker.token()).to.equal(ethers.getAddress(await token.getAddress()));
+  });
+
+  it("stakes and tracks positions per user", async function () {
+    const { token, staker, alice, bob } = await networkHelpers.loadFixture(deployFixture);
+
+    await expect(staker.connect(alice).stake(usdc("100")))
+      .to.emit(staker, "Staked")
+      .withArgs(alice.address, usdc("100"));
+    await staker.connect(alice).stake(usdc("50.5"));
+    await staker.connect(bob).stake(usdc("10"));
+
+    expect(await staker.stakedBalance(alice.address)).to.equal(usdc("150.5"));
+    expect(await staker.stakedBalance(bob.address)).to.equal(usdc("10"));
+    expect(await staker.totalStaked()).to.equal(usdc("160.5"));
+    expect(await token.balanceOf(await staker.getAddress())).to.equal(usdc("160.5"));
+  });
+
+  it("withdraws the full position", async function () {
+    const { token, staker, alice, bob } = await networkHelpers.loadFixture(deployFixture);
+    await staker.connect(alice).stake(usdc("100"));
+    await staker.connect(bob).stake(usdc("10"));
+
+    await expect(staker.connect(alice).withdraw()).to.emit(staker, "Withdrawn").withArgs(alice.address, usdc("100"));
+
+    expect(await staker.stakedBalance(alice.address)).to.equal(0n);
+    expect(await staker.totalStaked()).to.equal(usdc("10"));
+    expect(await token.balanceOf(alice.address)).to.equal(usdc("1000"));
+  });
+
+  it("stakes with an exact-amount approval, as the UI does", async function () {
+    const { token, staker, alice } = await networkHelpers.loadFixture(deployFixture);
+    await token.connect(alice).approve(await staker.getAddress(), usdc("25"));
+    await staker.connect(alice).stake(usdc("25"));
+    expect(await staker.stakedBalance(alice.address)).to.equal(usdc("25"));
+    expect(await token.allowance(alice.address, await staker.getAddress())).to.equal(0n);
+  });
+
+  it("reverts on zero stake and empty withdraw", async function () {
+    const { staker, alice } = await networkHelpers.loadFixture(deployFixture);
+    await expect(staker.connect(alice).stake(0)).to.be.revertedWithCustomError(staker, "ZeroAmount");
+    await expect(staker.connect(alice).withdraw()).to.be.revertedWithCustomError(staker, "NothingStaked");
+  });
+
+  it("reverts when allowance or balance is insufficient", async function () {
+    const { token, staker, alice } = await networkHelpers.loadFixture(deployFixture);
+    await expect(staker.connect(alice).stake(usdc("1000.000001"))).to.be.revertedWithCustomError(
+      token,
+      "ERC20InsufficientBalance",
+    );
+    await token.connect(alice).approve(await staker.getAddress(), usdc("1"));
+    await expect(staker.connect(alice).stake(usdc("2"))).to.be.revertedWithCustomError(
+      token,
+      "ERC20InsufficientAllowance",
+    );
+  });
+});
