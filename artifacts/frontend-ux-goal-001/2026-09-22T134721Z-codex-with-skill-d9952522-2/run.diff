+import { deployScript, artifacts } from "../rocketh/deploy.js";
+
+const BASE_CHAIN_ID = 8453;
+const BASE_USDC_ADDRESS = "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913" as const;
+const LOCAL_USDC_SUPPLY = 1_000_000n * 10n ** 6n;
+
+export default deployScript(
+  async env => {
+    const { deployer } = env.namedAccounts;
+
+    let usdcAddress: `0x${string}` = BASE_USDC_ADDRESS;
+
+    if (env.network.chain.id !== BASE_CHAIN_ID) {
+      const mockUsdc = await env.deploy("MockUSDC", {
+        account: deployer,
+        artifact: artifacts.MockUSDC,
+        args: [deployer, LOCAL_USDC_SUPPLY],
+      });
+
+      usdcAddress = mockUsdc.address;
+      console.log("Local MockUSDC:", usdcAddress);
+    }
+
+    const staker = await env.deploy("Staker", {
+      account: deployer,
+      artifact: artifacts.Staker,
+      args: [usdcAddress],
+    });
+
+    console.log("Staker:", staker.address);
+    console.log("USDC:", usdcAddress);
+  },
+  {
+    tags: ["Staker"],
+  },
+);
