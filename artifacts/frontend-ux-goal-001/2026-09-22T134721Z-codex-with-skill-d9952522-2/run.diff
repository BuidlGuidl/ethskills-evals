+"use client";
+
+import { useMemo, useState } from "react";
+import { Address, Balance } from "@scaffold-ui/components";
+import { useFetchNativeCurrencyPrice } from "@scaffold-ui/hooks";
+import type { NextPage } from "next";
+import { formatUnits, parseUnits, zeroAddress } from "viem";
+import { useAccount, useBalance, useSwitchChain } from "wagmi";
+import {
+  ArrowDownTrayIcon,
+  ArrowPathIcon,
+  CheckCircleIcon,
+  ExclamationTriangleIcon,
+} from "@heroicons/react/24/outline";
+import {
+  useDeployedContractInfo,
+  useScaffoldReadContract,
+  useScaffoldWriteContract,
+  useTargetNetwork,
+} from "~~/hooks/scaffold-eth";
+import { getParsedError } from "~~/utils/scaffold-eth";
+
+const USDC_DECIMALS = 6;
+const USDC_PRICE_USD = 1;
+
+const formatTokenAmount = (value?: bigint, maximumFractionDigits = 6) => {
+  if (value === undefined) {
+    return "0";
+  }
+
+  return Number(formatUnits(value, USDC_DECIMALS)).toLocaleString(undefined, {
+    maximumFractionDigits,
+  });
+};
+
+const formatUsd = (value: number) =>
+  value.toLocaleString(undefined, {
+    style: "currency",
+    currency: "USD",
+    maximumFractionDigits: 2,
+  });
+
+const parseUsdcInput = (value: string) => {
+  const trimmedValue = value.trim();
+
+  if (!trimmedValue) {
+    return 0n;
+  }
+
+  if (!/^\d+(\.\d{0,6})?$/.test(trimmedValue)) {
+    return undefined;
+  }
+
+  return parseUnits(trimmedValue, USDC_DECIMALS);
+};
+
+type PendingAction = "approve" | "stake" | "withdraw" | "switch";
+
+const Stake: NextPage = () => {
+  const [stakeAmount, setStakeAmount] = useState("");
+  const [pendingAction, setPendingAction] = useState<PendingAction>();
+  const [actionError, setActionError] = useState<string>();
+
+  const { address, chain } = useAccount();
+  const { switchChainAsync } = useSwitchChain();
+  const { targetNetwork } = useTargetNetwork();
+  const { price: nativeCurrencyPrice, isError: isNativePriceError } = useFetchNativeCurrencyPrice(targetNetwork);
+  const { data: stakerContract } = useDeployedContractInfo({ contractName: "Staker" });
+
+  const stakerAddress = stakerContract?.address;
+  const isStakerConfigured = Boolean(stakerAddress && stakerAddress !== zeroAddress);
+  const isWrongNetwork = Boolean(address && chain?.id !== targetNetwork.id);
+  const amountToStake = useMemo(() => parseUsdcInput(stakeAmount), [stakeAmount]);
+
+  const { data: nativeBalance } = useBalance({
+    address,
+    chainId: targetNetwork.id,
+    query: {
+      enabled: Boolean(address),
+    },
+  });
+
+  const {
+    data: usdcBalance,
+    isLoading: isUsdcBalanceLoading,
+    refetch: refetchUsdcBalance,
+  } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "balanceOf",
+    args: [address],
+    query: {
+      enabled: Boolean(address),
+    },
+  });
+
+  const {
+    data: allowance,
+    isLoading: isAllowanceLoading,
+    refetch: refetchAllowance,
+  } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "allowance",
+    args: [address, stakerAddress],
+    query: {
+      enabled: Boolean(address && isStakerConfigured),
+    },
+  });
+
+  const {
+    data: stakedPosition,
+    isLoading: isPositionLoading,
+    refetch: refetchStakedPosition,
+  } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "positionOf",
+    args: [address],
+    query: {
+      enabled: Boolean(address && isStakerConfigured),
+    },
+  });
+
+  const { writeContractAsync: approveUsdcAsync } = useScaffoldWriteContract({
+    contractName: "USDC",
+  });
+  const { writeContractAsync: writeStakerAsync } = useScaffoldWriteContract({
+    contractName: "Staker",
+  });
+
+  const refetchPositionState = async () => {
+    await Promise.all([refetchUsdcBalance(), refetchAllowance(), refetchStakedPosition()]);
+  };
+
+  const amountError = useMemo(() => {
+    if (!stakeAmount.trim()) {
+      return undefined;
+    }
+
+    if (amountToStake === undefined) {
+      return "Enter a USDC amount with no more than 6 decimals.";
+    }
+
+    if (amountToStake === 0n) {
+      return "Enter more than 0 USDC.";
+    }
+
+    if (usdcBalance !== undefined && amountToStake > usdcBalance) {
+      return "Amount exceeds your wallet USDC balance.";
+    }
+
+    return undefined;
+  }, [amountToStake, stakeAmount, usdcBalance]);
+
+  const needsApproval = Boolean(amountToStake && allowance !== undefined && amountToStake > allowance);
+  const canStake = Boolean(
+    address && !isWrongNetwork && isStakerConfigured && amountToStake && amountToStake > 0n && !amountError,
+  );
+  const canWithdraw = Boolean(
+    address && !isWrongNetwork && isStakerConfigured && stakedPosition && stakedPosition > 0n,
+  );
+  const nativeUsdValue =
+    nativeBalance && nativeCurrencyPrice > 0 ? Number(nativeBalance.formatted) * nativeCurrencyPrice : undefined;
+
+  const handleSwitchNetwork = async () => {
+    setActionError(undefined);
+    setPendingAction("switch");
+
+    try {
+      await switchChainAsync({ chainId: targetNetwork.id });
+    } catch (error) {
+      setActionError(getParsedError(error));
+    } finally {
+      setPendingAction(undefined);
+    }
+  };
+
+  const handleApprove = async () => {
+    if (!amountToStake || !stakerAddress) {
+      return;
+    }
+
+    setActionError(undefined);
+    setPendingAction("approve");
+
+    try {
+      await approveUsdcAsync({
+        functionName: "approve",
+        args: [stakerAddress, amountToStake],
+      });
+      await refetchAllowance();
+    } catch (error) {
+      setActionError(getParsedError(error));
+    } finally {
+      setPendingAction(undefined);
+    }
+  };
+
+  const handleStake = async () => {
+    if (!amountToStake) {
+      return;
+    }
+
+    setActionError(undefined);
+    setPendingAction("stake");
+
+    try {
+      await writeStakerAsync({
+        functionName: "stake",
+        args: [amountToStake],
+      });
+      setStakeAmount("");
+      await refetchPositionState();
+    } catch (error) {
+      setActionError(getParsedError(error));
+    } finally {
+      setPendingAction(undefined);
+    }
+  };
+
+  const handleWithdraw = async () => {
+    setActionError(undefined);
+    setPendingAction("withdraw");
+
+    try {
+      await writeStakerAsync({
+        functionName: "withdraw",
+      });
+      await refetchPositionState();
+    } catch (error) {
+      setActionError(getParsedError(error));
+    } finally {
+      setPendingAction(undefined);
+    }
+  };
+
+  const handlePrimaryStakeAction = async () => {
+    if (isWrongNetwork) {
+      await handleSwitchNetwork();
+      return;
+    }
+
+    if (needsApproval) {
+      await handleApprove();
+      return;
+    }
+
+    await handleStake();
+  };
+
+  const stakeButtonLabel = (() => {
+    if (!address) return "Connect wallet";
+    if (isWrongNetwork) return pendingAction === "switch" ? "Switching..." : "Switch to Base";
+    if (!isStakerConfigured) return "Staker not configured";
+    if (!amountToStake || amountToStake === 0n || amountError) return "Enter amount";
+    if (needsApproval) return pendingAction === "approve" ? "Approving..." : "Approve USDC";
+    return pendingAction === "stake" ? "Staking..." : "Stake USDC";
+  })();
+
+  return (
+    <div className="w-full grow bg-base-200">
+      <div className="mx-auto flex w-full max-w-6xl flex-col gap-6 px-4 py-6 sm:px-6 lg:px-8">
+        <section className="flex flex-col gap-4 border-b border-base-300 pb-6 lg:flex-row lg:items-end lg:justify-between">
+          <div>
+            <p className="mb-2 text-sm font-semibold uppercase tracking-wide text-primary">Base USDC staking</p>
+            <h1 className="text-3xl font-bold text-base-content sm:text-4xl">USDC Staker</h1>
+            <p className="max-w-2xl text-sm text-base-content/70">
+              Deposit USDC into the staking contract and withdraw your full position whenever you need it.
+            </p>
+          </div>
+          <div className="flex flex-wrap items-center gap-3">
+            {stakerAddress && isStakerConfigured ? (
+              <div className="badge badge-outline gap-2 px-3 py-3">
+                <CheckCircleIcon className="h-4 w-4 text-success" />
+                <span>Staker</span>
+                <Address address={stakerAddress} chain={targetNetwork} size="xs" />
+              </div>
+            ) : (
+              <div className="badge badge-warning gap-2 px-3 py-3">
+                <ExclamationTriangleIcon className="h-4 w-4" />
+                <span>Set NEXT_PUBLIC_STAKER_ADDRESS</span>
+              </div>
+            )}
+            <div className="badge badge-neutral px-3 py-3">{targetNetwork.name}</div>
+          </div>
+        </section>
+
+        <section className="grid gap-4 md:grid-cols-3">
+          <div className="card rounded-lg border border-base-300 bg-base-100 shadow-sm">
+            <div className="card-body gap-2 p-5">
+              <span className="text-sm font-medium text-base-content/60">Wallet USDC</span>
+              <span className="text-2xl font-bold">
+                {isUsdcBalanceLoading ? "Loading..." : `${formatTokenAmount(usdcBalance)} USDC`}
+              </span>
+              <span className="text-sm text-base-content/60">
+                {formatUsd(Number(formatUnits(usdcBalance ?? 0n, USDC_DECIMALS)) * USDC_PRICE_USD)}
+              </span>
+            </div>
+          </div>
+          <div className="card rounded-lg border border-base-300 bg-base-100 shadow-sm">
+            <div className="card-body gap-2 p-5">
+              <span className="text-sm font-medium text-base-content/60">ETH for gas</span>
+              <span className="text-2xl font-bold">
+                {address ? <Balance address={address} chain={targetNetwork} /> : "0 ETH"}
+              </span>
+              <span className="text-sm text-base-content/60">
+                {nativeUsdValue !== undefined
+                  ? formatUsd(nativeUsdValue)
+                  : isNativePriceError
+                    ? "USD price unavailable"
+                    : "USD price loading"}
+              </span>
+            </div>
+          </div>
+          <div className="card rounded-lg border border-base-300 bg-base-100 shadow-sm">
+            <div className="card-body gap-2 p-5">
+              <span className="text-sm font-medium text-base-content/60">Staked position</span>
+              <span className="text-2xl font-bold">
+                {isPositionLoading ? "Loading..." : `${formatTokenAmount(stakedPosition)} USDC`}
+              </span>
+              <span className="text-sm text-base-content/60">
+                {formatUsd(Number(formatUnits(stakedPosition ?? 0n, USDC_DECIMALS)) * USDC_PRICE_USD)}
+              </span>
+            </div>
+          </div>
+        </section>
+
+        <section className="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
+          <div className="card rounded-lg border border-base-300 bg-base-100 shadow-sm">
+            <div className="card-body p-5 sm:p-6">
+              <div className="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
+                <div>
+                  <h2 className="card-title text-xl">Stake USDC</h2>
+                  <p className="my-0 text-sm text-base-content/60">
+                    USDC uses 6 decimals. Price context: 1 USDC = $1.00.
+                  </p>
+                </div>
+                <button
+                  className="btn btn-sm btn-ghost gap-2 self-start"
+                  disabled={!usdcBalance}
+                  onClick={() => setStakeAmount(formatUnits(usdcBalance ?? 0n, USDC_DECIMALS))}
+                  type="button"
+                >
+                  Max
+                </button>
+              </div>
+
+              <label className="form-control mt-4 w-full">
+                <div className="label">
+                  <span className="label-text">Amount</span>
+                </div>
+                <div className="join w-full">
+                  <input
+                    className={`input join-item input-bordered w-full text-lg ${amountError ? "input-error" : ""}`}
+                    disabled={!address || !isStakerConfigured || pendingAction !== undefined}
+                    inputMode="decimal"
+                    min="0"
+                    onChange={event => setStakeAmount(event.target.value)}
+                    placeholder="0.00"
+                    value={stakeAmount}
+                  />
+                  <span className="join-item flex min-w-20 items-center justify-center border border-base-300 bg-base-200 px-4 font-semibold">
+                    USDC
+                  </span>
+                </div>
+                {amountError && (
+                  <div className="label">
+                    <span className="label-text-alt text-error">{amountError}</span>
+                  </div>
+                )}
+              </label>
+
+              <div className="mt-4 flex flex-col gap-3 sm:flex-row">
+                <button
+                  className="btn btn-primary min-h-12 flex-1 gap-2"
+                  disabled={
+                    !address ||
+                    pendingAction !== undefined ||
+                    !isStakerConfigured ||
+                    (!isWrongNetwork && (!canStake || isAllowanceLoading))
+                  }
+                  onClick={handlePrimaryStakeAction}
+                  type="button"
+                >
+                  {pendingAction === "approve" || pendingAction === "stake" || pendingAction === "switch" ? (
+                    <span className="loading loading-spinner loading-sm" />
+                  ) : (
+                    <ArrowDownTrayIcon className="h-5 w-5" />
+                  )}
+                  {stakeButtonLabel}
+                </button>
+                <button
+                  className="btn btn-outline min-h-12 flex-1 gap-2"
+                  disabled={!canWithdraw || pendingAction !== undefined}
+                  onClick={handleWithdraw}
+                  type="button"
+                >
+                  {pendingAction === "withdraw" ? (
+                    <span className="loading loading-spinner loading-sm" />
+                  ) : (
+                    <ArrowPathIcon className="h-5 w-5" />
+                  )}
+                  {pendingAction === "withdraw" ? "Withdrawing..." : "Withdraw full position"}
+                </button>
+              </div>
+
+              {actionError && (
+                <div className="alert alert-error mt-4 rounded-lg">
+                  <ExclamationTriangleIcon className="h-5 w-5" />
+                  <span className="text-sm">{actionError}</span>
+                </div>
+              )}
+            </div>
+          </div>
+
+          <aside className="card rounded-lg border border-base-300 bg-base-100 shadow-sm">
+            <div className="card-body p-5">
+              <h2 className="card-title text-lg">Position details</h2>
+              <div className="divider my-1" />
+              <div className="flex items-center justify-between gap-4 text-sm">
+                <span className="text-base-content/60">Approved</span>
+                <span className="font-semibold">{formatTokenAmount(allowance)} USDC</span>
+              </div>
+              <div className="flex items-center justify-between gap-4 text-sm">
+                <span className="text-base-content/60">Contract USDC</span>
+                <Address address={stakerAddress} chain={targetNetwork} size="sm" />
+              </div>
+              <div className="flex items-center justify-between gap-4 text-sm">
+                <span className="text-base-content/60">Withdraw mode</span>
+                <span className="font-semibold">Full position</span>
+              </div>
+              {isWrongNetwork && (
+                <div className="alert alert-warning mt-2 rounded-lg">
+                  <ExclamationTriangleIcon className="h-5 w-5" />
+                  <span className="text-sm">Switch your wallet to Base.</span>
+                </div>
+              )}
+            </div>
+          </aside>
+        </section>
+      </div>
+    </div>
+  );
+};
+
+export default Stake;
