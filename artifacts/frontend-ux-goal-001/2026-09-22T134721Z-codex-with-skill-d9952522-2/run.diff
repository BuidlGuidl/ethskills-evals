+import { expect } from "chai";
+import { network } from "hardhat";
+import type { Abi_MockUSDC } from "../generated/abis/MockUSDC.js";
+import type { Abi_Staker } from "../generated/abis/Staker.js";
+import { loadAndExecuteDeploymentsFromFiles } from "../rocketh/environment.js";
+
+const { provider, networkHelpers, ethers } = await network.create();
+
+async function deployFixture() {
+  const env = await loadAndExecuteDeploymentsFromFiles({ provider });
+  const stakerDeployment = env.get<Abi_Staker>("Staker");
+  const usdcDeployment = env.get<Abi_MockUSDC>("MockUSDC");
+
+  const staker = (await ethers.getContractAt(stakerDeployment.abi, stakerDeployment.address)) as any;
+  const usdc = (await ethers.getContractAt(usdcDeployment.abi, usdcDeployment.address)) as any;
+  const [deployer, stakerAccount] = await ethers.getSigners();
+
+  return { deployer, stakerAccount, staker, usdc };
+}
+
+describe("Staker", function () {
+  it("uses a 6-decimal USDC token locally", async function () {
+    const { deployer, usdc } = await networkHelpers.loadFixture(deployFixture);
+
+    expect(await usdc.name()).to.equal("USD Coin");
+    expect(await usdc.symbol()).to.equal("USDC");
+    expect(await usdc.decimals()).to.equal(6);
+    expect(await usdc.balanceOf(deployer.address)).to.equal(ethers.parseUnits("1000000", 6));
+  });
+
+  it("lets users stake USDC after approval", async function () {
+    const { stakerAccount, staker, usdc } = await networkHelpers.loadFixture(deployFixture);
+    const amount = ethers.parseUnits("125.50", 6);
+
+    await usdc.mint(stakerAccount.address, amount);
+    await usdc.connect(stakerAccount).approve(await staker.getAddress(), amount);
+
+    await expect(staker.connect(stakerAccount).stake(amount))
+      .to.emit(staker, "Staked")
+      .withArgs(stakerAccount.address, amount);
+
+    expect(await staker.positionOf(stakerAccount.address)).to.equal(amount);
+    expect(await staker.totalStaked()).to.equal(amount);
+    expect(await usdc.balanceOf(await staker.getAddress())).to.equal(amount);
+  });
+
+  it("withdraws a user's full position", async function () {
+    const { stakerAccount, staker, usdc } = await networkHelpers.loadFixture(deployFixture);
+    const amount = ethers.parseUnits("75", 6);
+
+    await usdc.mint(stakerAccount.address, amount);
+    await usdc.connect(stakerAccount).approve(await staker.getAddress(), amount);
+    await staker.connect(stakerAccount).stake(amount);
+
+    await expect(staker.connect(stakerAccount).withdraw())
+      .to.emit(staker, "Withdrawn")
+      .withArgs(stakerAccount.address, amount);
+
+    expect(await staker.positionOf(stakerAccount.address)).to.equal(0n);
+    expect(await staker.totalStaked()).to.equal(0n);
+    expect(await usdc.balanceOf(stakerAccount.address)).to.equal(amount);
+  });
+
+  it("rejects empty stake and withdraw calls", async function () {
+    const { stakerAccount, staker } = await networkHelpers.loadFixture(deployFixture);
+
+    await expect(staker.connect(stakerAccount).stake(0n)).to.be.revertedWithCustomError(staker, "ZeroAmount");
+    await expect(staker.connect(stakerAccount).withdraw()).to.be.revertedWithCustomError(staker, "NothingStaked");
+  });
+});
