diff --git a/packages/hardhat/test/Staker.ts b/packages/hardhat/test/Staker.ts
new file mode 100644
index 0000000..223a8bd
--- /dev/null
+++ b/packages/hardhat/test/Staker.ts
@@ -0,0 +1,61 @@
+import { expect } from "chai";
+import { network } from "hardhat";
+import { loadAndExecuteDeploymentsFromFiles } from "../rocketh/environment.js";
+
+const { provider, networkHelpers, ethers } = await network.create();
+
+async function deployFixture() {
+  const env = await loadAndExecuteDeploymentsFromFiles({ provider });
+  const usdcDeployment = env.get("USDC");
+  const stakerDeployment = env.get("Staker");
+  const usdc = await ethers.getContractAt(usdcDeployment.abi, usdcDeployment.address);
+  const staker = await ethers.getContractAt(stakerDeployment.abi, stakerDeployment.address);
+  const [, stakerAccount] = await ethers.getSigners();
+
+  return { staker, stakerAccount, usdc };
+}
+
+describe("Staker", function () {
+  it("accepts USDC deposits and tracks positions", async function () {
+    const { staker, stakerAccount, usdc } = await networkHelpers.loadFixture(deployFixture);
+    const amount = ethers.parseUnits("125.5", 6);
+
+    await usdc.mint(stakerAccount.address, amount);
+    await usdc.connect(stakerAccount).approve(await staker.getAddress(), amount);
+
+    await expect(staker.connect(stakerAccount).deposit(amount))
+      .to.emit(staker, "Deposited")
+      .withArgs(stakerAccount.address, amount);
+
+    expect(await staker.balanceOf(stakerAccount.address)).to.equal(amount);
+    expect(await staker.totalStaked()).to.equal(amount);
+    expect(await usdc.balanceOf(await staker.getAddress())).to.equal(amount);
+  });
+
+  it("withdraws the caller's full position", async function () {
+    const { staker, stakerAccount, usdc } = await networkHelpers.loadFixture(deployFixture);
+    const amount = ethers.parseUnits("40", 6);
+
+    await usdc.mint(stakerAccount.address, amount);
+    await usdc.connect(stakerAccount).approve(await staker.getAddress(), amount);
+    await staker.connect(stakerAccount).deposit(amount);
+
+    await expect(staker.connect(stakerAccount).withdraw())
+      .to.emit(staker, "Withdrawn")
+      .withArgs(stakerAccount.address, amount);
+
+    expect(await staker.balanceOf(stakerAccount.address)).to.equal(0);
+    expect(await staker.totalStaked()).to.equal(0);
+    expect(await usdc.balanceOf(stakerAccount.address)).to.equal(amount);
+  });
+
+  it("rejects zero deposits and empty withdrawals", async function () {
+    const { staker, stakerAccount } = await networkHelpers.loadFixture(deployFixture);
+
+    await expect(staker.connect(stakerAccount).deposit(0)).to.be.revertedWithCustomError(
+      staker,
+      "AmountMustBeGreaterThanZero",
+    );
+    await expect(staker.connect(stakerAccount).withdraw()).to.be.revertedWithCustomError(staker, "NoPosition");
+  });
+});
