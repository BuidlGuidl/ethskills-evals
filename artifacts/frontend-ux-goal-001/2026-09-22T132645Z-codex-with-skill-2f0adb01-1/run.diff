+"use client";
+
+import { useMemo, useState } from "react";
+import { ConnectButton } from "@rainbow-me/rainbowkit";
+import { Address } from "@scaffold-ui/components";
+import { useFetchNativeCurrencyPrice } from "@scaffold-ui/hooks";
+import type { NextPage } from "next";
+import { formatEther, formatUnits, parseUnits } from "viem";
+import { hardhat } from "viem/chains";
+import { useAccount, useBalance, useSwitchChain } from "wagmi";
+import {
+  ArrowDownTrayIcon,
+  ArrowPathIcon,
+  ArrowUpTrayIcon,
+  BanknotesIcon,
+  ExclamationTriangleIcon,
+  WalletIcon,
+} from "@heroicons/react/24/outline";
+import {
+  useDeployedContractInfo,
+  useScaffoldReadContract,
+  useScaffoldWriteContract,
+  useTargetNetwork,
+} from "~~/hooks/scaffold-eth";
+import { AllowedChainIds, getParsedError, notification } from "~~/utils/scaffold-eth";
+
+const USDC_DECIMALS = 6;
+const APPROVAL_CACHE_COOLDOWN_MS = 4000;
+
+const formatUsd = (value: number | undefined) => {
+  if (value === undefined || Number.isNaN(value)) return "USD unavailable";
+  return new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 2 }).format(value);
+};
+
+const formatTokenAmount = (value: bigint | undefined, decimals = USDC_DECIMALS) => {
+  if (value === undefined) return "0.00";
+
+  return new Intl.NumberFormat("en-US", {
+    maximumFractionDigits: decimals,
+    minimumFractionDigits: 2,
+  }).format(Number(formatUnits(value, decimals)));
+};
+
+const tokenAmountToUsd = (value: bigint | undefined, decimals = USDC_DECIMALS) => {
+  if (value === undefined) return undefined;
+  return Number(formatUnits(value, decimals));
+};
+
+const StatTile = ({
+  icon,
+  label,
+  value,
+  subvalue,
+}: {
+  icon: React.ReactNode;
+  label: string;
+  value: string;
+  subvalue: string;
+}) => (
+  <div className="border border-base-300 bg-base-100 p-5">
+    <div className="flex items-center gap-3">
+      <div className="grid h-10 w-10 shrink-0 place-items-center rounded bg-base-200 text-primary">{icon}</div>
+      <div className="min-w-0">
+        <p className="m-0 text-sm text-base-content/70">{label}</p>
+        <p className="m-0 truncate text-xl font-semibold">{value}</p>
+      </div>
+    </div>
+    <p className="m-0 mt-4 text-sm text-base-content/70">{subvalue}</p>
+  </div>
+);
+
+const ConnectWalletButton = () => (
+  <ConnectButton.Custom>
+    {({ openConnectModal, mounted }) => (
+      <button className="btn btn-primary w-full" disabled={!mounted} onClick={openConnectModal} type="button">
+        Connect Wallet
+      </button>
+    )}
+  </ConnectButton.Custom>
+);
+
+const Stake: NextPage = () => {
+  const { address, isConnected, chain } = useAccount();
+  const { switchChain } = useSwitchChain();
+  const { targetNetwork } = useTargetNetwork();
+  const { price: nativeCurrencyPrice } = useFetchNativeCurrencyPrice();
+  const selectedChainId = targetNetwork.id as AllowedChainIds;
+  const isWrongNetwork = isConnected && chain?.id !== targetNetwork.id;
+  const isLocalNetwork = targetNetwork.id === hardhat.id;
+
+  const [stakeAmount, setStakeAmount] = useState("");
+  const [isApproving, setIsApproving] = useState(false);
+  const [approveCooldown, setApproveCooldown] = useState(false);
+  const [isStaking, setIsStaking] = useState(false);
+  const [isWithdrawing, setIsWithdrawing] = useState(false);
+  const [txError, setTxError] = useState<string | null>(null);
+
+  const { data: usdcContract, isLoading: isUsdcLoading } = useDeployedContractInfo({
+    contractName: "USDC",
+    chainId: selectedChainId,
+  });
+  const { data: stakerContract, isLoading: isStakerLoading } = useDeployedContractInfo({
+    contractName: "Staker",
+    chainId: selectedChainId,
+  } as any);
+
+  const { data: ethBalance } = useBalance({
+    address,
+    chainId: targetNetwork.id,
+    query: { enabled: Boolean(address) },
+  });
+
+  const {
+    data: usdcBalanceResult,
+    refetch: refetchUsdcBalance,
+    isLoading: isUsdcBalanceLoading,
+  } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "balanceOf",
+    args: [address],
+    chainId: selectedChainId,
+    query: { enabled: Boolean(address && usdcContract) },
+  });
+
+  const {
+    data: stakedBalanceResult,
+    refetch: refetchStakedBalance,
+    isLoading: isStakedBalanceLoading,
+  } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "balanceOf",
+    args: [address],
+    chainId: selectedChainId,
+    query: { enabled: Boolean(address && stakerContract) },
+  } as any);
+
+  const { data: allowanceResult, refetch: refetchAllowance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "allowance",
+    args: [address, stakerContract?.address],
+    chainId: selectedChainId,
+    query: { enabled: Boolean(address && usdcContract && stakerContract) },
+  });
+
+  const { writeContractAsync: writeUsdcAsync } = useScaffoldWriteContract({
+    contractName: "USDC",
+    chainId: selectedChainId,
+  });
+  const { writeContractAsync: writeStakerAsync } = useScaffoldWriteContract({
+    contractName: "Staker",
+    chainId: selectedChainId,
+  } as any) as { writeContractAsync: (variables: any, options?: any) => Promise<unknown> };
+
+  const usdcBalance = typeof usdcBalanceResult === "bigint" ? usdcBalanceResult : undefined;
+  const stakedBalance = typeof stakedBalanceResult === "bigint" ? stakedBalanceResult : undefined;
+  const allowance = typeof allowanceResult === "bigint" ? allowanceResult : undefined;
+
+  const parsedStakeAmount = useMemo(() => {
+    const trimmedAmount = stakeAmount.trim();
+    if (!trimmedAmount || !/^\d+(\.\d*)?$/.test(trimmedAmount)) return undefined;
+
+    try {
+      const parsedAmount = parseUnits(trimmedAmount, USDC_DECIMALS);
+      return parsedAmount > 0n ? parsedAmount : undefined;
+    } catch {
+      return undefined;
+    }
+  }, [stakeAmount]);
+
+  const hasEnoughUsdc =
+    parsedStakeAmount !== undefined && usdcBalance !== undefined && parsedStakeAmount <= usdcBalance;
+  const needsApproval =
+    parsedStakeAmount !== undefined && allowance !== undefined && stakerContract && allowance < parsedStakeAmount;
+  const canWithdraw = Boolean(stakedBalance && stakedBalance > 0n);
+  const ethValue = ethBalance?.value ? Number(formatEther(ethBalance.value)) * nativeCurrencyPrice : undefined;
+
+  const refetchPosition = async () => {
+    await Promise.all([refetchUsdcBalance(), refetchStakedBalance(), refetchAllowance()]);
+  };
+
+  const handleError = (error: unknown) => {
+    const message = getParsedError(error);
+    setTxError(message);
+    notification.error(message);
+  };
+
+  const handleApprove = async () => {
+    if (!parsedStakeAmount || !stakerContract) return;
+
+    setTxError(null);
+    setIsApproving(true);
+
+    try {
+      await writeUsdcAsync(
+        {
+          functionName: "approve",
+          args: [stakerContract.address, parsedStakeAmount],
+        },
+        { blockConfirmations: 1 },
+      );
+      setApproveCooldown(true);
+      await refetchPosition();
+      window.setTimeout(async () => {
+        await refetchAllowance();
+        setApproveCooldown(false);
+      }, APPROVAL_CACHE_COOLDOWN_MS);
+    } catch (error) {
+      handleError(error);
+    } finally {
+      setIsApproving(false);
+    }
+  };
+
+  const handleStake = async () => {
+    if (!parsedStakeAmount) return;
+
+    setTxError(null);
+    setIsStaking(true);
+
+    try {
+      await writeStakerAsync(
+        {
+          functionName: "deposit",
+          args: [parsedStakeAmount],
+        },
+        { blockConfirmations: 1 },
+      );
+      setStakeAmount("");
+      await refetchPosition();
+    } catch (error) {
+      handleError(error);
+    } finally {
+      setIsStaking(false);
+    }
+  };
+
+  const handleWithdraw = async () => {
+    setTxError(null);
+    setIsWithdrawing(true);
+
+    try {
+      await writeStakerAsync(
+        {
+          functionName: "withdraw",
+        },
+        { blockConfirmations: 1 },
+      );
+      await refetchPosition();
+    } catch (error) {
+      handleError(error);
+    } finally {
+      setIsWithdrawing(false);
+    }
+  };
+
+  const setMaxAmount = () => {
+    if (usdcBalance === undefined) return;
+    setStakeAmount(formatUnits(usdcBalance, USDC_DECIMALS));
+  };
+
+  const renderStakeAction = () => {
+    if (!isConnected) return <ConnectWalletButton />;
+
+    if (isWrongNetwork) {
+      return (
+        <button
+          className="btn btn-warning w-full"
+          onClick={() => switchChain({ chainId: targetNetwork.id })}
+          type="button"
+        >
+          Switch to {targetNetwork.name}
+        </button>
+      );
+    }
+
+    if (!stakerContract || !usdcContract) {
+      return (
+        <button className="btn w-full" disabled type="button">
+          {isStakerLoading || isUsdcLoading ? "Checking contracts..." : "Contracts unavailable"}
+        </button>
+      );
+    }
+
+    if (!parsedStakeAmount) {
+      return (
+        <button className="btn btn-primary w-full" disabled type="button">
+          Enter USDC amount
+        </button>
+      );
+    }
+
+    if (!hasEnoughUsdc) {
+      return (
+        <button className="btn btn-primary w-full" disabled type="button">
+          Insufficient USDC
+        </button>
+      );
+    }
+
+    if (allowance === undefined) {
+      return (
+        <button className="btn btn-primary w-full" disabled type="button">
+          <span className="loading loading-spinner loading-sm" />
+          Checking allowance...
+        </button>
+      );
+    }
+
+    if (needsApproval || isApproving || approveCooldown) {
+      return (
+        <button
+          className="btn btn-primary w-full"
+          disabled={isApproving || approveCooldown}
+          onClick={handleApprove}
+          type="button"
+        >
+          {(isApproving || approveCooldown) && <span className="loading loading-spinner loading-sm" />}
+          {isApproving ? "Approving..." : approveCooldown ? "Refreshing approval..." : "Approve USDC"}
+        </button>
+      );
+    }
+
+    return (
+      <button className="btn btn-primary w-full" disabled={isStaking} onClick={handleStake} type="button">
+        {isStaking && <span className="loading loading-spinner loading-sm" />}
+        {isStaking ? "Staking..." : "Stake USDC"}
+      </button>
+    );
+  };
+
+  return (
+    <div className="grow bg-base-200">
+      <div className="mx-auto flex w-full max-w-6xl flex-col gap-8 px-4 py-8 sm:px-6 lg:px-8">
+        <div className="grid gap-4 md:grid-cols-3">
+          <StatTile
+            icon={<BanknotesIcon className="h-5 w-5" />}
+            label="Wallet USDC"
+            value={isUsdcBalanceLoading ? "Loading..." : `${formatTokenAmount(usdcBalance)} USDC`}
+            subvalue={formatUsd(tokenAmountToUsd(usdcBalance))}
+          />
+          <StatTile
+            icon={<WalletIcon className="h-5 w-5" />}
+            label={`${targetNetwork.nativeCurrency.symbol} for gas`}
+            value={`${Number(formatEther(ethBalance?.value ?? 0n)).toLocaleString("en-US", {
+              maximumFractionDigits: 6,
+            })} ${targetNetwork.nativeCurrency.symbol}`}
+            subvalue={formatUsd(ethValue)}
+          />
+          <StatTile
+            icon={<ArrowDownTrayIcon className="h-5 w-5" />}
+            label="Staked position"
+            value={isStakedBalanceLoading ? "Loading..." : `${formatTokenAmount(stakedBalance)} USDC`}
+            subvalue={formatUsd(tokenAmountToUsd(stakedBalance))}
+          />
+        </div>
+
+        <div className="grid gap-6 lg:grid-cols-[minmax(0,1.1fr)_minmax(320px,0.9fr)]">
+          <section className="bg-base-100 border border-base-300 p-6">
+            <div className="flex flex-col gap-5">
+              <div className="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
+                <div>
+                  <h1 className="m-0 text-2xl font-semibold">Stake USDC</h1>
+                  <p className="m-0 mt-1 text-sm text-base-content/70">
+                    {isLocalNetwork ? "Local mock USDC" : "Base USDC"} · {targetNetwork.name}
+                  </p>
+                </div>
+                {stakerContract?.address && <Address address={stakerContract.address} chain={targetNetwork} />}
+              </div>
+
+              <label className="form-control w-full">
+                <div className="label">
+                  <span className="label-text">Amount</span>
+                  <button className="btn btn-ghost btn-xs" onClick={setMaxAmount} type="button">
+                    Max
+                  </button>
+                </div>
+                <div className="join w-full">
+                  <input
+                    className="input input-bordered join-item w-full text-lg"
+                    inputMode="decimal"
+                    onChange={event => setStakeAmount(event.target.value)}
+                    placeholder="0.00"
+                    value={stakeAmount}
+                  />
+                  <span className="join-item grid w-24 place-items-center border border-base-300 bg-base-200 font-medium">
+                    USDC
+                  </span>
+                </div>
+              </label>
+
+              <div className="grid gap-3 sm:grid-cols-2">
+                <div className="border border-base-300 bg-base-200 p-4">
+                  <p className="m-0 text-sm text-base-content/70">Deposit value</p>
+                  <p className="m-0 mt-1 text-lg font-semibold">
+                    {formatUsd(parsedStakeAmount ? tokenAmountToUsd(parsedStakeAmount) : 0)}
+                  </p>
+                </div>
+                <div className="border border-base-300 bg-base-200 p-4">
+                  <p className="m-0 text-sm text-base-content/70">Allowance</p>
+                  <p className="m-0 mt-1 text-lg font-semibold">{formatTokenAmount(allowance)} USDC</p>
+                </div>
+              </div>
+
+              {txError && (
+                <div className="alert alert-error items-start">
+                  <ExclamationTriangleIcon className="h-5 w-5" />
+                  <span className="break-words">{txError}</span>
+                </div>
+              )}
+
+              {renderStakeAction()}
+            </div>
+          </section>
+
+          <aside className="bg-base-100 border border-base-300 p-6">
+            <div className="flex h-full flex-col gap-5">
+              <div>
+                <h2 className="m-0 text-xl font-semibold">Position</h2>
+                <p className="m-0 mt-1 text-sm text-base-content/70">
+                  {formatTokenAmount(stakedBalance)} USDC · {formatUsd(tokenAmountToUsd(stakedBalance))}
+                </p>
+              </div>
+
+              <div className="stats stats-vertical border border-base-300 bg-base-200 shadow-none">
+                <div className="stat">
+                  <div className="stat-title">Total staked</div>
+                  <div className="stat-value text-2xl">{formatTokenAmount(stakedBalance)}</div>
+                  <div className="stat-desc">USDC in this wallet position</div>
+                </div>
+                <div className="stat">
+                  <div className="stat-title">Required action</div>
+                  <div className="stat-value text-2xl">
+                    {parsedStakeAmount && allowance === undefined ? "Checking" : needsApproval ? "Approve" : "Ready"}
+                  </div>
+                  <div className="stat-desc">
+                    {parsedStakeAmount && allowance === undefined
+                      ? "Reading USDC allowance"
+                      : needsApproval
+                        ? "USDC allowance is below amount"
+                        : "Allowance covers amount"}
+                  </div>
+                </div>
+              </div>
+
+              <button
+                className="btn btn-outline mt-auto w-full"
+                disabled={!canWithdraw || isWithdrawing || isWrongNetwork || !stakerContract}
+                onClick={handleWithdraw}
+                type="button"
+              >
+                {isWithdrawing ? (
+                  <span className="loading loading-spinner loading-sm" />
+                ) : (
+                  <ArrowUpTrayIcon className="h-5 w-5" />
+                )}
+                {isWithdrawing ? "Withdrawing..." : "Withdraw full position"}
+              </button>
+
+              <button className="btn btn-ghost btn-sm" onClick={refetchPosition} type="button">
+                <ArrowPathIcon className="h-4 w-4" />
+                Refresh
+              </button>
+            </div>
+          </aside>
+        </div>
+      </div>
+    </div>
+  );
+};
+
+export default Stake;
