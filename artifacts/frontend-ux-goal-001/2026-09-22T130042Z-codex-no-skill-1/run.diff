@@ -0,0 +1,58 @@
+// SPDX-License-Identifier: MIT
+pragma solidity >=0.8.20 <0.9.0;
+
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { SafeERC20 } from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+import { ReentrancyGuard } from "@openzeppelin/contracts/utils/ReentrancyGuard.sol";
+
+contract Staker is ReentrancyGuard {
+    using SafeERC20 for IERC20;
+
+    IERC20 public immutable usdc;
+    uint256 public totalStaked;
+
+    mapping(address account => uint256 amount) public positions;
+
+    event Staked(address indexed account, uint256 amount);
+    event Withdrawn(address indexed account, uint256 amount);
+
+    error ZeroAddress();
+    error ZeroAmount();
+    error NoPosition();
+
+    constructor(IERC20 _usdc) {
+        if (address(_usdc) == address(0)) revert ZeroAddress();
+        usdc = _usdc;
+    }
+
+    function stake(uint256 amount) external nonReentrant {
+        if (amount == 0) revert ZeroAmount();
+
+        positions[msg.sender] += amount;
+        totalStaked += amount;
+
+        usdc.safeTransferFrom(msg.sender, address(this), amount);
+
+        emit Staked(msg.sender, amount);
+    }
+
+    function withdraw() external nonReentrant {
+        uint256 amount = positions[msg.sender];
+        if (amount == 0) revert NoPosition();
+
+        positions[msg.sender] = 0;
+        totalStaked -= amount;
+
+        usdc.safeTransfer(msg.sender, amount);
+
+        emit Withdrawn(msg.sender, amount);
+    }
+
+    function walletBalance(address account) external view returns (uint256) {
+        return usdc.balanceOf(account);
+    }
+
+    function allowanceToStaker(address account) external view returns (uint256) {
+        return usdc.allowance(account, address(this));
+    }
+}
