index 0000000..c7ea5c6
--- /dev/null
+++ b/packages/nextjs/app/stake/page.tsx
@@ -0,0 +1,377 @@
+"use client";
+
+import { useMemo, useState } from "react";
+import { Address } from "@scaffold-ui/components";
+import type { NextPage } from "next";
+import { Abi, Address as AddressType, formatEther, formatUnits, parseUnits } from "viem";
+import { useAccount, useBalance, useReadContract, useWriteContract } from "wagmi";
+import {
+  ArrowDownTrayIcon,
+  ArrowPathIcon,
+  ArrowUpTrayIcon,
+  BanknotesIcon,
+  CheckCircleIcon,
+  ExclamationTriangleIcon,
+} from "@heroicons/react/24/outline";
+import { useDeployedContractInfo, useTargetNetwork, useTransactor } from "~~/hooks/scaffold-eth";
+import { AllowedChainIds, getParsedError, notification } from "~~/utils/scaffold-eth";
+import { ContractName } from "~~/utils/scaffold-eth/contract";
+
+const USDC_DECIMALS = 6;
+const STAKER_CONTRACT_NAME = "Staker" as ContractName;
+
+const erc20ApprovalAbi = [
+  {
+    type: "function",
+    name: "approve",
+    stateMutability: "nonpayable",
+    inputs: [
+      { name: "spender", type: "address" },
+      { name: "amount", type: "uint256" },
+    ],
+    outputs: [{ name: "", type: "bool" }],
+  },
+] as const;
+
+const formatGrouped = (value: string) => value.replace(/\B(?=(\d{3})+(?!\d))/g, ",");
+
+const formatUsdc = (value?: bigint) => {
+  if (value === undefined) return "0.00";
+  const [whole, fraction = ""] = formatUnits(value, USDC_DECIMALS).split(".");
+  const trimmedFraction = fraction.slice(0, 2).replace(/0+$/, "");
+  return trimmedFraction ? `${formatGrouped(whole)}.${trimmedFraction}` : formatGrouped(whole);
+};
+
+const formatEth = (value?: bigint) => {
+  if (value === undefined) return "0";
+  const [whole, fraction = ""] = formatEther(value).split(".");
+  const trimmedFraction = fraction.slice(0, 4).replace(/0+$/, "");
+  return trimmedFraction ? `${formatGrouped(whole)}.${trimmedFraction}` : formatGrouped(whole);
+};
+
+const parseUsdcInput = (value: string) => {
+  const normalized = value.trim();
+  if (!normalized) return 0n;
+  return parseUnits(normalized, USDC_DECIMALS);
+};
+
+type StatTileProps = {
+  label: string;
+  value: string;
+  detail: string;
+  icon: React.ReactNode;
+};
+
+const StatTile = ({ label, value, detail, icon }: StatTileProps) => (
+  <div className="card bg-base-100 border border-base-300 shadow-sm">
+    <div className="card-body gap-3 p-5">
+      <div className="flex items-center justify-between gap-3">
+        <span className="text-sm font-medium text-base-content/70">{label}</span>
+        <span className="flex h-9 w-9 items-center justify-center rounded bg-base-200 text-base-content">{icon}</span>
+      </div>
+      <div className="text-2xl font-semibold leading-tight">{value}</div>
+      <div className="text-sm text-base-content/60">{detail}</div>
+    </div>
+  </div>
+);
+
+const StakePage: NextPage = () => {
+  const { address: connectedAddress, chain } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+  const transactor = useTransactor();
+  const { writeContractAsync } = useWriteContract();
+  const [stakeAmount, setStakeAmount] = useState("");
+  const [isSubmitting, setIsSubmitting] = useState(false);
+
+  const chainId = targetNetwork.id as AllowedChainIds;
+  const isWrongNetwork = Boolean(chain?.id && chain.id !== targetNetwork.id);
+
+  const { data: stakerContract, isLoading: isLoadingStaker } = useDeployedContractInfo({
+    contractName: STAKER_CONTRACT_NAME,
+    chainId,
+  });
+
+  const stakerAddress = stakerContract?.address;
+  const stakerAbi = stakerContract?.abi as Abi | undefined;
+
+  const enabled = Boolean(connectedAddress && stakerAddress && stakerAbi && !isWrongNetwork);
+
+  const { data: usdcAddress } = useReadContract({
+    address: stakerAddress,
+    abi: stakerAbi,
+    functionName: "usdc",
+    chainId: targetNetwork.id,
+    query: { enabled: Boolean(stakerAddress && stakerAbi) },
+  }) as { data: AddressType | undefined };
+
+  const {
+    data: walletUsdcBalance,
+    refetch: refetchWalletUsdcBalance,
+    isLoading: isLoadingWalletUsdcBalance,
+  } = useReadContract({
+    address: stakerAddress,
+    abi: stakerAbi,
+    functionName: "walletBalance",
+    args: connectedAddress ? [connectedAddress] : undefined,
+    chainId: targetNetwork.id,
+    query: { enabled },
+  }) as { data: bigint | undefined; refetch: () => Promise<unknown>; isLoading: boolean };
+
+  const {
+    data: stakedPosition,
+    refetch: refetchStakedPosition,
+    isLoading: isLoadingStakedPosition,
+  } = useReadContract({
+    address: stakerAddress,
+    abi: stakerAbi,
+    functionName: "positions",
+    args: connectedAddress ? [connectedAddress] : undefined,
+    chainId: targetNetwork.id,
+    query: { enabled },
+  }) as { data: bigint | undefined; refetch: () => Promise<unknown>; isLoading: boolean };
+
+  const { data: allowance, refetch: refetchAllowance } = useReadContract({
+    address: stakerAddress,
+    abi: stakerAbi,
+    functionName: "allowanceToStaker",
+    args: connectedAddress ? [connectedAddress] : undefined,
+    chainId: targetNetwork.id,
+    query: { enabled },
+  }) as { data: bigint | undefined; refetch: () => Promise<unknown> };
+
+  const { data: ethBalance, isLoading: isLoadingEthBalance } = useBalance({
+    address: connectedAddress,
+    chainId: targetNetwork.id,
+    query: { enabled: Boolean(connectedAddress && !isWrongNetwork) },
+  });
+
+  const parsedStakeAmount = useMemo(() => {
+    try {
+      return parseUsdcInput(stakeAmount);
+    } catch {
+      return undefined;
+    }
+  }, [stakeAmount]);
+
+  const hasAmount = Boolean(parsedStakeAmount && parsedStakeAmount > 0n);
+  const hasEnoughUsdc = Boolean(
+    parsedStakeAmount !== undefined && walletUsdcBalance !== undefined && parsedStakeAmount <= walletUsdcBalance,
+  );
+  const needsApproval = Boolean(parsedStakeAmount && allowance !== undefined && allowance < parsedStakeAmount);
+  const canStake = Boolean(enabled && hasAmount && hasEnoughUsdc && parsedStakeAmount !== undefined && usdcAddress);
+  const canWithdraw = Boolean(enabled && stakedPosition && stakedPosition > 0n);
+
+  const refetchPositions = async () => {
+    await Promise.all([refetchWalletUsdcBalance(), refetchStakedPosition(), refetchAllowance()]);
+  };
+
+  const handleMax = () => {
+    if (walletUsdcBalance !== undefined) setStakeAmount(formatUnits(walletUsdcBalance, USDC_DECIMALS));
+  };
+
+  const handleStake = async () => {
+    if (!canStake || !parsedStakeAmount || !stakerAddress || !stakerAbi || !usdcAddress) return;
+
+    try {
+      setIsSubmitting(true);
+
+      if (needsApproval) {
+        await transactor(() =>
+          writeContractAsync({
+            address: usdcAddress,
+            abi: erc20ApprovalAbi,
+            functionName: "approve",
+            args: [stakerAddress, parsedStakeAmount],
+          }),
+        );
+      }
+
+      await transactor(() =>
+        writeContractAsync({
+          address: stakerAddress,
+          abi: stakerAbi,
+          functionName: "stake",
+          args: [parsedStakeAmount],
+        }),
+      );
+
+      setStakeAmount("");
+      await refetchPositions();
+    } catch (error) {
+      notification.error(getParsedError(error));
+    } finally {
+      setIsSubmitting(false);
+    }
+  };
+
+  const handleWithdraw = async () => {
+    if (!canWithdraw || !stakerAddress || !stakerAbi) return;
+
+    try {
+      setIsSubmitting(true);
+      await transactor(() =>
+        writeContractAsync({
+          address: stakerAddress,
+          abi: stakerAbi,
+          functionName: "withdraw",
+        }),
+      );
+      await refetchPositions();
+    } catch (error) {
+      notification.error(getParsedError(error));
+    } finally {
+      setIsSubmitting(false);
+    }
+  };
+
+  const statusText = useMemo(() => {
+    if (!connectedAddress) return "Connect a wallet";
+    if (isWrongNetwork) return `Switch to ${targetNetwork.name}`;
+    if (isLoadingStaker) return "Loading staking contract";
+    if (!stakerContract) return "Staker not deployed";
+    if (!hasAmount) return "Enter an amount";
+    if (!hasEnoughUsdc) return "Insufficient USDC";
+    return needsApproval ? "Approve + stake" : "Stake USDC";
+  }, [
+    connectedAddress,
+    hasAmount,
+    hasEnoughUsdc,
+    isLoadingStaker,
+    isWrongNetwork,
+    needsApproval,
+    stakerContract,
+    targetNetwork.name,
+  ]);
+
+  return (
+    <main className="grow bg-base-200">
+      <div className="mx-auto flex w-full max-w-6xl flex-col gap-6 px-4 py-6 sm:px-6 lg:px-8">
+        <section className="flex flex-col gap-4 border-b border-base-300 pb-6 md:flex-row md:items-end md:justify-between">
+          <div className="space-y-2">
+            <p className="text-sm font-semibold uppercase tracking-wide text-primary">Base USDC staking</p>
+            <h1 className="text-3xl font-bold leading-tight sm:text-4xl">Stake USDC</h1>
+            <p className="max-w-2xl text-base text-base-content/70">
+              Deposit USDC into the staking contract and withdraw the full position whenever you need it.
+            </p>
+          </div>
+          <div className="flex flex-col items-start gap-2 rounded border border-base-300 bg-base-100 px-4 py-3 shadow-sm md:items-end">
+            <span className="text-xs font-semibold uppercase tracking-wide text-base-content/60">Connected wallet</span>
+            {connectedAddress ? (
+              <Address address={connectedAddress} chain={targetNetwork} />
+            ) : (
+              <span className="text-sm text-base-content/60">Not connected</span>
+            )}
+          </div>
+        </section>
+
+        {!stakerContract && !isLoadingStaker && (
+          <div className="alert border border-warning/40 bg-warning/10 text-warning-content">
+            <ExclamationTriangleIcon className="h-5 w-5" />
+            <span>Staker is not deployed on {targetNetwork.name}. Deploy it to enable staking on this network.</span>
+          </div>
+        )}
+
+        <section className="grid gap-4 md:grid-cols-3">
+          <StatTile
+            label="Wallet USDC"
+            value={isLoadingWalletUsdcBalance ? "Loading" : `${formatUsdc(walletUsdcBalance)} USDC`}
+            detail="Available to stake"
+            icon={<BanknotesIcon className="h-5 w-5" />}
+          />
+          <StatTile
+            label="ETH balance"
+            value={isLoadingEthBalance ? "Loading" : `${formatEth(ethBalance?.value)} ETH`}
+            detail="Needed for gas"
+            icon={<CheckCircleIcon className="h-5 w-5" />}
+          />
+          <StatTile
+            label="Staked position"
+            value={isLoadingStakedPosition ? "Loading" : `${formatUsdc(stakedPosition)} USDC`}
+            detail="Withdrawable balance"
+            icon={<ArrowDownTrayIcon className="h-5 w-5" />}
+          />
+        </section>
+
+        <section className="grid gap-4 lg:grid-cols-[1fr_0.8fr]">
+          <div className="card bg-base-100 border border-base-300 shadow-sm">
+            <div className="card-body gap-5">
+              <div className="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
+                <div>
+                  <h2 className="text-xl font-semibold">Stake</h2>
+                  <p className="text-sm text-base-content/60">USDC uses 6 decimals on Base and in local development.</p>
+                </div>
+                <button className="btn btn-sm btn-ghost" onClick={refetchPositions} disabled={!enabled || isSubmitting}>
+                  <ArrowPathIcon className="h-4 w-4" />
+                  Refresh
+                </button>
+              </div>
+
+              <label className="form-control w-full">
+                <div className="label">
+                  <span className="label-text font-medium">Amount</span>
+                  <button
+                    type="button"
+                    className="btn btn-xs btn-ghost"
+                    onClick={handleMax}
+                    disabled={!walletUsdcBalance}
+                  >
+                    Max
+                  </button>
+                </div>
+                <div className="join w-full">
+                  <input
+                    className="input input-bordered join-item min-w-0 grow text-lg"
+                    inputMode="decimal"
+                    placeholder="0.00"
+                    value={stakeAmount}
+                    onChange={event => setStakeAmount(event.target.value)}
+                  />
+                  <span className="join-item flex items-center border border-base-300 bg-base-200 px-4 text-sm font-semibold">
+                    USDC
+                  </span>
+                </div>
+              </label>
+
+              <button className="btn btn-primary w-full" onClick={handleStake} disabled={!canStake || isSubmitting}>
+                <ArrowUpTrayIcon className="h-5 w-5" />
+                {isSubmitting ? "Confirming" : statusText}
+              </button>
+
+              {needsApproval && canStake && (
+                <div className="alert border border-info/40 bg-info/10 text-info-content">
+                  <CheckCircleIcon className="h-5 w-5" />
+                  <span>Approval is needed before the staking transaction.</span>
+                </div>
+              )}
+            </div>
+          </div>
+
+          <div className="card bg-base-100 border border-base-300 shadow-sm">
+            <div className="card-body gap-5">
+              <div>
+                <h2 className="text-xl font-semibold">Withdraw</h2>
+                <p className="text-sm text-base-content/60">
+                  Withdraw sends the entire staked position back to your wallet.
+                </p>
+              </div>
+              <div className="rounded border border-base-300 bg-base-200 p-4">
+                <div className="text-sm text-base-content/60">Ready to withdraw</div>
+                <div className="mt-1 text-2xl font-semibold">{formatUsdc(stakedPosition)} USDC</div>
+              </div>
+              <button
+                className="btn btn-secondary w-full"
+                onClick={handleWithdraw}
+                disabled={!canWithdraw || isSubmitting}
+              >
+                <ArrowDownTrayIcon className="h-5 w-5" />
+                Withdraw all
+              </button>
+            </div>
+          </div>
+        </section>
+      </div>
+    </main>
+  );
+};
+
+export default StakePage;
