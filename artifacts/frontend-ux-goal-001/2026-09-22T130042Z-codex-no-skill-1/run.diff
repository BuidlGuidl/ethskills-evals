@@ -0,0 +1,66 @@
+import { expect } from "chai";
+import { network } from "hardhat";
+import type { Abi_MockUSDC } from "../generated/abis/MockUSDC.js";
+import type { Abi_Staker } from "../generated/abis/Staker.js";
+import { loadAndExecuteDeploymentsFromFiles } from "../rocketh/environment.js";
+
+const { provider, networkHelpers, ethers } = await network.create();
+
+async function deployFixture() {
+  const env = await loadAndExecuteDeploymentsFromFiles({ provider });
+  const [deployer, user] = await ethers.getSigners();
+
+  const { address: stakerAddress, abi: stakerAbi } = env.get<Abi_Staker>("Staker");
+  const { address: usdcAddress, abi: usdcAbi } = env.get<Abi_MockUSDC>("MockUSDC");
+
+  const staker = (await ethers.getContractAt(stakerAbi, stakerAddress)) as any;
+  const usdc = (await ethers.getContractAt(usdcAbi, usdcAddress)) as any;
+
+  return { deployer, user, staker, usdc };
+}
+
+describe("Staker", function () {
+  it("uses a 6 decimal local USDC mock", async function () {
+    const { usdc } = await networkHelpers.loadFixture(deployFixture);
+
+    expect(await usdc.name()).to.equal("USD Coin");
+    expect(await usdc.symbol()).to.equal("USDC");
+    expect(await usdc.decimals()).to.equal(6);
+  });
+
+  it("lets a user stake approved USDC", async function () {
+    const { deployer, user, staker, usdc } = await networkHelpers.loadFixture(deployFixture);
+    const amount = 250n * 10n ** 6n;
+
+    await usdc.connect(deployer).transfer(user.address, amount);
+    await usdc.connect(user).approve(await staker.getAddress(), amount);
+
+    await expect(staker.connect(user).stake(amount)).to.emit(staker, "Staked").withArgs(user.address, amount);
+
+    expect(await staker.positions(user.address)).to.equal(amount);
+    expect(await staker.totalStaked()).to.equal(amount);
+    expect(await usdc.balanceOf(await staker.getAddress())).to.equal(amount);
+  });
+
+  it("withdraws a user's full position", async function () {
+    const { deployer, user, staker, usdc } = await networkHelpers.loadFixture(deployFixture);
+    const amount = 100n * 10n ** 6n;
+
+    await usdc.connect(deployer).transfer(user.address, amount);
+    await usdc.connect(user).approve(await staker.getAddress(), amount);
+    await staker.connect(user).stake(amount);
+
+    await expect(staker.connect(user).withdraw()).to.emit(staker, "Withdrawn").withArgs(user.address, amount);
+
+    expect(await staker.positions(user.address)).to.equal(0n);
+    expect(await staker.totalStaked()).to.equal(0n);
+    expect(await usdc.balanceOf(user.address)).to.equal(amount);
+  });
+
+  it("reverts empty stakes and empty withdrawals", async function () {
+    const { staker, user } = await networkHelpers.loadFixture(deployFixture);
+
+    await expect(staker.connect(user).stake(0n)).to.be.revertedWithCustomError(staker, "ZeroAmount");
+    await expect(staker.connect(user).withdraw()).to.be.revertedWithCustomError(staker, "NoPosition");
+  });
+});
