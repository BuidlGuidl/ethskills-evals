+import { useAccount, useSwitchChain } from "wagmi";
+import {
+  useDeployedContractInfo,
+  useScaffoldReadContract,
+  useScaffoldWriteContract,
+  useTargetNetwork,
+} from "~~/hooks/scaffold-eth";
+
+// A handful of Base transactions cost far less than this; below it we warn the user they may not cover gas
+const LOW_GAS_BALANCE = parseEther("0.0001");
+const AMOUNT_REGEX = new RegExp(`^\\d*\\.?\\d{0,${USDC_DECIMALS}}$`);
+
+const parseAmount = (value: string) => {
+  if (!value || value === ".") return undefined;
+  try {
+    return parseUnits(value, USDC_DECIMALS);
+  } catch {
+    return undefined;
+  }
+};
+
+const Spinner = () => <span className="loading loading-spinner loading-sm" />;
+
+const StatRow = ({ label, value, usd }: { label: string; value?: string; usd?: string }) => (
+  <div className="flex justify-between items-baseline gap-4 py-2">
+    <span className="text-base-content/70">{label}</span>
+    {value === undefined ? (
+      <span className="skeleton h-5 w-28" />
+    ) : (
+      <span className="text-right">
+        <span className="font-semibold">{value}</span>
+        {usd && <span className="block text-xs text-base-content/60">~{usd}</span>}
+      </span>
+    )}
+  </div>
+);
+
+export const StakePanel = () => {
+  const { address, chain } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+  const { openConnectModal } = useConnectModal();
+  const { switchChainAsync } = useSwitchChain();
+
+  const [amountInput, setAmountInput] = useState("");
+  const [isSwitching, setIsSwitching] = useState(false);
+  const [isApproving, setIsApproving] = useState(false);
+  const [isStaking, setIsStaking] = useState(false);
+  const [isWithdrawing, setIsWithdrawing] = useState(false);
+  const [stakeError, setStakeError] = useState<string>();
+  const [withdrawError, setWithdrawError] = useState<string>();
+
+  const { data: stakerContract, isLoading: isStakerLoading } = useDeployedContractInfo({ contractName: "Staker" });
+  const { data: usdcContract, isLoading: isUsdcLoading } = useDeployedContractInfo({ contractName: "USDC" });
+  const stakerAddress = stakerContract?.address;
+
+  const { data: usdcBalance, refetch: refetchUsdcBalance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "balanceOf",
+    args: [address],
+  });
+  const { data: allowance, refetch: refetchAllowance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "allowance",
+    args: [address, stakerAddress],
+  });
+  const { data: stakedBalance, refetch: refetchStakedBalance } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "balances",
+    args: [address],
+  });
+  const { data: ethBalance } = useWatchBalance({ address, chain: targetNetwork });
+  const { price: ethPrice } = useFetchNativeCurrencyPrice();
+
+  const { writeContractAsync: writeUsdc } = useScaffoldWriteContract({ contractName: "USDC" });
+  const { writeContractAsync: writeStaker } = useScaffoldWriteContract({ contractName: "Staker" });
+
+  const isWrongNetwork = !!address && chain?.id !== targetNetwork.id;
+  const contractsMissing = !isStakerLoading && !isUsdcLoading && (!stakerContract || !usdcContract);
+  const amount = parseAmount(amountInput);
+  const exceedsBalance = amount !== undefined && usdcBalance !== undefined && amount > usdcBalance;
+  const needsApproval = amount !== undefined && allowance !== undefined && allowance < amount;
+  const isLowOnGas = ethBalance !== undefined && ethBalance.value < LOW_GAS_BALANCE;
+  const isStakeFlowBusy = isApproving || isStaking;
+
+  const refreshBalances = () => Promise.all([refetchUsdcBalance(), refetchStakedBalance(), refetchAllowance()]);
+
+  const handleSwitchNetwork = async () => {
+    setIsSwitching(true);
+    try {
+      await switchChainAsync({ chainId: targetNetwork.id });
+    } catch (e) {
+      setStakeError(parseTxError(e));
+    } finally {
+      setIsSwitching(false);
+    }
+  };
+
+  const handleApprove = async () => {
+    if (!amount || !stakerAddress) return;
+    setStakeError(undefined);
+    setIsApproving(true);
+    try {
+      // Approve exactly the amount being staked — no unlimited approvals
+      await writeUsdc({ functionName: "approve", args: [stakerAddress, amount] });
+      // Keep the button locked until the new allowance is actually read back, so Approve can't be clicked twice
+      await refetchAllowance();
+    } catch (e) {
+      setStakeError(parseTxError(e));
+    } finally {
+      setIsApproving(false);
+    }
+  };
+
+  const handleStake = async () => {
+    if (!amount) return;
+    setStakeError(undefined);
+    setIsStaking(true);
+    try {
+      const txHash = await writeStaker({ functionName: "stake", args: [amount] });
+      if (txHash) setAmountInput("");
+      await refreshBalances();
+    } catch (e) {
+      setStakeError(parseTxError(e));
+    } finally {
+      setIsStaking(false);
+    }
+  };
+
+  const handleWithdraw = async () => {
+    setWithdrawError(undefined);
+    setIsWithdrawing(true);
+    try {
+      await writeStaker({ functionName: "withdraw" });
+      await refreshBalances();
+    } catch (e) {
+      setWithdrawError(parseTxError(e));
+    } finally {
+      setIsWithdrawing(false);
+    }
+  };
+
+  const renderStakeAction = () => {
+    const buttonClass = "btn btn-primary w-full";
+
+    if (!address) {
+      return (
+        <button className={buttonClass} onClick={openConnectModal}>
+          Connect Wallet
+        </button>
+      );
+    }
+    if (isWrongNetwork) {
+      return (
+        <button className={buttonClass} disabled={isSwitching} onClick={handleSwitchNetwork}>
+          {isSwitching && <Spinner />}
+          {isSwitching ? "Switching..." : `Switch to ${targetNetwork.name}`}
+        </button>
+      );
+    }
+    if (contractsMissing) {
+      return (
+        <button className={buttonClass} disabled>
+          Staking is not available on {targetNetwork.name} yet
+        </button>
+      );
+    }
+    if (isApproving) {
+      return (
+        <button className={buttonClass} disabled>
+          <Spinner /> Approving...
+        </button>
+      );
+    }
+    if (isStaking) {
+      return (
+        <button className={buttonClass} disabled>
+          <Spinner /> Staking...
+        </button>
+      );
+    }
+    if (!amount) {
+      return (
+        <button className={buttonClass} disabled>
+          Enter an amount
+        </button>
+      );
+    }
+    if (exceedsBalance) {
+      return (
+        <button className={buttonClass} disabled>
+          Insufficient USDC balance
+        </button>
+      );
+    }
+    if (allowance === undefined) {
+      return (
+        <button className={buttonClass} disabled>
+          <Spinner /> Checking approval...
+        </button>
+      );
+    }
+    if (needsApproval) {
+      return (
+        <button className={buttonClass} onClick={handleApprove}>
+          Approve {formatUsdc(amount)} USDC
+        </button>
+      );
+    }
+    return (
+      <button className={buttonClass} onClick={handleStake}>
+        Stake {formatUsdc(amount)} USDC
+      </button>
+    );
+  };
+
+  const hasStake = stakedBalance !== undefined && stakedBalance > 0n;
+  const canWithdraw = !!address && !isWrongNetwork && !contractsMissing && hasStake && !isWithdrawing;
+
+  return (
+    <div className="flex flex-col gap-6 w-full max-w-lg">
+      <div className="card bg-base-100 shadow-md">
+        <div className="card-body">
+          <h2 className="card-title">Your wallet</h2>
+          {address ? (
+            <>
+              <Address address={address} chain={targetNetwork} />
+              <div className="divide-y divide-base-300">
+                <StatRow
+                  label="USDC balance"
+                  value={usdcBalance !== undefined ? `${formatUsdc(usdcBalance)} USDC` : undefined}
+                  usd={usdcBalance !== undefined ? formatUsdcAsUsd(usdcBalance) : undefined}
+                />
+                <StatRow
+                  label="ETH balance (for gas)"
+                  value={ethBalance !== undefined ? `${formatEth(ethBalance.value)} ETH` : undefined}
+                  usd={
+                    ethBalance !== undefined && ethPrice > 0 ? formatEthAsUsd(ethBalance.value, ethPrice) : undefined
+                  }
+                />
+              </div>
+              {isLowOnGas && (
+                <div role="alert" className="alert alert-warning alert-soft text-sm">
+                  You have little or no ETH on {targetNetwork.name}. You need a small amount of ETH to pay network fees
+                  for approving, staking and withdrawing.
+                </div>
+              )}
+            </>
+          ) : (
+            <p className="text-base-content/70 m-0">Connect your wallet to see your balances.</p>
+          )}
+        </div>
+      </div>
+
+      <div className="card bg-base-100 shadow-md">
+        <div className="card-body gap-4">
+          <h2 className="card-title">Stake USDC</h2>
+          <label className="form-control w-full">
+            <div className="flex justify-between text-sm mb-1">
+              <span>Amount</span>
+              {usdcBalance !== undefined && (
+                <button
+                  type="button"
+                  className="link link-primary no-underline"
+                  disabled={isStakeFlowBusy}
+                  onClick={() => setAmountInput(formatUnits(usdcBalance, USDC_DECIMALS))}
+                >
+                  Max: {formatUsdc(usdcBalance)}
+                </button>
+              )}
+            </div>
+            <div className="join w-full">
+              <input
+                type="text"
+                inputMode="decimal"
+                placeholder="0.00"
+                className="input join-item w-full"
+                value={amountInput}
+                disabled={isStakeFlowBusy}
+                onChange={e => {
+                  const value = e.target.value.trim().replace(",", ".");
+                  if (AMOUNT_REGEX.test(value)) {
+                    setAmountInput(value);
+                    setStakeError(undefined);
+                  }
+                }}
+              />
+              <span className="btn join-item no-animation pointer-events-none">USDC</span>
+            </div>
+            <span className="text-xs text-base-content/60 mt-1 min-h-4">
+              {amount ? `~${formatUsdcAsUsd(amount)}` : ""}
+            </span>
+          </label>
+
+          {renderStakeAction()}
+
+          {needsApproval && !isApproving && !exceedsBalance && !isWrongNetwork && (
+            <p className="text-xs text-base-content/60 m-0">
+              Step 1 of 2: allow the staking contract to move exactly this amount of your USDC. You will stake in the
+              next step.
+            </p>
+          )}
+          {stakeError && (
+            <div role="alert" className="alert alert-error alert-soft text-sm">
+              {stakeError}
+            </div>
+          )}
+        </div>
+      </div>
+
+      <div className="card bg-base-100 shadow-md">
+        <div className="card-body gap-4">
+          <h2 className="card-title">Your staked position</h2>
+          <StatRow
+            label="Staked"
+            value={!address ? "—" : stakedBalance !== undefined ? `${formatUsdc(stakedBalance)} USDC` : undefined}
+            usd={stakedBalance !== undefined ? formatUsdcAsUsd(stakedBalance) : undefined}
+          />
+          <button className="btn btn-outline w-full" disabled={!canWithdraw} onClick={handleWithdraw}>
+            {isWithdrawing && <Spinner />}
+            {isWithdrawing
+              ? "Withdrawing..."
+              : hasStake
+                ? `Withdraw all (${formatUsdc(stakedBalance)} USDC)`
+                : "Nothing to withdraw"}
+          </button>
+          <p className="text-xs text-base-content/60 m-0">
+            You can withdraw your full position at any time. Staking earns no rewards.
+          </p>
+          {withdrawError && (
+            <div role="alert" className="alert alert-error alert-soft text-sm">
+              {withdrawError}
+            </div>
+          )}
+        </div>
+      </div>
+
+      {stakerContract && usdcContract && (
+        <div className="text-xs text-base-content/60 flex flex-col gap-2 px-2">
+          <div className="flex items-center justify-between gap-2">
+            <span>Staking contract</span>
+            <Address address={stakerContract.address} chain={targetNetwork} size="xs" />
+          </div>
+          <div className="flex items-center justify-between gap-2">
+            <span>USDC token</span>
+            <Address address={usdcContract.address} chain={targetNetwork} size="xs" />
+          </div>
+        </div>
+      )}
+    </div>
+  );
+};
diff --git a/packages/nextjs/app/stake/_components/format.ts b/packages/nextjs/app/stake/_components/format.ts
new file mode 100644
index 0000000..ff1f6f1
--- /dev/null
+++ b/packages/nextjs/app/stake/_components/format.ts
@@ -0,0 +1,17 @@
+import { formatUnits } from "viem";
+
+export const USDC_DECIMALS = 6;
+
+const usdFormatter = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" });
+
+export const formatUsdc = (amount: bigint) =>
+  Number(formatUnits(amount, USDC_DECIMALS)).toLocaleString("en-US", { maximumFractionDigits: USDC_DECIMALS });
+
+// USDC is a 1:1 USD stablecoin, so its dollar value is the token amount itself
+export const formatUsdcAsUsd = (amount: bigint) => usdFormatter.format(Number(formatUnits(amount, USDC_DECIMALS)));
+
+export const formatEth = (amount: bigint) =>
+  Number(formatUnits(amount, 18)).toLocaleString("en-US", { maximumFractionDigits: 6 });
+
+export const formatEthAsUsd = (amount: bigint, ethPrice: number) =>
+  usdFormatter.format(Number(formatUnits(amount, 18)) * ethPrice);
diff --git a/packages/nextjs/app/stake/_components/parseTxError.ts b/packages/nextjs/app/stake/_components/parseTxError.ts
new file mode 100644
index 0000000..b4fc0d5
--- /dev/null
+++ b/packages/nextjs/app/stake/_components/parseTxError.ts
@@ -0,0 +1,35 @@
+import { BaseError, ContractFunctionRevertedError, InsufficientFundsError, UserRejectedRequestError } from "viem";
+import { getParsedError } from "~~/utils/scaffold-eth";
+
+// Staker custom errors plus the revert reasons used by the real (FiatToken) USDC and the OZ-based mock
+const REVERT_MESSAGES: Record<string, string> = {
+  ZeroAmount: "Enter an amount greater than zero.",
+  NothingToWithdraw: "You have nothing staked to withdraw.",
+  ERC20InsufficientBalance: "Your USDC balance is too low for this amount.",
+  ERC20InsufficientAllowance: "USDC approval is too low. Approve the amount again, then stake.",
+  "transfer amount exceeds balance": "Your USDC balance is too low for this amount.",
+  "transfer amount exceeds allowance": "USDC approval is too low. Approve the amount again, then stake.",
+  "account is blacklisted": "This address is blocked by the USDC issuer and cannot move USDC.",
+  paused: "USDC transfers are temporarily paused by the issuer. Try again later.",
+};
+
+/** Turns wallet/RPC/contract errors into a short message a user can act on. */
+export const parseTxError = (error: unknown): string => {
+  if (error instanceof BaseError) {
+    if (error.walk(e => e instanceof UserRejectedRequestError)) return "Transaction cancelled in your wallet.";
+    if (error.walk(e => e instanceof InsufficientFundsError)) {
+      return "Not enough ETH to pay the network fee. Add a little ETH on Base and try again.";
+    }
+
+    const revert = error.walk(e => e instanceof ContractFunctionRevertedError);
+    if (revert instanceof ContractFunctionRevertedError) {
+      const reason = revert.data?.errorName === "Error" ? String(revert.data.args?.[0] ?? "") : revert.data?.errorName;
+      const match = Object.keys(REVERT_MESSAGES).find(key => (reason ?? revert.reason ?? "").includes(key));
+      if (match) return REVERT_MESSAGES[match];
+    }
+  }
+
+  const fallback = getParsedError(error);
+  if (/user (rejected|denied)/i.test(fallback)) return "Transaction cancelled in your wallet.";
+  return fallback || "Something went wrong. Please try again.";
+};
