@@ -0,0 +1,46 @@
+import { deployScript, artifacts } from "../rocketh/deploy.js";
+
+// Canonical Circle-issued USDC per chain. The local hardhat chain gets a MockUSDC instead.
+const USDC_BY_CHAIN_ID: Record<number, `0x${string}`> = {
+  8453: "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913", // Base
+  84532: "0x036CbD53842c5426634e7929541eC2318f3dCF7e", // Base Sepolia
+};
+
+const LOCAL_CHAIN_ID = 31337;
+const LOCAL_DEPLOYER_USDC = 1_000_000n * 10n ** 6n;
+
+export default deployScript(
+  async env => {
+    const { deployer } = env.namedAccounts;
+    const chainId = env.network.chain.id;
+
+    let usdcAddress = USDC_BY_CHAIN_ID[chainId];
+    if (!usdcAddress) {
+      if (chainId !== LOCAL_CHAIN_ID) {
+        throw new Error(`No USDC address configured for chain ${chainId}. Add it to USDC_BY_CHAIN_ID.`);
+      }
+      // Named "USDC" so the frontend uses the same contract name locally and on Base
+      const mockUsdc = await env.deploy("USDC", {
+        account: deployer,
+        artifact: artifacts.MockUSDC,
+        args: [],
+      });
+      await env.execute(mockUsdc, {
+        account: deployer,
+        functionName: "mint",
+        args: [deployer, LOCAL_DEPLOYER_USDC],
+      });
+      usdcAddress = mockUsdc.address;
+    }
+
+    const staker = await env.deploy("Staker", {
+      account: deployer,
+      artifact: artifacts.Staker,
+      args: [usdcAddress],
+    });
+    console.log(`🏦 Staker deployed at ${staker.address} (USDC ${usdcAddress})`);
+  },
+  {
+    tags: ["Staker"],
+  },
+);
