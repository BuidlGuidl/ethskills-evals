+"use client";
+
+import { useMemo, useState } from "react";
+import { Address } from "@scaffold-ui/components";
+import { useFetchNativeCurrencyPrice } from "@scaffold-ui/hooks";
+import type { NextPage } from "next";
+import { formatEther, formatUnits, parseUnits } from "viem";
+import { useAccount, useBalance, useSwitchChain } from "wagmi";
+import { ArrowDownTrayIcon, ArrowPathIcon, ArrowUpTrayIcon, BanknotesIcon } from "@heroicons/react/24/outline";
+import { RainbowKitCustomConnectButton } from "~~/components/scaffold-eth";
+import {
+  useDeployedContractInfo,
+  useScaffoldReadContract,
+  useScaffoldWriteContract,
+  useTargetNetwork,
+} from "~~/hooks/scaffold-eth";
+import { AllowedChainIds, getParsedError } from "~~/utils/scaffold-eth";
+
+const USDC_DECIMALS = 6;
+
+const formatUsd = (value: number) =>
+  new Intl.NumberFormat("en-US", {
+    style: "currency",
+    currency: "USD",
+    maximumFractionDigits: 2,
+  }).format(Number.isFinite(value) ? value : 0);
+
+const formatTokenAmount = (amount?: bigint, maximumFractionDigits = 2) => {
+  if (amount === undefined) return "0.00";
+
+  return new Intl.NumberFormat("en-US", {
+    minimumFractionDigits: 2,
+    maximumFractionDigits,
+  }).format(Number(formatUnits(amount, USDC_DECIMALS)));
+};
+
+const formatEthAmount = (amount?: bigint) => {
+  if (amount === undefined) return "0.0000";
+
+  return new Intl.NumberFormat("en-US", {
+    minimumFractionDigits: 4,
+    maximumFractionDigits: 6,
+  }).format(Number(formatEther(amount)));
+};
+
+const getFriendlyError = (error: unknown) => {
+  const message = getParsedError(error);
+
+  if (/user rejected|denied transaction|rejected the request/i.test(message)) {
+    return "Transaction was rejected in the wallet.";
+  }
+  if (/insufficient funds/i.test(message)) {
+    return "Not enough ETH to pay for gas.";
+  }
+  if (/allowance|transfer amount exceeds allowance/i.test(message)) {
+    return "Approve enough USDC before staking.";
+  }
+  if (/balance|transfer amount exceeds balance/i.test(message)) {
+    return "Not enough USDC in this wallet.";
+  }
+
+  return message;
+};
+
+const Stake: NextPage = () => {
+  const { address: connectedAddress, chainId, isConnected } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+  const { switchChainAsync, isPending: isSwitchingNetwork } = useSwitchChain();
+  const { price: nativeCurrencyPrice } = useFetchNativeCurrencyPrice();
+
+  const [stakeInput, setStakeInput] = useState("");
+  const [approvalSubmitting, setApprovalSubmitting] = useState(false);
+  const [approveCooldown, setApproveCooldown] = useState(false);
+  const [isStaking, setIsStaking] = useState(false);
+  const [isWithdrawing, setIsWithdrawing] = useState(false);
+  const [txError, setTxError] = useState<string>();
+  const selectedChainId = targetNetwork.id as AllowedChainIds;
+
+  const { data: stakerInfo, isLoading: isStakerLoading } = useDeployedContractInfo({
+    contractName: "Staker",
+    chainId: selectedChainId,
+  });
+
+  const { data: usdcInfo, isLoading: isUsdcLoading } = useDeployedContractInfo({
+    contractName: "USDC",
+    chainId: selectedChainId,
+  });
+
+  const { data: walletUsdcBalance, refetch: refetchWalletUsdcBalance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "balanceOf",
+    args: [connectedAddress],
+    chainId: selectedChainId,
+    query: { enabled: Boolean(connectedAddress && usdcInfo) },
+  });
+
+  const { data: allowance, refetch: refetchAllowance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "allowance",
+    args: [connectedAddress, stakerInfo?.address],
+    chainId: selectedChainId,
+    query: { enabled: Boolean(connectedAddress && usdcInfo && stakerInfo) },
+  });
+
+  const { data: stakedPosition, refetch: refetchStakedPosition } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "positions",
+    args: [connectedAddress],
+    chainId: selectedChainId,
+    query: { enabled: Boolean(connectedAddress && stakerInfo) },
+  });
+
+  const { data: totalStaked, refetch: refetchTotalStaked } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "totalStaked",
+    chainId: selectedChainId,
+    query: { enabled: Boolean(stakerInfo) },
+  });
+
+  const { data: ethBalance, refetch: refetchEthBalance } = useBalance({
+    address: connectedAddress,
+    chainId: selectedChainId,
+    query: { enabled: Boolean(connectedAddress) },
+  });
+
+  const { writeContractAsync: writeUsdcAsync, isMining: isApprovingOnchain } = useScaffoldWriteContract({
+    contractName: "USDC",
+    chainId: selectedChainId,
+  });
+
+  const { writeContractAsync: writeStakeAsync, isMining: isStakeOnchain } = useScaffoldWriteContract({
+    contractName: "Staker",
+    chainId: selectedChainId,
+  });
+
+  const { writeContractAsync: writeWithdrawAsync, isMining: isWithdrawOnchain } = useScaffoldWriteContract({
+    contractName: "Staker",
+    chainId: selectedChainId,
+  });
+
+  const parsedStakeAmount = useMemo(() => {
+    const normalizedValue = stakeInput.trim();
+    if (!normalizedValue) return undefined;
+
+    try {
+      return parseUnits(normalizedValue, USDC_DECIMALS);
+    } catch {
+      return undefined;
+    }
+  }, [stakeInput]);
+
+  const wrongNetwork = isConnected && chainId !== targetNetwork.id;
+  const hasValidStakeAmount = parsedStakeAmount !== undefined && parsedStakeAmount > 0n;
+  const hasEnoughUsdc =
+    hasValidStakeAmount && walletUsdcBalance !== undefined && walletUsdcBalance >= parsedStakeAmount;
+  const needsApproval = hasValidStakeAmount && (allowance ?? 0n) < (parsedStakeAmount ?? 0n);
+  const stakerUnavailable = !isStakerLoading && !stakerInfo;
+  const usdcUnavailable = !isUsdcLoading && !usdcInfo;
+  const approvePending = approvalSubmitting || approveCooldown || isApprovingOnchain;
+  const stakePending = isStaking || isStakeOnchain;
+  const withdrawPending = isWithdrawing || isWithdrawOnchain;
+  const inputUsdValue = parsedStakeAmount ? Number(formatUnits(parsedStakeAmount, USDC_DECIMALS)) : 0;
+  const ethUsdValue = ethBalance ? Number(formatEther(ethBalance.value)) * nativeCurrencyPrice : 0;
+
+  const refetchPositionData = () => {
+    void refetchWalletUsdcBalance();
+    void refetchAllowance();
+    void refetchStakedPosition();
+    void refetchTotalStaked();
+    void refetchEthBalance();
+  };
+
+  const handleSwitchNetwork = async () => {
+    setTxError(undefined);
+    try {
+      await switchChainAsync({ chainId: targetNetwork.id });
+    } catch (error) {
+      setTxError(getFriendlyError(error));
+    }
+  };
+
+  const handleApprove = async () => {
+    if (!parsedStakeAmount || !stakerInfo) return;
+
+    setTxError(undefined);
+    setApprovalSubmitting(true);
+    try {
+      await writeUsdcAsync(
+        {
+          functionName: "approve",
+          args: [stakerInfo.address, parsedStakeAmount],
+        },
+        {
+          onBlockConfirmation: () => {
+            void refetchAllowance();
+          },
+        },
+      );
+      setApproveCooldown(true);
+      window.setTimeout(() => {
+        void refetchAllowance();
+        setApproveCooldown(false);
+      }, 4000);
+    } catch (error) {
+      setTxError(getFriendlyError(error));
+    } finally {
+      setApprovalSubmitting(false);
+    }
+  };
+
+  const handleStake = async () => {
+    if (!parsedStakeAmount) return;
+
+    setTxError(undefined);
+    setIsStaking(true);
+    try {
+      await writeStakeAsync(
+        {
+          functionName: "stake",
+          args: [parsedStakeAmount],
+        },
+        {
+          onBlockConfirmation: refetchPositionData,
+        },
+      );
+      setStakeInput("");
+      refetchPositionData();
+    } catch (error) {
+      setTxError(getFriendlyError(error));
+    } finally {
+      setIsStaking(false);
+    }
+  };
+
+  const handleWithdraw = async () => {
+    setTxError(undefined);
+    setIsWithdrawing(true);
+    try {
+      await writeWithdrawAsync(
+        {
+          functionName: "withdraw",
+        },
+        {
+          onBlockConfirmation: refetchPositionData,
+        },
+      );
+      refetchPositionData();
+    } catch (error) {
+      setTxError(getFriendlyError(error));
+    } finally {
+      setIsWithdrawing(false);
+    }
+  };
+
+  const renderStakeAction = () => {
+    if (!isConnected) {
+      return <RainbowKitCustomConnectButton />;
+    }
+
+    if (wrongNetwork) {
+      return (
+        <button
+          className="btn btn-primary w-full sm:w-auto"
+          onClick={handleSwitchNetwork}
+          disabled={isSwitchingNetwork}
+        >
+          {isSwitchingNetwork && <span className="loading loading-spinner loading-sm" />}
+          {isSwitchingNetwork ? "Switching..." : `Switch to ${targetNetwork.name}`}
+        </button>
+      );
+    }
+
+    const disabled =
+      stakerUnavailable ||
+      usdcUnavailable ||
+      !hasValidStakeAmount ||
+      !hasEnoughUsdc ||
+      approvePending ||
+      stakePending ||
+      isStakerLoading ||
+      isUsdcLoading;
+
+    if (needsApproval) {
+      return (
+        <button className="btn btn-primary w-full sm:w-auto" onClick={handleApprove} disabled={disabled}>
+          {approvePending && <span className="loading loading-spinner loading-sm" />}
+          {approveCooldown ? "Refreshing allowance..." : approvePending ? "Approving..." : "Approve USDC"}
+        </button>
+      );
+    }
+
+    return (
+      <button className="btn btn-primary w-full sm:w-auto" onClick={handleStake} disabled={disabled}>
+        {stakePending && <span className="loading loading-spinner loading-sm" />}
+        {stakePending ? "Staking..." : "Stake USDC"}
+      </button>
+    );
+  };
+
+  return (
+    <main className="grow bg-base-200">
+      <div className="mx-auto flex w-full max-w-6xl flex-col gap-6 px-4 py-8 sm:px-6 lg:px-8">
+        <section className="flex flex-col gap-3">
+          <div className="flex flex-wrap items-center justify-between gap-4">
+            <div>
+              <p className="text-sm font-medium text-primary">Base USDC</p>
+              <h1 className="text-3xl font-bold tracking-normal sm:text-4xl">USDC Staking</h1>
+            </div>
+            {stakerInfo && (
+              <div className="flex items-center gap-2 rounded-none border border-base-300 bg-base-100 px-3 py-2 text-sm">
+                <span className="text-base-content/60">Contract</span>
+                <Address address={stakerInfo.address} chain={targetNetwork} />
+              </div>
+            )}
+          </div>
+          {(stakerUnavailable || usdcUnavailable) && (
+            <div className="alert alert-warning rounded-none">
+              <BanknotesIcon className="h-5 w-5" />
+              <span>
+                {stakerUnavailable
+                  ? "Staker is not configured on this network."
+                  : "USDC is not available on this network."}
+              </span>
+            </div>
+          )}
+        </section>
+
+        <section className="grid gap-4 md:grid-cols-3">
+          <div className="bg-base-100 p-5 shadow-sm">
+            <div className="flex items-center gap-2 text-sm text-base-content/60">
+              <BanknotesIcon className="h-5 w-5" />
+              Wallet USDC
+            </div>
+            <div className="mt-3 text-2xl font-semibold">{formatTokenAmount(walletUsdcBalance)} USDC</div>
+            <div className="text-sm text-base-content/60">
+              {formatUsd(Number(formatUnits(walletUsdcBalance ?? 0n, 6)))}
+            </div>
+          </div>
+          <div className="bg-base-100 p-5 shadow-sm">
+            <div className="flex items-center gap-2 text-sm text-base-content/60">
+              <ArrowPathIcon className="h-5 w-5" />
+              Gas Balance
+            </div>
+            <div className="mt-3 text-2xl font-semibold">
+              {formatEthAmount(ethBalance?.value)} {targetNetwork.nativeCurrency.symbol}
+            </div>
+            <div className="text-sm text-base-content/60">{formatUsd(ethUsdValue)}</div>
+          </div>
+          <div className="bg-base-100 p-5 shadow-sm">
+            <div className="flex items-center gap-2 text-sm text-base-content/60">
+              <ArrowDownTrayIcon className="h-5 w-5" />
+              Your Position
+            </div>
+            <div className="mt-3 text-2xl font-semibold">{formatTokenAmount(stakedPosition)} USDC</div>
+            <div className="text-sm text-base-content/60">
+              {formatUsd(Number(formatUnits(stakedPosition ?? 0n, 6)))}
+            </div>
+          </div>
+        </section>
+
+        <section className="grid gap-6 lg:grid-cols-[minmax(0,1fr)_360px]">
+          <div className="bg-base-100 p-5 shadow-sm">
+            <div className="mb-5 flex items-center justify-between gap-3">
+              <div>
+                <h2 className="text-xl font-semibold">Stake</h2>
+                <p className="text-sm text-base-content/60">{formatUsd(inputUsdValue)}</p>
+              </div>
+              <button
+                className="btn btn-ghost btn-sm"
+                disabled={!walletUsdcBalance || walletUsdcBalance === 0n || approvePending || stakePending}
+                onClick={() => setStakeInput(formatUnits(walletUsdcBalance ?? 0n, USDC_DECIMALS))}
+              >
+                Max
+              </button>
+            </div>
+            <label className="input input-bordered flex h-16 items-center gap-3 rounded-none">
+              <input
+                className="grow text-2xl"
+                inputMode="decimal"
+                min="0"
+                placeholder="0.00"
+                type="text"
+                value={stakeInput}
+                onChange={event => {
+                  setTxError(undefined);
+                  setStakeInput(event.target.value.replace(/[^\d.]/g, ""));
+                }}
+              />
+              <span className="font-semibold">USDC</span>
+            </label>
+            <div className="mt-4 flex flex-col items-stretch justify-between gap-3 sm:flex-row sm:items-center">
+              <div className="text-sm text-base-content/60">Allowance: {formatTokenAmount(allowance, 6)} USDC</div>
+              {renderStakeAction()}
+            </div>
+          </div>
+
+          <div className="bg-base-100 p-5 shadow-sm">
+            <div className="mb-5 flex items-center justify-between">
+              <div>
+                <h2 className="text-xl font-semibold">Withdraw</h2>
+                <p className="text-sm text-base-content/60">
+                  {formatUsd(Number(formatUnits(stakedPosition ?? 0n, 6)))}
+                </p>
+              </div>
+              <ArrowUpTrayIcon className="h-6 w-6 text-base-content/50" />
+            </div>
+            <div className="text-3xl font-semibold">{formatTokenAmount(stakedPosition)} USDC</div>
+            <button
+              className="btn btn-secondary mt-5 w-full"
+              disabled={
+                !isConnected ||
+                wrongNetwork ||
+                stakerUnavailable ||
+                withdrawPending ||
+                !stakedPosition ||
+                stakedPosition === 0n
+              }
+              onClick={handleWithdraw}
+            >
+              {withdrawPending && <span className="loading loading-spinner loading-sm" />}
+              {withdrawPending ? "Withdrawing..." : "Withdraw full position"}
+            </button>
+          </div>
+        </section>
+
+        <section className="grid gap-4 md:grid-cols-2">
+          <div className="bg-base-100 p-5 shadow-sm">
+            <div className="text-sm text-base-content/60">Total staked</div>
+            <div className="mt-2 text-2xl font-semibold">{formatTokenAmount(totalStaked)} USDC</div>
+            <div className="text-sm text-base-content/60">{formatUsd(Number(formatUnits(totalStaked ?? 0n, 6)))}</div>
+          </div>
+          {txError && (
+            <div className="alert alert-error rounded-none">
+              <span>{txError}</span>
+            </div>
+          )}
+        </section>
+      </div>
+    </main>
+  );
+};
+
+export default Stake;
