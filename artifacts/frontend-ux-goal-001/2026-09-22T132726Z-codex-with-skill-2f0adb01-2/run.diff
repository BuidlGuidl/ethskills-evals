diff --git a/packages/hardhat/test/Staker.ts b/packages/hardhat/test/Staker.ts
new file mode 100644
index 0000000..0460736
--- /dev/null
+++ b/packages/hardhat/test/Staker.ts
@@ -0,0 +1,91 @@
+import { expect } from "chai";
+import { network } from "hardhat";
+import type { Abi_MockUSDC } from "../generated/abis/MockUSDC.js";
+import type { Abi_Staker } from "../generated/abis/Staker.js";
+import { loadAndExecuteDeploymentsFromFiles } from "../rocketh/environment.js";
+
+const { provider, networkHelpers, ethers } = await network.create();
+
+async function deployFixture() {
+  const env = await loadAndExecuteDeploymentsFromFiles({ provider });
+  const { address: stakerAddress, abi: stakerAbi } = env.get<Abi_Staker>("Staker");
+  const { address: usdcAddress, abi: usdcAbi } = env.get<Abi_MockUSDC>("USDC");
+  const staker = await ethers.getContractAt(stakerAbi, stakerAddress);
+  const usdc = await ethers.getContractAt(usdcAbi, usdcAddress);
+  const [deployer, alice] = await ethers.getSigners();
+
+  return { staker, usdc, deployer, alice };
+}
+
+describe("Staker", function () {
+  it("deploys with a faithful 6-decimal USDC mock on local networks", async function () {
+    const { staker, usdc, deployer } = await networkHelpers.loadFixture(deployFixture);
+
+    expect(await usdc.name()).to.equal("USD Coin");
+    expect(await usdc.symbol()).to.equal("USDC");
+    expect(await usdc.decimals()).to.equal(6);
+    expect((await staker.usdc()).toLowerCase()).to.equal((await usdc.getAddress()).toLowerCase());
+    expect(await usdc.balanceOf(deployer.address)).to.equal(ethers.parseUnits("1000000", 6));
+  });
+
+  it("lets a user stake USDC after approval", async function () {
+    const { staker, usdc, deployer, alice } = await networkHelpers.loadFixture(deployFixture);
+    const amount = ethers.parseUnits("125.50", 6);
+
+    await usdc.transfer(alice.address, amount);
+    await usdc.connect(alice).approve(await staker.getAddress(), amount);
+
+    await expect(staker.connect(alice).stake(amount)).to.emit(staker, "Staked").withArgs(alice.address, amount);
+
+    expect(await staker.positions(alice.address)).to.equal(amount);
+    expect(await staker.totalStaked()).to.equal(amount);
+    expect(await usdc.balanceOf(await staker.getAddress())).to.equal(amount);
+    expect(await usdc.balanceOf(deployer.address)).to.equal(ethers.parseUnits("1000000", 6) - amount);
+  });
+
+  it("adds repeat stakes to the user's position", async function () {
+    const { staker, usdc, alice } = await networkHelpers.loadFixture(deployFixture);
+    const firstAmount = ethers.parseUnits("10", 6);
+    const secondAmount = ethers.parseUnits("15", 6);
+
+    await usdc.transfer(alice.address, firstAmount + secondAmount);
+    await usdc.connect(alice).approve(await staker.getAddress(), firstAmount + secondAmount);
+    await staker.connect(alice).stake(firstAmount);
+    await staker.connect(alice).stake(secondAmount);
+
+    expect(await staker.positions(alice.address)).to.equal(firstAmount + secondAmount);
+    expect(await staker.totalStaked()).to.equal(firstAmount + secondAmount);
+  });
+
+  it("withdraws the user's full position", async function () {
+    const { staker, usdc, alice } = await networkHelpers.loadFixture(deployFixture);
+    const amount = ethers.parseUnits("42", 6);
+
+    await usdc.transfer(alice.address, amount);
+    await usdc.connect(alice).approve(await staker.getAddress(), amount);
+    await staker.connect(alice).stake(amount);
+
+    await expect(staker.connect(alice).withdraw()).to.emit(staker, "Withdrawn").withArgs(alice.address, amount);
+
+    expect(await staker.positions(alice.address)).to.equal(0n);
+    expect(await staker.totalStaked()).to.equal(0n);
+    expect(await usdc.balanceOf(alice.address)).to.equal(amount);
+    expect(await usdc.balanceOf(await staker.getAddress())).to.equal(0n);
+  });
+
+  it("reverts zero-amount stakes and empty withdrawals", async function () {
+    const { staker, alice } = await networkHelpers.loadFixture(deployFixture);
+
+    await expect(staker.connect(alice).stake(0n)).to.be.revertedWithCustomError(staker, "ZeroAmount");
+    await expect(staker.connect(alice).withdraw()).to.be.revertedWithCustomError(staker, "NoPosition");
+  });
+
+  it("reverts when the user has not approved enough USDC", async function () {
+    const { staker, usdc, alice } = await networkHelpers.loadFixture(deployFixture);
+    const amount = ethers.parseUnits("5", 6);
+
+    await usdc.transfer(alice.address, amount);
+
+    await expect(staker.connect(alice).stake(amount)).to.be.revert(ethers);
+  });
+});
