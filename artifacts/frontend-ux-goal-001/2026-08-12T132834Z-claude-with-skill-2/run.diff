+++ b/packages/nextjs/utils/amounts.ts
@@ -0,0 +1,57 @@
+import { formatUnits, parseUnits } from "viem";
+
+/** Fixed locale so server and client render identical strings. */
+const LOCALE = "en-US";
+
+/**
+ * Formats a token amount for display: always at least 2 decimals so USDC reads
+ * like money, never more than the token itself supports, and never truncated to
+ * zero when a small balance exists.
+ */
+export const formatTokenAmount = (value: bigint, decimals: number) =>
+  new Intl.NumberFormat(LOCALE, {
+    minimumFractionDigits: 2,
+    maximumFractionDigits: Math.max(decimals, 2),
+  }).format(Number(formatUnits(value, decimals)));
+
+export const formatUsd = (value: number) =>
+  new Intl.NumberFormat(LOCALE, {
+    style: "currency",
+    currency: "USD",
+    minimumFractionDigits: 2,
+    maximumFractionDigits: 2,
+  }).format(value);
+
+export const toNumber = (value: bigint, decimals: number) => Number(formatUnits(value, decimals));
+
+/**
+ * Parses user input into base units, returning why the input was rejected so
+ * the form can explain itself instead of just disabling the button.
+ */
+export const parseTokenAmount = (
+  input: string,
+  decimals: number,
+  symbol: string,
+): { amount?: bigint; error?: string } => {
+  const value = input.trim();
+  if (value === "") return {};
+
+  if (!/^\d*\.?\d*$/.test(value)) {
+    return { error: "Enter a plain number, e.g. 100.50" };
+  }
+
+  const [, fraction = ""] = value.split(".");
+  if (fraction.length > decimals) {
+    return { error: `${symbol} supports at most ${decimals} decimals` };
+  }
+
+  try {
+    const amount = parseUnits(value, decimals);
+    // "0", "0." and friends are treated as "nothing entered yet" rather than an
+    // error, so the form does not shout at someone mid-keystroke.
+    if (amount === 0n) return {};
+    return { amount };
+  } catch {
+    return { error: "Enter a plain number, e.g. 100.50" };
+  }
+};
