+  disabled?: boolean;
+  hasError?: boolean;
+  onMax: () => void;
+  isMaxDisabled?: boolean;
+};
+
+export const AmountInput = ({
+  value,
+  onChange,
+  symbol,
+  disabled,
+  hasError,
+  onMax,
+  isMaxDisabled,
+}: AmountInputProps) => (
+  <BaseInput
+    name="amount"
+    value={value}
+    onChange={onChange}
