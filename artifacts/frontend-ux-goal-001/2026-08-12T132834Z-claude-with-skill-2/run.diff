diff --git a/packages/nextjs/hooks/usePrices.ts b/packages/nextjs/hooks/usePrices.ts
new file mode 100644
index 0000000..c00ad53
--- /dev/null
+++ b/packages/nextjs/hooks/usePrices.ts
@@ -0,0 +1,109 @@
+import { useFetchNativeCurrencyPrice } from "@scaffold-ui/hooks";
+import type { Address } from "viem";
+import { base } from "viem/chains";
+import { useReadContract } from "wagmi";
+import { useTargetNetwork } from "~~/hooks/scaffold-eth";
+
+/**
+ * A USD price plus the reason it may not be usable, so the UI can say
+ * "unavailable" or "stale" instead of silently showing nothing.
+ */
+export type PriceInfo = {
+  price?: number;
+  isLoading: boolean;
+  isStale: boolean;
+  isUnavailable: boolean;
+};
+
+/** Chainlink USDC/USD aggregators. Chains without one fall back to "unavailable". */
+const USDC_USD_FEEDS: Record<number, Address> = {
+  [base.id]: "0x7e860098F58bBFC8648a4311b374B1D669a2bc6B",
+};
+
+/** The Base feed answers on a 24h heartbeat (or a 0.3% move); flag anything older. */
+const FEED_STALE_AFTER_SECONDS = 26 * 60 * 60;
+
+const AGGREGATOR_V3_ABI = [
+  {
+    inputs: [],
+    name: "decimals",
+    outputs: [{ name: "", type: "uint8" }],
+    stateMutability: "view",
+    type: "function",
+  },
+  {
+    inputs: [],
+    name: "latestRoundData",
+    outputs: [
+      { name: "roundId", type: "uint80" },
+      { name: "answer", type: "int256" },
+      { name: "startedAt", type: "uint256" },
+      { name: "updatedAt", type: "uint256" },
+      { name: "answeredInRound", type: "uint80" },
+    ],
+    stateMutability: "view",
+    type: "function",
+  },
+] as const;
+
+/**
+ * USDC price in USD, read from Chainlink on the target network. USDC trades
+ * near a dollar but does not always hold it, so positions are valued at the
+ * feed price rather than assumed to be 1:1.
+ */
+export const useUsdcPrice = (): PriceInfo => {
+  const { targetNetwork } = useTargetNetwork();
+  const feedAddress = USDC_USD_FEEDS[targetNetwork.id];
+
+  const { data: feedDecimals } = useReadContract({
+    chainId: targetNetwork.id,
+    address: feedAddress,
+    abi: AGGREGATOR_V3_ABI,
+    functionName: "decimals",
+    query: { enabled: Boolean(feedAddress), staleTime: Infinity },
+  });
+
+  const {
+    data: roundData,
+    dataUpdatedAt,
+    isLoading,
+  } = useReadContract({
+    chainId: targetNetwork.id,
+    address: feedAddress,
+    abi: AGGREGATOR_V3_ABI,
+    functionName: "latestRoundData",
+    query: { enabled: Boolean(feedAddress), refetchInterval: 60_000 },
+  });
+
+  if (!feedAddress) {
+    return { isLoading: false, isStale: false, isUnavailable: true };
+  }
+
+  if (!roundData || feedDecimals === undefined) {
+    return { isLoading, isStale: false, isUnavailable: !isLoading };
+  }
+
+  const [, answer, , updatedAt] = roundData;
+  if (answer <= 0n) {
+    return { isLoading: false, isStale: false, isUnavailable: true };
+  }
+
+  const price = Number(answer) / 10 ** feedDecimals;
+  // How old the feed's answer was when we last read it.
+  const ageInSeconds = Math.floor(dataUpdatedAt / 1000) - Number(updatedAt);
+
+  return { price, isLoading: false, isStale: ageInSeconds > FEED_STALE_AFTER_SECONDS, isUnavailable: false };
+};
+
+/** ETH price in USD, used to price the gas balance. */
+export const useEthPrice = (): PriceInfo => {
+  const { targetNetwork } = useTargetNetwork();
+  const { price, isLoading, isError } = useFetchNativeCurrencyPrice(targetNetwork);
+
+  return {
+    price: price > 0 ? price : undefined,
+    isLoading,
+    isStale: false,
+    isUnavailable: isError || (!isLoading && price <= 0),
+  };
+};
diff --git a/packages/nextjs/hooks/useStakingData.ts b/packages/nextjs/hooks/useStakingData.ts
