@@ -0,0 +1,26 @@
+//SPDX-License-Identifier: MIT
+pragma solidity ^0.8.30;
+
+import { ERC20 } from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+import { ERC20Permit } from "@openzeppelin/contracts/token/ERC20/extensions/ERC20Permit.sol";
+
+/**
+ * Local-development stand-in for USDC. NEVER deployed to a live network —
+ * the deploy script points at the canonical USDC on Base and Base Sepolia.
+ *
+ * Matches the real token where it matters to the app: 6 decimals, the same
+ * name/symbol, and EIP-2612 permit like Base USDC (FiatTokenV2.2) — though the
+ * permit domain version is OZ's "1", not USDC's "2", so signatures are not
+ * interchangeable. Minting is open so any local account can fund itself.
+ */
+contract MockUSDC is ERC20, ERC20Permit {
+    constructor() ERC20("USD Coin", "USDC") ERC20Permit("USD Coin") {}
+
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    function mint(address to, uint256 amount) external {
+        _mint(to, amount);
+    }
+}
