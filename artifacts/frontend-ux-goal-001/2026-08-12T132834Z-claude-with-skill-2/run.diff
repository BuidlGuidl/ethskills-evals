+import { artifacts, deployScript } from "../rocketh/deploy.js";
+import type { Address } from "viem";
+
+/**
+ * Canonical USDC per chain. Anything not listed here (i.e. local chains) gets a
+ * MockUSDC deployment instead.
+ */
+const USDC_ADDRESSES: Record<number, Address> = {
+  8453: "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913", // Base
+  84532: "0x036CbD53842c5426634e7929541eC2318f3dCF7e", // Base Sepolia
+};
+
+/**
+ * Deploys the Staker, wired to real USDC on live networks and to a freshly
+ * deployed MockUSDC everywhere else.
+ */
+export default deployScript(
+  async env => {
+    const { deployer } = env.namedAccounts;
+    const chainId = env.network.chain.id;
+
+    let usdcAddress = USDC_ADDRESSES[chainId];
+
+    if (!usdcAddress) {
+      // Deployed under the name "USDC" so the frontend resolves the same
+      // contract name on every network.
+      const mockUsdc = await env.deploy("USDC", {
+        account: deployer,
+        artifact: artifacts.MockUSDC,
+        args: [],
+      });
+      usdcAddress = mockUsdc.address;
+      console.log("🪙 Deployed MockUSDC for local development at", usdcAddress);
+    } else {
+      console.log("🪙 Using canonical USDC at", usdcAddress);
+    }
+
+    const staker = await env.deploy("Staker", {
+      account: deployer,
+      artifact: artifacts.Staker,
+      args: [usdcAddress],
+    });
+
+    console.log("🏦 Staker deployed at", staker.address, "staking", await env.read(staker, { functionName: "token" }));
+  },
+  {
+    tags: ["Staker"],
+  },
+);
