@@ -0,0 +1,75 @@
+"use client";
+
+import { useState } from "react";
+import type { Address } from "viem";
+import { parseUnits } from "viem";
+import { useAccount, useWriteContract } from "wagmi";
+import { useTargetNetwork, useTransactor } from "~~/hooks/scaffold-eth";
+
+const MINT_ABI = [
+  {
+    inputs: [
+      { name: "to", type: "address" },
+      { name: "amount", type: "uint256" },
+    ],
+    name: "mint",
+    outputs: [],
+    stateMutability: "nonpayable",
+    type: "function",
+  },
+] as const;
+
+const MINT_AMOUNT = 1_000;
+
+/**
+ * Local-chain convenience: MockUSDC lets anyone mint, so developers can fund
+ * themselves without a faucet. Only rendered on local networks.
+ */
+export const MintTestUsdcButton = ({
+  tokenAddress,
+  decimals,
+  onMinted,
+}: {
+  tokenAddress?: Address;
+  decimals: number;
+  onMinted: () => Promise<void>;
+}) => {
+  const { address: connectedAddress } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+  const { writeContractAsync } = useWriteContract();
+  const writeTx = useTransactor();
+  const [isMinting, setIsMinting] = useState(false);
+
+  const mint = async () => {
+    if (!tokenAddress || !connectedAddress) return;
+    setIsMinting(true);
+    try {
+      await writeTx(() =>
+        writeContractAsync({
+          chainId: targetNetwork.id,
+          address: tokenAddress,
+          abi: MINT_ABI,
+          functionName: "mint",
+          args: [connectedAddress, parseUnits(String(MINT_AMOUNT), decimals)],
+        }),
+      );
+      await onMinted();
+    } catch {
+      // The transactor already showed the failure.
+    } finally {
+      setIsMinting(false);
+    }
+  };
+
+  return (
+    <button
+      className="btn btn-xs btn-outline mt-2 self-start"
+      onClick={mint}
+      disabled={isMinting || !tokenAddress || !connectedAddress}
+      type="button"
+    >
+      {isMinting && <span className="loading loading-spinner loading-xs" />}
+      Mint {MINT_AMOUNT.toLocaleString("en-US")} test USDC
+    </button>
+  );
+};
