@@ -0,0 +1,87 @@
+import { useCallback } from "react";
+import { useWatchBalance } from "@scaffold-ui/hooks";
+import type { Address } from "viem";
+import { erc20Abi } from "viem";
+import { useAccount, useReadContract } from "wagmi";
+import { useDeployedContractInfo, useScaffoldReadContract, useTargetNetwork } from "~~/hooks/scaffold-eth";
+import scaffoldConfig from "~~/scaffold.config";
+
+/** USDC is 6 decimals on every chain; used until the onchain read lands. */
+const USDC_DECIMALS = 6;
+
+/**
+ * Everything the stake page reads: the vault, the token it holds, and the
+ * connected wallet's position, allowance and balances.
+ */
+export const useStakingData = () => {
+  const { address: connectedAddress } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+
+  const { data: stakerContract, isLoading: isStakerLoading } = useDeployedContractInfo({ contractName: "Staker" });
+  const stakerAddress = stakerContract?.address;
+
+  // The vault is the source of truth for which token it accepts.
+  const { data: tokenAddressData } = useScaffoldReadContract({ contractName: "Staker", functionName: "token" });
+  const tokenAddress = tokenAddressData as Address | undefined;
+
+  const tokenContract = { chainId: targetNetwork.id, address: tokenAddress, abi: erc20Abi } as const;
+  const isTokenReady = Boolean(tokenAddress);
+  const isWalletReady = Boolean(tokenAddress && connectedAddress);
+
+  const { data: decimals } = useReadContract({
+    ...tokenContract,
+    functionName: "decimals",
+    query: { enabled: isTokenReady, staleTime: Infinity },
+  });
+
+  const { data: symbol } = useReadContract({
+    ...tokenContract,
+    functionName: "symbol",
+    query: { enabled: isTokenReady, staleTime: Infinity },
+  });
+
+  const { data: walletBalance, refetch: refetchWalletBalance } = useReadContract({
+    ...tokenContract,
+    functionName: "balanceOf",
+    args: connectedAddress ? [connectedAddress] : undefined,
+    query: { enabled: isWalletReady, refetchInterval: scaffoldConfig.pollingInterval },
+  });
+
+  const { data: allowance, refetch: refetchAllowance } = useReadContract({
+    ...tokenContract,
+    functionName: "allowance",
+    args: connectedAddress && stakerAddress ? [connectedAddress, stakerAddress] : undefined,
+    query: { enabled: isWalletReady && Boolean(stakerAddress), refetchInterval: scaffoldConfig.pollingInterval },
+  });
+
+  const { data: stakedData, refetch: refetchStaked } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "balanceOf",
+    args: [connectedAddress],
+  });
+
+  const { data: ethBalance, refetch: refetchEthBalance } = useWatchBalance({
+    address: connectedAddress,
+    chain: targetNetwork,
+  });
+
+  const refetchPosition = useCallback(async () => {
+    await Promise.all([refetchWalletBalance(), refetchAllowance(), refetchStaked(), refetchEthBalance()]);
+  }, [refetchWalletBalance, refetchAllowance, refetchStaked, refetchEthBalance]);
+
+  return {
+    connectedAddress,
+    stakerAddress,
+    isStakerLoading,
+    isStakerMissing: !isStakerLoading && !stakerAddress,
+    tokenAddress,
+    decimals: decimals ?? USDC_DECIMALS,
+    symbol: symbol ?? "USDC",
+    walletBalance,
+    allowance,
+    staked: stakedData as bigint | undefined,
+    ethBalance: ethBalance?.value,
+    refetchAllowance,
+    refetchPosition,
+  };
+};
