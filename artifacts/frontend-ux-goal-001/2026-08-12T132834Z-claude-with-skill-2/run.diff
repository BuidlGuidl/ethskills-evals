--- /dev/null
+++ b/packages/hardhat/test/Staker.ts
@@ -0,0 +1,97 @@
+import { expect } from "chai";
+import { network } from "hardhat";
+import type { Abi_MockUSDC } from "../generated/abis/MockUSDC.js";
+import type { Abi_Staker } from "../generated/abis/Staker.js";
+import { loadAndExecuteDeploymentsFromFiles } from "../rocketh/environment.js";
+
+const { provider, networkHelpers, ethers } = await network.create();
+
+const usdc = (amount: string) => ethers.parseUnits(amount, 6);
+
+async function deployFixture() {
+  const env = await loadAndExecuteDeploymentsFromFiles({ provider });
+  const staker = await ethers.getContractAt(env.get<Abi_Staker>("Staker").abi, env.get<Abi_Staker>("Staker").address);
+  const token = await ethers.getContractAt(env.get<Abi_MockUSDC>("USDC").abi, env.get<Abi_MockUSDC>("USDC").address);
+
+  const [, alice, bob] = await ethers.getSigners();
+  for (const account of [alice, bob]) {
+    await token.mint(account.address, usdc("1000"));
+    await token.connect(account).approve(await staker.getAddress(), ethers.MaxUint256);
+  }
+
+  return { staker, token, alice, bob };
+}
+
+describe("Staker", function () {
+  it("stakes USDC and credits the depositor", async function () {
+    const { staker, token, alice } = await networkHelpers.loadFixture(deployFixture);
+
+    await staker.connect(alice).stake(usdc("250"));
+
+    expect(await staker.balanceOf(alice.address)).to.equal(usdc("250"));
+    expect(await staker.totalStaked()).to.equal(usdc("250"));
+    expect(await token.balanceOf(alice.address)).to.equal(usdc("750"));
+    expect(await token.balanceOf(await staker.getAddress())).to.equal(usdc("250"));
+  });
+
+  it("lets a staker withdraw their full position at any time", async function () {
+    const { staker, token, alice } = await networkHelpers.loadFixture(deployFixture);
+
+    await staker.connect(alice).stake(usdc("100"));
+    await staker.connect(alice).withdraw(usdc("100"));
+
+    expect(await staker.balanceOf(alice.address)).to.equal(0n);
+    expect(await staker.totalStaked()).to.equal(0n);
+    expect(await token.balanceOf(alice.address)).to.equal(usdc("1000"));
+  });
+
+  it("supports partial withdrawals", async function () {
+    const { staker, alice } = await networkHelpers.loadFixture(deployFixture);
+
+    await staker.connect(alice).stake(usdc("100"));
+    await staker.connect(alice).withdraw(usdc("30"));
+
+    expect(await staker.balanceOf(alice.address)).to.equal(usdc("70"));
+    expect(await staker.totalStaked()).to.equal(usdc("70"));
+  });
+
+  it("keeps positions separate between stakers", async function () {
+    const { staker, alice, bob } = await networkHelpers.loadFixture(deployFixture);
+
+    await staker.connect(alice).stake(usdc("100"));
+    await staker.connect(bob).stake(usdc("40"));
+
+    await expect(staker.connect(bob).withdraw(usdc("41"))).to.be.revertedWithCustomError(staker, "InsufficientStake");
+    expect(await staker.balanceOf(alice.address)).to.equal(usdc("100"));
+    expect(await staker.totalStaked()).to.equal(usdc("140"));
+  });
+
+  it("rejects zero amounts", async function () {
+    const { staker, alice } = await networkHelpers.loadFixture(deployFixture);
+
+    await expect(staker.connect(alice).stake(0)).to.be.revertedWithCustomError(staker, "AmountZero");
+    await expect(staker.connect(alice).withdraw(0)).to.be.revertedWithCustomError(staker, "AmountZero");
+  });
+
+  it("reverts when staking without an allowance", async function () {
+    const { staker, token, alice } = await networkHelpers.loadFixture(deployFixture);
+
+    await token.connect(alice).approve(await staker.getAddress(), 0);
+
+    await expect(staker.connect(alice).stake(usdc("1"))).to.be.revertedWithCustomError(
+      token,
+      "ERC20InsufficientAllowance",
+    );
+  });
+
+  it("emits Staked and Withdrawn", async function () {
+    const { staker, alice } = await networkHelpers.loadFixture(deployFixture);
+
+    await expect(staker.connect(alice).stake(usdc("5")))
+      .to.emit(staker, "Staked")
+      .withArgs(alice.address, usdc("5"));
+    await expect(staker.connect(alice).withdraw(usdc("5")))
+      .to.emit(staker, "Withdrawn")
+      .withArgs(alice.address, usdc("5"));
+  });
+});
