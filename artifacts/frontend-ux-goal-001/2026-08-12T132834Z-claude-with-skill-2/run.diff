@@ -0,0 +1,103 @@
+"use client";
+
+import { BalanceCard } from "./BalanceCard";
+import { MintTestUsdcButton } from "./MintTestUsdcButton";
+import { StakeWithdrawCard } from "./StakeWithdrawCard";
+import { VaultDetails } from "./VaultDetails";
+import { parseEther } from "viem";
+import { hardhat } from "viem/chains";
+import { useAccount } from "wagmi";
+import { ExclamationTriangleIcon } from "@heroicons/react/24/outline";
+import { useTargetNetwork } from "~~/hooks/scaffold-eth";
+import { useEthPrice, useUsdcPrice } from "~~/hooks/usePrices";
+import { useStakingData } from "~~/hooks/useStakingData";
+
+/** Below this, a Base transaction is at risk of failing for lack of gas. */
+const LOW_ETH_BALANCE = parseEther("0.0002");
+
+export const StakeDashboard = () => {
+  const staking = useStakingData();
+  const usdcPrice = useUsdcPrice();
+  const ethPrice = useEthPrice();
+  const { targetNetwork } = useTargetNetwork();
+  const { isConnected } = useAccount();
+
+  const { symbol, decimals, ethBalance, tokenAddress, stakerAddress, isStakerMissing, refetchPosition } = staking;
+  const isLocalNetwork = targetNetwork.id === hardhat.id;
+  const hasLowEth = isConnected && ethBalance !== undefined && ethBalance < LOW_ETH_BALANCE;
+
+  return (
+    <div className="flex flex-col items-center grow w-full px-4 py-10">
+      <div className="w-full max-w-3xl flex flex-col gap-6">
+        <div className="flex flex-col gap-2">
+          <h1 className="text-3xl font-bold m-0">Stake {symbol}</h1>
+          <p className="m-0 opacity-70">
+            Deposit {symbol} on {targetNetwork.name} and withdraw your position at any time. No lockups, no rewards.
+          </p>
+        </div>
+
+        {isStakerMissing && (
+          <div role="alert" className="alert alert-warning">
+            <ExclamationTriangleIcon className="h-5 w-5" />
+            <span>
+              The vault is not deployed on {targetNetwork.name} yet, so staking is unavailable. Run{" "}
+              <code>yarn deploy --network {targetNetwork.name.toLowerCase()}</code> to publish it.
+            </span>
+          </div>
+        )}
+
+        <div className="grid gap-4 sm:grid-cols-3">
+          <BalanceCard
+            label="Your staked position"
+            value={isConnected ? staking.staked : undefined}
+            decimals={decimals}
+            symbol={symbol}
+            price={usdcPrice}
+            placeholder={isConnected ? "…" : "Not connected"}
+          />
+          <BalanceCard
+            label={`Wallet ${symbol}`}
+            value={isConnected ? staking.walletBalance : undefined}
+            decimals={decimals}
+            symbol={symbol}
+            price={usdcPrice}
+            placeholder={isConnected ? "…" : "Not connected"}
+            footer={
+              isLocalNetwork && isConnected ? (
+                <MintTestUsdcButton tokenAddress={tokenAddress} decimals={decimals} onMinted={refetchPosition} />
+              ) : undefined
+            }
+          />
+          <BalanceCard
+            label={`${targetNetwork.nativeCurrency.symbol} for gas`}
+            value={isConnected ? ethBalance : undefined}
+            decimals={targetNetwork.nativeCurrency.decimals}
+            symbol={targetNetwork.nativeCurrency.symbol}
+            price={ethPrice}
+            placeholder={isConnected ? "…" : "Not connected"}
+            footer={
+              hasLowEth ? (
+                <span className="text-sm text-warning flex items-center gap-1 mt-1">
+                  <ExclamationTriangleIcon className="h-4 w-4 shrink-0" />
+                  {ethBalance === 0n
+                    ? `No ${targetNetwork.nativeCurrency.symbol} to pay for gas`
+                    : `Low ${targetNetwork.nativeCurrency.symbol} — transactions may fail`}
+                </span>
+              ) : undefined
+            }
+          />
+        </div>
+
+        <StakeWithdrawCard staking={staking} usdcPrice={usdcPrice} />
+
+        <VaultDetails
+          stakerAddress={stakerAddress}
+          tokenAddress={tokenAddress}
+          decimals={decimals}
+          symbol={symbol}
+          usdcPrice={usdcPrice}
+        />
+      </div>
+    </div>
+  );
+};
diff --git a/packages/nextjs/app/stake/_components/StakeWithdrawCard.tsx b/packages/nextjs/app/stake/_components/StakeWithdrawCard.tsx
new file mode 100644
index 0000000..3f6e3f7
--- /dev/null
+++ b/packages/nextjs/app/stake/_components/StakeWithdrawCard.tsx
@@ -0,0 +1,241 @@
+"use client";
+
+import { useState } from "react";
+import { AmountInput } from "./AmountInput";
+import { FiatValue } from "./FiatValue";
+import { useConnectModal } from "@rainbow-me/rainbowkit";
+import { erc20Abi, formatUnits } from "viem";
+import { useAccount, useSwitchChain, useWriteContract } from "wagmi";
+import { useScaffoldWriteContract, useTargetNetwork, useTransactor } from "~~/hooks/scaffold-eth";
+import type { PriceInfo } from "~~/hooks/usePrices";
+import { useStakingData } from "~~/hooks/useStakingData";
+import { formatTokenAmount, parseTokenAmount, toNumber } from "~~/utils/amounts";
+
+type Mode = "stake" | "withdraw";
+type PendingAction = "approve" | "stake" | "withdraw";
+
+type StakeWithdrawCardProps = {
+  staking: ReturnType<typeof useStakingData>;
+  usdcPrice: PriceInfo;
+};
+
+export const StakeWithdrawCard = ({ staking, usdcPrice }: StakeWithdrawCardProps) => {
+  const {
+    stakerAddress,
+    isStakerLoading,
+    isStakerMissing,
+    tokenAddress,
+    decimals,
+    symbol,
+    walletBalance,
+    allowance,
+    staked,
+    refetchAllowance,
+    refetchPosition,
+  } = staking;
+
+  const [mode, setMode] = useState<Mode>("stake");
+  const [amountInput, setAmountInput] = useState("");
+  const [pendingAction, setPendingAction] = useState<PendingAction | null>(null);
+
+  const { isConnected, chain } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+  const { openConnectModal } = useConnectModal();
+  const { switchChain, isPending: isSwitchingChain } = useSwitchChain();
+  const { writeContractAsync: writeToken } = useWriteContract();
+  const { writeContractAsync: writeStaker } = useScaffoldWriteContract({ contractName: "Staker" });
+  const writeTx = useTransactor();
+
+  const isStakeMode = mode === "stake";
+  const available = isStakeMode ? walletBalance : staked;
+  const { amount, error: parseError } = parseTokenAmount(amountInput, decimals, symbol);
+  const exceedsAvailable = amount !== undefined && available !== undefined && amount > available;
+  // Allowance is read from the chain on every block — never inferred from a
+  // successful approval earlier in this session.
+  const needsApproval = isStakeMode && amount !== undefined && allowance !== undefined && allowance < amount;
+
+  const isWrongNetwork = isConnected && chain?.id !== targetNetwork.id;
+  const isBusy = pendingAction !== null;
+
+  const validationMessage =
+    parseError ??
+    (exceedsAvailable
+      ? isStakeMode
+        ? `You only have ${formatTokenAmount(walletBalance ?? 0n, decimals)} ${symbol} in your wallet`
+        : `You only have ${formatTokenAmount(staked ?? 0n, decimals)} ${symbol} staked`
+      : undefined);
+
+  const switchMode = (nextMode: Mode) => {
+    setMode(nextMode);
+    setAmountInput("");
+  };
+
+  const setMaxAmount = () => {
+    if (available === undefined) return;
+    setAmountInput(formatUnits(available, decimals));
+  };
+
+  const handleApprove = async () => {
+    if (!amount || !tokenAddress || !stakerAddress) return;
+    setPendingAction("approve");
+    try {
+      await writeTx(() =>
+        writeToken({
+          chainId: targetNetwork.id,
+          address: tokenAddress,
+          abi: erc20Abi,
+          functionName: "approve",
+          args: [stakerAddress, amount],
+        }),
+      );
+      // Hold the pending state until the new allowance is on the chain.
+      await refetchAllowance();
+    } catch {
+      // The transactor already showed the wallet/revert reason.
+    } finally {
+      setPendingAction(null);
+    }
+  };
+
+  const handleStakeOrWithdraw = async () => {
+    if (!amount) return;
+    setPendingAction(isStakeMode ? "stake" : "withdraw");
+    try {
+      await writeStaker({ functionName: isStakeMode ? "stake" : "withdraw", args: [amount] });
+      await refetchPosition();
+      setAmountInput("");
+    } catch {
+      // The transactor already showed the wallet/revert reason.
+    } finally {
+      setPendingAction(null);
+    }
+  };
+
+  const actionButton = () => {
+    if (!isConnected) {
+      return (
+        <button className="btn btn-primary w-full" onClick={openConnectModal} type="button">
+          Connect wallet
+        </button>
+      );
+    }
+
+    if (isWrongNetwork) {
+      return (
+        <button
+          className="btn btn-primary w-full"
+          onClick={() => switchChain({ chainId: targetNetwork.id })}
+          disabled={isSwitchingChain}
+          type="button"
+        >
+          {isSwitchingChain && <span className="loading loading-spinner loading-xs" />}
+          Switch to {targetNetwork.name}
+        </button>
+      );
+    }
+
+    if (isStakerMissing) {
+      return (
+        <button className="btn btn-primary w-full" disabled type="button">
+          Vault unavailable on {targetNetwork.name}
+        </button>
+      );
+    }
+
+    if (needsApproval) {
+      return (
+        <button
+          className="btn btn-primary w-full"
+          onClick={handleApprove}
+          disabled={isBusy || Boolean(validationMessage)}
+          type="button"
+        >
+          {pendingAction === "approve" && <span className="loading loading-spinner loading-xs" />}
+          {pendingAction === "approve" ? "Approving…" : `Approve ${symbol}`}
+        </button>
+      );
+    }
+
+    const isPendingWrite = pendingAction === "stake" || pendingAction === "withdraw";
+    const label = isStakeMode ? "Stake" : "Withdraw";
+    const pendingLabel = isStakeMode ? "Staking…" : "Withdrawing…";
+    // In stake mode we cannot tell whether an approval is needed until the
+    // allowance read lands.
+    const isAllowanceUnknown = isStakeMode && allowance === undefined;
+
+    return (
+      <button
+        className="btn btn-primary w-full"
+        onClick={handleStakeOrWithdraw}
+        disabled={isBusy || isStakerLoading || isAllowanceUnknown || amount === undefined || Boolean(validationMessage)}
+        type="button"
+      >
+        {isPendingWrite && <span className="loading loading-spinner loading-xs" />}
+        {isPendingWrite ? pendingLabel : amount === undefined ? "Enter an amount" : `${label} ${symbol}`}
+      </button>
+    );
+  };
+
+  return (
+    <div className="card bg-base-100 border border-base-300">
+      <div className="card-body gap-4 p-5 sm:p-6">
+        <div role="tablist" className="tabs tabs-box self-start">
+          <button
+            role="tab"
+            type="button"
+            aria-selected={isStakeMode}
+            className={`tab ${isStakeMode ? "tab-active" : ""}`}
+            onClick={() => switchMode("stake")}
+            disabled={isBusy}
+          >
+            Stake
+          </button>
+          <button
+            role="tab"
+            type="button"
+            aria-selected={!isStakeMode}
+            className={`tab ${!isStakeMode ? "tab-active" : ""}`}
+            onClick={() => switchMode("withdraw")}
+            disabled={isBusy}
+          >
+            Withdraw
+          </button>
+        </div>
+
+        <div className="flex flex-col gap-2">
+          <div className="flex items-center justify-between text-sm">
+            <span className="font-medium">{isStakeMode ? "Amount to stake" : "Amount to withdraw"}</span>
+            <span className="opacity-70">
+              {isStakeMode ? "Wallet" : "Staked"}:{" "}
+              {available === undefined ? "—" : `${formatTokenAmount(available, decimals)} ${symbol}`}
+            </span>
+          </div>
+
+          <AmountInput
+            value={amountInput}
+            onChange={setAmountInput}
+            symbol={symbol}
+            disabled={isBusy}
+            hasError={Boolean(validationMessage)}
+            onMax={setMaxAmount}
+            isMaxDisabled={available === undefined || available === 0n}
+          />
+
+          {validationMessage ? (
+            <p className="text-sm text-error m-0">{validationMessage}</p>
+          ) : (
+            amount !== undefined && <FiatValue amount={toNumber(amount, decimals)} price={usdcPrice} />
+          )}
+        </div>
+
+        {needsApproval && !validationMessage && (
+          <p className="text-sm opacity-70 m-0">
+            Staking takes two transactions the first time: approve the vault to move your {symbol}, then stake.
+          </p>
+        )}
+
+        {actionButton()}
+      </div>
+    </div>
+  );
+};
diff --git a/packages/nextjs/app/stake/_components/VaultDetails.tsx b/packages/nextjs/app/stake/_components/VaultDetails.tsx
new file mode 100644
index 0000000..01b5579
--- /dev/null
+++ b/packages/nextjs/app/stake/_components/VaultDetails.tsx
@@ -0,0 +1,46 @@
+"use client";
+
+import { FiatValue } from "./FiatValue";
+import { Address } from "@scaffold-ui/components";
+import type { Address as AddressType } from "viem";
+import { useScaffoldReadContract, useTargetNetwork } from "~~/hooks/scaffold-eth";
+import type { PriceInfo } from "~~/hooks/usePrices";
+import { formatTokenAmount, toNumber } from "~~/utils/amounts";
+
+type VaultDetailsProps = {
+  stakerAddress?: AddressType;
+  tokenAddress?: AddressType;
+  decimals: number;
+  symbol: string;
+  usdcPrice: PriceInfo;
+};
+
+export const VaultDetails = ({ stakerAddress, tokenAddress, decimals, symbol, usdcPrice }: VaultDetailsProps) => {
+  const { targetNetwork } = useTargetNetwork();
+  const { data: totalStakedData } = useScaffoldReadContract({ contractName: "Staker", functionName: "totalStaked" });
+  const totalStaked = totalStakedData as bigint | undefined;
+
+  return (
+    <div className="card bg-base-200 border border-base-300">
+      <div className="card-body gap-3 p-5 text-sm">
+        <div className="flex flex-wrap items-center justify-between gap-2">
+          <span className="opacity-70">Total staked in vault</span>
+          <span className="font-medium flex items-center gap-2">
+            {totalStaked === undefined ? "—" : `${formatTokenAmount(totalStaked, decimals)} ${symbol}`}
+            {totalStaked !== undefined && (
+              <FiatValue amount={toNumber(totalStaked, decimals)} price={usdcPrice} className="font-normal" />
+            )}
+          </span>
+        </div>
+        <div className="flex flex-wrap items-center justify-between gap-2">
+          <span className="opacity-70">Vault contract</span>
+          {stakerAddress ? <Address address={stakerAddress} chain={targetNetwork} size="sm" /> : <span>—</span>}
+        </div>
+        <div className="flex flex-wrap items-center justify-between gap-2">
+          <span className="opacity-70">{symbol} token</span>
+          {tokenAddress ? <Address address={tokenAddress} chain={targetNetwork} size="sm" /> : <span>—</span>}
+        </div>
+      </div>
+    </div>
+  );
+};
