@@ -0,0 +1,39 @@
+import { ExclamationTriangleIcon } from "@heroicons/react/24/outline";
+import type { PriceInfo } from "~~/hooks/usePrices";
+import { formatUsd } from "~~/utils/amounts";
+
+type FiatValueProps = {
+  /** Token amount, already converted out of base units. */
+  amount?: number;
+  price: PriceInfo;
+  className?: string;
+};
+
+/**
+ * Shows what an amount is worth in USD, and says so plainly when the price
+ * source is loading, stale or missing rather than dropping the value.
+ */
+export const FiatValue = ({ amount, price, className = "" }: FiatValueProps) => {
+  const baseClass = `text-sm opacity-70 ${className}`;
+
+  if (amount === undefined) return null;
+
+  if (price.isUnavailable) {
+    return <span className={baseClass}>USD value unavailable</span>;
+  }
+
+  if (price.price === undefined) {
+    return <span className={baseClass}>Loading USD value…</span>;
+  }
+
+  return (
+    <span className={`${baseClass} flex items-center gap-1`}>
+      ≈ {formatUsd(amount * price.price)}
+      {price.isStale && (
+        <span className="tooltip tooltip-right" data-tip="Price feed has not updated recently — value may be stale">
+          <ExclamationTriangleIcon className="h-4 w-4 text-warning" />
+        </span>
+      )}
+    </span>
+  );
+};
