+"use client";
+
+import { useMemo, useState } from "react";
+import { useConnectModal } from "@rainbow-me/rainbowkit";
+import { Address as AddressDisplay } from "@scaffold-ui/components";
+import { useFetchNativeCurrencyPrice } from "@scaffold-ui/hooks";
+import { useQuery } from "@tanstack/react-query";
+import type { NextPage } from "next";
+import { Address as AddressType, formatEther, formatUnits, parseUnits, zeroAddress } from "viem";
+import { useAccount, useBalance, useSwitchChain } from "wagmi";
+import {
+  ArrowDownTrayIcon,
+  ArrowPathIcon,
+  ArrowUpTrayIcon,
+  BanknotesIcon,
+  CheckCircleIcon,
+  ExclamationTriangleIcon,
+  WalletIcon,
+} from "@heroicons/react/24/outline";
+import {
+  useDeployedContractInfo,
+  useScaffoldReadContract,
+  useScaffoldWriteContract,
+  useTargetNetwork,
+} from "~~/hooks/scaffold-eth";
+import { AllowedChainIds, getParsedError, notification } from "~~/utils/scaffold-eth";
+
+const USDC_DECIMALS = 6;
+const MAX_UINT256 = (1n << 256n) - 1n;
+
+const amountFormatter = new Intl.NumberFormat("en-US", {
+  minimumFractionDigits: 2,
+  maximumFractionDigits: 6,
+});
+
+const usdFormatter = new Intl.NumberFormat("en-US", {
+  style: "currency",
+  currency: "USD",
+  minimumFractionDigits: 2,
+  maximumFractionDigits: 2,
+});
+
+const compactUsdFormatter = new Intl.NumberFormat("en-US", {
+  style: "currency",
+  currency: "USD",
+  notation: "compact",
+  maximumFractionDigits: 2,
+});
+
+const formatTokenAmount = (value: bigint | undefined, decimals = USDC_DECIMALS) => {
+  if (value === undefined) return "—";
+  return amountFormatter.format(Number(formatUnits(value, decimals)));
+};
+
+const formatUsd = (amount: bigint | undefined, price: number | undefined) => {
+  if (amount === undefined || !price) return "Price unavailable";
+  return compactUsdFormatter.format(Number(formatUnits(amount, USDC_DECIMALS)) * price);
+};
+
+const parseUsdcAmount = (amount: string) => {
+  const trimmedAmount = amount.trim();
+  if (!trimmedAmount) return undefined;
+  if (!/^\d+(\.\d{0,6})?$/.test(trimmedAmount)) return undefined;
+  return parseUnits(trimmedAmount, USDC_DECIMALS);
+};
+
+const useUsdcUsdPrice = () =>
+  useQuery({
+    queryKey: ["usdc-usd-price"],
+    queryFn: async () => {
+      const response = await fetch("https://api.coingecko.com/api/v3/simple/price?ids=usd-coin&vs_currencies=usd");
+      if (!response.ok) throw new Error("USDC price is unavailable");
+      const payload = (await response.json()) as { "usd-coin"?: { usd?: number } };
+      const price = payload["usd-coin"]?.usd;
+      if (!price) throw new Error("USDC price is unavailable");
+      return price;
+    },
+    refetchInterval: 5 * 60 * 1000,
+    retry: 1,
+    staleTime: 5 * 60 * 1000,
+  });
+
+const StakePage: NextPage = () => {
+  const { address, chain, isConnected } = useAccount();
+  const { openConnectModal } = useConnectModal();
+  const { switchChainAsync, isPending: isSwitchPending } = useSwitchChain();
+  const { targetNetwork } = useTargetNetwork();
+  const selectedChainId = targetNetwork.id as AllowedChainIds;
+  const { price: nativeCurrencyPrice } = useFetchNativeCurrencyPrice();
+  const { data: usdcUsdPrice, isError: isUsdcPriceError } = useUsdcUsdPrice();
+  const [amount, setAmount] = useState("");
+  const [actionError, setActionError] = useState<string>();
+  const [activeAction, setActiveAction] = useState<"approve" | "stake" | "withdraw" | "switch">();
+
+  const { data: stakerContract } = useDeployedContractInfo({ contractName: "Staker", chainId: selectedChainId });
+  const stakerAddress = stakerContract?.address;
+  const isStakerConfigured = Boolean(stakerAddress && stakerAddress !== zeroAddress);
+  const isWrongNetwork = isConnected && chain?.id !== targetNetwork.id;
+  const parsedAmount = useMemo(() => parseUsdcAmount(amount), [amount]);
+
+  const { data: usdcBalance, refetch: refetchUsdcBalance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "balanceOf",
+    args: [address],
+    chainId: selectedChainId,
+  });
+
+  const { data: allowance, refetch: refetchAllowance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "allowance",
+    args: [address, stakerAddress],
+    chainId: selectedChainId,
+    query: {
+      enabled: Boolean(address && isStakerConfigured),
+    },
+  });
+
+  const { data: stakedPosition, refetch: refetchStakedPosition } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "positions",
+    args: [address],
+    chainId: selectedChainId,
+    query: {
+      enabled: Boolean(address && isStakerConfigured),
+    },
+  });
+
+  const { data: ethBalance, refetch: refetchEthBalance } = useBalance({
+    address,
+    chainId: targetNetwork.id,
+    query: {
+      enabled: Boolean(address),
+    },
+  });
+
+  const usdcWrite = useScaffoldWriteContract({ contractName: "USDC", chainId: selectedChainId });
+  const stakerWrite = useScaffoldWriteContract({ contractName: "Staker", chainId: selectedChainId });
+
+  const amountError = useMemo(() => {
+    if (!amount.trim()) return undefined;
+    if (parsedAmount === undefined) return "Enter a USDC amount with up to 6 decimals.";
+    if (parsedAmount === 0n) return "Enter more than 0 USDC.";
+    if (usdcBalance !== undefined && parsedAmount > usdcBalance) return "Amount exceeds your wallet USDC balance.";
+    return undefined;
+  }, [amount, parsedAmount, usdcBalance]);
+
+  const needsApproval = Boolean(parsedAmount && allowance !== undefined && allowance < parsedAmount);
+  const canSubmitStake = Boolean(parsedAmount && !amountError && isConnected && !isWrongNetwork && isStakerConfigured);
+  const hasPosition = Boolean(stakedPosition && stakedPosition > 0n);
+  const isBusy = Boolean(activeAction) || usdcWrite.isMining || stakerWrite.isMining || isSwitchPending;
+
+  const refetchBalances = async () => {
+    await Promise.allSettled([refetchUsdcBalance(), refetchAllowance(), refetchStakedPosition(), refetchEthBalance()]);
+  };
+
+  const handleError = (error: unknown) => {
+    const message = getParsedError(error);
+    setActionError(message);
+    notification.error(message);
+  };
+
+  const handleSwitchNetwork = async () => {
+    setActionError(undefined);
+    setActiveAction("switch");
+    try {
+      await switchChainAsync({ chainId: targetNetwork.id });
+    } catch (error) {
+      handleError(error);
+    } finally {
+      setActiveAction(undefined);
+    }
+  };
+
+  const handleApprove = async () => {
+    if (!parsedAmount || !stakerAddress) return;
+    setActionError(undefined);
+    setActiveAction("approve");
+    try {
+      await usdcWrite.writeContractAsync({
+        functionName: "approve",
+        args: [stakerAddress, parsedAmount],
+      });
+      await refetchBalances();
+      notification.success("USDC approved");
+    } catch (error) {
+      handleError(error);
+    } finally {
+      setActiveAction(undefined);
+    }
+  };
+
+  const handleStake = async () => {
+    if (!parsedAmount) return;
+    setActionError(undefined);
+    setActiveAction("stake");
+    try {
+      const latestAllowance = await refetchAllowance();
+      const availableAllowance = latestAllowance.data ?? allowance ?? 0n;
+      if (availableAllowance < parsedAmount) {
+        setActionError("Approve USDC before staking this amount.");
+        return;
+      }
+
+      await stakerWrite.writeContractAsync({
+        functionName: "stake",
+        args: [parsedAmount],
+      });
+      setAmount("");
+      await refetchBalances();
+      notification.success("USDC staked");
+    } catch (error) {
+      handleError(error);
+    } finally {
+      setActiveAction(undefined);
+    }
+  };
+
+  const handleWithdraw = async () => {
+    if (!hasPosition) return;
+    setActionError(undefined);
+    setActiveAction("withdraw");
+    try {
+      await stakerWrite.writeContractAsync({
+        functionName: "withdraw",
+      });
+      await refetchBalances();
+      notification.success("USDC withdrawn");
+    } catch (error) {
+      handleError(error);
+    } finally {
+      setActiveAction(undefined);
+    }
+  };
+
+  const handleMax = () => {
+    if (usdcBalance === undefined) return;
+    setAmount(formatUnits(usdcBalance, USDC_DECIMALS));
+    setActionError(undefined);
+  };
+
+  const primaryAction = () => {
+    if (!isConnected) {
+      return (
+        <button className="btn btn-primary w-full gap-2" onClick={openConnectModal} type="button">
+          <WalletIcon className="h-5 w-5" />
+          Connect wallet
+        </button>
+      );
+    }
+
+    if (isWrongNetwork) {
+      return (
+        <button className="btn btn-primary w-full gap-2" disabled={isBusy} onClick={handleSwitchNetwork} type="button">
+          {activeAction === "switch" ? (
+            <span className="loading loading-spinner loading-sm" />
+          ) : (
+            <ArrowPathIcon className="h-5 w-5" />
+          )}
+          Switch to {targetNetwork.name}
+        </button>
+      );
+    }
+
+    if (!isStakerConfigured) {
+      return (
+        <button className="btn btn-disabled w-full gap-2" type="button">
+          <ExclamationTriangleIcon className="h-5 w-5" />
+          Staker not configured
+        </button>
+      );
+    }
+
+    if (needsApproval) {
+      return (
+        <button
+          className="btn btn-primary w-full gap-2"
+          disabled={!canSubmitStake || isBusy}
+          onClick={handleApprove}
+          type="button"
+        >
+          {activeAction === "approve" ? (
+            <span className="loading loading-spinner loading-sm" />
+          ) : (
+            <CheckCircleIcon className="h-5 w-5" />
+          )}
+          Approve USDC
+        </button>
+      );
+    }
+
+    return (
+      <button
+        className="btn btn-primary w-full gap-2"
+        disabled={!canSubmitStake || isBusy}
+        onClick={handleStake}
+        type="button"
+      >
+        {activeAction === "stake" ? (
+          <span className="loading loading-spinner loading-sm" />
+        ) : (
+          <ArrowDownTrayIcon className="h-5 w-5" />
+        )}
+        Stake USDC
+      </button>
+    );
+  };
+
+  return (
+    <div className="grow bg-base-200 px-4 py-6 md:px-8">
+      <div className="mx-auto flex w-full max-w-6xl flex-col gap-6">
+        <section className="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
+          <div>
+            <div className="mb-3 inline-flex items-center gap-2 rounded-none border border-base-300 bg-base-100 px-3 py-2 text-sm">
+              <BanknotesIcon className="h-4 w-4" />
+              <span>{targetNetwork.name}</span>
+            </div>
+            <h1 className="text-3xl font-bold md:text-4xl">USDC Staker</h1>
+            <p className="max-w-2xl text-base-content/70">
+              Stake Base USDC, keep custody of a withdrawable position, and pull the full balance out whenever you need
+              it.
+            </p>
+          </div>
+          {address && (
+            <div className="flex items-center gap-2 rounded-none border border-base-300 bg-base-100 px-4 py-3">
+              <WalletIcon className="h-5 w-5" />
+              <AddressDisplay address={address as AddressType} chain={targetNetwork} />
+            </div>
+          )}
+        </section>
+
+        <section className="grid gap-4 md:grid-cols-3">
+          <div className="card border border-base-300 bg-base-100 shadow-sm">
+            <div className="card-body gap-2">
+              <span className="text-sm text-base-content/60">Wallet USDC</span>
+              <span className="text-2xl font-semibold">{formatTokenAmount(usdcBalance)}</span>
+              <span className="text-sm text-base-content/60">{formatUsd(usdcBalance, usdcUsdPrice)}</span>
+            </div>
+          </div>
+          <div className="card border border-base-300 bg-base-100 shadow-sm">
+            <div className="card-body gap-2">
+              <span className="text-sm text-base-content/60">Gas Balance</span>
+              <span className="text-2xl font-semibold">
+                {ethBalance ? Number(formatEther(ethBalance.value)).toFixed(5) : "—"}{" "}
+                {targetNetwork.nativeCurrency.symbol}
+              </span>
+              <span className="text-sm text-base-content/60">
+                {ethBalance && nativeCurrencyPrice > 0
+                  ? usdFormatter.format(Number(formatEther(ethBalance.value)) * nativeCurrencyPrice)
+                  : "ETH price unavailable"}
+              </span>
+            </div>
+          </div>
+          <div className="card border border-base-300 bg-base-100 shadow-sm">
+            <div className="card-body gap-2">
+              <span className="text-sm text-base-content/60">Staked Position</span>
+              <span className="text-2xl font-semibold">{formatTokenAmount(stakedPosition)}</span>
+              <span className="text-sm text-base-content/60">{formatUsd(stakedPosition, usdcUsdPrice)}</span>
+            </div>
+          </div>
+        </section>
+
+        <section className="grid gap-4 lg:grid-cols-[1.15fr_0.85fr]">
+          <div className="card border border-base-300 bg-base-100 shadow-sm">
+            <div className="card-body gap-5">
+              <div className="flex items-center justify-between gap-3">
+                <h2 className="card-title text-xl">Stake</h2>
+                <span className="text-sm text-base-content/60">
+                  1 USDC ={" "}
+                  {usdcUsdPrice ? usdFormatter.format(usdcUsdPrice) : isUsdcPriceError ? "unavailable" : "loading"}
+                </span>
+              </div>
+
+              <label className="form-control w-full">
+                <div className="label">
+                  <span className="label-text">Amount</span>
+                  <button
+                    className="btn btn-ghost btn-xs"
+                    disabled={usdcBalance === undefined || isBusy}
+                    onClick={handleMax}
+                    type="button"
+                  >
+                    Max
+                  </button>
+                </div>
+                <div className="join w-full">
+                  <input
+                    className="input join-item input-bordered w-full text-lg"
+                    disabled={isBusy}
+                    inputMode="decimal"
+                    min="0"
+                    onChange={event => {
+                      setAmount(event.target.value);
+                      setActionError(undefined);
+                    }}
+                    placeholder="0.00"
+                    type="text"
+                    value={amount}
+                  />
+                  <div className="join-item flex min-w-24 items-center justify-center border border-base-300 bg-base-200 px-4 font-semibold">
+                    USDC
+                  </div>
+                </div>
+                {amountError && <div className="label text-error">{amountError}</div>}
+              </label>
+
+              <div className="grid gap-3 sm:grid-cols-2">
+                <div className="rounded-none border border-base-300 bg-base-200 p-4">
+                  <div className="text-sm text-base-content/60">Allowance</div>
+                  <div className="mt-1 font-semibold">
+                    {allowance === MAX_UINT256 ? "Unlimited" : `${formatTokenAmount(allowance)} USDC`}
+                  </div>
+                </div>
+                <div className="rounded-none border border-base-300 bg-base-200 p-4">
+                  <div className="text-sm text-base-content/60">Entered Value</div>
+                  <div className="mt-1 font-semibold">{formatUsd(parsedAmount, usdcUsdPrice)}</div>
+                </div>
+              </div>
+
+              {actionError && (
+                <div className="alert alert-error rounded-none">
+                  <ExclamationTriangleIcon className="h-5 w-5" />
+                  <span>{actionError}</span>
+                </div>
+              )}
+
+              {primaryAction()}
+            </div>
+          </div>
+
+          <div className="card border border-base-300 bg-base-100 shadow-sm">
+            <div className="card-body gap-5">
+              <div>
+                <h2 className="card-title text-xl">Withdraw</h2>
+                <p className="text-base-content/70">Withdraw your full staked USDC position in one transaction.</p>
+              </div>
+
+              <div className="rounded-none border border-base-300 bg-base-200 p-4">
+                <div className="text-sm text-base-content/60">Available to Withdraw</div>
+                <div className="mt-1 text-2xl font-semibold">{formatTokenAmount(stakedPosition)} USDC</div>
+                <div className="mt-1 text-sm text-base-content/60">{formatUsd(stakedPosition, usdcUsdPrice)}</div>
+              </div>
+
+              <button
+                className="btn btn-secondary w-full gap-2"
+                disabled={!hasPosition || !isConnected || isWrongNetwork || !isStakerConfigured || isBusy}
+                onClick={handleWithdraw}
+                type="button"
+              >
+                {activeAction === "withdraw" ? (
+                  <span className="loading loading-spinner loading-sm" />
+                ) : (
+                  <ArrowUpTrayIcon className="h-5 w-5" />
+                )}
+                Withdraw Full Position
+              </button>
+
+              {!isStakerConfigured && (
+                <div className="alert alert-warning rounded-none">
+                  <ExclamationTriangleIcon className="h-5 w-5" />
+                  <span>Set NEXT_PUBLIC_STAKER_ADDRESS to the deployed Base Staker contract.</span>
+                </div>
+              )}
+            </div>
+          </div>
+        </section>
+      </div>
+    </div>
+  );
+};
+
+export default StakePage;
