@@ -0,0 +1,69 @@
+import { expect } from "chai";
+import { network } from "hardhat";
+import { parseUnits } from "ethers";
+import type { Abi_MockUSDC } from "../generated/abis/MockUSDC.js";
+import type { Abi_Staker } from "../generated/abis/Staker.js";
+import { loadAndExecuteDeploymentsFromFiles } from "../rocketh/environment.js";
+
+const { provider, networkHelpers, ethers } = await network.create();
+
+async function deployFixture() {
+  const env = await loadAndExecuteDeploymentsFromFiles({ provider });
+  const stakerDeployment = env.get<Abi_Staker>("Staker");
+  const usdcDeployment = env.get<Abi_MockUSDC>("USDC");
+  const staker = (await ethers.getContractAt(stakerDeployment.abi, stakerDeployment.address)) as any;
+  const usdc = (await ethers.getContractAt(usdcDeployment.abi, usdcDeployment.address)) as any;
+  const [deployer, stakerUser] = await ethers.getSigners();
+
+  return { deployer, stakerUser, staker, usdc };
+}
+
+describe("Staker", function () {
+  it("uses a 6 decimal local USDC mock", async function () {
+    const { usdc } = await networkHelpers.loadFixture(deployFixture);
+
+    expect(await usdc.name()).to.equal("USD Coin");
+    expect(await usdc.symbol()).to.equal("USDC");
+    expect(await usdc.decimals()).to.equal(6);
+  });
+
+  it("lets users stake approved USDC", async function () {
+    const { staker, stakerUser, usdc } = await networkHelpers.loadFixture(deployFixture);
+    const amount = parseUnits("125.50", 6);
+
+    await usdc.mint(stakerUser.address, amount);
+    await usdc.connect(stakerUser).approve(await staker.getAddress(), amount);
+
+    await expect(staker.connect(stakerUser).stake(amount))
+      .to.emit(staker, "Staked")
+      .withArgs(stakerUser.address, amount);
+
+    expect(await staker.positions(stakerUser.address)).to.equal(amount);
+    expect(await staker.totalStaked()).to.equal(amount);
+    expect(await usdc.balanceOf(await staker.getAddress())).to.equal(amount);
+  });
+
+  it("lets users withdraw their full position", async function () {
+    const { staker, stakerUser, usdc } = await networkHelpers.loadFixture(deployFixture);
+    const amount = parseUnits("42", 6);
+
+    await usdc.mint(stakerUser.address, amount);
+    await usdc.connect(stakerUser).approve(await staker.getAddress(), amount);
+    await staker.connect(stakerUser).stake(amount);
+
+    await expect(staker.connect(stakerUser).withdraw())
+      .to.emit(staker, "Withdrawn")
+      .withArgs(stakerUser.address, amount);
+
+    expect(await staker.positions(stakerUser.address)).to.equal(0n);
+    expect(await staker.totalStaked()).to.equal(0n);
+    expect(await usdc.balanceOf(stakerUser.address)).to.equal(amount);
+  });
+
+  it("rejects zero stakes and empty withdrawals", async function () {
+    const { staker, stakerUser } = await networkHelpers.loadFixture(deployFixture);
+
+    await expect(staker.connect(stakerUser).stake(0n)).to.be.revertedWithCustomError(staker, "ZeroAmount");
+    await expect(staker.connect(stakerUser).withdraw()).to.be.revertedWithCustomError(staker, "NoPosition");
+  });
+});
