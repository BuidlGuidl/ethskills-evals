@@ -0,0 +1,36 @@
+import { deployScript, artifacts } from "../rocketh/deploy.js";
+
+const BASE_CHAIN_ID = 8453;
+const BASE_USDC_ADDRESS = "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913";
+
+export default deployScript(
+  async env => {
+    const { deployer } = env.namedAccounts;
+    const chainId = env.network.chain.id;
+
+    let usdcAddress = BASE_USDC_ADDRESS;
+
+    if (chainId !== BASE_CHAIN_ID) {
+      const mockUsdc = await env.deploy("MockUSDC", {
+        account: deployer,
+        artifact: artifacts.MockUSDC,
+        args: [deployer],
+      });
+
+      usdcAddress = mockUsdc.address;
+      console.log("MockUSDC deployed for local staking:", usdcAddress);
+    }
+
+    const staker = await env.deploy("Staker", {
+      account: deployer,
+      artifact: artifacts.Staker,
+      args: [usdcAddress],
+    });
+
+    console.log("Staker deployed:", staker.address);
+    console.log("USDC token:", usdcAddress);
+  },
+  {
+    tags: ["Staker"],
+  },
+);
