@@ -0,0 +1,71 @@
+import { expect } from "chai";
+import { network } from "hardhat";
+import { parseUnits } from "ethers";
+import { loadAndExecuteDeploymentsFromFiles } from "../rocketh/environment.js";
+
+const { provider, networkHelpers, ethers } = await network.create();
+
+async function deployFixture() {
+  const env = await loadAndExecuteDeploymentsFromFiles({ provider });
+  const [deployer, stakerAccount] = await ethers.getSigners();
+
+  const { address: stakerAddress, abi: stakerAbi } = env.get("Staker");
+  const { address: mockUsdcAddress, abi: mockUsdcAbi } = env.get("MockUSDC");
+
+  const staker = (await ethers.getContractAt(stakerAbi, stakerAddress)) as any;
+  const mockUsdc = (await ethers.getContractAt(mockUsdcAbi, mockUsdcAddress)) as any;
+
+  const startingUsdc = parseUnits("1000", 6);
+  await mockUsdc.transfer(stakerAccount.address, startingUsdc);
+
+  return { deployer, mockUsdc, staker, stakerAccount, startingUsdc };
+}
+
+describe("Staker", function () {
+  it("deploys with the local mock USDC token", async function () {
+    const { mockUsdc, staker } = await networkHelpers.loadFixture(deployFixture);
+
+    expect(await mockUsdc.decimals()).to.equal(6);
+    expect(await mockUsdc.name()).to.equal("USD Coin");
+    expect(await mockUsdc.symbol()).to.equal("USDC");
+    expect(await staker.stakingToken()).to.equal(await mockUsdc.getAddress());
+  });
+
+  it("stakes approved USDC and updates the account position", async function () {
+    const { mockUsdc, staker, stakerAccount } = await networkHelpers.loadFixture(deployFixture);
+    const amount = parseUnits("125.50", 6);
+
+    await mockUsdc.connect(stakerAccount).approve(await staker.getAddress(), amount);
+
+    await expect(staker.connect(stakerAccount).stake(amount))
+      .to.emit(staker, "Staked")
+      .withArgs(stakerAccount.address, amount);
+
+    expect(await staker.positions(stakerAccount.address)).to.equal(amount);
+    expect(await staker.totalStaked()).to.equal(amount);
+    expect(await mockUsdc.balanceOf(await staker.getAddress())).to.equal(amount);
+  });
+
+  it("withdraws the full position", async function () {
+    const { mockUsdc, staker, stakerAccount, startingUsdc } = await networkHelpers.loadFixture(deployFixture);
+    const amount = parseUnits("250", 6);
+
+    await mockUsdc.connect(stakerAccount).approve(await staker.getAddress(), amount);
+    await staker.connect(stakerAccount).stake(amount);
+
+    await expect(staker.connect(stakerAccount).withdraw())
+      .to.emit(staker, "Withdrawn")
+      .withArgs(stakerAccount.address, amount);
+
+    expect(await staker.positions(stakerAccount.address)).to.equal(0n);
+    expect(await staker.totalStaked()).to.equal(0n);
+    expect(await mockUsdc.balanceOf(stakerAccount.address)).to.equal(startingUsdc);
+  });
+
+  it("rejects zero stakes and empty withdrawals", async function () {
+    const { staker, stakerAccount } = await networkHelpers.loadFixture(deployFixture);
+
+    await expect(staker.connect(stakerAccount).stake(0n)).to.be.revertedWithCustomError(staker, "ZeroAmount");
+    await expect(staker.connect(stakerAccount).withdraw()).to.be.revertedWithCustomError(staker, "NoPosition");
+  });
+});
