@@ -0,0 +1,385 @@
+"use client";
+
+import { type ReactNode, useState } from "react";
+import { Address } from "@scaffold-ui/components";
+import type { NextPage } from "next";
+import { Address as AddressType, formatEther, formatUnits, parseUnits, zeroAddress } from "viem";
+import { useAccount, useBalance, useReadContract, useWriteContract } from "wagmi";
+import {
+  ArrowDownTrayIcon,
+  ArrowPathIcon,
+  ArrowUpTrayIcon,
+  BanknotesIcon,
+  BoltIcon,
+  CheckCircleIcon,
+  CircleStackIcon,
+  WalletIcon,
+} from "@heroicons/react/24/outline";
+import {
+  useDeployedContractInfo,
+  useScaffoldReadContract,
+  useScaffoldWriteContract,
+  useTargetNetwork,
+  useTransactor,
+} from "~~/hooks/scaffold-eth";
+import { notification } from "~~/utils/scaffold-eth";
+
+const USDC_DECIMALS = 6;
+
+const erc20Abi = [
+  {
+    type: "function",
+    name: "allowance",
+    stateMutability: "view",
+    inputs: [
+      { name: "owner", type: "address" },
+      { name: "spender", type: "address" },
+    ],
+    outputs: [{ name: "", type: "uint256" }],
+  },
+  {
+    type: "function",
+    name: "approve",
+    stateMutability: "nonpayable",
+    inputs: [
+      { name: "spender", type: "address" },
+      { name: "amount", type: "uint256" },
+    ],
+    outputs: [{ name: "", type: "bool" }],
+  },
+  {
+    type: "function",
+    name: "balanceOf",
+    stateMutability: "view",
+    inputs: [{ name: "account", type: "address" }],
+    outputs: [{ name: "", type: "uint256" }],
+  },
+] as const;
+
+const formatTokenAmount = (value?: bigint, decimals = USDC_DECIMALS, precision = 2) => {
+  if (value === undefined) return "0";
+
+  const [whole, fraction = ""] = formatUnits(value, decimals).split(".");
+  const trimmedFraction = fraction.slice(0, precision).replace(/0+$/, "");
+
+  return trimmedFraction ? `${whole}.${trimmedFraction}` : whole;
+};
+
+const Stat = ({ icon, label, value, accent }: { icon: ReactNode; label: string; value: string; accent?: string }) => (
+  <div className="border border-base-300 bg-base-100 p-5">
+    <div className="flex items-center justify-between gap-3">
+      <div className="text-sm font-medium text-base-content/65">{label}</div>
+      <div className={`flex h-9 w-9 items-center justify-center border border-base-300 ${accent ?? "bg-base-200"}`}>
+        {icon}
+      </div>
+    </div>
+    <div className="mt-4 break-words text-2xl font-semibold leading-tight">{value}</div>
+  </div>
+);
+
+const Stake: NextPage = () => {
+  const [stakeAmount, setStakeAmount] = useState("");
+  const [isApproving, setIsApproving] = useState(false);
+  const { address: connectedAddress, chain: connectedChain } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+  const writeTx = useTransactor();
+
+  const { data: stakerContract } = useDeployedContractInfo({ contractName: "Staker" });
+  const stakerAddress = stakerContract?.address;
+
+  const { data: stakingTokenAddress } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "stakingToken",
+  });
+
+  const { data: stakedPosition, refetch: refetchPosition } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "positions",
+    args: [connectedAddress],
+  });
+
+  const { data: totalStaked, refetch: refetchTotalStaked } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "totalStaked",
+  });
+
+  const tokenAddress = stakingTokenAddress as AddressType | undefined;
+  const fallbackAccount = connectedAddress ?? zeroAddress;
+  const fallbackStaker = stakerAddress ?? zeroAddress;
+  const hasTokenContext = Boolean(connectedAddress && tokenAddress && stakerAddress);
+
+  const { data: ethBalance, refetch: refetchEthBalance } = useBalance({
+    address: connectedAddress,
+    chainId: targetNetwork.id,
+    query: { enabled: Boolean(connectedAddress) },
+  });
+
+  const { data: usdcBalance, refetch: refetchUsdcBalance } = useReadContract({
+    address: tokenAddress ?? zeroAddress,
+    abi: erc20Abi,
+    functionName: "balanceOf",
+    args: [fallbackAccount],
+    chainId: targetNetwork.id,
+    query: { enabled: hasTokenContext },
+  });
+
+  const { data: allowance, refetch: refetchAllowance } = useReadContract({
+    address: tokenAddress ?? zeroAddress,
+    abi: erc20Abi,
+    functionName: "allowance",
+    args: [fallbackAccount, fallbackStaker],
+    chainId: targetNetwork.id,
+    query: { enabled: hasTokenContext },
+  });
+
+  const { writeContractAsync: writeTokenContractAsync } = useWriteContract();
+  const { writeContractAsync: writeStakerContractAsync, isMining: isStakerMining } = useScaffoldWriteContract({
+    contractName: "Staker",
+  });
+
+  const parsedStakeAmount = (() => {
+    const trimmedAmount = stakeAmount.trim();
+    if (!trimmedAmount) return 0n;
+
+    try {
+      return parseUnits(trimmedAmount, USDC_DECIMALS);
+    } catch {
+      return null;
+    }
+  })();
+
+  const needsApproval = typeof parsedStakeAmount === "bigint" && parsedStakeAmount > (allowance ?? 0n);
+  const hasEnoughUsdc = typeof parsedStakeAmount === "bigint" && parsedStakeAmount <= (usdcBalance ?? 0n);
+  const canStake =
+    Boolean(connectedAddress && stakerAddress && tokenAddress) &&
+    typeof parsedStakeAmount === "bigint" &&
+    parsedStakeAmount > 0n &&
+    hasEnoughUsdc &&
+    !isApproving &&
+    !isStakerMining;
