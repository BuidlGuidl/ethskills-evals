+import { base } from "viem/chains";
+
+export const USDC_DECIMALS = 6;
+
+// Canonical (Circle-issued) USDC. The UI refuses to run against a Staker wired to any other token on these chains.
+export const CANONICAL_USDC: Record<number, string> = {
+  [base.id]: "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
+};
+
+// Chainlink feeds on Base mainnet (8 decimals). Read from Base regardless of the target chain so local dev shows real prices.
+export const CHAINLINK_FEEDS = {
+  USDC: { address: "0x7e860098F58bBFC8648a4311b374B1D669a2bc6B", heartbeatSeconds: 86_400 },
+  ETH: { address: "0x71041dddad3595F9CEd3DcCFBe3D1F4b0a16Bb70", heartbeatSeconds: 1_200 },
+} as const;
+
+// Below this ETH balance a stake + approve may not fit the gas bill.
+export const LOW_GAS_BALANCE_WEI = 20_000_000_000_000n; // 0.00002 ETH
diff --git a/packages/nextjs/utils/stake/format.ts b/packages/nextjs/utils/stake/format.ts
new file mode 100644
index 0000000..37c56a2
--- /dev/null
+++ b/packages/nextjs/utils/stake/format.ts
@@ -0,0 +1,54 @@
+import { formatUnits, parseUnits } from "viem";
+import type { UsdPrice } from "~~/hooks/stake/useUsdPrices";
+import { getParsedError } from "~~/utils/scaffold-eth";
+
+const usdFormatter = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" });
+
+/** Formats base units with thousands separators, trimming trailing zeros but keeping at least `minFractionDigits`. */
+export const formatTokenAmount = (
+  value: bigint,
+  decimals: number,
+  { maxFractionDigits = decimals, minFractionDigits = 2 } = {},
+) => {
+  const [whole, fraction = ""] = formatUnits(value, decimals).split(".");
+  const trimmed = fraction.slice(0, maxFractionDigits).replace(/0+$/, "").padEnd(minFractionDigits, "0");
+  const wholeFormatted = BigInt(whole).toLocaleString("en-US");
+  return trimmed ? `${wholeFormatted}.${trimmed}` : wholeFormatted;
+};
+
+/** Returns a USD label for a token amount, or a reason why no value can be shown. */
+export const formatUsdValue = (value: bigint | undefined, decimals: number, price: UsdPrice) => {
+  if (price.status === "loading" || value === undefined) return "…";
+  if (price.status === "unavailable") return "USD price unavailable";
+  const usd = usdFormatter.format(Number(formatUnits(value, decimals)) * price.usd);
+  return price.status === "stale" ? `≈ ${usd} (price may be outdated)` : `≈ ${usd}`;
+};
+
+export type ParsedAmount = { value: bigint; error?: undefined } | { value?: undefined; error: string };
+
+/** Parses user input into base units, explaining why input is rejected. Empty input yields neither value nor error. */
+export const parseAmountInput = (input: string, decimals: number): ParsedAmount | undefined => {
+  const trimmed = input.trim();
+  if (trimmed === "") return undefined;
+  if (!/^\d*\.?\d*$/.test(trimmed) || trimmed === ".") return { error: "Enter a number, like 25 or 10.5" };
+  const fraction = trimmed.split(".")[1] ?? "";
+  if (fraction.length > decimals) return { error: `USDC supports at most ${decimals} decimal places` };
+  const value = parseUnits(trimmed, decimals);
+  if (value === 0n) return { error: "Amount must be greater than zero" };
+  return { value };
+};
+
+/** Turns wallet and contract errors into short, human-readable messages. */
+export const getHumanError = (error: unknown) => {
+  const message = getParsedError(error);
+  if (/user (rejected|denied)/i.test(message)) return "You cancelled the request in your wallet.";
+  if (/insufficient funds/i.test(message)) return "Not enough ETH on Base to pay the network fee.";
+  if (/NothingStaked/.test(message)) return "You have nothing staked to withdraw.";
+  if (/ZeroAmount/.test(message)) return "Amount must be greater than zero.";
+  if (/ERC20InsufficientAllowance|exceeds allowance/i.test(message))
+    return "USDC approval is lower than the amount. Approve again, then stake.";
+  if (/ERC20InsufficientBalance|exceeds balance/i.test(message)) return "You don't have enough USDC for this amount.";
+  if (/blacklisted/i.test(message)) return "This address is blocked from moving USDC by the token issuer.";
+  if (/paused/i.test(message)) return "USDC transfers are paused by the issuer. Try again later.";
+  return message;
+};

# Untracked files and status
