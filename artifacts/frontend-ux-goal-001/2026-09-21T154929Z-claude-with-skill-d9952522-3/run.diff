diff --git a/packages/hardhat/test/Staker.ts b/packages/hardhat/test/Staker.ts
new file mode 100644
index 0000000..c7067e2
--- /dev/null
+++ b/packages/hardhat/test/Staker.ts
@@ -0,0 +1,70 @@
+import { expect } from "chai";
+import { network } from "hardhat";
+import { loadAndExecuteDeploymentsFromFiles } from "../rocketh/environment.js";
+
+const { provider, networkHelpers, ethers } = await network.create();
+
+const ONE_HUNDRED_USDC = 100_000_000n; // 6 decimals
+
+async function deployFixture() {
+  const env = await loadAndExecuteDeploymentsFromFiles({ provider });
+  const usdc = await ethers.getContractAt("MockUSDC", env.get("MockUSDC").address);
+  const staker = await ethers.getContractAt("Staker", env.get("Staker").address);
+  const [, alice, bob] = await ethers.getSigners();
+
+  for (const user of [alice, bob]) {
+    await usdc.mint(user.address, ONE_HUNDRED_USDC);
+    await usdc.connect(user).approve(await staker.getAddress(), ONE_HUNDRED_USDC);
+  }
+  return { usdc, staker, alice, bob };
+}
+
+describe("Staker", function () {
+  it("uses a 6-decimal USDC mock", async function () {
+    const { usdc, staker } = await networkHelpers.loadFixture(deployFixture);
+    expect(await usdc.decimals()).to.equal(6n);
+    expect(await usdc.symbol()).to.equal("USDC");
+    expect(await staker.token()).to.equal(ethers.getAddress(await usdc.getAddress()));
+  });
+
+  it("stakes and tracks positions per user", async function () {
+    const { usdc, staker, alice, bob } = await networkHelpers.loadFixture(deployFixture);
+
+    await expect(staker.connect(alice).stake(40_000_000n))
+      .to.emit(staker, "Staked")
+      .withArgs(alice.address, 40_000_000n);
+    await staker.connect(alice).stake(10_000_000n);
+    await staker.connect(bob).stake(5_000_000n);
+
+    expect(await staker.stakedBalance(alice.address)).to.equal(50_000_000n);
+    expect(await staker.stakedBalance(bob.address)).to.equal(5_000_000n);
+    expect(await staker.totalStaked()).to.equal(55_000_000n);
+    expect(await usdc.balanceOf(await staker.getAddress())).to.equal(55_000_000n);
+  });
+
+  it("withdraws the full position", async function () {
+    const { usdc, staker, alice, bob } = await networkHelpers.loadFixture(deployFixture);
+    await staker.connect(alice).stake(30_000_000n);
+    await staker.connect(bob).stake(20_000_000n);
+
+    await expect(staker.connect(alice).withdraw()).to.emit(staker, "Withdrawn").withArgs(alice.address, 30_000_000n);
+
+    expect(await staker.stakedBalance(alice.address)).to.equal(0n);
+    expect(await staker.totalStaked()).to.equal(20_000_000n);
+    expect(await usdc.balanceOf(alice.address)).to.equal(ONE_HUNDRED_USDC);
+  });
+
+  it("rejects zero stakes and empty withdrawals", async function () {
+    const { staker, alice } = await networkHelpers.loadFixture(deployFixture);
+    await expect(staker.connect(alice).stake(0n)).to.be.revertedWithCustomError(staker, "ZeroAmount");
+    await expect(staker.connect(alice).withdraw()).to.be.revertedWithCustomError(staker, "NothingStaked");
+  });
+
+  it("reverts when allowance is insufficient", async function () {
+    const { usdc, staker, alice } = await networkHelpers.loadFixture(deployFixture);
+    await expect(staker.connect(alice).stake(ONE_HUNDRED_USDC + 1n)).to.be.revertedWithCustomError(
+      usdc,
+      "ERC20InsufficientAllowance",
+    );
+  });
+});
