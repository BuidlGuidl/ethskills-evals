diff --git a/packages/nextjs/hooks/stake/useUsdPrices.ts b/packages/nextjs/hooks/stake/useUsdPrices.ts
new file mode 100644
index 0000000..d6b8299
--- /dev/null
+++ b/packages/nextjs/hooks/stake/useUsdPrices.ts
@@ -0,0 +1,68 @@
+import { useQuery } from "@tanstack/react-query";
+import { createPublicClient, fallback, formatUnits, http, parseAbi } from "viem";
+import { base } from "viem/chains";
+import scaffoldConfig, { DEFAULT_ALCHEMY_API_KEY } from "~~/scaffold.config";
+import { getAlchemyHttpUrl } from "~~/utils/scaffold-eth";
+import { CHAINLINK_FEEDS } from "~~/utils/stake/constants";
+
+export type UsdPrice =
+  | { status: "loading" }
+  | { status: "unavailable" }
+  | { status: "ok" | "stale"; usd: number; updatedAt: Date };
+
+const aggregatorAbi = parseAbi([
+  "function latestRoundData() view returns (uint80 roundId, int256 answer, uint256 startedAt, uint256 updatedAt, uint80 answeredInRound)",
+]);
+
+const baseRpcOverride = (scaffoldConfig.rpcOverrides as Record<number, string> | undefined)?.[base.id];
+const baseAlchemyUrl =
+  scaffoldConfig.alchemyApiKey !== DEFAULT_ALCHEMY_API_KEY ? getAlchemyHttpUrl(base.id) : undefined;
+const basePublicClient = createPublicClient({
+  chain: base,
+  transport: fallback(
+    [baseRpcOverride, baseAlchemyUrl]
+      .filter(Boolean)
+      .map(url => http(url))
+      .concat(http()),
+  ),
+});
+
+const FEED_DECIMALS = 8;
+// Grace period on top of the feed heartbeat before a price is labelled stale.
+const STALE_GRACE_SECONDS = 600;
+
+const readFeed = async ({ address, heartbeatSeconds }: (typeof CHAINLINK_FEEDS)[keyof typeof CHAINLINK_FEEDS]) => {
+  const [, answer, , updatedAt] = await basePublicClient.readContract({
+    address,
+    abi: aggregatorAbi,
+    functionName: "latestRoundData",
+  });
+  if (answer <= 0n) throw new Error("Invalid price");
+  const ageSeconds = Date.now() / 1000 - Number(updatedAt);
+  return {
+    usd: Number(formatUnits(answer, FEED_DECIMALS)),
+    updatedAt: new Date(Number(updatedAt) * 1000),
+    isStale: ageSeconds > heartbeatSeconds + STALE_GRACE_SECONDS,
+  };
+};
+
+const useFeedPrice = (feed: keyof typeof CHAINLINK_FEEDS): UsdPrice => {
+  const { data, isLoading, isError } = useQuery({
+    queryKey: ["chainlink-usd-price", feed],
+    queryFn: () => readFeed(CHAINLINK_FEEDS[feed]),
+    refetchInterval: 60_000,
+    retry: 2,
+  });
+
+  if (isLoading) return { status: "loading" };
+  if (isError || !data) return { status: "unavailable" };
+  return { status: data.isStale ? "stale" : "ok", usd: data.usd, updatedAt: data.updatedAt };
+};
+
+/**
+ * USD prices for USDC and ETH from Chainlink on Base.
+ */
+export const useUsdPrices = () => ({
+  usdc: useFeedPrice("USDC"),
+  eth: useFeedPrice("ETH"),
+});
