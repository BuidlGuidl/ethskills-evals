diff --git a/packages/nextjs/app/stake/_components/StakeDashboard.tsx b/packages/nextjs/app/stake/_components/StakeDashboard.tsx
new file mode 100644
index 0000000..02714a6
--- /dev/null
+++ b/packages/nextjs/app/stake/_components/StakeDashboard.tsx
@@ -0,0 +1,117 @@
+"use client";
+
+import { useState } from "react";
+import { StakeWorkspace } from "./StakeWorkspace";
+import { getAddress } from "viem";
+import { useAccount, useSwitchChain } from "wagmi";
+import { RainbowKitCustomConnectButton } from "~~/components/scaffold-eth";
+import { useDeployedContractInfo, useScaffoldReadContract, useTargetNetwork } from "~~/hooks/scaffold-eth";
+import { CANONICAL_USDC } from "~~/utils/stake/constants";
+import { getHumanError } from "~~/utils/stake/format";
+
+const Panel = ({ title, children }: { title: string; children: React.ReactNode }) => (
+  <div className="card bg-base-100 shadow-md">
+    <div className="card-body items-start gap-4">
+      <h2 className="card-title">{title}</h2>
+      {children}
+    </div>
+  </div>
+);
+
+/**
+ * Walks the user through connect → switch network before showing the staking workspace.
+ */
+export const StakeDashboard = () => {
+  const { address, chain, isConnected } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+  const { switchChainAsync, isPending: isSwitching } = useSwitchChain();
+  const [switchError, setSwitchError] = useState<string>();
+
+  const { data: staker, isLoading: isStakerLoading } = useDeployedContractInfo({ contractName: "Staker" });
+  const {
+    data: tokenAddress,
+    isLoading: isTokenLoading,
+    isError: isTokenError,
+    refetch: refetchToken,
+  } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "token",
+    watch: false,
+  });
+
+  if (!isConnected || !address) {
+    return (
+      <Panel title="Connect your wallet">
+        <p className="m-0">Connect a wallet on {targetNetwork.name} to see your balances and start staking.</p>
+        <RainbowKitCustomConnectButton />
+      </Panel>
+    );
+  }
+
+  if (chain?.id !== targetNetwork.id) {
+    const switchNetwork = async () => {
+      setSwitchError(undefined);
+      try {
+        await switchChainAsync({ chainId: targetNetwork.id });
+      } catch (e) {
+        setSwitchError(getHumanError(e));
+      }
+    };
+
+    return (
+      <Panel title={`Switch to ${targetNetwork.name}`}>
+        <p className="m-0">
+          Your wallet is connected to {chain?.name ?? "an unsupported network"}. USDC staking runs on{" "}
+          {targetNetwork.name}.
+        </p>
+        <button className="btn btn-primary" onClick={switchNetwork} disabled={isSwitching}>
+          {isSwitching && <span className="loading loading-spinner loading-sm" />}
+          Switch to {targetNetwork.name}
+        </button>
+        {switchError && <p className="m-0 text-error text-sm">{switchError}</p>}
+      </Panel>
+    );
+  }
+
+  if (isStakerLoading || (staker && isTokenLoading)) {
+    return (
+      <div className="flex justify-center py-10">
+        <span className="loading loading-spinner loading-lg" />
+      </div>
+    );
+  }
+
+  if (!staker) {
+    return (
+      <div role="alert" className="alert alert-warning">
+        <span>Staking isn&apos;t live on {targetNetwork.name} yet. Please check back soon.</span>
+      </div>
+    );
+  }
+
+  const usdcAddress = tokenAddress as string | undefined;
+  if (isTokenError || !usdcAddress) {
+    return (
+      <div role="alert" className="alert alert-warning">
+        <span>Couldn&apos;t load staking details from {targetNetwork.name}. The network may be busy.</span>
+        <button className="btn btn-sm" onClick={() => refetchToken()}>
+          Retry
+        </button>
+      </div>
+    );
+  }
+
+  const canonicalUsdc = CANONICAL_USDC[targetNetwork.id];
+  if (canonicalUsdc && getAddress(usdcAddress) !== getAddress(canonicalUsdc)) {
+    return (
+      <div role="alert" className="alert alert-error">
+        <span>
+          The staking contract is not connected to the official USDC token on {targetNetwork.name}. Staking is disabled
+          for your safety.
+        </span>
+      </div>
+    );
+  }
+
+  return <StakeWorkspace account={address} stakerAddress={staker.address} usdcAddress={getAddress(usdcAddress)} />;
+};
diff --git a/packages/nextjs/app/stake/_components/StakeWorkspace.tsx b/packages/nextjs/app/stake/_components/StakeWorkspace.tsx
new file mode 100644
index 0000000..12db298
--- /dev/null
+++ b/packages/nextjs/app/stake/_components/StakeWorkspace.tsx
@@ -0,0 +1,277 @@
+"use client";
+
+import { useState } from "react";
+import { Address, erc20Abi, formatUnits, parseAbi } from "viem";
+import { hardhat } from "viem/chains";
+import { useBalance, useReadContract, useWriteContract } from "wagmi";
+import {
+  useScaffoldReadContract,
+  useScaffoldWriteContract,
+  useTargetNetwork,
+  useTransactor,
+} from "~~/hooks/scaffold-eth";
+import { useUsdPrices } from "~~/hooks/stake/useUsdPrices";
+import scaffoldConfig from "~~/scaffold.config";
+import { LOW_GAS_BALANCE_WEI, USDC_DECIMALS } from "~~/utils/stake/constants";
+import { formatTokenAmount, formatUsdValue, getHumanError, parseAmountInput } from "~~/utils/stake/format";
+
+type Action = "approve" | "stake" | "withdraw" | "mint";
+
+const mockUsdcAbi = parseAbi(["function mint(address to, uint256 amount)"]);
+const LOCAL_MINT_AMOUNT = 1_000n * 10n ** BigInt(USDC_DECIMALS);
+const ALLOWANCE_POLL_ATTEMPTS = 5;
+
+const formatUsdc = (value: bigint) => formatTokenAmount(value, USDC_DECIMALS);
+const formatEth = (value: bigint) => formatTokenAmount(value, 18, { maxFractionDigits: 6, minFractionDigits: 0 });
+
+type StakeWorkspaceProps = {
+  account: Address;
+  stakerAddress: Address;
+  usdcAddress: Address;
+};
+
+export const StakeWorkspace = ({ account, stakerAddress, usdcAddress }: StakeWorkspaceProps) => {
+  const { targetNetwork } = useTargetNetwork();
+  const chainId = targetNetwork.id;
+  const isLocalNetwork = chainId === hardhat.id;
+  const prices = useUsdPrices();
+
+  // USDC is read by the address the Staker reports, so the UI always shows the token the contract actually holds.
+  const liveQuery = { refetchInterval: scaffoldConfig.pollingInterval };
+  const { data: usdcBalance, refetch: refetchUsdcBalance } = useReadContract({
+    address: usdcAddress,
+    abi: erc20Abi,
+    functionName: "balanceOf",
+    args: [account],
+    chainId,
+    query: liveQuery,
+  });
+  const { data: allowance, refetch: refetchAllowance } = useReadContract({
+    address: usdcAddress,
+    abi: erc20Abi,
+    functionName: "allowance",
+    args: [account, stakerAddress],
+    chainId,
+    query: liveQuery,
+  });
+  const { data: ethBalance, refetch: refetchEthBalance } = useBalance({ address: account, chainId, query: liveQuery });
+  const { data: stakedData, refetch: refetchStaked } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "stakedBalance",
+    args: [account],
+  });
+  const staked = stakedData as bigint | undefined;
+
+  const { writeContractAsync: writeStaker } = useScaffoldWriteContract({ contractName: "Staker" });
+  const { writeContractAsync: writeToken } = useWriteContract();
+  const transactor = useTransactor();
+
+  const [amountInput, setAmountInput] = useState("");
+  const [pendingAction, setPendingAction] = useState<Action>();
+  const [actionError, setActionError] = useState<{ action: Action; message: string }>();
+
+  const parsed = parseAmountInput(amountInput, USDC_DECIMALS);
+  const amount = parsed?.value;
+  const exceedsBalance = amount !== undefined && usdcBalance !== undefined && amount > usdcBalance;
+  const inputError = parsed?.error ?? (exceedsBalance ? "Amount exceeds your wallet USDC balance" : undefined);
+  const canSubmit =
+    amount !== undefined && !inputError && usdcBalance !== undefined && allowance !== undefined && !pendingAction;
+  const needsApproval = amount !== undefined && allowance !== undefined && allowance < amount;
+  const isBusy = pendingAction !== undefined;
+
+  const hasNoGas = ethBalance !== undefined && ethBalance.value === 0n;
+  const hasLowGas = ethBalance !== undefined && ethBalance.value > 0n && ethBalance.value < LOW_GAS_BALANCE_WEI;
+
+  // Holds the pending state from click through receipt and the balance refetch, so buttons never flash stale state.
+  const runAction = async (action: Action, send: () => Promise<unknown>) => {
+    setPendingAction(action);
+    setActionError(undefined);
+    try {
+      const hash = await send();
+      if (hash === undefined) throw new Error("The transaction was not sent. Check your wallet and try again.");
+      if (action === "stake") setAmountInput("");
+    } catch (e) {
+      setActionError({ action, message: getHumanError(e) });
+    } finally {
+      await Promise.all([refetchUsdcBalance(), refetchAllowance(), refetchEthBalance(), refetchStaked()]);
+      setPendingAction(undefined);
+    }
+  };
+
+  const approve = (value: bigint) =>
+    runAction("approve", async () => {
+      const hash = await transactor(() =>
+        writeToken({
+          address: usdcAddress,
+          abi: erc20Abi,
+          functionName: "approve",
+          args: [stakerAddress, value],
+          chainId,
+        }),
+      );
+      // An RPC node a block behind can still report the old allowance; wait until the new one is visible.
+      for (let attempt = 0; hash && attempt < ALLOWANCE_POLL_ATTEMPTS; attempt++) {
+        const { data } = await refetchAllowance();
+        if (data !== undefined && data >= value) break;
+        await new Promise(resolve => setTimeout(resolve, 1_000));
+      }
+      return hash;
+    });
+  const stake = (value: bigint) => runAction("stake", () => writeStaker({ functionName: "stake", args: [value] }));
+  const withdraw = () => runAction("withdraw", () => writeStaker({ functionName: "withdraw" }));
+  const mintTestUsdc = () =>
+    runAction("mint", () =>
+      transactor(() =>
+        writeToken({
+          address: usdcAddress,
+          abi: mockUsdcAbi,
+          functionName: "mint",
+          args: [account, LOCAL_MINT_AMOUNT],
+          chainId,
+        }),
+      ),
+    );
+
+  const errorFor = (...actions: Action[]) =>
+    actionError && actions.includes(actionError.action) ? (
+      <p role="alert" className="m-0 text-error text-sm">
+        {actionError.message}
+      </p>
+    ) : null;
+
+  const spinnerFor = (action: Action) =>
+    pendingAction === action ? <span className="loading loading-spinner loading-sm" /> : null;
+
+  return (
+    <>
+      <div className="stats stats-vertical md:stats-horizontal bg-base-100 shadow-md w-full">
+        <div className="stat">
+          <div className="stat-title">Wallet USDC</div>
+          <div className="stat-value text-2xl">{usdcBalance === undefined ? "…" : formatUsdc(usdcBalance)}</div>
+          <div className="stat-desc">{formatUsdValue(usdcBalance, USDC_DECIMALS, prices.usdc)}</div>
+        </div>
+        <div className="stat">
+          <div className="stat-title">ETH for gas</div>
+          <div className="stat-value text-2xl">{ethBalance === undefined ? "…" : formatEth(ethBalance.value)}</div>
+          <div className="stat-desc">{formatUsdValue(ethBalance?.value, 18, prices.eth)}</div>
+        </div>
+        <div className="stat">
+          <div className="stat-title">Staked USDC</div>
+          <div className="stat-value text-2xl">{staked === undefined ? "…" : formatUsdc(staked)}</div>
+          <div className="stat-desc">{formatUsdValue(staked, USDC_DECIMALS, prices.usdc)}</div>
+        </div>
+      </div>
+
+      {(hasNoGas || hasLowGas) && (
+        <div role="alert" className="alert alert-warning">
+          <span>
+            {hasNoGas
+              ? `You have no ETH on ${targetNetwork.name}. You need a small amount of ETH to pay network fees before you can stake or withdraw.`
+              : `Your ETH balance is low. You may not have enough to pay network fees on ${targetNetwork.name}.`}
+          </span>
+        </div>
+      )}
+
+      <div className="card bg-base-100 shadow-md">
+        <div className="card-body gap-3">
+          <h2 className="card-title">Stake</h2>
+          <label htmlFor="stake-amount" className="text-sm opacity-80">
+            Amount (USDC)
+          </label>
+          <div className="join w-full">
+            <input
+              id="stake-amount"
+              className={`input join-item w-full ${inputError ? "input-error" : ""}`}
+              inputMode="decimal"
+              autoComplete="off"
+              placeholder="0.00"
+              value={amountInput}
+              disabled={isBusy}
+              onChange={e => setAmountInput(e.target.value.replace(",", "."))}
+            />
+            <button
+              className="btn join-item"
+              disabled={isBusy || !usdcBalance}
+              onClick={() => usdcBalance !== undefined && setAmountInput(formatUnits(usdcBalance, USDC_DECIMALS))}
+            >
+              Max
+            </button>
+          </div>
+          <p className={`m-0 text-sm ${inputError ? "text-error" : "opacity-70"}`}>
+            {inputError ?? (amount !== undefined ? formatUsdValue(amount, USDC_DECIMALS, prices.usdc) : " ")}
+          </p>
+
+          {needsApproval && !inputError && (
+            <p className="m-0 text-sm">
+              Step 1 of 2: allow the staking contract to move {formatUsdc(amount)} USDC. You&apos;ll confirm the stake
+              right after.
+            </p>
+          )}
+
+          {needsApproval ? (
+            <button
+              className="btn btn-primary"
+              disabled={!canSubmit}
+              onClick={() => amount !== undefined && approve(amount)}
+            >
+              {spinnerFor("approve")}
+              {pendingAction === "approve"
+                ? "Approving…"
+                : `Approve ${amount !== undefined ? formatUsdc(amount) : ""} USDC`}
+            </button>
+          ) : (
+            <button
+              className="btn btn-primary"
+              disabled={!canSubmit}
+              onClick={() => amount !== undefined && stake(amount)}
+            >
+              {spinnerFor("stake")}
+              {pendingAction === "stake"
+                ? "Staking…"
+                : amount !== undefined
+                  ? `Stake ${formatUsdc(amount)} USDC`
+                  : "Enter an amount to stake"}
+            </button>
+          )}
+          {errorFor("approve", "stake")}
+        </div>
+      </div>
+
+      <div className="card bg-base-100 shadow-md">
+        <div className="card-body gap-3">
+          <h2 className="card-title">Your position</h2>
+          <p className="m-0">
+            {staked === undefined
+              ? "Loading your position…"
+              : staked === 0n
+                ? "You have nothing staked yet."
+                : `${formatUsdc(staked)} USDC staked (${formatUsdValue(staked, USDC_DECIMALS, prices.usdc)}). Withdrawing returns all of it to your wallet.`}
+          </p>
+          <button className="btn btn-outline" disabled={isBusy || !staked} onClick={withdraw}>
+            {spinnerFor("withdraw")}
+            {pendingAction === "withdraw"
+              ? "Withdrawing…"
+              : staked
+                ? `Withdraw all ${formatUsdc(staked)} USDC`
+                : "Nothing to withdraw"}
+          </button>
+          {errorFor("withdraw")}
+        </div>
+      </div>
+
+      {isLocalNetwork && (
+        <div className="card bg-base-100 shadow-md border border-dashed border-base-300">
+          <div className="card-body gap-3">
+            <h2 className="card-title text-base">Local testing</h2>
+            <p className="m-0 text-sm">Mint mock USDC to your wallet. Only available on the local chain.</p>
+            <button className="btn btn-sm" disabled={isBusy} onClick={mintTestUsdc}>
+              {spinnerFor("mint")}
+              Mint {formatUsdc(LOCAL_MINT_AMOUNT)} test USDC
+            </button>
+            {errorFor("mint")}
+          </div>
+        </div>
+      )}
+    </>
+  );
+};
