index 0000000..e2ba8cf
--- /dev/null
+++ b/packages/nextjs/app/stake/_utils/usdc.ts
@@ -0,0 +1,39 @@
+import { formatUnits, parseUnits } from "viem";
+
+/** USDC uses 6 decimals on Base and on the local mock. Only a fallback: the UI reads it on chain. */
+export const USDC_DECIMALS = 6;
+
+/**
+ * Keeps a typed amount parseable while the user types: digits, at most one decimal point,
+ * and never more decimal places than the token has.
+ */
+export const sanitizeAmountInput = (raw: string, decimals: number) => {
+  const [whole, ...rest] = raw
+    .replace(",", ".")
+    .replace(/[^\d.]/g, "")
+    .split(".");
+  if (rest.length === 0) return whole;
+  return `${whole}.${rest.join("").slice(0, decimals)}`;
+};
+
+/** Input string to token units. Anything unparseable (empty, ".") counts as zero. */
+export const parseAmountInput = (value: string, decimals: number) => {
+  try {
+    return parseUnits(value, decimals);
+  } catch {
+    return 0n;
+  }
+};
+
+/** Token units as an input value, without trailing-zero noise: 340500000n -> "340.5". */
+export const toAmountInput = (value: bigint, decimals: number) => formatUnits(value, decimals);
+
+/**
+ * Token units for display: thousands separators and 2 decimals, the way people read money.
+ * Balances too small to show never round down to a flat "0.00".
+ */
+export const formatAmount = (value: bigint, decimals: number) => {
+  const asNumber = Number(formatUnits(value, decimals));
+  if (value > 0n && asNumber < 0.01) return "<0.01";
+  return asNumber.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
+};
