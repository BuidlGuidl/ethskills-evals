index 0000000..b30842b
--- /dev/null
+++ b/packages/nextjs/app/stake/_hooks/useUsdcStaking.ts
@@ -0,0 +1,82 @@
+"use client";
+
+import { useCallback } from "react";
+import { useWatchBalance } from "@scaffold-ui/hooks";
+import { useAccount } from "wagmi";
+import { USDC_DECIMALS } from "~~/app/stake/_utils/usdc";
+import { useDeployedContractInfo, useScaffoldReadContract, useTargetNetwork } from "~~/hooks/scaffold-eth";
+
+/**
+ * Everything the stake page needs about the connected account: what it holds, what it has
+ * approved and what it has staked. The underlying reads are cached per query key, so
+ * calling this from several components costs nothing extra.
+ */
+export const useUsdcStaking = () => {
+  const { address } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+
+  const { data: stakerContract, isLoading: isStakerContractLoading } = useDeployedContractInfo({
+    contractName: "Staker",
+  });
+  const { data: usdcContract, isLoading: isUsdcContractLoading } = useDeployedContractInfo({ contractName: "USDC" });
+
+  // Fixed at 6 for USDC, but read on chain so the mock and the real token can never drift apart.
+  const { data: onChainDecimals } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "decimals",
+    watch: false,
+  });
+
+  const {
+    data: walletBalance,
+    isLoading: isWalletBalanceLoading,
+    refetch: refetchWalletBalance,
+  } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "balanceOf",
+    args: [address],
+  });
+
+  const { data: allowance, refetch: refetchAllowance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "allowance",
+    args: [address, stakerContract?.address],
+  });
+
+  const {
+    data: stakedBalance,
+    isLoading: isStakedBalanceLoading,
+    refetch: refetchStakedBalance,
+  } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "stakedBalance",
+    args: [address],
+  });
+
+  const { data: nativeBalance, isLoading: isNativeBalanceLoading } = useWatchBalance({
+    address,
+    chainId: targetNetwork.id,
+  });
+
+  // Writes land a block before the watchers pick them up, so refresh right away.
+  const refetchPosition = useCallback(async () => {
+    await Promise.all([refetchWalletBalance(), refetchAllowance(), refetchStakedBalance()]);
+  }, [refetchAllowance, refetchStakedBalance, refetchWalletBalance]);
+
+  const isContractsLoading = isStakerContractLoading || isUsdcContractLoading;
+
+  return {
+    stakerAddress: stakerContract?.address,
+    decimals: onChainDecimals ?? USDC_DECIMALS,
+    walletBalance: walletBalance ?? 0n,
+    allowance: allowance ?? 0n,
+    stakedBalance: stakedBalance ?? 0n,
+    nativeBalance: nativeBalance?.value,
+    nativeSymbol: nativeBalance?.symbol ?? targetNetwork.nativeCurrency.symbol,
+    isPositionLoading: isWalletBalanceLoading || isStakedBalanceLoading || isNativeBalanceLoading,
+    isContractsLoading,
+    /** The dApp is not deployed (yet) on the network the user is connected to. */
+    isMissingContracts: !isContractsLoading && (!stakerContract || !usdcContract),
+    refetchPosition,
+  };
+};
diff --git a/packages/nextjs/app/stake/_utils/usdc.ts b/packages/nextjs/app/stake/_utils/usdc.ts
