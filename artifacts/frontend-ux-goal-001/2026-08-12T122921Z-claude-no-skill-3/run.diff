@@ -0,0 +1,60 @@
+"use client";
+
+import { Balance } from "@scaffold-ui/components";
+import { useAccount } from "wagmi";
+import { useUsdcStaking } from "~~/app/stake/_hooks/useUsdcStaking";
+import { formatAmount, toAmountInput } from "~~/app/stake/_utils/usdc";
+import { useTargetNetwork } from "~~/hooks/scaffold-eth";
+
+type AmountStatProps = { title: string; amount: bigint; decimals: number; hint: string };
+
+/** Rounded for reading, exact on hover: nobody should have to guess where their cents went. */
+const AmountStat = ({ title, amount, decimals, hint }: AmountStatProps) => (
+  <div className="stat px-5">
+    <div className="stat-title text-xs">{title}</div>
+    <div className="stat-value text-2xl tabular-nums" title={`${toAmountInput(amount, decimals)} USDC`}>
+      {formatAmount(amount, decimals)} <span className="text-base font-normal text-base-content/60">USDC</span>
+    </div>
+    <div className="stat-desc">{hint}</div>
+  </div>
+);
+
+/** The three numbers a staker needs before touching a button: staked, spendable, gas. */
+export const PositionSummary = () => {
+  const { address } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+  const { decimals, walletBalance, stakedBalance, nativeBalance, nativeSymbol, isPositionLoading } = useUsdcStaking();
+
+  if (isPositionLoading) {
+    return <div className="skeleton h-28 w-full rounded-none" />;
+  }
+
+  const hasNoGas = nativeBalance === 0n;
+
+  return (
+    <div className="flex flex-col gap-2">
+      <div className="stats stats-vertical w-full border border-base-300 bg-base-100 sm:stats-horizontal">
+        <AmountStat title="Staked" amount={stakedBalance} decimals={decimals} hint="Withdrawable any time" />
+        <AmountStat title="In your wallet" amount={walletBalance} decimals={decimals} hint="Available to stake" />
+
+        <div className="stat px-5">
+          <div className="stat-title text-xs">For gas</div>
+          <div className="stat-value text-2xl tabular-nums">
+            <Balance address={address} chain={targetNetwork} />
+          </div>
+          <div className="stat-desc">
+            Your {nativeSymbol} on {targetNetwork.name}
+          </div>
+        </div>
+      </div>
+
+      {hasNoGas ? (
+        <div className="alert alert-warning py-2 text-sm">
+          <span>
+            No {nativeSymbol} on {targetNetwork.name}, so transactions cannot be paid for. Add some before staking.
+          </span>
+        </div>
+      ) : null}
+    </div>
+  );
+};
diff --git a/packages/nextjs/app/stake/_components/StakeForm.tsx b/packages/nextjs/app/stake/_components/StakeForm.tsx
new file mode 100644
index 0000000..7489eec
--- /dev/null
+++ b/packages/nextjs/app/stake/_components/StakeForm.tsx
@@ -0,0 +1,85 @@
+"use client";
+
+import { FormEvent, useState } from "react";
+import { AmountField } from "~~/app/stake/_components/AmountField";
+import { useUsdcStaking } from "~~/app/stake/_hooks/useUsdcStaking";
+import { formatAmount, parseAmountInput } from "~~/app/stake/_utils/usdc";
+import { useScaffoldWriteContract } from "~~/hooks/scaffold-eth";
+
+/**
+ * Deposit flow. ERC20 deposits take two transactions when the allowance is not big enough,
+ * so the button walks the user through them one at a time instead of failing halfway.
+ */
+export const StakeForm = () => {
+  const { stakerAddress, decimals, walletBalance, allowance, isPositionLoading, refetchPosition } = useUsdcStaking();
+  const [value, setValue] = useState("");
+  const [hasJustApproved, setHasJustApproved] = useState(false);
+
+  const { writeContractAsync: writeUsdc, isMining: isApproving } = useScaffoldWriteContract({ contractName: "USDC" });
+  const { writeContractAsync: writeStaker, isMining: isStaking } = useScaffoldWriteContract({ contractName: "Staker" });
+
+  const amount = parseAmountInput(value, decimals);
+  const isBusy = isApproving || isStaking;
+  const exceedsBalance = amount > walletBalance;
+  const needsApproval = amount > allowance;
+
+  const canSubmit = amount > 0n && !exceedsBalance && !isBusy && Boolean(stakerAddress);
+
+  const handleSubmit = async (event: FormEvent) => {
+    event.preventDefault();
+    if (!canSubmit || !stakerAddress) return;
+
+    try {
+      if (needsApproval) {
+        // Approve exactly what is being staked: no leftover allowance sitting on the contract.
+        await writeUsdc({ functionName: "approve", args: [stakerAddress, amount] });
+        setHasJustApproved(true);
+      } else {
+        await writeStaker({ functionName: "stake", args: [amount] });
+        setValue("");
+        setHasJustApproved(false);
+      }
+      await refetchPosition();
+    } catch (error) {
+      // useScaffoldWriteContract already showed the reason; there is nothing to recover here.
+      console.error("Staking failed", error);
+    }
+  };
+
+  return (
+    <form className="flex flex-col gap-4" onSubmit={handleSubmit}>
+      <AmountField
+        id="stake-amount"
+        label="Amount to stake"
+        value={value}
+        onChange={setValue}
+        max={walletBalance}
+        maxLabel="Wallet"
+        decimals={decimals}
+        disabled={isBusy}
+        error={
+          exceedsBalance ? `You only have ${formatAmount(walletBalance, decimals)} USDC in your wallet` : undefined
+        }
+      />
+
+      <button type="submit" className="btn btn-primary w-full" disabled={!canSubmit}>
+        {isBusy ? <span className="loading loading-spinner loading-sm" /> : null}
+        {isApproving ? "Approving…" : isStaking ? "Staking…" : needsApproval && amount > 0n ? "Approve USDC" : "Stake"}
+      </button>
+
+      {amount > 0n && !exceedsBalance && (needsApproval || hasJustApproved) ? (
+        <div className="text-center text-xs text-base-content/60">
+          {needsApproval
+            ? `Step 1 of 2: allow the Staker to move ${formatAmount(amount, decimals)} USDC. You confirm the deposit next.`
+            : `Approved. Step 2 of 2: confirm the deposit of ${formatAmount(amount, decimals)} USDC.`}
+        </div>
+      ) : null}
+
+      {walletBalance === 0n && !isPositionLoading ? (
+        <div className="text-center text-xs text-base-content/60">
+          This wallet holds no USDC yet. Fund it before staking.
+        </div>
+      ) : null}
+    </form>
+  );
+};
