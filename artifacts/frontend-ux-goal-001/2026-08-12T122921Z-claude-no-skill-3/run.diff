+"use client";
+
+import { FormEvent, useState } from "react";
+import { AmountField } from "~~/app/stake/_components/AmountField";
+import { useUsdcStaking } from "~~/app/stake/_hooks/useUsdcStaking";
+import { formatAmount, parseAmountInput } from "~~/app/stake/_utils/usdc";
+import { useScaffoldWriteContract } from "~~/hooks/scaffold-eth";
+
+/** Withdrawals need no approval: the Staker is already holding the tokens. */
+export const WithdrawForm = () => {
+  const { decimals, stakedBalance, isPositionLoading, refetchPosition } = useUsdcStaking();
+  const [value, setValue] = useState("");
+
+  const { writeContractAsync: writeStaker, isMining } = useScaffoldWriteContract({ contractName: "Staker" });
+
+  const amount = parseAmountInput(value, decimals);
+  const exceedsStake = amount > stakedBalance;
+  const canSubmit = amount > 0n && !exceedsStake && !isMining;
+
+  const handleSubmit = async (event: FormEvent) => {
+    event.preventDefault();
+    if (!canSubmit) return;
+
+    try {
+      await writeStaker({ functionName: "withdraw", args: [amount] });
+      setValue("");
+      await refetchPosition();
+    } catch (error) {
+      console.error("Withdrawal failed", error);
+    }
+  };
+
+  if (isPositionLoading) {
+    return <div className="skeleton h-32 w-full rounded-none" />;
+  }
+
+  if (stakedBalance === 0n) {
+    return (
+      <div className="py-6 text-center text-sm text-base-content/60">
+        Nothing staked yet. Anything you stake shows up here and can be withdrawn straight away.
+      </div>
+    );
+  }
+
+  return (
+    <form className="flex flex-col gap-4" onSubmit={handleSubmit}>
+      <AmountField
+        id="withdraw-amount"
+        label="Amount to withdraw"
+        value={value}
+        onChange={setValue}
+        max={stakedBalance}
+        maxLabel="Staked"
+        decimals={decimals}
+        disabled={isMining}
+        error={exceedsStake ? `You have ${formatAmount(stakedBalance, decimals)} USDC staked` : undefined}
+      />
+
+      <button type="submit" className="btn btn-primary w-full" disabled={!canSubmit}>
+        {isMining ? <span className="loading loading-spinner loading-sm" /> : null}
+        {isMining ? "Withdrawing…" : "Withdraw"}
+      </button>
+
+      <div className="text-center text-xs text-base-content/60">
+        Withdrawals are instant and unlimited: MAX returns your whole position.
+      </div>
+    </form>
+  );
+};
