@@ -0,0 +1,74 @@
+"use client";
+
+import { formatAmount, sanitizeAmountInput, toAmountInput } from "~~/app/stake/_utils/usdc";
+
+type AmountFieldProps = {
+  id: string;
+  label: string;
+  value: string;
+  onChange: (value: string) => void;
+  /** Largest amount the user can enter, in token units. Drives the MAX button. */
+  max: bigint;
+  maxLabel: string;
+  decimals: number;
+  disabled?: boolean;
+  error?: string;
+};
+
+/**
+ * USDC amount input. Values are kept as the typed string (never a float) so nothing is lost
+ * on the way to `parseUnits`, and typing is constrained to what a 6 decimal token can hold.
+ */
+export const AmountField = ({
+  id,
+  label,
+  value,
+  onChange,
+  max,
+  maxLabel,
+  decimals,
+  disabled,
+  error,
+}: AmountFieldProps) => (
+  <div className="flex flex-col gap-2">
+    <div className="flex items-baseline justify-between gap-2 text-sm">
+      <label htmlFor={id} className="font-medium">
+        {label}
+      </label>
+      <span className="text-base-content/60">
+        {maxLabel}: {formatAmount(max, decimals)} USDC
+      </span>
+    </div>
+
+    <label className={`input input-bordered flex w-full items-center gap-2 bg-base-100 ${error ? "input-error" : ""}`}>
+      <input
+        id={id}
+        className="grow"
+        type="text"
+        inputMode="decimal"
+        autoComplete="off"
+        placeholder="0.00"
+        value={value}
+        disabled={disabled}
+        aria-invalid={Boolean(error)}
+        aria-describedby={error ? `${id}-error` : undefined}
+        onChange={event => onChange(sanitizeAmountInput(event.target.value, decimals))}
+      />
+      <span className="text-sm font-medium text-base-content/60">USDC</span>
+      <button
+        type="button"
+        className="btn btn-xs btn-secondary"
+        disabled={disabled || max === 0n}
+        onClick={() => onChange(toAmountInput(max, decimals))}
+      >
+        MAX
+      </button>
+    </label>
+
+    {error ? (
+      <span id={`${id}-error`} role="alert" className="text-sm text-error">
+        {error}
+      </span>
+    ) : null}
+  </div>
+);
