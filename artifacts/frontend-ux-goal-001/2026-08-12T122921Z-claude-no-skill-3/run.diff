+import { deployScript, artifacts } from "../rocketh/deploy.js";
+
+/**
+ * Circle's canonical USDC deployments. Any chain that is not listed here has to be a
+ * local one, where we deploy a mock token instead.
+ */
+const USDC_BY_CHAIN_ID: Record<number, `0x${string}`> = {
+  8453: "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913", // Base
+  84532: "0x036CbD53842c5426634e7929541eC2318f3dCF7e", // Base Sepolia
+};
+
+const LOCAL_CHAIN_IDS = [31337];
+
+/**
+ * Deploys the Staker, wired to the USDC of the target chain.
+ *
+ * @param env Rocketh environment object.
+ */
+export default deployScript(
+  async env => {
+    const { deployer } = env.namedAccounts;
+    const chainId = env.network.chain.id;
+
+    let usdcAddress = USDC_BY_CHAIN_ID[chainId];
+
+    if (!usdcAddress) {
+      if (!LOCAL_CHAIN_IDS.includes(chainId)) {
+        throw new Error(`No USDC address known for chain ${chainId}. Add it to USDC_BY_CHAIN_ID first.`);
+      }
+
+      // Saved as "USDC" so the frontend resolves the mock under the same name as the real token.
+      const mockUsdc = await env.deploy("USDC", {
+        account: deployer,
+        artifact: artifacts.MockUSDC,
+        args: [],
+      });
+      usdcAddress = mockUsdc.address;
+      console.log("🪙 Mock USDC deployed. Mint yourself some from the Debug Contracts page.");
+    }
+
+    await env.deploy("Staker", {
+      account: deployer,
+      artifact: artifacts.Staker,
+      args: [usdcAddress],
+    });
+
+    console.log("💵 Staker is staking USDC at", usdcAddress);
+  },
+  {
+    // e.g. yarn deploy --tags Staker
+    tags: ["Staker"],
+  },
+);
diff --git a/packages/hardhat/test/Staker.ts b/packages/hardhat/test/Staker.ts
new file mode 100644
index 0000000..9af038b
--- /dev/null
+++ b/packages/hardhat/test/Staker.ts
@@ -0,0 +1,134 @@
+import { expect } from "chai";
+import { network } from "hardhat";
+import type { Abi_Staker } from "../generated/abis/Staker.js";
+import type { Abi_MockUSDC } from "../generated/abis/MockUSDC.js";
+import { loadAndExecuteDeploymentsFromFiles } from "../rocketh/environment.js";
+
+const { provider, networkHelpers, ethers } = await network.create();
+
+const ONE_USDC = 1_000_000n; // USDC has 6 decimals
+
+async function deployFixture() {
+  const env = await loadAndExecuteDeploymentsFromFiles({ provider });
+
+  const { abi: stakerAbi, address: stakerAddress } = env.get<Abi_Staker>("Staker");
+  const { abi: usdcAbi, address: usdcAddress } = env.get<Abi_MockUSDC>("USDC");
+
+  const [, alice, bob] = await ethers.getSigners();
+
+  const staker = await ethers.getContractAt(stakerAbi, stakerAddress);
+  const usdc = await ethers.getContractAt(usdcAbi, usdcAddress);
+  const aliceStaker = await ethers.getContractAt(stakerAbi, stakerAddress, alice);
+  const aliceUsdc = await ethers.getContractAt(usdcAbi, usdcAddress, alice);
+  const bobStaker = await ethers.getContractAt(stakerAbi, stakerAddress, bob);
+  const bobUsdc = await ethers.getContractAt(usdcAbi, usdcAddress, bob);
+
+  // Fund both users and let the staker pull from Alice.
+  await usdc.mint(alice.address, 1000n * ONE_USDC);
+  await usdc.mint(bob.address, 1000n * ONE_USDC);
+  await aliceUsdc.approve(stakerAddress, 1000n * ONE_USDC);
+
+  return { staker, usdc, stakerAddress, alice, aliceStaker, bob, bobStaker, bobUsdc };
+}
+
+describe("Staker", function () {
+  it("Should be wired to the USDC deployment", async function () {
+    const { staker, usdc } = await networkHelpers.loadFixture(deployFixture);
+    expect(await staker.token()).to.equal(ethers.getAddress(await usdc.getAddress()));
+  });
+
+  describe("stake", function () {
+    it("Should move the tokens and credit the staker", async function () {
+      const { staker, usdc, stakerAddress, alice, aliceStaker } = await networkHelpers.loadFixture(deployFixture);
+
+      await expect(aliceStaker.stake(100n * ONE_USDC))
+        .to.emit(staker, "Staked")
+        .withArgs(alice.address, 100n * ONE_USDC);
+
+      expect(await staker.stakedBalance(alice.address)).to.equal(100n * ONE_USDC);
+      expect(await staker.totalStaked()).to.equal(100n * ONE_USDC);
+      expect(await usdc.balanceOf(alice.address)).to.equal(900n * ONE_USDC);
+      expect(await usdc.balanceOf(stakerAddress)).to.equal(100n * ONE_USDC);
+    });
+
+    it("Should add up over several deposits", async function () {
+      const { staker, alice, aliceStaker } = await networkHelpers.loadFixture(deployFixture);
+
+      await aliceStaker.stake(30n * ONE_USDC);
+      await aliceStaker.stake(12n * ONE_USDC);
+
+      expect(await staker.stakedBalance(alice.address)).to.equal(42n * ONE_USDC);
+    });
+
+    it("Should reject a zero amount", async function () {
+      const { staker, aliceStaker } = await networkHelpers.loadFixture(deployFixture);
+      await expect(aliceStaker.stake(0)).to.be.revertedWithCustomError(staker, "AmountZero");
+    });
+
+    it("Should revert without an allowance", async function () {
+      const { usdc, bobStaker } = await networkHelpers.loadFixture(deployFixture);
+      // Bob holds USDC but never approved the staker.
+      await expect(bobStaker.stake(ONE_USDC)).to.be.revertedWithCustomError(usdc, "ERC20InsufficientAllowance");
+    });
+
+    it("Should keep positions separate per account", async function () {
+      const { staker, stakerAddress, alice, aliceStaker, bob, bobStaker, bobUsdc } =
+        await networkHelpers.loadFixture(deployFixture);
+
+      await bobUsdc.approve(stakerAddress, 1000n * ONE_USDC);
+      await aliceStaker.stake(10n * ONE_USDC);
+      await bobStaker.stake(25n * ONE_USDC);
+
+      expect(await staker.stakedBalance(alice.address)).to.equal(10n * ONE_USDC);
+      expect(await staker.stakedBalance(bob.address)).to.equal(25n * ONE_USDC);
+      expect(await staker.totalStaked()).to.equal(35n * ONE_USDC);
+    });
+  });
+
+  describe("withdraw", function () {
+    it("Should return part of the position", async function () {
+      const { staker, usdc, alice, aliceStaker } = await networkHelpers.loadFixture(deployFixture);
+
+      await aliceStaker.stake(100n * ONE_USDC);
+
+      await expect(aliceStaker.withdraw(40n * ONE_USDC))
+        .to.emit(staker, "Withdrawn")
+        .withArgs(alice.address, 40n * ONE_USDC);
+
+      expect(await staker.stakedBalance(alice.address)).to.equal(60n * ONE_USDC);
+      expect(await staker.totalStaked()).to.equal(60n * ONE_USDC);
+      expect(await usdc.balanceOf(alice.address)).to.equal(940n * ONE_USDC);
+    });
+
+    it("Should let a staker exit fully at any time", async function () {
+      const { staker, usdc, stakerAddress, alice, aliceStaker } = await networkHelpers.loadFixture(deployFixture);
+
+      await aliceStaker.stake(100n * ONE_USDC);
+      await aliceStaker.withdraw(await staker.stakedBalance(alice.address));
+
+      expect(await staker.stakedBalance(alice.address)).to.equal(0n);
+      expect(await staker.totalStaked()).to.equal(0n);
+      expect(await usdc.balanceOf(alice.address)).to.equal(1000n * ONE_USDC);
+      expect(await usdc.balanceOf(stakerAddress)).to.equal(0n);
+    });
+
+    it("Should reject more than the caller staked", async function () {
+      const { staker, stakerAddress, aliceStaker, bobStaker, bobUsdc } =
+        await networkHelpers.loadFixture(deployFixture);
+
+      // Another account's deposit must not be withdrawable.
+      await bobUsdc.approve(stakerAddress, 1000n * ONE_USDC);
+      await bobStaker.stake(500n * ONE_USDC);
+      await aliceStaker.stake(10n * ONE_USDC);
+
+      await expect(aliceStaker.withdraw(11n * ONE_USDC))
+        .to.be.revertedWithCustomError(staker, "InsufficientStake")
+        .withArgs(11n * ONE_USDC, 10n * ONE_USDC);
+    });
+
+    it("Should reject a zero amount", async function () {
+      const { staker, aliceStaker } = await networkHelpers.loadFixture(deployFixture);
+      await expect(aliceStaker.withdraw(0)).to.be.revertedWithCustomError(staker, "AmountZero");
+    });
+  });
+});
