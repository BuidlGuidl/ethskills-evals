@@ -0,0 +1,121 @@
+"use client";
+
+import { ReactNode, useState } from "react";
+import { Address } from "@scaffold-ui/components";
+import { useAccount, useSwitchChain } from "wagmi";
+import { PositionSummary } from "~~/app/stake/_components/PositionSummary";
+import { StakeForm } from "~~/app/stake/_components/StakeForm";
+import { WithdrawForm } from "~~/app/stake/_components/WithdrawForm";
+import { useUsdcStaking } from "~~/app/stake/_hooks/useUsdcStaking";
+import { RainbowKitCustomConnectButton } from "~~/components/scaffold-eth";
+import { useTargetNetwork } from "~~/hooks/scaffold-eth";
+import scaffoldConfig from "~~/scaffold.config";
+
+const TABS = [
+  { id: "stake", label: "Stake" },
+  { id: "withdraw", label: "Withdraw" },
+] as const;
+
+type TabId = (typeof TABS)[number]["id"];
+
+const Panel = ({ children }: { children: ReactNode }) => (
+  <div className="card border border-base-300 bg-base-100">
+    <div className="card-body items-center gap-4 p-6 text-center">{children}</div>
+  </div>
+);
+
+export const StakeInterface = () => {
+  const [activeTab, setActiveTab] = useState<TabId>("stake");
+
+  const { chain, isConnected } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+  const { switchChain, isPending: isSwitchingChain } = useSwitchChain();
+  const { stakerAddress, isContractsLoading, isMissingContracts } = useUsdcStaking();
+
+  if (!isConnected) {
+    return (
+      <Panel>
+        <h2 className="text-lg font-semibold">Connect your wallet</h2>
+        <span className="text-sm text-base-content/70">
+          Connect to see your USDC balance and your staked position on {targetNetwork.name}.
+        </span>
+        <RainbowKitCustomConnectButton />
+      </Panel>
+    );
+  }
+
+  // Any configured network is fine: `useTargetNetwork` follows the wallet across them.
+  const isSupportedNetwork = scaffoldConfig.targetNetworks.some(network => network.id === chain?.id);
+
+  if (!isSupportedNetwork) {
+    return (
+      <Panel>
+        <h2 className="text-lg font-semibold">Wrong network</h2>
+        <span className="text-sm text-base-content/70">
+          Staking happens on {targetNetwork.name}
+          {chain ? `, but your wallet is on ${chain.name}` : ""}.
+        </span>
+        <button
+          className="btn btn-primary"
+          onClick={() => switchChain({ chainId: targetNetwork.id })}
+          disabled={isSwitchingChain}
+        >
+          {isSwitchingChain ? <span className="loading loading-spinner loading-sm" /> : null}
+          Switch to {targetNetwork.name}
+        </button>
+      </Panel>
+    );
+  }
+
+  if (isContractsLoading) {
+    return <div className="skeleton h-64 w-full rounded-none" />;
+  }
+
+  if (isMissingContracts) {
+    return (
+      <Panel>
+        <h2 className="text-lg font-semibold">Not available here</h2>
+        <span className="text-sm text-base-content/70">
+          The staking contracts are not deployed on {targetNetwork.name}. Run{" "}
+          <code className="bg-base-300 px-1">yarn deploy</code> for a local chain, or switch to a network where they
+          live.
+        </span>
+      </Panel>
+    );
+  }
+
+  return (
+    <div className="flex flex-col gap-4">
+      <PositionSummary />
+
+      <div className="card border border-base-300 bg-base-100">
+        <div className="card-body gap-5 p-5 sm:p-6">
+          <div role="tablist" className="tabs tabs-box w-full p-1">
+            {TABS.map(({ id, label }) => (
+              <button
+                key={id}
+                role="tab"
+                id={`${id}-tab`}
+                aria-selected={activeTab === id}
+                aria-controls={`${id}-panel`}
+                className={`tab flex-1 ${activeTab === id ? "tab-active" : ""}`}
+                onClick={() => setActiveTab(id)}
+              >
+                {label}
+              </button>
+            ))}
+          </div>
+
+          <div role="tabpanel" id={`${activeTab}-panel`} aria-labelledby={`${activeTab}-tab`}>
+            {activeTab === "stake" ? <StakeForm /> : <WithdrawForm />}
+          </div>
+        </div>
+      </div>
+
+      <div className="flex items-center justify-center gap-2 text-xs text-base-content/60">
+        <span>Staker contract:</span>
+        <Address address={stakerAddress} chain={targetNetwork} size="xs" />
+      </div>
+    </div>
+  );
+};
