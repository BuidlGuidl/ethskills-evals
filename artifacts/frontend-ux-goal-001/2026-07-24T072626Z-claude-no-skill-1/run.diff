+//SPDX-License-Identifier: MIT
+pragma solidity 0.8.30;
+
+import { ERC20 } from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+
+/**
+ * Mock USDC for local development only.
+ *
+ * Mirrors the real token's name, symbol, and 6-decimal precision so the frontend
+ * behaves identically against a local chain. Exposes an unrestricted `mint` so
+ * developers can fund any test account — this is why it must NEVER be deployed to
+ * a live network.
+ */
+contract MockUSDC is ERC20 {
+    constructor() ERC20("USD Coin", "USDC") {}
+
+    /// USDC uses 6 decimals, not the ERC20 default of 18.
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    /// Freely mint test tokens to any address.
+    function mint(address to, uint256 amount) external {
+        _mint(to, amount);
+    }
+}
diff --git a/packages/hardhat/contracts/Staker.sol b/packages/hardhat/contracts/Staker.sol
new file mode 100644
index 0000000..f0ff311
--- /dev/null
+++ b/packages/hardhat/contracts/Staker.sol
@@ -0,0 +1,76 @@
+//SPDX-License-Identifier: MIT
+pragma solidity 0.8.30;
+
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { SafeERC20 } from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+
+/**
+ * Minimal USDC staking vault.
+ *
+ * Users deposit USDC and can withdraw their full position at any time. There is
+ * no rewards logic, no lockup, and no admin — the contract only ever holds what
+ * stakers deposited and only ever pays it back to them.
+ *
+ * The token is fixed at deployment and assumed to be a standard, non-rebasing,
+ * non-fee-on-transfer ERC20 (USDC on Base). Accounting credits the requested
+ * amount on deposit; a fee-on-transfer token would break that invariant.
+ *
+ * There is deliberately no rescue/sweep function: the contract is trustless and
+ * only pays out via {withdraw}. Tokens transferred in directly (bypassing
+ * {stake}) are therefore unrecoverable.
+ *
+ * @author BuidlGuidl
+ */
+contract Staker {
+    using SafeERC20 for IERC20;
+
+    /// The staked token (USDC, 6 decimals on Base).
+    IERC20 public immutable usdc;
+
+    /// Staked balance per user, denominated in USDC's smallest unit.
+    mapping(address => uint256) public stakedBalance;
+
+    /// Total USDC held on behalf of all stakers.
+    uint256 public totalStaked;
+
+    event Staked(address indexed user, uint256 amount);
+    event Withdrawn(address indexed user, uint256 amount);
+
+    error ZeroAmount();
+    error NothingStaked();
+    error ZeroAddress();
+
+    constructor(IERC20 _usdc) {
+        if (address(_usdc) == address(0)) revert ZeroAddress();
+        usdc = _usdc;
+    }
+
+    /**
+     * Deposit `amount` of USDC into the vault. Caller must approve this contract
+     * for at least `amount` beforehand.
+     */
+    function stake(uint256 amount) external {
+        if (amount == 0) revert ZeroAmount();
+
+        // Effects before interaction (checks-effects-interactions).
+        stakedBalance[msg.sender] += amount;
+        totalStaked += amount;
+
+        usdc.safeTransferFrom(msg.sender, address(this), amount);
+
+        emit Staked(msg.sender, amount);
+    }
+
+    /// Withdraw the caller's entire staked position back to their wallet.
+    function withdraw() external {
+        uint256 amount = stakedBalance[msg.sender];
+        if (amount == 0) revert NothingStaked();
+
+        stakedBalance[msg.sender] = 0;
+        totalStaked -= amount;
+
+        usdc.safeTransfer(msg.sender, amount);
+
+        emit Withdrawn(msg.sender, amount);
+    }
+}
diff --git a/packages/hardhat/deploy/00_deploy_staker.ts b/packages/hardhat/deploy/00_deploy_staker.ts
new file mode 100644
index 0000000..b0a69eb
--- /dev/null
+++ b/packages/hardhat/deploy/00_deploy_staker.ts
@@ -0,0 +1,59 @@
+import { deployScript, artifacts } from "../rocketh/deploy.js";
+
+/**
+ * Canonical USDC addresses per chain. On these networks the Staker points at the
+ * real token; on any other (local) network a faithful mock is deployed instead.
+ *
+ * Sources: https://developers.circle.com/stablecoins/usdc-on-main-networks
+ */
+const USDC_BY_CHAIN: Record<number, `0x${string}`> = {
+  8453: "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913", // Base mainnet
+  84532: "0x036CbD53842c5426634e7929541eC2318f3dCF7e", // Base Sepolia
+};
+
+// 1,000,000 USDC (6 decimals) seeded to the deployer on local networks.
+const LOCAL_MINT_AMOUNT = 1_000_000_000_000n;
+
+/**
+ * Deploys the Staker contract wired to USDC.
+ *
+ * - Known networks (Base / Base Sepolia): reuse the real USDC token.
+ * - Local / unknown networks: deploy MockUSDC and seed the deployer so the app
+ *   is immediately usable end-to-end.
+ */
+export default deployScript(
+  async env => {
+    const { deployer } = env.namedAccounts;
+    const chainId = env.network.chain.id;
+
+    let usdcAddress = USDC_BY_CHAIN[chainId];
+
+    if (!usdcAddress) {
+      const mockUsdc = await env.deploy("USDC", {
+        account: deployer,
+        artifact: artifacts.MockUSDC,
+        args: [],
+      });
+      usdcAddress = mockUsdc.address;
+
+      await env.execute(mockUsdc, {
+        functionName: "mint",
+        args: [deployer, LOCAL_MINT_AMOUNT],
+        account: deployer,
+      });
+
+      console.log("🪙 Deployed MockUSDC and seeded deployer at", usdcAddress);
+    } else {
+      console.log("🪙 Using real USDC at", usdcAddress);
+    }
+
+    await env.deploy("Staker", {
+      account: deployer,
+      artifact: artifacts.Staker,
+      args: [usdcAddress],
+    });
+  },
+  {
+    tags: ["Staker"],
+  },
+);
diff --git a/packages/hardhat/test/Staker.ts b/packages/hardhat/test/Staker.ts
new file mode 100644
index 0000000..28a3be7
--- /dev/null
+++ b/packages/hardhat/test/Staker.ts
@@ -0,0 +1,118 @@
+import { expect } from "chai";
+import { network } from "hardhat";
+import { loadAndExecuteDeploymentsFromFiles } from "../rocketh/environment.js";
+
+const { provider, networkHelpers, ethers } = await network.create();
+
+// 100 USDC (6 decimals).
+const ONE_HUNDRED = 100_000_000n;
+
+async function deployFixture() {
+  const env = await loadAndExecuteDeploymentsFromFiles({ provider });
+
+  // Deployment names ("Staker" / "USDC") come from the deploy script; the mock's
+  // contract type is MockUSDC.
+  const staker = env.get("Staker");
+  const usdc = env.get("USDC");
+
+  const stakerContract = await ethers.getContractAt("Staker", staker.address);
+  const usdcContract = await ethers.getContractAt("MockUSDC", usdc.address);
+
+  const [deployer, alice, bob] = await ethers.getSigners();
+
+  // Fund the test users from the freely-mintable mock.
+  await usdcContract.mint(alice.address, ONE_HUNDRED);
+  await usdcContract.mint(bob.address, ONE_HUNDRED);
+
+  return { stakerContract, usdcContract, deployer, alice, bob };
+}
+
+describe("Staker", function () {
+  describe("Deployment", function () {
+    it("points at the USDC token and starts empty", async function () {
+      const { stakerContract, usdcContract } = await networkHelpers.loadFixture(deployFixture);
+      expect(await stakerContract.usdc()).to.equal(ethers.getAddress(await usdcContract.getAddress()));
+      expect(await stakerContract.totalStaked()).to.equal(0n);
+    });
+
+    it("rejects a zero-address token", async function () {
+      await networkHelpers.loadFixture(deployFixture);
+      const stakerFactory = await ethers.getContractFactory("Staker");
+      await expect(stakerFactory.deploy(ethers.ZeroAddress)).to.be.revertedWithCustomError(
+        stakerFactory,
+        "ZeroAddress",
+      );
+    });
+  });
+
+  describe("Staking", function () {
+    it("accepts a deposit and records the position", async function () {
+      const { stakerContract, usdcContract, alice } = await networkHelpers.loadFixture(deployFixture);
+      const stakerAddress = await stakerContract.getAddress();
+
+      await usdcContract.connect(alice).approve(stakerAddress, ONE_HUNDRED);
+      await expect(stakerContract.connect(alice).stake(ONE_HUNDRED))
+        .to.emit(stakerContract, "Staked")
+        .withArgs(alice.address, ONE_HUNDRED);
+
+      expect(await stakerContract.stakedBalance(alice.address)).to.equal(ONE_HUNDRED);
+      expect(await stakerContract.totalStaked()).to.equal(ONE_HUNDRED);
+      expect(await usdcContract.balanceOf(stakerAddress)).to.equal(ONE_HUNDRED);
+      expect(await usdcContract.balanceOf(alice.address)).to.equal(0n);
+    });
+
+    it("reverts on a zero deposit", async function () {
+      const { stakerContract, alice } = await networkHelpers.loadFixture(deployFixture);
+      await expect(stakerContract.connect(alice).stake(0n)).to.be.revertedWithCustomError(stakerContract, "ZeroAmount");
+    });
+
+    it("reverts without sufficient allowance", async function () {
+      const { stakerContract, usdcContract, alice } = await networkHelpers.loadFixture(deployFixture);
+      await expect(stakerContract.connect(alice).stake(ONE_HUNDRED)).to.be.revertedWithCustomError(
+        usdcContract,
+        "ERC20InsufficientAllowance",
+      );
+    });
+
+    it("keeps positions isolated between users", async function () {
+      const { stakerContract, usdcContract, alice, bob } = await networkHelpers.loadFixture(deployFixture);
+      const stakerAddress = await stakerContract.getAddress();
+
+      await usdcContract.connect(alice).approve(stakerAddress, ONE_HUNDRED);
+      await stakerContract.connect(alice).stake(ONE_HUNDRED);
+      await usdcContract.connect(bob).approve(stakerAddress, ONE_HUNDRED / 2n);
+      await stakerContract.connect(bob).stake(ONE_HUNDRED / 2n);
+
+      expect(await stakerContract.stakedBalance(alice.address)).to.equal(ONE_HUNDRED);
+      expect(await stakerContract.stakedBalance(bob.address)).to.equal(ONE_HUNDRED / 2n);
+      expect(await stakerContract.totalStaked()).to.equal(ONE_HUNDRED + ONE_HUNDRED / 2n);
+    });
+  });
+
+  describe("Withdrawing", function () {
+    it("returns the full position and clears it", async function () {
+      const { stakerContract, usdcContract, alice } = await networkHelpers.loadFixture(deployFixture);
+      const stakerAddress = await stakerContract.getAddress();
+
+      await usdcContract.connect(alice).approve(stakerAddress, ONE_HUNDRED);
+      await stakerContract.connect(alice).stake(ONE_HUNDRED);
+
+      await expect(stakerContract.connect(alice).withdraw())
+        .to.emit(stakerContract, "Withdrawn")
+        .withArgs(alice.address, ONE_HUNDRED);
+
+      expect(await stakerContract.stakedBalance(alice.address)).to.equal(0n);
+      expect(await stakerContract.totalStaked()).to.equal(0n);
+      expect(await usdcContract.balanceOf(alice.address)).to.equal(ONE_HUNDRED);
+      expect(await usdcContract.balanceOf(stakerAddress)).to.equal(0n);
+    });
+
+    it("reverts when there is nothing staked", async function () {
+      const { stakerContract, alice } = await networkHelpers.loadFixture(deployFixture);
+      await expect(stakerContract.connect(alice).withdraw()).to.be.revertedWithCustomError(
+        stakerContract,
+        "NothingStaked",
+      );
+    });
+  });
+});
diff --git a/packages/nextjs/app/stake/page.tsx b/packages/nextjs/app/stake/page.tsx
new file mode 100644
index 0000000..0e6710a
--- /dev/null
+++ b/packages/nextjs/app/stake/page.tsx
@@ -0,0 +1,245 @@
+"use client";
+
+import { useState } from "react";
+import { Address, Balance } from "@scaffold-ui/components";
+import type { NextPage } from "next";
+import { formatUnits, parseUnits } from "viem";
+import { useAccount } from "wagmi";
+import { ArrowDownTrayIcon, ArrowUpTrayIcon, BanknotesIcon } from "@heroicons/react/24/outline";
+import {
+  useDeployedContractInfo,
+  useScaffoldReadContract,
+  useScaffoldWriteContract,
+  useTargetNetwork,
+} from "~~/hooks/scaffold-eth";
+
+type PendingAction = "approve" | "stake" | "withdraw" | null;
+
+const Stake: NextPage = () => {
+  const { address: connectedAddress } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+
+  const [amount, setAmount] = useState("");
+  const [pending, setPending] = useState<PendingAction>(null);
+
+  const { data: stakerInfo, isLoading: isLoadingStaker } = useDeployedContractInfo({ contractName: "Staker" });
+  const stakerAddress = stakerInfo?.address;
+
+  const { data: usdcDecimals } = useScaffoldReadContract({ contractName: "USDC", functionName: "decimals" });
+  const { data: usdcSymbol } = useScaffoldReadContract({ contractName: "USDC", functionName: "symbol" });
+  const { data: walletBalance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "balanceOf",
+    args: [connectedAddress],
+  });
+  const { data: allowance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "allowance",
+    args: [connectedAddress, stakerAddress],
+  });
+  const { data: stakedBalance } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "stakedBalance",
+    args: [connectedAddress],
+  });
+
+  const { writeContractAsync: writeUsdc } = useScaffoldWriteContract({ contractName: "USDC" });
+  const { writeContractAsync: writeStaker } = useScaffoldWriteContract({ contractName: "Staker" });
+
+  const decimals = usdcDecimals ?? 6;
+  const symbol = usdcSymbol ?? "USDC";
+
+  const parseAmount = () => {
+    if (!amount) return 0n;
+    try {
+      return parseUnits(amount, decimals);
+    } catch {
+      return 0n;
+    }
+  };
+  const parsedAmount = parseAmount();
+
+  const format = (value?: bigint) =>
+    value === undefined
+      ? "…"
+      : Number(formatUnits(value, decimals)).toLocaleString("en-US", { maximumFractionDigits: decimals });
+
+  const hasStake = (stakedBalance ?? 0n) > 0n;
+  const exceedsBalance = walletBalance !== undefined && parsedAmount > walletBalance;
+  // Until the allowance read resolves, treat it as insufficient so we never show
+  // "Stake" (and let a user fire a tx that reverts) before approval is known.
+  const needsApproval = parsedAmount > 0n && (allowance === undefined || allowance < parsedAmount);
+  const isBusy = pending !== null;
+
+  const handleApprove = async () => {
+    if (!stakerAddress || parsedAmount === 0n) return;
+    try {
+      setPending("approve");
+      await writeUsdc({ functionName: "approve", args: [stakerAddress, parsedAmount] });
+    } catch {
+      // Error surfaced by the transactor notification.
+    } finally {
+      setPending(null);
+    }
+  };
+
+  const handleStake = async () => {
+    if (parsedAmount === 0n) return;
+    try {
+      setPending("stake");
+      await writeStaker({ functionName: "stake", args: [parsedAmount] });
+      setAmount("");
+    } catch {
+      // Error surfaced by the transactor notification.
+    } finally {
+      setPending(null);
+    }
+  };
+
+  const handleWithdraw = async () => {
+    try {
+      setPending("withdraw");
+      await writeStaker({ functionName: "withdraw" });
+    } catch {
+      // Error surfaced by the transactor notification.
+    } finally {
+      setPending(null);
+    }
+  };
+
+  if (!connectedAddress) {
+    return (
+      <div className="flex flex-col items-center grow pt-20 px-4">
+        <BanknotesIcon className="h-16 w-16 text-primary" />
+        <h1 className="text-3xl font-bold mt-4">Stake USDC</h1>
+        <p className="text-base-content/70 mt-2">Connect your wallet to stake USDC.</p>
+      </div>
+    );
+  }
+
+  const stakerMissing = !stakerAddress && !isLoadingStaker;
+
+  return (
+    <div className="flex flex-col items-center grow py-10 px-4">
+      <div className="w-full max-w-xl flex flex-col gap-6">
+        <div className="text-center">
+          <h1 className="text-3xl font-bold flex items-center justify-center gap-2">
+            <BanknotesIcon className="h-8 w-8" />
+            Stake USDC
+          </h1>
+          <p className="text-base-content/70 mt-1">Deposit USDC and withdraw your full position any time.</p>
+        </div>
+
+        {stakerMissing && (
+          <div className="alert alert-warning">
+            <span>Staker is not deployed on {targetNetwork.name}. Switch networks or deploy the contract.</span>
+          </div>
+        )}
+
+        {/* Balances overview */}
+        <div className="stats stats-vertical sm:stats-horizontal shadow bg-base-100 w-full">
+          <div className="stat">
+            <div className="stat-title">Wallet {symbol}</div>
+            <div className="stat-value text-2xl">{format(walletBalance)}</div>
+          </div>
+          <div className="stat">
+            <div className="stat-title">Staked</div>
+            <div className="stat-value text-2xl text-primary">{format(stakedBalance)}</div>
+          </div>
+          <div className="stat">
+            <div className="stat-title">ETH (for gas)</div>
+            <div className="stat-value text-2xl">
+              <Balance address={connectedAddress} chain={targetNetwork} />
+            </div>
+          </div>
+        </div>
+
+        {/* Stake */}
+        <div className="card bg-base-100 shadow-xl">
+          <div className="card-body gap-4">
+            <h2 className="card-title">Stake</h2>
+            <div className="join w-full">
+              <input
+                type="text"
+                inputMode="decimal"
+                placeholder="0.0"
+                className="input input-bordered join-item w-full"
+                value={amount}
+                onChange={e => setAmount(e.target.value.replace(/[^0-9.]/g, ""))}
+                disabled={isBusy}
+              />
+              <button
+                type="button"
+                className="btn btn-ghost join-item"
+                onClick={() => walletBalance !== undefined && setAmount(formatUnits(walletBalance, decimals))}
+                disabled={isBusy || walletBalance === undefined}
+              >
+                Max
+              </button>
+            </div>
+
+            {exceedsBalance && <p className="text-error text-sm">Amount exceeds your wallet balance.</p>}
+
+            {needsApproval ? (
+              <button
+                className="btn btn-primary"
+                onClick={handleApprove}
+                disabled={isBusy || parsedAmount === 0n || exceedsBalance || !stakerAddress}
+              >
+                {pending === "approve" ? (
+                  <span className="loading loading-spinner loading-sm" />
+                ) : (
+                  <ArrowDownTrayIcon className="h-4 w-4" />
+                )}
+                Approve {symbol}
+              </button>
+            ) : (
+              <button
+                className="btn btn-primary"
+                onClick={handleStake}
+                disabled={isBusy || parsedAmount === 0n || exceedsBalance || !stakerAddress}
+              >
+                {pending === "stake" ? (
+                  <span className="loading loading-spinner loading-sm" />
+                ) : (
+                  <ArrowDownTrayIcon className="h-4 w-4" />
+                )}
+                Stake
+              </button>
+            )}
+          </div>
+        </div>
+
+        {/* Withdraw */}
+        <div className="card bg-base-100 shadow-xl">
+          <div className="card-body gap-4">
+            <h2 className="card-title">Withdraw</h2>
+            <p className="text-base-content/70">
+              Your staked position: <span className="font-bold text-base-content">{format(stakedBalance)}</span>{" "}
+              {symbol}
+            </p>
+            <button className="btn btn-secondary" onClick={handleWithdraw} disabled={isBusy || !hasStake}>
+              {pending === "withdraw" ? (
+                <span className="loading loading-spinner loading-sm" />
+              ) : (
+                <ArrowUpTrayIcon className="h-4 w-4" />
+              )}
+              Withdraw all
+            </button>
+          </div>
+        </div>
+
+        {stakerAddress && (
+          <div className="flex flex-col sm:flex-row sm:justify-between gap-2 text-sm text-base-content/60">
+            <div className="flex items-center gap-2">
+              <span>Staker:</span>
+              <Address address={stakerAddress} chain={targetNetwork} size="xs" />
+            </div>
+          </div>
+        )}
+      </div>
+    </div>
+  );
+};
+
+export default Stake;
