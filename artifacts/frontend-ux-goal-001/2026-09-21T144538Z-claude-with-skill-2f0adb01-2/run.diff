@@ -0,0 +1,41 @@
+import { deployScript, artifacts } from "../rocketh/deploy.js";
+
+const HARDHAT_CHAIN_ID = 31337;
+
+// Canonical (Circle-issued) USDC per live chain. Staker refuses to deploy anywhere not listed here.
+const USDC_ADDRESSES: Record<number, `0x${string}`> = {
+  8453: "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913", // Base
+  84532: "0x036CbD53842c5426634e7929541eC2318f3dCF7e", // Base Sepolia, for a pre-launch dry run
+};
+
+/**
+ * Deploys Staker against real USDC on live networks, or against a freshly deployed MockUSDC locally.
+ * Locally the mock is saved as "USDC" so the frontend uses the same contract name on every chain.
+ */
+export default deployScript(
+  async env => {
+    const { deployer } = env.namedAccounts;
+    const chainId = env.network.chain.id;
+
+    let usdcAddress = USDC_ADDRESSES[chainId];
+    if (chainId === HARDHAT_CHAIN_ID) {
+      const mockUsdc = await env.deploy("USDC", {
+        account: deployer,
+        artifact: artifacts.MockUSDC,
+        args: [],
+      });
+      usdcAddress = mockUsdc.address;
+    }
+    if (!usdcAddress) throw new Error(`No USDC address configured for chain ${chainId}`);
+
+    const staker = await env.deploy("Staker", {
+      account: deployer,
+      artifact: artifacts.Staker,
+      args: [usdcAddress],
+    });
+    console.log(`🏦 Staker deployed at ${staker.address} (USDC: ${usdcAddress})`);
+  },
+  {
+    tags: ["Staker"],
+  },
+);
