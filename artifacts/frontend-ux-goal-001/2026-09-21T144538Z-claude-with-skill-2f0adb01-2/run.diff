@@ -0,0 +1,353 @@
+"use client";
+
+import { useEffect, useState } from "react";
+import { useConnectModal } from "@rainbow-me/rainbowkit";
+import { useFetchNativeCurrencyPrice, useWatchBalance } from "@scaffold-ui/hooks";
+import { formatUnits, parseEther, parseUnits } from "viem";
+import { useAccount, useSwitchChain } from "wagmi";
+import { isUserRejection, parseTxError } from "~~/app/stake/_components/parseTxError";
+import {
+  useDeployedContractInfo,
+  useScaffoldReadContract,
+  useScaffoldWriteContract,
+  useTargetNetwork,
+} from "~~/hooks/scaffold-eth";
+
+const USDC_DECIMALS = 6;
+const AMOUNT_REGEX = new RegExp(`^\\d*\\.?\\d{0,${USDC_DECIMALS}}$`);
+// RPC nodes behind a load balancer can lag the one that confirmed the approval; poll until the new allowance shows up
+const ALLOWANCE_POLL_ATTEMPTS = 10;
+const ALLOWANCE_POLL_INTERVAL_MS = 1000;
+// Below this, the wallet likely can't pay for even one more transaction
+const LOW_GAS_THRESHOLD = parseEther("0.00002");
+
+const usdFormatter = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" });
+const usdcFormatter = new Intl.NumberFormat("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 6 });
+const ethFormatter = new Intl.NumberFormat("en-US", { maximumFractionDigits: 6 });
+
+// USDC is redeemable 1:1 for USD, so its dollar value is the token amount
+const formatUsdc = (amount: bigint) => `${usdcFormatter.format(Number(formatUnits(amount, USDC_DECIMALS)))} USDC`;
+const formatUsdcAsUsd = (amount: bigint) => `~${usdFormatter.format(Number(formatUnits(amount, USDC_DECIMALS)))}`;
+
+const parseAmount = (value: string) => {
+  if (value === "" || value === "." || !AMOUNT_REGEX.test(value)) return undefined;
+  return parseUnits(value, USDC_DECIMALS);
+};
+
+const sleep = (ms: number) => new Promise(resolve => setTimeout(resolve, ms));
+
+const Spinner = () => <span className="loading loading-spinner loading-sm" />;
+
+const StatCard = ({ title, value, usd }: { title: string; value?: string; usd?: string }) => (
+  <div className="card bg-base-100 shadow-md">
+    <div className="card-body p-5 gap-1">
+      <span className="text-sm opacity-70">{title}</span>
+      {value === undefined ? (
+        <span className="skeleton h-7 w-32" />
+      ) : (
+        <span className="text-xl font-semibold break-all">{value}</span>
+      )}
+      <span className="text-sm opacity-70 min-h-5">{usd}</span>
+    </div>
+  </div>
+);
+
+export const StakeDashboard = () => {
+  const { address, chain, isConnected } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+  const { openConnectModal } = useConnectModal();
+  const { switchChain, isPending: isSwitching } = useSwitchChain();
+  const isWrongNetwork = isConnected && chain?.id !== targetNetwork.id;
+
+  const { data: stakerInfo, isLoading: isStakerInfoLoading } = useDeployedContractInfo({ contractName: "Staker" });
+  const stakerAddress = stakerInfo?.address;
+
+  const { data: usdcBalance, refetch: refetchUsdcBalance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "balanceOf",
+    args: [address],
+    query: { enabled: Boolean(address) },
+  });
+  const {
+    data: allowance,
+    isError: isAllowanceError,
+    refetch: refetchAllowance,
+  } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "allowance",
+    args: [address, stakerAddress],
+    query: { enabled: Boolean(address && stakerAddress) },
+  });
+  const { data: stakedBalance, refetch: refetchStakedBalance } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "stakedBalance",
+    args: [address],
+    query: { enabled: Boolean(address) },
+  });
+  const { data: ethBalance } = useWatchBalance({ address, chain: targetNetwork });
+  const { price: ethPrice } = useFetchNativeCurrencyPrice();
+
+  const { writeContractAsync: writeUsdc } = useScaffoldWriteContract({ contractName: "USDC" });
+  const { writeContractAsync: writeStaker } = useScaffoldWriteContract({ contractName: "Staker" });
+
+  const [amountInput, setAmountInput] = useState("");
+  const [isApproving, setIsApproving] = useState(false);
+  const [approveCooldown, setApproveCooldown] = useState(false);
+  const [isStaking, setIsStaking] = useState(false);
+  const [isWithdrawing, setIsWithdrawing] = useState(false);
+  const [stakeError, setStakeError] = useState<string>();
+  const [withdrawError, setWithdrawError] = useState<string>();
+
+  const amount = parseAmount(amountInput);
+  const exceedsBalance = amount !== undefined && usdcBalance !== undefined && amount > usdcBalance;
+  const needsApproval = amount !== undefined && allowance !== undefined && allowance < amount;
+  const isLowOnGas = ethBalance !== undefined && ethBalance.value < LOW_GAS_THRESHOLD;
+  const isBusy = isApproving || approveCooldown || isStaking || isWithdrawing;
+
+  // Don't carry a half-typed amount or an old error over to a different account or network
+  useEffect(() => {
+    setAmountInput("");
+    setStakeError(undefined);
+    setWithdrawError(undefined);
+  }, [address, chain?.id]);
+
+  const handleAmountChange = (value: string) => {
+    const normalized = value.replace(",", ".").trim();
+    // Silently refuse characters or precision USDC can't represent
+    if (normalized !== "" && !AMOUNT_REGEX.test(normalized)) return;
+    setAmountInput(normalized);
+    setStakeError(undefined);
+  };
+
+  const handleApprove = async () => {
+    if (!amount || !stakerAddress) return;
+    setIsApproving(true);
+    setStakeError(undefined);
+    try {
+      // Exact-amount approval: never leave an open-ended allowance on a user's USDC
+      const txHash = await writeUsdc({ functionName: "approve", args: [stakerAddress, amount] });
+      if (!txHash) return;
+      setApproveCooldown(true);
+      for (let attempt = 0; attempt < ALLOWANCE_POLL_ATTEMPTS; attempt++) {
+        const { data: freshAllowance } = await refetchAllowance();
+        if (freshAllowance !== undefined && freshAllowance >= amount) break;
+        await sleep(ALLOWANCE_POLL_INTERVAL_MS);
+      }
+    } catch (e) {
+      if (!isUserRejection(e)) setStakeError(parseTxError(e));
+    } finally {
+      setIsApproving(false);
+      setApproveCooldown(false);
+    }
+  };
+
+  const handleStake = async () => {
+    if (!amount) return;
+    setIsStaking(true);
+    setStakeError(undefined);
+    try {
+      const txHash = await writeStaker({ functionName: "stake", args: [amount] });
+      if (!txHash) return;
+      setAmountInput("");
+      await Promise.all([refetchUsdcBalance(), refetchStakedBalance(), refetchAllowance()]);
+    } catch (e) {
+      if (!isUserRejection(e)) setStakeError(parseTxError(e));
+    } finally {
+      setIsStaking(false);
+    }
+  };
+
+  const handleWithdraw = async () => {
+    setIsWithdrawing(true);
+    setWithdrawError(undefined);
+    try {
+      const txHash = await writeStaker({ functionName: "withdraw" });
+      if (!txHash) return;
+      await Promise.all([refetchUsdcBalance(), refetchStakedBalance()]);
+    } catch (e) {
+      if (!isUserRejection(e)) setWithdrawError(parseTxError(e));
+    } finally {
+      setIsWithdrawing(false);
+    }
+  };
+
+  const renderPrimaryAction = () => {
+    if (!isConnected) {
+      return (
+        <button className="btn btn-primary w-full" onClick={openConnectModal}>
+          Connect Wallet
+        </button>
+      );
+    }
+    if (isWrongNetwork) {
+      return (
+        <button
+          className="btn btn-warning w-full"
+          disabled={isSwitching}
+          onClick={() => switchChain({ chainId: targetNetwork.id })}
+        >
+          {isSwitching && <Spinner />}
+          {isSwitching ? "Switching..." : `Switch to ${targetNetwork.name}`}
+        </button>
+      );
+    }
+    if (amount === undefined || amount === 0n) {
+      return (
+        <button className="btn btn-primary w-full" disabled>
+          Enter an amount
+        </button>
+      );
+    }
+    if (exceedsBalance) {
+      return (
+        <button className="btn btn-primary w-full" disabled>
+          Insufficient USDC balance
+        </button>
+      );
+    }
+    if (isAllowanceError) {
+      return (
+        <button className="btn btn-primary w-full" onClick={() => refetchAllowance()}>
+          Couldn&apos;t load approval status. Retry
+        </button>
+      );
+    }
+    if (allowance === undefined) {
+      return (
+        <button className="btn btn-primary w-full" disabled>
+          <Spinner />
+          Checking approval...
+        </button>
+      );
+    }
+    if (needsApproval || approveCooldown) {
+      return (
+        <button className="btn btn-primary w-full" disabled={isBusy} onClick={handleApprove}>
+          {(isApproving || approveCooldown) && <Spinner />}
+          {isApproving ? "Approving..." : approveCooldown ? "Confirming approval..." : `Approve ${formatUsdc(amount)}`}
+        </button>
+      );
+    }
+    return (
+      <button className="btn btn-primary w-full" disabled={isBusy} onClick={handleStake}>
+        {isStaking && <Spinner />}
+        {isStaking ? "Staking..." : `Stake ${formatUsdc(amount)}`}
+      </button>
+    );
+  };
+
+  if (!isStakerInfoLoading && !stakerInfo) {
+    return (
+      <div role="alert" className="alert alert-warning max-w-xl">
+        <span>Staking is not available on {targetNetwork.name} yet. Please check back soon.</span>
+      </div>
+    );
+  }
+
+  const canShowPosition = isConnected && !isWrongNetwork;
+  const hasPosition = stakedBalance !== undefined && stakedBalance > 0n;
+
+  return (
+    <div className="flex flex-col gap-6 w-full max-w-3xl">
+      {canShowPosition && (
+        <div className="grid grid-cols-1 sm:grid-cols-3 gap-4">
+          <StatCard
+            title="Wallet USDC"
+            value={usdcBalance === undefined ? undefined : formatUsdc(usdcBalance)}
+            usd={usdcBalance === undefined ? undefined : formatUsdcAsUsd(usdcBalance)}
+          />
+          <StatCard
+            title="Wallet ETH (for gas)"
+            value={ethBalance === undefined ? undefined : `${ethFormatter.format(Number(ethBalance.formatted))} ETH`}
+            usd={
+              ethBalance === undefined || !ethPrice
+                ? undefined
+                : `~${usdFormatter.format(Number(ethBalance.formatted) * ethPrice)}`
+            }
+          />
+          <StatCard
+            title="Staked"
+            value={stakedBalance === undefined ? undefined : formatUsdc(stakedBalance)}
+            usd={stakedBalance === undefined ? undefined : formatUsdcAsUsd(stakedBalance)}
+          />
+        </div>
+      )}
+
+      {canShowPosition && isLowOnGas && (
+        <div role="alert" className="alert alert-warning">
+          <span>
+            You&apos;re low on ETH on {targetNetwork.name}. Every transaction needs a small amount of ETH for gas — add
+            some before staking or withdrawing.
+          </span>
+        </div>
+      )}
+
+      <div className="card bg-base-100 shadow-md">
+        <div className="card-body gap-4">
+          <h2 className="card-title">Stake USDC</h2>
+          <label className="form-control w-full">
+            <div className="join w-full">
+              <input
+                type="text"
+                inputMode="decimal"
+                autoComplete="off"
+                placeholder="0.00"
+                aria-label="Amount of USDC to stake"
+                className={`input input-bordered join-item w-full text-lg ${exceedsBalance ? "input-error" : ""}`}
+                value={amountInput}
+                disabled={isBusy}
+                onChange={e => handleAmountChange(e.target.value)}
+              />
+              <button
+                className="btn join-item"
+                disabled={isBusy || !usdcBalance}
+                onClick={() => usdcBalance && handleAmountChange(formatUnits(usdcBalance, USDC_DECIMALS))}
+              >
+                Max
+              </button>
+            </div>
+            <div className="flex justify-between text-sm opacity-70 mt-1 px-1">
+              <span>{amount ? formatUsdcAsUsd(amount) : " "}</span>
+              {usdcBalance !== undefined && canShowPosition && <span>Available: {formatUsdc(usdcBalance)}</span>}
+            </div>
+          </label>
+
+          {renderPrimaryAction()}
+
+          {needsApproval && !approveCooldown && isConnected && !isWrongNetwork && !exceedsBalance && (
+            <p className="text-sm opacity-70 m-0">
+              Step 1 of 2: approve the staking contract to move exactly this amount of your USDC. Then stake.
+            </p>
+          )}
+          {stakeError && (
+            <div role="alert" className="alert alert-error text-sm">
+              <span>{stakeError}</span>
+            </div>
+          )}
+        </div>
+      </div>
+
+      {canShowPosition && (
+        <div className="card bg-base-100 shadow-md">
+          <div className="card-body gap-4">
+            <h2 className="card-title">Withdraw</h2>
+            <p className="m-0 opacity-80">
+              {hasPosition
+                ? `Withdraw your full position of ${formatUsdc(stakedBalance)} (${formatUsdcAsUsd(stakedBalance)}) back to your wallet.`
+                : "You have no USDC staked."}
+            </p>
+            <button className="btn btn-secondary w-full" disabled={!hasPosition || isBusy} onClick={handleWithdraw}>
+              {isWithdrawing && <Spinner />}
+              {isWithdrawing ? "Withdrawing..." : "Withdraw all"}
+            </button>
+            {withdrawError && (
+              <div role="alert" className="alert alert-error text-sm">
+                <span>{withdrawError}</span>
+              </div>
+            )}
+          </div>
+        </div>
+      )}
+    </div>
+  );
+};
diff --git a/packages/nextjs/app/stake/_components/parseTxError.ts b/packages/nextjs/app/stake/_components/parseTxError.ts
new file mode 100644
index 0000000..c4291a0
--- /dev/null
+++ b/packages/nextjs/app/stake/_components/parseTxError.ts
@@ -0,0 +1,80 @@
+import {
+  BaseError,
+  ContractFunctionRevertedError,
+  InsufficientFundsError,
+  UserRejectedRequestError,
+  decodeErrorResult,
+} from "viem";
+
+// Staker custom errors + OpenZeppelin ERC20 errors (thrown by the local MockUSDC)
+const CUSTOM_ERROR_MESSAGES: Record<string, string> = {
+  ZeroAmount: "Enter an amount greater than zero.",
+  NothingStaked: "You have nothing staked to withdraw.",
+  SafeERC20FailedOperation: "The USDC contract rejected this transfer.",
+  ERC20InsufficientBalance: "Your USDC balance is too low for this amount.",
+  ERC20InsufficientAllowance: "USDC approval is too low. Approve the amount again, then stake.",
+};
+
+// Revert strings used by Circle's FiatToken (real USDC on Base)
+const REVERT_REASON_MESSAGES: [string, string][] = [
+  ["transfer amount exceeds balance", "Your USDC balance is too low for this amount."],
+  ["transfer amount exceeds allowance", "USDC approval is too low. Approve the amount again, then stake."],
+  ["blacklisted", "This address is restricted by the USDC issuer and cannot move USDC."],
+  ["paused", "USDC transfers are currently paused by the issuer. Please try again later."],
+];
+
+const OZ_ERC20_ERRORS_ABI = [
+  {
+    type: "error",
+    name: "ERC20InsufficientBalance",
+    inputs: [
+      { name: "sender", type: "address" },
+      { name: "balance", type: "uint256" },
+      { name: "needed", type: "uint256" },
+    ],
+  },
+  {
+    type: "error",
+    name: "ERC20InsufficientAllowance",
+    inputs: [
+      { name: "spender", type: "address" },
+      { name: "allowance", type: "uint256" },
+      { name: "needed", type: "uint256" },
+    ],
+  },
+] as const;
+
+const FALLBACK_MESSAGE = "Transaction failed. Please try again.";
+
+export const isUserRejection = (error: unknown) =>
+  error instanceof BaseError && Boolean(error.walk(e => e instanceof UserRejectedRequestError));
+
+/** Turns wallet / RPC / contract errors into a sentence a user can act on. */
+export const parseTxError = (error: unknown): string => {
+  if (!(error instanceof BaseError)) return FALLBACK_MESSAGE;
+
+  if (isUserRejection(error)) return "You rejected the transaction in your wallet.";
+  if (error.walk(e => e instanceof InsufficientFundsError)) {
+    return "Not enough ETH to pay for gas. Add a little ETH and try again.";
+  }
+
+  const revert = error.walk(e => e instanceof ContractFunctionRevertedError);
+  if (revert instanceof ContractFunctionRevertedError) {
+    let errorName = revert.data?.errorName;
+    // Errors bubbled up from the token aren't in the Staker ABI, so decode them separately
+    if (!errorName && revert.raw) {
+      try {
+        errorName = decodeErrorResult({ abi: OZ_ERC20_ERRORS_ABI, data: revert.raw }).errorName;
+      } catch {
+        // unknown selector, fall through
+      }
+    }
+    if (errorName && CUSTOM_ERROR_MESSAGES[errorName]) return CUSTOM_ERROR_MESSAGES[errorName];
+
+    const reason = revert.reason?.toLowerCase();
+    const match = reason && REVERT_REASON_MESSAGES.find(([needle]) => reason.includes(needle));
+    if (match) return match[1];
+  }
+
+  return FALLBACK_MESSAGE;
+};
