@@ -0,0 +1,236 @@
+"use client";
+
+import { useMemo, useState } from "react";
+import type { NextPage } from "next";
+import { erc20Abi, formatUnits, parseUnits } from "viem";
+import { useAccount, useReadContract, useWriteContract } from "wagmi";
+import { Balance } from "@scaffold-ui/components";
+import {
+  useDeployedContractInfo,
+  useScaffoldReadContract,
+  useScaffoldWriteContract,
+  useTargetNetwork,
+  useTransactor,
+} from "~~/hooks/scaffold-eth";
+
+const DEFAULT_DECIMALS = 6; // USDC
+
+// Safely turn a human-typed amount into base units; returns 0n on invalid input.
+const parseAmount = (value: string, decimals: number) => {
+  try {
+    return parseUnits(value || "0", decimals);
+  } catch {
+    return 0n;
+  }
+};
+
+const Stake: NextPage = () => {
+  const { address: connectedAddress, isConnected } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+
+  const [amount, setAmount] = useState("");
+  const [isApproving, setIsApproving] = useState(false);
+
+  const writeTx = useTransactor();
+  const { writeContractAsync: writeErc20 } = useWriteContract();
+
+  const { data: stakerInfo } = useDeployedContractInfo({ contractName: "Staker" });
+  const stakerAddress = stakerInfo?.address;
+
+  // USDC address comes from the vault itself, so this page works against the
+  // real token on Base and the mock token locally without any config changes.
+  const { data: tokenAddress } = useScaffoldReadContract({ contractName: "Staker", functionName: "token" });
+
+  const { data: stakedBalance, refetch: refetchStaked } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "balanceOf",
+    args: [connectedAddress],
+  });
+
+  const erc20Enabled = Boolean(tokenAddress && connectedAddress);
+
+  const { data: decimals } = useReadContract({
+    address: tokenAddress,
+    abi: erc20Abi,
+    functionName: "decimals",
+    query: { enabled: Boolean(tokenAddress) },
+  });
+
+  const { data: walletBalance, refetch: refetchWallet } = useReadContract({
+    address: tokenAddress,
+    abi: erc20Abi,
+    functionName: "balanceOf",
+    args: connectedAddress ? [connectedAddress] : undefined,
+    query: { enabled: erc20Enabled },
+  });
+
+  const { data: allowance, refetch: refetchAllowance } = useReadContract({
+    address: tokenAddress,
+    abi: erc20Abi,
+    functionName: "allowance",
+    args: connectedAddress && stakerAddress ? [connectedAddress, stakerAddress] : undefined,
+    query: { enabled: erc20Enabled && Boolean(stakerAddress) },
+  });
+
+  const { writeContractAsync: writeStake, isMining: isStaking } = useScaffoldWriteContract({ contractName: "Staker" });
+  const { writeContractAsync: writeWithdraw, isMining: isWithdrawing } = useScaffoldWriteContract({
+    contractName: "Staker",
+  });
+
+  const tokenDecimals = decimals ?? DEFAULT_DECIMALS;
+  const parsedAmount = useMemo(() => parseAmount(amount, tokenDecimals), [amount, tokenDecimals]);
+
+  const allowanceLoaded = allowance !== undefined;
+  const needsApproval = allowanceLoaded && parsedAmount > 0n && parsedAmount > allowance;
+  const exceedsBalance = walletBalance !== undefined && parsedAmount > walletBalance;
+  const canStake = parsedAmount > 0n && !exceedsBalance;
+
+  const refetchAll = () => {
+    refetchStaked();
+    refetchWallet();
+    refetchAllowance();
+  };
+
+  const setMax = () => {
+    if (walletBalance !== undefined) setAmount(formatUnits(walletBalance, tokenDecimals));
+  };
+
+  const handleApprove = async () => {
+    if (!tokenAddress || !stakerAddress) return;
+    try {
+      setIsApproving(true);
+      await writeTx(() =>
+        writeErc20({
+          address: tokenAddress,
+          abi: erc20Abi,
+          functionName: "approve",
+          args: [stakerAddress, parsedAmount],
+        }),
+      );
+      await refetchAllowance();
+    } catch {
+      // useTransactor already surfaces the error via a notification.
+    } finally {
+      setIsApproving(false);
+    }
+  };
+
+  const handleStake = async () => {
+    if (!canStake) return;
+    try {
+      await writeStake({ functionName: "stake", args: [parsedAmount] });
+      setAmount("");
+      refetchAll();
+    } catch {
+      // handled by the hook
+    }
+  };
+
+  const handleWithdraw = async () => {
+    try {
+      await writeWithdraw({ functionName: "withdraw" });
+      refetchAll();
+    } catch {
+      // handled by the hook
+    }
+  };
+
+  const format = (value: bigint | undefined) =>
+    value === undefined ? "…" : Number(formatUnits(value, tokenDecimals)).toLocaleString(undefined, {
+      maximumFractionDigits: 6,
+    });
+
+  const hasStake = stakedBalance !== undefined && stakedBalance > 0n;
+
+  return (
+    <div className="flex flex-col items-center grow w-full px-4 py-10">
+      <div className="w-full max-w-lg">
+        <h1 className="text-center mb-2">
+          <span className="block text-3xl font-bold">USDC Staking</span>
+          <span className="block text-base mt-1 opacity-70">Deposit USDC and withdraw your full position anytime.</span>
+        </h1>
+
+        {!isConnected ? (
+          <div className="alert mt-8 justify-center">
+            <span>Connect your wallet to start staking.</span>
+          </div>
+        ) : (
+          <div className="flex flex-col gap-6 mt-6">
+            {/* Balances */}
+            <div className="card bg-base-100 shadow-md">
+              <div className="card-body gap-4">
+                <h2 className="card-title text-lg">Your balances</h2>
+                <div className="flex justify-between items-center">
+                  <span className="opacity-70">Wallet USDC</span>
+                  <span className="font-medium">{format(walletBalance)} USDC</span>
+                </div>
+                <div className="flex justify-between items-center">
+                  <span className="opacity-70">ETH (for gas)</span>
+                  <Balance address={connectedAddress} chain={targetNetwork} />
+                </div>
+                <div className="flex justify-between items-center">
+                  <span className="opacity-70">Staked</span>
+                  <span className="font-medium">{format(stakedBalance)} USDC</span>
+                </div>
+              </div>
+            </div>
+
+            {/* Stake */}
+            <div className="card bg-base-100 shadow-md">
+              <div className="card-body gap-4">
+                <h2 className="card-title text-lg">Stake</h2>
+                <div className="join w-full">
+                  <input
+                    type="text"
+                    inputMode="decimal"
+                    placeholder="0.0"
+                    className="input input-bordered join-item w-full"
+                    value={amount}
+                    onChange={e => setAmount(e.target.value)}
+                  />
+                  <span className="btn btn-ghost join-item no-animation pointer-events-none">USDC</span>
+                  <button type="button" className="btn btn-outline join-item" onClick={setMax}>
+                    Max
+                  </button>
+                </div>
+                {exceedsBalance && <span className="text-error text-sm">Amount exceeds your wallet balance.</span>}
+
+                {needsApproval ? (
+                  <button className="btn btn-primary" disabled={!canStake || isApproving} onClick={handleApprove}>
+                    {isApproving && <span className="loading loading-spinner loading-sm" />}
+                    Approve USDC
+                  </button>
+                ) : (
+                  <button
+                    className="btn btn-primary"
+                    disabled={!canStake || isStaking || !allowanceLoaded}
+                    onClick={handleStake}
+                  >
+                    {isStaking && <span className="loading loading-spinner loading-sm" />}
+                    Stake
+                  </button>
+                )}
+              </div>
+            </div>
+
+            {/* Withdraw */}
+            <div className="card bg-base-100 shadow-md">
+              <div className="card-body gap-4">
+                <h2 className="card-title text-lg">Withdraw</h2>
+                <p className="opacity-70 text-sm">
+                  Withdraw your entire staked position of {format(stakedBalance)} USDC.
+                </p>
+                <button className="btn btn-secondary" disabled={!hasStake || isWithdrawing} onClick={handleWithdraw}>
+                  {isWithdrawing && <span className="loading loading-spinner loading-sm" />}
+                  Withdraw all
+                </button>
+              </div>
+            </div>
+          </div>
+        )}
+      </div>
+    </div>
+  );
+};
+
+export default Stake;
