@@ -0,0 +1,91 @@
+import { expect } from "chai";
+import { network } from "hardhat";
+import type { Abi_Staker } from "../generated/abis/Staker.js";
+import type { Abi_MockUSDC } from "../generated/abis/MockUSDC.js";
+import { loadAndExecuteDeploymentsFromFiles } from "../rocketh/environment.js";
+
+const { provider, networkHelpers, ethers } = await network.create();
+
+const USDC = (whole: bigint) => whole * 10n ** 6n; // USDC has 6 decimals
+
+// Deploys via the real deploy scripts (MockUSDC + Staker) on a fresh network.
+async function deployFixture() {
+  const env = await loadAndExecuteDeploymentsFromFiles({ provider });
+  const stakerDeployment = env.get<Abi_Staker>("Staker");
+  const usdcDeployment = env.get<Abi_MockUSDC>("MockUSDC");
+  const staker = await ethers.getContractAt(stakerDeployment.abi, stakerDeployment.address);
+  const usdc = await ethers.getContractAt(usdcDeployment.abi, usdcDeployment.address);
+  return { staker, usdc, stakerAddress: stakerDeployment.address };
+}
+
+describe("Staker", function () {
+  it("points at the deployed USDC token", async function () {
+    const { staker, usdc } = await networkHelpers.loadFixture(deployFixture);
+    expect(await staker.token()).to.equal(await usdc.getAddress());
+  });
+
+  it("lets a user stake USDC and emits Staked", async function () {
+    const { staker, usdc, stakerAddress } = await networkHelpers.loadFixture(deployFixture);
+    const [deployer] = await ethers.getSigners();
+
+    await usdc.approve(stakerAddress, USDC(100n));
+    await expect(staker.stake(USDC(100n))).to.emit(staker, "Staked").withArgs(deployer.address, USDC(100n));
+
+    expect(await staker.balanceOf(deployer.address)).to.equal(USDC(100n));
+    expect(await staker.totalStaked()).to.equal(USDC(100n));
+    expect(await usdc.balanceOf(stakerAddress)).to.equal(USDC(100n));
+  });
+
+  it("keeps positions isolated between users", async function () {
+    const { staker, usdc, stakerAddress } = await networkHelpers.loadFixture(deployFixture);
+    const [deployer, user] = await ethers.getSigners();
+
+    // Fund a second user from the deployer's minted supply.
+    await usdc.transfer(user.address, USDC(50n));
+
+    await usdc.approve(stakerAddress, USDC(100n));
+    await staker.stake(USDC(100n));
+    await usdc.connect(user).approve(stakerAddress, USDC(50n));
+    await staker.connect(user).stake(USDC(50n));
+
+    expect(await staker.balanceOf(deployer.address)).to.equal(USDC(100n));
+    expect(await staker.balanceOf(user.address)).to.equal(USDC(50n));
+    expect(await staker.totalStaked()).to.equal(USDC(150n));
+
+    // One user withdrawing must not touch the other's position.
+    await staker.connect(user).withdraw();
+    expect(await staker.balanceOf(deployer.address)).to.equal(USDC(100n));
+    expect(await staker.totalStaked()).to.equal(USDC(100n));
+  });
+
+  it("lets a user withdraw their full position", async function () {
+    const { staker, usdc, stakerAddress } = await networkHelpers.loadFixture(deployFixture);
+    const [deployer] = await ethers.getSigners();
+    const before = await usdc.balanceOf(deployer.address);
+
+    await usdc.approve(stakerAddress, USDC(100n));
+    await staker.stake(USDC(100n));
+    await expect(staker.withdraw()).to.emit(staker, "Withdrawn").withArgs(deployer.address, USDC(100n));
+
+    expect(await staker.balanceOf(deployer.address)).to.equal(0n);
+    expect(await staker.totalStaked()).to.equal(0n);
+    expect(await usdc.balanceOf(deployer.address)).to.equal(before);
+  });
+
+  it("reverts when staking without approval", async function () {
+    const { staker } = await networkHelpers.loadFixture(deployFixture);
+    // Deployer holds USDC but has not approved the vault.
+    await expect(staker.stake(USDC(100n))).to.be.reverted;
+  });
+
+  it("reverts when staking zero", async function () {
+    const { staker } = await networkHelpers.loadFixture(deployFixture);
+    await expect(staker.stake(0n)).to.be.revertedWithCustomError(staker, "ZeroAmount");
+  });
+
+  it("reverts when withdrawing with nothing staked", async function () {
+    const { staker } = await networkHelpers.loadFixture(deployFixture);
+    const [, user] = await ethers.getSigners();
+    await expect(staker.connect(user).withdraw()).to.be.revertedWithCustomError(staker, "NothingStaked");
+  });
+});
