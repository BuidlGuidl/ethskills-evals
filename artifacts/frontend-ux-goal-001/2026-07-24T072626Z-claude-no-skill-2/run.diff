+//SPDX-License-Identifier: MIT
+pragma solidity >=0.8.0 <0.9.0;
+
+import { ERC20 } from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+
+/**
+ * Local-development stand-in for Circle's USDC. Matches the real token's name,
+ * symbol and 6-decimal precision. The open `mint` is a dev faucet only — the
+ * real USDC on Base is never deployed from this repo.
+ */
+contract MockUSDC is ERC20 {
+    constructor() ERC20("USD Coin", "USDC") {}
+
+    // USDC uses 6 decimals, not the ERC20 default of 18.
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    // Faucet for local testing. Do not deploy to a live network.
+    function mint(address to, uint256 amount) external {
+        _mint(to, amount);
+    }
+}
