@@ -0,0 +1,49 @@
+import { deployScript, artifacts } from "../rocketh/deploy.js";
+
+// Circle's canonical USDC on Base mainnet.
+const BASE_CHAIN_ID = 8453;
+const BASE_USDC = "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913";
+
+/**
+ * Deploys the Staker vault.
+ *
+ * - On Base mainnet it points at the real Circle USDC.
+ * - On any other network (local hardhat, testnets) it deploys a faithful
+ *   6-decimal MockUSDC and mints a supply to the deployer for testing.
+ */
+export default deployScript(
+  async env => {
+    const { deployer } = env.namedAccounts;
+
+    let usdcAddress: string;
+
+    if (env.network.chain.id === BASE_CHAIN_ID) {
+      usdcAddress = BASE_USDC;
+    } else {
+      const mockUSDC = await env.deploy("MockUSDC", {
+        account: deployer,
+        artifact: artifacts.MockUSDC,
+        args: [],
+      });
+      usdcAddress = mockUSDC.address;
+
+      // Fund the deployer with 1,000,000 USDC (6 decimals) for local testing.
+      await env.execute(mockUSDC, {
+        functionName: "mint",
+        args: [deployer, 1_000_000n * 10n ** 6n],
+        account: deployer,
+      });
+    }
+
+    await env.deploy("Staker", {
+      account: deployer,
+      artifact: artifacts.Staker,
+      args: [usdcAddress],
+    });
+
+    console.log("💰 Staking USDC at:", usdcAddress);
+  },
+  {
+    tags: ["Staker", "MockUSDC"],
+  },
+);
