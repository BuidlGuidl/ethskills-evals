--- /dev/null
+++ b/packages/nextjs/hooks/useUsdcUsdPrice.ts
@@ -0,0 +1,55 @@
+import { base } from "viem/chains";
+import { useReadContract } from "wagmi";
+
+// Chainlink USDC / USD on Base mainnet: 8 decimals, 24h heartbeat, 0.3% deviation.
+const USDC_USD_FEED = "0x7e860098F58bBFC8648a4311b374B1D669a2bc6B";
+const FEED_DECIMALS = 8;
+// Heartbeat plus an hour of slack before we call the answer stale.
+const MAX_PRICE_AGE_SECONDS = 25 * 60 * 60;
+
+const aggregatorV3Abi = [
+  {
+    type: "function",
+    name: "latestRoundData",
+    stateMutability: "view",
+    inputs: [],
+    outputs: [
+      { name: "roundId", type: "uint80" },
+      { name: "answer", type: "int256" },
+      { name: "startedAt", type: "uint256" },
+      { name: "updatedAt", type: "uint256" },
+      { name: "answeredInRound", type: "uint80" },
+    ],
+  },
+] as const;
+
+export type UsdPrice = {
+  price?: number;
+  isLoading: boolean;
+  isStale: boolean;
+};
+
+/**
+ * USDC/USD from Chainlink on Base. Callers show "price unavailable" rather than assuming $1
+ * (e.g. when targeting a local chain, where Base isn't a configured chain).
+ */
+export const useUsdcUsdPrice = (): UsdPrice => {
+  const { data, isLoading } = useReadContract({
+    address: USDC_USD_FEED,
+    abi: aggregatorV3Abi,
+    functionName: "latestRoundData",
+    chainId: base.id,
+    query: {
+      refetchInterval: 60_000,
+      select: ([, answer, , updatedAt]) =>
+        answer > 0n
+          ? {
+              price: Number(answer) / 10 ** FEED_DECIMALS,
+              isStale: Date.now() / 1000 - Number(updatedAt) > MAX_PRICE_AGE_SECONDS,
+            }
+          : undefined,
+    },
+  });
+
+  return { price: data?.price, isStale: data?.isStale ?? false, isLoading };
+};
