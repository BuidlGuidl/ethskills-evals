@@ -0,0 +1,47 @@
+import { formatUnits, parseUnits } from "viem";
+import { getParsedError } from "~~/utils/scaffold-eth";
+
+export const USDC_DECIMALS = 6;
+
+const usdFormatter = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" });
+
+export const formatUsd = (value: number) => usdFormatter.format(value);
+
+export const formatToken = (amount: bigint, decimals: number, maxFractionDigits = decimals) =>
+  Number(formatUnits(amount, decimals)).toLocaleString("en-US", {
+    minimumFractionDigits: 2,
+    maximumFractionDigits: maxFractionDigits,
+  });
+
+export const formatUsdc = (amount: bigint) => formatToken(amount, USDC_DECIMALS);
+
+export type ParsedAmount = { amount?: bigint; error?: string };
+
+export const parseUsdcInput = (value: string, walletBalance?: bigint): ParsedAmount => {
+  if (value === "" || value === ".") return {};
+  const decimals = value.split(".")[1] ?? "";
+  if (decimals.length > USDC_DECIMALS) return { error: `USDC supports at most ${USDC_DECIMALS} decimal places` };
+  const amount = parseUnits(value, USDC_DECIMALS);
+  if (amount === 0n) return { error: "Amount must be greater than 0" };
+  if (walletBalance !== undefined && amount > walletBalance)
+    return { amount, error: "Exceeds your wallet USDC balance" };
+  return { amount };
+};
+
+// Revert reasons from Staker, OZ ERC20 (MockUSDC) and Circle's FiatToken (real USDC), plus common wallet errors.
+const FRIENDLY_ERRORS: [RegExp, string][] = [
+  [/user (rejected|denied)|rejected the request/i, "You rejected the request in your wallet."],
+  [/insufficient funds/i, "Not enough ETH to pay the network fee. Add ETH on Base and try again."],
+  [/ZeroAmount/, "Amount must be greater than 0."],
+  [/NothingStaked/, "You have nothing staked to withdraw."],
+  [/ERC20InsufficientAllowance|exceeds allowance/i, "USDC approval is too low. Approve the amount again."],
+  [/ERC20InsufficientBalance|exceeds balance/i, "Not enough USDC in your wallet."],
+  [/blacklisted/i, "USDC has blocked this address, so it can't send or receive USDC."],
+  [/paused/i, "USDC transfers are paused by Circle right now. Try again later."],
+];
+
+export const toFriendlyError = (error: unknown) => {
+  const parsed = getParsedError(error);
+  const raw = `${parsed} ${(error as Error | undefined)?.message ?? ""}`;
+  return FRIENDLY_ERRORS.find(([pattern]) => pattern.test(raw))?.[1] ?? parsed;
+};
