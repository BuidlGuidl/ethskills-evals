+export const StakePanel = () => {
+  const { address, chainId, isConnected } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+  const { switchChain, isPending: isSwitching } = useSwitchChain();
+  const isWrongNetwork = isConnected && chainId !== targetNetwork.id;
+  const isLocalNetwork = targetNetwork.id === hardhat.id;
+
+  const [amountInput, setAmountInput] = useState("");
+  const [pendingAction, setPendingAction] = useState<Action | null>(null);
+  const [stakeError, setStakeError] = useState<string>();
+  const [withdrawError, setWithdrawError] = useState<string>();
+
+  const { data: staker, isLoading: isStakerLoading } = useDeployedContractInfo({ contractName: "Staker" });
+  // The staker is the source of truth for which token it holds.
+  const { data: tokenAddress } = useScaffoldReadContract({ contractName: "Staker", functionName: "token" });
+  const { data: staked, refetch: refetchStaked } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "balances",
+    args: [address],
+  });
+  const { data: totalStaked, refetch: refetchTotalStaked } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "totalStaked",
+  });
+
+  const tokenQuery = {
+    enabled: !!tokenAddress && !!address && !!staker,
+    refetchInterval: scaffoldConfig.pollingInterval,
+  };
+  const { data: usdcBalance, refetch: refetchUsdcBalance } = useReadContract({
+    address: tokenAddress,
+    abi: erc20Abi,
+    functionName: "balanceOf",
+    args: address ? [address] : undefined,
+    chainId: targetNetwork.id,
+    query: tokenQuery,
+  });
+  const { data: allowance, refetch: refetchAllowance } = useReadContract({
+    address: tokenAddress,
+    abi: erc20Abi,
+    functionName: "allowance",
+    args: address && staker ? [address, staker.address] : undefined,
+    chainId: targetNetwork.id,
+    query: tokenQuery,
+  });
+  const { data: ethBalance, refetch: refetchEthBalance } = useBalance({
+    address,
+    chainId: targetNetwork.id,
+    query: { refetchInterval: scaffoldConfig.pollingInterval },
+  });
+
+  const usdcPrice = useUsdcUsdPrice();
+  const ethPriceQuery = useFetchNativeCurrencyPrice();
+  const ethPrice = ethPriceQuery.price > 0 ? ethPriceQuery.price : undefined;
+
+  const { writeContractAsync: writeStaker } = useScaffoldWriteContract({ contractName: "Staker" });
+  const { writeContractAsync: writeToken } = useWriteContract();
+  const transactor = useTransactor();
+
+  const parsed = parseUsdcInput(amountInput, usdcBalance);
+  const needsApproval = parsed.amount !== undefined && allowance !== undefined && allowance < parsed.amount;
+  const isBusy = pendingAction !== null;
+
+  /** Holds the button's pending state from click through receipt and the balance refetch. */
+  const run = async (action: Action, tx: () => Promise<unknown>, setError: (error?: string) => void) => {
+    setPendingAction(action);
+    setError(undefined);
+    try {
+      await tx();
+      await Promise.all([
+        refetchStaked(),
+        refetchTotalStaked(),
+        refetchUsdcBalance(),
+        refetchAllowance(),
+        refetchEthBalance(),
+      ]);
+      return true;
+    } catch (error) {
+      setError(toFriendlyError(error));
+      return false;
+    } finally {
+      setPendingAction(null);
+    }
+  };
+
+  const handleApprove = (amount: bigint) =>
+    run(
+      "approve",
+      () =>
+        transactor(() =>
+          writeToken({
+            address: tokenAddress!,
+            abi: erc20Abi,
+            functionName: "approve",
+            args: [staker!.address, amount],
+            chainId: targetNetwork.id,
+          }),
+        ),
+      setStakeError,
+    );
+
+  const handleStake = async (amount: bigint) => {
+    const ok = await run("stake", () => writeStaker({ functionName: "stake", args: [amount] }), setStakeError);
+    if (ok) setAmountInput("");
+  };
+
+  const handleWithdraw = () => run("withdraw", () => writeStaker({ functionName: "withdraw" }), setWithdrawError);
+
+  const handleMint = () =>
+    run(
+      "mint",
+      () =>
+        transactor(() =>
+          writeToken({
+            address: tokenAddress!,
+            abi: mockMintAbi,
+            functionName: "mint",
+            args: [address!, LOCAL_MINT_AMOUNT],
+            chainId: targetNetwork.id,
+          }),
+        ),
+      setStakeError,
+    );
+
+  const handleAmountChange = (value: string) => {
+    const normalized = value.replace(",", ".");
+    // Ignore keystrokes that can't form a decimal number.
+    if (/^\d*\.?\d*$/.test(normalized)) setAmountInput(normalized);
+  };
+
+  /** Connect → switch network gate shared by both cards. Returns null once the wallet is ready. */
+  const renderWalletGate = () => {
+    if (!isConnected) {
+      return (
+        <div className="flex justify-center">
+          <RainbowKitCustomConnectButton />
+        </div>
+      );
+    }
+    if (isWrongNetwork) {
+      return (
+        <button
+          className="btn btn-primary w-full"
+          disabled={isSwitching}
+          onClick={() => switchChain({ chainId: targetNetwork.id })}
+        >
+          {isSwitching && <Spinner />}
+          Switch to {targetNetwork.name}
+        </button>
+      );
+    }
+    return null;
+  };
+
+  const renderStakeAction = () => {
+    const gate = renderWalletGate();
+    if (gate) return gate;
+
+    const { amount, error } = parsed;
+    if (amount === undefined || error) {
+      return (
+        <button className="btn btn-primary w-full" disabled>
+          {error ? "Fix the amount above" : "Enter an amount"}
+        </button>
+      );
+    }
+    if (allowance === undefined) {
+      return (
+        <button className="btn btn-primary w-full" disabled>
+          <Spinner />
+          Checking approval…
+        </button>
+      );
+    }
+    if (needsApproval) {
+      return (
+        <div className="flex flex-col gap-2">
+          <button className="btn btn-primary w-full" disabled={isBusy} onClick={() => handleApprove(amount)}>
+            {pendingAction === "approve" && <Spinner />}
+            Approve {formatUsdc(amount)} USDC
+          </button>
+          <p className="text-xs opacity-70 text-center m-0">
+            Step 1 of 2: allow the staking contract to move this much USDC. Then stake.
+          </p>
+        </div>
+      );
+    }
+    return (
+      <button className="btn btn-primary w-full" disabled={isBusy} onClick={() => handleStake(amount)}>
+        {pendingAction === "stake" && <Spinner />}
+        Stake {formatUsdc(amount)} USDC
+      </button>
+    );
+  };
+
+  const renderWithdrawAction = () => {
+    const gate = renderWalletGate();
+    if (gate) return gate;
+
+    const hasPosition = staked !== undefined && staked > 0n;
+    return (
+      <button className="btn btn-secondary w-full" disabled={isBusy || !hasPosition} onClick={handleWithdraw}>
+        {pendingAction === "withdraw" && <Spinner />}
+        {hasPosition ? `Withdraw all ${formatUsdc(staked)} USDC` : "Nothing to withdraw"}
+      </button>
+    );
+  };
+
+  if (isStakerLoading) {
+    return (
+      <div className="flex justify-center py-20">
+        <span className="loading loading-spinner loading-lg" />
+      </div>
+    );
+  }
+
+  if (!staker) {
+    return (
+      <div role="alert" className="alert alert-warning max-w-xl">
+        <span>Staking isn&apos;t live on {targetNetwork.name} yet. Check back soon.</span>
+      </div>
+    );
+  }
+
+  const showBalances = isConnected && !isWrongNetwork;
+  const hasNoEth = showBalances && ethBalance?.value === 0n;
+  const inputUsd = toUsdcNumber(parsed.amount);
+
+  return (
+    <div className="flex flex-col gap-6 w-full">
+      <div className="stats stats-vertical sm:stats-horizontal bg-base-100 shadow w-full">
+        <Stat
+          title="Wallet USDC"
+          value={showBalances && usdcBalance !== undefined ? formatUsdc(usdcBalance) : "—"}
+          desc={showBalances && <UsdValue amount={toUsdcNumber(usdcBalance)} {...usdcPrice} />}
+        />
+        <Stat
+          title={`${targetNetwork.nativeCurrency.symbol} for gas`}
+          value={showBalances && ethBalance ? formatToken(ethBalance.value, ethBalance.decimals, 6) : "—"}
+          desc={
+            showBalances &&
+            ethBalance && (
+              <UsdValue
+                amount={Number(formatUnits(ethBalance.value, ethBalance.decimals))}
+                price={ethPrice}
+                isLoading={ethPriceQuery.isLoading}
+              />
+            )
+          }
+        />
+        <Stat
+          title="Your stake"
+          value={showBalances && staked !== undefined ? formatUsdc(staked) : "—"}
+          desc={showBalances && <UsdValue amount={toUsdcNumber(staked)} {...usdcPrice} />}
+        />
+      </div>
+
+      {hasNoEth && (
+        <div role="alert" className="alert alert-warning">
+          <span>
+            You have no {targetNetwork.nativeCurrency.symbol} on {targetNetwork.name}. You need a small amount to pay
+            network fees for approving, staking and withdrawing.
+          </span>
+        </div>
+      )}
+
+      <div className="grid gap-6 md:grid-cols-2">
+        <div className="card bg-base-100 shadow">
+          <div className="card-body gap-4">
+            <h2 className="card-title">Stake</h2>
+            <div className="flex flex-col gap-1">
+              <label className="input w-full">
+                <input
+                  type="text"
+                  inputMode="decimal"
+                  autoComplete="off"
+                  placeholder="0.00"
+                  aria-label="Amount of USDC to stake"
+                  className="grow"
+                  value={amountInput}
+                  disabled={isBusy}
+                  onChange={e => handleAmountChange(e.target.value)}
+                />
+                <button
+                  type="button"
+                  className="btn btn-ghost btn-xs"
+                  disabled={isBusy || !usdcBalance}
+                  onClick={() => usdcBalance && setAmountInput(formatUnits(usdcBalance, USDC_DECIMALS))}
+                >
+                  Max
+                </button>
+                <span className="font-semibold">USDC</span>
+              </label>
+              <div className="flex justify-between gap-2 min-h-5">
+                {parsed.error ? (
+                  <span className="text-sm text-error">{parsed.error}</span>
+                ) : (
+                  <UsdValue amount={inputUsd} {...usdcPrice} />
+                )}
+              </div>
+            </div>
+            {renderStakeAction()}
+            {stakeError && <p className="text-sm text-error m-0">{stakeError}</p>}
+            {isLocalNetwork && showBalances && (
+              <button className="btn btn-ghost btn-sm" disabled={isBusy} onClick={handleMint}>
+                {pendingAction === "mint" && <Spinner />}
+                Mint 1,000 test USDC (local only)
+              </button>
+            )}
+          </div>
+        </div>
+
+        <div className="card bg-base-100 shadow">
+          <div className="card-body gap-4">
+            <h2 className="card-title">Withdraw</h2>
+            <p className="m-0 opacity-80">
+              Withdraw your entire position back to your wallet at any time. There&apos;s no lockup and no fee beyond
+              network gas.
+            </p>
+            {renderWithdrawAction()}
+            {withdrawError && <p className="text-sm text-error m-0">{withdrawError}</p>}
+          </div>
+        </div>
+      </div>
+
+      <div className="flex flex-col sm:flex-row items-center justify-center gap-x-4 gap-y-1 text-sm opacity-80">
+        <div className="flex items-center gap-2">
+          <span>Staking contract:</span>
+          <Address address={staker.address} chain={targetNetwork} size="sm" />
+        </div>
+        {totalStaked !== undefined && <span>Total staked: {formatUsdc(totalStaked)} USDC</span>}
+      </div>
+    </div>
+  );
+};
