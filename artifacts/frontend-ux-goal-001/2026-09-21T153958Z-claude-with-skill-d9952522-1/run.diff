@@ -0,0 +1,32 @@
+import { deployScript, artifacts } from "../rocketh/deploy.js";
+
+// Circle's native USDC. Keyed by chain id.
+const USDC_ADDRESSES: Record<number, `0x${string}`> = {
+  8453: "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913", // Base
+  84532: "0x036CbD53842c5426634e7929541eC2318f3dCF7e", // Base Sepolia
+};
+
+const LOCAL_CHAIN_IDS = [31337, 1337];
+
+/**
+ * Deploys Staker against real USDC on Base / Base Sepolia, or against a fresh MockUSDC on a local chain.
+ * The frontend reads the token address from `Staker.token()`, so there's no second address to keep in sync.
+ */
+export default deployScript(
+  async env => {
+    const { deployer } = env.namedAccounts;
+    const chainId = env.network.chain.id;
+
+    let usdc = USDC_ADDRESSES[chainId];
+    if (!usdc) {
+      if (!LOCAL_CHAIN_IDS.includes(chainId)) {
+        throw new Error(`No USDC address configured for chain ${chainId}. Add it to USDC_ADDRESSES.`);
+      }
+      const mock = await env.deploy("MockUSDC", { account: deployer, artifact: artifacts.MockUSDC, args: [] });
+      usdc = mock.address;
+    }
+
+    await env.deploy("Staker", { account: deployer, artifact: artifacts.Staker, args: [usdc] });
+  },
+  { tags: ["Staker"] },
+);
