+import { formatUsd } from "./utils";
+
+type UsdValueProps = {
+  amount?: number;
+  price?: number;
+  isLoading: boolean;
+  isStale?: boolean;
+};
+
+/** Fiat value of a token amount, with the price state spelled out instead of silently hidden. */
+export const UsdValue = ({ amount, price, isLoading, isStale }: UsdValueProps) => {
+  if (amount === undefined) return null;
+  if (price === undefined) {
+    return <span className="text-sm opacity-60">{isLoading ? "Fetching USD price…" : "USD price unavailable"}</span>;
+  }
+  return (
+    <span className="text-sm opacity-70">
+      ≈ {formatUsd(amount * price)}
+      {isStale && <span className="text-warning"> (price may be stale)</span>}
+    </span>
+  );
+};
