+//SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import { ERC20 } from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+
+/**
+ * Mock USDC for local development only.
+ *
+ * Mirrors the real USDC token (name, symbol, and — importantly — 6 decimals)
+ * so the frontend behaves identically against a local chain and against Base.
+ * `mint` is intentionally permissionless so any dev account can fund itself.
+ *
+ * Do NOT deploy this to a live network; on Base the real USDC is used instead.
+ */
+contract MockUSDC is ERC20 {
+    constructor() ERC20("USD Coin", "USDC") {}
+
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    function mint(address to, uint256 amount) external {
+        _mint(to, amount);
+    }
+}
diff --git a/packages/hardhat/contracts/Staker.sol b/packages/hardhat/contracts/Staker.sol
