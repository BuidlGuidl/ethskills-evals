diff --git a/packages/nextjs/app/stake/page.tsx b/packages/nextjs/app/stake/page.tsx
new file mode 100644
index 0000000..ddbeddf
--- /dev/null
+++ b/packages/nextjs/app/stake/page.tsx
@@ -0,0 +1,232 @@
+"use client";
+
+import { useMemo, useState } from "react";
+import { Address } from "@scaffold-ui/components";
+import { useWatchBalance } from "@scaffold-ui/hooks";
+import type { NextPage } from "next";
+import { erc20Abi, formatUnits, parseUnits } from "viem";
+import { useAccount, useReadContract, useWriteContract } from "wagmi";
+import {
+  useDeployedContractInfo,
+  useScaffoldReadContract,
+  useScaffoldWriteContract,
+  useTargetNetwork,
+  useTransactor,
+} from "~~/hooks/scaffold-eth";
+
+// Trim a token amount to a readable number of decimals.
+const formatAmount = (value: bigint | undefined, decimals: number, maxFractionDigits = 2) => {
+  if (value === undefined) return "0";
+  return Number(formatUnits(value, decimals)).toLocaleString(undefined, {
+    maximumFractionDigits: maxFractionDigits,
+  });
+};
+
+const Stake: NextPage = () => {
+  const { address, isConnected } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+
+  const { data: stakerInfo, isLoading: stakerInfoLoading } = useDeployedContractInfo({ contractName: "Staker" });
+  const stakerAddress = stakerInfo?.address;
+
+  // The token the Staker custodies is the single source of truth — no hardcoded
+  // address in the UI, so this works against Base and a local mock alike.
+  const { data: usdcAddress } = useScaffoldReadContract({ contractName: "Staker", functionName: "usdc" });
+
+  const { data: ethBalance } = useWatchBalance({ address, chain: targetNetwork });
+  const { data: usdcBalance, refetch: refetchUsdc } = useWatchBalance({
+    address,
+    token: usdcAddress,
+    chain: targetNetwork,
+    query: { enabled: Boolean(address && usdcAddress) },
+  });
+  const decimals = usdcBalance?.decimals ?? 6;
+  const symbol = usdcBalance?.symbol ?? "USDC";
+
+  const { data: staked, refetch: refetchStaked } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "stakedBalance",
+    args: [address],
+  });
+
+  const { data: allowance, refetch: refetchAllowance } = useReadContract({
+    address: usdcAddress,
+    abi: erc20Abi,
+    functionName: "allowance",
+    args: address && stakerAddress ? [address, stakerAddress] : undefined,
+    chainId: targetNetwork.id,
+    query: { enabled: Boolean(address && stakerAddress && usdcAddress) },
+  });
+
+  const { writeContractAsync: writeStaker } = useScaffoldWriteContract({ contractName: "Staker" });
+  const { writeContractAsync: writeErc20 } = useWriteContract();
+  const writeTx = useTransactor();
+  // Track the in-flight action so each button shows its own spinner.
+  const [pendingAction, setPendingAction] = useState<"approve" | "stake" | "withdraw" | null>(null);
+
+  const [amount, setAmount] = useState("");
+  const parsedAmount = useMemo(() => {
+    try {
+      return amount ? parseUnits(amount, decimals) : 0n;
+    } catch {
+      return 0n;
+    }
+  }, [amount, decimals]);
+
+  const walletValue = usdcBalance?.value ?? 0n;
+  const stakedValue = staked ?? 0n;
+  const insufficientBalance = parsedAmount > walletValue;
+  const needsApproval = parsedAmount > (allowance ?? 0n);
+  const busy = pendingAction !== null;
+  const canStake = isConnected && !!stakerAddress && parsedAmount > 0n && !insufficientBalance && !busy;
+
+  const setMax = () => setAmount(formatUnits(walletValue, decimals));
+
+  const handleApprove = async () => {
+    if (!usdcAddress || !stakerAddress || parsedAmount === 0n) return;
+    try {
+      setPendingAction("approve");
+      await writeTx(() =>
+        writeErc20({
+          address: usdcAddress,
+          abi: erc20Abi,
+          functionName: "approve",
+          args: [stakerAddress, parsedAmount],
+        }),
+      );
+      await refetchAllowance();
+    } catch (e) {
+      console.error("Approve failed", e);
+    } finally {
+      setPendingAction(null);
+    }
+  };
+
+  const handleStake = async () => {
+    try {
+      setPendingAction("stake");
+      await writeStaker({ functionName: "stake", args: [parsedAmount] });
+      setAmount("");
+      // Staking consumes the allowance and moves USDC out of the wallet.
+      await Promise.all([refetchStaked(), refetchAllowance(), refetchUsdc()]);
+    } catch (e) {
+      console.error("Stake failed", e);
+    } finally {
+      setPendingAction(null);
+    }
+  };
+
+  const handleWithdraw = async () => {
+    try {
+      setPendingAction("withdraw");
+      await writeStaker({ functionName: "withdraw" });
+      await Promise.all([refetchStaked(), refetchUsdc()]);
+    } catch (e) {
+      console.error("Withdraw failed", e);
+    } finally {
+      setPendingAction(null);
+    }
+  };
+
+  return (
+    <div className="flex flex-col items-center grow w-full px-4 py-10">
+      <div className="w-full max-w-xl flex flex-col gap-6">
+        <div className="text-center">
+          <h1 className="text-4xl font-bold mb-1">Stake USDC</h1>
+          <p className="text-base-content/70">Deposit USDC and withdraw your full position anytime. No lockups.</p>
+        </div>
+
+        {isConnected && (
+          <div className="flex items-center justify-center gap-2 text-sm">
+            <span className="text-base-content/70">Wallet:</span>
+            <Address address={address} chain={targetNetwork} />
+          </div>
+        )}
+
+        <div className="stats stats-vertical sm:stats-horizontal shadow bg-base-100 w-full">
+          <div className="stat">
+            <div className="stat-title">Wallet {symbol}</div>
+            <div className="stat-value text-2xl">{formatAmount(walletValue, decimals)}</div>
+          </div>
+          <div className="stat">
+            <div className="stat-title">ETH (for gas)</div>
+            <div className="stat-value text-2xl">{formatAmount(ethBalance?.value, ethBalance?.decimals ?? 18, 4)}</div>
+          </div>
+          <div className="stat">
+            <div className="stat-title">Staked {symbol}</div>
+            <div className="stat-value text-2xl text-primary">{formatAmount(stakedValue, decimals)}</div>
+          </div>
+        </div>
+
+        {!isConnected ? (
+          <div className="card bg-base-100 shadow-xl">
+            <div className="card-body items-center text-center">
+              <p>Connect your wallet to stake.</p>
+            </div>
+          </div>
+        ) : !stakerAddress && !stakerInfoLoading ? (
+          <div className="card bg-base-100 shadow-xl">
+            <div className="card-body items-center text-center">
+              <p>Staker contract is not deployed on {targetNetwork.name}.</p>
+            </div>
+          </div>
+        ) : (
+          <>
+            <div className="card bg-base-100 shadow-xl">
+              <div className="card-body gap-4">
+                <h2 className="card-title">Stake</h2>
+                <div className="form-control">
+                  <label className="input input-bordered flex items-center gap-2">
+                    <input
+                      type="number"
+                      min="0"
+                      step="any"
+                      placeholder="0.00"
+                      className="grow"
+                      value={amount}
+                      onChange={e => setAmount(e.target.value)}
+                    />
+                    <span className="text-base-content/60">{symbol}</span>
+                    <button type="button" className="btn btn-xs btn-ghost" onClick={setMax}>
+                      Max
+                    </button>
+                  </label>
+                  {insufficientBalance && (
+                    <span className="text-error text-sm mt-1">Amount exceeds wallet balance.</span>
+                  )}
+                </div>
+
+                {needsApproval && parsedAmount > 0n && !insufficientBalance ? (
+                  <button className="btn btn-primary" onClick={handleApprove} disabled={busy}>
+                    {pendingAction === "approve" && <span className="loading loading-spinner loading-sm" />}
+                    Approve {symbol}
+                  </button>
+                ) : (
+                  <button className="btn btn-primary" onClick={handleStake} disabled={!canStake}>
+                    {pendingAction === "stake" && <span className="loading loading-spinner loading-sm" />}
+                    Stake
+                  </button>
+                )}
+              </div>
+            </div>
+
+            <div className="card bg-base-100 shadow-xl">
+              <div className="card-body gap-4">
+                <h2 className="card-title">Your position</h2>
+                <p className="text-lg">
+                  <span className="font-bold">{formatAmount(stakedValue, decimals)}</span> {symbol} staked
+                </p>
+                <button className="btn btn-secondary" onClick={handleWithdraw} disabled={stakedValue === 0n || busy}>
+                  {pendingAction === "withdraw" && <span className="loading loading-spinner loading-sm" />}
+                  Withdraw all
+                </button>
+              </div>
+            </div>
+          </>
+        )}
+      </div>
+    </div>
+  );
+};
+
+export default Stake;
