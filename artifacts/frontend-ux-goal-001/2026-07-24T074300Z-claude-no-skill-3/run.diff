@@ -0,0 +1,56 @@
+import { parseUnits } from "viem";
+import { deployScript, artifacts } from "../rocketh/deploy.js";
+
+/**
+ * Canonical USDC addresses per chain. Where an entry exists we point the Staker
+ * at the real token; otherwise (local/dev chains) we deploy a MockUSDC.
+ */
+const USDC_BY_CHAIN: Record<number, `0x${string}`> = {
+  8453: "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913", // Base mainnet
+  84532: "0x036CbD53842c5426634e7929541eC2318f3dCF7e", // Base Sepolia
+};
+
+/**
+ * Deploys the Staker contract, wiring it to USDC.
+ *
+ * - On chains with a known USDC (e.g. Base), the real token is used.
+ * - On local/dev chains, a MockUSDC (6 decimals, like real USDC) is deployed
+ *   and the deployer is minted a starting balance for testing.
+ */
+export default deployScript(
+  async env => {
+    const { deployer } = env.namedAccounts;
+    const chainId = env.network.chain.id;
+
+    let usdcAddress = USDC_BY_CHAIN[chainId];
+
+    if (!usdcAddress) {
+      const mockUsdc = await env.deploy("MockUSDC", {
+        account: deployer,
+        artifact: artifacts.MockUSDC,
+        args: [],
+      });
+      usdcAddress = mockUsdc.address;
+
+      // Fund the deployer so the /stake page is usable immediately on local.
+      await env.execute(mockUsdc, {
+        account: deployer,
+        functionName: "mint",
+        args: [deployer, parseUnits("1000000", 6)],
+      });
+
+      console.log("🪙 Deployed MockUSDC at", usdcAddress);
+    } else {
+      console.log("🪙 Using existing USDC at", usdcAddress);
+    }
+
+    await env.deploy("Staker", {
+      account: deployer,
+      artifact: artifacts.Staker,
+      args: [usdcAddress],
+    });
+  },
+  {
+    tags: ["Staker"],
+  },
+);
diff --git a/packages/hardhat/test/Staker.ts b/packages/hardhat/test/Staker.ts
new file mode 100644
index 0000000..bf9d45a
--- /dev/null
+++ b/packages/hardhat/test/Staker.ts
@@ -0,0 +1,120 @@
+import { expect } from "chai";
+import type { Signer } from "ethers";
+import { network } from "hardhat";
+import { parseUnits } from "viem";
+import type { Abi_MockUSDC } from "../generated/abis/MockUSDC.js";
+import type { Abi_Staker } from "../generated/abis/Staker.js";
+import { loadAndExecuteDeploymentsFromFiles } from "../rocketh/environment.js";
+
+const { provider, networkHelpers, ethers } = await network.create();
+
+const USDC = (n: string) => parseUnits(n, 6);
+
+// ethers v6 `.connect()` widens back to BaseContract, dropping typed methods;
+// this preserves the original contract's typing.
+const as = <T extends { connect: (s: Signer) => unknown }>(contract: T, signer: Signer) =>
+  contract.connect(signer) as T;
+
+// Deploy MockUSDC + Staker via the real deploy scripts, then return ethers
+// contract handles alongside a few signers.
+async function deployFixture() {
+  const env = await loadAndExecuteDeploymentsFromFiles({ provider });
+
+  const staker = env.get<Abi_Staker>("Staker");
+  const usdc = env.get<Abi_MockUSDC>("MockUSDC");
+
+  const [deployer, alice, bob] = await ethers.getSigners();
+  const stakerC = await ethers.getContractAt(staker.abi, staker.address);
+  const usdcC = await ethers.getContractAt(usdc.abi, usdc.address);
+
+  return { stakerC, usdcC, deployer, alice, bob };
+}
+
+describe("Staker", function () {
+  it("points at the deployed USDC token", async function () {
+    const { stakerC, usdcC } = await networkHelpers.loadFixture(deployFixture);
+    expect((await stakerC.usdc()).toLowerCase()).to.equal((await usdcC.getAddress()).toLowerCase());
+  });
+
+  it("stakes USDC and tracks the position", async function () {
+    const { stakerC, usdcC, alice } = await networkHelpers.loadFixture(deployFixture);
+    const stakerAddr = await stakerC.getAddress();
+
+    await usdcC.mint(alice.address, USDC("100"));
+    await as(usdcC, alice).approve(stakerAddr, USDC("100"));
+
+    await expect(as(stakerC, alice).stake(USDC("40")))
+      .to.emit(stakerC, "Staked")
+      .withArgs(alice.address, USDC("40"));
+
+    expect(await stakerC.stakedBalance(alice.address)).to.equal(USDC("40"));
+    expect(await stakerC.totalStaked()).to.equal(USDC("40"));
+    expect(await usdcC.balanceOf(stakerAddr)).to.equal(USDC("40"));
+    expect(await usdcC.balanceOf(alice.address)).to.equal(USDC("60"));
+  });
+
+  it("accumulates multiple stakes", async function () {
+    const { stakerC, usdcC, alice } = await networkHelpers.loadFixture(deployFixture);
+    const stakerAddr = await stakerC.getAddress();
+
+    await usdcC.mint(alice.address, USDC("100"));
+    await as(usdcC, alice).approve(stakerAddr, USDC("100"));
+
+    await as(stakerC, alice).stake(USDC("30"));
+    await as(stakerC, alice).stake(USDC("20"));
+
+    expect(await stakerC.stakedBalance(alice.address)).to.equal(USDC("50"));
+  });
+
+  it("withdraws the full position", async function () {
+    const { stakerC, usdcC, alice } = await networkHelpers.loadFixture(deployFixture);
+    const stakerAddr = await stakerC.getAddress();
+
+    await usdcC.mint(alice.address, USDC("100"));
+    await as(usdcC, alice).approve(stakerAddr, USDC("100"));
+    await as(stakerC, alice).stake(USDC("100"));
+
+    await expect(as(stakerC, alice).withdraw()).to.emit(stakerC, "Withdrawn").withArgs(alice.address, USDC("100"));
+
+    expect(await stakerC.stakedBalance(alice.address)).to.equal(0n);
+    expect(await stakerC.totalStaked()).to.equal(0n);
+    expect(await usdcC.balanceOf(alice.address)).to.equal(USDC("100"));
+    expect(await usdcC.balanceOf(stakerAddr)).to.equal(0n);
+  });
+
+  it("keeps user positions isolated", async function () {
+    const { stakerC, usdcC, alice, bob } = await networkHelpers.loadFixture(deployFixture);
+    const stakerAddr = await stakerC.getAddress();
+
+    await usdcC.mint(alice.address, USDC("100"));
+    await usdcC.mint(bob.address, USDC("100"));
+    await as(usdcC, alice).approve(stakerAddr, USDC("100"));
+    await as(usdcC, bob).approve(stakerAddr, USDC("100"));
+
+    await as(stakerC, alice).stake(USDC("70"));
+    await as(stakerC, bob).stake(USDC("30"));
+
+    await as(stakerC, alice).withdraw();
+
+    expect(await stakerC.stakedBalance(alice.address)).to.equal(0n);
+    expect(await stakerC.stakedBalance(bob.address)).to.equal(USDC("30"));
+    expect(await stakerC.totalStaked()).to.equal(USDC("30"));
+  });
+
+  it("reverts when staking zero", async function () {
+    const { stakerC, alice } = await networkHelpers.loadFixture(deployFixture);
+    await expect(as(stakerC, alice).stake(0n)).to.be.revertedWithCustomError(stakerC, "ZeroAmount");
+  });
+
+  it("reverts when withdrawing with nothing staked", async function () {
+    const { stakerC, alice } = await networkHelpers.loadFixture(deployFixture);
+    await expect(as(stakerC, alice).withdraw()).to.be.revertedWithCustomError(stakerC, "NothingStaked");
+  });
+
+  it("reverts staking without allowance", async function () {
+    const { stakerC, usdcC, alice } = await networkHelpers.loadFixture(deployFixture);
+    await usdcC.mint(alice.address, USDC("100"));
+    // no approve
+    await expect(as(stakerC, alice).stake(USDC("10"))).to.be.revert(ethers);
+  });
+});
