diff --git a/packages/hardhat/test/Staker.ts b/packages/hardhat/test/Staker.ts
new file mode 100644
index 0000000..08fa3b8
--- /dev/null
+++ b/packages/hardhat/test/Staker.ts
@@ -0,0 +1,73 @@
+import { expect } from "chai";
+import { network } from "hardhat";
+import type { Abi_MockUSDC } from "../generated/abis/MockUSDC.js";
+import type { Abi_Staker } from "../generated/abis/Staker.js";
+import { loadAndExecuteDeploymentsFromFiles } from "../rocketh/environment.js";
+
+const { provider, networkHelpers, ethers } = await network.create();
+
+async function deployFixture() {
+  const env = await loadAndExecuteDeploymentsFromFiles({ provider });
+  const [deployer, user] = await ethers.getSigners();
+
+  const { address: usdcAddress, abi: usdcAbi } = env.get<Abi_MockUSDC>("USDC");
+  const { address: stakerAddress, abi: stakerAbi } = env.get<Abi_Staker>("Staker");
+
+  const usdc = (await ethers.getContractAt(usdcAbi, usdcAddress)) as any;
+  const staker = (await ethers.getContractAt(stakerAbi, stakerAddress)) as any;
+
+  return { deployer, user, usdc, usdcAddress, staker, stakerAddress };
+}
+
+describe("Staker", function () {
+  it("deploys with a faithful local USDC mock", async function () {
+    const { deployer, usdc, usdcAddress, staker } = await networkHelpers.loadFixture(deployFixture);
+
+    expect(await usdc.name()).to.equal("USD Coin");
+    expect(await usdc.symbol()).to.equal("USDC");
+    expect(await usdc.decimals()).to.equal(6);
+    expect(await usdc.balanceOf(deployer.address)).to.equal(1_000_000_000_000n);
+    expect(await staker.usdc()).to.equal(ethers.getAddress(usdcAddress));
+  });
+
+  it("deposits approved USDC and tracks the position", async function () {
+    const { user, usdc, staker, stakerAddress } = await networkHelpers.loadFixture(deployFixture);
+    const amount = ethers.parseUnits("250", 6);
+
+    await usdc.mint(user.address, amount);
+    await usdc.connect(user).approve(stakerAddress, amount);
+
+    await expect(staker.connect(user).deposit(amount))
+      .to.emit(staker, "Deposited")
+      .withArgs(user.address, amount, amount);
+
+    expect(await staker.positions(user.address)).to.equal(amount);
+    expect(await staker.totalStaked()).to.equal(amount);
+    expect(await usdc.balanceOf(stakerAddress)).to.equal(amount);
+  });
+
+  it("allows users to withdraw their full position", async function () {
+    const { user, usdc, staker, stakerAddress } = await networkHelpers.loadFixture(deployFixture);
+    const firstDeposit = ethers.parseUnits("125.50", 6);
+    const secondDeposit = ethers.parseUnits("24.50", 6);
+    const totalDeposit = firstDeposit + secondDeposit;
+
+    await usdc.mint(user.address, totalDeposit);
+    await usdc.connect(user).approve(stakerAddress, totalDeposit);
+    await staker.connect(user).deposit(firstDeposit);
+    await staker.connect(user).deposit(secondDeposit);
+
+    await expect(staker.connect(user).withdraw()).to.emit(staker, "Withdrawn").withArgs(user.address, totalDeposit);
+
+    expect(await staker.positions(user.address)).to.equal(0n);
+    expect(await staker.totalStaked()).to.equal(0n);
+    expect(await usdc.balanceOf(user.address)).to.equal(totalDeposit);
+  });
+
+  it("rejects zero deposits and empty withdrawals", async function () {
+    const { user, staker } = await networkHelpers.loadFixture(deployFixture);
+
+    await expect(staker.connect(user).deposit(0)).to.be.revertedWithCustomError(staker, "AmountZero");
+    await expect(staker.connect(user).withdraw()).to.be.revertedWithCustomError(staker, "NoPosition");
+  });
+});
