@@ -0,0 +1,470 @@
+"use client";
+
+import { useMemo, useState } from "react";
+import { useConnectModal } from "@rainbow-me/rainbowkit";
+import { Address, Balance } from "@scaffold-ui/components";
+import { useFetchNativeCurrencyPrice } from "@scaffold-ui/hooks";
+import type { NextPage } from "next";
+import { Address as AddressType, formatEther, formatUnits, parseUnits } from "viem";
+import { useAccount, useBalance, useSwitchChain } from "wagmi";
+import {
+  ArrowDownTrayIcon,
+  ArrowPathIcon,
+  ArrowUpTrayIcon,
+  BanknotesIcon,
+  BoltIcon,
+  ExclamationTriangleIcon,
+} from "@heroicons/react/24/outline";
+import {
+  useDeployedContractInfo,
+  useScaffoldReadContract,
+  useScaffoldWriteContract,
+  useTargetNetwork,
+} from "~~/hooks/scaffold-eth";
+import { AllowedChainIds, getParsedError } from "~~/utils/scaffold-eth";
+
+const USDC_DECIMALS = 6;
+
+const formatTokenAmount = (value?: bigint, maximumFractionDigits = 2) => {
+  const amount = Number(formatUnits(value ?? 0n, USDC_DECIMALS));
+  return new Intl.NumberFormat("en-US", {
+    minimumFractionDigits: 2,
+    maximumFractionDigits,
+  }).format(amount);
+};
+
+const formatUsd = (value: number) =>
+  new Intl.NumberFormat("en-US", {
+    style: "currency",
+    currency: "USD",
+    minimumFractionDigits: 2,
+    maximumFractionDigits: 2,
+  }).format(value);
+
+const parseUsdcAmount = (value: string) => {
+  const trimmedValue = value.trim();
+  if (!trimmedValue || trimmedValue === ".") return undefined;
+  if (!/^\d*\.?\d*$/.test(trimmedValue)) return undefined;
+  const [, decimals = ""] = trimmedValue.split(".");
+  if (decimals.length > USDC_DECIMALS) return undefined;
+
+  try {
+    return parseUnits(trimmedValue, USDC_DECIMALS);
+  } catch {
+    return undefined;
+  }
+};
+
+const Spinner = () => <span className="loading loading-spinner loading-sm" />;
+
+const Stake: NextPage = () => {
+  const { address: connectedAddress, chain, isConnected } = useAccount();
+  const { openConnectModal } = useConnectModal();
+  const { switchChainAsync } = useSwitchChain();
+  const { targetNetwork } = useTargetNetwork();
+  const selectedChainId = targetNetwork.id as AllowedChainIds;
+
+  const [stakeAmount, setStakeAmount] = useState("");
+  const [approvalSubmitting, setApprovalSubmitting] = useState(false);
+  const [approveCooldown, setApproveCooldown] = useState(false);
+  const [isStaking, setIsStaking] = useState(false);
+  const [isWithdrawing, setIsWithdrawing] = useState(false);
+  const [isSwitchingNetwork, setIsSwitchingNetwork] = useState(false);
+  const [actionError, setActionError] = useState("");
+
+  const parsedStakeAmount = useMemo(() => parseUsdcAmount(stakeAmount), [stakeAmount]);
+  const isStakeAmountValid = parsedStakeAmount !== undefined && parsedStakeAmount > 0n;
+
+  const { data: stakerContract, isLoading: isStakerLoading } = useDeployedContractInfo({
+    contractName: "Staker",
+    chainId: selectedChainId,
+  });
+  const stakerAddress = stakerContract?.address;
+
+  const { writeContractAsync: writeUsdcAsync } = useScaffoldWriteContract({
+    contractName: "USDC",
+    chainId: selectedChainId,
+  });
+  const { writeContractAsync: writeStakerAsync } = useScaffoldWriteContract({
+    contractName: "Staker",
+    chainId: selectedChainId,
+  });
+
+  const {
+    data: walletUsdcData,
+    isLoading: isWalletUsdcLoading,
+    refetch: refetchWalletUsdc,
+  } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "balanceOf",
+    args: [connectedAddress],
+    chainId: selectedChainId,
+  });
+  const { data: allowanceData, refetch: refetchAllowance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "allowance",
+    args: [connectedAddress, stakerAddress],
+    chainId: selectedChainId,
+  });
+  const {
+    data: positionData,
+    isLoading: isPositionLoading,
+    refetch: refetchPosition,
+  } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "positions",
+    args: [connectedAddress],
+    chainId: selectedChainId,
+  });
+  const { data: totalStakedData, refetch: refetchTotalStaked } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "totalStaked",
+    chainId: selectedChainId,
+  });
+  const { data: nativeBalance, refetch: refetchNativeBalance } = useBalance({
+    address: connectedAddress,
+    chainId: selectedChainId,
+    query: {
+      enabled: Boolean(connectedAddress),
+    },
+  });
+  const { price: nativeCurrencyPrice } = useFetchNativeCurrencyPrice();
+
+  const walletUsdc = (walletUsdcData as bigint | undefined) ?? 0n;
+  const allowance = (allowanceData as bigint | undefined) ?? 0n;
+  const position = (positionData as bigint | undefined) ?? 0n;
+  const totalStaked = (totalStakedData as bigint | undefined) ?? 0n;
+
+  const isWrongNetwork = isConnected && chain?.id !== targetNetwork.id;
+  const hasEnoughUsdc = isStakeAmountValid && parsedStakeAmount !== undefined && walletUsdc >= parsedStakeAmount;
+  const needsApproval = isStakeAmountValid && parsedStakeAmount !== undefined && allowance < parsedStakeAmount;
+  const isStakeDisabled =
+    approvalSubmitting ||
+    approveCooldown ||
+    isStaking ||
+    isSwitchingNetwork ||
+    !stakerAddress ||
+    !isStakeAmountValid ||
+    !hasEnoughUsdc;
+  const ethAmount = Number(formatEther(nativeBalance?.value ?? 0n));
+  const ethUsdValue = nativeCurrencyPrice > 0 ? ethAmount * nativeCurrencyPrice : undefined;
+  const stakePreviewValue = isStakeAmountValid ? Number(formatUnits(parsedStakeAmount ?? 0n, USDC_DECIMALS)) : 0;
+
+  const refreshPositionData = async () => {
+    await Promise.all([
+      refetchWalletUsdc(),
+      refetchAllowance(),
+      refetchPosition(),
+      refetchTotalStaked(),
+      refetchNativeBalance(),
+    ]);
+  };
+
+  const handleSwitchNetwork = async () => {
+    setActionError("");
+    setIsSwitchingNetwork(true);
+    try {
+      await switchChainAsync({ chainId: targetNetwork.id });
+    } catch (error) {
+      setActionError(getParsedError(error));
+    } finally {
+      setIsSwitchingNetwork(false);
+    }
+  };
+
+  const handleApprove = async () => {
+    if (!stakerAddress || parsedStakeAmount === undefined) return;
+
+    setActionError("");
+    setApprovalSubmitting(true);
+    try {
+      await writeUsdcAsync({
+        functionName: "approve",
+        args: [stakerAddress, parsedStakeAmount],
+      });
+      setApproveCooldown(true);
+      await refreshPositionData();
+      setTimeout(async () => {
+        await refetchAllowance();
+        setApproveCooldown(false);
+      }, 4000);
+    } catch (error) {
+      setActionError(getParsedError(error));
+    } finally {
+      setApprovalSubmitting(false);
+    }
+  };
+
+  const handleStake = async () => {
+    if (parsedStakeAmount === undefined) return;
+
+    setActionError("");
+    setIsStaking(true);
+    try {
+      await writeStakerAsync({
+        functionName: "deposit",
+        args: [parsedStakeAmount],
+      });
+      setStakeAmount("");
+      await refreshPositionData();
+    } catch (error) {
+      setActionError(getParsedError(error));
+    } finally {
+      setIsStaking(false);
+    }
+  };
+
+  const handleWithdraw = async () => {
+    if (position === 0n) return;
+
+    setActionError("");
+    setIsWithdrawing(true);
+    try {
+      await writeStakerAsync({
+        functionName: "withdraw",
+      });
+      await refreshPositionData();
+    } catch (error) {
+      setActionError(getParsedError(error));
+    } finally {
+      setIsWithdrawing(false);
+    }
+  };
+
+  const renderStakeAction = () => {
+    if (!isConnected) {
+      return (
+        <button type="button" className="btn btn-primary w-full" onClick={openConnectModal}>
+          <BanknotesIcon className="h-5 w-5" />
+          Connect Wallet
+        </button>
+      );
+    }
+
+    if (isWrongNetwork) {
+      return (
+        <button
+          type="button"
+          className="btn btn-primary w-full"
+          onClick={handleSwitchNetwork}
+          disabled={isSwitchingNetwork}
+        >
+          {isSwitchingNetwork ? <Spinner /> : <BoltIcon className="h-5 w-5" />}
+          {isSwitchingNetwork ? "Switching..." : `Switch to ${targetNetwork.name}`}
+        </button>
+      );
+    }
+
+    if (!stakerAddress) {
+      return (
+        <button type="button" className="btn btn-disabled w-full" disabled>
+          {isStakerLoading ? <Spinner /> : <ExclamationTriangleIcon className="h-5 w-5" />}
+          {isStakerLoading ? "Checking Staker..." : `Staker not deployed on ${targetNetwork.name}`}
+        </button>
+      );
+    }
+
+    if (!isStakeAmountValid) {
+      return (
+        <button type="button" className="btn btn-disabled w-full" disabled>
+          Enter USDC amount
+        </button>
+      );
+    }
+
+    if (!hasEnoughUsdc) {
+      return (
+        <button type="button" className="btn btn-disabled w-full" disabled>
+          Insufficient USDC
+        </button>
+      );
+    }
+
+    if (needsApproval || approvalSubmitting || approveCooldown) {
+      return (
+        <button type="button" className="btn btn-primary w-full" onClick={handleApprove} disabled={isStakeDisabled}>
+          {approvalSubmitting || approveCooldown ? <Spinner /> : <ArrowPathIcon className="h-5 w-5" />}
+          {approvalSubmitting ? "Approving..." : approveCooldown ? "Syncing approval..." : "Approve USDC"}
+        </button>
+      );
+    }
+
+    return (
+      <button type="button" className="btn btn-primary w-full" onClick={handleStake} disabled={isStakeDisabled}>
+        {isStaking ? <Spinner /> : <ArrowDownTrayIcon className="h-5 w-5" />}
+        {isStaking ? "Staking..." : "Stake USDC"}
+      </button>
+    );
+  };
+
+  return (
+    <div className="w-full grow bg-base-200 px-4 py-8 sm:px-6 lg:px-8">
+      <div className="mx-auto flex w-full max-w-6xl flex-col gap-6">
+        <div className="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
+          <div>
+            <div className="badge badge-primary badge-outline mb-3">Base USDC</div>
+            <h1 className="text-3xl font-bold tracking-normal md:text-4xl">Stake USDC</h1>
+            <p className="m-0 max-w-2xl text-sm text-base-content/70">
+              Deposit USDC into the Staker contract and withdraw the full position whenever you need it.
+            </p>
+          </div>
+          <div className="flex flex-col items-start gap-1 text-sm md:items-end">
+            <span className="text-base-content/60">Connected wallet</span>
+            {connectedAddress ? (
+              <Address address={connectedAddress} chain={targetNetwork} />
+            ) : (
+              <span>Not connected</span>
+            )}
+          </div>
+        </div>
+
+        <div className="grid gap-4 md:grid-cols-3">
+          <div className="bg-base-100 border border-base-300 p-5">
+            <div className="mb-2 flex items-center gap-2 text-sm font-semibold text-base-content/70">
+              <BanknotesIcon className="h-5 w-5" />
+              Wallet USDC
+            </div>
+            <div className="text-2xl font-bold">
+              {isWalletUsdcLoading ? "..." : `${formatTokenAmount(walletUsdc, 6)} USDC`}
+            </div>
+            <div className="text-sm text-base-content/60">
+              ~{formatUsd(Number(formatUnits(walletUsdc, USDC_DECIMALS)))}
+            </div>
+          </div>
+          <div className="bg-base-100 border border-base-300 p-5">
+            <div className="mb-2 flex items-center gap-2 text-sm font-semibold text-base-content/70">
+              <BoltIcon className="h-5 w-5" />
+              ETH for gas
+            </div>
+            <div className="text-2xl font-bold">
+              {nativeBalance ? `${Number(formatEther(nativeBalance.value)).toFixed(5)} ETH` : "..."}
+            </div>
+            <div className="text-sm text-base-content/60">
+              {ethUsdValue === undefined ? "USD price unavailable" : `~${formatUsd(ethUsdValue)}`}
+            </div>
+          </div>
+          <div className="bg-base-100 border border-base-300 p-5">
+            <div className="mb-2 flex items-center gap-2 text-sm font-semibold text-base-content/70">
+              <ArrowDownTrayIcon className="h-5 w-5" />
+              Staked position
+            </div>
+            <div className="text-2xl font-bold">
+              {isPositionLoading ? "..." : `${formatTokenAmount(position, 6)} USDC`}
+            </div>
+            <div className="text-sm text-base-content/60">
+              ~{formatUsd(Number(formatUnits(position, USDC_DECIMALS)))}
+            </div>
+          </div>
+        </div>
+
+        <div className="grid gap-6 lg:grid-cols-[minmax(0,1.25fr)_minmax(320px,0.75fr)]">
+          <section className="bg-base-100 border border-base-300 p-5 sm:p-6">
+            <div className="mb-5 flex flex-col gap-1">
+              <h2 className="text-xl font-bold">Stake</h2>
+              <p className="m-0 text-sm text-base-content/70">
+                Approve the exact amount, then stake it in one confirmed flow.
+              </p>
+            </div>
+
+            <label className="form-control w-full">
+              <div className="label">
+                <span className="label-text font-medium">Amount</span>
+                <button
+                  type="button"
+                  className="btn btn-ghost btn-xs"
+                  onClick={() => setStakeAmount(formatUnits(walletUsdc, USDC_DECIMALS))}
+                  disabled={walletUsdc === 0n || approvalSubmitting || approveCooldown || isStaking}
+                >
+                  Max
+                </button>
+              </div>
+              <div className="join w-full">
+                <input
+                  className="input join-item input-bordered w-full text-lg"
+                  inputMode="decimal"
+                  placeholder="0.00"
+                  value={stakeAmount}
+                  onChange={event => setStakeAmount(event.target.value)}
+                />
+                <div className="join-item flex min-w-20 items-center justify-center border border-base-300 bg-base-200 px-3 font-semibold">
+                  USDC
+                </div>
+              </div>
+              <div className="label min-h-8">
+                <span className="label-text-alt text-base-content/60">
+                  {stakeAmount && parsedStakeAmount === undefined
+                    ? "Use numbers with up to 6 decimal places."
+                    : `~${formatUsd(stakePreviewValue)}`}
+                </span>
+              </div>
+            </label>
+
+            <div className="mt-2">{renderStakeAction()}</div>
+
+            {actionError && (
+              <div className="alert alert-error mt-4 items-start">
+                <ExclamationTriangleIcon className="h-5 w-5 shrink-0" />
+                <span className="break-words text-sm">{actionError}</span>
+              </div>
+            )}
+          </section>
+
+          <aside className="flex flex-col gap-6">
+            <section className="bg-base-100 border border-base-300 p-5 sm:p-6">
+              <div className="mb-5 flex flex-col gap-1">
+                <h2 className="text-xl font-bold">Withdraw</h2>
+                <p className="m-0 text-sm text-base-content/70">
+                  Withdraws your full staked position back to your wallet.
+                </p>
+              </div>
+              <button
+                type="button"
+                className="btn btn-secondary w-full"
+                onClick={handleWithdraw}
+                disabled={!isConnected || isWrongNetwork || position === 0n || isWithdrawing || isStaking}
+              >
+                {isWithdrawing ? <Spinner /> : <ArrowUpTrayIcon className="h-5 w-5" />}
+                {isWithdrawing ? "Withdrawing..." : "Withdraw all"}
+              </button>
+              <div className="mt-3 text-sm text-base-content/60">
+                Current position: {formatTokenAmount(position, 6)} USDC (~
+                {formatUsd(Number(formatUnits(position, USDC_DECIMALS)))})
+              </div>
+            </section>
+
+            <section className="bg-base-100 border border-base-300 p-5 sm:p-6">
+              <h2 className="mb-4 text-xl font-bold">Contracts</h2>
+              <div className="space-y-4 text-sm">
+                <div>
+                  <div className="font-medium text-base-content/60">Staker</div>
+                  {stakerAddress ? (
+                    <Address address={stakerAddress as AddressType} chain={targetNetwork} />
+                  ) : (
+                    <span>Not deployed</span>
+                  )}
+                </div>
+                <div>
+                  <div className="font-medium text-base-content/60">Total staked</div>
+                  <div>
+                    {formatTokenAmount(totalStaked, 6)} USDC (~
+                    {formatUsd(Number(formatUnits(totalStaked, USDC_DECIMALS)))})
+                  </div>
+                </div>
+                <div>
+                  <div className="font-medium text-base-content/60">Gas balance</div>
+                  {connectedAddress ? (
+                    <Balance address={connectedAddress} chain={targetNetwork} />
+                  ) : (
+                    <span>Connect wallet</span>
+                  )}
+                </div>
+              </div>
+            </section>
+          </aside>
