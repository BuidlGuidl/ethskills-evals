@@ -0,0 +1,35 @@
+import { deployScript, artifacts } from "../rocketh/deploy.js";
+
+const BASE_CHAIN_ID = 8453;
+const BASE_USDC = "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913";
+const LOCAL_USDC_SUPPLY = 1_000_000_000_000n;
+
+export default deployScript(
+  async env => {
+    const { deployer } = env.namedAccounts;
+    const chainId = env.network.chain.id;
+
+    const usdcAddress =
+      chainId === BASE_CHAIN_ID
+        ? BASE_USDC
+        : (
+            await env.deploy("USDC", {
+              account: deployer,
+              artifact: artifacts.MockUSDC,
+              args: [deployer, LOCAL_USDC_SUPPLY],
+            })
+          ).address;
+
+    const staker = await env.deploy("Staker", {
+      account: deployer,
+      artifact: artifacts.Staker,
+      args: [usdcAddress],
+    });
+
+    console.log(`USDC: ${usdcAddress}`);
+    console.log(`Staker: ${staker.address}`);
+  },
+  {
+    tags: ["Staker"],
+  },
+);
