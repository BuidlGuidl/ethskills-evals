+++ b/packages/nextjs/app/stake/_components/BalanceTiles.tsx
@@ -0,0 +1,100 @@
+"use client";
+
+import { UsdValue } from "./UsdValue";
+import { useFetchNativeCurrencyPrice } from "@scaffold-ui/hooks";
+import { ExclamationTriangleIcon } from "@heroicons/react/24/outline";
+import { useTargetNetwork } from "~~/hooks/scaffold-eth";
+import type { Staking } from "~~/hooks/useStaking";
+import { formatEthAmount, formatTokenAmount, toNumber } from "~~/utils/format";
+
+/** Below this there is not enough ETH left to be confident a stake or withdraw will go through. */
+const LOW_GAS_THRESHOLD_WEI = 300_000_000_000_000n; // 0.0003 ETH
+
+type BalanceTilesProps = {
+  staking: Staking;
+};
+
+const Tile = ({ label, children }: { label: string; children: React.ReactNode }) => (
+  <div className="flex flex-col gap-1 bg-base-100 border border-base-300 px-4 py-3">
+    <span className="text-xs uppercase tracking-wide opacity-60">{label}</span>
+    {children}
+  </div>
+);
+
+const Placeholder = () => <span className="text-lg font-semibold opacity-40">—</span>;
+
+export const BalanceTiles = ({ staking }: BalanceTilesProps) => {
+  const { targetNetwork } = useTargetNetwork();
+  const { token, walletBalance, staked, ethBalance, usdcPrice } = staking;
+  const { price: ethPrice, isLoading: isEthPriceLoading } = useFetchNativeCurrencyPrice();
+
+  const symbol = token?.symbol ?? "USDC";
+  const decimals = token?.decimals;
+
+  const isLowOnGas = ethBalance !== undefined && ethBalance < LOW_GAS_THRESHOLD_WEI;
+
+  return (
+    <div className="flex flex-col gap-2">
+      <div className="grid grid-cols-1 sm:grid-cols-3 gap-2">
+        <Tile label={`${symbol} in wallet`}>
+          {walletBalance !== undefined && decimals !== undefined ? (
+            <>
+              <span className="text-lg font-semibold">{formatTokenAmount(walletBalance, decimals)}</span>
+              <UsdValue
+                amount={toNumber(walletBalance, decimals)}
+                price={usdcPrice.price}
+                isPriceLoading={usdcPrice.isLoading}
+                isPriceStale={usdcPrice.isStale}
+              />
+            </>
+          ) : (
+            <Placeholder />
+          )}
+        </Tile>
+
+        <Tile label="Staked">
+          {staked !== undefined && decimals !== undefined ? (
+            <>
+              <span className="text-lg font-semibold">{formatTokenAmount(staked, decimals)}</span>
+              <UsdValue
+                amount={toNumber(staked, decimals)}
+                price={usdcPrice.price}
+                isPriceLoading={usdcPrice.isLoading}
+                isPriceStale={usdcPrice.isStale}
+              />
+            </>
+          ) : (
+            <Placeholder />
+          )}
+        </Tile>
+
+        <Tile label={`${targetNetwork.nativeCurrency.symbol} for gas`}>
+          {ethBalance !== undefined ? (
+            <>
+              <span className={`text-lg font-semibold ${isLowOnGas ? "text-warning" : ""}`}>
+                {formatEthAmount(ethBalance)}
+              </span>
+              <UsdValue
+                amount={toNumber(ethBalance, 18)}
+                price={ethPrice > 0 ? ethPrice : null}
+                isPriceLoading={isEthPriceLoading}
+              />
+            </>
+          ) : (
+            <Placeholder />
+          )}
+        </Tile>
+      </div>
+
+      {isLowOnGas && (
+        <p className="flex items-start gap-2 text-sm text-warning m-0">
+          <ExclamationTriangleIcon className="h-5 w-5 shrink-0" />
+          <span>
+            You have almost no {targetNetwork.nativeCurrency.symbol} on {targetNetwork.name}. Staking and withdrawing
+            both cost gas, so top up before you try.
+          </span>
+        </p>
+      )}
+    </div>
+  );
+};
