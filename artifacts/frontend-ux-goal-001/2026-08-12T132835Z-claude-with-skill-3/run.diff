+import { PrimaryAction } from "./PrimaryAction";
+import { UsdValue } from "./UsdValue";
+import type { StakeActions } from "~~/hooks/useStakeActions";
+import type { Staking } from "~~/hooks/useStaking";
+import { formatTokenAmount, toNumber } from "~~/utils/format";
+
+type WithdrawPanelProps = {
+  staking: Staking;
+  actions: StakeActions;
+};
+
+export const WithdrawPanel = ({ staking, actions }: WithdrawPanelProps) => {
+  const { token, staked, usdcPrice, isStakerDeployed } = staking;
+  const { pendingAction, error, withdraw } = actions;
+
+  const symbol = token?.symbol ?? "USDC";
+  const hasPosition = staked !== undefined && staked > 0n;
+  const isBusy = pendingAction !== null;
+
+  return (
+    <div className="flex flex-col gap-4">
+      <div className="flex flex-col gap-1">
+        <span className="text-sm font-medium">Your position</span>
+        <div className="bg-base-200 border border-base-300 px-4 py-3">
+          {staked !== undefined && token ? (
+            <div className="flex flex-col">
+              <span className="text-2xl font-semibold">
+                {formatTokenAmount(staked, token.decimals)} <span className="text-base opacity-60">{symbol}</span>
+              </span>
+              <UsdValue
+                amount={toNumber(staked, token.decimals)}
+                price={usdcPrice.price}
+                isPriceLoading={usdcPrice.isLoading}
+                isPriceStale={usdcPrice.isStale}
+              />
+            </div>
+          ) : (
+            <span className="text-2xl font-semibold opacity-40">—</span>
+          )}
+        </div>
+      </div>
+
+      <PrimaryAction
+        label={hasPosition && token ? `Withdraw ${formatTokenAmount(staked, token.decimals)} ${symbol}` : "Withdraw"}
+        pendingLabel="Withdrawing…"
+        onClick={withdraw}
+        isPending={pendingAction === "withdraw"}
+        disabled={isBusy || !hasPosition || !isStakerDeployed}
+      />
+
+      <p className="m-0 text-xs opacity-60">
+        {hasPosition
+          ? "Withdrawing returns your whole position in a single transaction. You can stake again straight after."
+          : "You don't have anything staked yet. Stake some " + symbol + " first."}
+      </p>
+
+      {error && <p className="m-0 text-sm text-error whitespace-pre-line">{error}</p>}
+    </div>
+  );
+};
