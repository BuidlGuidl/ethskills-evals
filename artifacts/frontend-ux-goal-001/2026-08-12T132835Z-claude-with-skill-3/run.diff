@@ -0,0 +1,60 @@
+"use client";
+
+import { useConnectModal } from "@rainbow-me/rainbowkit";
+import { useAccount, useSwitchChain } from "wagmi";
+import { useTargetNetwork } from "~~/hooks/scaffold-eth";
+
+type PrimaryActionProps = {
+  label: string;
+  pendingLabel: string;
+  onClick: () => void;
+  isPending: boolean;
+  disabled?: boolean;
+};
+
+/**
+ * The single button at the bottom of the card.
+ *
+ * Connecting, switching network and the action itself are the same slot, so there is never more
+ * than one thing asking to be clicked.
+ */
+export const PrimaryAction = ({ label, pendingLabel, onClick, isPending, disabled }: PrimaryActionProps) => {
+  const { isConnected, chainId: walletChainId } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+  const { openConnectModal } = useConnectModal();
+  const { switchChain, isPending: isSwitching } = useSwitchChain();
+
+  if (!isConnected) {
+    return (
+      <button
+        className="btn btn-primary btn-block"
+        onClick={openConnectModal}
+        disabled={!openConnectModal}
+        type="button"
+      >
+        Connect wallet
+      </button>
+    );
+  }
+
+  if (walletChainId !== targetNetwork.id) {
+    return (
+      <button
+        className="btn btn-primary btn-block"
+        onClick={() => switchChain({ chainId: targetNetwork.id })}
+        disabled={isSwitching}
+        type="button"
+      >
+        {isSwitching && <span className="loading loading-spinner loading-xs" />}
+        Switch to {targetNetwork.name}
+      </button>
+    );
+  }
+
+  return (
+    <button className="btn btn-primary btn-block" onClick={onClick} disabled={disabled || isPending} type="button">
+      {isPending && <span className="loading loading-spinner loading-xs" />}
+      {isPending ? pendingLabel : label}
+    </button>
+  );
+};
