diff --git a/packages/nextjs/hooks/useStakeActions.ts b/packages/nextjs/hooks/useStakeActions.ts
new file mode 100644
index 0000000..d9a1b2c
--- /dev/null
+++ b/packages/nextjs/hooks/useStakeActions.ts
@@ -0,0 +1,76 @@
+import { useCallback, useState } from "react";
+import type { Staking } from "./useStaking";
+import { erc20Abi } from "viem";
+import { useWriteContract } from "wagmi";
+import { useScaffoldWriteContract, useTargetNetwork, useTransactor } from "~~/hooks/scaffold-eth";
+import { getFriendlyError } from "~~/utils/errors";
+
+export type StakeAction = "approve" | "stake" | "withdraw";
+
+export type StakeActions = ReturnType<typeof useStakeActions>;
+
+/**
+ * The three writes the stake page can make.
+ *
+ * Only one can be in flight at a time, and `pendingAction` stays set from the click until the
+ * receipt is in *and* the page's reads have caught up - releasing it any earlier shows the user a
+ * finished button next to numbers that haven't moved yet.
+ */
+export const useStakeActions = ({ token, stakerAddress, refetch }: Staking) => {
+  const { targetNetwork } = useTargetNetwork();
+  const [pendingAction, setPendingAction] = useState<StakeAction | null>(null);
+  const [error, setError] = useState<string | null>(null);
+
+  const writeTx = useTransactor();
+  const { writeContractAsync: writeToken } = useWriteContract();
+  const { writeContractAsync: writeStaker } = useScaffoldWriteContract({ contractName: "Staker" });
+
+  /** Resolves true only once the transaction confirmed and the page's reads caught up. */
+  const run = useCallback(
+    async (action: StakeAction, send: () => Promise<unknown>) => {
+      setPendingAction(action);
+      setError(null);
+      try {
+        await send();
+        await refetch();
+        return true;
+      } catch (e) {
+        setError(getFriendlyError(e));
+        return false;
+      } finally {
+        setPendingAction(null);
+      }
+    },
+    [refetch],
+  );
+
+  const approve = useCallback(
+    (amount: bigint) =>
+      run("approve", () => {
+        if (!token || !stakerAddress) throw new Error("The vault isn't ready yet. Reload and try again.");
+        // Approving exactly what is about to be staked, rather than an unlimited allowance.
+        return writeTx(() =>
+          writeToken({
+            chainId: targetNetwork.id,
+            address: token.address,
+            abi: erc20Abi,
+            functionName: "approve",
+            args: [stakerAddress, amount],
+          }),
+        );
+      }),
+    [run, token, stakerAddress, writeTx, writeToken, targetNetwork.id],
+  );
+
+  const stake = useCallback(
+    (amount: bigint) => run("stake", () => writeStaker({ functionName: "stake", args: [amount] })),
+    [run, writeStaker],
+  );
+
+  const withdraw = useCallback(
+    () => run("withdraw", () => writeStaker({ functionName: "withdraw" })),
+    [run, writeStaker],
+  );
+
+  return { pendingAction, error, approve, stake, withdraw };
+};
diff --git a/packages/nextjs/hooks/useStaking.ts b/packages/nextjs/hooks/useStaking.ts
new file mode 100644
index 0000000..c8a346e
--- /dev/null
+++ b/packages/nextjs/hooks/useStaking.ts
@@ -0,0 +1,119 @@
+import { useCallback, useEffect } from "react";
+import { useUsdcPrice } from "./useUsdcPrice";
+import { useWatchBalance } from "@scaffold-ui/hooks";
+import { useQueryClient } from "@tanstack/react-query";
+import { type Address, erc20Abi } from "viem";
+import { useAccount, useBlockNumber, useReadContracts } from "wagmi";
+import { useDeployedContractInfo, useScaffoldReadContract, useTargetNetwork } from "~~/hooks/scaffold-eth";
+
+export type Staking = ReturnType<typeof useStaking>;
+
+export type StakingToken = {
+  address: Address;
+  symbol: string;
+  decimals: number;
+};
+
+/**
+ * Everything the stake page reads, for the network the app is currently pointed at.
+ *
+ * The staking token is not hardcoded: it is read from the deployed Staker, so the page shows the
+ * real USDC on Base and the local mock on hardhat without either being configured twice. Its
+ * symbol and decimals come from the token itself for the same reason.
+ */
+export const useStaking = () => {
+  const { address: connectedAddress } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+  const chainId = targetNetwork.id;
+
+  const { data: stakerContract, isLoading: isStakerLoading } = useDeployedContractInfo({ contractName: "Staker" });
+  const stakerAddress = stakerContract?.address;
+
+  const { data: stakingTokenAddress } = useScaffoldReadContract({ contractName: "Staker", functionName: "token" });
+  const tokenAddress = stakingTokenAddress as Address | undefined;
+
+  const { data: tokenMetadata } = useReadContracts({
+    allowFailure: false,
+    contracts: [
+      { chainId, address: tokenAddress, abi: erc20Abi, functionName: "decimals" },
+      { chainId, address: tokenAddress, abi: erc20Abi, functionName: "symbol" },
+    ],
+    // Neither value can change for a deployed token, so this only ever needs fetching once.
+    query: { enabled: Boolean(tokenAddress), staleTime: Infinity, gcTime: Infinity },
+  });
+
+  const {
+    data: accountTokenState,
+    queryKey: accountTokenStateQueryKey,
+    refetch: refetchAccountTokenState,
+  } = useReadContracts({
+    allowFailure: false,
+    contracts: [
+      {
+        chainId,
+        address: tokenAddress,
+        abi: erc20Abi,
+        functionName: "balanceOf",
+        args: [connectedAddress as Address],
+      },
+      {
+        chainId,
+        address: tokenAddress,
+        abi: erc20Abi,
+        functionName: "allowance",
+        args: [connectedAddress as Address, stakerAddress as Address],
+      },
+    ],
+    query: { enabled: Boolean(tokenAddress && connectedAddress && stakerAddress) },
+  });
+
+  const queryClient = useQueryClient();
+  const { data: blockNumber } = useBlockNumber({ watch: true, chainId });
+  useEffect(() => {
+    void queryClient.invalidateQueries({ queryKey: accountTokenStateQueryKey });
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [blockNumber]);
+
+  const { data: staked, refetch: refetchStaked } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "stakedBalance",
+    args: [connectedAddress],
+  });
+
+  const { data: totalStaked, refetch: refetchTotalStaked } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "totalStaked",
+  });
+
+  const { data: ethBalance, refetch: refetchEthBalance } = useWatchBalance({
+    address: connectedAddress,
+    chain: targetNetwork,
+  });
+
+  const usdcPrice = useUsdcPrice();
+
+  // Held by the callers of stake/withdraw until every number on the page reflects the new state,
+  // so the button never releases into stale balances.
+  const refetch = useCallback(async () => {
+    await Promise.all([refetchAccountTokenState(), refetchStaked(), refetchTotalStaked(), refetchEthBalance()]);
+  }, [refetchAccountTokenState, refetchStaked, refetchTotalStaked, refetchEthBalance]);
+
+  const token: StakingToken | undefined =
+    tokenAddress && tokenMetadata
+      ? { address: tokenAddress, decimals: tokenMetadata[0], symbol: tokenMetadata[1] }
+      : undefined;
+
+  return {
+    stakerAddress,
+    isStakerDeployed: Boolean(stakerAddress),
+    isStakerLoading,
+    token,
+    walletBalance: accountTokenState?.[0],
+    allowance: accountTokenState?.[1],
+    staked: staked as bigint | undefined,
+    totalStaked: totalStaked as bigint | undefined,
+    ethBalance: ethBalance?.value,
+    usdcPrice,
+    refetch,
+  };
+};
diff --git a/packages/nextjs/hooks/useUsdcPrice.ts b/packages/nextjs/hooks/useUsdcPrice.ts
new file mode 100644
index 0000000..8c6c57a
--- /dev/null
+++ b/packages/nextjs/hooks/useUsdcPrice.ts
@@ -0,0 +1,86 @@
+import { useEffect, useMemo, useState } from "react";
+import { formatUnits } from "viem";
+import { base } from "viem/chains";
+import { useReadContracts } from "wagmi";
+
+/**
+ * Chainlink USDC/USD aggregator proxy on Base.
+ * https://docs.chain.link/data-feeds/price-feeds/addresses?network=base
+ */
+const USDC_USD_FEED = "0x458138Fc0D67027E9A6778ef40a6ffC318c69061";
+
+/** The feed's published heartbeat: it is rewritten at least this often, so an older answer is suspect. */
+const HEARTBEAT_SECONDS = 86_400;
+
+const AGGREGATOR_V3_ABI = [
+  {
+    type: "function",
+    name: "decimals",
+    stateMutability: "view",
+    inputs: [],
+    outputs: [{ type: "uint8" }],
+  },
+  {
+    type: "function",
+    name: "latestRoundData",
+    stateMutability: "view",
+    inputs: [],
+    outputs: [
+      { name: "roundId", type: "uint80" },
+      { name: "answer", type: "int256" },
+      { name: "startedAt", type: "uint256" },
+      { name: "updatedAt", type: "uint256" },
+      { name: "answeredInRound", type: "uint80" },
+    ],
+  },
+] as const;
+
+export type UsdcPrice = {
+  /** USD per USDC, or null when no answer we can trust is available. */
+  price: number | null;
+  isLoading: boolean;
+  /** The feed answered, but later than its heartbeat promises. Show the number and flag it. */
+  isStale: boolean;
+};
+
+/**
+ * USD price of USDC, read from Chainlink on Base.
+ *
+ * It is always read from Base regardless of the network the user is on, so amounts still carry a
+ * real price while developing against the local chain. USDC is a dollar peg, not a dollar: it has
+ * traded off peg before, which is exactly when a user would want to see the number.
+ */
+export const useUsdcPrice = (): UsdcPrice => {
+  // Wall-clock time, kept in state so rendering stays pure and the server doesn't stamp a time
+  // into the markup that the client would then disagree with.
+  const [nowSeconds, setNowSeconds] = useState<number | null>(null);
+  useEffect(() => {
+    const tick = () => setNowSeconds(Math.floor(Date.now() / 1000));
+    tick();
+    const interval = setInterval(tick, 60_000);
+    return () => clearInterval(interval);
+  }, []);
+
+  const { data, isLoading } = useReadContracts({
+    allowFailure: false,
+    contracts: [
+      { chainId: base.id, address: USDC_USD_FEED, abi: AGGREGATOR_V3_ABI, functionName: "decimals" },
+      { chainId: base.id, address: USDC_USD_FEED, abi: AGGREGATOR_V3_ABI, functionName: "latestRoundData" },
+    ],
+    query: { refetchInterval: 60_000 },
+  });
+
+  return useMemo(() => {
+    if (!data) return { price: null, isLoading, isStale: false };
+
+    const [decimals, [, answer, , updatedAt]] = data;
+    // A non-positive answer means the feed has nothing valid to report; treat it as no price at all.
+    if (answer <= 0n) return { price: null, isLoading: false, isStale: false };
+
+    return {
+      price: Number(formatUnits(answer, decimals)),
+      isLoading: false,
+      isStale: nowSeconds !== null && nowSeconds - Number(updatedAt) > HEARTBEAT_SECONDS,
+    };
+  }, [data, isLoading, nowSeconds]);
+};
