@@ -0,0 +1,86 @@
+"use client";
+
+import { useState } from "react";
+import { BalanceTiles } from "./BalanceTiles";
+import { StakeForm } from "./StakeForm";
+import { VaultDetails } from "./VaultDetails";
+import { WithdrawPanel } from "./WithdrawPanel";
+import { hardhat } from "viem/chains";
+import { ExclamationTriangleIcon } from "@heroicons/react/24/outline";
+import { useTargetNetwork } from "~~/hooks/scaffold-eth";
+import { useStakeActions } from "~~/hooks/useStakeActions";
+import { useStaking } from "~~/hooks/useStaking";
+
+type Tab = "stake" | "withdraw";
+
+export const StakeApp = () => {
+  const { targetNetwork } = useTargetNetwork();
+  const staking = useStaking();
+  const actions = useStakeActions(staking);
+  const [tab, setTab] = useState<Tab>("stake");
+
+  const isBusy = actions.pendingAction !== null;
+  const isMissingVault = !staking.isStakerLoading && !staking.isStakerDeployed;
+
+  return (
+    <div className="w-full max-w-2xl mx-auto px-4 py-8 flex flex-col gap-6">
+      <header className="flex flex-col gap-1">
+        <div className="flex items-center gap-3">
+          <h1 className="text-3xl font-bold m-0">Stake USDC</h1>
+          <span className="badge badge-outline">{targetNetwork.name}</span>
+        </div>
+        <p className="m-0 opacity-70">
+          Deposit USDC into the vault and take your whole position back whenever you want. No lockup, no fees, and no
+          rewards — the vault holds your deposit 1:1 and nobody else can move it.
+        </p>
+      </header>
+
+      <BalanceTiles staking={staking} />
+
+      {isMissingVault && (
+        <div className="flex items-start gap-2 bg-base-100 border border-warning p-4 text-sm">
+          <ExclamationTriangleIcon className="h-5 w-5 shrink-0 text-warning" />
+          <span>
+            The vault isn&apos;t deployed on {targetNetwork.name} yet, so staking is unavailable here.
+            {targetNetwork.id === hardhat.id
+              ? " Run yarn chain and yarn deploy to put it on your local chain."
+              : " Switch networks, or deploy it with yarn deploy --network base."}
+          </span>
+        </div>
+      )}
+
+      <div className="bg-base-100 border border-base-300 flex flex-col">
+        <div role="tablist" className="tabs tabs-border grid grid-cols-2">
+          <button
+            role="tab"
+            type="button"
+            className={`tab ${tab === "stake" ? "tab-active" : ""}`}
+            onClick={() => setTab("stake")}
+            disabled={isBusy}
+          >
+            Stake
+          </button>
+          <button
+            role="tab"
+            type="button"
+            className={`tab ${tab === "withdraw" ? "tab-active" : ""}`}
+            onClick={() => setTab("withdraw")}
+            disabled={isBusy}
+          >
+            Withdraw
+          </button>
+        </div>
+
+        <div className="p-5">
+          {tab === "stake" ? (
+            <StakeForm staking={staking} actions={actions} />
+          ) : (
+            <WithdrawPanel staking={staking} actions={actions} />
+          )}
+        </div>
+      </div>
+
+      <VaultDetails staking={staking} />
+    </div>
+  );
+};
diff --git a/packages/nextjs/app/stake/_components/StakeForm.tsx b/packages/nextjs/app/stake/_components/StakeForm.tsx
new file mode 100644
index 0000000..5e43ee2
--- /dev/null
+++ b/packages/nextjs/app/stake/_components/StakeForm.tsx
@@ -0,0 +1,133 @@
+"use client";
+
+import { useMemo, useState } from "react";
+import { PrimaryAction } from "./PrimaryAction";
+import { UsdValue } from "./UsdValue";
+import { formatUnits } from "viem";
+import type { StakeActions } from "~~/hooks/useStakeActions";
+import type { Staking } from "~~/hooks/useStaking";
+import { formatTokenAmount, toNumber } from "~~/utils/format";
+import { parseTokenAmount } from "~~/utils/parseTokenAmount";
+
+type StakeFormProps = {
+  staking: Staking;
+  actions: StakeActions;
+};
+
+export const StakeForm = ({ staking, actions }: StakeFormProps) => {
+  const { token, walletBalance, allowance, usdcPrice, isStakerDeployed } = staking;
+  const { pendingAction, error, approve, stake } = actions;
+  const [amount, setAmount] = useState("");
+
+  const parsed = useMemo(() => parseTokenAmount(amount, token, walletBalance), [amount, token, walletBalance]);
+
+  const symbol = token?.symbol ?? "USDC";
+  const hasEmptyWallet = walletBalance === 0n;
+  // Read from the chain every block, never remembered from a previous approval in this session.
+  const needsApproval = parsed.value !== undefined && allowance !== undefined && allowance < parsed.value;
+  const isBusy = pendingAction !== null;
+
+  // What the button says it will do, normalised out of whatever the user typed.
+  const amountLabel = parsed.value !== undefined && token ? formatTokenAmount(parsed.value, token.decimals) : "";
+
+  const setMax = () => {
+    if (walletBalance === undefined || !token) return;
+    setAmount(formatUnits(walletBalance, token.decimals));
+  };
+
+  const handleStake = async () => {
+    if (parsed.value === undefined) return;
+    if (await stake(parsed.value)) setAmount("");
+  };
+
+  return (
+    <div className="flex flex-col gap-4">
+      <div className="flex flex-col gap-1">
+        <div className="flex items-baseline justify-between text-sm">
+          <label htmlFor="stake-amount" className="font-medium">
+            Amount to stake
+          </label>
+          {walletBalance !== undefined && token && (
+            <span className="opacity-60">
+              Balance {formatTokenAmount(walletBalance, token.decimals)} {symbol}
+            </span>
+          )}
+        </div>
+
+        <label
+          className={`input input-bordered flex items-center gap-2 w-full ${parsed.error ? "input-error" : ""}`}
+          htmlFor="stake-amount"
+        >
+          <input
+            id="stake-amount"
+            className="grow"
+            type="text"
+            inputMode="decimal"
+            autoComplete="off"
+            placeholder="0.00"
+            value={amount}
+            onChange={event => setAmount(event.target.value)}
+            disabled={isBusy}
+          />
+          <span className="text-sm opacity-60">{symbol}</span>
+          <button
+            type="button"
+            className="btn btn-xs"
+            onClick={setMax}
+            disabled={isBusy || walletBalance === undefined || hasEmptyWallet}
+          >
+            Max
+          </button>
+        </label>
+
+        <div className="min-h-5 text-xs">
+          {parsed.error ? (
+            <span className="text-error">{parsed.error}</span>
+          ) : parsed.value !== undefined && token ? (
+            <UsdValue
+              amount={toNumber(parsed.value, token.decimals)}
+              price={usdcPrice.price}
+              isPriceLoading={usdcPrice.isLoading}
+              isPriceStale={usdcPrice.isStale}
+            />
+          ) : hasEmptyWallet ? (
+            <span className="opacity-60">You don&apos;t have any {symbol} in this wallet yet.</span>
+          ) : null}
+        </div>
+      </div>
+
+      {needsApproval ? (
+        <>
+          <PrimaryAction
+            label={`Approve ${amountLabel} ${symbol}`}
+            pendingLabel="Approving…"
+            onClick={() => parsed.value !== undefined && approve(parsed.value)}
+            isPending={pendingAction === "approve"}
+            disabled={isBusy || !isStakerDeployed}
+          />
+          <p className="m-0 text-xs opacity-60">
+            Step 1 of 2. Approval lets the vault move exactly this amount of {symbol} — nothing more.
+          </p>
+        </>
+      ) : (
+        <>
+          <PrimaryAction
+            label={parsed.value === undefined ? "Stake" : `Stake ${amountLabel} ${symbol}`}
+            pendingLabel="Staking…"
+            onClick={handleStake}
+            isPending={pendingAction === "stake"}
+            disabled={isBusy || parsed.value === undefined || !isStakerDeployed}
+          />
+          {parsed.value === undefined && !parsed.error && (
+            <p className="m-0 text-xs opacity-60">Enter an amount to stake.</p>
+          )}
+          {parsed.value !== undefined && allowance !== undefined && allowance > 0n && (
+            <p className="m-0 text-xs opacity-60">Step 2 of 2. The vault is approved for this amount.</p>
+          )}
+        </>
+      )}
+
+      {error && <p className="m-0 text-sm text-error whitespace-pre-line">{error}</p>}
+    </div>
+  );
+};
diff --git a/packages/nextjs/app/stake/_components/UsdValue.tsx b/packages/nextjs/app/stake/_components/UsdValue.tsx
