@@ -0,0 +1,35 @@
+import { formatUsd } from "~~/utils/format";
+
+type UsdValueProps = {
+  /** Token amount already converted out of base units, or undefined while it is still loading. */
+  amount?: number;
+  price: number | null;
+  isPriceLoading: boolean;
+  isPriceStale?: boolean;
+  className?: string;
+};
+
+/**
+ * The fiat line under a token amount.
+ *
+ * A price we do not have is said out loud rather than dropped, because a missing "≈ $1,000" reads
+ * exactly like a balance that is worth nothing.
+ */
+export const UsdValue = ({ amount, price, isPriceLoading, isPriceStale, className = "" }: UsdValueProps) => {
+  if (amount === undefined) return null;
+
+  if (isPriceLoading) {
+    return <span className={`text-xs opacity-50 ${className}`}>fetching USD price…</span>;
+  }
+
+  if (price === null) {
+    return <span className={`text-xs text-warning ${className}`}>USD price unavailable</span>;
+  }
+
+  return (
+    <span className={`text-xs opacity-70 ${className}`}>
+      ≈ {formatUsd(amount * price)}
+      {isPriceStale && <span className="text-warning"> · price over 24h old</span>}
+    </span>
+  );
+};
