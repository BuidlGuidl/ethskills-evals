+++ b/packages/hardhat/contracts/MockUSDC.sol
@@ -0,0 +1,27 @@
+//SPDX-License-Identifier: MIT
+pragma solidity 0.8.30;
+
+import { ERC20 } from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+
+/**
+ * Stand-in for Circle's USDC, used only on the local chain.
+ *
+ * Matches the real token where it matters for the app: same name, same symbol, and 6 decimals -
+ * so amounts entered in the UI go through the same `parseUnits`/`formatUnits` path as on Base.
+ *
+ * `mint` is deliberately unrestricted so any local account can fund itself.
+ * The deploy script only ever deploys this on chain 31337; never point it at a live network.
+ *
+ * @author BuidlGuidl
+ */
+contract MockUSDC is ERC20 {
+    constructor() ERC20("USD Coin", "USDC") {}
+
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    function mint(address to, uint256 amount) external {
+        _mint(to, amount);
+    }
+}
diff --git a/packages/hardhat/contracts/Staker.sol b/packages/hardhat/contracts/Staker.sol
new file mode 100644
index 0000000..2fec49d
--- /dev/null
+++ b/packages/hardhat/contracts/Staker.sol
@@ -0,0 +1,71 @@
+//SPDX-License-Identifier: MIT
+pragma solidity 0.8.30;
+
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { SafeERC20 } from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+
+/**
+ * Minimal single-token staking vault, deployed against USDC on Base.
+ *
+ * Deposits are held 1:1 and the full position can be withdrawn at any time. There are no rewards,
+ * no lockup, no fees and no owner: nobody, including the deployer, can move a staker's funds.
+ *
+ * Assumes a plain, non-rebasing, non fee-on-transfer ERC-20 (which USDC is). A fee-on-transfer
+ * token would credit more than the vault actually received and leave the last stakers short.
+ *
+ * @author BuidlGuidl
+ */
+contract Staker {
+    using SafeERC20 for IERC20;
+
+    /// @notice The token being staked (USDC on Base).
+    IERC20 public immutable token;
+
+    /// @notice Amount currently staked per account, in the token's own decimals (6 for USDC).
+    mapping(address account => uint256 amount) public stakedBalance;
+
+    /// @notice Sum of every open position. Equals the vault's token balance.
+    uint256 public totalStaked;
+
+    event Staked(address indexed account, uint256 amount);
+    event Withdrawn(address indexed account, uint256 amount);
+
+    error ZeroAddress();
+    error ZeroAmount();
+    error NothingStaked();
+
+    constructor(IERC20 _token) {
+        if (address(_token) == address(0)) revert ZeroAddress();
+        token = _token;
+    }
+
+    /**
+     * Pulls `amount` of token from the caller and credits their position.
+     * The caller must have approved this contract for at least `amount` first.
+     */
+    function stake(uint256 amount) external {
+        if (amount == 0) revert ZeroAmount();
+
+        stakedBalance[msg.sender] += amount;
+        totalStaked += amount;
+
+        emit Staked(msg.sender, amount);
+
+        token.safeTransferFrom(msg.sender, address(this), amount);
+    }
+
+    /**
+     * Returns the caller's entire position to them. Reverts if they have nothing staked.
+     */
+    function withdraw() external {
+        uint256 amount = stakedBalance[msg.sender];
+        if (amount == 0) revert NothingStaked();
+
+        stakedBalance[msg.sender] = 0;
+        totalStaked -= amount;
+
+        emit Withdrawn(msg.sender, amount);
+
+        token.safeTransfer(msg.sender, amount);
+    }
+}
diff --git a/packages/hardhat/deploy/00_deploy_staker.ts b/packages/hardhat/deploy/00_deploy_staker.ts
new file mode 100644
index 0000000..91d0c81
--- /dev/null
+++ b/packages/hardhat/deploy/00_deploy_staker.ts
@@ -0,0 +1,64 @@
+import { artifacts, deployScript } from "../rocketh/deploy.js";
+
+const HARDHAT_CHAIN_ID = 31337;
+
+/**
+ * Circle's canonical USDC per chain. Anything not listed here has no USDC we trust, so the
+ * script refuses to deploy rather than silently staking against the wrong token.
+ */
+const USDC_BY_CHAIN_ID: Record<number, `0x${string}`> = {
+  8453: "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913", // Base
+  84532: "0x036CbD53842c5426634e7929541eC2318f3dCF7e", // Base Sepolia
+};
+
+/** Seed for the local chain: 100k mock USDC (6 decimals) for the deployer to play with. */
+const LOCAL_MINT_AMOUNT = 100_000_000_000n;
+
+/**
+ * Deploys the Staker against USDC. On the local chain there is no USDC, so a faithful
+ * 6-decimal mock is deployed first and the deployer is funded with it.
+ */
+export default deployScript(
+  async env => {
+    const { deployer } = env.namedAccounts;
+    const chainId = env.network.chain.id;
+
+    let usdcAddress = USDC_BY_CHAIN_ID[chainId];
+
+    if (!usdcAddress) {
+      if (chainId !== HARDHAT_CHAIN_ID) {
+        throw new Error(
+          `No USDC address configured for chain ${chainId}. Add it to USDC_BY_CHAIN_ID in ` +
+            `packages/hardhat/deploy/00_deploy_staker.ts before deploying there.`,
+        );
+      }
+
+      const mockUsdc = await env.deploy("MockUSDC", {
+        account: deployer,
+        artifact: artifacts.MockUSDC,
+        args: [],
+      });
+      usdcAddress = mockUsdc.address;
+
+      await env.execute(mockUsdc, {
+        functionName: "mint",
+        args: [deployer, LOCAL_MINT_AMOUNT],
+        account: deployer,
+      });
+
+      console.log("🪙 Local MockUSDC deployed at", usdcAddress, "and 100,000 USDC minted to the deployer");
+    }
+
+    const staker = await env.deploy("Staker", {
+      account: deployer,
+      artifact: artifacts.Staker,
+      args: [usdcAddress],
+    });
+
+    console.log("🔒 Staker deployed at", staker.address, "staking USDC at", usdcAddress);
+  },
+  {
+    // e.g. yarn deploy --tags Staker
+    tags: ["Staker"],
+  },
+);
diff --git a/packages/hardhat/test/Staker.ts b/packages/hardhat/test/Staker.ts
new file mode 100644
index 0000000..61c1d80
--- /dev/null
+++ b/packages/hardhat/test/Staker.ts
@@ -0,0 +1,119 @@
+import { expect } from "chai";
+import type { BaseContract, Signer } from "ethers";
+import { network } from "hardhat";
+import type { Abi_MockUSDC } from "../generated/abis/MockUSDC.js";
+import type { Abi_Staker } from "../generated/abis/Staker.js";
+import { loadAndExecuteDeploymentsFromFiles } from "../rocketh/environment.js";
+
+const { provider, networkHelpers, ethers } = await network.create();
+
+const usdc = (whole: number) => BigInt(whole) * 1_000_000n;
+
+/** ethers v6 widens `connect()` to BaseContract, which drops the contract's generated methods. */
+const connectAs = <T extends BaseContract>(contract: T, signer: Signer) => contract.connect(signer) as T;
+
+async function deployFixture() {
+  const env = await loadAndExecuteDeploymentsFromFiles({ provider });
+
+  const stakerDeployment = env.get<Abi_Staker>("Staker");
+  const usdcDeployment = env.get<Abi_MockUSDC>("MockUSDC");
+
+  const staker = await ethers.getContractAt(stakerDeployment.abi, stakerDeployment.address);
+  const mockUsdc = await ethers.getContractAt(usdcDeployment.abi, usdcDeployment.address);
+
+  const [deployer, alice, bob] = await ethers.getSigners();
+  for (const account of [alice, bob]) {
+    await mockUsdc.mint(account.address, usdc(1_000));
+  }
+
+  return { staker, mockUsdc, deployer, alice, bob };
+}
+
+describe("Staker", function () {
+  it("stakes against the mock USDC deployed alongside it", async function () {
+    const { staker, mockUsdc } = await networkHelpers.loadFixture(deployFixture);
+
+    expect(await staker.token()).to.equal(ethers.getAddress(await mockUsdc.getAddress()));
+    expect(await mockUsdc.decimals()).to.equal(6n);
+  });
+
+  it("moves tokens into the vault and credits the staker", async function () {
+    const { staker, mockUsdc, alice } = await networkHelpers.loadFixture(deployFixture);
+    const stakerAddress = await staker.getAddress();
+
+    await connectAs(mockUsdc, alice).approve(stakerAddress, usdc(250));
+    await expect(connectAs(staker, alice).stake(usdc(250)))
+      .to.emit(staker, "Staked")
+      .withArgs(alice.address, usdc(250));
+
+    expect(await staker.stakedBalance(alice.address)).to.equal(usdc(250));
+    expect(await staker.totalStaked()).to.equal(usdc(250));
+    expect(await mockUsdc.balanceOf(stakerAddress)).to.equal(usdc(250));
+    expect(await mockUsdc.balanceOf(alice.address)).to.equal(usdc(750));
+  });
+
+  it("adds to an existing position", async function () {
+    const { staker, mockUsdc, alice } = await networkHelpers.loadFixture(deployFixture);
+    const stakerAddress = await staker.getAddress();
+
+    await connectAs(mockUsdc, alice).approve(stakerAddress, usdc(300));
+    await connectAs(staker, alice).stake(usdc(100));
+    await connectAs(staker, alice).stake(usdc(200));
+
+    expect(await staker.stakedBalance(alice.address)).to.equal(usdc(300));
+    expect(await staker.totalStaked()).to.equal(usdc(300));
+  });
+
+  it("rejects a zero stake", async function () {
+    const { staker, alice } = await networkHelpers.loadFixture(deployFixture);
+
+    await expect(connectAs(staker, alice).stake(0)).to.be.revertedWithCustomError(staker, "ZeroAmount");
+  });
+
+  it("rejects a stake that was not approved", async function () {
+    const { staker, mockUsdc, alice } = await networkHelpers.loadFixture(deployFixture);
+
+    await expect(connectAs(staker, alice).stake(usdc(1))).to.be.revertedWithCustomError(
+      mockUsdc,
+      "ERC20InsufficientAllowance",
+    );
+  });
+
+  it("returns the whole position on withdraw", async function () {
+    const { staker, mockUsdc, alice } = await networkHelpers.loadFixture(deployFixture);
+    const stakerAddress = await staker.getAddress();
+
+    await connectAs(mockUsdc, alice).approve(stakerAddress, usdc(400));
+    await connectAs(staker, alice).stake(usdc(400));
+
+    await expect(connectAs(staker, alice).withdraw()).to.emit(staker, "Withdrawn").withArgs(alice.address, usdc(400));
+
+    expect(await staker.stakedBalance(alice.address)).to.equal(0n);
+    expect(await staker.totalStaked()).to.equal(0n);
+    expect(await mockUsdc.balanceOf(alice.address)).to.equal(usdc(1_000));
+    expect(await mockUsdc.balanceOf(stakerAddress)).to.equal(0n);
+  });
+
+  it("rejects a withdraw with nothing staked", async function () {
+    const { staker, bob } = await networkHelpers.loadFixture(deployFixture);
+
+    await expect(connectAs(staker, bob).withdraw()).to.be.revertedWithCustomError(staker, "NothingStaked");
+  });
+
+  it("keeps positions separate between stakers", async function () {
+    const { staker, mockUsdc, alice, bob } = await networkHelpers.loadFixture(deployFixture);
+    const stakerAddress = await staker.getAddress();
+
+    await connectAs(mockUsdc, alice).approve(stakerAddress, usdc(100));
+    await connectAs(mockUsdc, bob).approve(stakerAddress, usdc(600));
+    await connectAs(staker, alice).stake(usdc(100));
+    await connectAs(staker, bob).stake(usdc(600));
+
+    await connectAs(staker, alice).withdraw();
+
+    expect(await staker.stakedBalance(alice.address)).to.equal(0n);
+    expect(await staker.stakedBalance(bob.address)).to.equal(usdc(600));
+    expect(await staker.totalStaked()).to.equal(usdc(600));
+    expect(await mockUsdc.balanceOf(stakerAddress)).to.equal(usdc(600));
+  });
+});
