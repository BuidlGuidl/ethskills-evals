new file mode 100644
index 0000000..18dc485
--- /dev/null
+++ b/packages/nextjs/utils/errors.ts
@@ -0,0 +1,22 @@
+import { getParsedError } from "~~/utils/scaffold-eth";
+
+/**
+ * The reverts and wallet failures this app can actually produce, in words a user can act on.
+ * Anything unmatched falls through to viem's own message rather than a generic apology.
+ */
+const KNOWN_FAILURES: [RegExp, string][] = [
+  [/User rejected|rejected the request|denied transaction/i, "You rejected the transaction in your wallet."],
+  [/ZeroAmount/, "Enter an amount greater than zero."],
+  [/NothingStaked/, "You don't have anything staked to withdraw."],
+  [/ERC20InsufficientAllowance/, "The vault isn't approved for that amount yet. Approve it and try again."],
+  [/ERC20InsufficientBalance|transfer amount exceeds balance/i, "That's more than your token balance."],
+  [/insufficient funds/i, "Not enough ETH in this wallet to pay for gas."],
+  [/blacklisted/i, "This address is blocked by USDC's issuer and cannot move the token."],
+  [/paused/i, "USDC transfers are currently paused by the issuer. Try again later."],
+];
+
+export const getFriendlyError = (error: unknown): string => {
+  const parsed = getParsedError(error);
+  const known = KNOWN_FAILURES.find(([pattern]) => pattern.test(parsed));
+  return known ? known[1] : parsed;
+};
diff --git a/packages/nextjs/utils/format.ts b/packages/nextjs/utils/format.ts
new file mode 100644
index 0000000..374aad8
--- /dev/null
+++ b/packages/nextjs/utils/format.ts
@@ -0,0 +1,16 @@
+import { formatEther, formatUnits } from "viem";
+
+const tokenFormatter = new Intl.NumberFormat("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 6 });
+const ethFormatter = new Intl.NumberFormat("en-US", { minimumFractionDigits: 4, maximumFractionDigits: 4 });
+const usdFormatter = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" });
+
+/** Token amounts are converted at the token's own decimals, never rendered as base units. */
+export const formatTokenAmount = (value: bigint, decimals: number) =>
+  tokenFormatter.format(Number(formatUnits(value, decimals)));
+
+export const formatEthAmount = (value: bigint) => ethFormatter.format(Number(formatEther(value)));
+
+/** Rounds to cents, but never rounds a non-zero holding down to "$0.00". */
+export const formatUsd = (value: number) => (value > 0 && value < 0.01 ? "<$0.01" : usdFormatter.format(value));
+
+export const toNumber = (value: bigint, decimals: number) => Number(formatUnits(value, decimals));
diff --git a/packages/nextjs/utils/parseTokenAmount.ts b/packages/nextjs/utils/parseTokenAmount.ts
new file mode 100644
index 0000000..d163cdb
--- /dev/null
+++ b/packages/nextjs/utils/parseTokenAmount.ts
@@ -0,0 +1,38 @@
+import { parseUnits } from "viem";
+
+export type ParsedTokenAmount = {
+  /** Base units, only set when the input is a usable amount. */
+  value?: bigint;
+  /** Why the input was rejected. Never set while the field is empty. */
+  error?: string;
+};
+
+const NUMERIC = /^(\d+(\.\d*)?|\.\d+)$/;
+
+/**
+ * Turns what the user typed into base units, or into the reason it can't be used.
+ *
+ * Every rejection has a message: a disabled button with no explanation is the thing that makes
+ * people think the app is broken.
+ */
+export const parseTokenAmount = (
+  input: string,
+  token?: { symbol: string; decimals: number },
+  balance?: bigint,
+): ParsedTokenAmount => {
+  const trimmed = input.trim();
+  if (!trimmed || !token) return {};
+
+  if (!NUMERIC.test(trimmed)) return { error: "Enter a number, for example 250.50" };
+
+  const [, fraction = ""] = trimmed.split(".");
+  if (fraction.length > token.decimals) {
+    return { error: `${token.symbol} only goes to ${token.decimals} decimal places` };
+  }
+
+  const value = parseUnits(trimmed, token.decimals);
+  if (value === 0n) return { error: "Enter an amount greater than zero" };
+  if (balance !== undefined && value > balance) return { error: `That's more than your ${token.symbol} balance` };
+
+  return { value };
+};
