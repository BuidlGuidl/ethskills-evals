+import { ImageResponse } from "next/og";
+
+export const alt = "Baseline — stake USDC on Base";
+export const size = { width: 1200, height: 630 };
+export const contentType = "image/png";
+
+/** The link preview for every route. Rendered at build time so it never depends on a design tool. */
+const OpengraphImage = () =>
+  new ImageResponse(
+    <div
+      style={{
+        width: "100%",
+        height: "100%",
+        display: "flex",
+        flexDirection: "column",
+        justifyContent: "center",
+        padding: "80px",
+        background: "#0B1A3A",
+        color: "#F9FBFF",
