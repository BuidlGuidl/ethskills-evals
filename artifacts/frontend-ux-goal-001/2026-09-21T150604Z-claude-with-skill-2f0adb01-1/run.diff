diff --git a/packages/nextjs/app/stake/_components/StakeDashboard.tsx b/packages/nextjs/app/stake/_components/StakeDashboard.tsx
new file mode 100644
index 0000000..d1eaab1
--- /dev/null
+++ b/packages/nextjs/app/stake/_components/StakeDashboard.tsx
@@ -0,0 +1,144 @@
+"use client";
+
+import { StakeForm } from "./StakeForm";
+import { WithdrawCard } from "./WithdrawCard";
+import { formatTokenAmount, formatUsd, formatUsdc, usdcToUsd } from "./utils";
+import { Address } from "@scaffold-ui/components";
+import { useFetchNativeCurrencyPrice, useWatchBalance } from "@scaffold-ui/hooks";
+import { formatEther, parseEther } from "viem";
+import { useAccount } from "wagmi";
+import { useDeployedContractInfo, useScaffoldReadContract, useTargetNetwork } from "~~/hooks/scaffold-eth";
+
+// Enough for several stake/withdraw transactions on Base at typical fees.
+const MIN_ETH_FOR_GAS = parseEther("0.0001");
+
+type StatProps = {
+  title: string;
+  value: string;
+  usd?: string;
+  isLoading: boolean;
+};
+
+const Stat = ({ title, value, usd, isLoading }: StatProps) => (
+  <div className="stat">
+    <div className="stat-title">{title}</div>
+    <div className="stat-value text-2xl">
+      {isLoading ? <span className="loading loading-dots loading-md" /> : value}
+    </div>
+    <div className="stat-desc">{usd ? `≈ ${usd}` : " "}</div>
+  </div>
+);
+
+export const StakeDashboard = () => {
+  const { address } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+  const { price: ethPrice } = useFetchNativeCurrencyPrice();
+
+  const { data: staker, isLoading: isStakerLoading } = useDeployedContractInfo({ contractName: "Staker" });
+  const { data: usdc } = useDeployedContractInfo({ contractName: "USDC" });
+
+  const {
+    data: usdcBalance,
+    isLoading: isUsdcLoading,
+    refetch: refetchUsdcBalance,
+  } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "balanceOf",
+    args: [address],
+  });
+  const {
+    data: stakedBalance,
+    isLoading: isStakedLoading,
+    refetch: refetchStakedBalance,
+  } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "balances",
+    args: [address],
+  });
+  const { data: totalStaked, refetch: refetchTotalStaked } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "totalStaked",
+  });
+  const { data: ethBalance, isLoading: isEthLoading } = useWatchBalance({ address, chain: targetNetwork });
+
+  const ethValue = ethBalance?.value;
+  const ethUsd =
+    ethValue !== undefined && ethPrice > 0 ? formatUsd(Number(formatEther(ethValue)) * ethPrice) : undefined;
+  const isLowOnGas = ethValue !== undefined && ethValue < MIN_ETH_FOR_GAS;
+
+  const refetchPositions = () => Promise.all([refetchUsdcBalance(), refetchStakedBalance(), refetchTotalStaked()]);
+
+  if (!isStakerLoading && !staker) {
+    return (
+      <div role="alert" className="alert alert-warning max-w-xl">
+        <span>Staking is not available on {targetNetwork.name} yet. Please check back soon.</span>
+      </div>
+    );
+  }
+
+  return (
+    <div className="w-full max-w-4xl flex flex-col gap-6">
+      <div className="text-center">
+        <h1 className="text-4xl font-bold mb-2">Stake USDC</h1>
+        <p className="text-base-content/70">
+          Deposit USDC on {targetNetwork.name} and withdraw your full position at any time.
+        </p>
+      </div>
+
+      <div className="stats stats-vertical md:stats-horizontal bg-base-100 border border-base-300 shadow-sm w-full">
+        <Stat
+          title="Staked"
+          value={address && stakedBalance !== undefined ? `${formatUsdc(stakedBalance)} USDC` : "—"}
+          usd={address && stakedBalance !== undefined ? usdcToUsd(stakedBalance) : undefined}
+          isLoading={!!address && isStakedLoading}
+        />
+        <Stat
+          title="Wallet USDC"
+          value={address && usdcBalance !== undefined ? `${formatUsdc(usdcBalance)} USDC` : "—"}
+          usd={address && usdcBalance !== undefined ? usdcToUsd(usdcBalance) : undefined}
+          isLoading={!!address && isUsdcLoading}
+        />
+        <Stat
+          title="ETH for gas"
+          value={address && ethValue !== undefined ? `${formatTokenAmount(ethValue, 18, 5)} ETH` : "—"}
+          usd={address ? ethUsd : undefined}
+          isLoading={!!address && isEthLoading}
+        />
+      </div>
+
+      {address && isLowOnGas && (
+        <div role="alert" className="alert alert-warning">
+          <span>
+            You need a small amount of ETH on {targetNetwork.name} to pay network fees for staking and withdrawing. Add
+            some ETH to this wallet before continuing.
+          </span>
+        </div>
+      )}
+
+      <div className="grid gap-6 md:grid-cols-2">
+        <StakeForm usdcBalance={usdcBalance} stakerAddress={staker?.address} onStaked={refetchPositions} />
+        <WithdrawCard stakedBalance={stakedBalance} onWithdrawn={refetchPositions} />
+      </div>
+
+      <div className="text-sm text-base-content/70 flex flex-col gap-2 items-center">
+        {totalStaked !== undefined && (
+          <span>
+            Total staked by all users: {formatUsdc(totalStaked)} USDC (≈ {usdcToUsd(totalStaked)})
+          </span>
+        )}
+        <div className="flex flex-wrap justify-center gap-x-6 gap-y-2">
+          {staker && (
+            <span className="flex items-center gap-2">
+              Staking contract: <Address address={staker.address} chain={targetNetwork} size="sm" />
+            </span>
+          )}
+          {usdc && (
+            <span className="flex items-center gap-2">
+              USDC: <Address address={usdc.address} chain={targetNetwork} size="sm" />
+            </span>
+          )}
+        </div>
+      </div>
+    </div>
+  );
+};
diff --git a/packages/nextjs/app/stake/_components/StakeForm.tsx b/packages/nextjs/app/stake/_components/StakeForm.tsx
new file mode 100644
index 0000000..059d3a2
--- /dev/null
+++ b/packages/nextjs/app/stake/_components/StakeForm.tsx
@@ -0,0 +1,174 @@
+"use client";
+
+import { useState } from "react";
+import { WalletGate } from "./WalletGate";
+import { USDC_DECIMALS, formatUsdc, getReadableTxError, isValidAmountInput, parseUsdcInput, usdcToUsd } from "./utils";
+import { Address, formatUnits } from "viem";
+import { useAccount } from "wagmi";
+import { useScaffoldReadContract, useScaffoldWriteContract } from "~~/hooks/scaffold-eth";
+
+type StakeFormProps = {
+  usdcBalance: bigint | undefined;
+  stakerAddress: Address | undefined;
+  onStaked: () => Promise<unknown>;
+};
+
+const ALLOWANCE_POLL_ATTEMPTS = 5;
+const ALLOWANCE_POLL_DELAY_MS = 1000;
+
+export const StakeForm = ({ usdcBalance, stakerAddress, onStaked }: StakeFormProps) => {
+  const { address } = useAccount();
+  const [amountInput, setAmountInput] = useState("");
+  const [isApproving, setIsApproving] = useState(false);
+  const [isStaking, setIsStaking] = useState(false);
+  const [txError, setTxError] = useState<string>();
+
+  const { data: allowance, refetch: refetchAllowance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "allowance",
+    args: [address, stakerAddress],
+  });
+
+  const { writeContractAsync: writeUsdc } = useScaffoldWriteContract({ contractName: "USDC" });
+  const { writeContractAsync: writeStaker } = useScaffoldWriteContract({ contractName: "Staker" });
+
+  const amount = parseUsdcInput(amountInput);
+  const isBusy = isApproving || isStaking;
+
+  let inputError: string | undefined;
+  if (amount === 0n) inputError = "Enter an amount greater than zero";
+  else if (amount !== undefined && usdcBalance !== undefined && amount > usdcBalance)
+    inputError = "Amount exceeds your USDC balance";
+
+  const isReady = usdcBalance !== undefined && allowance !== undefined;
+  const canSubmit = amount !== undefined && amount > 0n && !inputError && isReady;
+  const needsApproval = amount !== undefined && allowance !== undefined && allowance < amount;
+
+  const handleAmountChange = (value: string) => {
+    // "1,000.50" → thousands separators; "1,5" → decimal comma.
+    const trimmed = value.trim();
+    const normalized = trimmed.includes(".") ? trimmed.replaceAll(",", "") : trimmed.replace(",", ".");
+    if (!isValidAmountInput(normalized)) return;
+    setAmountInput(normalized);
+    setTxError(undefined);
+  };
+
+  const handleApprove = async () => {
+    if (!amount || !stakerAddress) return;
+    setIsApproving(true);
+    setTxError(undefined);
+    try {
+      // Approve only what is being staked; no lingering unlimited allowance.
+      const hash = await writeUsdc({ functionName: "approve", args: [stakerAddress, amount] });
+      if (!hash) return;
+      // Keep the button locked until the RPC reports the new allowance (load-balanced nodes can lag a block),
+      // so "Approve" can't reappear and be paid for twice.
+      for (let i = 0; i < ALLOWANCE_POLL_ATTEMPTS; i++) {
+        const { data } = await refetchAllowance();
+        if (data !== undefined && data >= amount) break;
+        await new Promise(resolve => setTimeout(resolve, ALLOWANCE_POLL_DELAY_MS));
+      }
+    } catch (e) {
+      setTxError(getReadableTxError(e));
+    } finally {
+      setIsApproving(false);
+    }
+  };
+
+  const handleStake = async () => {
+    if (!amount) return;
+    setIsStaking(true);
+    setTxError(undefined);
+    try {
+      const hash = await writeStaker({ functionName: "stake", args: [amount] });
+      if (!hash) return;
+      setAmountInput("");
+      await Promise.all([refetchAllowance(), onStaked()]);
+    } catch (e) {
+      setTxError(getReadableTxError(e));
+    } finally {
+      setIsStaking(false);
+    }
+  };
+
+  const amountLabel = amount ? `${formatUsdc(amount)} USDC` : "";
+
+  return (
+    <div className="card bg-base-100 border border-base-300 shadow-sm">
+      <div className="card-body gap-4">
+        <h2 className="card-title">Stake USDC</h2>
+
+        <fieldset className="fieldset" disabled={isBusy}>
+          <div className="flex justify-between text-sm">
+            <label htmlFor="stake-amount" className="font-medium">
+              Amount
+            </label>
+            <span className="text-base-content/70">
+              Wallet: {usdcBalance !== undefined ? `${formatUsdc(usdcBalance)} USDC` : "—"}
+            </span>
+          </div>
+          <div className={`input w-full ${inputError ? "input-error" : ""}`}>
+            <input
+              id="stake-amount"
+              type="text"
+              inputMode="decimal"
+              autoComplete="off"
+              placeholder="0.00"
+              value={amountInput}
+              onChange={e => handleAmountChange(e.target.value)}
+            />
+            <span className="text-base-content/70">USDC</span>
+            <button
+              type="button"
+              className="btn btn-ghost btn-xs"
+              disabled={!usdcBalance}
+              onClick={() => usdcBalance && handleAmountChange(formatUnits(usdcBalance, USDC_DECIMALS))}
+            >
+              Max
+            </button>
+          </div>
+          <p className={`label text-sm ${inputError ? "text-error" : ""}`}>
+            {inputError ?? (amount ? `≈ ${usdcToUsd(amount)}` : "You can withdraw your full position at any time.")}
+          </p>
+        </fieldset>
+
+        {/* One primary action at a time: connect → switch network → approve → stake */}
+        <WalletGate>
+          {needsApproval && canSubmit ? (
+            <button type="button" className="btn btn-primary w-full" disabled={isBusy} onClick={handleApprove}>
+              {isApproving && <span className="loading loading-spinner loading-sm" />}
+              {isApproving ? "Approving..." : `Approve ${amountLabel}`}
+            </button>
+          ) : (
+            <button
+              type="button"
+              className="btn btn-primary w-full"
+              disabled={!canSubmit || isBusy}
+              onClick={handleStake}
+            >
+              {isStaking && <span className="loading loading-spinner loading-sm" />}
+              {isStaking
+                ? "Staking..."
+                : !isReady
+                  ? "Loading balances..."
+                  : amount
+                    ? `Stake ${amountLabel} (≈ ${usdcToUsd(amount)})`
+                    : "Enter an amount"}
+            </button>
+          )}
+        </WalletGate>
+        {needsApproval && canSubmit && (
+          <p className="text-xs text-base-content/70 -mt-2">
+            Step 1 of 2: allow the staking contract to move {amountLabel}. You&apos;ll confirm the stake next.
+          </p>
+        )}
+
+        {txError && (
+          <div role="alert" className="alert alert-error alert-soft">
+            <span>{txError}</span>
+          </div>
+        )}
+      </div>
+    </div>
+  );
+};
diff --git a/packages/nextjs/app/stake/_components/WalletGate.tsx b/packages/nextjs/app/stake/_components/WalletGate.tsx
