+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import { ERC20 } from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+import { Ownable } from "@openzeppelin/contracts/access/Ownable.sol";
+
+/**
+ * @title MockUSDC
+ * @notice LOCAL DEVELOPMENT ONLY. Mirrors the parts of Circle's FiatTokenV2_2 (USDC on Base) that matter to integrators:
+ *  - name "USD Coin", symbol "USDC", 6 decimals
+ *  - transfers / approvals revert while paused ("Pausable: paused")
+ *  - transfers / approvals revert for blacklisted accounts ("Blacklistable: account is blacklisted")
+ * Differences: `mint` is open to anyone so local wallets can fund themselves (real USDC only lets approved minters mint),
+ * EIP-2612 / EIP-3009 signature flows are not implemented, and balance/allowance failures use OZ custom errors
+ * (e.g. ERC20InsufficientBalance) where real USDC reverts with "ERC20: transfer amount exceeds balance".
+ */
+contract MockUSDC is ERC20, Ownable {
+    bool public paused;
+    mapping(address account => bool) public isBlacklisted;
+
+    event Pause();
+    event Unpause();
+    event Blacklisted(address indexed account);
+    event UnBlacklisted(address indexed account);
+
+    constructor(address initialOwner) ERC20("USD Coin", "USDC") Ownable(initialOwner) {}
+
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    function mint(address to, uint256 amount) external {
+        _mint(to, amount);
+    }
+
+    function pause() external onlyOwner {
+        paused = true;
+        emit Pause();
+    }
+
+    function unpause() external onlyOwner {
+        paused = false;
+        emit Unpause();
+    }
+
+    function blacklist(address account) external onlyOwner {
+        isBlacklisted[account] = true;
+        emit Blacklisted(account);
+    }
+
+    function unBlacklist(address account) external onlyOwner {
+        isBlacklisted[account] = false;
+        emit UnBlacklisted(account);
+    }
+
+    function transferFrom(address from, address to, uint256 value) public override returns (bool) {
+        _requireNotBlacklisted(_msgSender());
+        return super.transferFrom(from, to, value);
+    }
+
+    function _update(address from, address to, uint256 value) internal override {
+        _requireNotPaused();
+        _requireNotBlacklisted(from);
+        _requireNotBlacklisted(to);
+        super._update(from, to, value);
+    }
+
+    function _approve(address owner, address spender, uint256 value, bool emitEvent) internal override {
+        // Only gate user-initiated approvals; allowance spending inside transferFrom is already gated by _update.
+        if (emitEvent) {
+            _requireNotPaused();
+            _requireNotBlacklisted(owner);
+            _requireNotBlacklisted(spender);
+        }
+        super._approve(owner, spender, value, emitEvent);
+    }
+
+    function _requireNotPaused() private view {
+        require(!paused, "Pausable: paused");
+    }
+
+    function _requireNotBlacklisted(address account) private view {
+        require(!isBlacklisted[account], "Blacklistable: account is blacklisted");
+    }
+}
