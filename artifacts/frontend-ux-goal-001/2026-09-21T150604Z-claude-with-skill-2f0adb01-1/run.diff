@@ -0,0 +1,66 @@
+"use client";
+
+import { useState } from "react";
+import { WalletGate } from "./WalletGate";
+import { formatUsdc, getReadableTxError, usdcToUsd } from "./utils";
+import { useScaffoldWriteContract } from "~~/hooks/scaffold-eth";
+
+type WithdrawCardProps = {
+  stakedBalance: bigint | undefined;
+  onWithdrawn: () => Promise<unknown>;
+};
+
+export const WithdrawCard = ({ stakedBalance, onWithdrawn }: WithdrawCardProps) => {
+  const [isWithdrawing, setIsWithdrawing] = useState(false);
+  const [txError, setTxError] = useState<string>();
+  const { writeContractAsync: writeStaker } = useScaffoldWriteContract({ contractName: "Staker" });
+
+  const hasStake = stakedBalance !== undefined && stakedBalance > 0n;
+
+  const handleWithdraw = async () => {
+    setIsWithdrawing(true);
+    setTxError(undefined);
+    try {
+      const hash = await writeStaker({ functionName: "withdraw" });
+      // Refresh before re-enabling so the button never offers an already-withdrawn position.
+      if (hash) await onWithdrawn();
+    } catch (e) {
+      setTxError(getReadableTxError(e));
+    } finally {
+      setIsWithdrawing(false);
+    }
+  };
+
+  return (
+    <div className="card bg-base-100 border border-base-300 shadow-sm">
+      <div className="card-body gap-4">
+        <h2 className="card-title">Withdraw</h2>
+        <p className="text-sm text-base-content/70">
+          Withdrawals return your entire staked position to your wallet. There is no lock-up.
+        </p>
+
+        <WalletGate>
+          <button
+            type="button"
+            className="btn btn-outline w-full"
+            disabled={!hasStake || isWithdrawing}
+            onClick={handleWithdraw}
+          >
+            {isWithdrawing && <span className="loading loading-spinner loading-sm" />}
+            {isWithdrawing
+              ? "Withdrawing..."
+              : hasStake
+                ? `Withdraw ${formatUsdc(stakedBalance)} USDC (≈ ${usdcToUsd(stakedBalance)})`
+                : "Nothing to withdraw"}
+          </button>
+        </WalletGate>
+
+        {txError && (
+          <div role="alert" className="alert alert-error alert-soft">
+            <span>{txError}</span>
+          </div>
+        )}
+      </div>
+    </div>
+  );
+};
diff --git a/packages/nextjs/app/stake/_components/utils.ts b/packages/nextjs/app/stake/_components/utils.ts
new file mode 100644
index 0000000..2b56ddb
--- /dev/null
+++ b/packages/nextjs/app/stake/_components/utils.ts
@@ -0,0 +1,91 @@
+import {
+  BaseError,
+  ContractFunctionRevertedError,
+  InsufficientFundsError,
+  UserRejectedRequestError,
+  formatUnits,
+  parseUnits,
+} from "viem";
+import { getParsedError } from "~~/utils/scaffold-eth";
+
+export const USDC_DECIMALS = 6;
+
+const usdFormatter = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" });
+
+export const formatUsd = (value: number) => usdFormatter.format(value);
+
+/**
+ * Formats a base-unit amount, truncating (never rounding up) so we never show more than the user holds.
+ */
+export const formatTokenAmount = (value: bigint, decimals: number, displayDecimals = 2) => {
+  const unit = 10n ** BigInt(Math.max(decimals - displayDecimals, 0));
+  const truncated = Number(value / unit) / 10 ** displayDecimals;
+  if (truncated === 0 && value > 0n) return `<${(1 / 10 ** displayDecimals).toFixed(displayDecimals)}`;
+  return truncated.toLocaleString("en-US", {
+    minimumFractionDigits: displayDecimals,
+    maximumFractionDigits: displayDecimals,
+  });
+};
+
+export const formatUsdc = (value: bigint) => formatTokenAmount(value, USDC_DECIMALS);
+
+// USDC is redeemable 1:1 for USD, so its dollar value is its face value.
+export const usdcToUsd = (value: bigint) => formatUsd(Number(formatUnits(value, USDC_DECIMALS)));
+
+const AMOUNT_INPUT_REGEX = new RegExp(`^\\d*\\.?\\d{0,${USDC_DECIMALS}}$`);
+
+export const isValidAmountInput = (value: string) => AMOUNT_INPUT_REGEX.test(value);
+
+export const parseUsdcInput = (value: string): bigint | undefined => {
+  if (!value || value === ".") return undefined;
+  try {
+    return parseUnits(value, USDC_DECIMALS);
+  } catch {
+    return undefined;
+  }
+};
+
+const CUSTOM_ERROR_MESSAGES: Record<string, string> = {
+  ZeroAmount: "Enter an amount greater than zero.",
+  NothingStaked: "You have nothing staked to withdraw.",
+  ERC20InsufficientBalance: "You don't have enough USDC in your wallet.",
+  ERC20InsufficientAllowance: "USDC approval is lower than the amount. Approve again, then stake.",
+};
+
+// Revert strings used by Circle's FiatToken (USDC) and mirrored by MockUSDC.
+const REVERT_REASON_MESSAGES: [string, string][] = [
+  ["account is blacklisted", "This address is blocked by the USDC issuer and can't move USDC."],
+  ["Pausable: paused", "USDC transfers are temporarily paused by the issuer. Please try again later."],
+  ["transfer amount exceeds balance", "You don't have enough USDC in your wallet."],
+  ["transfer amount exceeds allowance", "USDC approval is lower than the amount. Approve again, then stake."],
+];
+
+/**
+ * Turns wallet/RPC/contract errors into a sentence a user can act on.
+ */
+export const getReadableTxError = (error: unknown): string => {
+  if (error instanceof BaseError) {
+    if (error.walk(e => e instanceof UserRejectedRequestError)) {
+      return "You rejected the request in your wallet.";
+    }
+    if (error.walk(e => e instanceof InsufficientFundsError)) {
+      return "Not enough ETH to pay the network fee. Add a little ETH to your wallet and try again.";
+    }
+    const revert = error.walk(e => e instanceof ContractFunctionRevertedError);
+    if (revert instanceof ContractFunctionRevertedError) {
+      const errorName = revert.data?.errorName;
+      if (errorName && CUSTOM_ERROR_MESSAGES[errorName]) return CUSTOM_ERROR_MESSAGES[errorName];
+      const reason = revert.reason ?? "";
+      const match = REVERT_REASON_MESSAGES.find(([needle]) => reason.includes(needle));
+      if (match) return match[1];
+    }
+  }
+
+  const parsed = getParsedError(error);
+  const match = REVERT_REASON_MESSAGES.find(([needle]) => parsed.includes(needle));
+  if (match) return match[1];
+  const customError = Object.keys(CUSTOM_ERROR_MESSAGES).find(name => parsed.includes(name));
+  if (customError) return CUSTOM_ERROR_MESSAGES[customError];
+
+  return "Something went wrong and the transaction was not completed. Please try again.";
+};
