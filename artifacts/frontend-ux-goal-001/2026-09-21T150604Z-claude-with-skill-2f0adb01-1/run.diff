@@ -0,0 +1,40 @@
+import { deployScript, artifacts } from "../rocketh/deploy.js";
+
+// Circle's native USDC on Base (https://developers.circle.com/stablecoins/usdc-contract-addresses)
+const BASE_USDC = "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913";
+const BASE_CHAIN_ID = 8453;
+const LOCAL_CHAIN_ID = 31337;
+
+/**
+ * Deploys Staker against real USDC on Base. On the local chain it first deploys MockUSDC under the
+ * deployment name "USDC", so the frontend uses the same contract name everywhere.
+ */
+export default deployScript(
+  async env => {
+    const { deployer } = env.namedAccounts;
+    const chainId = env.network.chain.id;
+
+    let usdcAddress: `0x${string}`;
+    if (chainId === BASE_CHAIN_ID) {
+      usdcAddress = BASE_USDC;
+    } else if (chainId === LOCAL_CHAIN_ID) {
+      const mockUsdc = await env.deploy("USDC", {
+        account: deployer,
+        artifact: artifacts.MockUSDC,
+        args: [deployer],
+      });
+      usdcAddress = mockUsdc.address;
+    } else {
+      throw new Error(`No USDC address configured for chain ${chainId}. Add it to deploy/00_deploy_staker.ts.`);
+    }
+
+    await env.deploy("Staker", {
+      account: deployer,
+      artifact: artifacts.Staker,
+      args: [usdcAddress],
+    });
+  },
+  {
+    tags: ["Staker"],
+  },
+);
