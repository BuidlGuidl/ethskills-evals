+//SPDX-License-Identifier: MIT
+pragma solidity >=0.8.0 <0.9.0;
+
+import { ERC20 } from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+
+/**
+ * Mock USDC for local development only. Mirrors canonical USDC: name "USD Coin",
+ * symbol "USDC", 6 decimals. `mint` is intentionally open so any test wallet can
+ * be funded — do NOT deploy this to a live network.
+ */
+contract MockUSDC is ERC20 {
+    constructor() ERC20("USD Coin", "USDC") {}
+
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    function mint(address to, uint256 amount) external {
+        _mint(to, amount);
+    }
+}
diff --git a/packages/hardhat/contracts/Staker.sol b/packages/hardhat/contracts/Staker.sol
new file mode 100644
index 0000000..8d62459
--- /dev/null
+++ b/packages/hardhat/contracts/Staker.sol
@@ -0,0 +1,52 @@
+//SPDX-License-Identifier: MIT
+pragma solidity >=0.8.0 <0.9.0;
+
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { SafeERC20 } from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+
+/**
+ * Minimal USDC staking vault. Users deposit USDC and can withdraw their full
+ * position at any time. No rewards logic — deposits are held 1:1.
+ *
+ * SafeERC20 is used so the contract stays faithful to real USDC on Base, which
+ * follows the standard ERC20 return-bool interface.
+ */
+contract Staker {
+    using SafeERC20 for IERC20;
+
+    IERC20 public immutable usdc;
+
+    mapping(address => uint256) public stakedBalance;
+    uint256 public totalStaked;
+
+    event Staked(address indexed user, uint256 amount);
+    event Withdrawn(address indexed user, uint256 amount);
+
+    error ZeroAmount();
+    error NothingStaked();
+    error ZeroAddress();
+
+    constructor(address usdcToken) {
+        if (usdcToken == address(0)) revert ZeroAddress();
+        usdc = IERC20(usdcToken);
+    }
+
+    /// Pull `amount` of USDC from the caller (requires prior approval) into their position.
+    function stake(uint256 amount) external {
+        if (amount == 0) revert ZeroAmount();
+        stakedBalance[msg.sender] += amount;
+        totalStaked += amount;
+        usdc.safeTransferFrom(msg.sender, address(this), amount);
+        emit Staked(msg.sender, amount);
+    }
+
+    /// Return the caller's entire staked position.
+    function withdraw() external {
+        uint256 amount = stakedBalance[msg.sender];
+        if (amount == 0) revert NothingStaked();
+        stakedBalance[msg.sender] = 0;
+        totalStaked -= amount;
+        usdc.safeTransfer(msg.sender, amount);
+        emit Withdrawn(msg.sender, amount);
+    }
+}
diff --git a/packages/hardhat/deploy/01_deploy_staker.ts b/packages/hardhat/deploy/01_deploy_staker.ts
