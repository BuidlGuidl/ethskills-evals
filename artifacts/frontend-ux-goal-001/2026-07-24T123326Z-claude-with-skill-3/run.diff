@@ -0,0 +1,49 @@
+import { deployScript, artifacts } from "../rocketh/deploy.js";
+
+/**
+ * Deploys the Staker contract wired to USDC.
+ *
+ * On chains where canonical USDC exists we point at it directly. Everywhere else
+ * (e.g. local hardhat) we deploy a faithful MockUSDC first so the app is usable
+ * end-to-end without a fork.
+ */
+
+// Canonical USDC (6 decimals) by chainId.
+const USDC_BY_CHAIN: Record<number, `0x${string}`> = {
+  8453: "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913", // Base mainnet
+  84532: "0x036CbD53842c5426634e7929541eC2318f3dCF7e", // Base Sepolia (Circle testnet USDC)
+};
+
+export default deployScript(
+  async env => {
+    const { deployer } = env.namedAccounts;
+
+    const chainIdHex = (await env.network.provider.request({ method: "eth_chainId" })) as string;
+    const chainId = Number(chainIdHex);
+
+    let usdcAddress = USDC_BY_CHAIN[chainId];
+
+    if (!usdcAddress) {
+      const mockUsdc = await env.deploy("MockUSDC", {
+        account: deployer,
+        artifact: artifacts.MockUSDC,
+        args: [],
+      });
+      usdcAddress = mockUsdc.address;
+      console.log("🪙 Deployed MockUSDC (local) at", usdcAddress);
+    } else {
+      console.log("🪙 Using canonical USDC at", usdcAddress);
+    }
+
+    const staker = await env.deploy("Staker", {
+      account: deployer,
+      artifact: artifacts.Staker,
+      args: [usdcAddress],
+    });
+
+    console.log("🥩 Staker deployed at", staker.address);
+  },
+  {
+    tags: ["Staker"],
+  },
+);
diff --git a/packages/hardhat/test/Staker.ts b/packages/hardhat/test/Staker.ts
new file mode 100644
index 0000000..ab530a0
--- /dev/null
+++ b/packages/hardhat/test/Staker.ts
@@ -0,0 +1,99 @@
+import { expect } from "chai";
+import { network } from "hardhat";
+import type { Abi_Staker } from "../generated/abis/Staker.js";
+import type { Abi_MockUSDC } from "../generated/abis/MockUSDC.js";
+import { loadAndExecuteDeploymentsFromFiles } from "../rocketh/environment.js";
+
+const { provider, networkHelpers, ethers } = await network.create();
+
+const ONE_USDC = 1_000_000n; // 6 decimals
+
+async function deployFixture() {
+  const env = await loadAndExecuteDeploymentsFromFiles({ provider });
+  const staker = env.get<Abi_Staker>("Staker");
+  const usdc = env.get<Abi_MockUSDC>("MockUSDC");
+
+  const [deployer, user] = await ethers.getSigners();
+  const stakerContract = await ethers.getContractAt(staker.abi, staker.address);
+  const usdcContract = await ethers.getContractAt(usdc.abi, usdc.address);
+
+  return { stakerContract, usdcContract, deployer, user };
+}
+
+describe("Staker", function () {
+  it("wires up to the deployed USDC token", async function () {
+    const { stakerContract, usdcContract } = await networkHelpers.loadFixture(deployFixture);
+    expect((await stakerContract.usdc()).toLowerCase()).to.equal((await usdcContract.getAddress()).toLowerCase());
+  });
+
+  it("stakes USDC and tracks the position", async function () {
+    const { stakerContract, usdcContract, user } = await networkHelpers.loadFixture(deployFixture);
+    const stakerAddress = await stakerContract.getAddress();
+
+    await usdcContract.mint(user.address, 100n * ONE_USDC);
+    await usdcContract.connect(user).approve(stakerAddress, 100n * ONE_USDC);
+
+    await expect(stakerContract.connect(user).stake(100n * ONE_USDC))
+      .to.emit(stakerContract, "Staked")
+      .withArgs(user.address, 100n * ONE_USDC);
+
+    expect(await stakerContract.stakedBalance(user.address)).to.equal(100n * ONE_USDC);
+    expect(await stakerContract.totalStaked()).to.equal(100n * ONE_USDC);
+    expect(await usdcContract.balanceOf(stakerAddress)).to.equal(100n * ONE_USDC);
+  });
+
+  it("withdraws the full position", async function () {
+    const { stakerContract, usdcContract, user } = await networkHelpers.loadFixture(deployFixture);
+    const stakerAddress = await stakerContract.getAddress();
+
+    await usdcContract.mint(user.address, 100n * ONE_USDC);
+    await usdcContract.connect(user).approve(stakerAddress, 100n * ONE_USDC);
+    await stakerContract.connect(user).stake(100n * ONE_USDC);
+
+    await expect(stakerContract.connect(user).withdraw())
+      .to.emit(stakerContract, "Withdrawn")
+      .withArgs(user.address, 100n * ONE_USDC);
+
+    expect(await stakerContract.stakedBalance(user.address)).to.equal(0n);
+    expect(await stakerContract.totalStaked()).to.equal(0n);
+    expect(await usdcContract.balanceOf(user.address)).to.equal(100n * ONE_USDC);
+  });
+
+  it("reverts staking without a sufficient allowance", async function () {
+    const { stakerContract, usdcContract, user } = await networkHelpers.loadFixture(deployFixture);
+    await usdcContract.mint(user.address, 100n * ONE_USDC);
+    // No approve() call, so the underlying ERC20 transferFrom reverts on allowance.
+    await expect(stakerContract.connect(user).stake(100n * ONE_USDC)).to.be.revertedWithCustomError(
+      usdcContract,
+      "ERC20InsufficientAllowance",
+    );
+  });
+
+  it("keeps each user's position isolated", async function () {
+    const { stakerContract, usdcContract, deployer, user } = await networkHelpers.loadFixture(deployFixture);
+    const stakerAddress = await stakerContract.getAddress();
+
+    for (const signer of [deployer, user]) {
+      await usdcContract.mint(signer.address, 50n * ONE_USDC);
+      await usdcContract.connect(signer).approve(stakerAddress, 50n * ONE_USDC);
+      await stakerContract.connect(signer).stake(50n * ONE_USDC);
+    }
+
+    expect(await stakerContract.stakedBalance(user.address)).to.equal(50n * ONE_USDC);
+    expect(await stakerContract.totalStaked()).to.equal(100n * ONE_USDC);
+
+    await stakerContract.connect(user).withdraw();
+    expect(await stakerContract.stakedBalance(user.address)).to.equal(0n);
+    expect(await stakerContract.stakedBalance(deployer.address)).to.equal(50n * ONE_USDC);
+    expect(await stakerContract.totalStaked()).to.equal(50n * ONE_USDC);
+  });
+
+  it("reverts on zero-amount stake and empty withdraw", async function () {
+    const { stakerContract, user } = await networkHelpers.loadFixture(deployFixture);
+    await expect(stakerContract.connect(user).stake(0n)).to.be.revertedWithCustomError(stakerContract, "ZeroAmount");
+    await expect(stakerContract.connect(user).withdraw()).to.be.revertedWithCustomError(
+      stakerContract,
+      "NothingStaked",
+    );
+  });
+});
