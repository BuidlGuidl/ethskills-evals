diff --git a/packages/nextjs/app/stake/page.tsx b/packages/nextjs/app/stake/page.tsx
new file mode 100644
index 0000000..1981ead
--- /dev/null
+++ b/packages/nextjs/app/stake/page.tsx
@@ -0,0 +1,345 @@
+"use client";
+
+import { useEffect, useState } from "react";
+import { useConnectModal } from "@rainbow-me/rainbowkit";
+import { Balance } from "@scaffold-ui/components";
+import type { NextPage } from "next";
+import { erc20Abi, formatUnits, parseUnits } from "viem";
+import { hardhat } from "viem/chains";
+import { useAccount, useBlockNumber, useReadContract, useSwitchChain, useWalletClient } from "wagmi";
+import { ArrowDownTrayIcon, ArrowUpTrayIcon } from "@heroicons/react/24/outline";
+import {
+  useDeployedContractInfo,
+  useScaffoldReadContract,
+  useScaffoldWriteContract,
+  useTargetNetwork,
+  useTransactor,
+} from "~~/hooks/scaffold-eth";
+import { getParsedError, notification } from "~~/utils/scaffold-eth";
+
+const FALLBACK_DECIMALS = 6;
+
+// USDC is a dollar stablecoin, so 1 unit ≈ $1. Good enough for on-screen context.
+const formatUsd = (value: number) =>
+  `~$${value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
+
+const formatUsdc = (value: bigint, decimals: number) =>
+  Number(formatUnits(value, decimals)).toLocaleString(undefined, {
+    minimumFractionDigits: 2,
+    maximumFractionDigits: 2,
+  });
+
+// null => unparseable input; 0n => empty.
+const parseAmount = (amount: string, decimals: number): bigint | null => {
+  if (!amount) return 0n;
+  try {
+    return parseUnits(amount, decimals);
+  } catch {
+    return null;
+  }
+};
+
+const Stake: NextPage = () => {
+  const { address, isConnected, chainId } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+  const { openConnectModal } = useConnectModal();
+  const { switchChain } = useSwitchChain();
+  const { data: walletClient } = useWalletClient();
+  const writeTx = useTransactor();
+
+  const [amount, setAmount] = useState("");
+  const [isApproving, setIsApproving] = useState(false);
+  const [isStaking, setIsStaking] = useState(false);
+  const [isWithdrawing, setIsWithdrawing] = useState(false);
+  const [isMinting, setIsMinting] = useState(false);
+
+  const { data: stakerInfo } = useDeployedContractInfo({ contractName: "Staker" });
+  const stakerAddress = stakerInfo?.address;
+
+  const { data: usdcAddress } = useScaffoldReadContract({ contractName: "Staker", functionName: "usdc" });
+
+  const { data: stakedBalance } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "stakedBalance",
+    args: [address],
+  });
+
+  const { data: rawDecimals } = useReadContract({
+    chainId: targetNetwork.id,
+    address: usdcAddress,
+    abi: erc20Abi,
+    functionName: "decimals",
+    query: { enabled: !!usdcAddress },
+  });
+  const decimals = rawDecimals ?? FALLBACK_DECIMALS;
+
+  const { data: usdcBalance, refetch: refetchUsdcBalance } = useReadContract({
+    chainId: targetNetwork.id,
+    address: usdcAddress,
+    abi: erc20Abi,
+    functionName: "balanceOf",
+    args: address ? [address] : undefined,
+    query: { enabled: !!usdcAddress && !!address },
+  });
+
+  const { data: allowance, refetch: refetchAllowance } = useReadContract({
+    chainId: targetNetwork.id,
+    address: usdcAddress,
+    abi: erc20Abi,
+    functionName: "allowance",
+    args: address && stakerAddress ? [address, stakerAddress] : undefined,
+    query: { enabled: !!usdcAddress && !!address && !!stakerAddress },
+  });
+
+  // Keep token balance / allowance fresh (staked position already auto-watches).
+  const { data: blockNumber } = useBlockNumber({ watch: true });
+  useEffect(() => {
+    refetchUsdcBalance();
+    refetchAllowance();
+  }, [blockNumber, refetchUsdcBalance, refetchAllowance]);
+
+  const { writeContractAsync: writeStaker } = useScaffoldWriteContract({ contractName: "Staker" });
+  const { writeContractAsync: writeMockUsdc } = useScaffoldWriteContract({ contractName: "MockUSDC" });
+
+  // MockUSDC is only deployed on local networks; the faucet is a dev-only affordance.
+  const isLocalChain = isConnected && chainId === hardhat.id;
+
+  const parsedAmount = parseAmount(amount, decimals);
+
+  const wrongNetwork = isConnected && chainId !== targetNetwork.id;
+  const hasAmount = parsedAmount !== null && parsedAmount > 0n;
+  const balancesReady = usdcBalance !== undefined && allowance !== undefined;
+  const insufficientBalance = hasAmount && usdcBalance !== undefined && parsedAmount! > usdcBalance;
+  const needsApproval = hasAmount && allowance !== undefined && allowance < parsedAmount!;
+  const busy = isApproving || isStaking || isWithdrawing;
+
+  const setMax = () => {
+    if (usdcBalance !== undefined) setAmount(formatUnits(usdcBalance, decimals));
+  };
+
+  const handleApprove = async () => {
+    if (!walletClient || !usdcAddress || !stakerAddress || !parsedAmount) return;
+    setIsApproving(true);
+    try {
+      await writeTx(
+        () =>
+          walletClient.writeContract({
+            address: usdcAddress,
+            abi: erc20Abi,
+            functionName: "approve",
+            args: [stakerAddress, parsedAmount],
+          }),
+        { blockConfirmations: 1 },
+      );
+      await refetchAllowance();
+    } catch (e) {
+      notification.error(getParsedError(e));
+    } finally {
+      setIsApproving(false);
+    }
+  };
+
+  const handleStake = async () => {
+    if (!parsedAmount) return;
+    setIsStaking(true);
+    try {
+      await writeStaker({ functionName: "stake", args: [parsedAmount] });
+      setAmount("");
+      await Promise.all([refetchUsdcBalance(), refetchAllowance()]);
+    } catch (e) {
+      notification.error(getParsedError(e));
+    } finally {
+      setIsStaking(false);
+    }
+  };
+
+  const handleWithdraw = async () => {
+    setIsWithdrawing(true);
+    try {
+      await writeStaker({ functionName: "withdraw" });
+      await refetchUsdcBalance();
+    } catch (e) {
+      notification.error(getParsedError(e));
+    } finally {
+      setIsWithdrawing(false);
+    }
+  };
+
+  const handleMint = async () => {
+    if (!address) return;
+    setIsMinting(true);
+    try {
+      await writeMockUsdc({ functionName: "mint", args: [address, parseUnits("1000", decimals)] });
+      await refetchUsdcBalance();
+    } catch (e) {
+      notification.error(getParsedError(e));
+    } finally {
+      setIsMinting(false);
+    }
+  };
+
+  // Single primary action at a time (connect → switch → approve → stake).
+  const primaryAction = (() => {
+    if (!isConnected) return { label: "Connect Wallet", onClick: openConnectModal, disabled: !openConnectModal };
+    if (wrongNetwork)
+      return {
+        label: `Switch to ${targetNetwork.name}`,
+        onClick: () => switchChain({ chainId: targetNetwork.id }),
+        disabled: false,
+      };
+    if (!hasAmount) return { label: "Enter an amount", onClick: undefined, disabled: true };
+    if (insufficientBalance) return { label: "Insufficient USDC balance", onClick: undefined, disabled: true };
+    // Wait for allowance/balance before deciding approve-vs-stake, so we never
+    // surface "Stake" with an unloaded (undefined) allowance and revert on click.
+    if (!balancesReady) return { label: "Loading…", onClick: undefined, disabled: true };
+    if (needsApproval)
+      return {
+        label: isApproving ? "Approving..." : "Approve USDC",
+        onClick: handleApprove,
+        disabled: busy,
+        showIcon: true,
+      };
+    return { label: isStaking ? "Staking..." : "Stake USDC", onClick: handleStake, disabled: busy, showIcon: true };
+  })();
+
+  const amountUsd = parsedAmount && parsedAmount > 0n ? Number(formatUnits(parsedAmount, decimals)) : 0;
+  const canWithdraw = isConnected && !wrongNetwork && !!stakedBalance && stakedBalance > 0n;
+
+  return (
+    <div className="flex flex-col items-center grow w-full px-4 py-10 bg-base-200">
+      <div className="w-full max-w-lg">
+        <div className="mb-6 text-center">
+          <h1 className="text-3xl font-bold mb-1">Stake USDC</h1>
+          <p className="text-base-content/70">Deposit USDC and withdraw your full position anytime. No lockup.</p>
+        </div>
+
+        {/* Balances */}
+        <div className="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-6">
+          <div className="card bg-base-100 shadow-sm">
+            <div className="card-body p-4 items-center text-center">
+              <span className="text-xs uppercase tracking-wide text-base-content/60">Wallet USDC</span>
+              <span className="text-lg font-semibold">
+                {usdcBalance !== undefined ? formatUsdc(usdcBalance, decimals) : "—"}
+              </span>
+              {usdcBalance !== undefined && (
+                <span className="text-xs text-base-content/60">
+                  {formatUsd(Number(formatUnits(usdcBalance, decimals)))}
+                </span>
+              )}
+            </div>
+          </div>
+          <div className="card bg-base-100 shadow-sm">
+            <div className="card-body p-4 items-center text-center">
+              <span className="text-xs uppercase tracking-wide text-base-content/60">ETH (gas)</span>
+              <div className="text-lg font-semibold">
+                <Balance address={address} chain={targetNetwork} />
+              </div>
+            </div>
+          </div>
+          <div className="card bg-base-100 shadow-sm">
+            <div className="card-body p-4 items-center text-center">
+              <span className="text-xs uppercase tracking-wide text-base-content/60">Staked</span>
+              <span className="text-lg font-semibold">
+                {stakedBalance !== undefined ? formatUsdc(stakedBalance, decimals) : "—"}
+              </span>
+              {stakedBalance !== undefined && (
+                <span className="text-xs text-base-content/60">
+                  {formatUsd(Number(formatUnits(stakedBalance, decimals)))}
+                </span>
+              )}
+            </div>
+          </div>
+        </div>
+
+        {/* Stake card */}
+        <div className="card bg-base-100 shadow-md">
+          <div className="card-body gap-4">
+            <div>
+              <label className="flex justify-between items-center mb-1">
+                <span className="text-sm font-medium">Amount to stake</span>
+                <button
+                  type="button"
+                  className="btn btn-xs btn-ghost"
+                  onClick={setMax}
+                  disabled={!isConnected || usdcBalance === undefined || usdcBalance === 0n}
+                >
+                  Max
+                </button>
+              </label>
+              <label className="input input-bordered flex items-center gap-2">
+                <input
+                  type="text"
+                  inputMode="decimal"
+                  placeholder="0.00"
+                  className="grow"
+                  value={amount}
+                  onChange={e => {
+                    const v = e.target.value;
+                    if (v !== "" && !/^\d*\.?\d*$/.test(v)) return;
+                    // Reject more fraction digits than the token supports (parseUnits would silently round).
+                    if (v.includes(".") && v.split(".")[1].length > decimals) return;
+                    setAmount(v);
+                  }}
+                />
+                <span className="text-base-content/60 font-medium">USDC</span>
+              </label>
+              <div className="flex justify-between mt-1 text-xs text-base-content/60">
+                <span>{amountUsd > 0 ? formatUsd(amountUsd) : ""}</span>
+                {parsedAmount === null && <span className="text-error">Invalid amount</span>}
+                {insufficientBalance && <span className="text-error">Exceeds wallet balance</span>}
+              </div>
+            </div>
+
+            <button
+              className="btn btn-primary w-full"
+              onClick={primaryAction.onClick}
+              disabled={primaryAction.disabled}
+            >
+              {isApproving || isStaking ? (
+                <span className="loading loading-spinner loading-sm" />
+              ) : (
+                primaryAction.showIcon && <ArrowDownTrayIcon className="h-4 w-4" />
+              )}
+              {primaryAction.label}
+            </button>
+
+            {needsApproval && !isApproving && (
+              <p className="text-xs text-center text-base-content/60">
+                One-time approval lets the Staker move this USDC amount.
+              </p>
+            )}
+
+            {isLocalChain && (
+              <button className="btn btn-ghost btn-sm" onClick={handleMint} disabled={isMinting}>
+                {isMinting ? <span className="loading loading-spinner loading-xs" /> : null}
+                {isMinting ? "Minting..." : "Get 1,000 test USDC (local dev)"}
+              </button>
+            )}
+          </div>
+        </div>
+
+        {/* Withdraw */}
+        <div className="card bg-base-100 shadow-md mt-4">
+          <div className="card-body gap-3">
+            <div className="flex justify-between items-center">
+              <span className="text-sm font-medium">Your staked position</span>
+              <span className="font-semibold">
+                {stakedBalance !== undefined ? `${formatUsdc(stakedBalance, decimals)} USDC` : "—"}
+              </span>
+            </div>
+            <button className="btn btn-outline w-full" onClick={handleWithdraw} disabled={!canWithdraw || busy}>
+              {isWithdrawing ? (
+                <span className="loading loading-spinner loading-sm" />
+              ) : (
+                <ArrowUpTrayIcon className="h-4 w-4" />
+              )}
+              {isWithdrawing ? "Withdrawing..." : "Withdraw full position"}
+            </button>
+          </div>
+        </div>
+      </div>
+    </div>
+  );
+};
+
+export default Stake;
