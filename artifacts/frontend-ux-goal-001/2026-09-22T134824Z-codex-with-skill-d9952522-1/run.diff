+"use client";
+
+import { useEffect, useMemo, useState } from "react";
+import type { ReactNode } from "react";
+import { useConnectModal } from "@rainbow-me/rainbowkit";
+import type { NextPage } from "next";
+import { erc20Abi, formatEther, formatUnits, parseUnits, zeroAddress } from "viem";
+import type { Address } from "viem";
+import { base, hardhat } from "viem/chains";
+import { useAccount, useBalance, usePublicClient, useReadContract, useSwitchChain, useWriteContract } from "wagmi";
+import {
+  ArrowPathIcon,
+  ArrowUpRightIcon,
+  BanknotesIcon,
+  BoltIcon,
+  CheckCircleIcon,
+  WalletIcon,
+} from "@heroicons/react/24/outline";
+import {
+  useDeployedContractInfo,
+  useScaffoldReadContract,
+  useScaffoldWriteContract,
+  useTargetNetwork,
+} from "~~/hooks/scaffold-eth";
+import { AllowedChainIds, getParsedError, notification } from "~~/utils/scaffold-eth";
+
+const BASE_USDC_ADDRESS = "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913";
+const USDC_DECIMALS = 6;
+
+type PendingAction = "approve" | "stake" | "withdraw" | "switch";
+
+type TokenPrices = {
+  eth?: number;
+  usdc?: number;
+  updatedAt?: Date;
+  error?: string;
+};
+
+const currencyFormatter = new Intl.NumberFormat("en-US", {
+  style: "currency",
+  currency: "USD",
+  maximumFractionDigits: 2,
+});
+
+const tokenFormatter = new Intl.NumberFormat("en-US", {
+  maximumFractionDigits: 6,
+});
+
+const compactTokenFormatter = new Intl.NumberFormat("en-US", {
+  maximumFractionDigits: 4,
+});
+
+const toAddress = (address?: Address) => address ?? zeroAddress;
+
+const formatTokenAmount = (amount?: bigint, decimals = USDC_DECIMALS, compact = false) => {
+  if (amount === undefined) return "0";
+  const numericAmount = Number(formatUnits(amount, decimals));
+  return (compact ? compactTokenFormatter : tokenFormatter).format(numericAmount);
+};
+
+const formatFiat = (amount: bigint | undefined, decimals: number, price?: number) => {
+  if (amount === undefined || price === undefined) return "Price unavailable";
+  const value = Number(formatUnits(amount, decimals)) * price;
+  return currencyFormatter.format(value);
+};
+
+const useTokenPrices = () => {
+  const [prices, setPrices] = useState<TokenPrices>({});
+
+  useEffect(() => {
+    const controller = new AbortController();
+
+    const loadPrices = async () => {
+      try {
+        const response = await fetch(
+          "https://api.coingecko.com/api/v3/simple/price?ids=usd-coin,ethereum&vs_currencies=usd",
+          { signal: controller.signal },
+        );
+
+        if (!response.ok) {
+          throw new Error("Price source unavailable");
+        }
+
+        const data = (await response.json()) as {
+          ethereum?: { usd?: number };
+          "usd-coin"?: { usd?: number };
+        };
+
+        setPrices({
+          eth: data.ethereum?.usd,
+          usdc: data["usd-coin"]?.usd,
+          updatedAt: new Date(),
+        });
+      } catch (error) {
+        if (!controller.signal.aborted) {
+          setPrices({ error: error instanceof Error ? error.message : "Price source unavailable" });
+        }
+      }
+    };
+
+    loadPrices();
+    const interval = setInterval(loadPrices, 60_000);
+
+    return () => {
+      controller.abort();
+      clearInterval(interval);
+    };
+  }, []);
+
+  return prices;
+};
+
+const Stat = ({
+  icon,
+  label,
+  value,
+  subValue,
+}: {
+  icon: ReactNode;
+  label: string;
+  value: string;
+  subValue: string;
+}) => (
+  <div className="bg-base-100 border border-base-300 p-5 min-h-36">
+    <div className="flex items-center gap-2 text-sm text-base-content/70">
+      {icon}
+      <span>{label}</span>
+    </div>
+    <div className="mt-4 text-2xl font-semibold leading-tight break-words">{value}</div>
+    <div className="mt-2 text-sm text-base-content/70 break-words">{subValue}</div>
+  </div>
+);
+
+const StakePage: NextPage = () => {
+  const { address: connectedAddress, chain, isConnected } = useAccount();
+  const { openConnectModal } = useConnectModal();
+  const { targetNetwork } = useTargetNetwork();
+  const selectedChainId = targetNetwork.id as AllowedChainIds;
+  const publicClient = usePublicClient({ chainId: targetNetwork.id });
+  const prices = useTokenPrices();
+
+  const [stakeAmount, setStakeAmount] = useState("");
+  const [pendingAction, setPendingAction] = useState<PendingAction>();
+  const [actionError, setActionError] = useState<string>();
+
+  const isLocalNetwork = targetNetwork.id === hardhat.id;
+  const isWrongNetwork = isConnected && chain?.id !== targetNetwork.id;
+  const isBusy = Boolean(pendingAction);
+
+  const { data: stakerContract } = useDeployedContractInfo({
+    contractName: "Staker",
+    chainId: selectedChainId,
+  });
+  const { data: mockUsdcContract } = useDeployedContractInfo({
+    contractName: "MockUSDC",
+    chainId: selectedChainId,
+  });
+
+  const stakerAddress = stakerContract?.address;
+  const usdcAddress =
+    targetNetwork.id === base.id
+      ? (BASE_USDC_ADDRESS as Address)
+      : isLocalNetwork
+        ? mockUsdcContract?.address
+        : undefined;
+
+  const stakeAmountUnits = useMemo(() => {
+    const normalizedAmount = stakeAmount.trim();
+    if (!normalizedAmount || !/^\d+(\.\d*)?$/.test(normalizedAmount)) return undefined;
+
+    try {
+      return parseUnits(normalizedAmount, USDC_DECIMALS);
+    } catch {
+      return undefined;
+    }
+  }, [stakeAmount]);
+
+  const { data: ethBalance } = useBalance({
+    address: connectedAddress,
+    chainId: targetNetwork.id,
+    query: {
+      enabled: Boolean(connectedAddress),
+    },
+  });
+
+  const { data: walletUsdcBalance, refetch: refetchWalletUsdcBalance } = useReadContract({
+    address: usdcAddress,
+    abi: erc20Abi,
+    functionName: "balanceOf",
+    args: [toAddress(connectedAddress)],
+    chainId: targetNetwork.id,
+    query: {
+      enabled: Boolean(connectedAddress && usdcAddress),
+    },
+  });
+
+  const { data: allowance, refetch: refetchAllowance } = useReadContract({
+    address: usdcAddress,
+    abi: erc20Abi,
+    functionName: "allowance",
+    args: [toAddress(connectedAddress), toAddress(stakerAddress)],
+    chainId: targetNetwork.id,
+    query: {
+      enabled: Boolean(connectedAddress && stakerAddress && usdcAddress),
+    },
+  });
+
+  const { data: stakedPosition, refetch: refetchStakedPosition } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "positionOf",
+    args: [connectedAddress],
+    chainId: selectedChainId,
+    query: {
+      enabled: Boolean(connectedAddress && stakerAddress),
+    },
+  });
+
+  const { data: totalStaked } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "totalStaked",
+    chainId: selectedChainId,
+    query: {
+      enabled: Boolean(stakerAddress),
+    },
+  });
+
+  const { writeContractAsync: writeTokenAsync } = useWriteContract();
+  const { writeContractAsync: writeStakerAsync } = useScaffoldWriteContract({
+    contractName: "Staker",
+    chainId: selectedChainId,
+  });
+  const { switchChainAsync } = useSwitchChain();
+
+  const balanceTooLow =
+    stakeAmountUnits !== undefined && walletUsdcBalance !== undefined && stakeAmountUnits > walletUsdcBalance;
+  const needsApproval =
+    stakeAmountUnits !== undefined &&
+    allowance !== undefined &&
+    stakerAddress !== undefined &&
+    stakeAmountUnits > allowance;
+  const hasStakeAmount = stakeAmountUnits !== undefined && stakeAmountUnits > 0n;
+  const hasPosition = stakedPosition !== undefined && stakedPosition > 0n;
+
+  const stakeAmountError = useMemo(() => {
+    if (!stakeAmount.trim()) return undefined;
+    if (stakeAmountUnits === undefined) return "Enter a valid USDC amount with up to 6 decimals.";
+    if (stakeAmountUnits === 0n) return "Amount must be greater than 0 USDC.";
+    if (balanceTooLow) return "Insufficient USDC balance.";
+    return undefined;
+  }, [balanceTooLow, stakeAmount, stakeAmountUnits]);
+
+  const refetchStakeData = async () => {
+    await Promise.all([refetchWalletUsdcBalance(), refetchAllowance(), refetchStakedPosition()]);
+  };
+
+  const handleSwitchNetwork = async () => {
+    setPendingAction("switch");
+    setActionError(undefined);
+
+    try {
+      await switchChainAsync({ chainId: targetNetwork.id });
+    } catch (error) {
+      setActionError(getParsedError(error));
+    } finally {
+      setPendingAction(undefined);
+    }
+  };
+
+  const handleApprove = async () => {
+    if (!publicClient || !usdcAddress || !stakerAddress || !stakeAmountUnits) return;
+
+    setPendingAction("approve");
+    setActionError(undefined);
+
+    try {
+      const hash = await writeTokenAsync({
+        address: usdcAddress,
+        abi: erc20Abi,
+        functionName: "approve",
+        args: [stakerAddress, stakeAmountUnits],
+      });
+
+      await publicClient.waitForTransactionReceipt({ hash });
+      await refetchAllowance();
+      notification.success("USDC approval confirmed");
+    } catch (error) {
+      setActionError(getParsedError(error));
+    } finally {
+      setPendingAction(undefined);
+    }
+  };
+
+  const handleStake = async () => {
+    if (!stakeAmountUnits) return;
+
+    setPendingAction("stake");
+    setActionError(undefined);
+
+    try {
+      await writeStakerAsync({
+        functionName: "stake",
+        args: [stakeAmountUnits],
+      });
+
+      await refetchStakeData();
+      setStakeAmount("");
+    } catch (error) {
+      setActionError(getParsedError(error));
+    } finally {
+      setPendingAction(undefined);
+    }
+  };
+
+  const handleWithdraw = async () => {
+    setPendingAction("withdraw");
+    setActionError(undefined);
+
+    try {
+      await writeStakerAsync({
+        functionName: "withdraw",
+      });
+
+      await refetchStakeData();
+    } catch (error) {
+      setActionError(getParsedError(error));
+    } finally {
+      setPendingAction(undefined);
+    }
+  };
+
+  const handlePrimaryAction = async () => {
+    if (!isConnected) {
+      openConnectModal?.();
+      return;
+    }
+
+    if (isWrongNetwork) {
+      await handleSwitchNetwork();
+      return;
+    }
+
+    if (needsApproval) {
+      await handleApprove();
+      return;
+    }
+
+    await handleStake();
+  };
+
+  const primaryActionLabel = useMemo(() => {
+    if (!isConnected) return "Connect Wallet";
+    if (isWrongNetwork) return `Switch to ${targetNetwork.name}`;
+    if (!stakerAddress) return `Deploy Staker on ${targetNetwork.name}`;
+    if (!usdcAddress) return "USDC Unavailable";
+    if (!hasStakeAmount) return "Enter Amount";
+    if (balanceTooLow) return "Insufficient USDC";
+    if (needsApproval) return "Approve USDC";
+    return "Stake USDC";
+  }, [
+    balanceTooLow,
+    hasStakeAmount,
+    isConnected,
+    isWrongNetwork,
+    needsApproval,
+    stakerAddress,
+    targetNetwork.name,
+    usdcAddress,
+  ]);
+
+  const primaryActionDisabled =
+    isBusy ||
+    (isConnected &&
+      !isWrongNetwork &&
+      (!stakerAddress || !usdcAddress || !hasStakeAmount || Boolean(stakeAmountError)));
+
+  return (
+    <div className="flex-1 bg-base-200">
+      <div className="mx-auto flex w-full max-w-6xl flex-col gap-8 px-4 py-8 sm:px-6 lg:px-8">
+        <section className="grid gap-6 lg:grid-cols-[1fr_24rem] lg:items-start">
+          <div>
+            <div className="flex flex-wrap items-center gap-3">
+              <div className="badge badge-primary gap-2 px-3 py-3">
+                <BanknotesIcon className="h-4 w-4" />
+                Base USDC
+              </div>
+              <div className="badge badge-outline px-3 py-3">{targetNetwork.name}</div>
+            </div>
+            <h1 className="mt-5 text-4xl font-semibold leading-tight sm:text-5xl">Stake USDC on Base</h1>
+            <p className="mt-4 max-w-2xl text-base text-base-content/70">
+              Deposit USDC into a minimal position contract and withdraw the full balance whenever you choose.
+            </p>
+          </div>
+
+          <div className="bg-base-100 border border-base-300 p-5">
+            <div className="text-sm font-medium text-base-content/70">Contract</div>
+            <div className="mt-3 space-y-3 text-sm">
+              <div className="flex items-center justify-between gap-4">
+                <span className="text-base-content/60">Staker</span>
+                <span className="max-w-48 truncate font-mono">{stakerAddress ?? "Not deployed"}</span>
+              </div>
+              <div className="flex items-center justify-between gap-4">
+                <span className="text-base-content/60">USDC</span>
+                <span className="max-w-48 truncate font-mono">{usdcAddress ?? "Unavailable"}</span>
+              </div>
+            </div>
+          </div>
+        </section>
+
+        <section className="grid gap-4 md:grid-cols-3">
+          <Stat
+            icon={<WalletIcon className="h-5 w-5" />}
+            label="Wallet USDC"
+            value={`${formatTokenAmount(walletUsdcBalance)} USDC`}
+            subValue={formatFiat(walletUsdcBalance, USDC_DECIMALS, prices.usdc)}
+          />
+          <Stat
+            icon={<BoltIcon className="h-5 w-5" />}
+            label="ETH for gas"
+            value={`${ethBalance ? compactTokenFormatter.format(Number(formatEther(ethBalance.value))) : "0"} ETH`}
+            subValue={formatFiat(ethBalance?.value, 18, prices.eth)}
+          />
+          <Stat
+            icon={<CheckCircleIcon className="h-5 w-5" />}
+            label="Staked position"
+            value={`${formatTokenAmount(stakedPosition)} USDC`}
+            subValue={formatFiat(stakedPosition, USDC_DECIMALS, prices.usdc)}
+          />
+        </section>
+
+        <section className="grid gap-6 lg:grid-cols-[1fr_22rem]">
+          <div className="bg-base-100 border border-base-300 p-5 sm:p-6">
+            <div className="flex flex-col gap-4 sm:flex-row sm:items-end">
+              <label className="form-control flex-1">
+                <div className="label">
+                  <span className="label-text font-medium">Amount</span>
+                  <span className="label-text-alt">USDC</span>
+                </div>
+                <div className="join w-full">
+                  <input
+                    className="input join-item input-bordered w-full text-lg"
+                    inputMode="decimal"
+                    placeholder="0.00"
+                    value={stakeAmount}
+                    onChange={event => setStakeAmount(event.target.value)}
+                  />
+                  <button
+                    type="button"
+                    className="btn join-item"
+                    disabled={!walletUsdcBalance || walletUsdcBalance === 0n || isBusy}
+                    onClick={() => setStakeAmount(formatUnits(walletUsdcBalance ?? 0n, USDC_DECIMALS))}
+                  >
+                    Max
+                  </button>
+                </div>
+              </label>
+
+              <button
+                className="btn btn-primary min-w-44"
+                disabled={primaryActionDisabled}
+                onClick={handlePrimaryAction}
+              >
+                {isBusy && pendingAction !== "withdraw" ? (
+                  <span className="loading loading-spinner loading-sm" />
+                ) : null}
+                {primaryActionLabel}
+              </button>
+            </div>
+
+            {stakeAmountError ? <div className="mt-3 text-sm text-error">{stakeAmountError}</div> : null}
+            {actionError ? <div className="mt-3 text-sm text-error whitespace-pre-wrap">{actionError}</div> : null}
+
+            <div className="mt-6 grid gap-3 sm:grid-cols-3">
+              <div className="border border-base-300 p-4">
+                <div className="text-sm text-base-content/60">Approved</div>
+                <div className="mt-2 font-medium">{formatTokenAmount(allowance)} USDC</div>
+              </div>
+              <div className="border border-base-300 p-4">
+                <div className="text-sm text-base-content/60">Total staked</div>
+                <div className="mt-2 font-medium">{formatTokenAmount(totalStaked)} USDC</div>
+              </div>
+              <div className="border border-base-300 p-4">
+                <div className="text-sm text-base-content/60">Prices</div>
+                <div className="mt-2 font-medium">
+                  {prices.updatedAt
+                    ? `CoinGecko ${prices.updatedAt.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })}`
+                    : (prices.error ?? "Loading")}
+                </div>
+              </div>
+            </div>
+          </div>
+
+          <div className="bg-base-100 border border-base-300 p-5 sm:p-6">
+            <div className="flex items-start justify-between gap-4">
+              <div>
+                <h2 className="text-xl font-semibold">Withdraw</h2>
+                <p className="mt-2 text-sm text-base-content/70">Full position only</p>
+              </div>
+              <ArrowUpRightIcon className="h-6 w-6 text-base-content/50" />
+            </div>
+
+            <div className="mt-8 text-3xl font-semibold">{formatTokenAmount(stakedPosition)} USDC</div>
+            <div className="mt-2 text-sm text-base-content/70">
+              {formatFiat(stakedPosition, USDC_DECIMALS, prices.usdc)}
+            </div>
+
+            <button
+              className="btn btn-secondary mt-8 w-full"
+              disabled={isBusy || !isConnected || isWrongNetwork || !stakerAddress || !hasPosition}
+              onClick={handleWithdraw}
+            >
+              {pendingAction === "withdraw" ? <span className="loading loading-spinner loading-sm" /> : null}
+              Withdraw All
+            </button>
+          </div>
+        </section>
+
+        <button className="btn btn-ghost w-fit gap-2" disabled={isBusy} onClick={refetchStakeData}>
+          <ArrowPathIcon className="h-4 w-4" />
+          Refresh
+        </button>
+      </div>
+    </div>
+  );
+};
+
+export default StakePage;
