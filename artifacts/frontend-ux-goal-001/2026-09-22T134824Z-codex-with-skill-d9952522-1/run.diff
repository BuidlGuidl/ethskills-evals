--- /dev/null
+++ b/packages/hardhat/deploy/00_deploy_staker.ts
@@ -0,0 +1,45 @@
+import { deployScript, artifacts } from "../rocketh/deploy.js";
+
+const BASE_USDC_ADDRESS = "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913";
+const INITIAL_MOCK_USDC_SUPPLY = 1_000_000_000_000n;
+
+const getNetworkName = () => {
+  const networkIndex = process.argv.indexOf("--network");
+  return networkIndex === -1 ? "default" : process.argv[networkIndex + 1];
+};
+
+export default deployScript(
+  async env => {
+    const { deployer } = env.namedAccounts;
+    const networkName = getNetworkName();
+    const usesBaseUsdc = networkName === "base";
+
+    let usdcAddress = BASE_USDC_ADDRESS;
+
+    if (!usesBaseUsdc) {
+      const mockUsdc = await env.deploy("MockUSDC", {
+        account: deployer,
+        artifact: artifacts.MockUSDC,
+        args: [deployer, INITIAL_MOCK_USDC_SUPPLY],
+      });
+
+      usdcAddress = mockUsdc.address;
+      console.log("Local MockUSDC deployed at:", usdcAddress);
+    } else {
+      console.log("Using Base USDC at:", usdcAddress);
+    }
+
+    const staker = await env.deploy("Staker", {
+      account: deployer,
+      artifact: artifacts.Staker,
+      args: [usdcAddress],
+    });
+
+    const stakingToken = await env.read(staker, { functionName: "stakingToken" });
+    console.log("USDC Staker deployed at:", staker.address);
+    console.log("Staking token:", stakingToken);
+  },
+  {
+    tags: ["Staker"],
+  },
+);
