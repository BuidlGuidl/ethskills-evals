index 0000000..d7180e4
--- /dev/null
+++ b/packages/nextjs/app/stake/_components/StakeDashboard.tsx
@@ -0,0 +1,314 @@
+"use client";
+
+import { useState } from "react";
+import { Balance } from "@scaffold-ui/components";
+import { Address as AddressType, erc20Abi, formatUnits, parseUnits } from "viem";
+import { useAccount, useBalance, useReadContract, useSwitchChain, useWriteContract } from "wagmi";
+import { RainbowKitCustomConnectButton } from "~~/components/scaffold-eth";
+import {
+  useDeployedContractInfo,
+  useScaffoldReadContract,
+  useScaffoldWriteContract,
+  useTargetNetwork,
+  useTransactor,
+} from "~~/hooks/scaffold-eth";
+import scaffoldConfig from "~~/scaffold.config";
+
+type TxStep = "idle" | "approving" | "staking" | "withdrawing";
+
+// Exact bigint -> "1,234.56" formatting; never goes through floats so no USDC dust is lost or invented.
+const formatTokenAmount = (value: bigint, decimals: number) => {
+  const [whole, fraction = ""] = formatUnits(value, decimals).split(".");
+  return `${BigInt(whole).toLocaleString("en-US")}.${fraction.replace(/0+$/, "").padEnd(2, "0")}`;
+};
+
+export const StakeDashboard = () => {
+  const { address, chainId: walletChainId, isConnected } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+  const { switchChain, isPending: isSwitching } = useSwitchChain();
+  const { data: stakerInfo, isLoading: isStakerLoading } = useDeployedContractInfo({ contractName: "Staker" });
+
+  if (!isConnected || !address) {
+    return (
+      <StatusCard title="Connect your wallet" description="Connect a wallet to stake USDC.">
+        <RainbowKitCustomConnectButton />
+      </StatusCard>
+    );
+  }
+
+  if (walletChainId !== targetNetwork.id) {
+    return (
+      <StatusCard title="Wrong network" description={`Staking is available on ${targetNetwork.name}.`}>
+        <button
+          className="btn btn-primary"
+          disabled={isSwitching}
+          onClick={() => switchChain({ chainId: targetNetwork.id })}
+        >
+          {isSwitching && <span className="loading loading-spinner loading-sm" />}
+          Switch to {targetNetwork.name}
+        </button>
+      </StatusCard>
+    );
+  }
+
+  if (isStakerLoading) {
+    return <span className="loading loading-spinner loading-lg" />;
+  }
+
+  if (!stakerInfo) {
+    return (
+      <StatusCard
+        title="Staking unavailable"
+        description={`The staking contract is not deployed on ${targetNetwork.name}.`}
+      />
+    );
+  }
+
+  return <StakeForm userAddress={address} stakerAddress={stakerInfo.address} />;
+};
+
+const StakeForm = ({ userAddress, stakerAddress }: { userAddress: AddressType; stakerAddress: AddressType }) => {
+  const { targetNetwork } = useTargetNetwork();
+  const chainId = targetNetwork.id;
+  const [amountInput, setAmountInput] = useState("");
+  const [step, setStep] = useState<TxStep>("idle");
+
+  // The staking token comes from the contract itself, so the UI can never approve/display a different token.
+  const { data: tokenAddress } = useScaffoldReadContract({ contractName: "Staker", functionName: "token" });
+  const { data: staked, refetch: refetchStaked } = useScaffoldReadContract({
+    contractName: "Staker",
+    functionName: "balances",
+    args: [userAddress],
+  });
+
+  const tokenQuery = { enabled: Boolean(tokenAddress), refetchInterval: scaffoldConfig.pollingInterval };
+  const { data: decimals } = useReadContract({
+    address: tokenAddress,
+    abi: erc20Abi,
+    functionName: "decimals",
+    chainId,
+    query: { enabled: Boolean(tokenAddress) },
+  });
+  const { data: symbol = "USDC" } = useReadContract({
+    address: tokenAddress,
+    abi: erc20Abi,
+    functionName: "symbol",
+    chainId,
+    query: { enabled: Boolean(tokenAddress) },
+  });
+  const { data: walletBalance, refetch: refetchWalletBalance } = useReadContract({
+    address: tokenAddress,
+    abi: erc20Abi,
+    functionName: "balanceOf",
+    args: [userAddress],
+    chainId,
+    query: tokenQuery,
+  });
+  const { data: allowance, refetch: refetchAllowance } = useReadContract({
+    address: tokenAddress,
+    abi: erc20Abi,
+    functionName: "allowance",
+    args: [userAddress, stakerAddress],
+    chainId,
+    query: tokenQuery,
+  });
+  const { data: ethBalance } = useBalance({
+    address: userAddress,
+    chainId,
+    query: { refetchInterval: scaffoldConfig.pollingInterval },
+  });
+
+  const { writeContractAsync: writeToken } = useWriteContract();
+  const transactor = useTransactor();
+  const { writeContractAsync: writeStaker } = useScaffoldWriteContract({ contractName: "Staker" });
+
+  const isReady = decimals !== undefined && walletBalance !== undefined && allowance !== undefined;
+  const isBusy = step !== "idle";
+
+  let amount: bigint | undefined;
+  if (decimals !== undefined && amountInput !== "") {
+    try {
+      amount = parseUnits(amountInput, decimals);
+    } catch {
+      amount = undefined;
+    }
+  }
+
+  let amountError: string | undefined;
+  if (amount !== undefined && walletBalance !== undefined && amount > walletBalance) {
+    amountError = `Insufficient ${symbol} balance`;
+  }
+
+  const needsApproval = amount !== undefined && allowance !== undefined && allowance < amount;
+  const canStake = isReady && !isBusy && amount !== undefined && amount > 0n && !amountError;
+  const hasNoGas = ethBalance?.value === 0n;
+
+  const handleAmountChange = (value: string) => {
+    // Only digits with at most `decimals` fractional digits, so parseUnits never silently rounds the input.
+    const maxDecimals = decimals ?? 6;
+    if (new RegExp(`^\\d*(\\.\\d{0,${maxDecimals}})?$`).test(value)) setAmountInput(value);
+  };
+
+  const refreshBalances = () => Promise.all([refetchWalletBalance(), refetchAllowance(), refetchStaked()]);
+
+  const handleStake = async () => {
+    if (!canStake || !tokenAddress || amount === undefined) return;
+    try {
+      if (needsApproval) {
+        setStep("approving");
+        // Approve only the amount being staked — no unlimited allowances.
+        const approveHash = await transactor(() =>
+          writeToken({
+            address: tokenAddress,
+            abi: erc20Abi,
+            functionName: "approve",
+            args: [stakerAddress, amount],
+            chainId,
+          }),
+        );
+        if (!approveHash) return;
+        await refetchAllowance();
+      }
+
+      setStep("staking");
+      const stakeHash = await writeStaker({ functionName: "stake", args: [amount] });
+      if (stakeHash) setAmountInput("");
+    } catch (e) {
+      // Errors are already surfaced to the user via notifications by the transactor.
+      console.error("Stake failed", e);
+    } finally {
+      setStep("idle");
+      await refreshBalances();
+    }
+  };
+
+  const handleWithdraw = async () => {
+    try {
+      setStep("withdrawing");
+      await writeStaker({ functionName: "withdraw" });
+    } catch (e) {
+      console.error("Withdraw failed", e);
+    } finally {
+      setStep("idle");
+      await refreshBalances();
+    }
+  };
+
+  const format = (value: bigint | undefined) =>
+    value === undefined || decimals === undefined ? "—" : `${formatTokenAmount(value, decimals)} ${symbol}`;
+
+  let stakeLabel = "Stake";
+  if (step === "approving") stakeLabel = `Approving ${symbol} (1/2)…`;
+  else if (step === "staking") stakeLabel = "Staking…";
+  else if (needsApproval && canStake) stakeLabel = `Approve & stake`;
+
+  return (
+    <div className="w-full max-w-lg flex flex-col gap-6">
+      <div className="card bg-base-100 shadow-xl">
+        <div className="card-body gap-4">
+          <h2 className="card-title">Your balances</h2>
+          <div className="stats stats-vertical bg-base-200">
+            <div className="stat">
+              <div className="stat-title">Staked position</div>
+              <div className="stat-value text-2xl">{format(staked)}</div>
+            </div>
+            <div className="stat">
+              <div className="stat-title">Wallet {symbol}</div>
+              <div className="stat-value text-2xl">{format(walletBalance)}</div>
+            </div>
+            <div className="stat">
+              <div className="stat-title">Wallet ETH (for network fees)</div>
+              <div className="stat-value text-2xl">
+                <Balance address={userAddress} chain={targetNetwork} />
+              </div>
+            </div>
+          </div>
+          {hasNoGas && (
+            <div role="alert" className="alert alert-warning">
+              <span>
+                You have no ETH on {targetNetwork.name}. You need a small amount of ETH to pay network fees before you
+                can stake or withdraw.
+              </span>
+            </div>
+          )}
+        </div>
+      </div>
+
+      <div className="card bg-base-100 shadow-xl">
+        <div className="card-body gap-4">
+          <h2 className="card-title">Stake</h2>
+          <fieldset className="fieldset">
+            <label className="input input-lg w-full">
+              <input
+                type="text"
+                inputMode="decimal"
+                autoComplete="off"
+                placeholder="0.00"
+                value={amountInput}
+                disabled={isBusy}
+                onChange={e => handleAmountChange(e.target.value.trim())}
+                aria-label={`Amount of ${symbol} to stake`}
+              />
+              <span className="text-base-content/60">{symbol}</span>
+              <button
+                type="button"
+                className="btn btn-ghost btn-xs"
+                disabled={!isReady || isBusy || walletBalance === 0n}
+                onClick={() => walletBalance !== undefined && setAmountInput(formatUnits(walletBalance, decimals!))}
+              >
+                Max
+              </button>
+            </label>
+            {amountError ? (
+              <p className="label text-error">{amountError}</p>
+            ) : (
+              <p className="label">Available: {format(walletBalance)}</p>
+            )}
+          </fieldset>
+          {needsApproval && canStake && (
+            <p className="text-sm text-base-content/70">
+              Staking takes two transactions: approve {symbol} for the staking contract, then stake.
+            </p>
+          )}
+          <button className="btn btn-primary btn-lg" disabled={!canStake} onClick={handleStake}>
+            {(step === "approving" || step === "staking") && <span className="loading loading-spinner" />}
+            {stakeLabel}
+          </button>
+        </div>
+      </div>
+
+      <div className="card bg-base-100 shadow-xl">
+        <div className="card-body gap-4">
+          <h2 className="card-title">Withdraw</h2>
+          <p className="text-base-content/70">Withdraw your full staked position back to your wallet.</p>
+          <button
+            className="btn btn-outline btn-lg"
+            disabled={isBusy || !staked || staked === 0n}
+            onClick={handleWithdraw}
+          >
+            {step === "withdrawing" && <span className="loading loading-spinner" />}
+            {step === "withdrawing" ? "Withdrawing…" : staked ? `Withdraw ${format(staked)}` : "Nothing to withdraw"}
+          </button>
+        </div>
+      </div>
+    </div>
+  );
+};
+
+const StatusCard = ({
+  title,
+  description,
+  children,
+}: {
+  title: string;
+  description: string;
+  children?: React.ReactNode;
+}) => (
+  <div className="card bg-base-100 shadow-xl w-full max-w-lg">
+    <div className="card-body items-center text-center">
+      <h2 className="card-title">{title}</h2>
+      <p className="text-base-content/70">{description}</p>
+      {children && <div className="card-actions mt-2">{children}</div>}
+    </div>
+  </div>
+);
