+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import { ERC20 } from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+
+/**
+ * @title MockUSDC
+ * @notice LOCAL DEVELOPMENT ONLY. Matches Circle's USDC where it matters to this app:
+ * name "USD Coin", symbol "USDC" and 6 decimals (not 18!).
+ * Minting is open to anyone so devs can fund test accounts — never deploy this to a live network.
+ */
+contract MockUSDC is ERC20 {
+    constructor() ERC20("USD Coin", "USDC") {}
+
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    function mint(address to, uint256 amount) external {
+        _mint(to, amount);
+    }
+}
