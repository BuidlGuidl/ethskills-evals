@@ -0,0 +1,45 @@
+import { deployScript, artifacts } from "../rocketh/deploy.js";
+
+// Circle's native USDC. Never use a mock on these networks.
+const USDC_BY_CHAIN_ID: Record<number, `0x${string}`> = {
+  8453: "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913", // Base
+  84532: "0x036CbD53842c5426634e7929541eC2318f3dCF7e", // Base Sepolia
+};
+
+const LOCAL_CHAIN_IDS = [31337, 1337];
+
+/**
+ * Deploys the Staker contract against USDC.
+ * - Base / Base Sepolia: uses Circle's USDC.
+ * - Local chains: deploys MockUSDC (6 decimals, like the real token) first.
+ * - Anything else: aborts, so we never ship a Staker bound to the wrong token.
+ */
+export default deployScript(
+  async env => {
+    const { deployer } = env.namedAccounts;
+    const chainId = Number(env.network.chain.id);
+
+    let usdcAddress = USDC_BY_CHAIN_ID[chainId];
+    if (!usdcAddress) {
+      if (!LOCAL_CHAIN_IDS.includes(chainId)) {
+        throw new Error(`No USDC address configured for chain ${chainId}. Add it to USDC_BY_CHAIN_ID.`);
+      }
+      const mockUsdc = await env.deploy("MockUSDC", {
+        account: deployer,
+        artifact: artifacts.MockUSDC,
+        args: [],
+      });
+      usdcAddress = mockUsdc.address;
+    }
+
+    const staker = await env.deploy("Staker", {
+      account: deployer,
+      artifact: artifacts.Staker,
+      args: [usdcAddress],
+    });
+    console.log(`🏦 Staker deployed at ${staker.address} using USDC at ${usdcAddress}`);
+  },
+  {
+    tags: ["Staker"],
+  },
+);
