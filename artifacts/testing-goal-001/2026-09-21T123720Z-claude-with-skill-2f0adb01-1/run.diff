+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console} from "forge-std/Test.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+
+import {UsdtYieldVault} from "../src/UsdtYieldVault.sol";
+import {MockUSDT} from "./mocks/MockUSDT.sol";
+import {MockAavePool, MockAToken} from "./mocks/MockAavePool.sol";
+
+/// @notice Guided random deposit/withdraw sequences against the vault.
+contract VaultHandler is Test {
+    UsdtYieldVault public vault;
+    MockUSDT public usdt;
+    MockAToken public aUsdt;
+
+    address[] public actors;
+    address internal current;
+
+    uint256 public totalDeposited;
+    uint256 public totalWithdrawn;
+    uint256 public depositCalls;
+    uint256 public withdrawCalls;
+
+    constructor(UsdtYieldVault _vault, MockUSDT _usdt, MockAToken _aUsdt) {
+        vault = _vault;
+        usdt = _usdt;
+        aUsdt = _aUsdt;
+
+        for (uint256 i = 0; i < 4; i++) {
+            address a = address(uint160(uint256(keccak256(abi.encode("actor", i)))));
+            actors.push(a);
+            usdt.mint(a, 10_000_000e6);
+            vm.prank(a);
+            usdt.approve(address(vault), type(uint256).max);
+        }
+    }
+
+    modifier useActor(uint256 seed) {
+        current = actors[bound(seed, 0, actors.length - 1)];
+        _;
+    }
+
+    function deposit(uint256 actorSeed, uint256 amount) public useActor(actorSeed) {
+        amount = bound(amount, vault.MIN_DEPOSIT(), 100_000e6);
+        if (usdt.balanceOf(current) < amount) return;
+
+        vm.prank(current);
+        try vault.deposit(amount) {
+            totalDeposited += amount;
+            depositCalls++;
+        } catch {}
+    }
+
+    function withdraw(uint256 actorSeed, uint256 shares) public useActor(actorSeed) {
+        uint256 held = vault.shareBalance(current);
+        if (held == 0) return;
+        shares = bound(shares, 1, held);
+
+        vm.prank(current);
+        try vault.withdraw(shares) returns (uint256 net) {
+            totalWithdrawn += net;
+            withdrawCalls++;
+        } catch {}
+    }
+
+    function actorCount() external view returns (uint256) {
+        return actors.length;
+    }
+}
+
+contract VaultInvariantTest is Test {
+    UsdtYieldVault internal vault;
+    MockUSDT internal usdt;
+    MockAavePool internal pool;
+    MockAToken internal aUsdt;
+    VaultHandler internal handler;
+
+    address internal owner = makeAddr("owner");
+
+    function setUp() public {
+        usdt = new MockUSDT();
+        pool = new MockAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 10, owner);
+
+        handler = new VaultHandler(vault, usdt, aUsdt);
+        targetContract(address(handler));
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        THE CORE ACCOUNTING INVARIANT - FAILS.
+
+        Every unit of USDT the vault owns inside Aave should be claimable by
+        some shareholder. That is exactly what README.md promises for both
+        fees. withdraw() breaks it on the very first withdrawal and the gap
+        only ever widens.
+    //////////////////////////////////////////////////////////////*/
+    function invariant_EveryAssetHeldIsClaimableBySomeone() public view {
+        uint256 held = aUsdt.balanceOf(address(vault));
+        uint256 claimable = vault.totalAssetsStored();
+        assertEq(held, claimable, "vault holds aUSDT that no share can ever redeem");
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        HOLDS - reported as a genuine positive: the vault never becomes
+        insolvent. Internal accounting is conservative, so it can never
+        promise more USDT than it can pull out of Aave. Value leaks the
+        safe direction: it gets stuck, not stolen.
+    //////////////////////////////////////////////////////////////*/
+    function invariant_VaultIsNeverInsolvent() public view {
+        assertLe(
+            vault.totalAssetsStored(),
+            aUsdt.balanceOf(address(vault)),
+            "vault owes more USDT than it can withdraw from Aave"
+        );
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        HOLDS - share price is monotonically non-decreasing, so no sequence
+        of deposits/withdrawals lets one user dilute another.
+    //////////////////////////////////////////////////////////////*/
+    uint256 internal lastPrice;
+
+    function invariant_SharePriceNeverDecreases() public {
+        uint256 p = vault.sharePrice();
+        if (vault.totalShares() > 0) {
+            assertGe(p, lastPrice, "share price went down; existing holders were diluted");
+            lastPrice = p;
+        }
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        HOLDS - convertToShares()/convertToAssets() divide by
+        totalAssetsStored and totalShares respectively. Neither can be
+        driven to zero while the other is non-zero, so the share maths
+        cannot be bricked by a crafted sequence.
+    //////////////////////////////////////////////////////////////*/
+    function invariant_ShareMathCannotBeBricked() public view {
+        if (vault.totalShares() > 0) {
+            assertGt(vault.totalAssetsStored(), 0, "totalAssetsStored hit zero with shares outstanding: convertToShares reverts");
+        }
+        if (vault.totalAssetsStored() > 0) {
+            assertGt(vault.totalShares(), 0, "assets stranded with no shares outstanding");
+        }
+    }
+
+    function invariant_CallSummary() public view {
+        console.log("deposit calls                   :", handler.depositCalls());
+        console.log("withdraw calls                  :", handler.withdrawCalls());
+        console.log("total USDT deposited            :", handler.totalDeposited());
+        console.log("total USDT withdrawn            :", handler.totalWithdrawn());
+        console.log("aUSDT held by vault             :", aUsdt.balanceOf(address(vault)));
+        console.log("totalAssetsStored (claimable)   :", vault.totalAssetsStored());
+        console.log("UNCLAIMABLE, stuck forever      :", aUsdt.balanceOf(address(vault)) - vault.totalAssetsStored());
+    }
+}

