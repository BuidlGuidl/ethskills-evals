+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console} from "forge-std/Test.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+
+import {UsdtYieldVault} from "../src/UsdtYieldVault.sol";
+
+interface ITether {
+    function owner() external view returns (address);
+    function basisPointsRate() external view returns (uint256);
+    function maximumFee() external view returns (uint256);
+    function setParams(uint256 newBasisPoints, uint256 newMaxFee) external;
+    function allowance(address, address) external view returns (uint256);
+}
+
+/// @notice The vault is tested here against the ACTUAL mainnet contracts it will
+///         be pointed at on Monday - real USDT, real Aave V3 pool, real aUSDT -
+///         rather than against test/mocks/, which model neither USDT's
+///         non-standard ERC-20 nor Aave's interest accrual.
+///
+///         Self-contained: the RPC and fork block are hardcoded, so
+///         `forge test --match-path test/RealUsdtFork.t.sol` is the whole command.
+contract RealUsdtForkTest is Test {
+    // Addresses taken verbatim from README.md / the task brief.
+    address internal constant USDT = 0xdAC17F958D2ee523a2206206994597C13D831ec7;
+    address internal constant AAVE_POOL = 0x87870Bca3F3fD6335C3F4ce8392D69350B4fA4E2;
+    address internal constant AUSDT = 0x23878914EFE38d27C4D67Ab83ed1b93A74D4086a;
+
+    string internal constant RPC = "https://eth.drpc.org";
+    uint256 internal constant FORK_BLOCK = 23_500_000;
+
+    UsdtYieldVault internal vault;
+
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+    address internal bob = makeAddr("bob");
+
+    uint256 internal constant FEE_BPS = 10;
+    uint256 internal constant AMT = 10_000e6; // 10k USDT
+
+    function setUp() public {
+        vm.createSelectFork(RPC, FORK_BLOCK);
+        vault = new UsdtYieldVault(USDT, AUSDT, AAVE_POOL, FEE_BPS, owner);
+
+        deal(USDT, alice, 1_000_000e6);
+        deal(USDT, bob, 1_000_000e6);
+
+        // Users approve via a raw call because real USDT.approve returns no data.
+        _rawApprove(alice, address(vault), type(uint256).max);
+        _rawApprove(bob, address(vault), type(uint256).max);
+    }
+
+    function _rawApprove(address from, address spender, uint256 amount) internal {
+        vm.prank(from);
+        (bool ok,) = USDT.call(abi.encodeWithSignature("approve(address,uint256)", spender, amount));
+        require(ok, "raw approve failed");
+    }
+
+    /// @dev Neutralises Finding 1 ONLY, so that the findings downstream of the
+    ///      approve() call are reachable. The real allowance is set for real by a
+    ///      raw call; the mock just makes the vault's own `approve` return `true`
+    ///      the way a standard ERC-20 would. Everything else stays real.
+    function _workAroundBrokenApprove() internal {
+        _rawApprove(address(vault), AAVE_POOL, type(uint256).max);
+        vm.mockCall(USDT, abi.encodeWithSelector(IERC20.approve.selector), abi.encode(true));
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        F1 - deposit() ALWAYS reverts against real USDT.
+
+        USDT's approve() writes no return data. The vault calls it through the
+        IERC20 interface, which is declared `returns (bool)`, so Solidity's
+        ABI decoder reverts on the empty returndata. The vault uses SafeERC20
+        for transferFrom but calls `usdt.approve(...)` raw.
+
+        test/mocks/MockUSDT.sol is a stock OpenZeppelin ERC20 that DOES return
+        a bool, which is the single reason all 39 shipped tests pass.
+    //////////////////////////////////////////////////////////////*/
+    function test_Fork_DepositAlwaysRevertsWithRealUsdt() public {
+        console.log("USDT.balanceOf(alice)           :", IERC20(USDT).balanceOf(alice));
+        console.log("USDT.allowance(alice, vault)    :", IERC20(USDT).allowance(alice, address(vault)));
+
+        vm.prank(alice);
+        uint256 shares = vault.deposit(AMT); // reverts: cannot decode bool from USDT.approve
+
+        console.log("shares minted                   :", shares);
+    }
+
+    /// @notice Same thing, stated as an explicit expectation so the revert itself
+    ///         is the assertion. This one PASSES - it proves the revert is real.
+    function test_Fork_DepositRevertIsProven() public {
+        vm.prank(alice);
+        vm.expectRevert();
+        vault.deposit(AMT);
+
+        assertEq(vault.totalShares(), 0, "no deposit can ever succeed on mainnet");
+        console.log("confirmed: deposit() reverts against real USDT at block", FORK_BLOCK);
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        F8 - the vault earns Aave yield but never pays it out.
+
+        totalAssetsStored is a plain counter that only moves on deposit and
+        withdraw. It never reads aUSDT.balanceOf(vault), so the interest Aave
+        pays is invisible to convertToAssets(). After a year of real Aave
+        interest the depositor redeems their principal and nothing else; the
+        yield is stranded in the contract with no code path to reach it.
+
+        test/mocks/MockAavePool.sol never accrues a single wei of interest,
+        so the shipped suite cannot see this.
+    //////////////////////////////////////////////////////////////*/
+    function test_Fork_AaveYieldNeverReachesDepositors() public {
+        _workAroundBrokenApprove();
+
+        vm.prank(alice);
+        uint256 shares = vault.deposit(AMT);
+
+        uint256 aBefore = IERC20(AUSDT).balanceOf(address(vault));
+        uint256 claimBefore = vault.balanceOfUnderlying(alice);
+
+        vm.warp(block.timestamp + 365 days);
+
+        uint256 aAfter = IERC20(AUSDT).balanceOf(address(vault));
+        uint256 claimAfter = vault.balanceOfUnderlying(alice);
+
+        console.log("deposited                       :", AMT);
+        console.log("aUSDT held by vault, day 0      :", aBefore);
+        console.log("aUSDT held by vault, day 365    :", aAfter);
+        console.log("real Aave interest earned       :", aAfter - aBefore);
+        console.log("totalAssets() day 0             :", claimBefore);
+        console.log("totalAssets() day 365           :", vault.totalAssets());
+        console.log("alice's claim, day 0            :", claimBefore);
+        console.log("alice's claim, day 365          :", claimAfter);
+        console.log("sharePrice() day 365            :", vault.sharePrice());
+        shares;
+
+        assertGt(aAfter, aBefore, "sanity: real Aave must have paid interest over a year");
+        assertGt(claimAfter, claimBefore, "a yield vault must pass Aave interest on to its depositors");
+    }
+
+    /// @notice And the yield is not merely delayed - it is unreachable. Alice
+    ///         withdraws everything after a year and gets less than she paid in.
+    function test_Fork_DepositorEndsUpBelowPrincipalAfterAYear() public {
+        _workAroundBrokenApprove();
+
+        uint256 before = IERC20(USDT).balanceOf(alice);
+
+        vm.prank(alice);
+        uint256 shares = vault.deposit(AMT);
+
+        vm.warp(block.timestamp + 365 days);
+
+        vm.prank(alice);
+        uint256 net = vault.withdraw(shares);
+
+        uint256 stranded = IERC20(AUSDT).balanceOf(address(vault));
+
+        console.log("alice paid in                   :", AMT);
+        console.log("alice got back after 365 days   :", net);
+        console.log("totalShares now                 :", vault.totalShares());
+        console.log("aUSDT left in vault (unreachable):", stranded);
+        console.log("alice USDT delta                :", IERC20(USDT).balanceOf(alice) - (before - AMT));
+
+        assertGe(net, AMT, "after a year in Aave the depositor should be up, not down");
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        F7b - withdraw() of a small share amount rounds grossAssets to zero
+        and calls aavePool.withdraw(asset, 0, to). The real Aave V3 pool
+        rejects that with error '26' (INVALID_AMOUNT). MockAavePool accepts it.
+    //////////////////////////////////////////////////////////////*/
+    function test_Fork_SmallWithdrawRevertsOnRealAave() public {
+        _workAroundBrokenApprove();
+
+        vm.prank(alice);
+        vault.deposit(AMT);
+
+        // 1e11 shares < SHARE_SCALE, so convertToAssets() floors to 0.
+        assertEq(vault.convertToAssets(1e11), 0, "gross assets round to zero");
+
+        vm.prank(alice);
+        vault.withdraw(1e11); // reverts inside the real Aave pool
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        F9 - USDT is a fee-on-transfer token whose fee is a live, owner-flippable
+        parameter (currently 0). The vault transfers `amount` in and then supplies
+        `amount` to Aave. The moment Tether turns the fee on, the vault holds less
+        than `amount` and every deposit reverts.
+
+        This is not hypothetical state manipulation: setParams() is called here as
+        the real, current USDT owner, within the limits USDT itself enforces.
+    //////////////////////////////////////////////////////////////*/
+    function test_Fork_DepositBreaksIfTetherEnablesTransferFee() public {
+        _workAroundBrokenApprove();
+
+        // Deposits work with the fee at zero.
+        vm.prank(alice);
+        vault.deposit(AMT);
+
+        address tetherOwner = ITether(USDT).owner();
+        console.log("current basisPointsRate         :", ITether(USDT).basisPointsRate());
+        console.log("USDT owner                      :", tetherOwner);
+
+        vm.prank(tetherOwner);
+        ITether(USDT).setParams(10, 30); // 0.1%, capped at 30 USDT - within USDT's own limits
+
+        console.log("new basisPointsRate             :", ITether(USDT).basisPointsRate());
+        console.log("new maximumFee                  :", ITether(USDT).maximumFee());
+
+        vm.prank(bob);
+        vault.deposit(AMT); // reverts: vault received less than `amount`, cannot supply `amount`
+    }
