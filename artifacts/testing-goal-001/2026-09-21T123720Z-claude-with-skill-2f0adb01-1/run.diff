+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console, stdError} from "forge-std/Test.sol";
+
+import {UsdtYieldVault} from "../src/UsdtYieldVault.sol";
+import {MockUSDT} from "./mocks/MockUSDT.sol";
+import {MockAavePool, MockAToken} from "./mocks/MockAavePool.sol";
+
+/// @notice Accounting regressions reproducible with the project's OWN mocks.
+///         Nothing here is fork-dependent: `forge test --match-path test/AccountingRegression.t.sol`
+///         reproduces every failure offline.
+contract AccountingRegressionTest is Test {
+    UsdtYieldVault internal vault;
+    MockUSDT internal usdt;
+    MockAavePool internal pool;
+    MockAToken internal aUsdt;
+
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+    address internal bob = makeAddr("bob");
+    address internal carol = makeAddr("carol");
+
+    uint256 internal constant FEE_BPS = 10; // same as the shipped suite
+    uint256 internal constant AMT = 1_000e6;
+
+    function setUp() public {
+        usdt = new MockUSDT();
+        pool = new MockAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), FEE_BPS, owner);
+
+        address[3] memory users = [alice, bob, carol];
+        for (uint256 i = 0; i < users.length; i++) {
+            usdt.mint(users[i], 1_000_000e6);
+            vm.prank(users[i]);
+            usdt.approve(address(vault), type(uint256).max);
+        }
+    }
+
+    function _deposit(address who, uint256 amount) internal returns (uint256) {
+        vm.prank(who);
+        return vault.deposit(amount);
+    }
+
+    function _withdraw(address who, uint256 shares) internal returns (uint256) {
+        vm.prank(who);
+        return vault.withdraw(shares);
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        F2 - the withdrawal fee accrues to NOBODY.
+
+        README.md and the contract NatSpec both promise:
+          "Both fees stay supplied in Aave and accrue to the remaining
+           shareholders - they are not swept to the owner."
+
+        withdraw() subtracts `grossAssets` from totalAssetsStored but only
+        pulls `netAssets` out of Aave. The fee therefore leaves the share
+        accounting at the same moment it stays in Aave: no shareholder's
+        claim goes up by a single wei.
+    //////////////////////////////////////////////////////////////*/
+    function test_WithdrawFeeDoesNotAccrueToRemainingShareholders() public {
+        uint256 aliceShares = _deposit(alice, AMT);
+        _deposit(bob, AMT);
+
+        // Before any withdrawal every aUSDT the vault owns is backed by a share.
+        assertEq(aUsdt.balanceOf(address(vault)), vault.totalAssetsStored(), "sanity: fully backed after deposits");
+
+        uint256 bobBefore = vault.balanceOfUnderlying(bob);
+        uint256 priceBefore = vault.sharePrice();
+        uint256 storedBefore = vault.totalAssetsStored();
+
+        // Alice exits in full. Her 0.3% withdrawal fee stays supplied in Aave.
+        uint256 net = _withdraw(alice, aliceShares);
+        uint256 gross = storedBefore - vault.totalAssetsStored();
+        uint256 fee = gross - net;
+
+        uint256 unclaimable = aUsdt.balanceOf(address(vault)) - vault.totalAssetsStored();
+
+        console.log("gross assets alice was owed     :", gross);
+        console.log("net assets alice received       :", net);
+        console.log("withdrawal fee retained in Aave :", fee);
+        console.log("bob's claim before alice exited :", bobBefore);
+        console.log("bob's claim after  alice exited :", vault.balanceOfUnderlying(bob));
+        console.log("bob's gain from the fee         :", vault.balanceOfUnderlying(bob) - bobBefore);
+        console.log("share price before              :", priceBefore);
+        console.log("share price after               :", vault.sharePrice());
+        console.log("aUSDT owned but owned by no one :", unclaimable);
+
+        // The documented promise: the fee stays in Aave AND accrues to the
+        // remaining shareholders. Bob is now the only shareholder, so his claim
+        // should have grown by the whole fee.
+        assertEq(unclaimable, 0, "every aUSDT the vault holds must be claimable by a shareholder");
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        F3 - value is permanently stranded: once every share is burned
+        the vault still owns aUSDT that no code path can ever move.
+        There is no sweep/rescue/skim function on the contract.
+    //////////////////////////////////////////////////////////////*/
+    function test_AssetsAreStrandedAfterEveryoneExits() public {
+        uint256 aliceShares = _deposit(alice, AMT);
+        uint256 bobShares = _deposit(bob, AMT);
+
+        _withdraw(alice, aliceShares);
+        _withdraw(bob, bobShares);
+
+        uint256 stuck = aUsdt.balanceOf(address(vault));
+
+        console.log("totalShares                     :", vault.totalShares());
+        console.log("totalAssetsStored               :", vault.totalAssetsStored());
+        console.log("aUSDT still owned by the vault  :", stuck);
+        console.log("...i.e. USDT permanently stuck  :", stuck);
+
+        assertEq(stuck, 0, "vault must not retain unclaimable assets once all shares are burned");
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        F5 - setDepositFee() is unbounded. The owner can front-run a
+        pending deposit with a 99.99% fee and take the depositor's money
+        via the share price, or brick deposits outright.
+    //////////////////////////////////////////////////////////////*/
+    function test_OwnerCanSetConfiscatoryDepositFee() public {
+        _deposit(bob, AMT); // owner-controlled position, or just an incumbent
+
+        vm.prank(owner);
+        vault.setDepositFee(9_999); // 99.99%
+
+        uint256 bobBefore = vault.balanceOfUnderlying(bob);
+        uint256 victimIn = 100_000e6;
+        uint256 shares = _deposit(alice, victimIn);
+        uint256 aliceClaim = vault.balanceOfUnderlying(alice);
+
+        console.log("alice paid in                   :", victimIn);
+        console.log("alice's claim on the vault      :", aliceClaim);
+        console.log("bob's claim before              :", bobBefore);
+        console.log("bob's claim after               :", vault.balanceOfUnderlying(bob));
+        console.log("value transferred bob <- alice  :", vault.balanceOfUnderlying(bob) - bobBefore);
+        shares;
+
+        assertGe(aliceClaim, victimIn * 9_000 / 10_000, "a deposit must not be confiscatable by an owner fee change");
+    }
+
+    function test_OwnerCanBrickDepositsWithFeeAboveOneHundredPercent() public {
+        vm.prank(owner);
+        vault.setDepositFee(10_001);
+
+        vm.prank(alice);
+        vm.expectRevert(stdError.arithmeticError); // amount - fee underflows
+        vault.deposit(AMT);
+
+        // and there is no ceiling at all on the stored value
+        vm.prank(owner);
+        vault.setDepositFee(type(uint256).max);
+        assertEq(vault.depositFeeBps(), type(uint256).max);
+        console.log("depositFeeBps accepted          :", vault.depositFeeBps());
+
+        assertLe(vault.depositFeeBps(), vault.BPS_DENOMINATOR(), "deposit fee must be capped at 100%");
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        F6 - pause() blocks withdraw() as well as deposit(). A paused
+        vault is a vault whose users cannot get their money out, and
+        only the owner can unpause. Renounced/lost ownership while
+        paused = total loss.
+    //////////////////////////////////////////////////////////////*/
+    function test_PauseTrapsUserFunds() public {
+        uint256 shares = _deposit(alice, AMT);
+
+        vm.prank(owner);
+        vault.pause();
+
+        vm.prank(owner);
+        vault.renounceOwnership(); // or: key lost, multisig quorum broken
+
+        vm.prank(alice);
+        vm.expectRevert(); // EnforcedPause
+        vault.withdraw(shares);
+
+        console.log("owner after renounce            :", vault.owner());
+        console.log("alice's locked claim            :", vault.balanceOfUnderlying(alice));
+
+        assertTrue(false, "withdrawals are permanently blocked; funds are unrecoverable");
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        F7 - shares can be burned for zero assets. Any holder can hand
+        their shares back for nothing, which silently marks up everyone
+        else. More importantly it shows withdraw() will happily call
+        aavePool.withdraw(asset, 0, to) - which the REAL Aave pool
+        rejects (see test/RealUsdtFork.t.sol).
+    //////////////////////////////////////////////////////////////*/
+    function test_WithdrawCanBurnSharesForZeroAssets() public {
+        uint256 shares = _deposit(alice, AMT);
+
+        uint256 balBefore = usdt.balanceOf(alice);
+        uint256 net = _withdraw(alice, 1e11); // < 1e12 shares => grossAssets rounds to 0
+
+        console.log("shares burned                   :", uint256(1e11));
+        console.log("USDT received                   :", net);
+        console.log("alice USDT delta                :", usdt.balanceOf(alice) - balBefore);
+        console.log("alice shares left               :", vault.shareBalance(alice));
+        shares;
+
+        assertGt(net, 0, "burning shares must never return zero assets");
+    }
+}
