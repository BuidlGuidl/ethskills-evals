@@ -0,0 +1,82 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test} from "forge-std/Test.sol";
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+import {MockUSDT} from "../mocks/MockUSDT.sol";
+import {MockAavePool, MockAToken} from "../mocks/MockAavePool.sol";
+
+/// @notice Deterministic companion to the invariant counterexample: shows the drift is
+///         CUMULATIVE (it grows with each fee-bearing withdrawal) and that the stranded
+///         USDT is unreachable by any function on the vault once everyone has exited.
+contract FeeDriftRegressionTest is Test {
+    UsdtYieldVault internal vault;
+    MockUSDT internal usdt;
+    MockAavePool internal pool;
+    MockAToken internal aUsdt;
+
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+    address internal bob = makeAddr("bob");
+
+    function setUp() public {
+        usdt = new MockUSDT();
+        pool = new MockAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 0, owner);
+
+        usdt.mint(alice, 100_000e6);
+        usdt.mint(bob, 100_000e6);
+        vm.prank(alice);
+        usdt.approve(address(vault), type(uint256).max);
+        vm.prank(bob);
+        usdt.approve(address(vault), type(uint256).max);
+    }
+
+    function _drift() internal view returns (uint256) {
+        return aUsdt.balanceOf(address(vault)) - vault.totalAssetsStored();
+    }
+
+    function test_DriftGrowsWithEachWithdrawal() public {
+        vm.prank(alice);
+        uint256 aliceShares = vault.deposit(10_000e6);
+        vm.prank(bob);
+        uint256 bobShares = vault.deposit(10_000e6);
+
+        uint256 driftAfterDeposits = _drift();
+
+        vm.prank(alice);
+        vault.withdraw(aliceShares / 2);
+        uint256 driftAfterFirstWithdrawal = _drift();
+
+        vm.prank(bob);
+        vault.withdraw(bobShares / 2);
+        uint256 driftAfterSecondWithdrawal = _drift();
+
+        emit log_named_uint("drift after deposits         ", driftAfterDeposits);
+        emit log_named_uint("drift after 1st withdrawal   ", driftAfterFirstWithdrawal);
+        emit log_named_uint("drift after 2nd withdrawal   ", driftAfterSecondWithdrawal);
+
+        assertEq(driftAfterDeposits, 0, "sanity: no drift before any withdrawal");
+        assertEq(driftAfterSecondWithdrawal, 0, "aUSDT held must equal assets accounted for");
+    }
+
+    function test_StrandedFeesAreUnrecoverableAfterFullExit() public {
+        vm.prank(alice);
+        uint256 shares = vault.deposit(10_000e6);
+        vm.prank(alice);
+        vault.withdraw(shares);
+
+        assertEq(vault.totalShares(), 0);
+        assertEq(vault.totalAssetsStored(), 0);
+
+        uint256 stranded = aUsdt.balanceOf(address(vault));
+        emit log_named_uint("shares outstanding           ", vault.totalShares());
+        emit log_named_uint("assets accounted for         ", vault.totalAssetsStored());
+        emit log_named_uint("aUSDT still held by the vault", stranded);
+
+        // No function on the vault can move this: withdraw() needs shares, and there is
+        // no sweep/rescue/harvest entry point. It is locked in Aave forever.
+        assertEq(stranded, 0, "vault holds aUSDT that no shareholder can ever claim");
+    }
+}
diff --git a/test/audit/MainnetFork.t.sol b/test/audit/MainnetFork.t.sol
new file mode 100644
index 0000000..01ee6f3
--- /dev/null
+++ b/test/audit/MainnetFork.t.sol
@@ -0,0 +1,128 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test} from "forge-std/Test.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+
+/// @notice Exercises the vault against the ACTUAL deployments it will hold user funds on:
+///         real USDT and the real Aave V3 pool, on a pinned mainnet block.
+///         Every prior test in this repo runs against MockUSDT, which is a standard
+///         OpenZeppelin ERC20 and therefore cannot reproduce USDT's behaviour.
+contract MainnetForkTest is Test {
+    address internal constant USDT = 0xdAC17F958D2ee523a2206206994597C13D831ec7;
+    address internal constant AAVE_POOL = 0x87870Bca3F3fD6335C3F4ce8392D69350B4fA4E2;
+    address internal constant AUSDT = 0x23878914EFE38d27C4D67Ab83ed1b93A74D4086a;
+    uint256 internal constant FORK_BLOCK = 21_000_000;
+
+    UsdtYieldVault internal vault;
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+
+    function setUp() public {
+        vm.createSelectFork(vm.envOr("MAINNET_RPC_URL", string("https://eth.drpc.org")), FORK_BLOCK);
+        vault = new UsdtYieldVault(USDT, AUSDT, AAVE_POOL, 10, owner);
+
+        deal(USDT, alice, 100_000e6);
+
+        // NOTE: even this has to be a raw call - see test_Control_RawApproveOnRealUsdtReverts.
+        vm.prank(alice);
+        (bool ok,) = USDT.call(abi.encodeWithSignature("approve(address,uint256)", address(vault), type(uint256).max));
+        require(ok, "alice approve failed");
+    }
+
+    /// @notice FINDING: `usdt.approve(...)` inside deposit() is a plain IERC20 call.
+    ///         Real USDT's approve returns NO data, so the ABI decode of the bool reverts.
+    ///         Every deposit on mainnet reverts. The vault cannot take a single deposit.
+    function test_DepositRevertsAgainstRealUsdt() public {
+        vm.prank(alice);
+        vault.deposit(1_000e6);
+    }
+
+    /// @notice Same call through SafeERC20 (what the vault already uses for transferFrom)
+    ///         succeeds, isolating the cause to the unsafe `approve`.
+    function test_Control_RawApproveOnRealUsdtReverts() public {
+        // Isolates the cause: a bare IERC20.approve on real USDT reverts on the return
+        // decode for any caller. The same call via a low-level call succeeds.
+        vm.prank(alice);
+        IERC20(USDT).approve(AAVE_POOL, 1_000e6);
+    }
+
+    function test_Control_LowLevelApproveOnRealUsdtSucceedsAndReturnsNoData() public {
+        vm.prank(alice);
+        (bool ok, bytes memory ret) =
+            USDT.call(abi.encodeWithSignature("approve(address,uint256)", AAVE_POOL, uint256(1_000e6)));
+        emit log_named_uint("approve() returndata length", ret.length);
+        assertTrue(ok, "low-level approve should succeed");
+        assertEq(ret.length, 0, "real USDT approve returns no data (0 bytes), so decoding a bool reverts");
+    }
+
+    /// @dev Neutralises ONLY the unsafe-approve bug (finding 1) at the test boundary so the
+    ///      rest of the flow can be exercised against real USDT and the real Aave pool.
+    ///      The vault's allowance to the pool is granted for real first; then approve() is
+    ///      stubbed so the return-data decode no longer reverts. Nothing else is mocked:
+    ///      the transferFrom, the supply, the aUSDT accrual and the withdraw are all real.
+    function _bypassUnsafeApprove() internal {
+        vm.prank(address(vault));
+        (bool ok,) =
+            USDT.call(abi.encodeWithSignature("approve(address,uint256)", AAVE_POOL, type(uint256).max));
+        require(ok, "vault approve failed");
+        vm.mockCall(USDT, abi.encodeWithSelector(IERC20.approve.selector), abi.encode(true));
+    }
+
+    /// @notice FINDING: `totalAssetsStored` is a static counter. Real aUSDT is rebasing, so
+    ///         the interest the vault earns in Aave never reaches depositors: share price is
+    ///         frozen, and the yield is stranded in the vault's aUSDT balance forever.
+    function test_AaveYieldNeverReachesDepositors() public {
+        _bypassUnsafeApprove();
+
+        vm.prank(alice);
+        uint256 shares = vault.deposit(100_000e6);
+
+        uint256 aUsdtAtDeposit = IERC20(AUSDT).balanceOf(address(vault));
+        uint256 priceAtDeposit = vault.sharePrice();
+
+        // One year of real Aave interest at the pinned block's rate.
+        vm.warp(block.timestamp + 365 days);
+
+        uint256 aUsdtAfter = IERC20(AUSDT).balanceOf(address(vault));
+        emit log_named_uint("aUSDT held at deposit        ", aUsdtAtDeposit);
+        emit log_named_uint("aUSDT held after 365 days    ", aUsdtAfter);
+        emit log_named_uint("interest actually earned     ", aUsdtAfter - aUsdtAtDeposit);
+        emit log_named_uint("totalAssets() after 365 days ", vault.totalAssets());
+        emit log_named_uint("alice balanceOfUnderlying    ", vault.balanceOfUnderlying(alice));
+        emit log_named_uint("sharePrice at deposit        ", priceAtDeposit);
+        emit log_named_uint("sharePrice after 365 days    ", vault.sharePrice());
+
+        assertGt(aUsdtAfter, aUsdtAtDeposit, "sanity: real Aave position did accrue interest");
+        assertEq(
+            vault.totalAssets(), aUsdtAfter, "totalAssets() must track the aUSDT the vault actually holds"
+        );
+        assertGt(vault.sharePrice(), priceAtDeposit, "share price must rise as Aave interest accrues");
+        shares;
+    }
+
+    /// @notice FINDING (consequence): the sole depositor withdraws everything after a year
+    ///         and receives LESS than they put in, while the yield stays locked in Aave.
+    function test_SoleDepositorLosesMoneyOverAYearOfYield() public {
+        _bypassUnsafeApprove();
+
+        uint256 before = IERC20(USDT).balanceOf(alice);
+        vm.prank(alice);
+        uint256 shares = vault.deposit(100_000e6);
+
+        vm.warp(block.timestamp + 365 days);
+
+        vm.prank(alice);
+        vault.withdraw(shares);
+
+        uint256 got = IERC20(USDT).balanceOf(alice) - (before - 100_000e6);
+        emit log_named_uint("alice deposited              ", 100_000e6);
+        emit log_named_uint("alice received back          ", got);
+        emit log_named_uint("aUSDT left stranded in vault ", IERC20(AUSDT).balanceOf(address(vault)));
+        emit log_named_uint("shares outstanding           ", vault.totalShares());
+
+        assertGe(got, 100_000e6, "a yield vault must not return less than the principal after a year");
+    }
+}
