@@ -0,0 +1,69 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test} from "forge-std/Test.sol";
+import {Pausable} from "@openzeppelin/contracts/utils/Pausable.sol";
+
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+import {MockUSDT} from "../mocks/MockUSDT.sol";
+import {MockAavePool, MockAToken} from "../mocks/MockAavePool.sol";
+
+/// @notice The shipped suite asserts pause blocks DEPOSITS. It never asks what pause does
+///         to a user who is already in. Answer: it locks their funds, with no exit.
+contract OwnerPowersTest is Test {
+    UsdtYieldVault internal vault;
+    MockUSDT internal usdt;
+    MockAavePool internal pool;
+    MockAToken internal aUsdt;
+
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+
+    function setUp() public {
+        usdt = new MockUSDT();
+        pool = new MockAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 10, owner);
+
+        usdt.mint(alice, 100_000e6);
+        vm.prank(alice);
+        usdt.approve(address(vault), type(uint256).max);
+    }
+
+    /// @notice PROPERTY: pausing is an emergency brake on new risk, not a freeze on existing
+    ///         depositors. A depositor must always be able to exit.
+    function test_PauseFreezesExistingDepositorFundsWithNoExit() public {
+        vm.prank(alice);
+        uint256 shares = vault.deposit(10_000e6);
+
+        vm.prank(owner);
+        vault.pause();
+
+        vm.prank(alice);
+        vm.expectRevert(Pausable.EnforcedPause.selector);
+        vault.withdraw(shares);
+
+        // There is no other exit: no emergencyWithdraw, no redeem-while-paused path.
+        // Alice's 10,000 USDT is held at the owner's discretion, indefinitely.
+        assertEq(vault.balanceOfUnderlying(alice), 10_000e6);
+    }
+
+    /// @notice PROPERTY: an owner key compromise must not be able to take user funds.
+    ///         It can: renounce is unguarded, fee is unbounded, and pause is unilateral.
+    function test_OwnerCanRenounceLeavingVaultPermanentlyPaused() public {
+        vm.prank(alice);
+        vault.deposit(10_000e6);
+
+        vm.startPrank(owner);
+        vault.pause();
+        vault.renounceOwnership();
+        vm.stopPrank();
+
+        assertEq(vault.owner(), address(0));
+        // Nobody can ever call unpause() again. Every deposit in the vault is bricked.
+        vm.expectRevert();
+        vault.unpause();
+
+        assertTrue(vault.paused(), "vault is paused forever with no owner to unpause it");
+    }
+}
