@@ -0,0 +1,67 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {CommonBase} from "forge-std/Base.sol";
+import {StdCheats} from "forge-std/StdCheats.sol";
+import {StdUtils} from "forge-std/StdUtils.sol";
+
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+import {MockUSDT} from "../mocks/MockUSDT.sol";
+
+/// @notice Handler owning funded, approved actors and bounded inputs, so the fuzzer
+///         reaches real vault states instead of reverting on every call.
+contract VaultHandler is CommonBase, StdCheats, StdUtils {
+    UsdtYieldVault public immutable vault;
+    MockUSDT public immutable usdt;
+    address public immutable owner;
+
+    address[3] public actors;
+
+    uint256 public depositCalls;
+    uint256 public withdrawCalls;
+
+    constructor(UsdtYieldVault _vault, MockUSDT _usdt, address _owner) {
+        vault = _vault;
+        usdt = _usdt;
+        owner = _owner;
+
+        actors[0] = makeAddr("handlerAlice");
+        actors[1] = makeAddr("handlerBob");
+        actors[2] = makeAddr("handlerCarol");
+
+        for (uint256 i = 0; i < actors.length; i++) {
+            usdt.mint(actors[i], 10_000_000e6);
+            vm.prank(actors[i]);
+            usdt.approve(address(vault), type(uint256).max);
+        }
+    }
+
+    function _actor(uint256 seed) internal view returns (address) {
+        return actors[seed % actors.length];
+    }
+
+    function deposit(uint256 actorSeed, uint256 amount) external {
+        address actor = _actor(actorSeed);
+        amount = bound(amount, vault.MIN_DEPOSIT(), 100_000e6);
+        vm.prank(actor);
+        vault.deposit(amount);
+        depositCalls++;
+    }
+
+    function withdraw(uint256 actorSeed, uint256 shares) external {
+        address actor = _actor(actorSeed);
+        uint256 balance = vault.shareBalance(actor);
+        if (balance == 0) return;
+        shares = bound(shares, 1, balance);
+        if (vault.convertToAssets(shares) == 0) return;
+        vm.prank(actor);
+        vault.withdraw(shares);
+        withdrawCalls++;
+    }
+
+    function setDepositFee(uint256 newFeeBps) external {
+        newFeeBps = bound(newFeeBps, 0, 500); // stay inside sane fees: this invariant is not about the fee bound
+        vm.prank(owner);
+        vault.setDepositFee(newFeeBps);
+    }
+}

