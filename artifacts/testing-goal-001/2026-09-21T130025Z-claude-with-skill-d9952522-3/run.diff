+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, stdError} from "forge-std/Test.sol";
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+import {MockUSDT} from "../mocks/MockUSDT.sol";
+import {MockAavePool, MockAToken} from "../mocks/MockAavePool.sol";
+
+/// @notice Fuzzes `setDepositFee` across its ENTIRE accepted domain (it has no bound in src),
+///         which the hand-picked values 0 / 10 / 25 in the shipped suite never leave.
+contract DepositFeeFuzzTest is Test {
+    UsdtYieldVault internal vault;
+    MockUSDT internal usdt;
+    MockAavePool internal pool;
+    MockAToken internal aUsdt;
+
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+
+    function setUp() public {
+        usdt = new MockUSDT();
+        pool = new MockAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 10, owner);
+
+        usdt.mint(alice, 1_000_000e6);
+        vm.prank(alice);
+        usdt.approve(address(vault), type(uint256).max);
+    }
+
+    /// @notice PROPERTY: a fee the owner is allowed to set must leave deposit callable.
+    ///         `setDepositFee` accepts any uint256, so fuzz the whole domain.
+    function testFuzz_AnyAcceptedFeeKeepsDepositUsable(uint256 feeBps) public {
+        feeBps = bound(feeBps, 0, type(uint256).max);
+
+        vm.prank(owner);
+        vault.setDepositFee(feeBps); // never reverts: no upper bound in src
+
+        vm.prank(alice);
+        vault.deposit(1_000e6);
+    }
+
+    /// @notice BOUNDARY: 9_999 bps is the nearest *numerically valid* value below the 100% limit.
+    ///         It does not revert - it silently confiscates 99.99% of the deposit to whoever
+    ///         already holds shares. Owner front-runs a deposit to steal it.
+    function test_Boundary_9999Bps_ConfiscatesDepositToIncumbentHolders() public {
+        // Owner is an incumbent shareholder with a 1 USDT position.
+        usdt.mint(owner, 1e6);
+        vm.startPrank(owner);
+        usdt.approve(address(vault), type(uint256).max);
+        vault.setDepositFee(0);
+        vault.deposit(1e6);
+        // Owner front-runs alice's pending deposit.
+        vault.setDepositFee(9_999);
+        vm.stopPrank();
+
+        vm.prank(alice);
+        vault.deposit(100_000e6);
+
+        uint256 aliceValue = vault.balanceOfUnderlying(alice);
+        uint256 ownerValue = vault.balanceOfUnderlying(owner);
+        emit log_named_uint("alice deposited        ", 100_000e6);
+        emit log_named_uint("alice redeemable value ", aliceValue);
+        emit log_named_uint("owner redeemable value ", ownerValue);
+
+        // Owner turned a 1 USDT position into ~100k USDT of claim, taken from alice.
+        assertLt(ownerValue, 2e6, "owner must not be able to seize alice's deposit");
+    }
+
+    /// @notice BOUNDARY: 10_000 bps is the exact 100% limit. It is *not* semantically usable:
+    ///         net amount is 0, so every deposit reverts. Permanent deposit DoS.
+    function test_Boundary_10000Bps_BricksDeposits() public {
+        vm.prank(owner);
+        vault.setDepositFee(10_000);
+
+        vm.prank(alice);
+        vm.expectRevert(UsdtYieldVault.NoSharesMinted.selector);
+        vault.deposit(1_000e6);
+    }
+
+    /// @notice BOUNDARY: first value beyond the limit, 10_001 bps. Fails through a DIFFERENT path:
+    ///         `amount - fee` underflows (Panic 0x11) instead of the NoSharesMinted guard.
+    function test_Boundary_10001Bps_UnderflowPanic() public {
+        vm.prank(owner);
+        vault.setDepositFee(10_001);
+
+        vm.prank(alice);
+        vm.expectRevert(stdError.arithmeticError);
+        vault.deposit(1_000e6);
+    }
+}
