+		sender=0x0000000000000000000000000000000000000653 addr=[test/audit/VaultHandler.sol:VaultHandler] calldata=deposit(uint256,uint256) args=[6, 129]
+		sender=0x00000000000000000000000000000000000001EE addr=[test/audit/VaultHandler.sol:VaultHandler] calldata=withdraw(uint256,uint256) args=[115792089237316195423570985008687907853269984665640564039457584007913129639932 [1.157e77], 78836565091764272444722548995616973406751625194633930663464870 [7.883e61]]
+ invariant_AccountingEqualsCustody() (runs: 0, calls: 0, reverts: 0)
+
+╭--------------+---------------+-------+---------+----------╮
+| Contract     | Selector      | Calls | Reverts | Discards |
++===========================================================+
+| VaultHandler | deposit       | 7     | 0       | 0        |
+|--------------+---------------+-------+---------+----------|
+| VaultHandler | setDepositFee | 9     | 0       | 0        |
