+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test} from "forge-std/Test.sol";
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+import {MockUSDT} from "../mocks/MockUSDT.sol";
+import {MockAavePool, MockAToken} from "../mocks/MockAavePool.sol";
+import {VaultHandler} from "./VaultHandler.sol";
+
+/// @notice Ties the vault's internal accounting to the assets it actually custodies.
+///         Asserted as an EQUALITY: a one-sided `claims <= holdings` check would stay
+///         green while value is stranded, which is exactly what happens here.
+contract SolvencyInvariantTest is Test {
+    UsdtYieldVault internal vault;
+    MockUSDT internal usdt;
+    MockAavePool internal pool;
+    MockAToken internal aUsdt;
+    VaultHandler internal handler;
+
+    address internal owner = makeAddr("owner");
+
+    function setUp() public {
+        usdt = new MockUSDT();
+        pool = new MockAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 10, owner);
+
+        handler = new VaultHandler(vault, usdt, owner);
+        targetContract(address(handler));
+    }
+
+    /// forge-config: default.invariant.runs = 128
+    /// forge-config: default.invariant.depth = 32
+    /// forge-config: default.invariant.fail-on-revert = true
+    function invariant_AccountingEqualsCustody() public view {
+        assertEq(
+            vault.totalAssetsStored(),
+            aUsdt.balanceOf(address(vault)),
+            "totalAssetsStored drifted from the aUSDT the vault actually holds"
+        );
+    }
+
+}
