+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console} from "forge-std/Test.sol";
+
+import {UsdtYieldVault} from "../src/UsdtYieldVault.sol";
+import {MockUSDT} from "./mocks/MockUSDT.sol";
+import {MockAavePool, MockAToken} from "./mocks/MockAavePool.sol";
+
+/// @notice What the owner key can do to depositors.
+/// No network required:
+///   forge test --match-path 'test/OwnerRisk.t.sol' -vv
+contract OwnerRiskTest is Test {
+    UsdtYieldVault internal vault;
+    MockUSDT internal usdt;
+    MockAavePool internal pool;
+    MockAToken internal aUsdt;
+
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+    address internal bob = makeAddr("bob");
+
+    function setUp() public {
+        usdt = new MockUSDT();
+        pool = new MockAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 10, owner);
+
+        usdt.mint(alice, 1_000_000e6);
+        usdt.mint(bob, 1_000_000e6);
+        vm.prank(alice);
+        usdt.approve(address(vault), type(uint256).max);
+        vm.prank(bob);
+        usdt.approve(address(vault), type(uint256).max);
+    }
+
+    /// @notice F-04. The deposit fee has no upper bound.
+    function test_DepositFeeIsCapped() public {
+        vm.prank(owner);
+        vault.setDepositFee(1_000_000); // 10,000%
+        console.log("depositFeeBps now :", vault.depositFeeBps());
+
+        assertLe(vault.depositFeeBps(), vault.BPS_DENOMINATOR(), "deposit fee must not exceed 100%");
+    }
+
+    /// @notice F-04. A fee above 100% makes `amount - fee` underflow: deposits
+    ///         are bricked until the owner reverses it.
+    function test_OverlargeFeeDoesNotBrickDeposits() public {
+        vm.prank(owner);
+        vault.setDepositFee(10_001);
+
+        vm.prank(alice);
+        vault.deposit(1_000e6);
+    }
+
+    /// @notice F-04. Owner front-runs a pending deposit and redirects it to the
+    ///         existing shareholders (which the owner can be).
+    function test_OwnerCannotConfiscateAPendingDeposit() public {
+        vm.prank(bob);
+        vault.deposit(100_000e6); // incumbent shareholder
+
+        uint256 bobBefore = vault.balanceOfUnderlying(bob);
+
+        // ... alice's deposit(10_000e6) is sitting in the mempool ...
+        vm.prank(owner);
+        vault.setDepositFee(9_999);
+
+        vm.prank(alice);
+        vault.deposit(10_000e6);
+
+        uint256 aliceClaim = vault.balanceOfUnderlying(alice);
+        console.log("alice deposited   :", uint256(10_000e6));
+        console.log("alice can redeem  :", aliceClaim);
+        console.log("bob claim before  :", bobBefore);
+        console.log("bob claim after   :", vault.balanceOfUnderlying(bob));
+
+        assertGe(aliceClaim, 9_000e6, "a depositor must keep the bulk of their own deposit");
+    }
+
+    /// @notice F-05. pause() gates withdraw() as well as deposit(): the owner key
+    ///         can freeze every depositor's principal indefinitely.
+    function test_PausedVaultStillLetsDepositorsExit() public {
+        vm.prank(alice);
+        uint256 shares = vault.deposit(100_000e6);
+
+        vm.prank(owner);
+        vault.pause();
+
+        vm.prank(alice);
+        vault.withdraw(shares);
+    }
+
+    /// @notice F-08. Constructor accepts anything.
+    function test_ConstructorRejectsZeroAddresses() public {
+        UsdtYieldVault bad = new UsdtYieldVault(address(0), address(0), address(0), 0, owner);
+        console.log("deployed with all-zero config at:", address(bad));
+        fail();
+    }
+
+    /// @notice F-08. Constructor accepts a fee that bricks the vault on arrival.
+    function test_ConstructorRejectsUnpayableFee() public {
+        UsdtYieldVault bad = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 50_000, owner);
+        console.log("deployed with depositFeeBps =", bad.depositFeeBps());
+
+        vm.prank(alice);
+        usdt.approve(address(bad), type(uint256).max);
+        vm.prank(alice);
+        bad.deposit(1_000e6);
+    }
+
+    /// @notice F-08. Single-step Ownable: one bad transferOwnership is terminal.
+    function test_OwnershipTransferIsTwoStep() public {
+        address typo = address(0xdeadbeef);
+        vm.prank(owner);
+        vault.transferOwnership(typo);
+
+        console.log("owner is now :", vault.owner());
+        assertEq(vault.owner(), owner, "ownership should not move until the new owner accepts");
+    }
+}
