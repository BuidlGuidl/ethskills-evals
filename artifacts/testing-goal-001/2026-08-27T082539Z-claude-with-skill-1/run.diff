+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {CommonBase} from "forge-std/Base.sol";
+import {StdCheats} from "forge-std/StdCheats.sol";
+import {StdUtils} from "forge-std/StdUtils.sol";
+
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+import {MockUSDT} from "../mocks/MockUSDT.sol";
+
+/// @notice Guided random deposits/withdrawals for the invariant suite.
+contract VaultHandler is CommonBase, StdCheats, StdUtils {
+    UsdtYieldVault public immutable vault;
+    MockUSDT public immutable usdt;
+
+    address[3] public actors;
+
+    uint256 public totalDeposited;
+    uint256 public totalWithdrawn;
+    uint256 public depositCalls;
+    uint256 public withdrawCalls;
+    uint256 public totalWithdrawFees;
+
+    constructor(UsdtYieldVault _vault, MockUSDT _usdt) {
+        vault = _vault;
+        usdt = _usdt;
+        actors = [makeAddr("actor0"), makeAddr("actor1"), makeAddr("actor2")];
+    }
+
+    function _actor(uint256 seed) internal view returns (address) {
+        return actors[seed % actors.length];
+    }
+
+    function deposit(uint256 actorSeed, uint256 amount) external {
+        address actor = _actor(actorSeed);
+        amount = bound(amount, vault.MIN_DEPOSIT(), 250_000e6);
+
+        usdt.mint(actor, amount);
+        vm.startPrank(actor);
+        usdt.approve(address(vault), amount);
+        vault.deposit(amount);
+        vm.stopPrank();
+
+        totalDeposited += amount;
+        depositCalls++;
+    }
+
+    function withdraw(uint256 actorSeed, uint256 shares) external {
+        address actor = _actor(actorSeed);
+        uint256 balance = vault.shareBalance(actor);
+        if (balance == 0) return;
+
+        shares = bound(shares, 1, balance);
+        if (vault.convertToAssets(shares) == 0) return;
+
+        uint256 gross = vault.convertToAssets(shares);
+
+        vm.prank(actor);
+        uint256 out = vault.withdraw(shares);
+
+        totalWithdrawn += out;
+        totalWithdrawFees += gross - out;
+        withdrawCalls++;
+    }
+}

