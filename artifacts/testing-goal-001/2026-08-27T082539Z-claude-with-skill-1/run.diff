+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console} from "forge-std/Test.sol";
+
+import {UsdtYieldVault} from "../src/UsdtYieldVault.sol";
+import {MockUSDT} from "./mocks/MockUSDT.sol";
+import {MockAavePool, MockAToken} from "./mocks/MockAavePool.sol";
+
+/// @notice Share/asset accounting properties, checked with the project's own mocks.
+/// No network required:
+///   forge test --match-path 'test/AccountingBugs.t.sol' -vv
+contract AccountingBugsTest is Test {
+    UsdtYieldVault internal vault;
+    MockUSDT internal usdt;
+    MockAavePool internal pool;
+    MockAToken internal aUsdt;
+
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+    address internal bob = makeAddr("bob");
+
+    uint256 internal constant STAKE = 100_000e6;
+
+    function setUp() public {
+        usdt = new MockUSDT();
+        pool = new MockAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        // Deposit fee 0: isolates the withdrawal-fee accounting.
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 0, owner);
+
+        usdt.mint(alice, 1_000_000e6);
+        usdt.mint(bob, 1_000_000e6);
+        vm.prank(alice);
+        usdt.approve(address(vault), type(uint256).max);
+        vm.prank(bob);
+        usdt.approve(address(vault), type(uint256).max);
+    }
+
+    function _deposit(address who, uint256 amount) internal returns (uint256) {
+        vm.prank(who);
+        return vault.deposit(amount);
+    }
+
+    /// @notice F-03. README: "Both fees stay supplied in Aave and accrue to the
+    ///         remaining shareholders." Alice is the remaining shareholder when
+    ///         Bob pays a 30 bps exit fee, so her claim should grow by that fee.
+    function test_WithdrawFeeAccruesToRemainingShareholders() public {
+        _deposit(alice, STAKE);
+        uint256 bobShares = _deposit(bob, STAKE);
+
+        uint256 aliceBefore = vault.balanceOfUnderlying(alice);
+
+        vm.prank(bob);
+        vault.withdraw(bobShares);
+
+        uint256 aliceAfter = vault.balanceOfUnderlying(alice);
+        uint256 feeBobPaid = (STAKE * vault.WITHDRAW_FEE_BPS()) / vault.BPS_DENOMINATOR();
+
+        console.log("fee bob paid            :", feeBobPaid);
+        console.log("alice claim before      :", aliceBefore);
+        console.log("alice claim after       :", aliceAfter);
+        console.log("aUSDT actually in vault :", aUsdt.balanceOf(address(vault)));
+        console.log("vault.totalAssetsStored :", vault.totalAssetsStored());
+
+        assertEq(aliceAfter, aliceBefore + feeBobPaid, "withdrawal fee should accrue to the remaining shareholder");
+    }
+
+    /// @notice F-03. Internal accounting must not drift from the real position.
+    ///         withdraw() subtracts grossAssets from totalAssetsStored but only
+    ///         pulls netAssets out of Aave; the difference is orphaned.
+    function test_TrackedAssetsMatchAavePosition() public {
+        _deposit(alice, STAKE);
+        uint256 shares = _deposit(bob, STAKE);
+
+        vm.prank(bob);
+        vault.withdraw(shares);
+
+        console.log("totalAssetsStored :", vault.totalAssetsStored());
+        console.log("aUSDT balance     :", aUsdt.balanceOf(address(vault)));
+        assertEq(vault.totalAssetsStored(), aUsdt.balanceOf(address(vault)), "accounting must match the Aave position");
+    }
+
+    /// @notice F-03. When every share is burned the vault should be empty.
+    function test_VaultHoldsNothingAfterEveryoneExits() public {
+        uint256 aliceShares = _deposit(alice, STAKE);
+        uint256 bobShares = _deposit(bob, STAKE);
+
+        vm.prank(bob);
+        vault.withdraw(bobShares);
+        vm.prank(alice);
+        vault.withdraw(aliceShares);
+
+        console.log("totalShares       :", vault.totalShares());
+        console.log("totalAssetsStored :", vault.totalAssetsStored());
+        console.log("orphaned aUSDT    :", aUsdt.balanceOf(address(vault)));
+
+        assertEq(vault.totalShares(), 0, "all shares burned");
+        assertEq(aUsdt.balanceOf(address(vault)), 0, "no aUSDT should be left behind");
+    }
+
+    /// @notice F-03. The orphaned amount is exactly the sum of withdrawal fees,
+    ///         for any deposit sizes. It is systematic, not a rounding artefact.
+    function testFuzz_NothingIsOrphanedByWithdrawals(uint256 a, uint256 b) public {
+        a = bound(a, 1e6, 500_000e6);
+        b = bound(b, 1e6, 500_000e6);
+
+        uint256 aliceShares = _deposit(alice, a);
+        uint256 bobShares = _deposit(bob, b);
+
+        vm.prank(bob);
+        vault.withdraw(bobShares);
+        vm.prank(alice);
+        vault.withdraw(aliceShares);
+
+        assertEq(aUsdt.balanceOf(address(vault)), 0, "no aUSDT should be left behind");
+    }
+
+    /// @notice F-06. Conservation: every USDT that entered the vault must end up
+    ///         either back with a user or claimable by a remaining shareholder.
+    function test_RoundTripConservesValue() public {
+        uint256 aliceBefore = usdt.balanceOf(alice);
+
+        uint256 shares = _deposit(alice, STAKE);
+        vm.prank(alice);
+        uint256 received = vault.withdraw(shares);
+
+        console.log("deposited        :", STAKE);
+        console.log("received back    :", received);
+        console.log("burned into Aave :", STAKE - received);
+        console.log("claimable by any :", vault.totalAssetsStored());
+
+        assertEq(usdt.balanceOf(alice), aliceBefore, "sole depositor round trip should be value-neutral");
+    }
+
+    /// @notice F-07. Shares too small to convert to a whole USDT unit are burned
+    ///         for zero payout — silent principal loss on this mock, and an
+    ///         outright revert against real Aave (see fork test).
+    function test_SmallWithdrawDoesNotBurnSharesForNothing() public {
+        _deposit(alice, STAKE);
+
+        uint256 dust = vault.SHARE_SCALE() - 1; // strictly less than 1 USDT unit of shares
+        uint256 sharesBefore = vault.shareBalance(alice);
+        uint256 usdtBefore = usdt.balanceOf(alice);
+
+        vm.prank(alice);
+        uint256 out = vault.withdraw(dust);
+
+        console.log("shares burned :", sharesBefore - vault.shareBalance(alice));
+        console.log("usdt received :", usdt.balanceOf(alice) - usdtBefore);
+        assertGt(out, 0, "burning shares must pay out something");
+    }
+}
