+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console} from "forge-std/Test.sol";
+
+import {UsdtYieldVault} from "../src/UsdtYieldVault.sol";
+import {MockUSDT} from "./mocks/MockUSDT.sol";
+import {MockAavePool, MockAToken} from "./mocks/MockAavePool.sol";
+import {VaultHandler} from "./harness/VaultHandler.sol";
+
+/// @notice Properties that must hold across any sequence of deposits/withdrawals.
+/// No network required:
+///   forge test --match-path 'test/VaultInvariants.t.sol' -vv
+contract VaultInvariantsTest is Test {
+    UsdtYieldVault internal vault;
+    MockUSDT internal usdt;
+    MockAavePool internal pool;
+    MockAToken internal aUsdt;
+    VaultHandler internal handler;
+
+    function setUp() public {
+        usdt = new MockUSDT();
+        pool = new MockAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 10, makeAddr("owner"));
+
+        handler = new VaultHandler(vault, usdt);
+        targetContract(address(handler));
+    }
+
+    /// @notice The vault's own books must describe its real Aave position.
+    function invariant_TrackedAssetsMatchAavePosition() public view {
+        assertEq(
+            vault.totalAssetsStored(),
+            aUsdt.balanceOf(address(vault)),
+            "totalAssetsStored must equal the vault's aUSDT balance"
+        );
+    }
+
+    /// @notice Control: the vault is never short of what its books promise.
+    ///         (It leaks value upward, not downward - this one should hold.)
+    function invariant_PositionCoversTrackedAssets() public view {
+        assertGe(
+            aUsdt.balanceOf(address(vault)), vault.totalAssetsStored(), "vault position is short of its own accounting"
+        );
+    }
+
+    function invariant_CallSummary() public view {
+        console.log("deposit calls   :", handler.depositCalls());
+        console.log("withdraw calls  :", handler.withdrawCalls());
+        console.log("withdraw fees   :", handler.totalWithdrawFees());
+        console.log("orphaned aUSDT  :", aUsdt.balanceOf(address(vault)) - vault.totalAssetsStored());
+    }
+}
diff --git a/test/fork/AaveYieldAccrual.t.sol b/test/fork/AaveYieldAccrual.t.sol
new file mode 100644
index 0000000..62b8602
--- /dev/null
+++ b/test/fork/AaveYieldAccrual.t.sol
@@ -0,0 +1,144 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console} from "forge-std/Test.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+
+/// @notice Exercises the UNMODIFIED vault against the real mainnet Aave V3 pool.
+///
+/// USDT itself cannot be used here because deposit() reverts on it (see
+/// test/fork/RealUsdt.t.sol). To reach the accounting logic behind that wall we
+/// point the same unmodified vault at USDC, which uses the identical Aave V3
+/// pool and an ERC-20-compliant approve(). Nothing in the vault is asset-specific:
+/// deposit/withdraw/convertToShares/convertToAssets run the same code either way.
+///
+/// Run with:
+///   forge test --match-path 'test/fork/AaveYieldAccrual.t.sol' -vvv
+contract AaveYieldAccrualForkTest is Test {
+    address internal constant USDC = 0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48;
+    address internal constant AUSDC = 0x98C23E9d8f34FEFb1B7BD6a91B7FF122F4e16F5c;
+    address internal constant AAVE_POOL = 0x87870Bca3F3fD6335C3F4ce8392D69350B4fA4E2;
+
+    uint256 internal constant FORK_BLOCK = 25_000_000;
+    uint256 internal constant DEPOSIT_AMOUNT = 100_000e6;
+
+    UsdtYieldVault internal vault;
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+    address internal bob = makeAddr("bob");
+
+    function setUp() public {
+        vm.createSelectFork(vm.envOr("MAINNET_RPC_URL", string("https://eth.drpc.org")), FORK_BLOCK);
+
+        // Zero deposit fee so that only yield/withdraw-fee behaviour is under test.
+        vault = new UsdtYieldVault(USDC, AUSDC, AAVE_POOL, 0, owner);
+
+        deal(USDC, alice, 1_000_000e6);
+        deal(USDC, bob, 1_000_000e6);
+        vm.prank(alice);
+        IERC20(USDC).approve(address(vault), type(uint256).max);
+        vm.prank(bob);
+        IERC20(USDC).approve(address(vault), type(uint256).max);
+    }
+
+    function _depositAndAccrue(uint256 period) internal returns (uint256 shares, uint256 aBalAfter) {
+        vm.prank(alice);
+        shares = vault.deposit(DEPOSIT_AMOUNT);
+
+        vm.warp(block.timestamp + period);
+        aBalAfter = IERC20(AUSDC).balanceOf(address(vault));
+    }
+
+    /// @dev Sanity: real Aave really does pay interest over the warped period.
+    function test_RealAaveAccruesInterest() public {
+        (, uint256 aBal) = _depositAndAccrue(365 days);
+
+        console.log("supplied to Aave     :", DEPOSIT_AMOUNT);
+        console.log("aToken bal after 1y  :", aBal);
+        console.log("interest earned      :", aBal - DEPOSIT_AMOUNT);
+        assertGt(aBal, DEPOSIT_AMOUNT, "Aave paid interest");
+    }
+
+    /// @notice F-02. totalAssets() on a yield vault should track the yield-bearing
+    ///         position. It is a plain storage counter that never moves.
+    function test_TotalAssetsTracksAccruedYield() public {
+        (, uint256 aBal) = _depositAndAccrue(365 days);
+
+        console.log("vault.totalAssets()  :", vault.totalAssets());
+        console.log("aToken bal           :", aBal);
+        assertEq(vault.totalAssets(), aBal, "totalAssets() should equal the vault's Aave position");
+    }
+
+    /// @notice F-02. A depositor's redeemable balance should grow with the yield.
+    function test_DepositorBalanceGrowsWithYield() public {
+        (, uint256 aBal) = _depositAndAccrue(365 days);
+
+        console.log("balanceOfUnderlying  :", vault.balanceOfUnderlying(alice));
+        console.log("aToken bal           :", aBal);
+        assertGt(vault.balanceOfUnderlying(alice), DEPOSIT_AMOUNT, "alice should have earned yield");
+    }
+
+    /// @notice F-02. Share price should rise as Aave pays interest.
+    function test_SharePriceRisesWithYield() public {
+        vm.prank(alice);
+        vault.deposit(DEPOSIT_AMOUNT);
+        uint256 priceBefore = vault.sharePrice();
+
+        vm.warp(block.timestamp + 365 days);
+
+        console.log("sharePrice before 1y :", priceBefore);
+        console.log("sharePrice after  1y :", vault.sharePrice());
+        assertGt(vault.sharePrice(), priceBefore, "share price should rise with yield");
+    }
+
+    /// @notice F-02. After a year in a yield vault, a full exit should return
+    ///         more than the principal. It returns less.
+    function test_FullExitReturnsPrincipalPlusYield() public {
+        (uint256 shares, uint256 aBal) = _depositAndAccrue(365 days);
+
+        uint256 before = IERC20(USDC).balanceOf(alice);
+        vm.prank(alice);
+        vault.withdraw(shares);
+        uint256 received = IERC20(USDC).balanceOf(alice) - before;
+
+        console.log("deposited            :", DEPOSIT_AMOUNT);
+        console.log("received after 1y    :", received);
+        console.log("yield Aave paid      :", aBal - DEPOSIT_AMOUNT);
+        console.log("left behind in Aave  :", IERC20(AUSDC).balanceOf(address(vault)));
+        assertGt(received, DEPOSIT_AMOUNT, "a year of yield should leave alice better off");
+    }
+
+    /// @notice F-02/F-03. Once every shareholder has exited, the vault should hold
+    ///         nothing. It holds a year of yield plus the withdrawal fee, and has
+    ///         no function that can ever move it.
+    function test_VaultIsEmptyAfterEveryoneExits() public {
+        (uint256 shares,) = _depositAndAccrue(365 days);
+
+        vm.prank(alice);
+        vault.withdraw(shares);
+
+        uint256 stranded = IERC20(AUSDC).balanceOf(address(vault));
+        console.log("totalShares          :", vault.totalShares());
+        console.log("totalAssetsStored    :", vault.totalAssetsStored());
+        console.log("aToken left in vault :", stranded);
+        assertEq(vault.totalShares(), 0, "all shares burned");
+        assertEq(stranded, 0, "vault should hold no aTokens once all shares are burned");
+    }
+
+    /// @notice F-07. Shares worth less than one whole token unit round to a zero
+    ///         withdrawal, and real Aave rejects a zero-amount withdraw: the
+    ///         holder can neither redeem nor discard them.
+    function test_DustSharesCanBeRedeemed() public {
+        vm.prank(alice);
+        vault.deposit(DEPOSIT_AMOUNT);
+
+        uint256 dust = vault.SHARE_SCALE() - 1;
+        console.log("dust shares          :", dust);
+        console.log("convertToAssets(dust):", vault.convertToAssets(dust));
+
+        vm.prank(alice);
+        vault.withdraw(dust);
+    }
+}
diff --git a/test/fork/RealUsdt.t.sol b/test/fork/RealUsdt.t.sol
new file mode 100644
index 0000000..21e3d2a
--- /dev/null
+++ b/test/fork/RealUsdt.t.sol
@@ -0,0 +1,98 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console} from "forge-std/Test.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+
+/// @notice Exercises the UNMODIFIED vault against the real mainnet USDT and the
+///         real Aave V3 pool named in README.md / TASK.md.
+///
+/// Run with:
+///   forge test --match-path 'test/fork/RealUsdt.t.sol' -vvv
+/// An archive RPC is required. Defaults to a public one; override with MAINNET_RPC_URL.
+contract RealUsdtForkTest is Test {
+    address internal constant USDT = 0xdAC17F958D2ee523a2206206994597C13D831ec7;
+    address internal constant AUSDT = 0x23878914EFE38d27C4D67Ab83ed1b93A74D4086a;
+    address internal constant AAVE_POOL = 0x87870Bca3F3fD6335C3F4ce8392D69350B4fA4E2;
+
+    uint256 internal constant FORK_BLOCK = 25_000_000;
+    uint256 internal constant DEPOSIT_AMOUNT = 10_000e6;
+
+    UsdtYieldVault internal vault;
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+
+    function setUp() public {
+        vm.createSelectFork(vm.envOr("MAINNET_RPC_URL", string("https://eth.drpc.org")), FORK_BLOCK);
+
+        vault = new UsdtYieldVault(USDT, AUSDT, AAVE_POOL, 10, owner);
+
+        deal(USDT, alice, 100_000e6);
+
+        // Real USDT's approve() returns no data, so it cannot be called through
+        // IERC20 from a test either. Raw-call it to fund the allowance.
+        vm.prank(alice);
+        (bool ok,) = USDT.call(abi.encodeWithSignature("approve(address,uint256)", address(vault), type(uint256).max));
+        assertTrue(ok, "raw USDT approve failed");
+    }
+
+    /// @dev Sanity: the fork is real and the preconditions hold.
+    function test_ForkPreconditions() public view {
+        assertEq(IERC20(USDT).balanceOf(alice), 100_000e6, "alice USDT funded");
+        assertEq(IERC20(USDT).allowance(alice, address(vault)), type(uint256).max, "vault allowance set");
+        assertGt(IERC20(AUSDT).totalSupply(), 0, "real aUSDT reserve is live");
+    }
+
+    /// @notice F-01. A depositor should be able to deposit USDT. On mainnet they cannot.
+    function test_AliceCanDepositRealUsdt() public {
+        vm.prank(alice);
+        uint256 shares = vault.deposit(DEPOSIT_AMOUNT);
+
+        assertGt(shares, 0, "deposit should mint shares");
+    }
+
+    /// @notice F-01 root cause. USDT.approve() returns zero bytes, so the
+    ///         `IERC20.approve` call in deposit() cannot ABI-decode a bool.
+    function test_RealUsdtApproveReturnsABool() public {
+        vm.prank(address(vault));
+        (bool ok, bytes memory ret) = USDT.call(abi.encodeWithSignature("approve(address,uint256)", AAVE_POOL, 1e6));
+
+        assertTrue(ok, "raw call to USDT.approve succeeded at the EVM level");
+        console.log("USDT.approve() returndata size:", ret.length);
+        assertEq(ret.length, 32, "IERC20.approve requires 32 bytes of returndata to decode");
+    }
+
+    /// @notice F-01. Every deposit reverts, permanently. No user can ever enter the vault.
+    function test_EveryDepositSizeReverts() public {
+        uint256[4] memory amounts = [uint256(1e6), 100e6, 10_000e6, 100_000e6];
+
+        for (uint256 i = 0; i < amounts.length; i++) {
+            vm.prank(alice);
+            (bool ok, bytes memory ret) =
+                address(vault).call(abi.encodeWithSelector(UsdtYieldVault.deposit.selector, amounts[i]));
+            console.log("deposit amount:", amounts[i]);
+            console.log("  succeeded:", ok);
+            console.log("  revert data size:", ret.length);
+            assertFalse(ok, "deposit reverted");
+        }
+
+        assertEq(vault.totalShares(), 0, "no shares were ever minted");
+        assertEq(IERC20(AUSDT).balanceOf(address(vault)), 0, "vault never supplied anything to Aave");
+    }
+
+    /// @notice F-01. Real USDT rejects a non-zero -> non-zero allowance change.
+    ///         deposit() calls approve(amount) unconditionally, so any residual
+    ///         allowance to the Aave pool bricks every future deposit.
+    function test_RealUsdtAllowsOverwritingANonZeroAllowance() public {
+        vm.startPrank(address(vault));
+        (bool first,) = USDT.call(abi.encodeWithSignature("approve(address,uint256)", AAVE_POOL, 1_000e6));
+        (bool second,) = USDT.call(abi.encodeWithSignature("approve(address,uint256)", AAVE_POOL, 2_000e6));
+        vm.stopPrank();
+
+        console.log("first approve(1000e6) ok :", first);
+        console.log("second approve(2000e6) ok:", second);
+        assertTrue(second, "USDT should allow overwriting a non-zero allowance");
+    }
+}
diff --git a/test/harness/TetherLikeUsdt.sol b/test/harness/TetherLikeUsdt.sol
new file mode 100644
index 0000000..8f879ac
--- /dev/null
+++ b/test/harness/TetherLikeUsdt.sol
@@ -0,0 +1,126 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+/// @notice Faithful stand-in for the deployed TetherToken at
+///         0xdAC17F958D2ee523a2206206994597C13D831ec7, reproducing the three
+///         behaviours the project's MockUSDT does not have:
+///           1. transfer/transferFrom/approve return no data at all;
+///           2. approve() rejects a non-zero -> non-zero change;
+///           3. an owner-settable transfer fee (basisPointsRate/maximumFee).
+///         Lets the USDT findings be reproduced without an archive RPC.
+contract TetherLikeUsdt {
+    string public constant name = "Tether USD";
+    string public constant symbol = "USDT";
+    uint8 public constant decimals = 6;
+
+    uint256 public totalSupply;
+    uint256 public basisPointsRate;
+    uint256 public maximumFee;
+
+    mapping(address => uint256) public balanceOf;
+    mapping(address => mapping(address => uint256)) public allowance;
+
+    event Transfer(address indexed from, address indexed to, uint256 value);
+    event Approval(address indexed owner, address indexed spender, uint256 value);
+
+    function mint(address to, uint256 amount) external {
+        balanceOf[to] += amount;
+        totalSupply += amount;
+    }
+
+    function setParams(uint256 newBasisPoints, uint256 newMaxFee) external {
+        require(newBasisPoints < 20, "bps too high");
+        require(newMaxFee < 50, "max fee too high");
+        basisPointsRate = newBasisPoints;
+        maximumFee = newMaxFee * (10 ** decimals);
+    }
+
+    // No `returns (bool)`, exactly like TetherToken.
+    function approve(address spender, uint256 value) public {
+        require(!((value != 0) && (allowance[msg.sender][spender] != 0)));
+        allowance[msg.sender][spender] = value;
+        emit Approval(msg.sender, spender, value);
+    }
+
+    function transfer(address to, uint256 value) public {
+        _transfer(msg.sender, to, value);
+    }
+
+    function transferFrom(address from, address to, uint256 value) public {
+        uint256 allowed = allowance[from][msg.sender];
+        if (allowed < type(uint256).max) {
+            allowance[from][msg.sender] = allowed - value;
+        }
+        _transfer(from, to, value);
+    }
+
+    function _transfer(address from, address to, uint256 value) internal {
+        uint256 fee = (value * basisPointsRate) / 10000;
+        if (fee > maximumFee) fee = maximumFee;
+        uint256 sendAmount = value - fee;
+
+        balanceOf[from] -= value;
+        balanceOf[to] += sendAmount;
+        if (fee > 0) {
+            balanceOf[address(this)] += fee;
+            emit Transfer(from, address(this), fee);
+        }
+        emit Transfer(from, to, sendAmount);
+    }
+}
+
+/// @notice Same owner-settable transfer fee as {TetherLikeUsdt}, but with
+///         standard ERC-20 bool returns. Isolates the fee-on-transfer failure
+///         from the empty-returndata failure, which would otherwise mask it.
+contract FeeOnTransferUsdt {
+    string public constant name = "Tether USD";
+    string public constant symbol = "USDT";
+    uint8 public constant decimals = 6;
+
+    uint256 public totalSupply;
+    uint256 public basisPointsRate;
+    uint256 public maximumFee;
+
+    mapping(address => uint256) public balanceOf;
+    mapping(address => mapping(address => uint256)) public allowance;
+
+    event Transfer(address indexed from, address indexed to, uint256 value);
+    event Approval(address indexed owner, address indexed spender, uint256 value);
+
+    function mint(address to, uint256 amount) external {
+        balanceOf[to] += amount;
+        totalSupply += amount;
+    }
+
+    function setParams(uint256 newBasisPoints, uint256 newMaxFee) external {
+        basisPointsRate = newBasisPoints;
+        maximumFee = newMaxFee * (10 ** decimals);
+    }
+
+    function approve(address spender, uint256 value) public returns (bool) {
+        allowance[msg.sender][spender] = value;
+        emit Approval(msg.sender, spender, value);
+        return true;
+    }
+
+    function transfer(address to, uint256 value) public returns (bool) {
+        _transfer(msg.sender, to, value);
+        return true;
+    }
+
+    function transferFrom(address from, address to, uint256 value) public returns (bool) {
+        uint256 allowed = allowance[from][msg.sender];
+        if (allowed < type(uint256).max) allowance[from][msg.sender] = allowed - value;
+        _transfer(from, to, value);
+        return true;
+    }
+
+    function _transfer(address from, address to, uint256 value) internal {
+        uint256 fee = (value * basisPointsRate) / 10000;
+        if (fee > maximumFee) fee = maximumFee;
+        balanceOf[from] -= value;
+        balanceOf[to] += value - fee;
+        balanceOf[address(this)] += fee;
+        emit Transfer(from, to, value - fee);
+    }
+}
