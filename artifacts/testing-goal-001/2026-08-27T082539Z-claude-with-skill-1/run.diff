@@ -0,0 +1,72 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console} from "forge-std/Test.sol";
+
+import {UsdtYieldVault} from "../src/UsdtYieldVault.sol";
+import {TetherLikeUsdt, FeeOnTransferUsdt} from "./harness/TetherLikeUsdt.sol";
+import {MockAavePool, MockAToken} from "./mocks/MockAavePool.sol";
+
+/// @notice Offline reproduction of the real-USDT findings, for anyone without an
+///         archive RPC. Same conclusions as test/fork/RealUsdt.t.sol.
+///   forge test --match-path 'test/UsdtQuirks.t.sol' -vv
+contract UsdtQuirksTest is Test {
+    UsdtYieldVault internal vault;
+    TetherLikeUsdt internal usdt;
+    MockAavePool internal pool;
+    MockAToken internal aUsdt;
+
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+
+    function setUp() public {
+        usdt = new TetherLikeUsdt();
+        pool = new MockAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 10, owner);
+
+        usdt.mint(alice, 1_000_000e6);
+        vm.prank(alice);
+        usdt.approve(address(vault), type(uint256).max);
+    }
+
+    /// @notice F-01, offline. The vault calls `IERC20(usdt).approve(...)` directly
+    ///         instead of `forceApprove`, so it cannot decode USDT's empty return.
+    function test_DepositWorksAgainstUsdtSemantics() public {
+        vm.prank(alice);
+        uint256 shares = vault.deposit(1_000e6);
+        assertGt(shares, 0, "deposit should mint shares");
+    }
+
+    /// @notice F-01, offline. USDT rejects a non-zero -> non-zero allowance
+    ///         change, so a residual approval permanently bricks deposit().
+    function test_UsdtAllowsOverwritingANonZeroAllowance() public {
+        vm.startPrank(address(vault));
+        usdt.approve(address(pool), 1_000e6);
+        usdt.approve(address(pool), 2_000e6);
+        vm.stopPrank();
+    }
+
+    /// @notice F-09. Tether's owner can switch on a transfer fee at any time.
+    ///         deposit() then supplies `amount` to Aave while only holding
+    ///         `amount - fee`, so every deposit reverts until it is switched off.
+    ///         Uses a bool-returning clone so this failure is not masked by F-01.
+    function test_DepositSurvivesATransferFeeOnTheUnderlying() public {
+        FeeOnTransferUsdt fotUsdt = new FeeOnTransferUsdt();
+        MockAavePool fotPool = new MockAavePool(address(fotUsdt));
+        UsdtYieldVault fotVault =
+            new UsdtYieldVault(address(fotUsdt), address(fotPool.aToken()), address(fotPool), 10, owner);
+
+        fotUsdt.mint(alice, 1_000_000e6);
+        vm.startPrank(alice);
+        fotUsdt.approve(address(fotVault), type(uint256).max);
+        fotVault.deposit(1_000e6); // fee is still 0 here: this succeeds
+        vm.stopPrank();
+
+        fotUsdt.setParams(10, 30); // Tether flips the switch
+        console.log("basisPointsRate now :", fotUsdt.basisPointsRate());
+
+        vm.prank(alice);
+        fotVault.deposit(1_000e6);
+    }
+}
