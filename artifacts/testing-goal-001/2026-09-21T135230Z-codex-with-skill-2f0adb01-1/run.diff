+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test} from "forge-std/Test.sol";
+
+import {UsdtYieldVault} from "../src/UsdtYieldVault.sol";
+
+contract UsdtYieldVaultMainnetEvidenceTest is Test {
+    address internal constant USDT = 0xdAC17F958D2ee523a2206206994597C13D831ec7;
+    address internal constant AAVE_V3_POOL = 0x87870Bca3F3fD6335C3F4ce8392D69350B4fA4E2;
+    address internal constant AUSDT = 0x23878914EFE38d27C4D67Ab83ed1b93A74D4086a;
+
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+
+    UsdtYieldVault internal vault;
+
+    function setUp() public {
+        if (block.chainid != 1) return;
+        vault = new UsdtYieldVault(USDT, AUSDT, AAVE_V3_POOL, 0, owner);
+    }
+
+    function test_DepositIntoAaveWithRealUsdtShouldSucceed() public {
+        if (block.chainid != 1) return;
+
+        uint256 amount = 1_000e6;
+        deal(USDT, alice, amount);
+
+        vm.prank(alice);
+        (bool ok,) = USDT.call(abi.encodeWithSignature("approve(address,uint256)", address(vault), amount));
+        assertTrue(ok, "user approval failed");
+
+        vm.prank(alice);
+        uint256 shares = vault.deposit(amount);
+
+        assertGt(shares, 0, "deposit should mint shares");
+    }
+}

