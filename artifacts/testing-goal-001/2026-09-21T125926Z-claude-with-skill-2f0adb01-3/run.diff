@@ -0,0 +1,88 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console} from "forge-std/Test.sol";
+
+import {UsdtYieldVault} from "../src/UsdtYieldVault.sol";
+import {MockUSDT} from "./mocks/MockUSDT.sol";
+import {AccruingAavePool, AccruingAToken} from "./helpers/AccruingAavePool.sol";
+
+contract VaultFuzzTest is Test {
+    UsdtYieldVault vault;
+    MockUSDT usdt;
+    AccruingAavePool pool;
+    AccruingAToken aUsdt;
+
+    address owner = makeAddr("owner");
+    address alice = makeAddr("alice");
+
+    function setUp() public {
+        usdt = new MockUSDT();
+        pool = new AccruingAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 10, owner);
+
+        usdt.mint(alice, type(uint128).max);
+        vm.prank(alice);
+        usdt.approve(address(vault), type(uint256).max);
+        usdt.mint(address(pool), 1_000_000_000e6);
+    }
+
+    /// @notice A lone depositor round-tripping should lose the two advertised fees
+    ///         (0.1% in, 0.3% out) and nothing more.
+    function testFuzz_RoundTripLosesOnlyAdvertisedFees(uint256 amount) public {
+        amount = bound(amount, 1e6, 1_000_000_000e6);
+
+        uint256 before = usdt.balanceOf(alice);
+
+        vm.startPrank(alice);
+        uint256 shares = vault.deposit(amount);
+        uint256 net = vault.withdraw(shares);
+        vm.stopPrank();
+
+        uint256 lost = before - usdt.balanceOf(alice);
+        // Sole depositor: the deposit fee is charged but stays in her own share, so the
+        // only real cost should be the 0.3% exit fee.
+        uint256 maxExpectedLoss = (amount * 30) / 10_000 + 1;
+
+        console.log("amount / net / lost:", amount, net, lost);
+        assertLe(lost, maxExpectedLoss, "round trip lost more than the advertised fees");
+    }
+
+    /// @notice Setting a fee above 100% should be rejected by the setter.
+    function testFuzz_FeeAboveOneHundredPercentIsRejected(uint256 feeBps) public {
+        feeBps = bound(feeBps, 10_001, type(uint256).max);
+
+        vm.prank(owner);
+        vm.expectRevert();
+        vault.setDepositFee(feeBps);
+    }
+
+    /// @notice Concrete consequence of the missing bound: deposits panic instead of
+    ///         reverting cleanly, for every depositor, until the owner fixes the fee.
+    function test_DepositStillWorksAfterBadFee() public {
+        vm.prank(owner);
+        vault.setDepositFee(10_001);
+
+        vm.prank(alice);
+        vault.deposit(1_000e6);
+    }
+
+    /// @notice Whatever the vault reports as its assets should be what it can actually pay.
+    function testFuzz_ReportedAssetsAreBacked(uint256 a, uint256 b, uint256 accrueBps) public {
+        a = bound(a, 1e6, 1_000_000e6);
+        b = bound(b, 1e6, 1_000_000e6);
+        accrueBps = bound(accrueBps, 0, 2_000);
+
+        vm.startPrank(alice);
+        uint256 s1 = vault.deposit(a);
+        aUsdt.accrue(accrueBps);
+        vault.deposit(b);
+        vault.withdraw(s1);
+        vm.stopPrank();
+
+        assertEq(
+            vault.totalAssets(), aUsdt.balanceOf(address(vault)), "reported assets diverge from the real position"
+        );
+    }
+}
diff --git a/test/VaultInvariant.t.sol b/test/VaultInvariant.t.sol
new file mode 100644
index 0000000..b2f152e
--- /dev/null
+++ b/test/VaultInvariant.t.sol
@@ -0,0 +1,133 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console} from "forge-std/Test.sol";
+import {StdInvariant} from "forge-std/StdInvariant.sol";
+
+import {UsdtYieldVault} from "../src/UsdtYieldVault.sol";
+import {MockUSDT} from "./mocks/MockUSDT.sol";
+import {AccruingAavePool, AccruingAToken} from "./helpers/AccruingAavePool.sol";
+
+/// @notice Drives random deposit / withdraw / interest-accrual / fee-change sequences.
+contract VaultHandler is Test {
+    UsdtYieldVault public vault;
+    MockUSDT public usdt;
+    AccruingAToken public aUsdt;
+    address public owner;
+
+    address[3] public actors = [
+        address(uint160(uint256(keccak256("actor0")))),
+        address(uint160(uint256(keccak256("actor1")))),
+        address(uint160(uint256(keccak256("actor2"))))
+    ];
+
+    uint256 public totalDeposited;
+    uint256 public totalWithdrawn;
+
+    constructor(UsdtYieldVault _vault, MockUSDT _usdt, AccruingAToken _aUsdt, address _owner) {
+        vault = _vault;
+        usdt = _usdt;
+        aUsdt = _aUsdt;
+        owner = _owner;
+        for (uint256 i = 0; i < actors.length; i++) {
+            usdt.mint(actors[i], 10_000_000e6);
+            vm.prank(actors[i]);
+            usdt.approve(address(vault), type(uint256).max);
+        }
+    }
+
+    function _actor(uint256 seed) internal view returns (address) {
+        return actors[seed % actors.length];
+    }
+
+    function deposit(uint256 actorSeed, uint256 amount) public {
+        address a = _actor(actorSeed);
+        amount = bound(amount, 1e6, 100_000e6);
+        if (usdt.balanceOf(a) < amount) return;
+        vm.prank(a);
+        vault.deposit(amount);
+        totalDeposited += amount;
+    }
+
+    function withdraw(uint256 actorSeed, uint256 shares) public {
+        address a = _actor(actorSeed);
+        uint256 held = vault.shareBalance(a);
+        if (held == 0) return;
+        shares = bound(shares, 1, held);
+        if (vault.convertToAssets(shares) == 0) return;
+        vm.prank(a);
+        totalWithdrawn += vault.withdraw(shares);
+    }
+
+    /// @notice Aave pays interest between user actions.
+    function accrueInterest(uint256 bps) public {
+        bps = bound(bps, 0, 100);
+        aUsdt.accrue(bps);
+    }
+
+    function setDepositFee(uint256 feeBps) public {
+        feeBps = bound(feeBps, 0, 1_000); // stay inside a sane, non-bricking range
+        vm.prank(owner);
+        vault.setDepositFee(feeBps);
+    }
+}
+
+contract VaultInvariantTest is StdInvariant, Test {
+    UsdtYieldVault vault;
+    MockUSDT usdt;
+    AccruingAavePool pool;
+    AccruingAToken aUsdt;
+    VaultHandler handler;
+
+    address owner = makeAddr("owner");
+
+    function setUp() public {
+        usdt = new MockUSDT();
+        pool = new AccruingAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 10, owner);
+        usdt.mint(address(pool), 100_000_000e6);
+
+        handler = new VaultHandler(vault, usdt, aUsdt, owner);
+        targetContract(address(handler));
+    }
+
+    /// @notice The vault's own books must describe the position it actually holds.
+    ///         If they drift, the difference is USDT nobody can ever withdraw.
+    function invariant_TrackedAssetsMatchAavePosition() public view {
+        uint256 booked = vault.totalAssetsStored();
+        uint256 real = aUsdt.balanceOf(address(vault));
+        uint256 unreachable = real > booked ? real - booked : 0;
+        // A few units of slack absorbs AccruingAToken's floor-rounded scaled balances,
+        // so what this catches is the vault's own leak rather than the test double's dust.
+        assertLe(unreachable, 3, "USDT is accumulating in Aave that no one can withdraw");
+    }
+
+    /// @notice Shares must add up.
+    function invariant_SharesAddUp() public view {
+        uint256 sum;
+        for (uint256 i = 0; i < 3; i++) {
+            sum += vault.shareBalance(handler.actors(i));
+        }
+        assertEq(sum, vault.totalShares(), "share accounting broken");
+    }
+
+    /// @notice Every depositor must be able to exit for what the vault says they own.
+    function invariant_AllDepositorsCanBePaid() public view {
+        uint256 owed;
+        for (uint256 i = 0; i < 3; i++) {
+            owed += vault.balanceOfUnderlying(handler.actors(i));
+        }
+        // Tolerance of 1 unit per actor: AccruingAToken.mint floors its scaled-balance
+        // division, so a deposit made after interest has accrued can credit 1 unit less
+        // aToken than the vault booked. That is a rounding artefact of this test double,
+        // not of the vault; the tolerance isolates the vault's own behaviour.
+        assertLe(owed, aUsdt.balanceOf(address(vault)) + 3, "vault owes materially more than it holds");
+    }
+
+    /// @notice A share of a yield-bearing vault must never be worth less than it was.
+    function invariant_SharePriceNeverFalls() public view {
+        if (vault.totalShares() == 0) return;
+        assertGe(vault.sharePrice(), 1e6, "share price fell below the 1 USDT starting price");
+    }
+}
