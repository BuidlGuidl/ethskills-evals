+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console} from "forge-std/Test.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+
+import {UsdtYieldVault} from "../src/UsdtYieldVault.sol";
+
+/// @notice Integration tests against the REAL mainnet USDT and the REAL Aave V3 pool.
+///         The in-repo suite only ever sees MockUSDT (a stock OpenZeppelin ERC20) and
+///         MockAavePool (a pool that never accrues interest). These tests replace both
+///         with the actual deployed contracts the vault will face on Monday.
+contract ForkRealUsdtTest is Test {
+    address constant USDT = 0xdAC17F958D2ee523a2206206994597C13D831ec7;
+    address constant AAVE_POOL = 0x87870Bca3F3fD6335C3F4ce8392D69350B4fA4E2;
+    address constant AUSDT = 0x23878914EFE38d27C4D67Ab83ed1b93A74D4086a;
+
+    uint256 constant FORK_BLOCK = 23_000_000;
+
+    UsdtYieldVault vault;
+    address owner = makeAddr("owner");
+    address alice = makeAddr("alice");
+
+    function setUp() public {
+        vm.createSelectFork(vm.envOr("MAINNET_RPC_URL", string("https://eth.drpc.org")), FORK_BLOCK);
+
+        vault = new UsdtYieldVault(USDT, AUSDT, AAVE_POOL, 10, owner);
+
+        deal(USDT, alice, 100_000e6);
+        vm.prank(alice);
+        // NB: this is the caller approving the vault, not the vault approving Aave.
+        // Done low-level precisely because USDT.approve returns no data.
+        (bool ok,) = USDT.call(abi.encodeWithSignature("approve(address,uint256)", address(vault), type(uint256).max));
+        require(ok, "user approve failed");
+    }
+
+    /// @notice The single most basic thing a depositor does. Passes against MockUSDT.
+    function test_AliceCanDepositRealUsdt() public {
+        vm.prank(alice);
+        uint256 shares = vault.deposit(1_000e6);
+
+        assertGt(shares, 0, "alice should have received shares");
+        assertEq(IERC20(AUSDT).balanceOf(address(vault)), 1_000e6, "vault should hold aUSDT");
+    }
+
+    /// @notice Diagnosis: USDT.approve returns zero bytes, so the IERC20 bool decode reverts.
+    function test_Diagnosis_UsdtApproveReturnsNoData() public {
+        vm.prank(address(vault));
+        (bool ok, bytes memory ret) =
+            USDT.call(abi.encodeWithSignature("approve(address,uint256)", AAVE_POOL, uint256(1_000e6)));
+
+        console.log("raw call succeeded:", ok);
+        console.log("returndata length :", ret.length);
+
+        // The low-level call succeeds...
+        assertTrue(ok, "raw approve should succeed");
+        // ...but there is no bool to decode, which is what kills UsdtYieldVault.deposit().
+        assertEq(ret.length, 0, "USDT.approve returns no data");
+
+        // Proof that the typed call the vault actually makes reverts:
+        vm.prank(address(vault));
+        vm.expectRevert();
+        IERC20(USDT).approve(AAVE_POOL, 1_000e6);
+    }
+}
diff --git a/test/VaultAccounting.t.sol b/test/VaultAccounting.t.sol
new file mode 100644
index 0000000..cf0ee9d
--- /dev/null
+++ b/test/VaultAccounting.t.sol
@@ -0,0 +1,250 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console} from "forge-std/Test.sol";
+import {Pausable} from "@openzeppelin/contracts/utils/Pausable.sol";
+
+import {UsdtYieldVault} from "../src/UsdtYieldVault.sol";
+import {MockUSDT} from "./mocks/MockUSDT.sol";
+import {AccruingAavePool, AccruingAToken} from "./helpers/AccruingAavePool.sol";
+
+/// @notice Accounting tests run against an Aave pool that ACTUALLY PAYS INTEREST.
+///         The in-repo suite uses MockAavePool, whose aToken balance never grows, so
+///         every one of these behaviours is invisible to it.
+contract VaultAccountingTest is Test {
+    UsdtYieldVault vault;
+    MockUSDT usdt;
+    AccruingAavePool pool;
+    AccruingAToken aUsdt;
+
+    address owner = makeAddr("owner");
+    address alice = makeAddr("alice");
+    address bob = makeAddr("bob");
+
+    function _setUpWithFee(uint256 feeBps) internal {
+        usdt = new MockUSDT();
+        pool = new AccruingAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), feeBps, owner);
+
+        for (uint256 i = 0; i < 2; i++) {
+            address who = i == 0 ? alice : bob;
+            usdt.mint(who, 1_000_000e6);
+            vm.prank(who);
+            usdt.approve(address(vault), type(uint256).max);
+        }
+        // Liquidity so the pool can pay out interest it owes.
+        usdt.mint(address(pool), 1_000_000e6);
+    }
+
+    function setUp() public {
+        _setUpWithFee(0);
+    }
+
+    /*//////////////////////////////////////////////////////////////
+                    F2: YIELD NEVER REACHES DEPOSITORS
+    //////////////////////////////////////////////////////////////*/
+
+    /// @notice The core promise of a "yield vault": a depositor earns the Aave interest.
+    function test_DepositorEarnsAaveYield() public {
+        vm.prank(alice);
+        uint256 shares = vault.deposit(1_000e6);
+
+        // Aave pays 5%. The vault's aUSDT position really does grow.
+        pool.aToken().accrue(500);
+
+        console.log("aUSDT actually held by vault :", aUsdt.balanceOf(address(vault)));
+        console.log("vault.totalAssets()          :", vault.totalAssets());
+        console.log("alice balanceOfUnderlying()  :", vault.balanceOfUnderlying(alice));
+
+        assertEq(aUsdt.balanceOf(address(vault)), 1_050e6, "vault really did earn 50 USDT");
+
+        // Alice should be credited with the 50 USDT of interest, less the 0.3% exit fee.
+        assertApproxEqAbs(
+            vault.balanceOfUnderlying(alice), 1_050e6, 1, "alice should be credited the interest she earned"
+        );
+
+        uint256 before = usdt.balanceOf(alice);
+        vm.prank(alice);
+        vault.withdraw(shares);
+        uint256 received = usdt.balanceOf(alice) - before;
+
+        console.log("alice actually received      :", received);
+        assertApproxEqAbs(received, 1_050e6 - 3_150_000, 1, "alice should withdraw principal + interest");
+    }
+
+    /// @notice Once the last depositor exits, is the earned interest recoverable by anyone?
+    function test_YieldIsRecoverableAfterEveryoneExits() public {
+        vm.prank(alice);
+        uint256 shares = vault.deposit(1_000e6);
+        pool.aToken().accrue(500);
+
+        vm.prank(alice);
+        vault.withdraw(shares);
+
+        uint256 stranded = aUsdt.balanceOf(address(vault));
+        console.log("vault shares outstanding     :", vault.totalShares());
+        console.log("vault.totalAssetsStored()    :", vault.totalAssetsStored());
+        console.log("aUSDT left stranded in Aave  :", stranded);
+
+        assertEq(stranded, 0, "no USDT should be left behind in Aave");
+    }
+
+    /// @notice Scale of the leak on a realistic book: 5m USDT, 4% APY, one year,
+    ///         depositors churning monthly.
+    function test_LeakOverOneYearIsNegligible() public {
+        address[10] memory users;
+        for (uint256 i = 0; i < 10; i++) {
+            users[i] = address(uint160(1000 + i));
+            usdt.mint(users[i], 500_000e6);
+            vm.prank(users[i]);
+            usdt.approve(address(vault), type(uint256).max);
+            vm.prank(users[i]);
+            vault.deposit(500_000e6);
+        }
+        usdt.mint(address(pool), 10_000_000e6);
+
+        // 12 months: ~0.333% interest per month, one user cycling out and back in.
+        for (uint256 m = 0; m < 12; m++) {
+            aUsdt.accrue(33);
+            address u = users[m % 10];
+            uint256 sh = vault.shareBalance(u);
+            vm.prank(u);
+            vault.withdraw(sh);
+            uint256 redeposit = usdt.balanceOf(u) > 400_000e6 ? 400_000e6 : usdt.balanceOf(u);
+            vm.prank(u);
+            vault.deposit(redeposit);
+        }
+
+        uint256 real = aUsdt.balanceOf(address(vault));
+        uint256 booked = vault.totalAssetsStored();
+        console.log("real Aave position (USDT) :", real / 1e6);
+        console.log("vault booked      (USDT) :", booked / 1e6);
+        console.log("unreachable       (USDT) :", (real - booked) / 1e6);
+
+        assertLe(real - booked, 1e6, "more than 1 USDT has become unreachable");
+    }
+
+    /*//////////////////////////////////////////////////////////////
+              F3: WITHDRAW FEE IS DEBITED BUT NEVER COLLECTED
+    //////////////////////////////////////////////////////////////*/
+
+    /// @notice The contract docs say both fees "stay supplied in Aave and accrue to the
+    ///         remaining shareholders". Test that claim directly.
+    function test_WithdrawFeeAccruesToRemainingShareholders() public {
+        vm.prank(alice);
+        uint256 aliceShares = vault.deposit(1_000e6);
+        vm.prank(bob);
+        vault.deposit(1_000e6);
+
+        uint256 bobBefore = vault.balanceOfUnderlying(bob);
+        uint256 priceBefore = vault.sharePrice();
+
+        vm.prank(alice);
+        vault.withdraw(aliceShares); // pays a 0.3% = 3 USDT exit fee
+
+        uint256 bobAfter = vault.balanceOfUnderlying(bob);
+
+        console.log("bob underlying before exit   :", bobBefore);
+        console.log("bob underlying after exit    :", bobAfter);
+        console.log("share price before / after   :", priceBefore, vault.sharePrice());
+        console.log("aUSDT really held by vault   :", aUsdt.balanceOf(address(vault)));
+        console.log("vault.totalAssetsStored()    :", vault.totalAssetsStored());
+
+        assertGt(bobAfter, bobBefore, "alice's 3 USDT exit fee should accrue to bob");
+    }
+
+    /// @notice Whatever the vault thinks it has should match what it actually has.
+    function test_TrackedAssetsMatchAavePosition() public {
+        vm.prank(alice);
+        uint256 aliceShares = vault.deposit(1_000e6);
+        vm.prank(bob);
+        vault.deposit(1_000e6);
+
+        vm.prank(alice);
+        vault.withdraw(aliceShares);
+
+        assertEq(
+            vault.totalAssetsStored(),
+            aUsdt.balanceOf(address(vault)),
+            "totalAssetsStored must match the real Aave position"
+        );
+    }
+
+    /*//////////////////////////////////////////////////////////////
+                 F4: OWNER CAN CONFISCATE VIA THE FEE KNOB
+    //////////////////////////////////////////////////////////////*/
+
+    /// @notice setDepositFee has no upper bound and no timelock.
+    function test_OwnerCannotSetConfiscatoryDepositFee() public {
+        vm.prank(owner);
+        vault.setDepositFee(9_999); // 99.99%
+        assertLe(vault.depositFeeBps(), 1_000, "deposit fee should be capped at a sane maximum");
+    }
+
+    /// @notice End-to-end: owner front-runs a depositor and takes their money.
+    function test_OwnerCannotStealDepositByRaisingFee() public {
+        // Owner seeds the vault with 1 USDT.
+        usdt.mint(owner, 1_000e6);
+        vm.startPrank(owner);
+        usdt.approve(address(vault), type(uint256).max);
+        uint256 ownerShares = vault.deposit(1e6);
+        // Alice's deposit is in the mempool; owner front-runs it.
+        vault.setDepositFee(9_999);
+        vm.stopPrank();
+
+        vm.prank(alice);
+        vault.deposit(10_000e6);
+
+        uint256 ownerValue = vault.balanceOfUnderlying(owner);
+        uint256 aliceValue = vault.balanceOfUnderlying(alice);
+
+        console.log("owner put in 1 USDT, now worth :", ownerValue);
+        console.log("alice put in 10000 USDT, now   :", aliceValue);
+        console.log("owner shares / alice shares    :", ownerShares, vault.shareBalance(alice));
+
+        assertApproxEqRel(aliceValue, 10_000e6, 0.01e18, "alice should keep ~what she deposited");
+    }
+
+    /*//////////////////////////////////////////////////////////////
+                    F5: PAUSE IS A ONE-WAY FUND FREEZE
+    //////////////////////////////////////////////////////////////*/
+
+    /// @notice A paused vault must still let depositors get their principal out,
+    ///         or pause is a confiscation switch rather than a safety switch.
+    function test_CanWithdrawWhilePaused() public {
+        vm.prank(alice);
+        uint256 shares = vault.deposit(1_000e6);
+
+        vm.prank(owner);
+        vault.pause();
+
+        vm.prank(alice);
+        vault.withdraw(shares);
+
+        assertGt(usdt.balanceOf(alice), 999_000e6, "alice must be able to exit a paused vault");
+    }
+
+    /// @notice Ownable.renounceOwnership is not overridden, so the owner can pause and
+    ///         then destroy the only key that can ever unpause.
+    function test_PauseCannotBeMadePermanent() public {
+        vm.prank(alice);
+        uint256 shares = vault.deposit(1_000e6);
+
+        vm.startPrank(owner);
+        vault.pause();
+        vault.renounceOwnership();
+        vm.stopPrank();
+
+        assertEq(vault.owner(), address(0));
+        console.log("owner is now:", vault.owner());
+        console.log("paused      :", vault.paused());
+
+        vm.prank(alice);
+        vm.expectRevert(Pausable.EnforcedPause.selector);
+        vault.withdraw(shares);
+
+        // There is no longer any address on earth that can call unpause().
+        fail("vault is permanently frozen with alice's 1000 USDT inside");
+    }
+}
