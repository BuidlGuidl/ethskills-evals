+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test} from "forge-std/Test.sol";
+
+import {UsdtYieldVault} from "../src/UsdtYieldVault.sol";
+
+contract UsdtYieldVaultMainnetForkFailureTest is Test {
+    address public constant USDT = 0xdAC17F958D2ee523a2206206994597C13D831ec7;
+    address public constant AAVE_V3_POOL = 0x87870Bca3F3fD6335C3F4ce8392D69350B4fA4E2;
+    address public constant A_USDT = 0x23878914EFE38d27C4D67Ab83ed1b93A74D4086a;
+    uint256 public constant FORK_BLOCK = 26_026_346;
+
+    address public alice = makeAddr("alice");
+
+    function test_DepositWorksWithMainnetUsdtAndAave() public {
+        vm.createSelectFork("https://ethereum.publicnode.com", FORK_BLOCK);
+
+        UsdtYieldVault vault = new UsdtYieldVault(USDT, A_USDT, AAVE_V3_POOL, 0, address(this));
+        deal(USDT, alice, 1_000e6);
+
+        vm.prank(alice);
+        (bool approved,) =
+            USDT.call(abi.encodeWithSignature("approve(address,uint256)", address(vault), type(uint256).max));
+        assertTrue(approved, "real USDT approval setup failed");
+
+        vm.prank(alice);
+        vault.deposit(1_000e6);
+
+        assertEq(vault.totalAssets(), 1_000e6);
+    }
+}

