+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test} from "forge-std/Test.sol";
+
+import {UsdtYieldVault} from "../src/UsdtYieldVault.sol";
+import {MockUSDT} from "./mocks/MockUSDT.sol";
+import {MockAavePool, MockAToken} from "./mocks/MockAavePool.sol";
+
+contract UsdtYieldVaultAccountingFailureTest is Test {
+    UsdtYieldVault public vault;
+    MockUSDT public usdt;
+    MockAavePool public pool;
+    MockAToken public aUsdt;
+
+    address public owner = makeAddr("owner");
+    address public alice = makeAddr("alice");
+    address public bob = makeAddr("bob");
+
+    uint256 public constant DEPOSIT_AMOUNT = 1_000e6;
+
+    function setUp() public {
+        usdt = new MockUSDT();
+        pool = new MockAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 0, owner);
+
+        usdt.mint(alice, 100_000e6);
+        usdt.mint(bob, 100_000e6);
+
+        vm.prank(alice);
+        usdt.approve(address(vault), type(uint256).max);
+        vm.prank(bob);
+        usdt.approve(address(vault), type(uint256).max);
+    }
+
+    function _deposit(address account, uint256 amount) internal returns (uint256 shares) {
+        vm.prank(account);
+        shares = vault.deposit(amount);
+    }
+
+    function test_WithdrawalFeesAccrueToRemainingShareholders() public {
+        uint256 aliceShares = _deposit(alice, DEPOSIT_AMOUNT);
+        _deposit(bob, DEPOSIT_AMOUNT);
+
+        vm.prank(alice);
+        vault.withdraw(aliceShares);
+
+        assertEq(vault.balanceOfUnderlying(bob), aUsdt.balanceOf(address(vault)));
+    }
+
+    function test_LastWithdrawDoesNotLeaveAaveBalanceStranded() public {
+        uint256 shares = _deposit(alice, DEPOSIT_AMOUNT);
+
+        vm.prank(alice);
+        vault.withdraw(shares);
+
+        assertEq(aUsdt.balanceOf(address(vault)), 0);
+    }
+
+    function test_AaveYieldIsIncludedInShareholderRedeemableAssets() public {
+        _deposit(alice, DEPOSIT_AMOUNT);
+
+        vm.prank(address(pool));
+        aUsdt.mint(address(vault), 50e6);
+
+        assertEq(vault.totalAssets(), aUsdt.balanceOf(address(vault)));
+    }
+}
