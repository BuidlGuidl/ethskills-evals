+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console2} from "forge-std/Test.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+
+import {UsdtYieldVault} from "../src/UsdtYieldVault.sol";
+import {IAavePool} from "../src/interfaces/IAavePool.sol";
+
+/// @notice Audit tests run against real mainnet state at a pinned block.
+///         These exercise the vault against the exact addresses the README
+///         names for Monday's deployment. Nothing here is mocked.
+contract ForkMainnetTest is Test {
+    address constant USDT = 0xdAC17F958D2ee523a2206206994597C13D831ec7;
+    address constant AUSDT = 0x23878914EFE38d27C4D67Ab83ed1b93A74D4086a;
+    address constant AAVE_POOL = 0x87870Bca3F3fD6335C3F4ce8392D69350B4fA4E2;
+
+    // A bool-returning, Aave-supported asset, used to reach code paths that
+    // the USDT deployment can never reach at all (see F-01).
+    address constant USDC = 0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48;
+    address constant AUSDC = 0x98C23E9d8f34FEFb1B7BD6a91B7FF122F4e16F5c;
+
+    address owner = makeAddr("owner");
+    address alice = makeAddr("alice");
+    address bob = makeAddr("bob");
+
+    function setUp() public {
+        vm.createSelectFork("mainnet", 25_780_000);
+    }
+
+    // ---------------------------------------------------------------
+    // F-01: deposit() is bricked against the real USDT contract.
+    // ---------------------------------------------------------------
+
+    /// Real USDT's approve() is pre-ERC20 and returns NO data. The vault calls
+    /// it through the IERC20 interface, so solc inserts a returndatasize check
+    /// and the call reverts. Every deposit reverts. The vault is a brick.
+    function test_F01_DepositAlwaysRevertsOnRealUsdt() public {
+        UsdtYieldVault vault = new UsdtYieldVault(USDT, AUSDT, AAVE_POOL, 50, owner);
+
+        deal(USDT, alice, 10_000e6);
+        vm.startPrank(alice);
+        // USDT also requires approve-from-zero; alice's allowance starts at 0.
+        (bool ok,) = USDT.call(abi.encodeWithSignature("approve(address,uint256)", address(vault), 10_000e6));
+        assertTrue(ok, "user-side approve should succeed via raw call");
+
+        assertEq(IERC20(USDT).balanceOf(alice), 10_000e6, "alice funded");
+
+        vm.expectRevert();
+        vault.deposit(1_000e6);
+        vm.stopPrank();
+
+        assertEq(vault.totalShares(), 0, "no shares were ever minted");
+        assertEq(IERC20(AUSDT).balanceOf(address(vault)), 0, "nothing reached Aave");
+    }
+
+    /// Isolates the exact cause: USDT.approve returns zero bytes of returndata.
+    function test_F01_RealUsdtApproveReturnsNoData() public {
+        vm.prank(alice);
+        (bool ok, bytes memory ret) = USDT.call(abi.encodeWithSignature("approve(address,uint256)", AAVE_POOL, 1e6));
+        assertTrue(ok, "raw approve succeeds");
+        assertEq(ret.length, 0, "USDT.approve returns NOTHING, so IERC20.approve reverts on decode");
+    }
+
+    // ---------------------------------------------------------------
+    // F-02: real Aave interest never reaches depositors.
+    // Uses USDC so the deposit path is reachable at all; the Aave pool,
+    // the aToken and the interest accrual are all real mainnet ones.
+    // ---------------------------------------------------------------
+
+    function test_F02_RealAaveYieldIsStrandedForever() public {
+        UsdtYieldVault vault = new UsdtYieldVault(USDC, AUSDC, AAVE_POOL, 0, owner);
+
+        deal(USDC, alice, 1_000_000e6);
+        vm.startPrank(alice);
+        IERC20(USDC).approve(address(vault), type(uint256).max);
+        uint256 shares = vault.deposit(1_000_000e6);
+        vm.stopPrank();
+
+        uint256 aTokenAtDeposit = IERC20(AUSDC).balanceOf(address(vault));
+
+        // Let real Aave interest accrue for a year of blocks.
+        vm.warp(block.timestamp + 365 days);
+
+        uint256 aTokenAfterYear = IERC20(AUSDC).balanceOf(address(vault));
+        uint256 realInterest = aTokenAfterYear - aTokenAtDeposit;
+
+        console2.log("aToken balance at deposit :", aTokenAtDeposit);
+        console2.log("aToken balance after 1yr  :", aTokenAfterYear);
+        console2.log("real Aave interest earned :", realInterest);
+        console2.log("vault.totalAssets()       :", vault.totalAssets());
+        console2.log("alice balanceOfUnderlying :", vault.balanceOfUnderlying(alice));
+
+        assertGt(realInterest, 0, "real Aave DID pay interest");
+
+        // The vault's accounting is frozen at the deposited principal.
+        assertEq(vault.totalAssets(), 1_000_000e6, "totalAssets ignores all yield");
+        assertEq(vault.balanceOfUnderlying(alice), 1_000_000e6, "depositor is credited zero yield");
+
+        uint256 before = IERC20(USDC).balanceOf(alice);
+        vm.prank(alice);
+        vault.withdraw(shares);
+        uint256 received = IERC20(USDC).balanceOf(alice) - before;
+
+        console2.log("alice deposited           :", uint256(1_000_000e6));
+        console2.log("alice received after 1yr  :", received);
+        console2.log("yield left stuck in vault :", IERC20(AUSDC).balanceOf(address(vault)));
+
+        // Sole depositor, held a year, gets back LESS than she put in.
+        assertLt(received, 1_000_000e6, "sole depositor LOSES money over a year");
+
+        // And every cent of yield is stranded with no function to recover it.
+        assertGt(IERC20(AUSDC).balanceOf(address(vault)), realInterest, "yield + fee unreachable");
+        assertEq(vault.totalShares(), 0, "no shares left that could ever claim it");
+    }
+
+    // ---------------------------------------------------------------
+    // F-07: USDT can switch on a transfer fee at any time. deposit()
+    //       supplies `amount` but would receive less than `amount`.
+    //       This bites any fix for F-01 that keeps the current flow.
+    // ---------------------------------------------------------------
+
+    function test_F07_UsdtTransferFeeCanBeEnabledAndBreaksTheDepositFlow() public {
+        address usdtOwner = 0xC6CDE7C39eB2f0F0095F41570af89eFC2C1Ea828;
+
+        assertEq(_u256(USDT, "basisPointsRate()"), 0, "fee is off today");
+
+        // Tether's owner can turn it on unilaterally, at any time.
+        vm.prank(usdtOwner);
+        (bool ok,) = USDT.call(abi.encodeWithSignature("setParams(uint256,uint256)", 10, 49));
+        assertTrue(ok, "Tether owner enabled the transfer fee");
+        assertEq(_u256(USDT, "basisPointsRate()"), 10, "10 bps now charged on every transfer");
+
+        // A vault-shaped pull of 1,000 USDT now delivers less than 1,000.
+        deal(USDT, alice, 1_000e6);
+        address sink = makeAddr("sink");
+        vm.prank(alice);
+        USDT.call(abi.encodeWithSignature("approve(address,uint256)", sink, 1_000e6));
+        vm.prank(sink);
+        (ok,) = USDT.call(abi.encodeWithSignature("transferFrom(address,address,uint256)", alice, sink, 1_000e6));
+        assertTrue(ok);
+
+        uint256 delivered = IERC20(USDT).balanceOf(sink);
+        console2.log("pulled  :", uint256(1_000e6));
+        console2.log("received:", delivered);
+        console2.log("shortfall:", 1_000e6 - delivered);
+
+        assertLt(delivered, 1_000e6, "received less than requested");
+        // deposit() then calls aavePool.supply(usdt, amount=1_000e6) while
+        // holding only `delivered`, which Aave's own transferFrom reverts on.
+    }
+
+    function _u256(address target, string memory sig) internal view returns (uint256) {
+        (bool ok, bytes memory ret) = target.staticcall(abi.encodeWithSignature(sig));
+        require(ok, "staticcall");
+        return abi.decode(ret, (uint256));
+    }
+}

