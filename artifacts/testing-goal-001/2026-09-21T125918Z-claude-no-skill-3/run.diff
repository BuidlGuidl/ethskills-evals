diff --git a/test/AuditAccounting.t.sol b/test/AuditAccounting.t.sol
new file mode 100644
index 0000000..177ed94
--- /dev/null
+++ b/test/AuditAccounting.t.sol
@@ -0,0 +1,276 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console2, stdError} from "forge-std/Test.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {Pausable} from "@openzeppelin/contracts/utils/Pausable.sol";
+
+import {UsdtYieldVault} from "../src/UsdtYieldVault.sol";
+import {AuditUSDT, AuditAavePool, AuditAToken} from "./AuditMocks.sol";
+
+contract AuditAccountingTest is Test {
+    AuditUSDT usdt;
+    AuditAavePool pool;
+    AuditAToken aUsdt;
+    UsdtYieldVault vault;
+
+    address owner = makeAddr("owner");
+    address alice = makeAddr("alice");
+    address bob = makeAddr("bob");
+
+    function setUp() public {
+        usdt = new AuditUSDT();
+        pool = new AuditAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 0, owner);
+        _fund(alice);
+        _fund(bob);
+    }
+
+    function _fund(address who) internal {
+        usdt.mint(who, 10_000_000e6);
+        vm.prank(who);
+        usdt.approve(address(vault), type(uint256).max);
+    }
+
+    // =============================================================
+    // F-03  The withdrawal fee is deleted from accounting, not paid
+    //       to anyone. It becomes permanently unreachable.
+    //
+    //       NatSpec claims: "Both fees stay supplied in Aave and accrue
+    //       to the remaining shareholders rather than being swept to
+    //       the owner."  withdraw() does `totalAssetsStored -= grossAssets`
+    //       while only pulling `netAssets` out of Aave.
+    // =============================================================
+    function test_F03_WithdrawFeeAccruesToNobodyAndIsStranded() public {
+        vm.prank(alice);
+        vault.deposit(1_000e6);
+        vm.prank(bob);
+        vault.deposit(1_000e6);
+
+        uint256 bobBefore = vault.balanceOfUnderlying(bob);
+        uint256 priceBefore = vault.sharePrice();
+
+        uint256 aliceShares = vault.shareBalance(alice);
+        vm.prank(alice);
+        vault.withdraw(aliceShares);
+
+        console2.log("bob underlying before alice's exit :", bobBefore);
+        console2.log("bob underlying after  alice's exit :", vault.balanceOfUnderlying(bob));
+        console2.log("share price before / after         :", priceBefore, vault.sharePrice());
+
+        // The documented behaviour would raise bob's claim by the 3 USDT fee.
+        assertEq(vault.balanceOfUnderlying(bob), bobBefore, "fee did NOT accrue to remaining shareholder");
+        assertEq(vault.sharePrice(), priceBefore, "share price unmoved: nobody was paid the fee");
+
+        // Bob exits too. Now nobody holds shares, yet real value sits in Aave.
+        uint256 bobShares = vault.shareBalance(bob);
+        vm.prank(bob);
+        vault.withdraw(bobShares);
+
+        uint256 orphaned = aUsdt.balanceOf(address(vault));
+        console2.log("totalShares after everyone exits   :", vault.totalShares());
+        console2.log("aUSDT still held by the vault      :", orphaned);
+        console2.log("totalAssets() claims               :", vault.totalAssets());
+
+        assertEq(vault.totalShares(), 0);
+        assertEq(orphaned, 6e6, "6 USDT of fees orphaned with zero shares outstanding");
+        assertEq(vault.totalAssets(), 0, "vault accounting says it holds nothing");
+        // No sweep, no rescue, no owner withdrawal function exists.
+    }
+
+    /// The gap between what the vault owns and what it thinks it owns only grows.
+    function test_F03_AccountingDriftGrowsWithEveryWithdrawal() public {
+        vm.prank(alice);
+        vault.deposit(1_000_000e6);
+
+        for (uint256 i = 0; i < 5; i++) {
+            uint256 half = vault.shareBalance(alice) / 2;
+            vm.prank(alice);
+            vault.withdraw(half);
+            uint256 real = aUsdt.balanceOf(address(vault));
+            uint256 booked = vault.totalAssets();
+            console2.log("round", i, "real aUSDT:", real);
+            console2.log("        booked totalAssets:", booked);
+            console2.log("        unreachable drift :", real - booked);
+            assertGt(real, booked, "vault silently owns more than it can ever pay out");
+        }
+    }
+
+    // =============================================================
+    // F-04  The deposit fee collects nothing from a sole depositor:
+    //       it is credited straight back to the only shareholder.
+    // =============================================================
+    function test_F04_DepositFeeIsRefundedToASoleDepositor() public {
+        vm.prank(owner);
+        vault.setDepositFee(500); // 5%, a fee nobody could call negligible
+
+        vm.prank(alice);
+        vault.deposit(1_000e6);
+
+        console2.log("deposit fee bps            :", vault.depositFeeBps());
+        console2.log("alice deposited            :", uint256(1_000e6));
+        console2.log("alice balanceOfUnderlying  :", vault.balanceOfUnderlying(alice));
+
+        assertEq(vault.balanceOfUnderlying(alice), 1_000e6, "5% fee charged, 100% credited back");
+    }
+
+    /// Conversely, the fee is a wealth transfer to whoever already holds shares:
+    /// a whale front-running a known depositor captures almost all of their fee.
+    function test_F04_DepositFeeIsCapturedByIncumbentShareholders() public {
+        vm.prank(owner);
+        vault.setDepositFee(500);
+
+        vm.prank(alice); // the "whale" gets in first
+        vault.deposit(1_000_000e6);
+        uint256 aliceBefore = vault.balanceOfUnderlying(alice);
+
+        vm.prank(bob); // the victim deposits after
+        vault.deposit(100_000e6);
+
+        console2.log("bob paid in                :", uint256(100_000e6));
+        console2.log("bob's claim immediately    :", vault.balanceOfUnderlying(bob));
+        console2.log("alice gained for doing zero:", vault.balanceOfUnderlying(alice) - aliceBefore);
+
+        assertLt(vault.balanceOfUnderlying(bob), 100_000e6, "bob is instantly down");
+        assertGt(vault.balanceOfUnderlying(alice) - aliceBefore, 4_500e6, "alice pockets bob's fee");
+    }
+
+    // =============================================================
+    // F-05  The owner can freeze every depositor's funds indefinitely.
+    // =============================================================
+    function test_F05_OwnerCanPauseWithdrawalsAndHoldFundsHostage() public {
+        vm.prank(alice);
+        vault.deposit(1_000_000e6);
+
+        vm.prank(owner);
+        vault.pause();
+
+        uint256 aliceShares = vault.shareBalance(alice);
+
+        vm.prank(alice);
+        vm.expectRevert(Pausable.EnforcedPause.selector);
+        vault.withdraw(aliceShares);
+
+        // Nothing expires. There is no emergency exit, no timelock, no delay.
+        vm.warp(block.timestamp + 3650 days);
+        vm.prank(alice);
+        vm.expectRevert(Pausable.EnforcedPause.selector);
+        vault.withdraw(aliceShares);
+
+        console2.log("alice locked USDT after 10 years:", vault.balanceOfUnderlying(alice));
+        assertEq(vault.balanceOfUnderlying(alice), 1_000_000e6, "still hers on paper, unreachable in practice");
+    }
+
+    // =============================================================
+    // F-06  setDepositFee is unbounded and takes effect instantly.
+    // =============================================================
+    function test_F06_OwnerCanSetA99PercentDepositFee() public {
+        vm.prank(alice); // an existing pool, so the fee is not refunded to the payer
+        vault.deposit(1_000_000e6);
+
+        vm.prank(owner);
+        vault.setDepositFee(9_900); // 99%: no upper bound is enforced anywhere
+
+        vm.prank(bob);
+        vault.deposit(1_000e6);
+
+        console2.log("deposit fee bps :", vault.depositFeeBps());
+        console2.log("bob paid in     :", uint256(1_000e6));
+        console2.log("bob's claim     :", vault.balanceOfUnderlying(bob));
+
+        assertEq(vault.depositFeeBps(), 9_900, "setDepositFee accepts 99% without complaint");
+        assertLt(vault.balanceOfUnderlying(bob), 11e6, "bob lost ~99% of his deposit on the spot");
+    }
+
+    /// A fee above 100% bricks deposits outright (arithmetic underflow).
+    function test_F06_FeeAbove100PercentBricksDeposits() public {
+        vm.prank(owner);
+        vault.setDepositFee(10_001);
+
+        vm.prank(alice);
+        vm.expectRevert(stdError.arithmeticError);
+        vault.deposit(1_000e6);
+    }
+
+    /// The owner can raise the fee in the block between a user's approve and
+    /// their deposit. No user-supplied minimum-shares guard exists.
+    function test_F06_FeeChangeFrontRunsAnInFlightDeposit() public {
+        vm.prank(alice);
+        vault.deposit(1_000e6); // seed so shares are priced
+
+        uint256 expected = vault.convertToShares(1_000e6); // what bob quotes off-chain
+
+        vm.prank(owner); // owner's tx lands first
+        vault.setDepositFee(9_000);
+
+        vm.prank(bob);
+        uint256 got = vault.deposit(1_000e6);
+
+        console2.log("shares bob quoted :", expected);
+        console2.log("shares bob got    :", got);
+        assertLt(got, expected / 5, "bob got a fraction of his quote and had no way to say no");
+    }
+
+    // =============================================================
+    // F-02 (local corroboration) Aave interest never reaches depositors.
+    // =============================================================
+    function test_F02_InterestAccruedInAaveIsInvisibleToTheVault() public {
+        vm.prank(alice);
+        vault.deposit(1_000_000e6);
+
+        pool.accrueInterest(address(vault), 50_000e6); // 5% APY, one year
+
+        console2.log("vault aUSDT balance      :", aUsdt.balanceOf(address(vault)));
+        console2.log("vault.totalAssets()      :", vault.totalAssets());
+        console2.log("alice balanceOfUnderlying:", vault.balanceOfUnderlying(alice));
+        console2.log("vault.sharePrice()       :", vault.sharePrice());
+
+        assertEq(aUsdt.balanceOf(address(vault)), 1_050_000e6);
+        assertEq(vault.totalAssets(), 1_000_000e6, "yield never enters accounting");
+        assertEq(vault.balanceOfUnderlying(alice), 1_000_000e6, "sole depositor earns nothing");
+    }
+
+    // =============================================================
+    // F-07  Solvency / value-conservation fuzz.
+    //       Property: a lone depositor who deposits and immediately
+    //       withdraws in full should not be able to LOSE more than the
+    //       stated 30bps withdrawal fee. Deposit fee + withdraw fee
+    //       stack against them with nothing coming back.
+    // =============================================================
+    function testFuzz_F04_DepositFeeCollectsNothingFromALoneRoundTrip(uint256 amount, uint256 feeBps) public {
+        amount = bound(amount, 1e6, 1_000_000e6);
+        feeBps = bound(feeBps, 1, 1_000); // <=10%, i.e. a "reasonable" owner
+
+        vm.prank(owner);
+        vault.setDepositFee(feeBps);
+
+        uint256 before = usdt.balanceOf(alice);
+        vm.startPrank(alice);
+        uint256 shares = vault.deposit(amount);
+        vault.withdraw(shares);
+        vm.stopPrank();
+
+        uint256 loss = before - usdt.balanceOf(alice);
+        // 30bps is the only fee a lone round-tripper should ever see, because the
+        // deposit fee is (per F-04) credited back to the sole shareholder.
+        uint256 maxExpected = (amount * 30) / 10_000 + 1;
+        assertLe(loss, maxExpected, "round-trip loss exceeds the documented 30bps");
+    }
+
+    /// Property: the vault must never book more assets than it can actually pay.
+    function testFuzz_F03_DriftAlwaysStrandsValueNeverUnderfunds(uint96 a, uint96 b) public {
+        uint256 da = bound(uint256(a), 1e6, 1_000_000e6);
+        uint256 db = bound(uint256(b), 1e6, 1_000_000e6);
+
+        vm.prank(alice);
+        vault.deposit(da);
+        vm.prank(bob);
+        vault.deposit(db);
+        uint256 aliceShares = vault.shareBalance(alice);
+        vm.prank(alice);
+        vault.withdraw(aliceShares);
+
+        assertLe(vault.totalAssets(), aUsdt.balanceOf(address(vault)), "vault is insolvent on paper");
+    }
+}
diff --git a/test/AuditInvariant.t.sol b/test/AuditInvariant.t.sol
new file mode 100644
index 0000000..044c07a
--- /dev/null
+++ b/test/AuditInvariant.t.sol
@@ -0,0 +1,124 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console2} from "forge-std/Test.sol";
+
+import {UsdtYieldVault} from "../src/UsdtYieldVault.sol";
+import {AuditUSDT, AuditAavePool, AuditAToken} from "./AuditMocks.sol";
+
+/// @notice Drives the vault with random deposits, withdrawals, fee changes and
+///         Aave interest accrual.
+contract Handler is Test {
+    UsdtYieldVault public vault;
+    AuditUSDT public usdt;
+    AuditAavePool public pool;
+    AuditAToken public aUsdt;
+    address public owner;
+
+    address[3] public actors = [address(0xA11CE), address(0xB0B), address(0xCA401)];
+
+    /// @notice High-water mark of value the vault holds but cannot account for.
+    uint256 public maxDriftSeen;
+
+    constructor(UsdtYieldVault _vault, AuditUSDT _usdt, AuditAavePool _pool, address _owner) {
+        vault = _vault;
+        usdt = _usdt;
+        pool = _pool;
+        aUsdt = _pool.aToken();
+        owner = _owner;
+        for (uint256 i = 0; i < actors.length; i++) {
+            usdt.mint(actors[i], 100_000_000e6);
+            vm.prank(actors[i]);
+            usdt.approve(address(vault), type(uint256).max);
+        }
+    }
+
+    function _actor(uint256 seed) internal view returns (address) {
+        return actors[seed % actors.length];
+    }
+
+    function _track() internal {
+        uint256 drift = aUsdt.balanceOf(address(vault)) - vault.totalAssets();
+        if (drift > maxDriftSeen) maxDriftSeen = drift;
+    }
+
+    function deposit(uint256 actorSeed, uint256 amount) external {
+        amount = bound(amount, 1e6, 1_000_000e6);
+        address a = _actor(actorSeed);
+        vm.prank(a);
+        try vault.deposit(amount) {} catch {}
+        _track();
+    }
+
+    function withdraw(uint256 actorSeed, uint256 sharesSeed) external {
+        address a = _actor(actorSeed);
+        uint256 bal = vault.shareBalance(a);
+        if (bal == 0) return;
+        uint256 shares = bound(sharesSeed, 1, bal);
+        vm.prank(a);
+        try vault.withdraw(shares) {} catch {}
+        _track();
+    }
+
+    function setFee(uint256 feeBps) external {
+        feeBps = bound(feeBps, 0, 1_000);
+        vm.prank(owner);
+        vault.setDepositFee(feeBps);
+    }
+
+    function accrue(uint256 amount) external {
+        amount = bound(amount, 0, 10_000e6);
+        if (aUsdt.balanceOf(address(vault)) == 0) return;
+        pool.accrueInterest(address(vault), amount);
+        _track();
+    }
+}
+
+contract AuditInvariantTest is Test {
+    AuditUSDT usdt;
+    AuditAavePool pool;
+    AuditAToken aUsdt;
+    UsdtYieldVault vault;
+    Handler handler;
+
+    address owner = makeAddr("owner");
+
+    function setUp() public {
+        usdt = new AuditUSDT();
+        pool = new AuditAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 10, owner);
+        handler = new Handler(vault, usdt, pool, owner);
+        targetContract(address(handler));
+    }
+
+    /// HOLDS. The vault never books more than it holds; every discrepancy is in
+    /// the direction of value the depositors can never reach.
+    function invariant_A_NeverBooksMoreThanItHolds() public view {
+        assertLe(vault.totalAssets(), aUsdt.balanceOf(address(vault)));
+    }
+
+    /// FAILS BY DESIGN once any withdrawal or interest accrual happens: value the
+    /// vault physically holds but no share can ever claim. There is no path in
+    /// the contract that ever reduces this number.
+    function invariant_B_NoValueIsUnreachable() public view {
+        uint256 drift = aUsdt.balanceOf(address(vault)) - vault.totalAssets();
+        assertEq(drift, 0, "vault holds value that no shareholder can ever withdraw");
+    }
+
+    /// FAILS. A depositor should always be able to withdraw what
+    /// balanceOfUnderlying() advertises, minus the stated 30bps.
+    function invariant_C_AdvertisedBalanceIsActuallyRedeemable() public {
+        for (uint256 i = 0; i < 3; i++) {
+            address a = handler.actors(i);
+            uint256 shares = vault.shareBalance(a);
+            if (shares == 0) continue;
+            uint256 advertised = vault.balanceOfUnderlying(a);
+            uint256 before = usdt.balanceOf(a);
+            vm.prank(a);
+            vault.withdraw(shares);
+            uint256 got = usdt.balanceOf(a) - before;
+            assertGe(got + (advertised * 30) / 10_000 + 1, advertised, "could not redeem advertised balance");
+        }
+    }
+}
