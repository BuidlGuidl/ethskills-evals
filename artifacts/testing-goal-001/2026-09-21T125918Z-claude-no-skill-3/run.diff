new file mode 100644
index 0000000..1689e89
--- /dev/null
+++ b/test/AuditMocks.sol
@@ -0,0 +1,73 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {ERC20} from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+
+import {IAavePool} from "../src/interfaces/IAavePool.sol";
+
+/// @notice Bool-returning USDT stand-in. Deliberately identical in behaviour to
+///         test/mocks/MockUSDT.sol so that the findings proved with it cannot be
+///         dismissed as artefacts of a hostile mock.
+contract AuditUSDT is ERC20 {
+    constructor() ERC20("Tether USD", "USDT") {}
+
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    function mint(address to, uint256 amount) external {
+        _mint(to, amount);
+    }
+}
+
+/// @notice Aave pool stand-in whose aToken actually accrues interest, which is
+///         the one behaviour test/mocks/MockAavePool.sol never models.
+contract AuditAavePool is IAavePool {
+    IERC20 public immutable underlying;
+    AuditAToken public immutable aToken;
+
+    constructor(address _underlying) {
+        underlying = IERC20(_underlying);
+        aToken = new AuditAToken(address(this));
+    }
+
+    function supply(address, uint256 amount, address onBehalfOf, uint16) external override {
+        require(underlying.transferFrom(msg.sender, address(this), amount), "transferFrom");
+        aToken.mint(onBehalfOf, amount);
+    }
+
+    function withdraw(address, uint256 amount, address to) external override returns (uint256) {
+        aToken.burn(msg.sender, amount);
+        require(underlying.transfer(to, amount), "transfer");
+        return amount;
+    }
+
+    /// @notice Credits interest to a supplier, as real Aave does over time.
+    function accrueInterest(address holder, uint256 amount) external {
+        aToken.mint(holder, amount);
+        AuditUSDT(address(underlying)).mint(address(this), amount);
+    }
+}
+
+contract AuditAToken is ERC20 {
+    address public immutable pool;
+
+    constructor(address _pool) ERC20("Aave Tether USD", "aUSDT") {
+        pool = _pool;
+    }
+
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    function mint(address to, uint256 amount) external {
+        require(msg.sender == pool, "only pool");
+        _mint(to, amount);
+    }
+
+    function burn(address from, uint256 amount) external {
+        require(msg.sender == pool, "only pool");
+        _burn(from, amount);
+    }
+}
