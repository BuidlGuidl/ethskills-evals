+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test} from "forge-std/Test.sol";
+import {ERC20} from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+
+import {UsdtYieldVault} from "../src/UsdtYieldVault.sol";
+import {IAavePool} from "../src/interfaces/IAavePool.sol";
+
+contract MainnetForkUsdtYieldVaultFailureTest is Test {
+    address internal constant MAINNET_USDT = 0xdAC17F958D2ee523a2206206994597C13D831ec7;
+    address internal constant MAINNET_AAVE_V3_POOL = 0x87870Bca3F3fD6335C3F4ce8392D69350B4fA4E2;
+    address internal constant MAINNET_AUSDT = 0x23878914EFE38d27C4D67Ab83ed1b93A74D4086a;
+    string internal constant PUBLIC_MAINNET_RPC = "https://ethereum.publicnode.com";
+    uint256 internal constant FORK_BLOCK = 26_026_344;
+
+    UsdtYieldVault internal vault;
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+
+    function setUp() public {
+        vm.createSelectFork(PUBLIC_MAINNET_RPC, FORK_BLOCK);
+        vault = new UsdtYieldVault(MAINNET_USDT, MAINNET_AUSDT, MAINNET_AAVE_V3_POOL, 0, owner);
+    }
+
+    function test_FirstDepositShouldWorkWithRealMainnetUsdtAndAave() public {
+        deal(MAINNET_USDT, alice, 1_000e6);
+
+        vm.prank(alice);
+        (bool ok,) = MAINNET_USDT.call(abi.encodeWithSignature("approve(address,uint256)", address(vault), 1_000e6));
+        assertTrue(ok, "alice approval setup failed");
+
+        vm.prank(alice);
+        uint256 shares = vault.deposit(1_000e6);
+
+        assertGt(shares, 0);
+        assertEq(IERC20(MAINNET_AUSDT).balanceOf(address(vault)), 1_000e6);
+    }
+}
+
+contract MintableSixDecimalToken is ERC20 {
+    constructor(string memory name_, string memory symbol_) ERC20(name_, symbol_) {}
+
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    function mint(address to, uint256 amount) external {
+        _mint(to, amount);
+    }
+
+    function burn(address from, uint256 amount) external {
+        _burn(from, amount);
+    }
+}
+
+contract YieldingAavePool is IAavePool {
+    MintableSixDecimalToken public immutable underlying;
+    MintableSixDecimalToken public immutable aToken;
+
+    constructor(MintableSixDecimalToken _underlying) {
+        underlying = _underlying;
+        aToken = new MintableSixDecimalToken("Aave Tether USD", "aUSDT");
+    }
+
+    function supply(address, uint256 amount, address onBehalfOf, uint16) external override {
+        underlying.transferFrom(msg.sender, address(this), amount);
+        aToken.mint(onBehalfOf, amount);
+    }
+
+    function withdraw(address, uint256 amount, address to) external override returns (uint256) {
+        aToken.burn(msg.sender, amount);
+        underlying.transfer(to, amount);
+        return amount;
+    }
+
+    function accrueYield(address account, uint256 amount) external {
+        underlying.mint(address(this), amount);
+        aToken.mint(account, amount);
+    }
+}
+
+contract UsdtYieldVaultAccountingFailureTest is Test {
+    UsdtYieldVault internal vault;
+    MintableSixDecimalToken internal usdt;
+    YieldingAavePool internal pool;
+    MintableSixDecimalToken internal aUsdt;
+
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+    address internal bob = makeAddr("bob");
+
+    function setUp() public {
+        usdt = new MintableSixDecimalToken("Tether USD", "USDT");
+        pool = new YieldingAavePool(usdt);
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 0, owner);
+
+        usdt.mint(alice, 10_000e6);
+        usdt.mint(bob, 10_000e6);
+
+        vm.prank(alice);
+        usdt.approve(address(vault), type(uint256).max);
+        vm.prank(bob);
+        usdt.approve(address(vault), type(uint256).max);
+    }
+
+    function test_TotalAssetsShouldIncludeAaveYield() public {
+        vm.prank(alice);
+        vault.deposit(1_000e6);
+
+        pool.accrueYield(address(vault), 100e6);
+
+        assertEq(aUsdt.balanceOf(address(vault)), 1_100e6, "sanity: aUSDT balance grew");
+        assertEq(vault.totalAssets(), 1_100e6, "vault ignores accrued Aave yield");
+    }
+
+    function test_FinalWithdrawShouldNotLeaveUnownedAUsdtFees() public {
+        vm.prank(alice);
+        uint256 shares = vault.deposit(1_000e6);
+
+        vm.prank(alice);
+        vault.withdraw(shares);
+
+        assertEq(vault.totalShares(), 0, "sanity: no shareholders remain");
+        assertEq(vault.totalAssets(), 0, "sanity: vault accounting was reset");
+        assertEq(aUsdt.balanceOf(address(vault)), 0, "withdrawal fee is stranded with no owner");
+    }
+}

