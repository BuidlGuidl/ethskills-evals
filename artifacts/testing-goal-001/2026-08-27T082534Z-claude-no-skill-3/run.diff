index 0000000..73353b5
--- /dev/null
+++ b/test/audit/Harness.sol
@@ -0,0 +1,184 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {ERC20} from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+
+import {IAavePool} from "../../src/interfaces/IAavePool.sol";
+
+/*//////////////////////////////////////////////////////////////
+        TOKENS — modelled on the deployed TetherToken code
+//////////////////////////////////////////////////////////////*/
+
+/// @notice Faithful stand-in for the deployed USDT at 0xdAC17F9...ec7.
+/// @dev The only behaviours that matter here, all copied from TetherToken:
+///      - approve / transfer / transferFrom return NOTHING (not `bool`)
+///      - approve reverts when overwriting a non-zero allowance with a non-zero one
+///      Used to reproduce the mainnet failure offline. The `test/mocks/MockUSDT.sol`
+///      used by the shipped suite is a plain OpenZeppelin ERC20 and therefore does
+///      return `bool`, which is why the suite cannot see this.
+contract UsdtLike {
+    string public constant name = "Tether USD";
+    string public constant symbol = "USDT";
+    uint8 public constant decimals = 6;
+
+    uint256 public totalSupply;
+    mapping(address => uint256) public balanceOf;
+    mapping(address => mapping(address => uint256)) public allowance;
+
+    function mint(address to, uint256 amount) external {
+        balanceOf[to] += amount;
+        totalSupply += amount;
+    }
+
+    // NOTE: no `returns (bool)` — this is the whole point.
+    function approve(address spender, uint256 value) external {
+        // TetherToken's anti-front-running guard.
+        require(!((value != 0) && (allowance[msg.sender][spender] != 0)), "unsafe approve");
+        allowance[msg.sender][spender] = value;
+    }
+
+    function transfer(address to, uint256 value) external {
+        balanceOf[msg.sender] -= value;
+        balanceOf[to] += value;
+    }
+
+    function transferFrom(address from, address to, uint256 value) external {
+        uint256 allowed = allowance[from][msg.sender];
+        if (allowed < type(uint256).max) allowance[from][msg.sender] = allowed - value;
+        balanceOf[from] -= value;
+        balanceOf[to] += value;
+    }
+}
+
+/// @notice A bool-returning USDT that can switch on TetherToken's transfer fee.
+/// @dev Used to test what happens *after* the raw-approve bug is fixed. Tether's
+///      `setParams` allows basisPointsRate up to 20 and maximumFee up to 50 USDT.
+contract FeeOnTransferUsdt is ERC20 {
+    uint256 public basisPointsRate;
+    uint256 public maximumFee;
+    address public feeCollector = address(0xFEE);
+
+    constructor() ERC20("Tether USD", "USDT") {}
+
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    function mint(address to, uint256 amount) external {
+        _mint(to, amount);
+    }
+
+    /// @dev Mirrors TetherToken.setParams bounds.
+    function setParams(uint256 newBasisPoints, uint256 newMaxFee) external {
+        require(newBasisPoints < 20, "bps too high");
+        require(newMaxFee < 50, "fee too high");
+        basisPointsRate = newBasisPoints;
+        maximumFee = newMaxFee * 10 ** 6;
+    }
+
+    function _update(address from, address to, uint256 value) internal override {
+        if (from == address(0) || to == address(0) || basisPointsRate == 0) {
+            super._update(from, to, value);
+            return;
+        }
+        uint256 fee = (value * basisPointsRate) / 10_000;
+        if (fee > maximumFee) fee = maximumFee;
+        if (fee > 0) super._update(from, feeCollector, fee);
+        super._update(from, to, value - fee);
+    }
+}
+
+/*//////////////////////////////////////////////////////////////
+                              POOL
+//////////////////////////////////////////////////////////////*/
+
+contract HarnessAToken is ERC20 {
+    address public immutable pool;
+
+    constructor(address _pool) ERC20("Aave Tether USD", "aUSDT") {
+        pool = _pool;
+    }
+
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    function mint(address to, uint256 amount) external {
+        require(msg.sender == pool, "only pool");
+        _mint(to, amount);
+    }
+
+    function burn(address from, uint256 amount) external {
+        require(msg.sender == pool, "only pool");
+        _burn(from, amount);
+    }
+}
+
+/// @notice Same shape as test/mocks/MockAavePool.sol, plus the two things a real
+///         money market does and the shipped mock does not: pay interest, and
+///         run out of liquidity.
+contract HarnessAavePool is IAavePool {
+    IERC20 public immutable underlying;
+    HarnessAToken public immutable aToken;
+
+    constructor(address _underlying) {
+        underlying = IERC20(_underlying);
+        aToken = new HarnessAToken(address(this));
+    }
+
+    function supply(address, uint256 amount, address onBehalfOf, uint16) external override {
+        underlying.transferFrom(msg.sender, address(this), amount);
+        aToken.mint(onBehalfOf, amount);
+    }
+
+    function withdraw(address, uint256 amount, address to) external override returns (uint256) {
+        aToken.burn(msg.sender, amount);
+        underlying.transfer(to, amount);
+        return amount;
+    }
+
+    /// @notice Credit `amount` of accrued interest to `holder`, exactly as Aave's
+    ///         rebasing aToken would. Caller must have funded the pool first.
+    function accrue(address holder, uint256 amount) external {
+        aToken.mint(holder, amount);
+    }
+
+    /// @notice Remove `amount` of underlying liquidity from the pool (borrowed out,
+    ///         or lost to a reserve deficit). aToken supply is unchanged.
+    function drainLiquidity(uint256 amount) external {
+        underlying.transfer(address(0xdead), amount);
+    }
+}
+
+/// @notice Aave pool that re-enters the vault from inside `withdraw`.
+/// @dev Used as a negative control for the ReentrancyGuard.
+contract ReenteringAavePool is IAavePool {
+    IERC20 public immutable underlying;
+    HarnessAToken public immutable aToken;
+    bool internal entered;
+
+    constructor(address _underlying) {
+        underlying = IERC20(_underlying);
+        aToken = new HarnessAToken(address(this));
+    }
+
+    function supply(address, uint256 amount, address onBehalfOf, uint16) external override {
+        underlying.transferFrom(msg.sender, address(this), amount);
+        aToken.mint(onBehalfOf, amount);
+    }
+
+    function withdraw(address, uint256 amount, address to) external override returns (uint256) {
+        if (!entered) {
+            entered = true;
+            IVaultWithdraw(msg.sender).withdraw(1e12); // re-enter
+        }
+        aToken.burn(msg.sender, amount);
+        underlying.transfer(to, amount);
+        return amount;
+    }
+}
+
+interface IVaultWithdraw {
+    function withdraw(uint256 shares) external returns (uint256);
+}
