@@ -0,0 +1,90 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console2} from "forge-std/Test.sol";
+
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+import {MockUSDT} from "../mocks/MockUSDT.sol";
+import {HarnessAavePool, HarnessAToken} from "./Harness.sol";
+
+/// @notice Drives the vault with random deposits, withdrawals and Aave interest.
+contract VaultHandler is Test {
+    UsdtYieldVault public immutable vault;
+    MockUSDT public immutable usdt;
+    HarnessAavePool public immutable pool;
+
+    address[3] public actors;
+
+    constructor(UsdtYieldVault _vault, MockUSDT _usdt, HarnessAavePool _pool, address[3] memory _actors) {
+        vault = _vault;
+        usdt = _usdt;
+        pool = _pool;
+        actors = _actors;
+    }
+
+    function _actor(uint256 seed) internal view returns (address) {
+        return actors[seed % actors.length];
+    }
+
+    function deposit(uint256 seed, uint256 amount) external {
+        address who = _actor(seed);
+        amount = bound(amount, 1e6, 100_000e6);
+        if (usdt.balanceOf(who) < amount) return;
+        vm.prank(who);
+        try vault.deposit(amount) {} catch {}
+    }
+
+    function withdraw(uint256 seed, uint256 sharesSeed) external {
+        address who = _actor(seed);
+        uint256 held = vault.shareBalance(who);
+        if (held == 0) return;
+        uint256 shares = bound(sharesSeed, 1, held);
+        vm.prank(who);
+        try vault.withdraw(shares) {} catch {}
+    }
+
+    /// @notice Aave pays interest on whatever the vault holds.
+    function accrueInterest(uint256 bps) external {
+        bps = bound(bps, 0, 500);
+        uint256 held = pool.aToken().balanceOf(address(vault));
+        uint256 interest = (held * bps) / 10_000;
+        if (interest == 0) return;
+        usdt.mint(address(pool), interest);
+        pool.accrue(address(vault), interest);
+    }
+}
+
+contract VaultInvariantTest is Test {
+    UsdtYieldVault internal vault;
+    MockUSDT internal usdt;
+    HarnessAavePool internal pool;
+    HarnessAToken internal aUsdt;
+    VaultHandler internal handler;
+
+    address internal owner = makeAddr("owner");
+
+    function setUp() public {
+        usdt = new MockUSDT();
+        pool = new HarnessAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 10, owner);
+
+        address[3] memory actors = [makeAddr("a1"), makeAddr("a2"), makeAddr("a3")];
+        for (uint256 i = 0; i < actors.length; i++) {
+            usdt.mint(actors[i], 1_000_000e6);
+            vm.prank(actors[i]);
+            usdt.approve(address(vault), type(uint256).max);
+        }
+
+        handler = new VaultHandler(vault, usdt, pool, actors);
+        targetContract(address(handler));
+    }
+
+    /// @notice The vault's idea of what it owns must equal what it actually owns.
+    ///         Anything above the line is value no function in src/ can ever move.
+    function invariant_NoValueIsStrandedInTheVault() public view {
+        uint256 real = aUsdt.balanceOf(address(vault));
+        uint256 tracked = vault.totalAssets();
+        assertEq(tracked, real, "vault holds aUSDT that its accounting has written off");
+    }
+}
diff --git a/test/fork/MainnetFork.t.sol b/test/fork/MainnetFork.t.sol
new file mode 100644
index 0000000..81fbd59
--- /dev/null
+++ b/test/fork/MainnetFork.t.sol
@@ -0,0 +1,135 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console2} from "forge-std/Test.sol";
+import {stdStorage, StdStorage} from "forge-std/Test.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+import {IAavePool} from "../../src/interfaces/IAavePool.sol";
+
+/// @dev Real USDT's ABI: approve/transfer/transferFrom return NOTHING.
+interface IUsdtLike {
+    function approve(address spender, uint256 value) external;
+    function transfer(address to, uint256 value) external;
+    function balanceOf(address) external view returns (uint256);
+    function allowance(address, address) external view returns (uint256);
+    function basisPointsRate() external view returns (uint256);
+    function maximumFee() external view returns (uint256);
+}
+
+/// @notice The vault deployed against the exact mainnet addresses from README.md.
+contract MainnetForkTest is Test {
+    using stdStorage for StdStorage;
+
+    address internal constant USDT = 0xdAC17F958D2ee523a2206206994597C13D831ec7;
+    address internal constant AUSDT = 0x23878914EFE38d27C4D67Ab83ed1b93A74D4086a;
+    address internal constant AAVE_POOL = 0x87870Bca3F3fD6335C3F4ce8392D69350B4fA4E2;
+
+    uint256 internal constant FORK_BLOCK = 21_000_000;
+
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+
+    UsdtYieldVault internal vault;
+
+    function setUp() public {
+        // Any archive RPC works; override with MAINNET_RPC_URL if you prefer your own.
+        vm.createSelectFork(vm.envOr("MAINNET_RPC_URL", string("https://eth.drpc.org")), FORK_BLOCK);
+        vault = new UsdtYieldVault(USDT, AUSDT, AAVE_POOL, 10, owner);
+    }
+
+    /*//////////////////////////////////////////////////////////////
+       Root cause, isolated: real USDT returns no data from approve()
+    //////////////////////////////////////////////////////////////*/
+
+    function test_Fork_RealUsdtApproveReturnsNoData() public {
+        vm.prank(address(vault));
+        (bool ok, bytes memory ret) =
+            USDT.call(abi.encodeWithSignature("approve(address,uint256)", AAVE_POOL, uint256(1_000e6)));
+
+        assertTrue(ok, "the approve itself succeeds on-chain");
+        console2.log("returndata length from USDT.approve:", ret.length);
+
+        // UsdtYieldVault.sol:94 calls this through IERC20, so solc appends an
+        // `abi.decode(returndata, (bool))` which needs >= 32 bytes.
+        assertEq(ret.length, 32, "IERC20.approve on real USDT cannot be decoded as bool");
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        deposit() against the real token + the real Aave V3 pool
+    //////////////////////////////////////////////////////////////*/
+
+    function test_Fork_DepositSucceedsAgainstRealUsdt() public {
+        deal(USDT, alice, 10_000e6);
+        vm.prank(alice);
+        IUsdtLike(USDT).approve(address(vault), type(uint256).max);
+
+        assertEq(IUsdtLike(USDT).balanceOf(alice), 10_000e6, "sanity: alice funded");
+
+        vm.prank(alice);
+        vault.deposit(1_000e6);
+    }
+
+    /// @notice Proves the pool is not the problem: the identical supply() call
+    ///         works once the approve is done without decoding a return value.
+    function test_Fork_AaveAcceptsTheSupplyWhenApproveIsDoneCorrectly() public {
+        deal(USDT, address(vault), 1_000_000e6);
+
+        vm.startPrank(address(vault));
+        IUsdtLike(USDT).approve(AAVE_POOL, 1_000_000e6); // no bool decoded -> fine
+        IAavePool(AAVE_POOL).supply(USDT, 1_000_000e6, address(vault), 0);
+        vm.stopPrank();
+
+        assertApproxEqAbs(IERC20(AUSDT).balanceOf(address(vault)), 1_000_000e6, 1e6, "Aave took the supply");
+    }
+
+    /*//////////////////////////////////////////////////////////////
+       Real Aave interest vs. the vault's internal asset counter
+    //////////////////////////////////////////////////////////////*/
+
+    function test_Fork_DepositorEarnsRealAaveInterest() public {
+        // Put the vault in the exact state a successful 1,000,000 USDT deposit
+        // (0 bps fee) would have left it in, then let a year of real Aave
+        // interest accrue on the real aUSDT.
+        deal(USDT, address(vault), 1_000_000e6);
+        vm.startPrank(address(vault));
+        IUsdtLike(USDT).approve(AAVE_POOL, 1_000_000e6);
+        IAavePool(AAVE_POOL).supply(USDT, 1_000_000e6, address(vault), 0);
+        vm.stopPrank();
+
+        stdstore.target(address(vault)).sig("totalShares()").checked_write(uint256(1_000_000e18));
+        stdstore.target(address(vault)).sig("totalAssetsStored()").checked_write(uint256(1_000_000e6));
+        stdstore.target(address(vault)).sig("shareBalance(address)").with_key(alice).checked_write(
+            uint256(1_000_000e18)
+        );
+
+        uint256 aUsdtBefore = IERC20(AUSDT).balanceOf(address(vault));
+        uint256 claimBefore = vault.balanceOfUnderlying(alice);
+
+        vm.warp(block.timestamp + 365 days);
+
+        uint256 aUsdtAfter = IERC20(AUSDT).balanceOf(address(vault));
+        uint256 claimAfter = vault.balanceOfUnderlying(alice);
+
+        console2.log("aUSDT held by vault, t0      :", aUsdtBefore);
+        console2.log("aUSDT held by vault, t0+365d :", aUsdtAfter);
+        console2.log("interest earned from Aave    :", aUsdtAfter - aUsdtBefore);
+        console2.log("alice claimable, t0          :", claimBefore);
+        console2.log("alice claimable, t0+365d     :", claimAfter);
+        console2.log("vault.sharePrice()           :", vault.sharePrice());
+
+        assertGt(aUsdtAfter, aUsdtBefore, "sanity: real Aave paid interest");
+        assertEq(claimAfter - claimBefore, aUsdtAfter - aUsdtBefore, "none of the Aave interest reaches the depositor");
+    }
+
+    /*//////////////////////////////////////////////////////////////
+                      Tether transfer-fee switch state
+    //////////////////////////////////////////////////////////////*/
+
+    function test_Fork_TetherFeeParamsAreCurrentlyZero() public view {
+        console2.log("USDT.basisPointsRate :", IUsdtLike(USDT).basisPointsRate());
+        console2.log("USDT.maximumFee      :", IUsdtLike(USDT).maximumFee());
+        assertEq(IUsdtLike(USDT).basisPointsRate(), 0);
+    }
+}

