+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test} from "forge-std/Test.sol";
+import {ReentrancyGuard} from "@openzeppelin/contracts/utils/ReentrancyGuard.sol";
+
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+import {MockUSDT} from "../mocks/MockUSDT.sol";
+import {HarnessAavePool, HarnessAToken, ReenteringAavePool} from "./Harness.sol";
+
+/// @notice Attacks that were checked and do NOT work. These all pass; they are
+///         here so the things I am *not* flagging are also on the record.
+contract ControlsTest is Test {
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+    address internal attacker = makeAddr("attacker");
+
+    /// @notice The classic ERC-4626 first-depositor / donation inflation attack does
+    ///         not apply: totalAssets() is an internal counter, so donated USDT or
+    ///         donated aUSDT cannot move the share price.
+    function test_Control_DonationCannotMoveSharePrice() public {
+        MockUSDT usdt = new MockUSDT();
+        HarnessAavePool pool = new HarnessAavePool(address(usdt));
+        UsdtYieldVault vault =
+            new UsdtYieldVault(address(usdt), address(pool.aToken()), address(pool), 0, owner);
+
+        usdt.mint(alice, 10_000e6);
+        vm.startPrank(alice);
+        usdt.approve(address(vault), type(uint256).max);
+        vault.deposit(1_000e6);
+        vm.stopPrank();
+
+        uint256 priceBefore = vault.sharePrice();
+
+        usdt.mint(address(vault), 1_000_000e6); // donate underlying
+        usdt.mint(address(pool), 1_000_000e6);
+        pool.accrue(address(vault), 1_000_000e6); // donate aUSDT
+
+        assertEq(vault.sharePrice(), priceBefore, "share price is immune to donations");
+    }
+
+    /// @notice The vault is always over-collateralised: its aUSDT balance is never
+    ///         below what its accounting says it owes. The bugs in FINDINGS.md leak
+    ///         value *upward*, so they do not create a shortfall by themselves.
+    function test_Control_VaultIsNeverUnderCollateralised() public {
+        MockUSDT usdt = new MockUSDT();
+        HarnessAavePool pool = new HarnessAavePool(address(usdt));
+        HarnessAToken aUsdt = pool.aToken();
+        UsdtYieldVault vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 10, owner);
+
+        usdt.mint(alice, 10_000e6);
+        vm.startPrank(alice);
+        usdt.approve(address(vault), type(uint256).max);
+        vault.deposit(5_000e6);
+        vault.withdraw(vault.shareBalance(alice) / 3);
+        vault.deposit(1_000e6);
+        vault.withdraw(vault.shareBalance(alice) / 7);
+        vm.stopPrank();
+
+        assertGe(aUsdt.balanceOf(address(vault)), vault.totalAssets(), "aUSDT covers tracked assets");
+    }
+
+    /// @notice ReentrancyGuard holds: a malicious/compromised pool cannot re-enter
+    ///         withdraw() to drain. State is also written before the external call.
+    function test_Control_ReentrancyIsBlocked() public {
+        MockUSDT usdt = new MockUSDT();
+        ReenteringAavePool pool = new ReenteringAavePool(address(usdt));
+        UsdtYieldVault vault =
+            new UsdtYieldVault(address(usdt), address(pool.aToken()), address(pool), 0, owner);
+
+        usdt.mint(alice, 10_000e6);
+        vm.startPrank(alice);
+        usdt.approve(address(vault), type(uint256).max);
+        uint256 shares = vault.deposit(1_000e6);
+
+        vm.expectRevert(ReentrancyGuard.ReentrancyGuardReentrantCall.selector);
+        vault.withdraw(shares);
+        vm.stopPrank();
+    }
+}
