@@ -0,0 +1,286 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console2} from "forge-std/Test.sol";
+
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+import {MockUSDT} from "../mocks/MockUSDT.sol";
+import {UsdtLike, FeeOnTransferUsdt, HarnessAavePool, HarnessAToken} from "./Harness.sol";
+
+/// @notice Each test below asserts a property the vault MUST hold to be safe to
+///         ship. Every failure is a finding. Nothing under src/ is modified.
+contract VaultAuditTest is Test {
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+    address internal bob = makeAddr("bob");
+
+    MockUSDT internal usdt;
+    HarnessAavePool internal pool;
+    HarnessAToken internal aUsdt;
+    UsdtYieldVault internal vault;
+
+    /// @dev Standard rig: OZ-style USDT (so the vault actually runs) + an Aave pool
+    ///      that can pay interest and can run short of liquidity.
+    function _deploy(uint256 depositFeeBps) internal {
+        usdt = new MockUSDT();
+        pool = new HarnessAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), depositFeeBps, owner);
+
+        address[3] memory users = [alice, bob, owner];
+        for (uint256 i = 0; i < users.length; i++) {
+            usdt.mint(users[i], 1_000_000e6);
+            vm.prank(users[i]);
+            usdt.approve(address(vault), type(uint256).max);
+        }
+    }
+
+    function _deposit(address who, uint256 amount) internal returns (uint256) {
+        vm.prank(who);
+        return vault.deposit(amount);
+    }
+
+    function _withdrawAll(address who) internal returns (uint256) {
+        uint256 shares = vault.shareBalance(who);
+        vm.prank(who);
+        return vault.withdraw(shares);
+    }
+
+    /*//////////////////////////////////////////////////////////////
+      F-01  deposit() against a token with real USDT return semantics
+    //////////////////////////////////////////////////////////////*/
+
+    function test_F01_DepositWorksAgainstRealUsdtReturnSemantics() public {
+        UsdtLike realUsdt = new UsdtLike();
+        HarnessAavePool p = new HarnessAavePool(address(realUsdt));
+        UsdtYieldVault v =
+            new UsdtYieldVault(address(realUsdt), address(p.aToken()), address(p), 10, owner);
+
+        realUsdt.mint(alice, 100_000e6);
+        vm.prank(alice);
+        realUsdt.approve(address(v), type(uint256).max);
+
+        // The vault pulls the USDT fine (SafeERC20 tolerates the empty return),
+        // then dies on the raw `usdt.approve(...)` at UsdtYieldVault.sol:94.
+        vm.prank(alice);
+        v.deposit(1_000e6);
+    }
+
+    /*//////////////////////////////////////////////////////////////
+      F-02  Aave interest must reach depositors
+    //////////////////////////////////////////////////////////////*/
+
+    function test_F02_TotalAssetsTracksTheAaveBalance() public {
+        _deploy(0);
+        _deposit(alice, 1_000e6);
+
+        // Aave pays 5% interest: the vault's aUSDT rebases up to 1050 USDT.
+        usdt.mint(address(pool), 50e6);
+        pool.accrue(address(vault), 50e6);
+
+        assertEq(aUsdt.balanceOf(address(vault)), 1_050e6, "sanity: vault really holds 1050 aUSDT");
+        assertEq(vault.totalAssets(), 1_050e6, "totalAssets() ignores accrued Aave interest");
+    }
+
+    function test_F02_DepositorEarnsTheYield() public {
+        _deploy(0);
+        _deposit(alice, 1_000e6);
+
+        usdt.mint(address(pool), 50e6);
+        pool.accrue(address(vault), 50e6);
+
+        uint256 before = usdt.balanceOf(alice);
+        _withdrawAll(alice);
+        uint256 received = usdt.balanceOf(alice) - before;
+
+        console2.log("alice deposited     :", uint256(1_000e6));
+        console2.log("vault aUSDT at exit :", uint256(1_050e6));
+        console2.log("alice received      :", received);
+
+        // 1050 USDT minus the documented 30bps withdrawal fee = 1046.85 USDT.
+        assertApproxEqAbs(received, 1_046_850_000, 1e6, "depositor got none of the Aave yield");
+    }
+
+    function test_F02_NoValueIsStrandedAfterEveryoneExits() public {
+        _deploy(0);
+        _deposit(alice, 1_000e6);
+        usdt.mint(address(pool), 50e6);
+        pool.accrue(address(vault), 50e6);
+        _withdrawAll(alice);
+
+        assertEq(vault.totalShares(), 0, "sanity: everyone is out");
+        assertEq(aUsdt.balanceOf(address(vault)), 0, "value left in the vault that no function can move");
+    }
+
+    /*//////////////////////////////////////////////////////////////
+      F-03  the withdrawal fee must accrue to remaining shareholders
+    //////////////////////////////////////////////////////////////*/
+
+    function test_F03_WithdrawFeeAccruesToRemainingShareholders() public {
+        _deploy(0);
+        _deposit(alice, 1_000e6);
+        _deposit(bob, 1_000e6);
+
+        assertEq(vault.balanceOfUnderlying(bob), 1_000e6, "sanity: bob starts at 1000 USDT");
+
+        _withdrawAll(alice); // pays a 30bps = 3 USDT withdrawal fee
+
+        // README: "Both fees stay supplied in Aave and accrue to the remaining
+        // shareholders". Bob is the only remaining shareholder.
+        assertEq(vault.balanceOfUnderlying(bob), 1_003e6, "withdrawal fee never reaches remaining shareholders");
+    }
+
+    /*//////////////////////////////////////////////////////////////
+      F-04  the deposit fee must actually be charged
+    //////////////////////////////////////////////////////////////*/
+
+    function test_F04_DepositFeeIsActuallyCharged() public {
+        _deploy(10); // 10 bps, the value the shipped suite uses
+        _deposit(alice, 1_000e6);
+
+        // 10bps of 1000 USDT = 1 USDT. Alice should be able to claim 999, not 1000.
+        assertEq(vault.balanceOfUnderlying(alice), 999e6, "sole depositor is refunded the deposit fee");
+    }
+
+    /*//////////////////////////////////////////////////////////////
+      F-05  the owner must not be able to take a user's deposit
+    //////////////////////////////////////////////////////////////*/
+
+    function test_F05_OwnerCannotConfiscateAnInFlightDeposit() public {
+        _deploy(0);
+        _deposit(owner, 1_000e6);
+
+        uint256 ownerBefore = vault.balanceOfUnderlying(owner);
+
+        // Owner sees alice's deposit in the mempool and front-runs it.
+        vm.prank(owner);
+        vault.setDepositFee(9_999);
+
+        _deposit(alice, 1_000e6);
+
+        console2.log("alice deposited            :", uint256(1_000e6));
+        console2.log("alice claimable after      :", vault.balanceOfUnderlying(alice));
+        console2.log("owner claimable gain       :", vault.balanceOfUnderlying(owner) - ownerBefore);
+
+        assertApproxEqAbs(vault.balanceOfUnderlying(alice), 1_000e6, 1e6, "owner captured alice's deposit");
+    }
+
+    function test_F05_DepositFeeIsBounded() public {
+        _deploy(0);
+        vm.prank(owner);
+        vm.expectRevert(); // any bound check would do
+        vault.setDepositFee(20_000); // 200%
+    }
+
+    function test_F05_AbsurdFeeDoesNotBrickDeposits() public {
+        _deploy(0);
+        vm.prank(owner);
+        vault.setDepositFee(20_000);
+
+        vm.prank(alice);
+        vault.deposit(1_000e6); // reverts: `amount - fee` underflows
+    }
+
+    /*//////////////////////////////////////////////////////////////
+      F-06  pausing must not trap user funds
+    //////////////////////////////////////////////////////////////*/
+
+    function test_F06_UsersCanExitWhilePaused() public {
+        _deploy(0);
+        _deposit(alice, 1_000e6);
+
+        vm.prank(owner);
+        vault.pause();
+
+        _withdrawAll(alice); // reverts: EnforcedPause
+    }
+
+    function test_F06_PauseCannotBecomePermanent() public {
+        _deploy(0);
+        _deposit(alice, 1_000e6);
+
+        vm.startPrank(owner);
+        vault.pause();
+        vault.renounceOwnership(); // inherited from Ownable, never overridden
+        vm.stopPrank();
+
+        // No owner left, so nothing can ever unpause, so nothing can ever withdraw.
+        vm.prank(owner);
+        vault.unpause();
+    }
+
+    /*//////////////////////////////////////////////////////////////
+      F-07  a shortfall in Aave must be shared, not first-come-first-served
+    //////////////////////////////////////////////////////////////*/
+
+    function test_F07_ShortfallIsSharedNotFirstComeFirstServed() public {
+        _deploy(0);
+        _deposit(alice, 1_000e6);
+        _deposit(bob, 1_000e6);
+
+        // Aave reserve is 25% short (borrowed out / bad debt / paused reserve).
+        pool.drainLiquidity(500e6);
+
+        uint256 aliceGot = _withdrawAll(alice);
+
+        uint256 bobShares = vault.shareBalance(bob);
+        uint256 bobGot;
+        vm.prank(bob);
+        try vault.withdraw(bobShares) returns (uint256 got) {
+            bobGot = got;
+        } catch {
+            bobGot = 0;
+        }
+
+        console2.log("liquidity available :", uint256(1_500e6));
+        console2.log("alice received      :", aliceGot);
+        console2.log("bob received        :", bobGot);
+
+        assertGt(bobGot, 0, "second withdrawer is left with nothing");
+        assertApproxEqAbs(aliceGot, bobGot, 1e6, "loss is not socialised across shareholders");
+    }
+
+    /*//////////////////////////////////////////////////////////////
+      F-08  withdraw() must not burn shares for a zero payout
+    //////////////////////////////////////////////////////////////*/
+
+    function test_F08_WithdrawNeverBurnsSharesForNothing() public {
+        _deploy(0);
+        uint256 shares = _deposit(alice, 1_000e6);
+
+        uint256 dust = 1e11; // worth 0.0000001 USDT — rounds to zero base units
+        vm.prank(alice);
+        uint256 netAssets = vault.withdraw(dust);
+
+        assertEq(vault.shareBalance(alice), shares - dust, "sanity: the shares are gone");
+        assertGt(netAssets, 0, "shares burned, zero USDT returned");
+    }
+
+    /*//////////////////////////////////////////////////////////////
+      F-09  Tether's transfer fee switch must not break the vault
+    //////////////////////////////////////////////////////////////*/
+
+    function test_F09_SurvivesTetherEnablingItsTransferFee() public {
+        FeeOnTransferUsdt t = new FeeOnTransferUsdt();
+        HarnessAavePool p = new HarnessAavePool(address(t));
+        UsdtYieldVault v = new UsdtYieldVault(address(t), address(p.aToken()), address(p), 0, owner);
+
+        t.mint(alice, 100_000e6);
+        vm.prank(alice);
+        t.approve(address(v), type(uint256).max);
+
+        t.setParams(10, 49); // Tether turns on a 10bps fee, capped at 49 USDT
+
+        vm.prank(alice);
+        v.deposit(1_000e6); // reverts: vault received 999, tries to supply 1000
+    }
+
+    /*//////////////////////////////////////////////////////////////
+      F-10  constructor must validate its addresses
+    //////////////////////////////////////////////////////////////*/
+
+    function test_F10_ConstructorRejectsZeroAddresses() public {
+        vm.expectRevert();
+        new UsdtYieldVault(address(0), address(0), address(0), 0, owner);
+    }
+}
diff --git a/test/audit/VaultInvariant.t.sol b/test/audit/VaultInvariant.t.sol
new file mode 100644
index 0000000..a36fcfe
