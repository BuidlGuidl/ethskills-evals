--- /dev/null
+++ b/test/invariant/FeeDriftRegression.t.sol
@@ -0,0 +1,102 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console2} from "forge-std/Test.sol";
+
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+import {MockUSDT} from "../mocks/MockUSDT.sol";
+import {MockAavePool, MockAToken} from "../mocks/MockAavePool.sol";
+
+/// @notice Deterministic reproduction of the drift the invariant run found, showing it
+///         grows across successive fee-bearing withdrawals rather than being a one-off.
+contract FeeDriftRegressionTest is Test {
+    UsdtYieldVault internal vault;
+    MockUSDT internal usdt;
+    MockAavePool internal pool;
+    MockAToken internal aUsdt;
+
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+    address internal bob = makeAddr("bob");
+
+    function setUp() public {
+        usdt = new MockUSDT();
+        pool = new MockAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 0, owner);
+
+        usdt.mint(alice, 1_000_000e6);
+        usdt.mint(bob, 1_000_000e6);
+        vm.prank(alice);
+        usdt.approve(address(vault), type(uint256).max);
+        vm.prank(bob);
+        usdt.approve(address(vault), type(uint256).max);
+    }
+
+    function _gap() internal view returns (uint256) {
+        return aUsdt.balanceOf(address(vault)) - vault.totalAssetsStored();
+    }
+
+    function test_DriftAccumulatesAcrossWithdrawals() public {
+        vm.prank(alice);
+        vault.deposit(100_000e6);
+        vm.prank(bob);
+        vault.deposit(100_000e6);
+
+        console2.log("gap after deposits           ", _gap());
+        assertEq(_gap(), 0);
+
+        vm.startPrank(alice);
+        uint256 g0;
+        for (uint256 i = 0; i < 4; i++) {
+            vault.withdraw(vault.shareBalance(alice) / 4);
+            uint256 g = _gap();
+            console2.log("gap after withdrawal", i + 1, g);
+            assertGt(g, g0, "gap did not grow");
+            g0 = g;
+        }
+        vm.stopPrank();
+
+        assertEq(_gap(), 0, "value stranded in Aave that no share can claim");
+    }
+
+    /// @dev The documented behaviour is that the withdrawal fee "stays supplied in Aave and
+    ///      accrues to the remaining shareholders". Test that claim directly.
+    function test_WithdrawFeeDoesNotAccrueToRemainingShareholders() public {
+        vm.prank(alice);
+        vault.deposit(100_000e6);
+        vm.prank(bob);
+        vault.deposit(100_000e6);
+
+        uint256 bobBefore = vault.balanceOfUnderlying(bob);
+
+        uint256 aliceShares = vault.shareBalance(alice);
+        vm.prank(alice);
+        vault.withdraw(aliceShares);
+
+        uint256 bobAfter = vault.balanceOfUnderlying(bob);
+        console2.log("bob redeemable before alice's exit", bobBefore);
+        console2.log("bob redeemable after  alice's exit", bobAfter);
+        console2.log("withdraw fee alice paid           ", uint256(100_000e6) * 30 / 10_000);
+
+        assertGt(bobAfter, bobBefore, "withdrawal fee did not accrue to the remaining shareholder");
+    }
+
+    /// @dev Once the last shareholder exits, the accumulated fees are unreachable forever:
+    ///      totalShares is zero, so the next depositor starts from a fresh price and the
+    ///      stranded aUSDT belongs to nobody.
+    function test_FeesArePermanentlyStrandedAfterLastExit() public {
+        vm.prank(alice);
+        vault.deposit(100_000e6);
+
+        uint256 aliceShares = vault.shareBalance(alice);
+        vm.prank(alice);
+        vault.withdraw(aliceShares);
+
+        console2.log("totalShares            ", vault.totalShares());
+        console2.log("totalAssetsStored      ", vault.totalAssetsStored());
+        console2.log("aUSDT still held       ", aUsdt.balanceOf(address(vault)));
+
+        assertEq(aUsdt.balanceOf(address(vault)), 0, "aUSDT stranded in Aave with zero shares outstanding");
+    }
+}
