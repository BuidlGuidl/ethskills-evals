@@ -0,0 +1,117 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, stdError} from "forge-std/Test.sol";
+
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+import {MockUSDT} from "../mocks/MockUSDT.sol";
+import {MockAavePool, MockAToken} from "../mocks/MockAavePool.sol";
+
+/// @notice Fuzzes `depositFeeBps` across its whole accepted domain.
+///         `setDepositFee` has no upper bound, so the domain is [0, 2**256-1].
+contract DepositFeeFuzzTest is Test {
+    UsdtYieldVault internal vault;
+    MockUSDT internal usdt;
+    MockAavePool internal pool;
+    MockAToken internal aUsdt;
+
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+    address internal bob = makeAddr("bob");
+
+    function setUp() public {
+        usdt = new MockUSDT();
+        pool = new MockAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 10, owner);
+
+        usdt.mint(alice, 1_000_000e6);
+        usdt.mint(bob, 1_000_000e6);
+        vm.prank(alice);
+        usdt.approve(address(vault), type(uint256).max);
+        vm.prank(bob);
+        usdt.approve(address(vault), type(uint256).max);
+    }
+
+    /// @dev Property: any fee the owner is allowed to set must leave the vault usable.
+    ///      A deposit of 1,000 USDT at an accepted fee must mint shares.
+    function testFuzz_AnyAcceptedFeeLeavesDepositUsable(uint256 feeBps) public {
+        feeBps = bound(feeBps, 0, 20_000);
+
+        vm.prank(owner);
+        vault.setDepositFee(feeBps);
+
+        vm.prank(alice);
+        uint256 shares = vault.deposit(1_000e6);
+        assertGt(shares, 0, "deposit minted no shares");
+    }
+
+    /// @dev Property: a depositor must retain the overwhelming majority of what they paid in.
+    ///      Bob seeds the vault first so the fee is actually redistributed rather than
+    ///      returning to a sole shareholder.
+    function testFuzz_DepositorRetainsValue(uint256 feeBps) public {
+        feeBps = bound(feeBps, 0, 9_999);
+
+        vm.prank(bob);
+        vault.deposit(1_000e6);
+
+        vm.prank(owner);
+        vault.setDepositFee(feeBps);
+
+        vm.prank(alice);
+        vault.deposit(1_000e6);
+
+        uint256 redeemable = vault.balanceOfUnderlying(alice);
+        // A sane vault caps fees in the low single-digit percent. Assert 5%.
+        assertGe(redeemable, 950e6, "depositor lost more than 5% of principal to the deposit fee");
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        Boundary at BPS_DENOMINATOR, classified separately.
+    //////////////////////////////////////////////////////////////*/
+
+    /// @dev Nearest valid value below the limit: accepted, and confiscates 99.99%.
+    function test_Boundary_Fee9999_ConfiscatesDeposit() public {
+        vm.prank(bob);
+        vault.deposit(1_000e6);
+
+        vm.prank(owner);
+        vault.setDepositFee(9_999);
+
+        vm.prank(alice);
+        vault.deposit(1_000e6);
+
+        emit log_named_uint("alice paid in (USDT)      ", 1_000e6);
+        emit log_named_uint("alice redeemable (USDT)   ", vault.balanceOfUnderlying(alice));
+        emit log_named_uint("bob redeemable (USDT)     ", vault.balanceOfUnderlying(bob));
+        assertGe(vault.balanceOfUnderlying(alice), 950e6, "99.99% deposit fee accepted");
+    }
+
+    /// @dev The exact limit: accepted by setDepositFee, bricks deposit via NoSharesMinted.
+    function test_Boundary_Fee10000_BricksDeposits() public {
+        vm.prank(owner);
+        vault.setDepositFee(10_000);
+
+        vm.prank(alice);
+        vm.expectRevert(UsdtYieldVault.NoSharesMinted.selector);
+        vault.deposit(1_000e6);
+    }
+
+    /// @dev First value beyond the limit: accepted by setDepositFee, bricks deposit via
+    ///      arithmetic underflow (panic 0x11) -- a different path from the exact limit.
+    function test_Boundary_Fee10001_BricksDepositsByUnderflow() public {
+        vm.prank(owner);
+        vault.setDepositFee(10_001);
+
+        vm.prank(alice);
+        vm.expectRevert(stdError.arithmeticError);
+        vault.deposit(1_000e6);
+    }
+
+    /// @dev setDepositFee accepts a fee of 2**256-1 without reverting.
+    function test_SetDepositFeeAcceptsMaxUint() public {
+        vm.prank(owner);
+        vault.setDepositFee(type(uint256).max);
+        assertEq(vault.depositFeeBps(), type(uint256).max);
+    }
+}
diff --git a/test/invariant/FeeDriftRegression.t.sol b/test/invariant/FeeDriftRegression.t.sol
