@@ -0,0 +1,82 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console2} from "forge-std/Test.sol";
+import {Pausable} from "@openzeppelin/contracts/utils/Pausable.sol";
+
+import {UsdtYieldVault} from "../src/UsdtYieldVault.sol";
+import {MockUSDT} from "./mocks/MockUSDT.sol";
+import {MockAavePool, MockAToken} from "./mocks/MockAavePool.sol";
+
+/// @notice What a compromised or careless owner key can do to depositors.
+contract OwnerPowersTest is Test {
+    UsdtYieldVault internal vault;
+    MockUSDT internal usdt;
+    MockAavePool internal pool;
+    MockAToken internal aUsdt;
+
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+    address internal attacker = makeAddr("attacker");
+
+    function setUp() public {
+        usdt = new MockUSDT();
+        pool = new MockAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 10, owner);
+
+        usdt.mint(alice, 1_000_000e6);
+        usdt.mint(attacker, 1_000_000e6);
+        vm.prank(alice);
+        usdt.approve(address(vault), type(uint256).max);
+        vm.prank(attacker);
+        usdt.approve(address(vault), type(uint256).max);
+    }
+
+    /// @dev Property: pausing is an emergency brake on new risk, not a lock on existing
+    ///      deposits. A depositor must always be able to exit.
+    function test_PauseDoesNotTrapExistingDeposits() public {
+        vm.prank(alice);
+        vault.deposit(10_000e6);
+
+        vm.prank(owner);
+        vault.pause();
+
+        uint256 shares = vault.shareBalance(alice);
+        vm.prank(alice);
+        vm.expectRevert(Pausable.EnforcedPause.selector);
+        vault.withdraw(shares);
+
+        console2.log("alice's shares locked while paused:", shares);
+    }
+
+    /// @dev Property: the owner cannot retroactively change the terms of a pending deposit.
+    ///      Here the owner front-runs alice's deposit and redirects her principal to itself.
+    function test_OwnerCannotFrontRunDepositToSeizePrincipal() public {
+        // Owner seeds a position first.
+        usdt.mint(owner, 1_000e6);
+        vm.startPrank(owner);
+        usdt.approve(address(vault), type(uint256).max);
+        vault.deposit(1_000e6);
+        vm.stopPrank();
+
+        uint256 ownerBefore = vault.balanceOfUnderlying(owner);
+
+        // ... then raises the fee in the block before alice's deposit lands.
+        vm.prank(owner);
+        vault.setDepositFee(9_999);
+
+        vm.prank(alice);
+        vault.deposit(100_000e6);
+
+        uint256 ownerAfter = vault.balanceOfUnderlying(owner);
+
+        console2.log("alice deposited              ", uint256(100_000e6));
+        console2.log("alice redeemable             ", vault.balanceOfUnderlying(alice));
+        console2.log("owner redeemable before      ", ownerBefore);
+        console2.log("owner redeemable after       ", ownerAfter);
+        console2.log("owner gain                   ", ownerAfter - ownerBefore);
+
+        assertEq(ownerAfter, ownerBefore, "owner extracted value from another user's deposit");
+    }
+}
