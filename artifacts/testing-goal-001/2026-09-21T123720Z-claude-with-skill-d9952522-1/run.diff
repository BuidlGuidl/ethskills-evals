+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console2} from "forge-std/Test.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+
+/// @dev Real USDT's approve/transfer return no value, so it cannot be reached
+///      through a bool-returning IERC20 interface.
+interface IUsdtLike {
+    function approve(address spender, uint256 amount) external;
+    function balanceOf(address account) external view returns (uint256);
+    function allowance(address owner, address spender) external view returns (uint256);
+}
+
+/// @notice Exercises the vault against the real mainnet deployments it will use on Monday,
+///         at a pinned block. No mocks.
+contract UsdtRealTokenForkTest is Test {
+    address internal constant USDT = 0xdAC17F958D2ee523a2206206994597C13D831ec7;
+    address internal constant A_USDT = 0x23878914EFE38d27C4D67Ab83ed1b93A74D4086a;
+    address internal constant AAVE_POOL = 0x87870Bca3F3fD6335C3F4ce8392D69350B4fA4E2;
+
+    uint256 internal constant FORK_BLOCK = 19_000_000;
+
+    UsdtYieldVault internal vault;
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+
+    function setUp() public {
+        vm.createSelectFork(vm.envOr("MAINNET_RPC_URL", string("https://eth.drpc.org")), FORK_BLOCK);
+
+        vault = new UsdtYieldVault(USDT, A_USDT, AAVE_POOL, 10, owner);
+
+        deal(USDT, alice, 100_000e6);
+        vm.prank(alice);
+        IUsdtLike(USDT).approve(address(vault), type(uint256).max);
+    }
+
+    /// @dev Sanity: we really are on mainnet, against the real token and the real pool.
+    function test_ForkIsRealMainnet() public view {
+        assertEq(block.number, FORK_BLOCK);
+        assertEq(IUsdtLike(USDT).balanceOf(alice), 100_000e6);
+        assertGt(IERC20(A_USDT).totalSupply(), 0, "aUSDT has no supply -- wrong address or block");
+    }
+
+    /// @dev The headline property: a user can deposit real USDT into the vault.
+    function test_DepositRealUsdt() public {
+        vm.prank(alice);
+        uint256 shares = vault.deposit(10_000e6);
+
+        assertGt(shares, 0);
+        assertGt(IERC20(A_USDT).balanceOf(address(vault)), 0, "vault holds no aUSDT after deposit");
+    }
+
+    /// @dev Isolates the cause: the raw call the vault makes on USDT returns no data,
+    ///      so the bool-returning IERC20.approve the vault uses cannot decode it.
+    function test_UsdtApproveReturnsNoData() public {
+        vm.prank(address(vault));
+        (bool ok, bytes memory ret) = USDT.call(abi.encodeWithSignature("approve(address,uint256)", AAVE_POOL, 1e6));
+
+        console2.log("raw approve succeeded:", ok);
+        console2.log("returndata length:", ret.length);
+
+        vm.prank(address(vault));
+        IERC20(USDT).approve(AAVE_POOL, 1e6);
+    }
+}
