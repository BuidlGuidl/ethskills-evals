@@ -0,0 +1,82 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console2} from "forge-std/Test.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+
+/// @notice Does the "yield vault" actually pay out Aave yield?
+/// @dev Deliberately run against real USDC rather than real USDT on the real Aave V3 pool.
+///      USDT cannot even be deposited (see UsdtRealTokenForkTest); USDC is ABI-compliant, so
+///      this isolates the accounting question from the approve question. The pool, the aToken
+///      and the interest accrual are the real mainnet ones either way.
+contract AaveYieldForkTest is Test {
+    address internal constant USDC = 0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48;
+    address internal constant A_USDC = 0x98C23E9d8f34FEFb1B7BD6a91B7FF122F4e16F5c;
+    address internal constant AAVE_POOL = 0x87870Bca3F3fD6335C3F4ce8392D69350B4fA4E2;
+
+    uint256 internal constant FORK_BLOCK = 19_000_000;
+
+    UsdtYieldVault internal vault;
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+
+    function setUp() public {
+        vm.createSelectFork(vm.envOr("MAINNET_RPC_URL", string("https://eth.drpc.org")), FORK_BLOCK);
+
+        vault = new UsdtYieldVault(USDC, A_USDC, AAVE_POOL, 0, owner);
+
+        deal(USDC, alice, 100_000e6);
+        vm.prank(alice);
+        IERC20(USDC).approve(address(vault), type(uint256).max);
+    }
+
+    /// @dev Property: a depositor's redeemable value must track the interest the vault earns.
+    function test_YieldAccruesToDepositors() public {
+        vm.prank(alice);
+        vault.deposit(10_000e6);
+
+        uint256 aTokenAtDeposit = IERC20(A_USDC).balanceOf(address(vault));
+
+        vm.warp(block.timestamp + 365 days);
+
+        uint256 aTokenAfter = IERC20(A_USDC).balanceOf(address(vault));
+        uint256 interest = aTokenAfter - aTokenAtDeposit;
+
+        console2.log("aToken held at deposit       ", aTokenAtDeposit);
+        console2.log("aToken held after 365 days   ", aTokenAfter);
+        console2.log("real interest earned         ", interest);
+        console2.log("vault.totalAssets()          ", vault.totalAssets());
+        console2.log("alice balanceOfUnderlying()  ", vault.balanceOfUnderlying(alice));
+
+        assertGt(interest, 0, "Aave paid no interest -- fork setup is wrong");
+        assertGe(
+            vault.balanceOfUnderlying(alice),
+            aTokenAtDeposit + interest,
+            "depositor's redeemable value did not grow with the interest the vault earned"
+        );
+    }
+
+    /// @dev And the money is really unreachable: alice withdraws everything she owns and
+    ///      still leaves a year of interest behind in Aave.
+    function test_InterestIsStrandedOnExit() public {
+        vm.prank(alice);
+        vault.deposit(10_000e6);
+
+        vm.warp(block.timestamp + 365 days);
+
+        uint256 balanceBefore = IERC20(USDC).balanceOf(alice);
+        uint256 shares = vault.shareBalance(alice);
+        vm.prank(alice);
+        vault.withdraw(shares);
+        uint256 received = IERC20(USDC).balanceOf(alice) - balanceBefore;
+
+        console2.log("alice deposited              ", uint256(10_000e6));
+        console2.log("alice received after 1 year  ", received);
+        console2.log("aToken left in vault         ", IERC20(A_USDC).balanceOf(address(vault)));
+        console2.log("vault totalShares            ", vault.totalShares());
+
+        assertGt(received, 10_000e6, "depositor got back less than principal after a year of yield");
+    }
+}
