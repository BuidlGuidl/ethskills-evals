+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test} from "forge-std/Test.sol";
+
+import {UsdtYieldVault} from "../src/UsdtYieldVault.sol";
+import {MockUSDT} from "./mocks/MockUSDT.sol";
+import {MockAavePool, MockAToken} from "./mocks/MockAavePool.sol";
+
+contract UsdtYieldVaultFeeBoundsTest is Test {
+    UsdtYieldVault public vault;
+    MockUSDT public usdt;
+    MockAavePool public pool;
+    MockAToken public aUsdt;
+
+    address public owner = makeAddr("owner");
+    address public alice = makeAddr("alice");
+
+    uint256 public constant DEPOSIT_AMOUNT = 1_000e6;
+
+    function setUp() public {
+        usdt = new MockUSDT();
+        pool = new MockAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 0, owner);
+
+        usdt.mint(alice, DEPOSIT_AMOUNT);
+        vm.prank(alice);
+        usdt.approve(address(vault), type(uint256).max);
+    }
+
+    function testFuzz_DepositFeeMustRejectValuesAtOrAboveOneHundredPercent(uint256 feeBps) public {
+        feeBps = bound(feeBps, vault.BPS_DENOMINATOR(), type(uint16).max);
+
+        vm.prank(owner);
+        vm.expectRevert();
+        vault.setDepositFee(feeBps);
+    }
+
+    function test_DepositFeeAtOneHundredPercentMustNotBrickDeposits() public {
+        uint256 oneHundredPercent = vault.BPS_DENOMINATOR();
+
+        vm.prank(owner);
+        vault.setDepositFee(oneHundredPercent);
+
+        vm.prank(alice);
+        uint256 shares = vault.deposit(DEPOSIT_AMOUNT);
+
+        assertGt(shares, 0, "accepted fee setting must still mint shares");
+    }
+}
