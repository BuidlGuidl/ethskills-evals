+
+contract UsdtYieldVaultAccountingInvariantTest is Test {
+    UsdtYieldVault public vault;
+    MockUSDT public usdt;
+    MockAavePool public pool;
+    MockAToken public aUsdt;
+
+    address public owner = makeAddr("owner");
+    address public alice = makeAddr("alice");
+    address public bob = makeAddr("bob");
+
+    uint256 public constant DEPOSIT_AMOUNT = 1_000e6;
+
+    function setUp() public {
+        usdt = new MockUSDT();
+        pool = new MockAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 0, owner);
+
+        usdt.mint(alice, DEPOSIT_AMOUNT);
+        usdt.mint(bob, DEPOSIT_AMOUNT);
+
+        vm.prank(alice);
+        usdt.approve(address(vault), type(uint256).max);
+        vm.prank(bob);
+        usdt.approve(address(vault), type(uint256).max);
+    }
+
+    function _deposit(address account, uint256 amount) internal returns (uint256) {
+        vm.prank(account);
+        return vault.deposit(amount);
+    }
+
+    function test_WithdrawalFeeMustRemainInTrackedAssetsForRemainingShareholders() public {
+        uint256 aliceShares = _deposit(alice, DEPOSIT_AMOUNT);
+        _deposit(bob, DEPOSIT_AMOUNT);
+
+        vm.prank(alice);
+        vault.withdraw(aliceShares);
+
+        assertEq(vault.totalAssets(), aUsdt.balanceOf(address(vault)), "tracked assets must equal aUSDT custody");
+    }
+}
