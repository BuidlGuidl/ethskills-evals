+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test} from "forge-std/Test.sol";
+
+import {UsdtYieldVault} from "../src/UsdtYieldVault.sol";
+import {MockUSDT} from "./mocks/MockUSDT.sol";
+import {MockAavePool, MockAToken} from "./mocks/MockAavePool.sol";
+
+contract UsdtYieldVaultAccountingFailuresTest is Test {
+    UsdtYieldVault internal vault;
+    MockUSDT internal usdt;
+    MockAavePool internal pool;
+    MockAToken internal aUsdt;
+
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+    address internal bob = makeAddr("bob");
+
+    function setUp() public {
+        usdt = new MockUSDT();
+        pool = new MockAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 0, owner);
+
+        usdt.mint(alice, 100_000e6);
+        usdt.mint(bob, 100_000e6);
+
+        vm.prank(alice);
+        usdt.approve(address(vault), type(uint256).max);
+        vm.prank(bob);
+        usdt.approve(address(vault), type(uint256).max);
+    }
+
+    function test_WithdrawalFeeAccruesToRemainingShareholders() public {
+        _deposit(alice, 1_000e6);
+        _deposit(bob, 1_000e6);
+
+        uint256 aliceShares = vault.shareBalance(alice);
+
+        vm.prank(alice);
+        vault.withdraw(aliceShares);
+
+        assertEq(vault.balanceOfUnderlying(bob), 1_003e6, "Alice's withdrawal fee should back Bob's shares");
+    }
+
+    function test_AaveYieldAccruesToShareholders() public {
+        _deposit(alice, 1_000e6);
+
+        _accrueAaveYield(100e6);
+
+        assertEq(vault.balanceOfUnderlying(alice), 1_100e6, "Aave yield should increase depositor value");
+    }
+
+    function test_FullExitDoesNotStrandSuppliedUsdtInAave() public {
+        uint256 shares = _deposit(alice, 1_000e6);
+        _accrueAaveYield(100e6);
+
+        vm.prank(alice);
+        vault.withdraw(shares);
+
+        assertEq(aUsdt.balanceOf(address(vault)), 0, "no aUSDT should be left without shares");
+    }
+
+    function test_DepositFeeCannotBeConfiguredAboveOneHundredPercent() public {
+        vm.prank(owner);
+        vault.setDepositFee(10_001);
+
+        assertLe(vault.depositFeeBps(), vault.BPS_DENOMINATOR(), "deposit fee must stay within basis points");
+    }
+
+    function _deposit(address account, uint256 amount) internal returns (uint256 shares) {
+        vm.prank(account);
+        shares = vault.deposit(amount);
+    }
+
+    function _accrueAaveYield(uint256 amount) internal {
+        usdt.mint(address(pool), amount);
+
+        vm.prank(address(pool));
+        aUsdt.mint(address(vault), amount);
+    }
+}
