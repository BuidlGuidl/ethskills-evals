+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {Test} from "forge-std/Test.sol";
+
+import {UsdtYieldVault} from "../src/UsdtYieldVault.sol";
+
+contract MainnetUsdtForkFailureTest is Test {
+    address internal constant USDT = 0xdAC17F958D2ee523a2206206994597C13D831ec7;
+    address internal constant A_USDT = 0x23878914EFE38d27C4D67Ab83ed1b93A74D4086a;
+    address internal constant AAVE_POOL = 0x87870Bca3F3fD6335C3F4ce8392D69350B4fA4E2;
+
+    function test_MainnetUsdtDepositIntoAaveShouldSucceed() public {
+        UsdtYieldVault vault = new UsdtYieldVault(USDT, A_USDT, AAVE_POOL, 0, address(this));
+        address depositor = makeAddr("depositor");
+        uint256 amount = 1_000e6;
+
+        deal(USDT, depositor, amount);
+
+        vm.prank(depositor);
+        (bool approved,) = USDT.call(abi.encodeWithSelector(IERC20.approve.selector, address(vault), amount));
+        assertTrue(approved, "USDT approval to vault failed");
+
+        vm.prank(depositor);
+        uint256 shares = vault.deposit(amount);
+
+        assertEq(shares, 1_000e18);
+        assertEq(IERC20(A_USDT).balanceOf(address(vault)), amount);
+    }
+}
