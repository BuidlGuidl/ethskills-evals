+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test} from "forge-std/Test.sol";
+
+import {UsdtYieldVault} from "../src/UsdtYieldVault.sol";
+import {MockAavePool, MockAToken} from "./mocks/MockAavePool.sol";
+import {MockUSDT} from "./mocks/MockUSDT.sol";
+
+contract WithdrawalFeeAccountingFailureTest is Test {
+    UsdtYieldVault internal vault;
+    MockUSDT internal usdt;
+    MockAavePool internal pool;
+    MockAToken internal aUsdt;
+
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+    address internal bob = makeAddr("bob");
+
+    function setUp() public {
+        usdt = new MockUSDT();
+        pool = new MockAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 0, owner);
+
+        usdt.mint(alice, 1_000e6);
+        usdt.mint(bob, 1_000e6);
+
+        vm.prank(alice);
+        usdt.approve(address(vault), type(uint256).max);
+        vm.prank(bob);
+        usdt.approve(address(vault), type(uint256).max);
+    }
+
+    function test_WithdrawalFeeShouldRemainClaimableByRemainingShareholders() public {
+        vm.prank(alice);
+        uint256 aliceShares = vault.deposit(1_000e6);
+
+        vm.prank(bob);
+        vault.deposit(1_000e6);
+
+        vm.prank(alice);
+        vault.withdraw(aliceShares);
+
+        assertEq(vault.totalShares(), vault.shareBalance(bob), "bob should be the only remaining shareholder");
+        assertEq(
+            vault.balanceOfUnderlying(bob),
+            aUsdt.balanceOf(address(vault)),
+            "alice's withdrawal fee should remain tracked for bob"
+        );
+    }
+
+    function test_AllAccountingAssetsShouldBeWithdrawableAfterAllSharesAreBurned() public {
+        vm.prank(alice);
+        uint256 aliceShares = vault.deposit(1_000e6);
+
+        vm.prank(bob);
+        uint256 bobShares = vault.deposit(1_000e6);
+
+        vm.prank(alice);
+        vault.withdraw(aliceShares);
+
+        vm.prank(bob);
+        vault.withdraw(bobShares);
+
+        assertEq(aUsdt.balanceOf(address(vault)), 0, "no aUSDT should be stranded after all shares exit");
+    }
+}

