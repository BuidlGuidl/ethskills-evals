@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console2} from "forge-std/Test.sol";
+
+import {UsdtYieldVault} from "../src/UsdtYieldVault.sol";
+import {MockUSDT} from "./mocks/MockUSDT.sol";
+import {MockAavePool, MockAToken} from "./mocks/MockAavePool.sol";
+import {VaultHandler} from "./handlers/VaultHandler.sol";
+
+/// @notice Handler-driven invariants tying the vault's internal accounting to
+///         the assets it actually custodies in Aave.
+contract UsdtYieldVaultInvariantTest is Test {
+    UsdtYieldVault internal vault;
+    MockUSDT internal usdt;
+    MockAavePool internal pool;
+    MockAToken internal aUsdt;
+    VaultHandler internal handler;
+
+    address internal owner = makeAddr("owner");
+
+    function setUp() public {
+        usdt = new MockUSDT();
+        pool = new MockAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 10, owner);
+
+        handler = new VaultHandler(vault, usdt);
+        targetContract(address(handler));
+    }
+
+    /// @notice Custody must equal accounting: every USDT the vault claims to
+    ///         hold is represented by an aUSDT it actually holds, and every
+    ///         aUSDT it holds is claimable by some shareholder.
+    ///         Stated as an equality on purpose — a one-sided `claims <=
+    ///         holdings` bound stays green while value is stranded.
+    function invariant_AccountingEqualsCustody() public view {
+        assertEq(
+            vault.totalAssetsStored(),
+            aUsdt.balanceOf(address(vault)),
+            "totalAssetsStored diverged from aUSDT actually held"
+        );
+    }
+
+    /// @notice Share ledger must be internally consistent.
+    function invariant_SumOfSharesEqualsTotalShares() public view {
+        assertEq(handler.sumOfShareBalances(), vault.totalShares(), "share ledger does not sum to totalShares");
+    }
+
+    function invariant_CallSummary() public view {
+        console2.log("deposits ", handler.depositCalls());
+        console2.log("withdraws", handler.withdrawCalls());
+        console2.log("setFee   ", handler.feeCalls());
+    }
+}
