+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test} from "forge-std/Test.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+import {MockUSDT} from "../mocks/MockUSDT.sol";
+
+/// @notice Handler driving {UsdtYieldVault} with funded, approved actors and
+///         bounded inputs, so the invariant fuzzer reaches real vault states
+///         instead of bouncing off reverts.
+contract VaultHandler is Test {
+    UsdtYieldVault public immutable vault;
+    MockUSDT public immutable usdt;
+
+    address[] public actors;
+    address internal currentActor;
+
+    uint256 public depositCalls;
+    uint256 public withdrawCalls;
+    uint256 public feeCalls;
+
+    modifier useActor(uint256 actorSeed) {
+        currentActor = actors[bound(actorSeed, 0, actors.length - 1)];
+        vm.startPrank(currentActor);
+        _;
+        vm.stopPrank();
+    }
+
+    constructor(UsdtYieldVault _vault, MockUSDT _usdt) {
+        vault = _vault;
+        usdt = _usdt;
+
+        for (uint256 i = 0; i < 3; i++) {
+            address actor = makeAddr(string.concat("actor", vm.toString(i)));
+            actors.push(actor);
+            usdt.mint(actor, 10_000_000e6);
+            vm.prank(actor);
+            usdt.approve(address(vault), type(uint256).max);
+        }
+    }
+
+    function deposit(uint256 actorSeed, uint256 amount) external useActor(actorSeed) {
+        amount = bound(amount, vault.MIN_DEPOSIT(), 1_000_000e6);
+        // Keep the bounded input inside the range the vault accepts: a net
+        // amount that rounds to zero shares is a separate, documented revert.
+        uint256 fee = (amount * vault.depositFeeBps()) / vault.BPS_DENOMINATOR();
+        if (vault.convertToShares(amount - fee) == 0) return;
+        depositCalls++;
+        vault.deposit(amount);
+    }
+
+    function withdraw(uint256 actorSeed, uint256 shares) external useActor(actorSeed) {
+        uint256 balance = vault.shareBalance(currentActor);
+        if (balance == 0) return;
+        shares = bound(shares, 1, balance);
+        withdrawCalls++;
+        vault.withdraw(shares);
+    }
+
+    function setDepositFee(uint256 newFeeBps) external {
+        // Bounded well inside the sane range; the unbounded domain is searched
+        // separately by the fee fuzz tests.
+        newFeeBps = bound(newFeeBps, 0, 1_000);
+        feeCalls++;
+        vm.prank(vault.owner());
+        vault.setDepositFee(newFeeBps);
+    }
+
+    function actorCount() external view returns (uint256) {
+        return actors.length;
+    }
+
+    function sumOfShareBalances() external view returns (uint256 total) {
+        for (uint256 i = 0; i < actors.length; i++) {
+            total += vault.shareBalance(actors[i]);
+        }
+    }
+}

