+
+## F5 — Medium. Pausing freezes user exits
+
+### What is wrong
+
+`withdraw()` carries `whenNotPaused` (`UsdtYieldVault.sol:107`). A single owner
+key can stop every depositor from retrieving their funds, indefinitely, with no
+timelock, no guardian split, and no emergency redemption path. The existing
+suite has `test_PauseBlocksDeposit` and never asks the converse question.
+
+Pausing *deposits* in an incident is correct. Pausing *withdrawals* turns an
+operational safety feature into a custody risk, and if the owner key is lost
+while paused the funds are gone.
+
+### Evidence
+
+```
+$ forge test --match-path test/VaultLiveness.t.sol -vv
+
+Ran 1 test for test/VaultLiveness.t.sol:VaultLivenessTest
+[FAIL: EnforcedPause()] test_DepositorCanAlwaysExit() (gas: 238216)
+Suite result: FAILED. 0 passed; 1 failed; 0 skipped; finished in 755.43µs (119.07µs CPU time)
+```
+
+### Fix
+
+Drop `whenNotPaused` from `withdraw`. If you genuinely need to halt withdrawals
+for an Aave incident, make it a separate, explicitly-named switch with a hard
+expiry, rather than folding it into the same pause that guards deposits. Move
+ownership to a multisig before mainnet either way — every finding here that
+begins "the owner can" is currently one key.
+
+---
+
+## Residual concerns — flagged, not demonstrated
+
+I did not build failing tests for these. Treat them as review items, not
+findings:
+
+- **`aavePool.withdraw` return value is ignored.** Aave returns the amount
+  actually withdrawn, which can be less than requested (e.g. when reserve
+  liquidity is short). The vault discards it and emits `netAssets` in the event
+  regardless. Worth checking the return equals the request and reverting
+  otherwise.
+- **`Withdrawn` event semantics.** `deposit` emits the *gross* amount as
+  `assets` while `withdraw` emits the *net*. Inconsistent, and will confuse
+  off-chain accounting.
+- **`convertToAssets` divides by `SHARE_SCALE` when `totalShares == 0`**, which
+  is dead in practice but is the inverse of the mint branch and worth a second
+  look once the F3 fix changes the conversion maths.
+- **`slither .` was not run.** It is installed on this machine but its Python
+  package is broken (`ModuleNotFoundError: No module named 'slither'`), so I
+  have no output to show you and will not claim a clean result. This should be
+  run before sign-off.
+
+---
+
+## What I would want before signing off
+
+1. F1–F5 fixed, with the fix for F3 including an explicit inflation-attack
+   defence.
+2. `test/VaultInvariant.t.sol`'s accounting-equals-custody equality in CI,
+   running at higher depth than the 64×32 I used here.
+3. The fork suite in CI against a pinned block, so the next USDT-shaped
+   assumption fails in the pipeline rather than on mainnet.
+4. `slither .` clean, or every high/medium explicitly accepted in writing.
+5. Ownership on a multisig, and `setDepositFee` timelocked.
+6. An audit. This review found five defects in an afternoon by asking three
+   questions the suite had never asked; I would not assume it found the last one.
diff --git a/test/VaultAccountingDrift.t.sol b/test/VaultAccountingDrift.t.sol
new file mode 100644
index 0000000..f51d82e
--- /dev/null
+++ b/test/VaultAccountingDrift.t.sol
@@ -0,0 +1,98 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console2} from "forge-std/Test.sol";
+
+import {UsdtYieldVault} from "../src/UsdtYieldVault.sol";
+import {MockUSDT} from "./mocks/MockUSDT.sol";
+import {MockAavePool, MockAToken} from "./mocks/MockAavePool.sol";
+
+/// @notice Targeted regressions for the withdrawal-fee accounting gap that the
+///         handler invariant surfaced. These confirm the mechanism and show it
+///         accumulating; they do not replace the invariant search.
+contract VaultAccountingDriftTest is Test {
+    UsdtYieldVault internal vault;
+    MockUSDT internal usdt;
+    MockAavePool internal pool;
+    MockAToken internal aUsdt;
+
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+    address internal bob = makeAddr("bob");
+
+    function setUp() public {
+        usdt = new MockUSDT();
+        pool = new MockAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        // Deposit fee 0 so every number below is attributable to the
+        // withdrawal fee alone.
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 0, owner);
+
+        for (uint256 i = 0; i < 2; i++) {
+            address a = i == 0 ? alice : bob;
+            usdt.mint(a, 1_000_000e6);
+            vm.prank(a);
+            usdt.approve(address(vault), type(uint256).max);
+        }
+    }
+
+    function _drift() internal view returns (uint256) {
+        return aUsdt.balanceOf(address(vault)) - vault.totalAssetsStored();
+    }
+
+    /// @notice The withdrawal fee is deducted from `totalAssetsStored` but is
+    ///         never withdrawn from Aave and is never credited to anyone, so
+    ///         the gap between custody and accounting grows once per withdrawal.
+    function test_WithdrawFeeStrandsValueAndAccumulates() public {
+        vm.prank(alice);
+        uint256 aliceShares = vault.deposit(100_000e6);
+        vm.prank(bob);
+        uint256 bobShares = vault.deposit(100_000e6);
+
+        assertEq(_drift(), 0, "no drift before any withdrawal");
+
+        uint256 priceBefore = vault.sharePrice();
+
+        vm.prank(alice);
+        vault.withdraw(aliceShares / 2);
+        uint256 driftAfterFirst = _drift();
+
+        vm.prank(bob);
+        vault.withdraw(bobShares / 2);
+        uint256 driftAfterSecond = _drift();
+
+        console2.log("stranded after 1 withdrawal (USDT base units):", driftAfterFirst);
+        console2.log("stranded after 2 withdrawals (USDT base units):", driftAfterSecond);
+        console2.log("share price before:", priceBefore);
+        console2.log("share price after :", vault.sharePrice());
+
+        assertGt(driftAfterFirst, 0, "first withdrawal should strand the fee");
+        assertGt(driftAfterSecond, driftAfterFirst, "drift accumulates across withdrawals");
+
+        // The NatSpec claims withdrawal fees "accrue to the remaining
+        // shareholders". If that were true the share price would rise.
+        assertGt(vault.sharePrice(), priceBefore, "withdraw fee did not accrue to remaining shareholders");
+    }
+
+    /// @notice Once the last share is burned the stranded fees remain in Aave
+    ///         with no shares against them and no rescue path on the vault.
+    function test_StrandedFeesAreUnrecoverableAfterFullExit() public {
+        vm.prank(alice);
+        uint256 aliceShares = vault.deposit(100_000e6);
+        vm.prank(bob);
+        uint256 bobShares = vault.deposit(100_000e6);
+
+        vm.prank(alice);
+        vault.withdraw(aliceShares);
+        vm.prank(bob);
+        vault.withdraw(bobShares);
+
+        console2.log("totalShares        :", vault.totalShares());
+        console2.log("totalAssetsStored  :", vault.totalAssetsStored());
+        console2.log("aUSDT held by vault:", aUsdt.balanceOf(address(vault)));
+
+        assertEq(vault.totalShares(), 0, "all shares burned");
+        assertEq(vault.totalAssetsStored(), 0, "vault claims to hold nothing");
+        assertEq(aUsdt.balanceOf(address(vault)), 0, "yet aUSDT is still sitting in Aave");
+    }
+}
diff --git a/test/VaultDepositFeeFuzz.t.sol b/test/VaultDepositFeeFuzz.t.sol
new file mode 100644
index 0000000..a2b8dc3
--- /dev/null
+++ b/test/VaultDepositFeeFuzz.t.sol
@@ -0,0 +1,154 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console2, stdError} from "forge-std/Test.sol";
+
+import {UsdtYieldVault} from "../src/UsdtYieldVault.sol";
+import {MockUSDT} from "./mocks/MockUSDT.sol";
+import {MockAavePool, MockAToken} from "./mocks/MockAavePool.sol";
+
+/// @notice Searches the whole accepted domain of `depositFeeBps`, the one
+///         owner-settable number that feeds the vault's value math.
+///         `setDepositFee` applies no upper bound, so the domain under test is
+///         every uint256, not 0..BPS_DENOMINATOR.
+contract VaultDepositFeeFuzzTest is Test {
+    UsdtYieldVault internal vault;
+    MockUSDT internal usdt;
+    MockAavePool internal pool;
+    MockAToken internal aUsdt;
+
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+
+    uint256 internal constant DEPOSIT = 1_000e6;
+
+    function setUp() public {
+        usdt = new MockUSDT();
+        pool = new MockAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 10, owner);
+
+        usdt.mint(alice, 10_000_000e6);
+        vm.prank(alice);
+        usdt.approve(address(vault), type(uint256).max);
+    }
+
+    function _setFee(uint256 bps) internal {
+        vm.prank(owner);
+        vault.setDepositFee(bps);
+    }
+
+    /*//////////////////////////////////////////////////////////////
+                        DOMAIN SEARCH (FUZZ)
+    //////////////////////////////////////////////////////////////*/
+
+    /// @notice For any fee the owner is allowed to set, a deposit at or above
+    ///         MIN_DEPOSIT must remain possible. Deposits are the vault's only
+    ///         entry point; a fee value that makes them impossible is a
+    ///         permanent denial of service reachable by one owner call.
+    function testFuzz_DepositSucceedsForAnySettableFee(uint256 feeBps) public {
+        feeBps = bound(feeBps, 0, 2 * vault.BPS_DENOMINATOR());
+        _setFee(feeBps);
+
+        vm.prank(alice);
+        try vault.deposit(DEPOSIT) returns (uint256 shares) {
+            assertGt(shares, 0, "deposit minted no shares");
+        } catch (bytes memory reason) {
+            console2.log("deposit reverted at depositFeeBps =", feeBps);
+            console2.logBytes(reason);
+            fail();
+        }
+    }
+
+    /// @notice A depositor must never be able to lose more than the advertised
+    ///         fee. With no cap on `depositFeeBps` the owner can front-run a
+    ///         deposit and take essentially all of it.
+    function testFuzz_DepositorRetainsValueNetOfFee(uint256 feeBps) public {
+        feeBps = bound(feeBps, 0, vault.BPS_DENOMINATOR() - 1);
+
+        // An existing shareholder, so the fee has somewhere to be diverted to.
+        address whale = makeAddr("whale");
+        usdt.mint(whale, 1_000_000e6);
+        vm.startPrank(whale);
+        usdt.approve(address(vault), type(uint256).max);
+        vault.deposit(100_000e6);
+        vm.stopPrank();
+
+        _setFee(feeBps);
+
+        vm.prank(alice);
+        vault.deposit(DEPOSIT);
+
+        uint256 value = vault.balanceOfUnderlying(alice);
+        uint256 expectedFee = (DEPOSIT * feeBps) / vault.BPS_DENOMINATOR();
+
+        // Allow 1 base unit of rounding.
+        assertGe(value + expectedFee + 1, DEPOSIT, "depositor lost more than the fee");
+        assertLe(value, DEPOSIT, "depositor gained value");
+    }
+
+    /*//////////////////////////////////////////////////////////////
+              BOUNDARY: nearest valid / exact limit / beyond
+    //////////////////////////////////////////////////////////////*/
+
+    /// @notice Nearest semantically usable value below the denominator.
+    function test_Boundary_FeeBpsJustBelowDenominator() public {
+        _setFee(9_999);
+        vm.prank(alice);
+        uint256 shares = vault.deposit(DEPOSIT);
+        console2.log("feeBps 9999 -> shares minted:", shares);
+        assertGt(shares, 0);
+    }
+
+    /// @notice Exact limit: a 100% fee. Reverts through the NoSharesMinted path.
+    function test_Boundary_FeeBpsEqualsDenominator() public {
+        _setFee(10_000);
+        vm.prank(alice);
+        vm.expectRevert(UsdtYieldVault.NoSharesMinted.selector);
+        vault.deposit(DEPOSIT);
+    }
+
+    /// @notice First value beyond the limit. Reverts through a *different*
+    ///         path: arithmetic underflow in `amount - fee`, panic 0x11.
+    function test_Boundary_FeeBpsJustAboveDenominator() public {
+        _setFee(10_001);
+        vm.prank(alice);
+        vm.expectRevert(stdError.arithmeticError);
+        vault.deposit(DEPOSIT);
+    }
+
+    /// @notice The owner can set a fee far outside the basis-point domain and
+    ///         the setter accepts it without complaint.
+    function test_SetDepositFeeAcceptsAbsurdValues() public {
+        _setFee(type(uint256).max);
+        assertEq(vault.depositFeeBps(), type(uint256).max, "setter accepted uint256 max as a bps value");
+    }
+
+    /// @notice The owner can confiscate a pending deposit by raising the fee
+    ///         immediately before it lands. No timelock, no cap.
+    function test_OwnerCanFrontRunDepositAndTakeNearlyAllOfIt() public {
+        address whale = makeAddr("whale");
+        usdt.mint(whale, 1_000_000e6);
+        vm.startPrank(whale);
+        usdt.approve(address(vault), type(uint256).max);
+        uint256 whaleShares = vault.deposit(100_000e6);
+        vm.stopPrank();
+
+        uint256 whaleBefore = vault.convertToAssets(whaleShares);
+
+        // Owner front-runs alice's 1,000 USDT deposit.
+        _setFee(9_999);
+        vm.prank(alice);
+        vault.deposit(DEPOSIT);
+
+        uint256 aliceValue = vault.balanceOfUnderlying(alice);
+        uint256 whaleAfter = vault.convertToAssets(whaleShares);
+
+        console2.log("alice deposited      :", DEPOSIT);
+        console2.log("alice redeemable     :", aliceValue);
+        console2.log("whale gain from fee  :", whaleAfter - whaleBefore);
+
+        assertGe(aliceValue, DEPOSIT - (DEPOSIT * 9_999) / 10_000, "sanity");
+        assertLt(whaleAfter - whaleBefore, 1e6, "existing holder captured the front-run fee");
+    }
+}
