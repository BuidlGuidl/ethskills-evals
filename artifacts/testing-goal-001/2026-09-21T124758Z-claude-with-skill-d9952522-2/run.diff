+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test} from "forge-std/Test.sol";
+import {Pausable} from "@openzeppelin/contracts/utils/Pausable.sol";
+
+import {UsdtYieldVault} from "../src/UsdtYieldVault.sol";
+import {MockUSDT} from "./mocks/MockUSDT.sol";
+import {MockAavePool, MockAToken} from "./mocks/MockAavePool.sol";
+
+/// @notice The existing suite asserts that `pause()` blocks deposits. It never
+///         asks what `pause()` does to someone trying to get their money out.
+contract VaultLivenessTest is Test {
+    UsdtYieldVault internal vault;
+    MockUSDT internal usdt;
+    MockAavePool internal pool;
+    MockAToken internal aUsdt;
+
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+
+    function setUp() public {
+        usdt = new MockUSDT();
+        pool = new MockAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 10, owner);
+
+        usdt.mint(alice, 1_000_000e6);
+        vm.prank(alice);
+        usdt.approve(address(vault), type(uint256).max);
+    }
+
+    /// @notice A depositor must always retain a path to exit. `whenNotPaused`
+    ///         on `withdraw` means a single owner key can freeze every
+    ///         depositor's funds indefinitely, with no timelock and no
+    ///         emergency redemption route.
+    function test_DepositorCanAlwaysExit() public {
+        vm.prank(alice);
+        uint256 shares = vault.deposit(100_000e6);
+
+        vm.prank(owner);
+        vault.pause();
+
+        vm.prank(alice);
+        vault.withdraw(shares);
+    }
+}
diff --git a/test/VaultMainnetFork.t.sol b/test/VaultMainnetFork.t.sol
new file mode 100644
index 0000000..1636267
--- /dev/null
+++ b/test/VaultMainnetFork.t.sol
@@ -0,0 +1,148 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console2} from "forge-std/Test.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+
+import {UsdtYieldVault} from "../src/UsdtYieldVault.sol";
+
+/// @notice Exercises the vault against the real USDT token and the real Aave V3
+///         pool it will be pointed at on Monday, on a pinned mainnet fork.
+///         The mock suite cannot see any of this: the mocks are OpenZeppelin
+///         ERC20s that answer in the standard shape, and a mock Aave pool that
+///         never accrues interest.
+///
+/// Block 21_000_000 pinned. Endpoint must serve archive state at that block;
+/// verified with:
+///   cast call 0xdAC17F958D2ee523a2206206994597C13D831ec7 "totalSupply()(uint256)" \
+///     --block 21000000 --rpc-url https://eth.drpc.org
+contract VaultMainnetForkTest is Test {
+    address internal constant USDT = 0xdAC17F958D2ee523a2206206994597C13D831ec7;
+    address internal constant AAVE_POOL = 0x87870Bca3F3fD6335C3F4ce8392D69350B4fA4E2;
+    address internal constant AUSDT = 0x23878914EFE38d27C4D67Ab83ed1b93A74D4086a;
+
+    uint256 internal constant FORK_BLOCK = 21_000_000;
+
+    UsdtYieldVault internal vault;
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+
+    uint256 internal constant DEPOSIT = 100_000e6;
+
+    function setUp() public {
+        vm.createSelectFork(vm.envOr("MAINNET_RPC_URL", string("https://eth.drpc.org")), FORK_BLOCK);
+
+        // Confirm we are actually pointed at the real deployments before any
+        // conclusion is drawn from a call to them.
+        assertEq(IERC20Metadata(USDT).symbol(), "USDT", "USDT address");
+        assertEq(IERC20Metadata(AUSDT).symbol(), "aEthUSDT", "aUSDT address");
+        assertEq(IAToken(AUSDT).UNDERLYING_ASSET_ADDRESS(), USDT, "aUSDT underlying");
+
+        vault = new UsdtYieldVault(USDT, AUSDT, AAVE_POOL, 10, owner);
+
+        deal(USDT, alice, 1_000_000e6);
+        vm.prank(alice);
+        // Raw call: USDT.approve returns no data, so it cannot be made through
+        // the IERC20 interface at all. See test_RealUsdtApproveReturnsNoData.
+        (bool ok,) = USDT.call(abi.encodeWithSignature("approve(address,uint256)", address(vault), type(uint256).max));
+        require(ok, "alice approve failed");
+    }
+
+    /*//////////////////////////////////////////////////////////////
+                    FINDING: deposit() cannot work on mainnet
+    //////////////////////////////////////////////////////////////*/
+
+    /// @notice The root cause, stated directly: mainnet USDT's `approve` writes
+    ///         no return data, so any call made through a `returns (bool)`
+    ///         interface reverts when the compiler decodes the result.
+    function test_RealUsdtApproveReturnsNoData() public {
+        vm.prank(alice);
+        (bool ok, bytes memory ret) = USDT.call(abi.encodeWithSignature("approve(address,uint256)", AAVE_POOL, 1e6));
+        assertTrue(ok, "raw approve itself succeeds");
+        console2.log("USDT.approve return data length:", ret.length);
+        assertEq(ret.length, 32, "USDT.approve returned a decodable bool");
+    }
+
+    /// @notice The vault calls `usdt.approve(...)` through `IERC20`, not through
+    ///         SafeERC20. Against the real token every deposit reverts.
+    function test_DepositAgainstRealUsdt() public {
+        vm.prank(alice);
+        uint256 shares = vault.deposit(DEPOSIT);
+        assertGt(shares, 0, "deposit should mint shares");
+    }
+
+    /*//////////////////////////////////////////////////////////////
+       FINDING: Aave interest never reaches depositors (real pool)
+    //////////////////////////////////////////////////////////////*/
+
+    /// @dev Neutralises the `approve` revert above so the *next* defect is
+    ///      observable. Everything else — token, pool, interest model — is the
+    ///      real mainnet deployment.
+    function _depositBypassingApproveBug(uint256 amount) internal returns (uint256 shares) {
+        vm.prank(address(vault));
+        (bool ok,) = USDT.call(abi.encodeWithSignature("approve(address,uint256)", AAVE_POOL, type(uint256).max));
+        require(ok, "vault->pool approve failed");
+        vm.mockCall(USDT, abi.encodeWithSelector(IERC20.approve.selector), abi.encode(true));
+
+        vm.prank(alice);
+        shares = vault.deposit(amount);
+    }
+
+    /// @notice `totalAssets()` returns a stored number that is only ever moved
+    ///         by deposits and withdrawals. The aUSDT balance rebases upward as
+    ///         Aave pays interest, and the vault never looks at it — so a
+    ///         "yield vault" pays its depositors no yield.
+    function test_AaveInterestNeverReachesDepositors() public {
+        _depositBypassingApproveBug(DEPOSIT);
+
+        uint256 aBefore = IERC20(AUSDT).balanceOf(address(vault));
+        uint256 valueBefore = vault.balanceOfUnderlying(alice);
+        uint256 priceBefore = vault.sharePrice();
+
+        vm.warp(block.timestamp + 365 days);
+
+        uint256 aAfter = IERC20(AUSDT).balanceOf(address(vault));
+        uint256 valueAfter = vault.balanceOfUnderlying(alice);
+
+        console2.log("aUSDT held, day 0    :", aBefore);
+        console2.log("aUSDT held, day 365  :", aAfter);
+        console2.log("interest earned      :", aAfter - aBefore);
+        console2.log("alice redeemable d0  :", valueBefore);
+        console2.log("alice redeemable d365:", valueAfter);
+        console2.log("totalAssets() d365   :", vault.totalAssets());
+
+        assertGt(aAfter, aBefore, "Aave did pay interest");
+        assertGt(vault.totalAssets(), aBefore, "totalAssets() ignores the interest");
+        assertGt(valueAfter, valueBefore, "depositor's claim should grow with the interest");
+        assertGt(vault.sharePrice(), priceBefore, "share price should grow with the interest");
+    }
+
+    /// @notice After the only depositor exits, the interest plus the withdrawal
+    ///         fee stay behind as aUSDT owned by a vault with zero shares and no
+    ///         rescue function.
+    function test_ResidualIsStrandedAfterFullExitOnRealAave() public {
+        uint256 shares = _depositBypassingApproveBug(DEPOSIT);
+
+        vm.warp(block.timestamp + 365 days);
+
+        vm.prank(alice);
+        vault.withdraw(shares);
+
+        uint256 residual = IERC20(AUSDT).balanceOf(address(vault));
+        console2.log("totalShares         :", vault.totalShares());
+        console2.log("totalAssetsStored   :", vault.totalAssetsStored());
+        console2.log("aUSDT left in Aave  :", residual);
+        console2.log("alice USDT balance  :", IERC20(USDT).balanceOf(alice));
+
+        assertEq(vault.totalShares(), 0, "all shares burned");
+        assertEq(residual, 0, "nothing should be left behind");
+    }
+}
