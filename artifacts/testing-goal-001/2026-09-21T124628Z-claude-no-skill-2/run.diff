@@ -0,0 +1,84 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, stdStorage, StdStorage} from "forge-std/Test.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+import {IAavePool} from "../../src/interfaces/IAavePool.sol";
+
+/// @notice Mainnet-fork test against the REAL Aave V3 pool and the REAL aUSDT.
+/// @dev The vault cannot deposit on mainnet at all (see RealUsdtDeposit.t.sol), so
+///      this test puts the vault into the exact state a *working* deposit would have
+///      produced: 10,000 USDT supplied to Aave on the vault's behalf, and the vault's
+///      own accounting set to match. Interest accrual is 100% real Aave.
+contract StrandedYieldForkTest is Test {
+    using stdStorage for StdStorage;
+
+    address constant USDT = 0xdAC17F958D2ee523a2206206994597C13D831ec7;
+    address constant AUSDT = 0x23878914EFE38d27C4D67Ab83ed1b93A74D4086a;
+    address constant AAVE_POOL = 0x87870Bca3F3fD6335C3F4ce8392D69350B4fA4E2;
+
+    uint256 constant PRINCIPAL = 10_000e6;
+
+    UsdtYieldVault vault;
+    address alice = makeAddr("alice");
+
+    function setUp() public {
+        vm.createSelectFork(vm.envString("ETH_RPC_URL")); // latest block: public RPCs here serve no archive state
+        vault = new UsdtYieldVault(USDT, AUSDT, AAVE_POOL, 0, address(this));
+
+        // Supply PRINCIPAL into real Aave V3, crediting the aUSDT to the vault.
+        deal(USDT, address(this), PRINCIPAL);
+        (bool ok,) = USDT.call(abi.encodeWithSignature("approve(address,uint256)", AAVE_POOL, PRINCIPAL));
+        require(ok, "approve failed");
+        IAavePool(AAVE_POOL).supply(USDT, PRINCIPAL, address(vault), 0);
+
+        // Mirror that position in the vault's own books, exactly as deposit() would.
+        stdstore.target(address(vault)).sig("totalAssetsStored()").checked_write(PRINCIPAL);
+        stdstore.target(address(vault)).sig("totalShares()").checked_write(PRINCIPAL * 1e12);
+        stdstore.target(address(vault)).sig("shareBalance(address)").with_key(alice).checked_write(PRINCIPAL * 1e12);
+
+        assertApproxEqAbs(IERC20(AUSDT).balanceOf(address(vault)), PRINCIPAL, 2, "seed mismatch");
+        assertEq(vault.balanceOfUnderlying(alice), PRINCIPAL, "books mismatch");
+    }
+
+    /// @notice After a year in real Aave, a depositor should be able to withdraw
+    ///         their principal plus the interest their money earned.
+    function test_DepositorReceivesAaveInterest() public {
+        uint256 sharePriceBefore = vault.sharePrice();
+
+        vm.warp(block.timestamp + 365 days);
+
+        uint256 realPosition = IERC20(AUSDT).balanceOf(address(vault));
+        uint256 interest = realPosition - PRINCIPAL;
+        emit log_named_uint("real aUSDT held by vault after 1y", realPosition);
+        emit log_named_uint("interest actually earned (USDT)   ", interest);
+        emit log_named_uint("vault.totalAssets() says          ", vault.totalAssets());
+        emit log_named_uint("sharePrice before                 ", sharePriceBefore);
+        emit log_named_uint("sharePrice after  1y              ", vault.sharePrice());
+        assertGt(interest, 0, "no interest accrued on the fork; pick another block");
+
+        uint256 aliceShares = vault.shareBalance(alice);
+        vm.prank(alice);
+        uint256 received = vault.withdraw(aliceShares);
+        emit log_named_uint("alice received on full withdraw   ", received);
+
+        // 30bps withdrawal fee is expected; the year of interest is not.
+        assertGe(received, PRINCIPAL + interest - (PRINCIPAL + interest) * 30 / 10_000, "depositor lost the interest");
+    }
+
+    /// @notice Whatever the depositor did not get, can anyone get it out?
+    function test_InterestIsRecoverableAfterEveryoneExits() public {
+        vm.warp(block.timestamp + 365 days);
+
+        uint256 aliceShares = vault.shareBalance(alice);
+        vm.prank(alice);
+        vault.withdraw(aliceShares);
+
+        uint256 orphaned = IERC20(AUSDT).balanceOf(address(vault));
+        emit log_named_uint("aUSDT left in vault after last exit", orphaned);
+        emit log_named_uint("totalShares now                    ", vault.totalShares());
+        assertEq(orphaned, 0, "USDT is stranded in Aave with no function that can move it");
+    }
+}
