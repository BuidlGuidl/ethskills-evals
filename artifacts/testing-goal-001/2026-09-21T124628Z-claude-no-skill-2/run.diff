@@ -0,0 +1,84 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+/// @notice Behavioural replica of the deployed TetherToken at
+///         0xdAC17F958D2ee523a2206206994597C13D831ec7, for offline reproduction of
+///         the two ways real USDT differs from a textbook ERC20:
+///
+///         1. `approve` / `transfer` / `transferFrom` return NO data (they are
+///            declared `returns ()` in Tether's source, predating EIP-20 finalisation).
+///         2. `basisPointsRate` / `maximumFee` skim a fee off every transfer.
+///            Both are live on mainnet today and settable by Tether's owner via
+///            `setParams(uint256,uint256)`; today they read 0.
+///
+///         Everything else is simplified - only the ABI shape and the fee maths
+///         matter for the vault.
+contract UsdtReplica {
+    string public constant name = "Tether USD";
+    string public constant symbol = "USDT";
+    uint8 public constant decimals = 6;
+
+    uint256 public totalSupply;
+    uint256 public basisPointsRate;
+    uint256 public maximumFee;
+    address public immutable tetherOwner;
+
+    mapping(address => uint256) public balanceOf;
+    mapping(address => mapping(address => uint256)) public allowance;
+
+    event Transfer(address indexed from, address indexed to, uint256 value);
+    event Approval(address indexed owner, address indexed spender, uint256 value);
+
+    constructor() {
+        tetherOwner = msg.sender;
+    }
+
+    function setParams(uint256 newBasisPoints, uint256 newMaxFee) external {
+        require(msg.sender == tetherOwner, "not owner");
+        require(newBasisPoints < 20, "bps too high"); // Tether's own cap
+        basisPointsRate = newBasisPoints;
+        maximumFee = newMaxFee * 10 ** uint256(decimals);
+    }
+
+    function mint(address to, uint256 amount) external {
+        balanceOf[to] += amount;
+        totalSupply += amount;
+        emit Transfer(address(0), to, amount);
+    }
+
+    function _fee(uint256 amount) internal view returns (uint256 fee) {
+        fee = (amount * basisPointsRate) / 10_000;
+        if (fee > maximumFee) fee = maximumFee;
+    }
+
+    // NOTE: no `returns (bool)` - this is the whole point of the replica.
+    function approve(address spender, uint256 amount) external {
+        allowance[msg.sender][spender] = amount;
+        emit Approval(msg.sender, spender, amount);
+    }
+
+    function transfer(address to, uint256 amount) external {
+        _transfer(msg.sender, to, amount);
+    }
+
+    function transferFrom(address from, address to, uint256 amount) external {
+        uint256 allowed = allowance[from][msg.sender];
+        if (allowed < type(uint256).max) {
+            require(allowed >= amount, "allowance");
+            allowance[from][msg.sender] = allowed - amount;
+        }
+        _transfer(from, to, amount);
+    }
+
+    function _transfer(address from, address to, uint256 amount) internal {
+        require(balanceOf[from] >= amount, "balance");
+        uint256 fee = _fee(amount);
+        balanceOf[from] -= amount;
+        balanceOf[to] += amount - fee;
+        if (fee > 0) {
+            balanceOf[tetherOwner] += fee;
+            emit Transfer(from, tetherOwner, fee);
+        }
+        emit Transfer(from, to, amount - fee);
+    }
+}
