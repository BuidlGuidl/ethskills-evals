+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test} from "forge-std/Test.sol";
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+import {MockUSDT} from "../mocks/MockUSDT.sol";
+import {MockAavePool, MockAToken} from "../mocks/MockAavePool.sol";
+
+/// @notice Drives deposit/withdraw/setDepositFee from three actors.
+contract Handler is Test {
+    UsdtYieldVault public vault;
+    MockUSDT public usdt;
+    address[3] public actors;
+    uint256 public totalIn;
+    uint256 public totalOut;
+
+    constructor(UsdtYieldVault _vault, MockUSDT _usdt, address[3] memory _actors) {
+        vault = _vault;
+        usdt = _usdt;
+        actors = _actors;
+    }
+
+    function _actor(uint256 seed) internal view returns (address) {
+        return actors[seed % 3];
+    }
+
+    function deposit(uint256 seed, uint256 amount) external {
+        address a = _actor(seed);
+        amount = bound(amount, 1e6, 100_000e6);
+        if (usdt.balanceOf(a) < amount) return;
+        vm.prank(a);
+        try vault.deposit(amount) {
+            totalIn += amount;
+        } catch {}
+    }
+
+    function withdraw(uint256 seed, uint256 shares) external {
+        address a = _actor(seed);
+        uint256 bal = vault.shareBalance(a);
+        if (bal == 0) return;
+        shares = bound(shares, 1, bal);
+        vm.prank(a);
+        try vault.withdraw(shares) returns (uint256 out) {
+            totalOut += out;
+        } catch {}
+    }
+
+    function setFee(uint256 newFee) external {
+        newFee = bound(newFee, 0, 10_000);
+        vm.prank(vault.owner());
+        vault.setDepositFee(newFee);
+    }
+}
+
+contract VaultInvariantsTest is Test {
+    UsdtYieldVault vault;
+    MockUSDT usdt;
+    MockAavePool pool;
+    MockAToken aUsdt;
+    Handler handler;
+
+    address[3] actors;
+
+    function setUp() public {
+        usdt = new MockUSDT();
+        pool = new MockAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 10, address(this));
+
+        actors = [makeAddr("a1"), makeAddr("a2"), makeAddr("a3")];
+        for (uint256 i = 0; i < 3; i++) {
+            usdt.mint(actors[i], 1_000_000e6);
+            vm.prank(actors[i]);
+            usdt.approve(address(vault), type(uint256).max);
+        }
+
+        handler = new Handler(vault, usdt, actors);
+        vault.transferOwnership(address(handler));
+        targetContract(address(handler));
+    }
+
+    /// @notice The vault must always hold enough aUSDT to cover its own books.
+    function invariant_Solvent() public view {
+        assertGe(aUsdt.balanceOf(address(vault)), vault.totalAssetsStored(), "vault books exceed its Aave position");
+    }
+
+    /// @notice Every shareholder's claim together must fit inside the vault's assets.
+    function invariant_ClaimsFitAssets() public view {
+        uint256 sum;
+        for (uint256 i = 0; i < 3; i++) {
+            sum += vault.convertToAssets(vault.shareBalance(actors[i]));
+        }
+        assertLe(sum, vault.totalAssetsStored(), "shareholder claims exceed vault assets");
+    }
+
+    /// @notice Money out must never exceed money in: the mock Aave pays no interest,
+    ///         so any excess is value conjured out of the accounting.
+    function invariant_NoValueCreation() public view {
+        assertLe(handler.totalOut(), handler.totalIn(), "vault paid out more than it took in");
+    }
+
+    /// @notice If anyone still holds shares, the share price must be meaningful.
+    function invariant_SharePriceSane() public view {
+        if (vault.totalShares() == 0) return;
+        assertGt(vault.sharePrice(), 0, "share price collapsed to zero while shares exist");
+    }
+}
