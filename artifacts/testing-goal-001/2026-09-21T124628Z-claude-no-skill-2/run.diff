+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test} from "forge-std/Test.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+import {MockAavePool, MockAToken} from "../mocks/MockAavePool.sol";
+import {UsdtReplica} from "./UsdtReplica.sol";
+
+/// @notice Offline twin of the mainnet-fork findings, for reviewers without an RPC.
+contract UsdtReplicaTest is Test {
+    UsdtYieldVault vault;
+    UsdtReplica usdt;
+    MockAavePool pool;
+    MockAToken aUsdt;
+
+    address alice = makeAddr("alice");
+
+    function setUp() public {
+        usdt = new UsdtReplica();
+        pool = new MockAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 0, address(this));
+
+        usdt.mint(alice, 100_000e6);
+        vm.prank(alice);
+        usdt.approve(address(vault), type(uint256).max);
+    }
+
+    /// @notice Depositing must work against a token with USDT's actual ABI.
+    function test_DepositWorksAgainstUsdtAbi() public {
+        vm.prank(alice);
+        uint256 shares = vault.deposit(1_000e6);
+        assertGt(shares, 0);
+    }
+
+    /// @notice And must stay correct if Tether re-enables its transfer fee.
+    /// @dev Isolates the fee from the return-data problem by patching only the
+    ///      allowance path the vault cannot reach: we pre-fund and pre-approve the
+    ///      pool, then assert on what the vault's books claim versus what it holds.
+    function test_BooksMatchAaveWhenTetherChargesATransferFee() public {
+        usdt.setParams(10, 50); // 10 bps, capped at 50 USDT - within Tether's own limits
+
+        uint256 amount = 1_000e6;
+        uint256 fee = amount * 10 / 10_000;
+
+        // Simulate the transferFrom the vault performs, then the supply it performs.
+        vm.prank(alice);
+        usdt.transfer(address(vault), amount);
+        assertEq(usdt.balanceOf(address(vault)), amount - fee, "vault received less than `amount`");
+
+        emit log_named_uint("vault asked to supply (amount)", amount);
+        emit log_named_uint("vault actually received       ", amount - fee);
+        emit log_named_uint("shortfall per deposit         ", fee);
+
+        // deposit() would now call supply(usdt, amount, ...) for USDT it does not have.
+        assertGe(usdt.balanceOf(address(vault)), amount, "vault cannot supply the amount it books");
+    }
+}

