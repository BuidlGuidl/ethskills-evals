+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test} from "forge-std/Test.sol";
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+
+/// @notice Mainnet-fork test against the REAL USDT and the REAL Aave V3 pool
+///         listed in README.md. Nothing is mocked.
+contract RealUsdtDepositForkTest is Test {
+    address constant USDT = 0xdAC17F958D2ee523a2206206994597C13D831ec7;
+    address constant AUSDT = 0x23878914EFE38d27C4D67Ab83ed1b93A74D4086a;
+    address constant AAVE_POOL = 0x87870Bca3F3fD6335C3F4ce8392D69350B4fA4E2;
+
+    UsdtYieldVault vault;
+    address alice = makeAddr("alice");
+
+    function setUp() public {
+        vm.createSelectFork(vm.envString("ETH_RPC_URL")); // latest block: public RPCs here serve no archive state
+        vault = new UsdtYieldVault(USDT, AUSDT, AAVE_POOL, 10, address(this));
+
+        deal(USDT, alice, 10_000e6);
+        vm.prank(alice);
+        // USDT.approve returns no data, so it must be called through the raw ABI.
+        (bool ok,) = USDT.call(abi.encodeWithSignature("approve(address,uint256)", address(vault), type(uint256).max));
+        require(ok, "alice approve failed");
+    }
+
+    /// @notice The happy path that every mock-based test covers, run against real USDT.
+    function test_RealUsdt_Deposit() public {
+        vm.prank(alice);
+        uint256 shares = vault.deposit(1_000e6);
+        assertGt(shares, 0, "deposit minted no shares");
+    }
+}
