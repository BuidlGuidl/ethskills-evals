index 0000000..2c3a491
--- /dev/null
+++ b/test/review/ForkMainnet.t.sol
@@ -0,0 +1,117 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test} from "forge-std/Test.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+import {IAavePool} from "../../src/interfaces/IAavePool.sol";
+
+/// @notice Control rig: supplies USDT to the real Aave V3 pool the way the
+///         vault should have, so that a failure in the vault cannot be blamed
+///         on the fork, on Aave, or on the test setup.
+contract AaveControl {
+    using SafeERC20 for IERC20;
+
+    function supplyWithForceApprove(address usdt, address pool, uint256 amount) external {
+        IERC20(usdt).safeTransferFrom(msg.sender, address(this), amount);
+        IERC20(usdt).forceApprove(pool, amount);
+        IAavePool(pool).supply(usdt, amount, address(this), 0);
+    }
+}
+
+/// @notice Runs UsdtYieldVault against the exact mainnet addresses from README.md.
+/// @dev forge test --match-path test/review/ForkMainnet.t.sol \
+///        --fork-url https://eth.drpc.org --fork-block-number 25845000 -vv
+contract ForkMainnetTest is Test {
+    address internal constant USDT = 0xdAC17F958D2ee523a2206206994597C13D831ec7;
+    address internal constant AAVE_POOL = 0x87870Bca3F3fD6335C3F4ce8392D69350B4fA4E2;
+    address internal constant AUSDT = 0x23878914EFE38d27C4D67Ab83ed1b93A74D4086a;
+
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+
+    UsdtYieldVault internal vault;
+
+    function setUp() public {
+        vault = new UsdtYieldVault(USDT, AUSDT, AAVE_POOL, 10, owner);
+        deal(USDT, alice, 100_000e6);
+    }
+
+    /// The mainnet USDT `approve` returns zero bytes of return data.
+    function test_Fork_Evidence_UsdtApproveReturnsNoData() public {
+        vm.prank(alice);
+        (bool ok, bytes memory ret) =
+            USDT.call(abi.encodeWithSignature("approve(address,uint256)", address(vault), uint256(1e6)));
+        assertTrue(ok, "raw approve succeeds");
+        assertEq(ret.length, 0, "mainnet USDT.approve returns no data");
+        assertEq(IERC20(USDT).allowance(alice, address(vault)), 1e6, "allowance was still written");
+    }
+
+    /// Control: the real Aave V3 pool accepts real USDT when approval is done
+    /// with SafeERC20.forceApprove. So the pool, the asset and the fork are fine.
+    function test_Fork_Control_RealAaveAcceptsRealUsdt() public {
+        AaveControl control = new AaveControl();
+
+        vm.startPrank(alice);
+        (bool ok,) = USDT.call(abi.encodeWithSignature("approve(address,uint256)", address(control), uint256(1_000e6)));
+        require(ok, "approve failed");
+        control.supplyWithForceApprove(USDT, AAVE_POOL, 1_000e6);
+        vm.stopPrank();
+
+        emit log_named_uint("aUSDT minted to control rig", IERC20(AUSDT).balanceOf(address(control)));
+        assertApproxEqAbs(IERC20(AUSDT).balanceOf(address(control)), 1_000e6, 1, "Aave supply works");
+    }
+
+    /// F-9: Aave credits fewer aTokens than the amount supplied, because the
+    /// supplied amount is divided by the reserve's liquidity index and rounded
+    /// down. `deposit` credits `totalAssetsStored` the full nominal amount.
+    function test_Fork_Evidence_AaveCreditsLessThanSupplied() public {
+        AaveControl control = new AaveControl();
+
+        vm.startPrank(alice);
+        (bool ok,) = USDT.call(abi.encodeWithSignature("approve(address,uint256)", address(control), uint256(1_000e6)));
+        require(ok, "approve failed");
+        control.supplyWithForceApprove(USDT, AAVE_POOL, 1_000e6);
+        vm.stopPrank();
+
+        uint256 credited = IERC20(AUSDT).balanceOf(address(control));
+        emit log_named_uint("USDT supplied to Aave      ", 1_000e6);
+        emit log_named_uint("aUSDT credited by Aave     ", credited);
+        emit log_named_uint("shortfall the vault records", 1_000e6 - credited);
+        assertLt(credited, 1_000e6, "Aave credits strictly less than supplied");
+    }
+
+    /// F-1: a deposit of real USDT into the vault must succeed on mainnet.
+    function test_Fork_Spec_DepositWorksOnMainnet() public {
+        vm.startPrank(alice);
+        (bool ok,) =
+            USDT.call(abi.encodeWithSignature("approve(address,uint256)", address(vault), type(uint256).max));
+        require(ok, "approve failed");
+
+        uint256 shares = vault.deposit(1_000e6);
+        vm.stopPrank();
+
+        assertGt(shares, 0, "deposit must mint shares");
+        assertApproxEqAbs(IERC20(AUSDT).balanceOf(address(vault)), 1_000e6, 1, "vault must hold aUSDT");
+    }
+
+    /// F-1 supporting evidence: deposit() reverts, and it reverts with empty
+    /// revert data - the signature of a failed return-data decode, not of an
+    /// Aave or USDT require().
+    function test_Fork_Evidence_DepositRevertsOnMainnet() public {
+        vm.startPrank(alice);
+        (bool ok,) =
+            USDT.call(abi.encodeWithSignature("approve(address,uint256)", address(vault), type(uint256).max));
+        require(ok, "approve failed");
+
+        (bool depositOk, bytes memory err) =
+            address(vault).call(abi.encodeWithSelector(UsdtYieldVault.deposit.selector, uint256(1_000e6)));
+        vm.stopPrank();
+
+        assertFalse(depositOk, "deposit reverts against mainnet USDT");
+        assertEq(err.length, 0, "revert carries no data (ABI decode failure)");
+        assertEq(IERC20(USDT).balanceOf(alice), 100_000e6, "alice keeps her USDT; nothing was deposited");
+    }
+}
