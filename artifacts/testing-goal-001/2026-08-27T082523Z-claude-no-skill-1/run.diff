@@ -0,0 +1,407 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, stdError} from "forge-std/Test.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {Pausable} from "@openzeppelin/contracts/utils/Pausable.sol";
+
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+import {MockUSDT} from "../mocks/MockUSDT.sol";
+import {RealisticUSDT} from "./RealisticUSDT.sol";
+import {FeeSwitchUSDT} from "./FeeSwitchUSDT.sol";
+import {YieldingAavePool, RebasingAToken} from "./YieldingAavePool.sol";
+
+/// @notice Properties the vault must hold before it can take real deposits.
+/// @dev Tests prefixed `test_Spec_` state the required behaviour and FAIL
+///      against src/UsdtYieldVault.sol as it stands. Tests prefixed
+///      `test_Evidence_` / `test_Exploit_` PASS and pin down the broken
+///      behaviour they observe.
+contract UsdtYieldVaultSpecTest is Test {
+    address public owner = makeAddr("owner");
+    address public alice = makeAddr("alice");
+    address public bob = makeAddr("bob");
+
+    uint256 internal constant FEE_BPS = 10;
+
+    /*//////////////////////////////////////////////////////////////
+        F-1  the deployed USDT ABI: approve() returns nothing
+    //////////////////////////////////////////////////////////////*/
+
+    function _realUsdtRig() internal returns (RealisticUSDT usdt, YieldingAavePool pool, UsdtYieldVault vault) {
+        usdt = new RealisticUSDT();
+        pool = new YieldingAavePool(address(usdt));
+        vault = new UsdtYieldVault(address(usdt), address(pool.aToken()), address(pool), FEE_BPS, owner);
+        usdt.mint(alice, 100_000e6);
+        vm.prank(alice);
+        usdt.approve(address(vault), type(uint256).max);
+    }
+
+    /// F-1: a deposit of real USDT must succeed.
+    function test_Spec_DepositWorksAgainstRealUsdtAbi() public {
+        (,, UsdtYieldVault vault) = _realUsdtRig();
+        vm.prank(alice);
+        uint256 shares = vault.deposit(1_000e6);
+        assertGt(shares, 0, "deposit must mint shares");
+    }
+
+    /// F-1 supporting evidence: USDT.approve returns zero bytes, so the
+    /// bool-decoding high-level call inside deposit() always reverts.
+    function test_Evidence_RealUsdtApproveReturnsNoData() public {
+        (RealisticUSDT usdt,,) = _realUsdtRig();
+
+        (bool ok, bytes memory ret) =
+            address(usdt).call(abi.encodeWithSignature("approve(address,uint256)", bob, 1e6));
+        assertTrue(ok, "raw approve call itself succeeds");
+        assertEq(ret.length, 0, "USDT.approve returns no data");
+
+        // ...and the identical call made through IERC20 - which is what
+        // UsdtYieldVault.deposit does at line 94 - reverts while decoding the
+        // bool that is not there.
+        ApproveProber prober = new ApproveProber();
+        (bool decoded,) = address(prober).call(
+            abi.encodeWithSelector(ApproveProber.approveViaIERC20.selector, address(usdt), bob, uint256(0))
+        );
+        assertFalse(decoded, "IERC20(USDT).approve reverts on return-data decoding");
+    }
+
+    /// F-1 supporting evidence: the revert happens inside deposit().
+    function test_Evidence_DepositRevertsAgainstRealUsdtAbi() public {
+        (,, UsdtYieldVault vault) = _realUsdtRig();
+        vm.prank(alice);
+        vm.expectRevert();
+        vault.deposit(1_000e6);
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        F-2  Aave interest never reaches depositors
+    //////////////////////////////////////////////////////////////*/
+
+    function _yieldRig() internal returns (MockUSDT usdt, YieldingAavePool pool, UsdtYieldVault vault) {
+        usdt = new MockUSDT();
+        pool = new YieldingAavePool(address(usdt));
+        vault = new UsdtYieldVault(address(usdt), address(pool.aToken()), address(pool), FEE_BPS, owner);
+        usdt.mint(alice, 100_000e6);
+        usdt.mint(bob, 100_000e6);
+        usdt.mint(owner, 100_000e6);
+        vm.prank(alice);
+        usdt.approve(address(vault), type(uint256).max);
+        vm.prank(bob);
+        usdt.approve(address(vault), type(uint256).max);
+        vm.prank(owner);
+        usdt.approve(address(vault), type(uint256).max);
+    }
+
+    /// F-2: 10% of Aave interest must be claimable by the depositor who earned it.
+    function test_Spec_AaveInterestReachesDepositors() public {
+        (, YieldingAavePool pool, UsdtYieldVault vault) = _yieldRig();
+
+        vm.prank(alice);
+        vault.deposit(1_000e6);
+
+        pool.accrueInterest(1_000); // +10% liquidity index
+
+        RebasingAToken aUsdt = pool.aToken();
+        emit log_named_uint("aUSDT held by vault      ", aUsdt.balanceOf(address(vault)));
+        emit log_named_uint("vault.totalAssets()      ", vault.totalAssets());
+        emit log_named_uint("alice balanceOfUnderlying", vault.balanceOfUnderlying(alice));
+
+        assertApproxEqAbs(vault.balanceOfUnderlying(alice), 1_100e6, 1e6, "alice must earn the Aave interest");
+    }
+
+    /// F-2 supporting evidence: interest accrues to nobody.
+    function test_Evidence_InterestIsIgnoredByAccounting() public {
+        (, YieldingAavePool pool, UsdtYieldVault vault) = _yieldRig();
+
+        vm.prank(alice);
+        uint256 shares = vault.deposit(1_000e6);
+        pool.accrueInterest(1_000);
+
+        assertEq(vault.totalAssets(), 1_000e6, "totalAssets ignores the aToken balance");
+        assertEq(vault.balanceOfUnderlying(alice), 1_000e6, "alice's claim did not move");
+
+        vm.prank(alice);
+        uint256 out = vault.withdraw(shares);
+        assertEq(out, 997e6, "alice exits with her principal minus fee, no interest");
+        assertEq(pool.aToken().balanceOf(address(vault)), 103e6, "100 USDT interest + 3 USDT fee left behind");
+        assertEq(vault.totalShares(), 0, "no shares left that could ever claim it");
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        F-3  withdrawal fee is destroyed, not redistributed
+    //////////////////////////////////////////////////////////////*/
+
+    /// F-3: README - "Both fees stay supplied in Aave and accrue to the
+    /// remaining shareholders". Bob must be better off after Alice pays a fee.
+    function test_Spec_WithdrawFeeAccruesToRemainingShareholders() public {
+        (,, UsdtYieldVault vault) = _yieldRig();
+
+        vm.prank(alice);
+        uint256 aliceShares = vault.deposit(1_000e6);
+        vm.prank(bob);
+        vault.deposit(1_000e6);
+
+        uint256 bobBefore = vault.balanceOfUnderlying(bob);
+        uint256 aliceGross = vault.convertToAssets(aliceShares);
+        uint256 aliceExitFee = (aliceGross * vault.WITHDRAW_FEE_BPS()) / vault.BPS_DENOMINATOR();
+
+        vm.prank(alice);
+        vault.withdraw(aliceShares);
+
+        uint256 bobAfter = vault.balanceOfUnderlying(bob);
+        emit log_named_uint("alice's 0.3% exit fee   ", aliceExitFee);
+        emit log_named_uint("bob claim before her exit", bobBefore);
+        emit log_named_uint("bob claim after  her exit", bobAfter);
+        emit log_named_uint("bob actually gained      ", bobAfter - bobBefore);
+
+        assertApproxEqAbs(bobAfter - bobBefore, aliceExitFee, 1, "alice's exit fee must accrue to bob");
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        F-4  assets are stranded with no share backing them
+    //////////////////////////////////////////////////////////////*/
+
+    /// F-4: once every share is burned, nothing may be left behind in Aave.
+    function test_Spec_NothingIsStrandedAfterFullExit() public {
+        (, YieldingAavePool pool, UsdtYieldVault vault) = _yieldRig();
+
+        vm.prank(alice);
+        uint256 aliceShares = vault.deposit(10_000e6);
+        vm.prank(bob);
+        uint256 bobShares = vault.deposit(10_000e6);
+
+        pool.accrueInterest(500); // +5%
+
+        vm.prank(alice);
+        vault.withdraw(aliceShares);
+        vm.prank(bob);
+        vault.withdraw(bobShares);
+
+        uint256 stranded = pool.aToken().balanceOf(address(vault));
+        emit log_named_uint("totalShares after full exit", vault.totalShares());
+        emit log_named_uint("USDT stranded in the vault ", stranded);
+
+        assertLe(stranded, 1, "no USDT may be left unclaimable");
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        F-5  unbounded depositFeeBps lets the owner seize deposits
+    //////////////////////////////////////////////////////////////*/
+
+    /// F-5: the owner must not be able to take a depositor's principal.
+    function test_Spec_OwnerCannotSeizeAnIncomingDeposit() public {
+        (,, UsdtYieldVault vault) = _yieldRig();
+
+        vm.prank(owner);
+        vault.deposit(1_000e6);
+
+        // owner front-runs alice's deposit
+        vm.prank(owner);
+        vault.setDepositFee(9_999);
+
+        vm.prank(alice);
+        uint256 aliceShares = vault.deposit(100_000e6);
+
+        vm.prank(alice);
+        uint256 aliceOut = vault.withdraw(aliceShares);
+
+        emit log_named_uint("alice deposited", 100_000e6);
+        emit log_named_uint("alice got back ", aliceOut);
+
+        assertGe(aliceOut, 99_000e6, "alice must keep her principal");
+    }
+
+    /// F-5 exploit, passing: 1,000 USDT of owner capital extracts ~99,700 USDT.
+    function test_Exploit_OwnerStealsDepositViaFeeFrontRun() public {
+        (MockUSDT usdt,, UsdtYieldVault vault) = _yieldRig();
+
+        uint256 ownerStart = usdt.balanceOf(owner);
+        uint256 aliceStart = usdt.balanceOf(alice);
+
+        vm.prank(owner);
+        uint256 ownerShares = vault.deposit(1_000e6);
+
+        vm.prank(owner);
+        vault.setDepositFee(9_999); // front-run, still < BPS_DENOMINATOR
+
+        vm.prank(alice);
+        uint256 aliceShares = vault.deposit(100_000e6);
+
+        vm.prank(owner);
+        vault.setDepositFee(FEE_BPS); // restore, hide the trace
+
+        vm.prank(owner);
+        vault.withdraw(ownerShares);
+        vm.prank(alice);
+        vault.withdraw(aliceShares);
+
+        int256 ownerPnl = int256(usdt.balanceOf(owner)) - int256(ownerStart);
+        int256 alicePnl = int256(usdt.balanceOf(alice)) - int256(aliceStart);
+        emit log_named_int("owner P&L (USDT base units)", ownerPnl);
+        emit log_named_int("alice P&L (USDT base units)", alicePnl);
+
+        assertGt(ownerPnl, int256(98_000e6), "owner profits from alice's principal");
+        assertLt(alicePnl, -int256(98_000e6), "alice loses ~99% of her deposit");
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        F-6  depositFeeBps above 100% bricks deposits
+    //////////////////////////////////////////////////////////////*/
+
+    /// F-6: no owner-settable value may make deposit() unusable.
+    function test_Spec_DepositSurvivesAnyOwnerFeeSetting() public {
+        (,, UsdtYieldVault vault) = _yieldRig();
+
+        vm.prank(owner);
+        vault.setDepositFee(10_001); // fat finger: 100.01%
+
+        vm.prank(alice);
+        vault.deposit(1_000e6);
+    }
+
+    /// F-6 supporting evidence: it is an arithmetic panic, not a clean revert.
+    function test_Evidence_FeeAbove100PercentPanics() public {
+        (,, UsdtYieldVault vault) = _yieldRig();
+        vm.prank(owner);
+        vault.setDepositFee(10_001);
+        vm.prank(alice);
+        vm.expectRevert(stdError.arithmeticError);
+        vault.deposit(1_000e6);
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        F-7  pause() gates withdraw(), and ownership can be renounced
+    //////////////////////////////////////////////////////////////*/
+
+    /// F-7: depositors must always be able to exit.
+    function test_Spec_DepositorsCanExitWhilePaused() public {
+        (,, UsdtYieldVault vault) = _yieldRig();
+
+        vm.prank(alice);
+        uint256 shares = vault.deposit(1_000e6);
+
+        vm.startPrank(owner);
+        vault.pause();
+        vault.renounceOwnership(); // inherited from Ownable, no override
+        vm.stopPrank();
+
+        assertEq(vault.owner(), address(0), "no one can ever unpause again");
+
+        vm.prank(alice);
+        vault.withdraw(shares);
+    }
+
+    /// F-7 supporting evidence: the funds are permanently frozen.
+    function test_Evidence_PauseThenRenounceFreezesFundsForever() public {
+        (,, UsdtYieldVault vault) = _yieldRig();
+        vm.prank(alice);
+        uint256 shares = vault.deposit(1_000e6);
+
+        vm.startPrank(owner);
+        vault.pause();
+        vault.renounceOwnership();
+        vm.stopPrank();
+
+        vm.prank(alice);
+        vm.expectRevert(Pausable.EnforcedPause.selector);
+        vault.withdraw(shares);
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        F-8  USDT's fee switch breaks deposit accounting
+    //////////////////////////////////////////////////////////////*/
+
+    /// F-8: deposits must still work if Tether re-enables its transfer fee.
+    function test_Spec_DepositWorksWhenUsdtChargesTransferFee() public {
+        FeeSwitchUSDT usdt = new FeeSwitchUSDT();
+        YieldingAavePool pool = new YieldingAavePool(address(usdt));
+        UsdtYieldVault vault =
+            new UsdtYieldVault(address(usdt), address(pool.aToken()), address(pool), FEE_BPS, owner);
+
+        usdt.mint(alice, 100_000e6);
+        vm.prank(alice);
+        usdt.approve(address(vault), type(uint256).max);
+
+        usdt.setParams(10, 30); // Tether's own bounds: 10 bps, capped at 30 USDT
+
+        vm.prank(alice);
+        vault.deposit(1_000e6);
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        F-9  dust withdrawals hit Aave's zero-amount validation
+    //////////////////////////////////////////////////////////////*/
+
+    /// F-9: a withdrawal that the vault accepts must not revert inside Aave.
+    function test_Spec_DustWithdrawDoesNotRevertInAave() public {
+        (,, UsdtYieldVault vault) = _yieldRig();
+
+        vm.prank(alice);
+        vault.deposit(1_000e6);
+
+        vm.prank(alice);
+        vault.withdraw(1e6); // 1e-12 of a share: rounds to 0 USDT
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        checks that PASS - recorded so the report is even-handed
+    //////////////////////////////////////////////////////////////*/
+
+    /// With a static liquidity index the vault is never under-collateralised.
+    /// (The interest-accruing case is covered by invariant_A, which FAILS.)
+    function testFuzz_SolventWhenNoInterestAccrues(uint96 a, uint96 b) public {
+        (, YieldingAavePool pool, UsdtYieldVault vault) = _yieldRig();
+        uint256 depA = bound(uint256(a), 1e6, 50_000e6);
+        uint256 depB = bound(uint256(b), 1e6, 50_000e6);
+
+        vm.prank(alice);
+        uint256 sa = vault.deposit(depA);
+        vm.prank(bob);
+        vault.deposit(depB);
+        vm.prank(alice);
+        vault.withdraw(sa);
+
+        assertGe(pool.aToken().balanceOf(address(vault)), vault.totalAssetsStored());
+    }
+
+    /// A deposit-then-withdraw round trip never profits the user (no rounding leak).
+    function testFuzz_RoundTripNeverProfits(uint96 amount) public {
+        (MockUSDT usdt,, UsdtYieldVault vault) = _yieldRig();
+        uint256 dep = bound(uint256(amount), 1e6, 100_000e6);
+
+        uint256 before = usdt.balanceOf(alice);
+        vm.prank(alice);
+        uint256 shares = vault.deposit(dep);
+        vm.prank(alice);
+        vault.withdraw(shares);
+
+        assertLe(usdt.balanceOf(alice), before, "round trip must not mint value");
+    }
+
+    /// First-depositor share inflation via a direct aToken donation is not
+    /// possible, because pricing reads storage rather than a token balance.
+    function test_DonationCannotInflateSharePrice() public {
+        (MockUSDT usdt, YieldingAavePool pool, UsdtYieldVault vault) = _yieldRig();
+
+        vm.prank(alice);
+        vault.deposit(1e6); // MIN_DEPOSIT
+
+        // attacker donates 10,000 USDT of aUSDT straight to the vault
+        vm.startPrank(bob);
+        usdt.approve(address(pool), type(uint256).max);
+        pool.supply(address(usdt), 10_000e6, address(vault), 0);
+        vm.stopPrank();
+
+        vm.prank(bob);
+        uint256 bobShares = vault.deposit(1_000e6);
+        assertGt(bobShares, 0, "donation does not round the next depositor to zero shares");
+        assertEq(vault.totalAssetsStored(), 1_001e6, "donation is invisible to pricing");
+    }
+}
+
+/// @notice Helper so that the ABI-decode revert happens in a sub-call frame
+///         and can be observed, exactly as it happens inside the vault.
+contract ApproveProber {
+    function approveViaIERC20(address token, address spender, uint256 value) external {
+        IERC20(token).approve(spender, value);
+    }
+}
diff --git a/test/review/VaultInvariants.t.sol b/test/review/VaultInvariants.t.sol
new file mode 100644
index 0000000..9b412d8
--- /dev/null
+++ b/test/review/VaultInvariants.t.sol
@@ -0,0 +1,107 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test} from "forge-std/Test.sol";
+
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+import {MockUSDT} from "../mocks/MockUSDT.sol";
+import {YieldingAavePool, RebasingAToken} from "./YieldingAavePool.sol";
+
+contract VaultHandler is Test {
+    UsdtYieldVault public vault;
+    MockUSDT public usdt;
+    YieldingAavePool public pool;
+
+    address[3] public actors;
+
+    constructor(UsdtYieldVault _vault, MockUSDT _usdt, YieldingAavePool _pool) {
+        vault = _vault;
+        usdt = _usdt;
+        pool = _pool;
+        actors = [makeAddr("a1"), makeAddr("a2"), makeAddr("a3")];
+        for (uint256 i; i < actors.length; ++i) {
+            usdt.mint(actors[i], 1_000_000e6);
+            vm.prank(actors[i]);
+            usdt.approve(address(vault), type(uint256).max);
+        }
+    }
+
+    function _actor(uint256 seed) internal view returns (address) {
+        return actors[seed % actors.length];
+    }
+
+    function deposit(uint256 actorSeed, uint256 amount) external {
+        address actor = _actor(actorSeed);
+        amount = bound(amount, 1e6, 100_000e6);
+        if (usdt.balanceOf(actor) < amount) return;
+        if (vault.convertToShares(amount - (amount * vault.depositFeeBps()) / 10_000) == 0) return;
+        vm.prank(actor);
+        vault.deposit(amount);
+    }
+
+    function withdraw(uint256 actorSeed, uint256 shareSeed) external {
+        address actor = _actor(actorSeed);
+        uint256 held = vault.shareBalance(actor);
+        if (held == 0) return;
+        uint256 shares = bound(shareSeed, 1, held);
+        uint256 gross = vault.convertToAssets(shares);
+        if (gross == 0) return; // real Aave rejects a zero-amount withdrawal
+        if (gross - (gross * 30) / 10_000 == 0) return;
+        vm.prank(actor);
+        vault.withdraw(shares);
+    }
+
+    function accrueInterest(uint256 bps) external {
+        pool.accrueInterest(bound(bps, 0, 50));
+    }
+
+    function sumShareBalances() external view returns (uint256 total) {
+        for (uint256 i; i < actors.length; ++i) {
+            total += vault.shareBalance(actors[i]);
+        }
+    }
+}
+
+/// @notice Stateful invariants over random deposit / withdraw / interest sequences.
+contract VaultInvariantsTest is Test {
+    UsdtYieldVault internal vault;
+    MockUSDT internal usdt;
+    YieldingAavePool internal pool;
+    RebasingAToken internal aUsdt;
+    VaultHandler internal handler;
+
+    function setUp() public {
+        usdt = new MockUSDT();
+        pool = new YieldingAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 10, makeAddr("owner"));
+        handler = new VaultHandler(vault, usdt, pool);
+        targetContract(address(handler));
+    }
+
+    /// FAILS: totalAssetsStored can exceed the aUSDT actually redeemable,
+    /// because deposit() credits the full nominal amount while Aave credits it
+    /// scaled down by the liquidity index.
+    function invariant_A_TrackedAssetsAreActuallyRedeemable() public view {
+        assertGe(aUsdt.balanceOf(address(vault)), vault.totalAssetsStored());
+    }
+
+    /// HOLDS: share accounting is internally consistent.
+    function invariant_B_SharesSumToTotalShares() public view {
+        assertEq(handler.sumShareBalances(), vault.totalShares());
+    }
+
+    /// FAILS: value piles up in Aave that no share can ever redeem.
+    function invariant_C_NoUnredeemableAssets() public view {
+        uint256 held = aUsdt.balanceOf(address(vault));
+        uint256 tracked = vault.totalAssetsStored();
+        uint256 leak = held > tracked ? held - tracked : 0;
+        assertLe(leak, 1e6, "more than 1 USDT in Aave that no share can redeem");
+    }
+
+    /// FAILS: with every share burned, the vault must be empty.
+    function invariant_D_EmptyVaultHoldsNothing() public view {
+        if (vault.totalShares() != 0) return;
+        assertLe(aUsdt.balanceOf(address(vault)), 1, "vault has no shares but still holds USDT");
+    }
+}
diff --git a/test/review/YieldingAavePool.sol b/test/review/YieldingAavePool.sol
new file mode 100644
index 0000000..f63043c
--- /dev/null
+++ b/test/review/YieldingAavePool.sol
@@ -0,0 +1,89 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+
+import {IAavePool} from "../../src/interfaces/IAavePool.sol";
+
+/// @notice Rebasing aToken, matching how the real aUSDT balance grows with the
+///         reserve's liquidity index. `MockAToken` in test/mocks is static and
+///         therefore never exercises interest accrual.
+contract RebasingAToken {
+    string public constant name = "Aave Ethereum USDT";
+    string public constant symbol = "aEthUSDT";
+    uint8 public constant decimals = 6;
+
+    address public immutable pool;
+    uint256 public index = 1e27; // ray, like Aave's liquidityIndex
+    mapping(address => uint256) public scaledBalanceOf;
+    uint256 public scaledTotalSupply;
+
+    constructor(address _pool) {
+        pool = _pool;
+    }
+
+    function balanceOf(address account) public view returns (uint256) {
+        return (scaledBalanceOf[account] * index) / 1e27;
+    }
+
+    function totalSupply() external view returns (uint256) {
+        return (scaledTotalSupply * index) / 1e27;
+    }
+
+    function mint(address to, uint256 amount) external {
+        require(msg.sender == pool, "only pool");
+        uint256 scaled = (amount * 1e27) / index;
+        scaledBalanceOf[to] += scaled;
+        scaledTotalSupply += scaled;
+    }
+
+    function burn(address from, uint256 amount) external {
+        require(msg.sender == pool, "only pool");
+        uint256 scaled = (amount * 1e27) / index;
+        scaledBalanceOf[from] -= scaled;
+        scaledTotalSupply -= scaled;
+    }
+
+    /// @notice Grow every holder's balance by `bps` basis points.
+    function accrue(uint256 bps) external {
+        index += (index * bps) / 10_000;
+    }
+}
+
+/// @notice Aave V3 pool stand-in that (a) pays interest and (b) applies the
+///         same input validation as the real pool.
+contract YieldingAavePool is IAavePool {
+    using SafeERC20 for IERC20;
+
+    IERC20 public immutable underlying;
+    RebasingAToken public immutable aToken;
+
+    constructor(address _underlying) {
+        underlying = IERC20(_underlying);
+        aToken = new RebasingAToken(address(this));
+    }
+
+    function supply(address, uint256 amount, address onBehalfOf, uint16) external override {
+        require(amount != 0, "26"); // Errors.INVALID_AMOUNT
+        underlying.safeTransferFrom(msg.sender, address(this), amount);
+        aToken.mint(onBehalfOf, amount);
+    }
+
+    function withdraw(address, uint256 amount, address to) external override returns (uint256) {
+        require(amount != 0, "26"); // Errors.INVALID_AMOUNT
