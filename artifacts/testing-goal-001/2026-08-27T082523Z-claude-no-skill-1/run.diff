@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {ERC20} from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+
+/// @notice USDT with its `basisPointsRate` transfer fee switched on, but with
+///         standard bool-returning ERC20 signatures.
+/// @dev The bool returns are NOT realistic — they are here only so that the
+///      fee-on-transfer bug can be reached at all. Against the genuine USDT
+///      ABI the vault reverts earlier, inside `usdt.approve` (see F-1), which
+///      would mask this second defect.
+contract FeeSwitchUSDT is ERC20 {
+    uint256 public basisPointsRate;
+    uint256 public maximumFee;
+    address public feeCollector;
+
+    constructor() ERC20("Tether USD", "USDT") {
+        feeCollector = msg.sender;
+    }
+
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    function mint(address to, uint256 amount) external {
+        _mint(to, amount);
+    }
+
+    /// @dev Mirrors TetherToken.setParams bounds: bps < 20, maxFee < 50 USDT.
+    function setParams(uint256 newBasisPoints, uint256 newMaxFee) external {
+        require(newBasisPoints < 20 && newMaxFee < 50, "out of bounds");
+        basisPointsRate = newBasisPoints;
+        maximumFee = newMaxFee * 1e6;
+    }
+
+    function _update(address from, address to, uint256 value) internal override {
+        if (from == address(0) || to == address(0) || basisPointsRate == 0) {
+            super._update(from, to, value);
+            return;
+        }
+        uint256 fee = (value * basisPointsRate) / 10_000;
+        if (fee > maximumFee) fee = maximumFee;
+        super._update(from, feeCollector, fee);
+        super._update(from, to, value - fee);
+    }
+}
diff --git a/test/review/ForkMainnet.t.sol b/test/review/ForkMainnet.t.sol
