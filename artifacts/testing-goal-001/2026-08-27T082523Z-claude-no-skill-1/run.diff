@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+/// @notice Faithful stand-in for the deployed USDT at
+///         0xdAC17F958D2ee523a2206206994597C13D831ec7.
+/// @dev Reproduces the three behaviours that the suite's `MockUSDT` (a plain
+///      OpenZeppelin ERC20) does not have, transcribed from the deployed
+///      TetherToken source:
+///        1. `transfer`, `transferFrom` and `approve` declare NO return value.
+///        2. `approve` reverts on a non-zero -> non-zero allowance change.
+///        3. `transfer`/`transferFrom` charge `basisPointsRate` (capped at
+///           `maximumFee`) to the token owner, i.e. USDT is a fee-on-transfer
+///           token whose fee is currently 0 but is owner-settable.
+///        4. `transfer`/`transferFrom` revert for blacklisted addresses.
+contract RealisticUSDT {
+    string public constant name = "Tether USD";
+    string public constant symbol = "USDT";
+    uint8 public constant decimals = 6;
+
+    uint256 public totalSupply;
+    address public owner;
+
+    // matches TetherToken: settable via setParams, capped at 20 bps / 50 USDT
+    uint256 public basisPointsRate;
+    uint256 public maximumFee;
+
+    mapping(address => uint256) public balanceOf;
+    mapping(address => mapping(address => uint256)) public allowance;
+    mapping(address => bool) public isBlackListed;
+
+    event Transfer(address indexed from, address indexed to, uint256 value);
+    event Approval(address indexed owner, address indexed spender, uint256 value);
+
+    constructor() {
+        owner = msg.sender;
+    }
+
+    function mint(address to, uint256 amount) external {
+        balanceOf[to] += amount;
+        totalSupply += amount;
+        emit Transfer(address(0), to, amount);
+    }
+
+    /// @dev TetherToken.setParams: newBasisPoints < 20, newMaxFee < 50.
+    function setParams(uint256 newBasisPoints, uint256 newMaxFee) external {
+        require(newBasisPoints < 20, "bps too high");
+        require(newMaxFee < 50, "fee too high");
+        basisPointsRate = newBasisPoints;
+        maximumFee = newMaxFee * (10 ** uint256(decimals));
+    }
+
+    function addBlackList(address account) external {
+        isBlackListed[account] = true;
+    }
+
+    // NOTE: no `returns (bool)` — this is the whole point of this mock.
+    function transfer(address to, uint256 value) public {
+        require(!isBlackListed[msg.sender], "blacklisted");
+        _transfer(msg.sender, to, value);
+    }
+
+    function transferFrom(address from, address to, uint256 value) public {
+        require(!isBlackListed[from], "blacklisted");
+        uint256 allowed = allowance[from][msg.sender];
+        if (allowed < type(uint256).max) {
+            allowance[from][msg.sender] = allowed - value;
+        }
+        _transfer(from, to, value);
+    }
+
+    /// @dev TetherToken.approve: no return value, and the non-zero -> non-zero guard.
+    function approve(address spender, uint256 value) public {
+        require(!((value != 0) && (allowance[msg.sender][spender] != 0)), "unsafe approve");
+        allowance[msg.sender][spender] = value;
+        emit Approval(msg.sender, spender, value);
+    }
+
+    function _transfer(address from, address to, uint256 value) internal {
+        uint256 fee = (value * basisPointsRate) / 10000;
+        if (fee > maximumFee) fee = maximumFee;
+        uint256 sendAmount = value - fee;
+
+        balanceOf[from] -= value;
+        balanceOf[to] += sendAmount;
+        if (fee > 0) {
+            balanceOf[owner] += fee;
+            emit Transfer(from, owner, fee);
+        }
+        emit Transfer(from, to, sendAmount);
+    }
+}
