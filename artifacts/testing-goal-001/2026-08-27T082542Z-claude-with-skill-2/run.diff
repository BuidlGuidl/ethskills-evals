@@ -0,0 +1,126 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test} from "forge-std/Test.sol";
+
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+import {MockUSDT} from "../mocks/MockUSDT.sol";
+import {AccruingAavePool, AccruingAToken} from "./AccruingAavePool.sol";
+
+/// @notice The properties a USDT yield vault has to hold before it takes real money.
+///         Every test here asserts CORRECT behaviour. Every failure is a defect in
+///         src/UsdtYieldVault.sol as it stands today. This suite is expected to be RED.
+contract VaultPropertiesTest is Test {
+    UsdtYieldVault internal vault;
+    MockUSDT internal usdt;
+    AccruingAavePool internal pool;
+    AccruingAToken internal aUsdt;
+
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+    address internal bob = makeAddr("bob");
+
+    function setUp() public {
+        usdt = new MockUSDT();
+        pool = new AccruingAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 0, owner);
+
+        address[3] memory funded = [alice, bob, owner];
+        for (uint256 i = 0; i < funded.length; i++) {
+            usdt.mint(funded[i], 1_000_000e6);
+            vm.prank(funded[i]);
+            usdt.approve(address(vault), type(uint256).max);
+        }
+    }
+
+    function _deposit(address who, uint256 amount) internal returns (uint256) {
+        vm.prank(who);
+        return vault.deposit(amount);
+    }
+
+    function _accrue(uint256 bps) internal {
+        uint256 before = aUsdt.totalSupply();
+        pool.accrue(bps);
+        usdt.mint(address(pool), aUsdt.totalSupply() - before);
+    }
+
+    /// PROPERTY: a depositor in a yield vault earns the underlying protocol's yield.
+    function test_Property_DepositorEarnsAaveYield() public {
+        _deposit(alice, 1_000e6);
+        _accrue(1_000); // Aave pays 10%
+        assertApproxEqAbs(vault.balanceOfUnderlying(alice), 1_100e6, 1, "sole depositor must own the 10% yield");
+    }
+
+    /// PROPERTY: the vault's accounting matches the position it actually holds in Aave.
+    function test_Property_TotalAssetsTracksTheAavePosition() public {
+        _deposit(alice, 1_000e6);
+        _accrue(500);
+        assertEq(vault.totalAssets(), aUsdt.balanceOf(address(vault)), "accounting must match reality");
+    }
+
+    /// PROPERTY: once every share is burned, no user money is left behind in the protocol.
+    function test_Property_VaultCanBeFullyDrained() public {
+        uint256 shares = _deposit(alice, 1_000e6);
+        _accrue(1_000);
+        vm.prank(alice);
+        vault.withdraw(shares);
+        assertEq(vault.totalShares(), 0);
+        assertEq(aUsdt.balanceOf(address(vault)), 0, "nothing may be stranded after a full exit");
+    }
+
+    /// PROPERTY (from the contract's own NatSpec): "Both fees stay supplied in Aave and
+    /// accrue to the remaining shareholders."
+    function test_Property_WithdrawFeeAccruesToRemainingShareholders() public {
+        uint256 aliceShares = _deposit(alice, 1_000e6);
+        _deposit(bob, 1_000e6);
+
+        uint256 bobBefore = vault.balanceOfUnderlying(bob);
+        vm.prank(alice);
+        vault.withdraw(aliceShares); // pays a 3 USDT withdrawal fee
+
+        assertEq(vault.balanceOfUnderlying(bob), bobBefore + 3e6, "the fee must land on bob's shares");
+    }
+
+    /// PROPERTY: the owner cannot take value that belongs to a depositor.
+    function test_Property_OwnerCannotSeizeAnIncomingDeposit() public {
+        _deposit(owner, 1_000e6);
+
+        vm.prank(owner); // front-runs alice's pending deposit
+        vault.setDepositFee(9_999);
+
+        _deposit(alice, 10_000e6);
+        assertGt(vault.balanceOfUnderlying(alice), 9_000e6, "alice must keep the bulk of her 10,000 USDT");
+    }
+
+    /// PROPERTY: a fee setter is bounded by 100%.
+    function test_Property_DepositFeeIsBounded() public {
+        vm.prank(owner);
+        vm.expectRevert();
+        vault.setDepositFee(10_001);
+    }
+
+    /// PROPERTY: an emergency pause stops new risk; it does not imprison existing depositors.
+    function test_Property_DepositorsCanExitWhilePaused() public {
+        uint256 shares = _deposit(alice, 10_000e6);
+        vm.prank(owner);
+        vault.pause();
+
+        vm.prank(alice);
+        vault.withdraw(shares);
+        assertEq(vault.shareBalance(alice), 0, "a paused vault must still let people leave");
+    }
+
+    /// PROPERTY: every share a user holds can be redeemed.
+    function test_Property_AllSharesAreRedeemable() public {
+        _deposit(alice, 1_000e6);
+        vm.prank(alice);
+        vault.withdraw(1e11); // dust: rounds to 0 USDT, Aave rejects a zero-amount withdrawal
+    }
+
+    /// PROPERTY: a vault wired to a zero address is not deployable.
+    function test_Property_ConstructorRejectsZeroAddresses() public {
+        vm.expectRevert();
+        new UsdtYieldVault(address(0), address(0), address(0), 0, owner);
+    }
+}

