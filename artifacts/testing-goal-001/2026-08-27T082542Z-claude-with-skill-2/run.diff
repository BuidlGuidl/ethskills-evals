@@ -0,0 +1,137 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test} from "forge-std/Test.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+
+interface IUsdtAdmin {
+    function owner() external view returns (address);
+    function basisPointsRate() external view returns (uint256);
+    function maximumFee() external view returns (uint256);
+    function setParams(uint256 newBasisPoints, uint256 newMaxFee) external;
+}
+
+/// @notice The vault wired to the exact mainnet addresses it is meant to ship against.
+contract MainnetForkTest is Test {
+    address internal constant USDT = 0xdAC17F958D2ee523a2206206994597C13D831ec7;
+    address internal constant AAVE_POOL = 0x87870Bca3F3fD6335C3F4ce8392D69350B4fA4E2;
+    address internal constant AUSDT = 0x23878914EFE38d27C4D67Ab83ed1b93A74D4086a;
+    uint256 internal constant FORK_BLOCK = 25_817_216;
+
+    UsdtYieldVault internal vault;
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+
+    function setUp() public {
+        vm.createSelectFork(vm.envOr("ETH_RPC_URL", string("https://eth-mainnet.public.blastapi.io")), FORK_BLOCK);
+        vault = new UsdtYieldVault(USDT, AUSDT, AAVE_POOL, 10, owner);
+
+        deal(USDT, alice, 100_000e6);
+        // Real USDT's approve() returns nothing, so it must be called low-level, not through IERC20.
+        vm.prank(alice);
+        (bool ok,) = USDT.call(abi.encodeWithSignature("approve(address,uint256)", address(vault), type(uint256).max));
+        require(ok, "alice approve failed");
+    }
+
+    /// @dev Mechanism: mainnet USDT's approve/transfer/transferFrom return no data at all.
+    function test_RealUsdtApproveReturnsNoReturnData() public {
+        vm.prank(alice);
+        (bool ok, bytes memory ret) = USDT.call(abi.encodeWithSignature("approve(address,uint256)", address(1), 1));
+        assertTrue(ok, "call itself succeeds");
+        assertEq(ret.length, 0, "USDT.approve returns zero bytes, so `returns (bool)` cannot decode");
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        F-1  deposit() cannot succeed even once on mainnet.
+    //////////////////////////////////////////////////////////////*/
+
+    function test_DepositAlwaysRevertsAgainstRealUsdt() public {
+        vm.prank(alice);
+        (bool ok, bytes memory ret) = address(vault).call(abi.encodeWithSignature("deposit(uint256)", uint256(1_000e6)));
+
+        assertFalse(ok, "deposit MUST have reverted");
+        assertEq(ret.length, 0, "empty revert data: the bool decode of USDT.approve failed");
+
+        // And the depositor keeps their money, because nothing happened at all.
+        assertEq(IERC20(USDT).balanceOf(alice), 100_000e6);
+        assertEq(IERC20(AUSDT).balanceOf(address(vault)), 0);
+    }
+
+    function test_DepositRevertsForEveryAmount(uint256 amount) public {
+        amount = bound(amount, 1e6, 100_000e6);
+        vm.prank(alice);
+        vm.expectRevert();
+        vault.deposit(amount);
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        With the approve defect neutralised by a cheatcode, the next
+        failure shows up against the real Aave pool.
+    //////////////////////////////////////////////////////////////*/
+
+    /// @dev Give the vault a real USDT allowance, then stub the vault's own broken approve() call.
+    function _neutraliseApproveDefect() internal {
+        vm.prank(address(vault));
+        (bool ok,) = USDT.call(abi.encodeWithSignature("approve(address,uint256)", AAVE_POOL, type(uint256).max));
+        require(ok, "vault approve failed");
+        vm.mockCall(USDT, abi.encodeWithSelector(IERC20.approve.selector), abi.encode(true));
+    }
+
+    function test_RealAaveYieldIsInvisibleToTheVaultAndUnrecoverable() public {
+        _neutraliseApproveDefect();
+
+        vm.prank(alice);
+        uint256 shares = vault.deposit(10_000e6);
+
+        uint256 suppliedAt = IERC20(AUSDT).balanceOf(address(vault));
+        assertApproxEqAbs(suppliedAt, 10_000e6, 1, "supplied into aave");
+
+        vm.warp(block.timestamp + 365 days);
+
+        uint256 aavePosition = IERC20(AUSDT).balanceOf(address(vault));
+        emit log_named_decimal_uint("real aUSDT after 1y (6dp)", aavePosition, 6);
+        emit log_named_decimal_uint("vault.totalAssets()  (6dp)", vault.totalAssets(), 6);
+        emit log_named_decimal_uint("alice redeemable     (6dp)", vault.balanceOfUnderlying(alice), 6);
+
+        assertGt(aavePosition, suppliedAt, "aave really did pay interest");
+        assertEq(vault.totalAssets(), 10_000e6, "vault accounting frozen at the deposit amount");
+        assertEq(vault.balanceOfUnderlying(alice), 10_000e6, "sole depositor credited with zero yield");
+
+        uint256 before = IERC20(USDT).balanceOf(alice);
+        vm.prank(alice);
+        vault.withdraw(shares);
+        uint256 paid = IERC20(USDT).balanceOf(alice) - before;
+
+        assertEq(paid, 9_970e6, "principal minus the 0.3% exit fee, and not one unit of yield");
+
+        uint256 stranded = IERC20(AUSDT).balanceOf(address(vault));
+        emit log_named_decimal_uint("stranded in aave forever (6dp)", stranded, 6);
+        assertEq(vault.totalShares(), 0);
+        assertEq(vault.totalAssetsStored(), 0);
+        assertGt(stranded, 30e6, "yield + exit fee, with no code path that can reach it");
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        F-8  USDT can turn on a transfer fee. The vault assumes it cannot.
+    //////////////////////////////////////////////////////////////*/
+
+    function test_UsdtTransferFeeIsUnhandled() public {
+        assertEq(IUsdtAdmin(USDT).basisPointsRate(), 0, "fee currently off");
+        assertEq(IUsdtAdmin(USDT).maximumFee(), 0);
+
+        _neutraliseApproveDefect();
+
+        // Tether can switch the transfer fee on at any time; the parameters are owner-settable.
+        address usdtOwner = IUsdtAdmin(USDT).owner();
+        vm.prank(usdtOwner);
+        IUsdtAdmin(USDT).setParams(10, 49);
+        assertEq(IUsdtAdmin(USDT).basisPointsRate(), 10);
+
+        // The vault transfers in `amount`, receives less, then tries to supply the full `amount`.
+        vm.prank(alice);
+        vm.expectRevert();
+        vault.deposit(10_000e6);
+    }
+}
