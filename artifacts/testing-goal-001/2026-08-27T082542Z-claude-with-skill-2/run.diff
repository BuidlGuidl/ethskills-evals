@@ -0,0 +1,274 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, stdError} from "forge-std/Test.sol";
+import {Pausable} from "@openzeppelin/contracts/utils/Pausable.sol";
+
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+import {MockUSDT} from "../mocks/MockUSDT.sol";
+import {MockAavePool, MockAToken} from "../mocks/MockAavePool.sol";
+import {AccruingAavePool, AccruingAToken} from "./AccruingAavePool.sol";
+
+/// @notice Accounting regressions against src/UsdtYieldVault.sol exactly as it stands.
+///         Nothing under src/ or test/mocks/ is modified; the only new component is an
+///         Aave stand-in that actually pays interest, which the shipped mock never does.
+contract VaultAccountingTest is Test {
+    UsdtYieldVault internal vault;
+    MockUSDT internal usdt;
+    AccruingAavePool internal pool;
+    AccruingAToken internal aUsdt;
+
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+    address internal bob = makeAddr("bob");
+
+    /// @dev Deposit fee starts at 0 so every number below is attributable to one cause.
+    function setUp() public {
+        usdt = new MockUSDT();
+        pool = new AccruingAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 0, owner);
+
+        address[3] memory funded = [alice, bob, owner];
+        for (uint256 i = 0; i < funded.length; i++) {
+            usdt.mint(funded[i], 1_000_000e6);
+            vm.prank(funded[i]);
+            usdt.approve(address(vault), type(uint256).max);
+        }
+    }
+
+    function _deposit(address who, uint256 amount) internal returns (uint256) {
+        vm.prank(who);
+        return vault.deposit(amount);
+    }
+
+    /// @dev Grow the Aave liquidity index and fund the pool with the interest it now owes.
+    function _accrue(uint256 bps) internal {
+        uint256 before = aUsdt.totalSupply();
+        pool.accrue(bps);
+        usdt.mint(address(pool), aUsdt.totalSupply() - before);
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        F-2  Aave interest is never credited to anyone, ever.
+    //////////////////////////////////////////////////////////////*/
+
+    function test_AaveYieldIsUnrecoverableByEveryone() public {
+        uint256 shares = _deposit(alice, 1_000e6);
+
+        _accrue(1_000); // +10% supply interest in Aave
+
+        // The vault's real Aave position grew. Its accounting did not.
+        assertEq(aUsdt.balanceOf(address(vault)), 1_100e6, "aave position");
+        assertEq(vault.totalAssets(), 1_000e6, "vault accounting ignored the interest");
+        assertEq(vault.balanceOfUnderlying(alice), 1_000e6, "alice credited with zero yield");
+
+        uint256 balBefore = usdt.balanceOf(alice);
+        vm.prank(alice);
+        vault.withdraw(shares);
+
+        // Alice, the only depositor, receives principal minus the exit fee. No yield at all.
+        assertEq(usdt.balanceOf(alice) - balBefore, 997e6, "alice paid out");
+
+        // The vault is now empty of shares yet still holds 103 USDT in Aave that
+        // no code path in the contract can ever move out.
+        assertEq(vault.totalShares(), 0);
+        assertEq(vault.totalAssetsStored(), 0);
+        assertApproxEqAbs(aUsdt.balanceOf(address(vault)), 103e6, 1, "permanently stranded in aave");
+        emit log_named_decimal_uint("stranded aUSDT (6dp)", aUsdt.balanceOf(address(vault)), 6);
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        F-3  The withdrawal fee is destroyed, not redistributed.
+             NatSpec: "Both fees stay supplied in Aave and accrue to
+             the remaining shareholders."
+    //////////////////////////////////////////////////////////////*/
+
+    function test_WithdrawFeeIsStrandedNotDistributedToRemainingHolders() public {
+        uint256 aliceShares = _deposit(alice, 1_000e6);
+        _deposit(bob, 1_000e6);
+
+        uint256 bobBefore = vault.balanceOfUnderlying(bob);
+
+        vm.prank(alice);
+        vault.withdraw(aliceShares); // 3 USDT withdrawal fee retained in Aave
+
+        uint256 bobAfter = vault.balanceOfUnderlying(bob);
+
+        assertEq(bobBefore, 1_000e6);
+        assertEq(bobAfter, 1_000e6, "remaining shareholder received none of the fee");
+        assertEq(bobAfter, bobBefore, "docs claim the fee accrues here; it does not");
+
+        // The 3 USDT is real, sits in Aave, and is outside the vault's accounting.
+        assertEq(aUsdt.balanceOf(address(vault)), 1_003e6);
+        assertEq(vault.totalAssets(), 1_000e6);
+        assertEq(aUsdt.balanceOf(address(vault)) - vault.totalAssets(), 3e6, "unaccounted");
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        F-4  The unaccounted gap only ever grows.
+    //////////////////////////////////////////////////////////////*/
+
+    function test_UnaccountedGapGrowsWithEveryWithdrawal() public {
+        _deposit(alice, 10_000e6);
+        _deposit(bob, 10_000e6);
+
+        assertEq(aUsdt.balanceOf(address(vault)) - vault.totalAssets(), 0, "gap starts clean");
+
+        uint256 gap;
+        for (uint256 i = 0; i < 5; i++) {
+            uint256 half = vault.shareBalance(alice) / 2;
+            vm.prank(alice);
+            vault.withdraw(half);
+            uint256 next = aUsdt.balanceOf(address(vault)) - vault.totalAssets();
+            assertGt(next, gap, "gap must grow on every exit");
+            gap = next;
+        }
+        emit log_named_decimal_uint("unreachable USDT after 5 partial exits (6dp)", gap, 6);
+    }
+
+    function testFuzz_VaultNeverCreditsInterest(uint96 depositAmount, uint16 yieldBps) public {
+        depositAmount = uint96(bound(depositAmount, 1e6, 500_000e6));
+        yieldBps = uint16(bound(yieldBps, 1, 5_000));
+
+        _deposit(alice, depositAmount);
+        _accrue(yieldBps);
+
+        assertEq(vault.totalAssets(), depositAmount, "totalAssets can never reflect yield");
+        assertGt(aUsdt.balanceOf(address(vault)), vault.totalAssets(), "yield exists but is invisible");
+        assertEq(vault.balanceOfUnderlying(alice), depositAmount, "depositor credited zero yield");
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        F-5  Owner can seize an incoming deposit via setDepositFee.
+    //////////////////////////////////////////////////////////////*/
+
+    function test_OwnerCanFrontRunDepositAndSeizeIt() public {
+        // Owner takes a normal position first.
+        uint256 ownerShares = _deposit(owner, 1_000e6);
+        uint256 ownerSpent = 1_000e6;
+
+        // Alice broadcasts a 10,000 USDT deposit. Owner front-runs it.
+        vm.prank(owner);
+        vault.setDepositFee(9_999);
+
+        uint256 aliceShares = _deposit(alice, 10_000e6);
+
+        assertEq(vault.balanceOfUnderlying(alice), 10.98901e6, "alice's 10,000 USDT is now worth ~11");
+        emit log_named_decimal_uint("alice deposited (6dp)", 10_000e6, 6);
+        emit log_named_decimal_uint("alice can redeem (6dp)", vault.balanceOfUnderlying(alice), 6);
+
+        uint256 ownerBefore = usdt.balanceOf(owner);
+        vm.prank(owner);
+        vault.withdraw(ownerShares);
+        uint256 ownerProfit = usdt.balanceOf(owner) - ownerBefore - ownerSpent;
+
+        emit log_named_decimal_uint("owner profit on a 1,000 USDT position (6dp)", ownerProfit, 6);
+        assertGt(ownerProfit, 9_900e6, "owner extracted ~all of alice's deposit");
+        assertLt(aliceShares, 2e18);
+    }
+
+    function test_SetDepositFeeAboveOneHundredPercentBricksDeposits() public {
+        vm.prank(owner);
+        vault.setDepositFee(10_001); // accepted: no upper bound is enforced
+        assertEq(vault.depositFeeBps(), 10_001);
+
+        vm.prank(alice);
+        vm.expectRevert(stdError.arithmeticError); // amount - fee underflows
+        vault.deposit(1_000e6);
+    }
+
+    function test_SetDepositFeeToExactlyOneHundredPercentBricksDeposits() public {
+        vm.prank(owner);
+        vault.setDepositFee(10_000);
+
+        vm.prank(alice);
+        vm.expectRevert(UsdtYieldVault.NoSharesMinted.selector);
+        vault.deposit(1_000e6);
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        F-6  Pause traps depositor funds.
+    //////////////////////////////////////////////////////////////*/
+
+    function test_PauseBlocksWithdrawalsAndTrapsUserFunds() public {
+        uint256 shares = _deposit(alice, 10_000e6);
+
+        vm.prank(owner);
+        vault.pause();
+
+        vm.prank(alice);
+        vm.expectRevert(Pausable.EnforcedPause.selector);
+        vault.withdraw(shares);
+
+        // Owner then renounces: the pause can never be lifted and the funds are gone.
+        vm.prank(owner);
+        vault.renounceOwnership();
+
+        vm.prank(alice);
+        vm.expectRevert(Pausable.EnforcedPause.selector);
+        vault.withdraw(shares);
+
+        assertEq(vault.owner(), address(0), "no one can ever unpause");
+        assertEq(vault.balanceOfUnderlying(alice), 10_000e6, "alice's funds, permanently frozen");
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        F-7  Dust shares are unredeemable.
+    //////////////////////////////////////////////////////////////*/
+
+    /*//////////////////////////////////////////////////////////////
+        F-9  Deposited/Withdrawn use opposite asset conventions.
+    //////////////////////////////////////////////////////////////*/
+
+    function test_DepositAndWithdrawEventsDisagreeOnWhatAssetsMeans() public {
+        vm.prank(owner);
+        vault.setDepositFee(10);
+
+        // Deposited.assets is GROSS: 1000 in, fee 1, and the event still says 1000.
+        vm.expectEmit(true, false, false, true, address(vault));
+        emit UsdtYieldVault.Deposited(alice, 1_000e6, 999e18, 1e6);
+        _deposit(alice, 1_000e6);
+
+        // Withdrawn.assets is NET: 1000 out, fee 3, and the event says 997.
+        vm.expectEmit(true, false, false, true, address(vault));
+        emit UsdtYieldVault.Withdrawn(alice, 997e6, 999e18, 3e6);
+        vm.prank(alice);
+        vault.withdraw(999e18);
+
+        // An indexer summing Deposited.assets - Withdrawn.assets reports 3 USDT of TVL
+        // in a vault whose share supply is zero.
+        assertEq(uint256(1_000e6) - 997e6, 3e6);
+        assertEq(vault.totalShares(), 0);
+    }
+
+    function test_DustWithdrawalRevertsAgainstAaveSemantics() public {
+        _deposit(alice, 1_000e6);
+
+        // 1e11 shares round to 0 USDT; Aave V3 rejects withdraw(amount == 0) with Errors.INVALID_AMOUNT.
+        assertEq(vault.convertToAssets(1e11), 0);
+        vm.prank(alice);
+        vm.expectRevert(bytes("26"));
+        vault.withdraw(1e11);
+    }
+
+    function test_DustWithdrawalSilentlyBurnsSharesAgainstShippedMock() public {
+        // Same call against the pool the shipped suite uses: no revert, shares destroyed for nothing.
+        MockUSDT usdt2 = new MockUSDT();
+        MockAavePool pool2 = new MockAavePool(address(usdt2));
+        UsdtYieldVault vault2 = new UsdtYieldVault(address(usdt2), address(pool2.aToken()), address(pool2), 0, owner);
+
+        usdt2.mint(alice, 1_000e6);
+        vm.startPrank(alice);
+        usdt2.approve(address(vault2), type(uint256).max);
+        vault2.deposit(1_000e6);
+
+        uint256 sharesBefore = vault2.shareBalance(alice);
+        uint256 usdtBefore = usdt2.balanceOf(alice);
+        vault2.withdraw(1e11);
+        vm.stopPrank();
+
+        assertEq(vault2.shareBalance(alice), sharesBefore - 1e11, "shares burned");
+        assertEq(usdt2.balanceOf(alice), usdtBefore, "nothing paid out");
+    }
+}
diff --git a/test/audit/VaultInvariants.t.sol b/test/audit/VaultInvariants.t.sol
new file mode 100644
index 0000000..fc1570b
--- /dev/null
+++ b/test/audit/VaultInvariants.t.sol
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test} from "forge-std/Test.sol";
+
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+import {MockUSDT} from "../mocks/MockUSDT.sol";
+import {AccruingAavePool, AccruingAToken} from "./AccruingAavePool.sol";
+
+/// @notice Drives random deposit/withdraw/interest sequences against the live vault.
+contract VaultHandler is Test {
+    UsdtYieldVault public vault;
+    MockUSDT public usdt;
+    AccruingAavePool public pool;
+    AccruingAToken public aUsdt;
+
+    address[] public actors;
+    uint256 public ghostDeposited;
+    uint256 public ghostWithdrawn;
+
+    constructor(UsdtYieldVault _vault, MockUSDT _usdt, AccruingAavePool _pool) {
+        vault = _vault;
+        usdt = _usdt;
+        pool = _pool;
+        aUsdt = _pool.aToken();
+
+        for (uint256 i = 0; i < 4; i++) {
+            address actor = address(uint160(uint256(keccak256(abi.encode("actor", i)))));
+            actors.push(actor);
+            usdt.mint(actor, 10_000_000e6);
+            vm.prank(actor);
+            usdt.approve(address(vault), type(uint256).max);
+        }
+    }
+
+    function actorCount() external view returns (uint256) {
+        return actors.length;
+    }
+
+    function deposit(uint256 actorSeed, uint256 amount) external {
+        address actor = actors[actorSeed % actors.length];
+        amount = bound(amount, 1e6, 100_000e6);
+        vm.prank(actor);
+        try vault.deposit(amount) {
+            ghostDeposited += amount;
+        } catch {}
+    }
+
+    function withdraw(uint256 actorSeed, uint256 sharesSeed) external {
+        address actor = actors[actorSeed % actors.length];
+        uint256 balance = vault.shareBalance(actor);
+        if (balance == 0) return;
+        uint256 shares = bound(sharesSeed, 1, balance);
+        vm.prank(actor);
+        try vault.withdraw(shares) returns (uint256 netAssets) {
+            ghostWithdrawn += netAssets;
+        } catch {}
+    }
+
+    function accrue(uint256 bps) external {
+        bps = bound(bps, 0, 200);
+        uint256 before = aUsdt.totalSupply();
+        pool.accrue(bps);
+        usdt.mint(address(pool), aUsdt.totalSupply() - before);
+    }
+}
+
+contract VaultInvariantsTest is Test {
+    UsdtYieldVault internal vault;
+    MockUSDT internal usdt;
+    AccruingAavePool internal pool;
+    AccruingAToken internal aUsdt;
+    VaultHandler internal handler;
+
+    function setUp() public {
+        usdt = new MockUSDT();
+        pool = new AccruingAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 10, makeAddr("owner"));
+
+        handler = new VaultHandler(vault, usdt, pool);
+        targetContract(address(handler));
+    }
+
+    /// INVARIANT: every USDT the vault holds in Aave is claimable by some shareholder.
+    ///            Expected to FAIL: yield and withdrawal fees fall out of the accounting.
+    function invariant_NoUnaccountedFunds() public view {
+        assertEq(aUsdt.balanceOf(address(vault)), vault.totalAssets(), "unaccounted USDT stuck in aave");
+    }
+
+    /// INVARIANT: user share balances sum to totalShares. Expected to HOLD.
+    function invariant_SharesAccountingIsConsistent() public view {
+        uint256 sum;
+        for (uint256 i = 0; i < handler.actorCount(); i++) {
+            sum += vault.shareBalance(handler.actors(i));
+        }
+        assertEq(sum, vault.totalShares(), "share ledger");
+    }
+
+    /// INVARIANT: the vault is never materially short of what it owes shareholders.
+    ///            Expected to HOLD: the drift runs the other way -- the vault holds far more
+    ///            than it can pay out. The 1-unit tolerance is aToken scaled-balance rounding,
+    ///            which real Aave exhibits too; it is only reachable at all because the vault
+    ///            mirrors its Aave position instead of reading it.
+    function invariant_VaultIsNeverMateriallyInsolvent() public view {
+        assertGe(aUsdt.balanceOf(address(vault)) + 1, vault.totalAssets(), "insolvent");
+    }
+}
