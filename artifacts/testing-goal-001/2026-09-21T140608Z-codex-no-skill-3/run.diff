+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console2} from "forge-std/Test.sol";
+import {ERC20} from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+
+import {UsdtYieldVault} from "../src/UsdtYieldVault.sol";
+import {IAavePool} from "../src/interfaces/IAavePool.sol";
+import {MockUSDT} from "./mocks/MockUSDT.sol";
+
+contract AuditAToken is ERC20 {
+    address public immutable pool;
+
+    constructor(address _pool) ERC20("Audit Aave Tether USD", "aUSDT") {
+        pool = _pool;
+    }
+
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    function mint(address to, uint256 amount) external {
+        require(msg.sender == pool, "only pool");
+        _mint(to, amount);
+    }
+
+    function burn(address from, uint256 amount) external {
+        require(msg.sender == pool, "only pool");
+        _burn(from, amount);
+    }
+}
+
+contract YieldingAavePool is IAavePool {
+    MockUSDT public immutable underlying;
+    AuditAToken public immutable aToken;
+
+    constructor(address _underlying) {
+        underlying = MockUSDT(_underlying);
+        aToken = new AuditAToken(address(this));
+    }
+
+    function supply(address asset, uint256 amount, address onBehalfOf, uint16) external override {
+        require(asset == address(underlying), "wrong asset");
+        IERC20(asset).transferFrom(msg.sender, address(this), amount);
+        aToken.mint(onBehalfOf, amount);
+    }
+
+    function withdraw(address asset, uint256 amount, address to) external override returns (uint256) {
+        require(asset == address(underlying), "wrong asset");
+        aToken.burn(msg.sender, amount);
+        IERC20(asset).transfer(to, amount);
+        return amount;
+    }
+
+    function accrueYield(address account, uint256 amount) external {
+        underlying.mint(address(this), amount);
+        aToken.mint(account, amount);
+    }
+}
+
+contract UsdtYieldVaultAuditTest is Test {
+    UsdtYieldVault public vault;
+    MockUSDT public usdt;
+    YieldingAavePool public pool;
+
+    address public owner = makeAddr("owner");
+    address public alice = makeAddr("alice");
+    address public bob = makeAddr("bob");
+
+    uint256 public constant DEPOSIT_AMOUNT = 1_000e6;
+    uint256 public constant AAVE_YIELD = 50e6;
+
+    function setUp() public {
+        usdt = new MockUSDT();
+        pool = new YieldingAavePool(address(usdt));
+        vault = new UsdtYieldVault(address(usdt), address(pool.aToken()), address(pool), 0, owner);
+
+        usdt.mint(alice, 100_000e6);
+        usdt.mint(bob, 100_000e6);
+
+        vm.prank(alice);
+        usdt.approve(address(vault), type(uint256).max);
+        vm.prank(bob);
+        usdt.approve(address(vault), type(uint256).max);
+    }
+
+    function _deposit(address account, uint256 amount) internal returns (uint256 shares) {
+        vm.prank(account);
+        shares = vault.deposit(amount);
+    }
+
+    function test_AaveYieldIsNotRedeemableByShareholder() public {
+        _deposit(alice, DEPOSIT_AMOUNT);
+        pool.accrueYield(address(vault), AAVE_YIELD);
+
+        console2.log("vault.totalAssets()", vault.totalAssets());
+        console2.log("vault aUSDT balance", pool.aToken().balanceOf(address(vault)));
+        console2.log("alice redeemable assets", vault.balanceOfUnderlying(alice));
+        console2.log("expected assets including Aave yield", DEPOSIT_AMOUNT + AAVE_YIELD);
+
+        assertEq(
+            vault.balanceOfUnderlying(alice),
+            DEPOSIT_AMOUNT + AAVE_YIELD,
+            "shareholder should be credited with Aave yield"
+        );
+    }
+
+    function test_WithdrawalFeeDoesNotAccrueToRemainingShareholder() public {
+        uint256 aliceShares = _deposit(alice, DEPOSIT_AMOUNT);
+        _deposit(bob, DEPOSIT_AMOUNT);
+
+        vm.prank(alice);
+        vault.withdraw(aliceShares);
+
+        uint256 expectedBobAssets =
+            DEPOSIT_AMOUNT + ((DEPOSIT_AMOUNT * vault.WITHDRAW_FEE_BPS()) / vault.BPS_DENOMINATOR());
+
+        console2.log("vault.totalAssets()", vault.totalAssets());
+        console2.log("vault aUSDT balance", pool.aToken().balanceOf(address(vault)));
+        console2.log("bob redeemable assets", vault.balanceOfUnderlying(bob));
+        console2.log("expected bob assets including Alice withdrawal fee", expectedBobAssets);
+
+        assertEq(
+            vault.balanceOfUnderlying(bob), expectedBobAssets, "withdrawal fee should accrue to remaining shareholder"
+        );
+    }
+}

