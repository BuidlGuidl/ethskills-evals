@@ -0,0 +1,80 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console2} from "forge-std/Test.sol";
+
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+import {RealisticUsdt} from "../harness/RealisticUsdt.sol";
+import {MockAavePool, MockAToken} from "../mocks/MockAavePool.sol";
+
+/// @notice A-01 reproduced without an RPC, plus A-07 (fee-on-transfer USDT).
+contract A07_UsdtSemantics is Test {
+    address alice = makeAddr("alice");
+    address vaultOwner = makeAddr("vaultOwner");
+
+    function _build(bool returnBools) internal returns (UsdtYieldVault v, RealisticUsdt t, MockAavePool p) {
+        t = new RealisticUsdt(returnBools);
+        p = new MockAavePool(address(t));
+        v = new UsdtYieldVault(address(t), address(p.aToken()), address(p), 10, vaultOwner);
+
+        t.mint(alice, 100_000e6);
+        vm.prank(alice);
+        t.approve(address(v), type(uint256).max);
+    }
+
+    /*//////////////////////////////////////////////////////////////
+                    A-01, reproducible with no RPC
+    //////////////////////////////////////////////////////////////*/
+
+    function test_DepositRevertsAgainstUsdtSemantics() public {
+        (UsdtYieldVault v,,) = _build(false); // real USDT: approve returns nothing
+
+        vm.prank(alice);
+        v.deposit(1_000e6);
+    }
+
+    /// Control: the ONLY difference is that this token returns a bool, and the
+    /// exact same deposit now succeeds. That pins the failure on the return type.
+    function test_ControlSameTokenReturningBoolsWorks() public {
+        (UsdtYieldVault v,,) = _build(true);
+
+        vm.prank(alice);
+        uint256 shares = v.deposit(1_000e6);
+        assertEq(shares, 999e18);
+    }
+
+    /*//////////////////////////////////////////////////////////////
+                       A-07  fee-on-transfer USDT
+    //////////////////////////////////////////////////////////////*/
+
+    /// Tether's owner can turn the transfer fee back on at any time (the real
+    /// contract still exposes setParams; basisPointsRate is currently 0).
+    /// The vault assumes it receives exactly `amount`, so deposits break.
+    function test_FeeOnTransferBreaksDeposits() public {
+        (UsdtYieldVault v, RealisticUsdt t,) = _build(true); // isolate this quirk from A-01
+
+        t.setParams(10, 49); // 0.10%, capped at 50 USDT - within Tether's own limits
+
+        vm.prank(alice);
+        v.deposit(1_000e6);
+    }
+
+    /// Same call, showing that the vault's own idle balance is what silently
+    /// papers over the shortfall when there happens to be one.
+    function test_FeeOnTransferSilentlyConsumesStrayVaultBalance() public {
+        (UsdtYieldVault v, RealisticUsdt t, MockAavePool p) = _build(true);
+
+        t.setParams(10, 49);
+        t.mint(address(v), 100e6); // any stray USDT sitting on the vault
+
+        vm.prank(alice);
+        v.deposit(10_000e6);
+
+        console2.log("stray balance before:", uint256(100e6));
+        console2.log("stray balance after :", t.balanceOf(address(v)));
+        console2.log("totalAssetsStored   :", v.totalAssetsStored());
+        console2.log("aUSDT held          :", p.aToken().balanceOf(address(v)));
+
+        assertEq(t.balanceOf(address(v)), 100e6, "a deposit must not consume the vault's other USDT");
+    }
+}
diff --git a/test/audit/A08_Invariants.t.sol b/test/audit/A08_Invariants.t.sol
new file mode 100644
index 0000000..5882be8
--- /dev/null
+++ b/test/audit/A08_Invariants.t.sol
@@ -0,0 +1,103 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console2} from "forge-std/Test.sol";
+
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+import {MockUSDT} from "../mocks/MockUSDT.sol";
+import {AccruingAavePool, AccruingAToken} from "../harness/AccruingAavePool.sol";
+
+/// @notice Drives random deposit / withdraw / interest-accrual sequences.
+contract VaultHandler is Test {
+    UsdtYieldVault public vault;
+    MockUSDT public usdt;
+    AccruingAavePool public pool;
+
+    address[3] public actors = [makeAddr("a1"), makeAddr("a2"), makeAddr("a3")];
+
+    uint256 public totalDeposited;
+    uint256 public totalWithdrawn;
+    uint256 public totalAccrued;
+
+    constructor(UsdtYieldVault _vault, MockUSDT _usdt, AccruingAavePool _pool) {
+        vault = _vault;
+        usdt = _usdt;
+        pool = _pool;
+        for (uint256 i; i < actors.length; ++i) {
+            usdt.mint(actors[i], 1_000_000e6);
+            vm.prank(actors[i]);
+            usdt.approve(address(vault), type(uint256).max);
+        }
+    }
+
+    function deposit(uint256 actorSeed, uint256 amount) external {
+        address actor = actors[actorSeed % actors.length];
+        amount = bound(amount, 1e6, usdt.balanceOf(actor));
+        if (amount < 1e6) return;
+        vm.prank(actor);
+        try vault.deposit(amount) {
+            totalDeposited += amount;
+        } catch {}
+    }
+
+    function withdraw(uint256 actorSeed, uint256 shares) external {
+        address actor = actors[actorSeed % actors.length];
+        uint256 held = vault.shareBalance(actor);
+        if (held == 0) return;
+        shares = bound(shares, 1, held);
+        vm.prank(actor);
+        try vault.withdraw(shares) returns (uint256 got) {
+            totalWithdrawn += got;
+        } catch {}
+    }
+
+    /// Aave pays interest. Between 0.01% and 1% per call.
+    function accrue(uint256 bps) external {
+        if (pool.aToken().totalSupply() == 0) return;
+        pool.accrue(bound(bps, 1, 100));
+        totalAccrued += 1;
+    }
+}
+
+/// @notice A-03 / A-04 stated as invariants and checked over random sequences.
+contract A08_Invariants is Test {
+    UsdtYieldVault vault;
+    MockUSDT usdt;
+    AccruingAavePool pool;
+    AccruingAToken aUsdt;
+    VaultHandler handler;
+
+    address owner = makeAddr("owner");
+
+    function setUp() public {
+        usdt = new MockUSDT();
+        pool = new AccruingAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 10, owner);
+
+        handler = new VaultHandler(vault, usdt, pool);
+        targetContract(address(handler));
+    }
+
+    /// Every unit of USDT the vault owns in Aave must be claimable by some share.
+    /// It is not: interest and withdrawal fees fall outside the accounting.
+    function invariant_NoValueEscapesShareAccounting() public view {
+        assertEq(vault.totalAssetsStored(), aUsdt.balanceOf(address(vault)), "vault holds value no share can claim");
+    }
+
+    /// A yield vault's share price must rise as the underlying position earns.
+    /// This one is frozen unless someone deposits.
+    function invariant_YieldReachesShareholders() public view {
+        if (vault.totalShares() == 0) return;
+        uint256 claimable = vault.convertToAssets(vault.totalShares());
+        assertGe(claimable, aUsdt.balanceOf(address(vault)), "shareholders cannot claim the vault's real position");
+    }
+
+    function invariant_CallSummary() public view {
+        console2.log("deposited :", handler.totalDeposited());
+        console2.log("withdrawn :", handler.totalWithdrawn());
+        console2.log("accruals  :", handler.totalAccrued());
+        console2.log("stored    :", vault.totalAssetsStored());
+        console2.log("aUSDT held:", aUsdt.balanceOf(address(vault)));
+    }
+}
diff --git a/test/audit/A09_ChecksThatHeld.t.sol b/test/audit/A09_ChecksThatHeld.t.sol
new file mode 100644
index 0000000..53144f1
--- /dev/null
+++ b/test/audit/A09_ChecksThatHeld.t.sol
@@ -0,0 +1,190 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test} from "forge-std/Test.sol";
+
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+import {IAavePool} from "../../src/interfaces/IAavePool.sol";
+import {MockUSDT} from "../mocks/MockUSDT.sol";
+import {MockAavePool, MockAToken} from "../mocks/MockAavePool.sol";
+import {AccruingAavePool, AccruingAToken} from "../harness/AccruingAavePool.sol";
+import {VaultHandler} from "./A08_Invariants.t.sol";
+
+/// @notice Pool that re-enters the vault while it is mid-withdraw.
+contract ReentrantPool is IAavePool {
+    MockUSDT public immutable usdt;
+    MockAToken public aToken;
+    UsdtYieldVault public vault;
+    bool public tried;
+    bool public reenterSucceeded;
+
+    constructor(MockUSDT _usdt) {
+        usdt = _usdt;
+        aToken = new MockAToken(address(this));
+    }
+
+    function setVault(UsdtYieldVault v) external {
+        vault = v;
+    }
+
+    function supply(address, uint256 amount, address onBehalfOf, uint16) external override {
+        usdt.transferFrom(msg.sender, address(this), amount);
+        aToken.mint(onBehalfOf, amount);
+    }
+
+    function withdraw(address, uint256 amount, address to) external override returns (uint256) {
+        aToken.burn(msg.sender, amount);
+        if (!tried) {
+            tried = true;
+            // classic reentrancy: hit withdraw() again before state settles
+            try vault.withdraw(1e18) {
+                reenterSucceeded = true;
+            } catch {}
+        }
+        usdt.transfer(to, amount);
+        return amount;
+    }
+}
+
+/// @notice Things I attacked and could not break. Recorded so the report is
+///         not one-sided: every test in this file is expected to PASS.
+contract A09_ChecksThatHeld is Test {
+    UsdtYieldVault vault;
+    MockUSDT usdt;
+    MockAavePool pool;
+    MockAToken aUsdt;
+
+    address alice = makeAddr("alice");
+    address bob = makeAddr("bob");
+    address owner = makeAddr("owner");
+
+    function setUp() public {
+        usdt = new MockUSDT();
+        pool = new MockAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 10, owner);
+
+        usdt.mint(alice, 1_000_000e6);
+        usdt.mint(bob, 1_000_000e6);
+        vm.prank(alice);
+        usdt.approve(address(vault), type(uint256).max);
+        vm.prank(bob);
+        usdt.approve(address(vault), type(uint256).max);
+    }
+
+    /// nonReentrant genuinely holds on the withdraw path.
+    function test_WithdrawIsNotReentrant() public {
+        MockUSDT t = new MockUSDT();
+        ReentrantPool rp = new ReentrantPool(t);
+        UsdtYieldVault v = new UsdtYieldVault(address(t), address(rp.aToken()), address(rp), 0, owner);
+        rp.setVault(v);
+
+        t.mint(alice, 10_000e6);
+        vm.startPrank(alice);
+        t.approve(address(v), type(uint256).max);
+        uint256 shares = v.deposit(1_000e6);
+        v.withdraw(shares);
+        vm.stopPrank();
+
+        assertTrue(rp.tried(), "reentry was attempted");
+        assertFalse(rp.reenterSucceeded(), "reentry must be blocked");
+    }
+
+    /// The classic first-depositor / share-inflation attack does not apply:
+    /// totalAssetsStored is internal bookkeeping, so a donation of USDT or aUSDT
+    /// to the vault cannot move the share price.
+    function testFuzz_DonationCannotMoveSharePrice(uint256 donation) public {
+        donation = bound(donation, 1, 500_000e6);
+
+        vm.prank(alice);
+        vault.deposit(1_000e6);
+        uint256 priceBefore = vault.sharePrice();
+
+        vm.prank(bob);
+        usdt.transfer(address(vault), donation); // direct donation
+        vm.prank(bob);
+        usdt.approve(address(pool), donation);
+
+        assertEq(vault.sharePrice(), priceBefore, "share price is donation-proof");
+    }
+
+    /// An attacker cannot squeeze the vault into a state where a later deposit
+    /// divides by zero, and cannot make a victim's deposit mint zero shares.
+    function testFuzz_NoDivideByZeroAfterMassExit(uint256 a, uint256 b, uint256 exit) public {
+        a = bound(a, 1e6, 100_000e6);
+        b = bound(b, 1e6, 100_000e6);
+
+        vm.prank(alice);
+        uint256 sa = vault.deposit(a);
+        vm.prank(bob);
+        vault.deposit(b);
+
+        exit = bound(exit, 1, sa);
+        vm.prank(alice);
+        vault.withdraw(exit);
+
+        if (vault.totalShares() > 0) {
+            assertGt(vault.totalAssetsStored(), 0, "shares outstanding with zero assets would brick deposits");
+        }
+        vm.prank(alice);
+        vault.deposit(1_000e6); // must not revert
+    }
+
+    /// The vault is always over-collateralised: it never owes more than it holds.
+    /// (The excess is the bug in A-03/A-04, but the direction is at least safe.)
+    function testFuzz_NeverInsolvent(uint256 a, uint256 b, uint256 exit) public {
+        a = bound(a, 1e6, 100_000e6);
+        b = bound(b, 1e6, 100_000e6);
+
+        vm.prank(alice);
+        uint256 sa = vault.deposit(a);
+        vm.prank(bob);
+        uint256 sb = vault.deposit(b);
+
+        exit = bound(exit, 1, sa);
+        vm.prank(alice);
+        vault.withdraw(exit);
+
+        assertGe(aUsdt.balanceOf(address(vault)), vault.totalAssetsStored(), "solvent");
+
+        vm.prank(bob);
+        vault.withdraw(sb); // the other depositor can always still get out
+    }
+
+    /// Access control on the three privileged functions.
+    function testFuzz_OnlyOwnerCanAdminister(address caller) public {
+        vm.assume(caller != owner);
+
+        vm.startPrank(caller);
+        vm.expectRevert();
+        vault.setDepositFee(1);
+        vm.expectRevert();
+        vault.pause();
+        vm.expectRevert();
+        vault.unpause();
+        vm.stopPrank();
+    }
+}
+
+/// @notice Solvency stated as an invariant over random sequences. Expected to PASS.
+contract A09_SolvencyInvariant is Test {
+    UsdtYieldVault vault;
+    MockUSDT usdt;
+    AccruingAavePool pool;
+    AccruingAToken aUsdt;
+    VaultHandler handler;
+
+    function setUp() public {
+        usdt = new MockUSDT();
+        pool = new AccruingAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 10, makeAddr("owner"));
+
+        handler = new VaultHandler(vault, usdt, pool);
+        targetContract(address(handler));
+    }
+
+    function invariant_VaultIsNeverInsolvent() public view {
+        assertGe(aUsdt.balanceOf(address(vault)), vault.totalAssetsStored(), "vault owes more than it holds");
+    }
+}
diff --git a/test/fork/A01_UsdtApproveFork.t.sol b/test/fork/A01_UsdtApproveFork.t.sol
new file mode 100644
index 0000000..48f3baf
--- /dev/null
+++ b/test/fork/A01_UsdtApproveFork.t.sol
@@ -0,0 +1,98 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test} from "forge-std/Test.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+
+/// @notice Fork evidence for A-01 / A-02.
+///         A-01: the vault cannot take a single deposit on mainnet, because
+///         `usdt.approve(...)` is compiled as an IERC20 call that ABI-decodes a
+///         bool return value, and the real USDT approve() returns nothing.
+///         A-02: real USDT also rejects a non-zero -> non-zero approve.
+contract A01_UsdtApproveFork is Test {
+    address constant USDT = 0xdAC17F958D2ee523a2206206994597C13D831ec7;
+    address constant AUSDT = 0x23878914EFE38d27C4D67Ab83ed1b93A74D4086a;
+    address constant AAVE_POOL = 0x87870Bca3F3fD6335C3F4ce8392D69350B4fA4E2;
+
+    UsdtYieldVault vault;
+    address alice = makeAddr("alice");
+    address owner = makeAddr("owner");
+
+    function setUp() public {
+        vm.createSelectFork(vm.envOr("MAINNET_RPC_URL", string("https://eth.drpc.org")), 25_800_000);
+        vault = new UsdtYieldVault(USDT, AUSDT, AAVE_POOL, 10, owner);
+
+        deal(USDT, alice, 100_000e6);
+        vm.prank(alice);
+        // low-level, because a typed IERC20.approve would revert here too
+        (bool ok,) = USDT.call(abi.encodeWithSignature("approve(address,uint256)", address(vault), type(uint256).max));
+        require(ok, "approve setup failed");
+    }
+
+    /*//////////////////////////////////////////////////////////////
+                       A-01  deposit() is unusable
+    //////////////////////////////////////////////////////////////*/
+
+    /// USDT's approve() returns zero bytes of return data, so any typed
+    /// `IERC20.approve` call site reverts on the ABI decode of the bool.
+    function test_RealUsdtApproveReturnsNoReturnData() public {
+        address fresh = makeAddr("fresh"); // allowance 0, so USDT's own logic accepts it
+
+        vm.prank(fresh);
+        (bool ok, bytes memory ret) =
+            USDT.call(abi.encodeWithSignature("approve(address,uint256)", address(vault), uint256(1e6)));
+        assertTrue(ok, "raw approve succeeds at the EVM level");
+        assertEq(ret.length, 0, "real USDT approve returns NO return data");
+
+        // Exactly what UsdtYieldVault.deposit() line 94 compiles to, in its own
+        // call frame so the decode revert is observable.
+        TypedApprover probe = new TypedApprover();
+        vm.expectRevert();
+        probe.approve(USDT, address(vault), 1e6);
+    }
+
+    /// The headline: no deposit can ever succeed against mainnet USDT.
+    function test_DepositRevertsOnMainnet() public {
+        vm.prank(alice);
+        vm.expectRevert();
+        vault.deposit(1_000e6);
+    }
+
+    /// Same call without expectRevert, so the failure shows up in the trace.
+    function test_DepositRevertsOnMainnet_Trace() public {
+        vm.prank(alice);
+        vault.deposit(1_000e6);
+    }
+
+    /*//////////////////////////////////////////////////////////////
+              A-02  USDT rejects non-zero -> non-zero approve
+    //////////////////////////////////////////////////////////////*/
+
+    /// Any fix that only swaps the bool decode (e.g. a raw call, or
+    /// SafeERC20.safeApprove) still has to reset the allowance to 0 first.
+    function test_RealUsdtRejectsOverwritingNonZeroAllowance() public {
+        address spender = makeAddr("spender");
+
+        vm.startPrank(alice);
+        (bool first,) = USDT.call(abi.encodeWithSignature("approve(address,uint256)", spender, uint256(100e6)));
+        assertTrue(first, "0 -> 100 accepted");
+
+        (bool second,) = USDT.call(abi.encodeWithSignature("approve(address,uint256)", spender, uint256(200e6)));
+        assertFalse(second, "100 -> 200 MUST be rejected by real USDT");
+
+        (bool reset,) = USDT.call(abi.encodeWithSignature("approve(address,uint256)", spender, uint256(0)));
+        assertTrue(reset, "100 -> 0 accepted");
+        (bool third,) = USDT.call(abi.encodeWithSignature("approve(address,uint256)", spender, uint256(200e6)));
+        assertTrue(third, "0 -> 200 accepted");
+        vm.stopPrank();
+    }
+}
+
+/// @notice Minimal stand-in for the vault's `usdt.approve(...)` call site.
+contract TypedApprover {
+    function approve(address token, address spender, uint256 amount) external {
+        IERC20(token).approve(spender, amount);
+    }
+}
diff --git a/test/fork/A03_YieldStrandedFork.t.sol b/test/fork/A03_YieldStrandedFork.t.sol
new file mode 100644
index 0000000..ae16010
--- /dev/null
+++ b/test/fork/A03_YieldStrandedFork.t.sol
@@ -0,0 +1,113 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console2} from "forge-std/Test.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+import {IAavePool} from "../../src/interfaces/IAavePool.sol";
+
+/// @notice Fork evidence for A-03: the vault never reads its aUSDT balance, so
+///         every dollar of Aave interest is invisible to share accounting and
+///         unreachable by any function on the contract.
+///
+/// @dev A-01 makes deposit() impossible on mainnet, so this test constructs the
+///      post-deposit state directly: it supplies USDT into the *real* Aave pool
+///      on behalf of the vault (permissionless), and writes the share bookkeeping
+///      that a working deposit() would have written. Everything after that is the
+///      unmodified contract running against real Aave.
+contract A03_YieldStrandedFork is Test {
+    address constant USDT = 0xdAC17F958D2ee523a2206206994597C13D831ec7;
+    address constant AUSDT = 0x23878914EFE38d27C4D67Ab83ed1b93A74D4086a;
+    address constant AAVE_POOL = 0x87870Bca3F3fD6335C3F4ce8392D69350B4fA4E2;
+
+    uint256 constant PRINCIPAL = 1_000_000e6; // 1M USDT
+    uint256 constant SHARES = 1_000_000e18; // what deposit() would mint at fee 0
+
+    UsdtYieldVault vault;
+    address alice = makeAddr("alice");
+    address owner = makeAddr("owner");
+
+    function setUp() public {
+        vm.createSelectFork(vm.envOr("MAINNET_RPC_URL", string("https://eth.drpc.org")), 25_800_000);
+        vault = new UsdtYieldVault(USDT, AUSDT, AAVE_POOL, 0, owner);
+
+        // 1. real supply into real Aave, credited to the vault
+        address funder = makeAddr("funder");
+        deal(USDT, funder, PRINCIPAL);
+        vm.startPrank(funder);
+        (bool ok,) = USDT.call(abi.encodeWithSignature("approve(address,uint256)", AAVE_POOL, PRINCIPAL));
+        require(ok, "approve");
+        IAavePool(AAVE_POOL).supply(USDT, PRINCIPAL, address(vault), 0);
+        vm.stopPrank();
+
+        // 2. the bookkeeping a working deposit() would have written
+        vm.store(address(vault), bytes32(uint256(2)), bytes32(SHARES)); // totalShares
+        vm.store(address(vault), bytes32(uint256(3)), bytes32(PRINCIPAL)); // totalAssetsStored
+        vm.store(address(vault), keccak256(abi.encode(alice, uint256(4))), bytes32(SHARES)); // shareBalance[alice]
+
+        assertEq(vault.totalShares(), SHARES);
+        assertEq(vault.totalAssetsStored(), PRINCIPAL);
+        assertEq(vault.shareBalance(alice), SHARES);
+    }
+
+    function test_AaveInterestIsInvisibleToTheVault() public {
+        uint256 aBefore = IERC20(AUSDT).balanceOf(address(vault));
+        uint256 priceBefore = vault.sharePrice();
+        uint256 underlyingBefore = vault.balanceOfUnderlying(alice);
+
+        vm.warp(block.timestamp + 365 days);
+
+        uint256 aAfter = IERC20(AUSDT).balanceOf(address(vault));
+
+        console2.log("aUSDT balance   t0 :", aBefore);
+        console2.log("aUSDT balance   t1 :", aAfter);
+        console2.log("interest earned    :", aAfter - aBefore);
+        console2.log("totalAssets()   t1 :", vault.totalAssets());
+        console2.log("sharePrice()    t0 :", priceBefore);
+        console2.log("sharePrice()    t1 :", vault.sharePrice());
+        console2.log("alice underlying t1:", vault.balanceOfUnderlying(alice));
+
+        // Aave really did pay interest.
+        assertGt(aAfter, aBefore, "aUSDT should accrue");
+
+        // ...and the vault's own accounting did not move one unit.
+        assertEq(vault.totalAssets(), PRINCIPAL, "totalAssets ignores interest");
+        assertEq(vault.sharePrice(), priceBefore, "sharePrice ignores interest");
+        assertEq(vault.balanceOfUnderlying(alice), underlyingBefore, "depositor never sees the yield");
+
+        // This is the assertion a yield vault must satisfy. It does not.
+        assertGe(
+            vault.balanceOfUnderlying(alice), aAfter, "depositor's claim should track the vault's real Aave position"
+        );
+    }
+
+    function test_YieldIsUnreachableAfterEveryoneExits() public {
+        vm.warp(block.timestamp + 365 days);
+
+        uint256 aBefore = IERC20(AUSDT).balanceOf(address(vault));
+
+        vm.prank(alice);
+        uint256 got = vault.withdraw(SHARES);
+
+        uint256 stranded = IERC20(AUSDT).balanceOf(address(vault));
+
+        console2.log("aUSDT before exit :", aBefore);
+        console2.log("alice received    :", got);
+        console2.log("shares outstanding:", vault.totalShares());
+        console2.log("totalAssets()     :", vault.totalAssets());
+        console2.log("aUSDT STRANDED    :", stranded);
+
+        // Sole depositor exits with principal minus the 0.30% withdraw fee.
+        assertEq(got, PRINCIPAL - (PRINCIPAL * 30) / 10_000, "principal only, zero yield");
+
+        // Vault is now empty on paper...
+        assertEq(vault.totalShares(), 0);
+        assertEq(vault.totalAssets(), 0);
+
+        // ...while still holding a real, sizeable Aave position that no function
+        // on UsdtYieldVault can ever move. There is no sweep, no rescue, no
+        // owner withdrawal, and totalShares == 0 so no share can claim it.
+        assertEq(stranded, 0, "vault should hold nothing once all shares are burned");
+    }
+}
diff --git a/test/fork/A07_TetherFeeFork.t.sol b/test/fork/A07_TetherFeeFork.t.sol
new file mode 100644
index 0000000..1aba68c
--- /dev/null
+++ b/test/fork/A07_TetherFeeFork.t.sol
@@ -0,0 +1,47 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console2} from "forge-std/Test.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+
+/// @notice Fork evidence for A-07: the real USDT contract still exposes
+///         setParams(), so Tether can re-enable the transfer fee at any time.
+///         The vault assumes `amount` sent == `amount` received.
+contract A07_TetherFeeFork is Test {
+    address constant USDT = 0xdAC17F958D2ee523a2206206994597C13D831ec7;
+
+    function setUp() public {
+        vm.createSelectFork(vm.envOr("MAINNET_RPC_URL", string("https://eth.drpc.org")), 25_800_000);
+    }
+
+    function test_TetherOwnerCanReEnableTheTransferFee() public {
+        address tetherOwner = address(uint160(uint256(vm.load(USDT, bytes32(uint256(0))))));
+        console2.log("tether owner       :", tetherOwner);
+
+        (, bytes memory r) = USDT.staticcall(abi.encodeWithSignature("basisPointsRate()"));
+        console2.log("basisPointsRate now:", abi.decode(r, (uint256)));
+
+        vm.prank(tetherOwner);
+        (bool ok,) = USDT.call(abi.encodeWithSignature("setParams(uint256,uint256)", uint256(10), uint256(49)));
+        assertTrue(ok, "setParams accepted");
+
+        (, r) = USDT.staticcall(abi.encodeWithSignature("basisPointsRate()"));
+        console2.log("basisPointsRate set:", abi.decode(r, (uint256)));
+
+        address from = makeAddr("from");
+        address to = makeAddr("to");
+        deal(USDT, from, 10_000e6);
+
+        vm.prank(from);
+        (ok,) = USDT.call(abi.encodeWithSignature("transfer(address,uint256)", to, uint256(10_000e6)));
+        assertTrue(ok, "transfer executed");
+
+        uint256 received = IERC20(USDT).balanceOf(to);
+        console2.log("sent               :", uint256(10_000e6));
+        console2.log("received           :", received);
+
+        // This is the assumption baked into deposit(): amount sent == amount
+        // supplied to Aave == amount added to totalAssetsStored.
+        assertEq(received, 10_000e6, "USDT delivers the full amount sent");
+    }
+}
diff --git a/test/harness/AccruingAavePool.sol b/test/harness/AccruingAavePool.sol
new file mode 100644
index 0000000..a6d99ca
--- /dev/null
+++ b/test/harness/AccruingAavePool.sol
@@ -0,0 +1,84 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {ERC20} from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+
+import {IAavePool} from "../../src/interfaces/IAavePool.sol";
+
+/// @notice Aave-like pool whose receipt token actually accrues interest, the way
+///         the real aUSDT does. test/mocks/MockAavePool.sol pays 0% forever,
+///         which is why the existing suite cannot see A-03.
+contract AccruingAToken is ERC20 {
+    address public immutable pool;
+    uint256 public index = 1e27; // Aave-style ray index
+    mapping(address => uint256) public scaled;
+    uint256 public scaledTotal;
+
+    constructor(address _pool) ERC20("Aave Tether USD", "aUSDT") {
+        pool = _pool;
+    }
+
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    function setIndex(uint256 newIndex) external {
+        require(newIndex >= index, "index cannot decrease");
+        index = newIndex;
+    }
+
+    function balanceOf(address a) public view override returns (uint256) {
+        return (scaled[a] * index) / 1e27;
+    }
+
+    function totalSupply() public view override returns (uint256) {
+        return (scaledTotal * index) / 1e27;
+    }
+
+    function mint(address to, uint256 amount) external {
+        require(msg.sender == pool, "only pool");
+        uint256 s = (amount * 1e27) / index;
+        scaled[to] += s;
+        scaledTotal += s;
+    }
+
+    function burn(address from, uint256 amount) external {
+        require(msg.sender == pool, "only pool");
+        uint256 s = (amount * 1e27 + index - 1) / index;
+        require(scaled[from] >= s, "burn exceeds balance");
+        scaled[from] -= s;
+        scaledTotal -= s;
+    }
+}
+
+contract AccruingAavePool is IAavePool {
+    IERC20 public immutable underlying;
+    AccruingAToken public immutable aToken;
+
+    constructor(address _underlying) {
+        underlying = IERC20(_underlying);
+        aToken = new AccruingAToken(address(this));
+    }
+
+    /// Simulates interest: the index grows and the pool is funded to match.
+    function accrue(uint256 bps) external {
+        uint256 before = aToken.totalSupply();
+        aToken.setIndex((aToken.index() * (10_000 + bps)) / 10_000);
+        uint256 grown = aToken.totalSupply() - before;
+        // interest has to come from somewhere; in Aave it comes from borrowers
+        (bool ok,) = address(underlying).call(abi.encodeWithSignature("mint(address,uint256)", address(this), grown));
+        require(ok, "fund interest");
+    }
+
+    function supply(address, uint256 amount, address onBehalfOf, uint16) external override {
+        underlying.transferFrom(msg.sender, address(this), amount);
+        aToken.mint(onBehalfOf, amount);
+    }
+
+    function withdraw(address, uint256 amount, address to) external override returns (uint256) {
+        aToken.burn(msg.sender, amount);
+        underlying.transfer(to, amount);
+        return amount;
+    }
+}
