@@ -0,0 +1,105 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+/// @notice Faithful reimplementation of the quirks of the real TetherToken at
+///         0xdAC17F958D2ee523a2206206994597C13D831ec7, so the vault's behaviour
+///         against real USDT can be reproduced without an archive RPC.
+///
+///         Modelled quirks:
+///           1. transfer/transferFrom/approve return NOTHING (no bool).
+///           2. approve() rejects a non-zero -> non-zero change.
+///           3. an owner-settable transfer fee (basisPointsRate / maximumFee).
+///
+/// @dev `returnBools` exists only so individual quirks can be isolated in tests:
+///      set it true to get an otherwise-identical token that DOES return bools,
+///      which lets quirk 3 be exercised without quirk 1 masking it.
+contract RealisticUsdt {
+    string public constant name = "Tether USD";
+    string public constant symbol = "USDT";
+    uint8 public constant decimals = 6;
+
+    uint256 public totalSupply;
+    mapping(address => uint256) public balanceOf;
+    mapping(address => mapping(address => uint256)) public allowance;
+
+    address public owner;
+    uint256 public basisPointsRate; // real USDT: settable up to 20
+    uint256 public maximumFee; // real USDT: settable up to 50 * 1e6
+
+    bool public immutable returnBools;
+
+    event Transfer(address indexed from, address indexed to, uint256 value);
+    event Approval(address indexed owner, address indexed spender, uint256 value);
+
+    constructor(bool _returnBools) {
+        owner = msg.sender;
+        returnBools = _returnBools;
+    }
+
+    function mint(address to, uint256 amount) external {
+        totalSupply += amount;
+        balanceOf[to] += amount;
+        emit Transfer(address(0), to, amount);
+    }
+
+    /// Mirrors TetherToken.setParams: rate < 20, fee < 50 whole tokens.
+    function setParams(uint256 newBasisPoints, uint256 newMaxFee) external {
+        require(msg.sender == owner, "not owner");
+        require(newBasisPoints < 20, "rate too high");
+        require(newMaxFee < 50, "fee too high");
+        basisPointsRate = newBasisPoints;
+        maximumFee = newMaxFee * 1e6;
+    }
+
+    function _fee(uint256 value) internal view returns (uint256 fee) {
+        fee = (value * basisPointsRate) / 10_000;
+        if (fee > maximumFee) fee = maximumFee;
+    }
+
+    function _move(address from, address to, uint256 value) internal {
+        require(balanceOf[from] >= value, "insufficient balance");
+        uint256 fee = _fee(value);
+        uint256 sendAmount = value - fee;
+        balanceOf[from] -= value;
+        balanceOf[to] += sendAmount;
+        if (fee > 0) {
+            balanceOf[owner] += fee;
+            emit Transfer(from, owner, fee);
+        }
+        emit Transfer(from, to, sendAmount);
+    }
+
+    // NOTE: the `returns (bool)` below is emitted ONLY when returnBools is set;
+    // assembly returns early with empty returndata otherwise, exactly like USDT.
+    function transfer(address to, uint256 value) external returns (bool) {
+        _move(msg.sender, to, value);
+        _ret();
+        return true;
+    }
+
+    function transferFrom(address from, address to, uint256 value) external returns (bool) {
+        uint256 a = allowance[from][msg.sender];
+        require(a >= value, "insufficient allowance");
+        if (a != type(uint256).max) allowance[from][msg.sender] = a - value;
+        _move(from, to, value);
+        _ret();
+        return true;
+    }
+
+    function approve(address spender, uint256 value) external returns (bool) {
+        // The real USDT guard against the approve race.
+        require(value == 0 || allowance[msg.sender][spender] == 0, "unsafe approve");
+        allowance[msg.sender][spender] = value;
+        emit Approval(msg.sender, spender, value);
+        _ret();
+        return true;
+    }
+
+    /// Returns empty returndata (like real USDT) unless returnBools is set.
+    function _ret() internal view {
+        if (returnBools) return;
+        assembly {
+            return(0, 0)
+        }
+    }
+}

