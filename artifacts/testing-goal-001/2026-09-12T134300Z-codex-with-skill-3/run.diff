+$ MAINNET_RPC_URL=https://rpc.mevblocker.io forge test --match-path test/UsdtYieldVaultMainnetFork.t.sol -vvvv 2>&1 | sed -n '/UsdtYieldVault::deposit/,/Backtrace:/p'
