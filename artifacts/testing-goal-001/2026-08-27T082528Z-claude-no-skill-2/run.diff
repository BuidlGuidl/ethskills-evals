+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console2} from "forge-std/Test.sol";
+
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+import {MockUSDT} from "../mocks/MockUSDT.sol";
+import {MockAavePool, MockAToken} from "../mocks/MockAavePool.sol";
+import {TetherUsdt, YieldingAavePool} from "./mocks/AuditMocks.sol";
+
+/// @notice Audit suite for src/UsdtYieldVault.sol.
+/// @dev Every test asserts the behaviour the README and the NatSpec promise.
+///      They FAIL against the contract as it stands; each failure is a finding.
+///      Nothing under src/, test/UsdtYieldVault.t.sol or test/mocks/ is changed.
+contract VaultAuditTest is Test {
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+    address internal bob = makeAddr("bob");
+
+    uint256 internal constant FEE_BPS = 10;
+
+    /// @dev Fixture built from the repo's own untouched mocks.
+    function _repoFixture() internal returns (UsdtYieldVault v, MockUSDT usdt, MockAavePool pool, MockAToken aUsdt) {
+        usdt = new MockUSDT();
+        pool = new MockAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        v = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), FEE_BPS, owner);
+
+        usdt.mint(alice, 1_000_000e6);
+        usdt.mint(bob, 1_000_000e6);
+        vm.prank(alice);
+        usdt.approve(address(v), type(uint256).max);
+        vm.prank(bob);
+        usdt.approve(address(v), type(uint256).max);
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        FINDING 1 - the vault cannot be used with the real USDT contract
+    //////////////////////////////////////////////////////////////*/
+
+    /// @dev src/UsdtYieldVault.sol:94 calls `usdt.approve(...)` through the
+    ///      IERC20 interface, so solidity ABI-decodes a bool from the return
+    ///      data. The deployed Tether contract returns nothing, the decode
+    ///      reverts, and every deposit fails. MockUSDT is a standard
+    ///      OpenZeppelin ERC20 and therefore hides this.
+    function test_Finding01_DepositWorksAgainstRealUsdtSemantics() public {
+        TetherUsdt usdt = new TetherUsdt();
+        YieldingAavePool pool = new YieldingAavePool(address(usdt));
+        UsdtYieldVault v = new UsdtYieldVault(address(usdt), address(pool.aToken()), address(pool), FEE_BPS, owner);
+
+        usdt.mint(alice, 1_000_000e6);
+        vm.prank(alice);
+        usdt.approve(address(v), type(uint256).max);
+
+        vm.prank(alice);
+        uint256 shares = v.deposit(1_000e6);
+
+        assertGt(shares, 0, "deposit must mint shares against real USDT");
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        FINDING 2 - Aave interest never reaches depositors
+    //////////////////////////////////////////////////////////////*/
+
+    /// @dev `totalAssets()` returns the stored deposit tally, never the aToken
+    ///      balance, so a rising Aave liquidity index is invisible to the share
+    ///      price. MockAavePool never pays interest, so the suite never notices.
+    function test_Finding02_DepositorEarnsAaveInterest() public {
+        MockUSDT usdt = new MockUSDT();
+        YieldingAavePool pool = new YieldingAavePool(address(usdt));
+        UsdtYieldVault v = new UsdtYieldVault(address(usdt), address(pool.aToken()), address(pool), FEE_BPS, owner);
+
+        usdt.mint(alice, 1_000_000e6);
+        vm.prank(alice);
+        usdt.approve(address(v), type(uint256).max);
+
+        vm.prank(alice);
+        v.deposit(10_000e6);
+
+        // Aave credits 5% interest to the vault's aToken position.
+        pool.accrue(address(v), 500e6);
+
+        console2.log("aUSDT held by vault :", pool.aToken().balanceOf(address(v)));
+        console2.log("vault.totalAssets() :", v.totalAssets());
+        console2.log("alice underlying    :", v.balanceOfUnderlying(alice));
+
+        assertEq(v.totalAssets(), 10_500e6, "totalAssets must include Aave interest");
+        assertEq(v.balanceOfUnderlying(alice), 10_500e6, "depositor must own the interest");
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        FINDING 3 - the withdrawal fee is destroyed, not redistributed
+    //////////////////////////////////////////////////////////////*/
+
+    /// @dev README: "Both fees stay supplied in Aave and accrue to the remaining
+    ///      shareholders". withdraw() subtracts the GROSS amount from
+    ///      totalAssetsStored while pulling only the NET out of Aave, so the fee
+    ///      leaves the accounting entirely and no shareholder ever receives it.
+    function test_Finding03_WithdrawFeeAccruesToRemainingShareholders() public {
+        (UsdtYieldVault v,, MockAavePool pool,) = _repoFixture();
+
+        vm.prank(alice);
+        v.deposit(10_000e6);
+        vm.prank(bob);
+        v.deposit(10_000e6);
+
+        uint256 bobBefore = v.balanceOfUnderlying(bob);
+
+        // Before anyone exits, the Aave position and the accounting agree.
+        assertEq(
+            pool.aToken().balanceOf(address(v)),
+            v.totalAssetsStored(),
+            "sanity: position matches accounting before any withdrawal"
+        );
+
+        uint256 aliceShares = v.shareBalance(alice);
+        vm.prank(alice);
+        v.withdraw(aliceShares);
+
+        uint256 bobAfter = v.balanceOfUnderlying(bob);
+
+        console2.log("bob underlying before alice's exit:", bobBefore);
+        console2.log("bob underlying after  alice's exit:", bobAfter);
+        console2.log("bob gained                        :", bobAfter - bobBefore);
+        console2.log("aUSDT still in Aave for the vault :", pool.aToken().balanceOf(address(v)));
+        console2.log("vault.totalAssetsStored()         :", v.totalAssetsStored());
+        console2.log("untracked (nobody owns this)      :", pool.aToken().balanceOf(address(v)) - v.totalAssetsStored());
+
+        // Alice's exit fee is ~0.3% of ~10,005 USDT, i.e. ~30 USDT. Bob is the
+        // only remaining shareholder, so all of it should land on his balance.
+        assertGe(bobAfter, bobBefore + 29e6, "alice's ~30 USDT exit fee must accrue to bob");
+        assertEq(
+            pool.aToken().balanceOf(address(v)),
+            v.totalAssetsStored(),
+            "every aUSDT the vault holds must be owned by some shareholder"
+        );
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        FINDING 4 - the stranded fees are unrecoverable forever
+    //////////////////////////////////////////////////////////////*/
+
+    /// @dev After every share is burned the vault still owns aUSDT, and there is
+    ///      no owner sweep, no rescue path and no share left to redeem it with.
+    function test_Finding04_NothingIsLeftBehindAfterFullExit() public {
+        (UsdtYieldVault v,, MockAavePool pool,) = _repoFixture();
+
+        vm.prank(alice);
+        v.deposit(10_000e6);
+        vm.prank(bob);
+        v.deposit(10_000e6);
+
+        uint256 aliceShares = v.shareBalance(alice);
+        uint256 bobShares = v.shareBalance(bob);
+        vm.prank(alice);
+        v.withdraw(aliceShares);
+        vm.prank(bob);
+        v.withdraw(bobShares);
+
+        uint256 stranded = pool.aToken().balanceOf(address(v));
+        console2.log("totalShares after full exit :", v.totalShares());
+        console2.log("totalAssetsStored           :", v.totalAssetsStored());
+        console2.log("aUSDT stranded in Aave      :", stranded);
+
+        assertEq(v.totalShares(), 0, "all shares burned");
+        assertEq(stranded, 0, "no USDT may be left stranded once all shares are burned");
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        FINDING 5 - setDepositFee is unbounded: the owner can seize deposits
+    //////////////////////////////////////////////////////////////*/
+
+    /// @dev No cap, no timelock, effective on the very next block. The seized
+    ///      value lands in totalAssetsStored, i.e. in the existing shareholders'
+    ///      share price - and the owner can be a shareholder.
+    function test_Finding05a_OwnerCannotSeizeIncomingDeposits() public {
+        (UsdtYieldVault v,,,) = _repoFixture();
+
+        // An owner-aligned account takes the first position.
+        vm.prank(alice);
+        v.deposit(1_000e6);
+        uint256 aliceBefore = v.balanceOfUnderlying(alice);
+
+        // The owner front-runs bob's pending deposit.
+        vm.prank(owner);
+        v.setDepositFee(9_999);
+
+        vm.prank(bob);
+        v.deposit(10_000e6);
+
+        console2.log("bob deposited (base units) : 10000000000");
+        console2.log("bob underlying afterwards  :", v.balanceOfUnderlying(bob));
+        console2.log("alice underlying before    :", aliceBefore);
+        console2.log("alice underlying after     :", v.balanceOfUnderlying(alice));
+
+        assertGe(v.balanceOfUnderlying(bob), 9_900e6, "a deposit may not lose more than a sane fee");
+    }
+
+    /// @dev A fee >= BPS_DENOMINATOR bricks deposits outright: `amount - fee`
+    ///      underflows (panic 0x11) at src/UsdtYieldVault.sol:88.
+    function test_Finding05b_DepositFeeCannotBrickTheVault() public {
+        (UsdtYieldVault v,,,) = _repoFixture();
+
+        vm.prank(owner);
+        v.setDepositFee(10_001);
+
+        vm.prank(alice);
+        uint256 shares = v.deposit(1_000e6);
+        assertGt(shares, 0, "deposits must stay possible");
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        FINDING 6 - pause() also freezes withdrawals
+    //////////////////////////////////////////////////////////////*/
+
+    /// @dev whenNotPaused sits on withdraw() too, so a hostile or compromised
+    ///      owner (single-step Ownable, no timelock) locks every depositor out
+    ///      of their principal indefinitely.
+    function test_Finding06_PauseDoesNotTrapDepositorFunds() public {
+        (UsdtYieldVault v,,,) = _repoFixture();
+
+        vm.prank(alice);
+        v.deposit(10_000e6);
+
+        uint256 aliceShares = v.shareBalance(alice);
+
+        vm.prank(owner);
+        v.pause();
+
+        vm.prank(alice);
+        uint256 got = v.withdraw(aliceShares);
+        assertGt(got, 0, "a paused vault must still let depositors exit");
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        FINDING 7 - a re-enabled Tether transfer fee bricks every deposit
+    //////////////////////////////////////////////////////////////*/
+
+    /// @dev deposit() assumes the full `amount` arrives, then approves and
+    ///      supplies `amount`. Tether can switch its transfer fee back on with
+    ///      setParams() at any time; the vault then holds less than it supplies.
+    ///      Uses TetherUsdtReturningBool so this is isolated from Finding 1.
+    function test_Finding07_DepositSurvivesTetherTransferFee() public {
+        TetherUsdtReturningBool usdt = new TetherUsdtReturningBool();
+        YieldingAavePool pool = new YieldingAavePool(address(usdt));
+        UsdtYieldVault v = new UsdtYieldVault(address(usdt), address(pool.aToken()), address(pool), FEE_BPS, owner);
+
+        usdt.mint(alice, 1_000_000e6);
+        vm.prank(alice);
+        usdt.approve(address(v), type(uint256).max);
+
+        // Tether turns the fee back on: 10 bps, capped at 30 USDT.
+        usdt.setParams(10, 30);
+
+        vm.prank(alice);
+        uint256 shares = v.deposit(1_000e6);
+        assertGt(shares, 0, "deposit must survive a Tether transfer fee");
+    }
+}
+
+/// @notice {TetherUsdt} with bool-returning `approve`/`transfer`/`transferFrom`.
+/// @dev Exists only so FINDING 7 can be observed independently of FINDING 1.
+contract TetherUsdtReturningBool {
+    string public constant name = "Tether USD";
+    string public constant symbol = "USDT";
+    uint8 public constant decimals = 6;
+
+    uint256 public totalSupply;
+    uint256 public basisPointsRate;
+    uint256 public maximumFee;
+    address public owner = msg.sender;
+
+    mapping(address => uint256) public balanceOf;
+    mapping(address => mapping(address => uint256)) public allowance;
+
+    event Transfer(address indexed from, address indexed to, uint256 value);
+    event Approval(address indexed owner, address indexed spender, uint256 value);
+
+    function setParams(uint256 newBasisPoints, uint256 newMaxFee) external {
+        basisPointsRate = newBasisPoints;
+        maximumFee = newMaxFee * (10 ** decimals);
+    }
+
+    function mint(address to, uint256 amount) external {
+        balanceOf[to] += amount;
+        totalSupply += amount;
+        emit Transfer(address(0), to, amount);
+    }
+
+    function _fee(uint256 value) internal view returns (uint256 fee) {
+        fee = (value * basisPointsRate) / 10000;
+        if (fee > maximumFee) fee = maximumFee;
+    }
+
+    function approve(address spender, uint256 value) external returns (bool) {
+        allowance[msg.sender][spender] = value;
+        emit Approval(msg.sender, spender, value);
+        return true;
+    }
+
+    function transfer(address to, uint256 value) external returns (bool) {
+        uint256 fee = _fee(value);
+        balanceOf[msg.sender] -= value;
+        balanceOf[to] += value - fee;
+        balanceOf[owner] += fee;
+        emit Transfer(msg.sender, to, value - fee);
+        return true;
+    }
+
+    function transferFrom(address from, address to, uint256 value) external returns (bool) {
+        uint256 a = allowance[from][msg.sender];
+        require(value <= a, "allowance");
+        if (a < type(uint256).max) allowance[from][msg.sender] = a - value;
+        uint256 fee = _fee(value);
+        balanceOf[from] -= value;
+        balanceOf[to] += value - fee;
+        balanceOf[owner] += fee;
+        emit Transfer(from, to, value - fee);
+        return true;
+    }
+}
