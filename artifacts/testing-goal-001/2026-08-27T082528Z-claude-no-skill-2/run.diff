+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console2} from "forge-std/Test.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+import {IAavePool} from "../../src/interfaces/IAavePool.sol";
+
+/// @notice Runs the vault against the real mainnet USDT and the real Aave V3
+///         pool, at a pinned block, so nothing here depends on a mock.
+/// @dev Needs an archive RPC. Defaults to a public one; override with
+///      `MAINNET_RPC_URL=... forge test --match-contract MainnetForkTest`.
+contract MainnetForkTest is Test {
+    address internal constant USDT = 0xdAC17F958D2ee523a2206206994597C13D831ec7;
+    address internal constant AUSDT = 0x23878914EFE38d27C4D67Ab83ed1b93A74D4086a;
+    address internal constant AAVE_POOL = 0x87870Bca3F3fD6335C3F4ce8392D69350B4fA4E2;
+
+    uint256 internal constant FORK_BLOCK = 21_000_000;
+
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+
+    function setUp() public {
+        vm.createSelectFork(vm.envOr("MAINNET_RPC_URL", string("https://eth.drpc.org")), FORK_BLOCK);
+    }
+
+    /// @dev The vault calls `usdt.approve(...)` through IERC20, which makes
+    ///      solidity require 32 bytes of return data. Tether returns none.
+    function test_Fork01_RealUsdtApproveReturnsABool() public {
+        vm.prank(alice);
+        (bool ok, bytes memory ret) =
+            USDT.call(abi.encodeWithSignature("approve(address,uint256)", AAVE_POOL, uint256(1e6)));
+
+        assertTrue(ok, "the raw call itself succeeds");
+        console2.log("USDT.approve() return data length:", ret.length);
+        assertEq(ret.length, 32, "IERC20.approve() requires 32 bytes of return data to ABI-decode");
+    }
+
+    /// @dev End to end: real USDT, real Aave V3 pool, the vault exactly as it is
+    ///      in src/. Reverts inside deposit() at src/UsdtYieldVault.sol:94.
+    function test_Fork02_DepositIntoRealAaveWithRealUsdt() public {
+        UsdtYieldVault vault = new UsdtYieldVault(USDT, AUSDT, AAVE_POOL, 10, owner);
+
+        deal(USDT, alice, 10_000e6);
+        vm.prank(alice);
+        (bool ok,) = USDT.call(abi.encodeWithSignature("approve(address,uint256)", address(vault), type(uint256).max));
+        assertTrue(ok, "alice approves the vault");
+
+        console2.log("alice USDT balance :", IERC20(USDT).balanceOf(alice));
+        console2.log("alice allowance    :", IERC20(USDT).allowance(alice, address(vault)));
+
+        vm.prank(alice);
+        uint256 shares = vault.deposit(1_000e6);
+
+        assertGt(shares, 0, "a 1000 USDT deposit must mint shares");
+    }
+
+    /// @dev Supporting evidence for the yield finding. The vault models its Aave
+    ///      position as the constant `totalAssetsStored`. A real Aave position is
+    ///      not constant: aUSDT rebases upward with the liquidity index. This
+    ///      test asserts the position is static - which is what the vault
+    ///      assumes - and the failure shows by how much that assumption is off.
+    function test_Fork03_AavePositionIsStatic() public {
+        deal(USDT, address(this), 100_000e6);
+        (bool ok,) = USDT.call(abi.encodeWithSignature("approve(address,uint256)", AAVE_POOL, uint256(100_000e6)));
+        assertTrue(ok, "approve the pool");
+
+        IAavePool(AAVE_POOL).supply(USDT, 100_000e6, address(this), 0);
+        uint256 positionAtSupply = IERC20(AUSDT).balanceOf(address(this));
+
+        vm.warp(block.timestamp + 365 days);
+        vm.roll(block.number + 365 * 7200);
+        uint256 positionOneYearLater = IERC20(AUSDT).balanceOf(address(this));
+
+        console2.log("aUSDT at supply time  :", positionAtSupply);
+        console2.log("aUSDT one year later  :", positionOneYearLater);
+        console2.log("interest earned       :", positionOneYearLater - positionAtSupply);
+
+        assertEq(
+            positionOneYearLater,
+            positionAtSupply,
+            "totalAssetsStored assumes the Aave position never grows - this is the interest it cannot see"
+        );
+    }
+}
