@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, StdInvariant, console2} from "forge-std/Test.sol";
+
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+import {MockUSDT} from "../mocks/MockUSDT.sol";
+import {MockAavePool, MockAToken} from "../mocks/MockAavePool.sol";
+
+/// @notice Random deposit/withdraw driver over the repo's own untouched mocks.
+contract VaultHandler is Test {
+    UsdtYieldVault public vault;
+    MockUSDT public usdt;
+    address[3] public actors;
+
+    constructor(UsdtYieldVault _vault, MockUSDT _usdt) {
+        vault = _vault;
+        usdt = _usdt;
+        actors = [makeAddr("h_alice"), makeAddr("h_bob"), makeAddr("h_carol")];
+    }
+
+    function deposit(uint256 actorSeed, uint256 amount) external {
+        address actor = actors[actorSeed % actors.length];
+        amount = bound(amount, 1e6, 100_000e6);
+        usdt.mint(actor, amount);
+        vm.startPrank(actor);
+        usdt.approve(address(vault), amount);
+        vault.deposit(amount);
+        vm.stopPrank();
+    }
+
+    function withdraw(uint256 actorSeed, uint256 shareSeed) external {
+        address actor = actors[actorSeed % actors.length];
+        uint256 held = vault.shareBalance(actor);
+        if (held == 0) return;
+        uint256 shares = bound(shareSeed, 1, held);
+        vm.prank(actor);
+        vault.withdraw(shares);
+    }
+}
+
+/// @notice Invariants any pooled vault must hold. Run with `forge test --match-contract VaultInvariantTest`.
+contract VaultInvariantTest is StdInvariant, Test {
+    UsdtYieldVault internal vault;
+    MockUSDT internal usdt;
+    MockAavePool internal pool;
+    MockAToken internal aUsdt;
+    VaultHandler internal handler;
+
+    function setUp() public {
+        usdt = new MockUSDT();
+        pool = new MockAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 10, makeAddr("owner"));
+
+        handler = new VaultHandler(vault, usdt);
+        targetContract(address(handler));
+    }
+
+    /// @notice Sanity check on the harness: share bookkeeping is internally consistent.
+    /// @dev This one holds - it is here to show the driver is not simply broken.
+    function invariant_TotalSharesEqualsSumOfBalances() public view {
+        uint256 sum;
+        for (uint256 i = 0; i < 3; ++i) {
+            sum += vault.shareBalance(handler.actors(i));
+        }
+        assertEq(sum, vault.totalShares(), "totalShares must equal the sum of every share balance");
+    }
+
+    /// @notice Every USDT the vault holds in Aave must be claimable by some shareholder.
+    /// @dev FAILS. withdraw() removes the gross amount from totalAssetsStored but
+    ///      only pulls the net out of Aave, so the difference is value nobody owns.
+    function invariant_AavePositionIsFullyOwnedByShareholders() public view {
+        uint256 position = aUsdt.balanceOf(address(vault));
+        uint256 accounted = vault.totalAssetsStored();
+        assertEq(position, accounted, "aUSDT held by the vault must equal totalAssetsStored");
+    }
+}
