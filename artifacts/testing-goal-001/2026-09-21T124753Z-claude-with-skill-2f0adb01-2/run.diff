@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {CommonBase} from "forge-std/Base.sol";
+import {StdUtils} from "forge-std/StdUtils.sol";
+import {StdCheats} from "forge-std/StdCheats.sol";
+
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+import {MockUSDT} from "../mocks/MockUSDT.sol";
+import {YieldingAavePool} from "./YieldingAavePool.sol";
+
+/// @notice Drives the vault with bounded random deposits, withdrawals and Aave
+///         interest accrual, and records ghost totals for the invariants.
+contract VaultHandler is CommonBase, StdUtils, StdCheats {
+    UsdtYieldVault public immutable vault;
+    MockUSDT public immutable usdt;
+    YieldingAavePool public immutable pool;
+
+    address[] public actors;
+    address internal currentActor;
+
+    uint256 public ghostDeposited;
+    uint256 public ghostWithdrawn;
+    uint256 public depositCalls;
+    uint256 public withdrawCalls;
+
+    constructor(UsdtYieldVault _vault, MockUSDT _usdt, YieldingAavePool _pool) {
+        vault = _vault;
+        usdt = _usdt;
+        pool = _pool;
+
+        for (uint256 i = 0; i < 4; i++) {
+            address a = address(uint160(uint256(keccak256(abi.encode("actor", i)))));
+            actors.push(a);
+            usdt.mint(a, 10_000_000e6);
+            vm.prank(a);
+            usdt.approve(address(vault), type(uint256).max);
+        }
+    }
+
+    modifier useActor(uint256 seed) {
+        currentActor = actors[seed % actors.length];
+        _;
+    }
+
+    function actorCount() external view returns (uint256) {
+        return actors.length;
+    }
+
+    function deposit(uint256 actorSeed, uint256 amount) external useActor(actorSeed) {
+        amount = bound(amount, vault.MIN_DEPOSIT(), 1_000_000e6);
+        if (usdt.balanceOf(currentActor) < amount) return;
+
+        vm.prank(currentActor);
+        try vault.deposit(amount) {
+            ghostDeposited += amount;
+            depositCalls++;
+        } catch {}
+    }
+
+    function withdraw(uint256 actorSeed, uint256 sharesSeed) external useActor(actorSeed) {
+        uint256 held = vault.shareBalance(currentActor);
+        if (held == 0) return;
+        uint256 shares = bound(sharesSeed, 1, held);
+
+        vm.prank(currentActor);
+        try vault.withdraw(shares) returns (uint256 net) {
+            ghostWithdrawn += net;
+            withdrawCalls++;
+        } catch {}
+    }
+
+    function accrueInterest(uint256 bps) external {
+        pool.accrueInterest(bound(bps, 0, 100));
+    }
+}
diff --git a/test/harness/YieldingAavePool.sol b/test/harness/YieldingAavePool.sol
new file mode 100644
index 0000000..87cae74
--- /dev/null
+++ b/test/harness/YieldingAavePool.sol
@@ -0,0 +1,88 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+
+import {IAavePool} from "../../src/interfaces/IAavePool.sol";
+import {MockUSDT} from "../mocks/MockUSDT.sol";
+
+/// @notice A rebasing aToken, modelled on the real Aave V3 aUSDT: holders keep a
+///         *scaled* balance and `balanceOf` multiplies it by a liquidity index that
+///         only ever grows. This is the behaviour `test/mocks/MockAavePool.sol`
+///         leaves out -- its aToken is a fixed-supply ERC20 that never accrues.
+contract YieldingAToken {
+    string public constant name = "Aave Tether USD";
+    string public constant symbol = "aUSDT";
+    uint8 public constant decimals = 6;
+
+    uint256 internal constant RAY = 1e27;
+
+    address public immutable pool;
+    uint256 public liquidityIndex = RAY;
+    mapping(address => uint256) public scaledBalanceOf;
+
+    constructor() {
+        pool = msg.sender;
+    }
+
+    modifier onlyPool() {
+        require(msg.sender == pool, "only pool");
+        _;
+    }
+
+    /// @dev Aave's WadRayMath.rayMul / rayDiv: multiply-then-round-half-up.
+    function rayMul(uint256 a, uint256 b) internal pure returns (uint256) {
+        return (a * b + RAY / 2) / RAY;
+    }
+
+    function rayDiv(uint256 a, uint256 b) internal pure returns (uint256) {
+        return (a * RAY + b / 2) / b;
+    }
+
+    function balanceOf(address account) public view returns (uint256) {
+        return rayMul(scaledBalanceOf[account], liquidityIndex);
+    }
+
+    function mint(address to, uint256 amount) external onlyPool {
+        scaledBalanceOf[to] += rayDiv(amount, liquidityIndex);
+    }
+
+    function burn(address from, uint256 amount) external onlyPool {
+        scaledBalanceOf[from] -= rayDiv(amount, liquidityIndex);
+    }
+
+    function bumpIndex(uint256 newIndex) external onlyPool {
+        liquidityIndex = newIndex;
+    }
+}
+
+/// @notice Aave V3 pool stand-in that actually pays interest.
+contract YieldingAavePool is IAavePool {
+    MockUSDT public immutable underlying;
+    YieldingAToken public immutable aToken;
+
+    constructor(address _underlying) {
+        underlying = MockUSDT(_underlying);
+        aToken = new YieldingAToken();
+    }
+
+    function supply(address, uint256 amount, address onBehalfOf, uint16) external override {
+        IERC20(address(underlying)).transferFrom(msg.sender, address(this), amount);
+        aToken.mint(onBehalfOf, amount);
+    }
+
+    function withdraw(address, uint256 amount, address to) external override returns (uint256) {
+        aToken.burn(msg.sender, amount);
+        IERC20(address(underlying)).transfer(to, amount);
+        return amount;
+    }
+
+    /// @notice Accrue `bps` of interest to every aToken holder, exactly as a rising
+    ///         Aave liquidity index does. Fresh underlying is minted to the pool so
+    ///         the new aToken balances stay fully redeemable.
+    function accrueInterest(uint256 bps) external {
+        uint256 before = underlying.balanceOf(address(this));
+        aToken.bumpIndex((aToken.liquidityIndex() * (10_000 + bps)) / 10_000);
+        underlying.mint(address(this), (before * bps) / 10_000);
+    }
+}

