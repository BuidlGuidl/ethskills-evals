@@ -0,0 +1,86 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console} from "forge-std/Test.sol";
+
+import {UsdtYieldVault} from "../src/UsdtYieldVault.sol";
+import {MockUSDT} from "./mocks/MockUSDT.sol";
+import {YieldingAavePool, YieldingAToken} from "./harness/YieldingAavePool.sol";
+
+/// @notice Property-based tests. The shipped suite contains no fuzz tests at all.
+contract VaultFuzzTest is Test {
+    UsdtYieldVault vault;
+    MockUSDT usdt;
+    YieldingAavePool pool;
+    YieldingAToken aUsdt;
+
+    address owner = makeAddr("owner");
+    address alice = makeAddr("alice");
+    address bob = makeAddr("bob");
+
+    function setUp() public {
+        usdt = new MockUSDT();
+        pool = new YieldingAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 10, owner);
+
+        usdt.mint(alice, type(uint128).max);
+        usdt.mint(bob, type(uint128).max);
+        vm.prank(alice);
+        usdt.approve(address(vault), type(uint256).max);
+        vm.prank(bob);
+        usdt.approve(address(vault), type(uint256).max);
+    }
+
+    /// @notice Generalises Y-1: for ANY deposit size and ANY amount of accrued Aave
+    ///         interest, the sole depositor's redeemable balance never moves.
+    function testFuzz_SoleDepositorEarnsYield(uint256 amount, uint256 yieldBps) public {
+        amount = bound(amount, 1e6, 100_000_000e6);
+        yieldBps = bound(yieldBps, 1, 2_000); // up to 20%
+
+        vm.prank(alice);
+        vault.deposit(amount);
+
+        uint256 beforeYield = vault.balanceOfUnderlying(alice);
+        pool.accrueInterest(yieldBps);
+
+        assertGt(
+            vault.balanceOfUnderlying(alice), beforeYield, "sole depositor's balance must grow when Aave pays interest"
+        );
+    }
+
+    /// @notice EXPECTED TO PASS. A sole depositor who deposits and immediately exits
+    ///         should lose exactly the 0.3% exit fee -- the deposit fee is refunded to
+    ///         her because she owns 100% of the shares it accrues to.
+    function testFuzz_SoleDepositorRoundtripLosesOnlyTheExitFee(uint256 amount) public {
+        amount = bound(amount, 1e6, 100_000_000e6);
+
+        uint256 before = usdt.balanceOf(alice);
+        vm.prank(alice);
+        uint256 shares = vault.deposit(amount);
+        vm.prank(alice);
+        vault.withdraw(shares);
+
+        uint256 lost = before - usdt.balanceOf(alice);
+        uint256 expected = (amount * vault.WITHDRAW_FEE_BPS()) / vault.BPS_DENOMINATOR();
+        assertApproxEqAbs(lost, expected, 2, "roundtrip should cost exactly the exit fee");
+    }
+
+    /// @notice EXPECTED TO PASS. Two identical deposits at the same moment must be
+    ///         worth the same.
+    function testFuzz_EqualDepositorsAreTreatedEqually(uint256 amount) public {
+        amount = bound(amount, 1e6, 100_000_000e6);
+
+        vm.prank(alice);
+        vault.deposit(amount);
+        vm.prank(bob);
+        vault.deposit(amount);
+
+        assertApproxEqRel(
+            vault.balanceOfUnderlying(bob),
+            vault.balanceOfUnderlying(alice),
+            0.002e18,
+            "equal depositors should hold near-equal claims"
+        );
+    }
+}
diff --git a/test/VaultInvariants.t.sol b/test/VaultInvariants.t.sol
new file mode 100644
index 0000000..8ab9db0
--- /dev/null
+++ b/test/VaultInvariants.t.sol
@@ -0,0 +1,85 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console} from "forge-std/Test.sol";
+
+import {UsdtYieldVault} from "../src/UsdtYieldVault.sol";
+import {MockUSDT} from "./mocks/MockUSDT.sol";
+import {YieldingAavePool, YieldingAToken} from "./harness/YieldingAavePool.sol";
+import {VaultHandler} from "./harness/VaultHandler.sol";
+
+/// @notice Stateful invariant testing: thousands of random deposit / withdraw /
+///         interest-accrual sequences, asserting properties that must hold after
+///         every single one. The shipped suite has none of these.
+contract VaultInvariantsTest is Test {
+    UsdtYieldVault vault;
+    MockUSDT usdt;
+    YieldingAavePool pool;
+    YieldingAToken aUsdt;
+    VaultHandler handler;
+
+    address owner = makeAddr("owner");
+
+    function setUp() public {
+        usdt = new MockUSDT();
+        pool = new YieldingAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 10, owner);
+
+        handler = new VaultHandler(vault, usdt, pool);
+        targetContract(address(handler));
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        I-1: EXPECTED TO HOLD -- the vault stays solvent
+    //////////////////////////////////////////////////////////////*/
+
+    /// @notice The vault must always hold at least as much aUSDT as it owes.
+    /// @dev Tolerance of 1 unit per mint/burn: the aToken scales balances through a
+    ///      ray index, so each mint/burn rounds by up to 1 base unit. That dust is a
+    ///      property of aToken scaling (real aUSDT included), not of the vault, so it
+    ///      is excluded rather than reported. Anything larger is genuine insolvency.
+    function invariant_VaultIsSolvent() public view {
+        uint256 dust = handler.depositCalls() + handler.withdrawCalls() + 1;
+        assertGe(
+            aUsdt.balanceOf(address(vault)) + dust,
+            vault.totalAssetsStored(),
+            "vault owes materially more than its Aave position is worth"
+        );
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        I-2: EXPECTED TO HOLD -- share bookkeeping is consistent
+    //////////////////////////////////////////////////////////////*/
+
+    /// @notice Shares outstanding must equal the sum of every holder's balance.
+    function invariant_TotalSharesEqualsSumOfBalances() public view {
+        uint256 sum;
+        for (uint256 i = 0; i < handler.actorCount(); i++) {
+            sum += vault.shareBalance(handler.actors(i));
+        }
+        assertEq(sum, vault.totalShares(), "totalShares drifted from the sum of balances");
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        I-3: the books must describe the actual Aave position
+    //////////////////////////////////////////////////////////////*/
+
+    /// @notice `totalAssetsStored` is the ONLY number the vault prices shares from.
+    ///         If it does not equal the vault's real aUSDT balance, every share price,
+    ///         every `balanceOfUnderlying`, and every redemption is wrong.
+    function invariant_BooksMatchTheAavePosition() public view {
+        assertEq(
+            vault.totalAssetsStored(),
+            aUsdt.balanceOf(address(vault)),
+            "vault books do not match its real Aave position"
+        );
+    }
+
+    function invariant_CallSummary() public view {
+        console.log("deposit calls   :", handler.depositCalls());
+        console.log("withdraw calls  :", handler.withdrawCalls());
+        console.log("totalAssetsStored:", vault.totalAssetsStored());
+        console.log("real aUSDT held  :", aUsdt.balanceOf(address(vault)));
+    }
+}
diff --git a/test/YieldAccounting.t.sol b/test/YieldAccounting.t.sol
new file mode 100644
index 0000000..b9c8707
--- /dev/null
+++ b/test/YieldAccounting.t.sol
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console} from "forge-std/Test.sol";
+
+import {UsdtYieldVault} from "../src/UsdtYieldVault.sol";
+import {MockUSDT} from "./mocks/MockUSDT.sol";
+import {YieldingAavePool, YieldingAToken} from "./harness/YieldingAavePool.sol";
+
+/// @notice The shipped suite runs against a pool whose aToken never accrues, so it
+///         cannot observe what the vault does with yield. These tests use a pool that
+///         rebases like the real aUSDT does (see the fork test for proof it rebases).
+contract YieldAccountingTest is Test {
+    UsdtYieldVault vault;
+    MockUSDT usdt;
+    YieldingAavePool pool;
+    YieldingAToken aUsdt;
+
+    address owner = makeAddr("owner");
+    address alice = makeAddr("alice");
+    address bob = makeAddr("bob");
+
+    uint256 constant DEPOSIT = 100_000e6;
+
+    function setUp() public {
+        usdt = new MockUSDT();
+        pool = new YieldingAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 10, owner);
+
+        usdt.mint(alice, 1_000_000e6);
+        usdt.mint(bob, 1_000_000e6);
+        vm.prank(alice);
+        usdt.approve(address(vault), type(uint256).max);
+        vm.prank(bob);
+        usdt.approve(address(vault), type(uint256).max);
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        Y-1: yield never reaches the depositor
+    //////////////////////////////////////////////////////////////*/
+
+    /// @notice After a year at ~5% the vault's aUSDT is worth 105,000 USDT.
+    ///         The sole depositor owns 100% of the vault, so her redeemable
+    ///         balance should track that.
+    function test_DepositorBalanceReflectsAaveYield() public {
+        vm.prank(alice);
+        vault.deposit(DEPOSIT);
+
+        pool.accrueInterest(500); // one year at 5%
+
+        console.log("vault aUSDT (real value)       :", aUsdt.balanceOf(address(vault)));
+        console.log("vault.totalAssets()            :", vault.totalAssets());
+        console.log("alice balanceOfUnderlying()    :", vault.balanceOfUnderlying(alice));
+
+        assertEq(
+            vault.balanceOfUnderlying(alice),
+            aUsdt.balanceOf(address(vault)),
+            "sole depositor should own all accrued yield"
+        );
+    }
+
+    /// @notice A depositor in a yield vault should not end a profitable year poorer.
+    function test_DepositorIsNotWorseOffAfterAYearOfYield() public {
+        uint256 before = usdt.balanceOf(alice);
+
+        vm.prank(alice);
+        uint256 shares = vault.deposit(DEPOSIT);
+
+        pool.accrueInterest(500);
+
+        vm.prank(alice);
+        uint256 got = vault.withdraw(shares);
+
+        console.log("alice deposited                :", DEPOSIT);
+        console.log("alice withdrew                 :", got);
+        console.log("aUSDT left stranded in vault   :", aUsdt.balanceOf(address(vault)));
+        console.log("vault.totalAssetsStored()      :", vault.totalAssetsStored());
+        console.log("vault.totalShares()            :", vault.totalShares());
+
+        assertGe(usdt.balanceOf(alice), before, "depositor must not lose principal over a profitable year");
+    }
+
+    /// @notice Once everyone has exited, nothing is left owed -- so the vault should
+    ///         not still be sitting on aUSDT that no share can ever claim.
+    function test_NoAusdtIsStrandedAfterEveryoneExits() public {
+        vm.prank(alice);
+        uint256 aShares = vault.deposit(DEPOSIT);
+        vm.prank(bob);
+        uint256 bShares = vault.deposit(DEPOSIT);
+
+        pool.accrueInterest(500);
+
+        vm.prank(alice);
+        vault.withdraw(aShares);
+        vm.prank(bob);
+        vault.withdraw(bShares);
+
+        assertEq(vault.totalShares(), 0, "all shares burned");
+
+        uint256 stranded = aUsdt.balanceOf(address(vault));
+        console.log("shares outstanding             :", vault.totalShares());
+        console.log("aUSDT still held by the vault  :", stranded);
+        console.log("...in USDT, unclaimable by anyone. No harvest/sweep/rescue function exists.");
+
+        assertEq(stranded, 0, "no value may be left behind once all shares are burned");
+    }
+}
diff --git a/test/fork/MainnetForkIntegration.t.sol b/test/fork/MainnetForkIntegration.t.sol
new file mode 100644
index 0000000..4ced52e
--- /dev/null
+++ b/test/fork/MainnetForkIntegration.t.sol
@@ -0,0 +1,114 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console} from "forge-std/Test.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+import {IAavePool} from "../../src/interfaces/IAavePool.sol";
+
+/// @notice Non-standard USDT surface: `approve` and `transfer` return NOTHING.
+interface IUsdtNonStandard {
+    function approve(address spender, uint256 value) external; // no return value
+    function allowance(address owner, address spender) external view returns (uint256);
+    function balanceOf(address account) external view returns (uint256);
+}
+
+/// @notice The vault is deployed against the REAL mainnet USDT and the REAL Aave V3
+///         pool named in the deployment plan, at a pinned block so results are stable.
+contract MainnetForkIntegrationTest is Test {
+    address constant USDT = 0xdAC17F958D2ee523a2206206994597C13D831ec7;
+    address constant AAVE_POOL = 0x87870Bca3F3fD6335C3F4ce8392D69350B4fA4E2;
+    address constant AUSDT = 0x23878914EFE38d27C4D67Ab83ed1b93A74D4086a;
+
+    string constant RPC = "https://eth.drpc.org";
+    uint256 constant FORK_BLOCK = 25_000_000;
+
+    UsdtYieldVault vault;
+    address owner = makeAddr("owner");
+    address alice = makeAddr("alice");
+
+    function setUp() public {
+        vm.createSelectFork(RPC, FORK_BLOCK);
+        vault = new UsdtYieldVault(USDT, AUSDT, AAVE_POOL, 10, owner);
+
+        deal(USDT, alice, 100_000e6);
+        vm.prank(alice);
+        IUsdtNonStandard(USDT).approve(address(vault), type(uint256).max);
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        F-1: the headline user journey against the real deployment
+    //////////////////////////////////////////////////////////////*/
+
+    /// @notice A user deposits 1,000 real USDT into the vault on mainnet.
+    ///         This is the single most basic thing the product must do.
+    function test_Fork_UserCanDepositRealUsdt() public {
+        assertEq(IUsdtNonStandard(USDT).balanceOf(alice), 100_000e6, "alice funded with real USDT");
+
+        vm.prank(alice);
+        uint256 shares = vault.deposit(1_000e6);
+
+        assertGt(shares, 0, "deposit must mint shares");
+        assertGt(IERC20(AUSDT).balanceOf(address(vault)), 0, "vault must hold real aUSDT");
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        F-2: isolate the mechanism, so the cause is not in doubt
+    //////////////////////////////////////////////////////////////*/
+
+    /// @notice Real USDT's `approve` returns no data at all. Calling it through the
+    ///         standard `IERC20` ABI (as `UsdtYieldVault.deposit` line 94 does) makes
+    ///         solc try to ABI-decode a `bool` from 0 returned bytes, which reverts.
+    function test_Fork_RealUsdtApproveHasNoReturnValue() public {
+        // The raw call itself succeeds and returns zero bytes.
+        vm.prank(alice);
+        (bool ok, bytes memory ret) = USDT.call(abi.encodeWithSignature("approve(address,uint256)", AAVE_POOL, 1e6));
+        assertTrue(ok, "raw approve succeeds at the EVM level");
+        assertEq(ret.length, 0, "real USDT approve returns 0 bytes, not a bool");
+
+        // The very same call typed as IERC20 (what the vault does) reverts on decode.
+        vm.prank(alice);
+        vm.expectRevert();
+        IERC20(USDT).approve(AAVE_POOL, 1e6);
+    }
+
+    /// @notice Second, independent reason the bare `approve` is unsafe here: real USDT
+    ///         refuses to overwrite a non-zero allowance with another non-zero value.
+    ///         `deposit` re-approves on every single call, so any leftover allowance
+    ///         (a partial `supply`, a donated dust balance) bricks every later deposit.
+    function test_Fork_RealUsdtRejectsNonZeroToNonZeroApprove() public {
+        vm.startPrank(alice);
+        IUsdtNonStandard(USDT).approve(AAVE_POOL, 1e6); // 0 -> non-zero: fine
+        assertEq(IUsdtNonStandard(USDT).allowance(alice, AAVE_POOL), 1e6);
+
+        vm.expectRevert();
+        IUsdtNonStandard(USDT).approve(AAVE_POOL, 2e6); // non-zero -> non-zero: rejected
+        vm.stopPrank();
+    }
+
+    /*//////////////////////////////////////////////////////////////
+        F-3: real aUSDT accrues yield the vault can never see
+    //////////////////////////////////////////////////////////////*/
+
+    /// @notice Establishes the premise for the yield-accounting finding: real aUSDT
+    ///         balances grow over time, while `totalAssetsStored` is a plain counter
+    ///         that only ever moves on deposit/withdraw.
+    function test_Fork_RealAusdtBalanceGrowsButVaultCounterCannot() public {
+        // Supply 100k USDT to real Aave from this test contract, mimicking the vault.
+        deal(USDT, address(this), 100_000e6);
+        IUsdtNonStandard(USDT).approve(AAVE_POOL, 100_000e6);
+        IAavePool(AAVE_POOL).supply(USDT, 100_000e6, address(this), 0);
+
+        uint256 aBefore = IERC20(AUSDT).balanceOf(address(this));
+        vm.warp(block.timestamp + 365 days);
+        uint256 aAfter = IERC20(AUSDT).balanceOf(address(this));
+
+        console.log("aUSDT at supply time :", aBefore);
+        console.log("aUSDT after 365 days :", aAfter);
+        console.log("interest accrued     :", aAfter - aBefore);
+        console.log("vault totalAssets()  :", vault.totalAssets());
+
+        assertGt(aAfter, aBefore, "real aUSDT rebases upward");
+    }
+}
