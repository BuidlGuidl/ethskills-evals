+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console2} from "forge-std/Test.sol";
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+
+/// @notice Fork tests against the exact mainnet addresses named in README.md.
+///         Nothing under src/ or test/mocks/ is touched; these run against the
+///         real USDT token and the real Aave V3 pool.
+///
+///         Re-run with:
+///           forge test --match-path 'test/fork/*' -vv
+///         (set MAINNET_RPC_URL to use your own endpoint; a public one is the default)
+contract MainnetUsdtForkTest is Test {
+    address internal constant USDT = 0xdAC17F958D2ee523a2206206994597C13D831ec7;
+    address internal constant AUSDT = 0x23878914EFE38d27C4D67Ab83ed1b93A74D4086a;
+    address internal constant AAVE_POOL = 0x87870Bca3F3fD6335C3F4ce8392D69350B4fA4E2;
+
+    uint256 internal constant FORK_BLOCK = 26_000_000;
+
+    UsdtYieldVault internal vault;
+    address internal alice = makeAddr("alice");
+    address internal owner = makeAddr("owner");
+
+    function setUp() public {
+        string memory rpc = vm.envOr("MAINNET_RPC_URL", string("https://eth.drpc.org"));
+        vm.createSelectFork(rpc, FORK_BLOCK);
+
+        vault = new UsdtYieldVault(USDT, AUSDT, AAVE_POOL, 10, owner);
+
+        deal(USDT, alice, 10_000e6);
+        vm.prank(alice);
+        // USDT's own approve() is non-standard too, so call it raw.
+        (bool ok,) = USDT.call(abi.encodeWithSignature("approve(address,uint256)", address(vault), type(uint256).max));
+        require(ok, "alice approve failed");
+    }
+
+    /// @notice The headline result: a plain deposit of real USDT reverts on mainnet.
+    function test_Fork_DepositRevertsOnRealUsdt() public {
+        vm.prank(alice);
+        vm.expectRevert();
+        vault.deposit(1_000e6);
+    }
+
+    /// @notice Same thing without expectRevert, so the failure is visible in the trace.
+    function test_Fork_DepositRevertsOnRealUsdt_RawTrace() public {
+        vm.prank(alice);
+        vault.deposit(1_000e6);
+    }
+
+    /// @notice Root cause: real USDT's approve() returns no data at all, so the
+    ///         `bool` return in OpenZeppelin's IERC20 fails to decode.
+    function test_Fork_UsdtApproveReturnsNoData() public {
+        vm.prank(alice);
+        (bool ok, bytes memory ret) = USDT.call(abi.encodeWithSignature("approve(address,uint256)", address(0xBEEF), 0));
+        console2.log("approve call succeeded:", ok);
+        console2.log("approve returndata length:", ret.length);
+        assertTrue(ok, "raw approve should succeed");
+        assertEq(ret.length, 0, "USDT approve returns nothing; IERC20 expects 32 bytes");
+    }
+
+    /// @notice Real USDT's transfer() also returns no data - the same decode trap
+    ///         would hit any un-wrapped transfer call.
+    function test_Fork_UsdtTransferReturnsNoData() public {
+        vm.prank(alice);
+        (bool ok, bytes memory ret) = USDT.call(abi.encodeWithSignature("transfer(address,uint256)", address(0xBEEF), 1));
+        assertTrue(ok);
+        assertEq(ret.length, 0, "USDT transfer returns nothing");
+    }
+
+    /// @notice Second, independent mainnet trap: USDT forbids overwriting a
+    ///         non-zero allowance with another non-zero value. Even a bool-safe
+    ///         approve would revert here on any repeat deposit that left dust.
+    function test_Fork_UsdtForbidsNonZeroToNonZeroApprove() public {
+        address spender = makeAddr("spender");
+        vm.startPrank(alice);
+        (bool ok1,) = USDT.call(abi.encodeWithSignature("approve(address,uint256)", spender, 100));
+        assertTrue(ok1, "0 -> 100 must succeed");
+        (bool ok2,) = USDT.call(abi.encodeWithSignature("approve(address,uint256)", spender, 200));
+        vm.stopPrank();
+        console2.log("100 -> 200 approve succeeded:", ok2);
+        assertFalse(ok2, "USDT reverts on non-zero -> non-zero approve");
+    }
+}
+
+interface IAaveDataPool {
+    function getReserveNormalizedIncome(address asset) external view returns (uint256);
+}
+
+/// @notice Quantifies, from mainnet data, the yield the vault's accounting
+///         cannot see. Aave's liquidity index is what makes aUSDT balances grow;
+///         `totalAssetsStored` is a plain uint that never reads it.
+contract MainnetAaveIndexForkTest is Test {
+    address internal constant USDT = 0xdAC17F958D2ee523a2206206994597C13D831ec7;
+    address internal constant AAVE_POOL = 0x87870Bca3F3fD6335C3F4ce8392D69350B4fA4E2;
+
+    uint256 internal constant BLOCK_EARLY = 25_800_000;
+    uint256 internal constant BLOCK_LATE = 26_000_000;
+
+    function test_Fork_AaveIndexGrowsButVaultAccountingCannot() public {
+        string memory rpc = vm.envOr("MAINNET_RPC_URL", string("https://eth.drpc.org"));
+
+        vm.createSelectFork(rpc, BLOCK_EARLY);
+        uint256 indexEarly = IAaveDataPool(AAVE_POOL).getReserveNormalizedIncome(USDT);
+        uint256 tsEarly = block.timestamp;
+
+        vm.createSelectFork(rpc, BLOCK_LATE);
+        uint256 indexLate = IAaveDataPool(AAVE_POOL).getReserveNormalizedIncome(USDT);
+        uint256 tsLate = block.timestamp;
+
+        uint256 elapsed = tsLate - tsEarly;
+        uint256 growthBps = ((indexLate - indexEarly) * 10_000) / indexEarly;
+
+        console2.log("liquidity index @ block 25_800_000:", indexEarly);
+        console2.log("liquidity index @ block 26_000_000:", indexLate);
+        console2.log("elapsed seconds:", elapsed);
+        console2.log("growth in bps over the window:", growthBps);
+        console2.log("annualised bps:", (growthBps * 365 days) / elapsed);
+        console2.log("USDT earned on a 1,000,000 USDT position (base units):", (1_000_000e6 * growthBps) / 10_000);
+
+        assertGt(indexLate, indexEarly, "aUSDT rebases upward; a uint256 snapshot cannot track it");
+    }
+}

