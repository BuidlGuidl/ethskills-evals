+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console2} from "forge-std/Test.sol";
+
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+import {MockUSDT} from "../mocks/MockUSDT.sol";
+import {YieldAavePool, YieldAToken, UsdtLike, FeeOnTransferUsdt} from "./AuditMocks.sol";
+
+/// @notice Failing tests against src/UsdtYieldVault.sol exactly as it stands.
+///         Nothing under src/ or test/mocks/ is modified; the existing mocks are
+///         imported, never edited.
+///
+///         Run with: forge test --match-path 'test/audit/*' -vv
+contract AccountingAuditTest is Test {
+    uint256 internal constant INITIAL_FEE_BPS = 10;
+
+    MockUSDT internal usdt;
+    YieldAavePool internal pool;
+    YieldAToken internal aUsdt;
+    UsdtYieldVault internal vault;
+
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+    address internal bob = makeAddr("bob");
+
+    function setUp() public {
+        usdt = new MockUSDT();
+        pool = new YieldAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), INITIAL_FEE_BPS, owner);
+
+        usdt.mint(alice, 1_000_000e6);
+        usdt.mint(bob, 1_000_000e6);
+        vm.prank(alice);
+        usdt.approve(address(vault), type(uint256).max);
+        vm.prank(bob);
+        usdt.approve(address(vault), type(uint256).max);
+    }
+
+    // ---------------------------------------------------------------------
+    // F-1  Real USDT semantics: deposit() cannot work on mainnet.
+    //      (Local reproduction of the fork result, so it runs with no RPC.)
+    // ---------------------------------------------------------------------
+
+    function test_F1_DepositRevertsAgainstRealUsdtSemantics() public {
+        UsdtLike realUsdt = new UsdtLike();
+        YieldAavePool realPool = new YieldAavePool(address(realUsdt));
+        UsdtYieldVault realVault =
+            new UsdtYieldVault(address(realUsdt), address(realPool.aToken()), address(realPool), INITIAL_FEE_BPS, owner);
+
+        realUsdt.mint(alice, 10_000e6);
+        vm.startPrank(alice);
+        realUsdt.approve(address(realVault), type(uint256).max);
+
+        // The vault reverts: usdt.approve() is called through IERC20, which
+        // decodes a bool return value that real USDT never provides.
+        realVault.deposit(1_000e6);
+        vm.stopPrank();
+    }
+
+    // ---------------------------------------------------------------------
+    // F-2  The yield vault pays no yield. Aave interest is never accounted
+    //      for and is permanently stranded.
+    // ---------------------------------------------------------------------
+
+    function test_F2_AaveInterestNeverReachesDepositors() public {
+        vm.prank(alice);
+        uint256 shares = vault.deposit(1_000e6);
+
+        // A year passes; Aave pays 10% on the vault's position.
+        pool.accrue(address(vault), 100e6);
+
+        console2.log("vault aUSDT balance (real position):", aUsdt.balanceOf(address(vault)));
+        console2.log("vault totalAssets()  (what it thinks):", vault.totalAssets());
+        console2.log("alice balanceOfUnderlying:           ", vault.balanceOfUnderlying(alice));
+
+        // The vault's own view of the world is unchanged by 100 USDT of interest.
+        assertEq(
+            vault.totalAssets(), aUsdt.balanceOf(address(vault)), "totalAssets() must track the real Aave position"
+        );
+
+        uint256 before = usdt.balanceOf(alice);
+        vm.prank(alice);
+        vault.withdraw(shares);
+        uint256 received = usdt.balanceOf(alice) - before;
+
+        console2.log("alice deposited:", uint256(1_000e6));
+        console2.log("alice received: ", received);
+        assertGe(received, 1_000e6, "sole depositor should earn the 100 USDT of Aave interest, not lose money");
+    }
+
+    function test_F2b_InterestIsStrandedAfterEveryoneExits() public {
+        vm.prank(alice);
+        uint256 shares = vault.deposit(1_000e6);
+        pool.accrue(address(vault), 100e6);
+
+        vm.prank(alice);
+        vault.withdraw(shares);
+
+        uint256 stranded = aUsdt.balanceOf(address(vault));
+        console2.log("totalShares after full exit:", vault.totalShares());
+        console2.log("aUSDT left in the vault:    ", stranded);
+        assertEq(vault.totalShares(), 0);
+        assertEq(stranded, 0, "no shares exist any more, so any aUSDT left here is unrecoverable");
+    }
+
+    // ---------------------------------------------------------------------
+    // F-3  The withdrawal fee is deleted from the accounting instead of
+    //      accruing to the remaining shareholders, as README/NatSpec promise.
+    // ---------------------------------------------------------------------
+
+    function test_F3_WithdrawFeeDoesNotAccrueToRemainingShareholders() public {
+        vm.prank(alice);
+        uint256 aliceShares = vault.deposit(1_000e6);
+        vm.prank(bob);
+        vault.deposit(1_000e6);
+
+        uint256 bobBefore = vault.balanceOfUnderlying(bob);
+        uint256 priceBefore = vault.sharePrice();
+
+        // Alice exits; her 0.3% withdrawal fee stays supplied in Aave.
+        vm.prank(alice);
+        vault.withdraw(aliceShares);
+
+        console2.log("bob underlying before alice's exit:", bobBefore);
+        console2.log("bob underlying after  alice's exit:", vault.balanceOfUnderlying(bob));
+        console2.log("share price before:", priceBefore);
+        console2.log("share price after: ", vault.sharePrice());
+
+        // Alice paid a 3 USDT withdrawal fee that stayed supplied in Aave.
+        // Bob is the only shareholder left, so essentially all of it is his.
+        assertGe(
+            vault.balanceOfUnderlying(bob),
+            bobBefore + 2_900_000,
+            "alice's 3 USDT withdrawal fee should accrue to the remaining holder"
+        );
+    }
+
+    function test_F3b_WithdrawFeeIsStrandedForever() public {
+        vm.prank(alice);
+        uint256 shares = vault.deposit(1_000e6);
+
+        vm.prank(alice);
+        vault.withdraw(shares);
+
+        console2.log("totalShares:      ", vault.totalShares());
+        console2.log("totalAssetsStored:", vault.totalAssetsStored());
+        console2.log("aUSDT still held: ", aUsdt.balanceOf(address(vault)));
+        assertEq(aUsdt.balanceOf(address(vault)), 0, "3 USDT of fee is stranded with zero shares outstanding");
+    }
+
+    // ---------------------------------------------------------------------
+    // F-4  Small withdrawals burn shares and pay out nothing.
+    // ---------------------------------------------------------------------
+
+    function test_F4_DustWithdrawBurnsSharesForZeroUsdt() public {
+        vm.prank(alice);
+        vault.deposit(1_000e6);
+
+        uint256 sharesBefore = vault.shareBalance(alice);
+        uint256 usdtBefore = usdt.balanceOf(alice);
+
+        vm.prank(alice);
+        uint256 net = vault.withdraw(9e11); // just under one USDT-unit's worth of shares
+
+        console2.log("shares burned:", sharesBefore - vault.shareBalance(alice));
+        console2.log("usdt received:", usdt.balanceOf(alice) - usdtBefore);
+        console2.log("withdraw() returned:", net);
+        assertGt(usdt.balanceOf(alice) - usdtBefore, 0, "burning shares must not return zero USDT");
+    }
+
+    // ---------------------------------------------------------------------
+    // F-5  The owner can set an arbitrary deposit fee, including one that
+    //      confiscates a pending deposit or bricks deposits outright.
+    // ---------------------------------------------------------------------
+
+    function test_F5_OwnerCanFrontRunDepositAndConfiscate99Percent() public {
+        vm.prank(alice);
+        vault.deposit(1_000e6);
+        uint256 aliceBefore = vault.balanceOfUnderlying(alice);
+
+        // Owner sees bob's deposit in the mempool and raises the fee first.
+        vm.prank(owner);
+        vault.setDepositFee(9_900);
+
+        vm.prank(bob);
+        vault.deposit(1_000e6);
+
+        console2.log("bob deposited:            ", uint256(1_000e6));
+        console2.log("bob underlying after:     ", vault.balanceOfUnderlying(bob));
+        console2.log("alice underlying before:  ", aliceBefore);
+        console2.log("alice underlying after:   ", vault.balanceOfUnderlying(alice));
+
+        assertGe(vault.balanceOfUnderlying(bob), 990e6, "bob should not lose 99% of his deposit to a fee change");
+    }
+
+    function test_F5b_OwnerCanBrickDepositsWithFeeAbove100Percent() public {
+        vm.prank(owner);
+        vault.setDepositFee(10_001); // no upper bound is enforced
+
+        vm.prank(alice);
+        vault.deposit(1_000e6); // reverts: arithmetic underflow in `amount - fee`
+    }
+
+    // ---------------------------------------------------------------------
+    // F-6  pause() freezes withdrawals, not just deposits. User funds are
+    //      held hostage by a single owner key with no timelock or exit hatch.
+    // ---------------------------------------------------------------------
+
+    function test_F6_PauseTrapsDepositorFunds() public {
+        vm.prank(alice);
+        uint256 shares = vault.deposit(1_000e6);
+
+        vm.prank(owner);
+        vault.pause();
+
+        vm.prank(alice);
+        vault.withdraw(shares); // reverts: EnforcedPause
+    }
+
+    // ---------------------------------------------------------------------
+    // F-7  USDT's live transfer-fee switch breaks deposits entirely: the
+    //      vault supplies `amount` but only ever received `amount - fee`.
+    // ---------------------------------------------------------------------
+
+    function test_F7_UsdtTransferFeeBreaksDeposit() public {
+        FeeOnTransferUsdt feeUsdt = new FeeOnTransferUsdt();
+        YieldAavePool feePool = new YieldAavePool(address(feeUsdt));
+        UsdtYieldVault feeVault =
+            new UsdtYieldVault(address(feeUsdt), address(feePool.aToken()), address(feePool), INITIAL_FEE_BPS, owner);
+
+        feeUsdt.mint(alice, 10_000e6);
+        feeUsdt.setBasisPointsRate(10); // Tether turns its fee back on
+
+        vm.startPrank(alice);
+        feeUsdt.approve(address(feeVault), type(uint256).max);
+        feeVault.deposit(1_000e6); // reverts: vault holds 999e6, tries to supply 1000e6
+        vm.stopPrank();
+    }
+}
diff --git a/test/audit/AuditMocks.sol b/test/audit/AuditMocks.sol
new file mode 100644
index 0000000..8ddb728
--- /dev/null
+++ b/test/audit/AuditMocks.sol
@@ -0,0 +1,174 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {ERC20} from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+
+import {IAavePool} from "../../src/interfaces/IAavePool.sol";
+
+/// @notice Aave V3 pool stand-in that can actually accrue interest, unlike the
+///         suite's MockAavePool (whose aToken balance never changes).
+///         `accrue` mints fresh aUSDT to a holder and backs it with underlying,
+///         which is exactly what Aave's rebasing aToken does over time.
+contract YieldAToken is ERC20 {
+    address public immutable pool;
+
+    constructor(address _pool) ERC20("Aave Tether USD", "aUSDT") {
+        pool = _pool;
+    }
+
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    function mint(address to, uint256 amount) external {
+        require(msg.sender == pool, "only pool");
+        _mint(to, amount);
+    }
+
+    function burn(address from, uint256 amount) external {
+        require(msg.sender == pool, "only pool");
+        _burn(from, amount);
+    }
+}
+
+interface IMintable {
+    function mint(address to, uint256 amount) external;
+}
+
+contract YieldAavePool is IAavePool {
+    IERC20 public immutable underlying;
+    YieldAToken public immutable aToken;
+
+    constructor(address _underlying) {
+        underlying = IERC20(_underlying);
+        aToken = new YieldAToken(address(this));
+    }
+
+    function supply(address, uint256 amount, address onBehalfOf, uint16) external override {
+        underlying.transferFrom(msg.sender, address(this), amount);
+        aToken.mint(onBehalfOf, amount);
+    }
+
+    function withdraw(address, uint256 amount, address to) external override returns (uint256) {
+        aToken.burn(msg.sender, amount);
+        underlying.transfer(to, amount);
+        return amount;
+    }
+
+    /// @notice Simulates interest accrual: `holder` gains `amount` of aUSDT,
+    ///         fully backed by new underlying held by the pool.
+    function accrue(address holder, uint256 amount) external {
+        IMintable(address(underlying)).mint(address(this), amount);
+        aToken.mint(holder, amount);
+    }
+}
+
+/// @notice A faithful stand-in for the real USDT at 0xdAC17F9..., reproducing the
+///         two behaviours the suite's MockUSDT does not have:
+///           1. approve/transfer/transferFrom return NO data (non-standard ABI)
+///           2. a non-zero allowance cannot be overwritten with a non-zero value
+///           3. an owner-controlled transfer fee (USDT's `basisPointsRate`)
+///         Mirrors TetherToken's storage-visible behaviour, not its full source.
+contract UsdtLike {
+    string public constant name = "Tether USD";
+    string public constant symbol = "USDT";
+    uint8 public constant decimals = 6;
+
+    uint256 public totalSupply;
+    uint256 public basisPointsRate; // USDT's live fee switch, currently 0 on mainnet
+    uint256 public maximumFee;
+    address public feeOwner;
+
+    mapping(address => uint256) public balanceOf;
+    mapping(address => mapping(address => uint256)) public allowance;
+
+    event Transfer(address indexed from, address indexed to, uint256 value);
+    event Approval(address indexed owner, address indexed spender, uint256 value);
+
+    constructor() {
+        feeOwner = msg.sender;
+    }
+
+    function mint(address to, uint256 amount) external {
+        balanceOf[to] += amount;
+        totalSupply += amount;
+        emit Transfer(address(0), to, amount);
+    }
+
+    /// @notice USDT's setParams: fee is live and owner-settable on mainnet today.
+    function setParams(uint256 newBasisPoints, uint256 newMaxFee) external {
+        require(msg.sender == feeOwner, "only owner");
+        require(newBasisPoints < 20, "fee too high");
+        basisPointsRate = newBasisPoints;
+        maximumFee = newMaxFee * (10 ** uint256(decimals));
+    }
+
+    // NOTE: no `returns (bool)` - this is the whole point.
+    function approve(address spender, uint256 value) external {
+        require(!((value != 0) && (allowance[msg.sender][spender] != 0)), "unsafe allowance change");
+        allowance[msg.sender][spender] = value;
+        emit Approval(msg.sender, spender, value);
+    }
+
+    function transfer(address to, uint256 value) external {
+        _transfer(msg.sender, to, value);
+    }
+
+    function transferFrom(address from, address to, uint256 value) external {
+        uint256 allowed = allowance[from][msg.sender];
+        if (allowed < type(uint256).max) {
+            require(allowed >= value, "allowance");
+            allowance[from][msg.sender] = allowed - value;
+        }
+        _transfer(from, to, value);
+    }
+
+    function _transfer(address from, address to, uint256 value) internal {
+        require(balanceOf[from] >= value, "balance");
+        uint256 fee = (value * basisPointsRate) / 10000;
+        if (fee > maximumFee) fee = maximumFee;
+        uint256 sendAmount = value - fee;
+        balanceOf[from] -= value;
+        balanceOf[to] += sendAmount;
+        if (fee > 0) {
+            balanceOf[feeOwner] += fee;
+            emit Transfer(from, feeOwner, fee);
+        }
+        emit Transfer(from, to, sendAmount);
+    }
+}
+
+/// @notice A *standards-compliant* USDT that merely charges USDT's built-in
+///         transfer fee. Used to isolate the fee-on-transfer accounting problem
+///         from the non-standard-return problem, so each can be seen on its own.
+contract FeeOnTransferUsdt is ERC20 {
+    uint256 public basisPointsRate;
+    address public immutable feeSink;
+
+    constructor() ERC20("Tether USD", "USDT") {
+        feeSink = address(0xFEE);
+    }
+
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    function mint(address to, uint256 amount) external {
+        _mint(to, amount);
+    }
+
+    function setBasisPointsRate(uint256 bps) external {
+        basisPointsRate = bps;
+    }
+
+    function _update(address from, address to, uint256 value) internal override {
+        if (from != address(0) && to != address(0) && basisPointsRate > 0) {
+            uint256 fee = (value * basisPointsRate) / 10000;
+            super._update(from, feeSink, fee);
+            super._update(from, to, value - fee);
+        } else {
+            super._update(from, to, value);
+        }
+    }
+}
diff --git a/test/audit/Invariants.t.sol b/test/audit/Invariants.t.sol
new file mode 100644
index 0000000..5233ccb
--- /dev/null
+++ b/test/audit/Invariants.t.sol
@@ -0,0 +1,96 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console2} from "forge-std/Test.sol";
+import {StdInvariant} from "forge-std/StdInvariant.sol";
+
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+import {MockUSDT} from "../mocks/MockUSDT.sol";
+import {YieldAavePool, YieldAToken} from "./AuditMocks.sol";
+
+/// @notice Drives deposits, withdrawals and Aave interest accrual at random.
+contract VaultHandler is Test {
+    UsdtYieldVault public vault;
+    MockUSDT public usdt;
+    YieldAavePool public pool;
+
+    address[3] public actors = [makeAddr("a1"), makeAddr("a2"), makeAddr("a3")];
+
+    uint256 public totalDeposited;
+    uint256 public totalWithdrawn;
+
+    constructor(UsdtYieldVault _vault, MockUSDT _usdt, YieldAavePool _pool) {
+        vault = _vault;
+        usdt = _usdt;
+        pool = _pool;
+        for (uint256 i = 0; i < actors.length; i++) {
+            usdt.mint(actors[i], 10_000_000e6);
+            vm.prank(actors[i]);
+            usdt.approve(address(vault), type(uint256).max);
+        }
+    }
+
+    function deposit(uint256 actorSeed, uint256 amount) external {
+        address actor = actors[actorSeed % actors.length];
+        amount = bound(amount, 1e6, 100_000e6);
+        vm.prank(actor);
+        try vault.deposit(amount) {
+            totalDeposited += amount;
+        } catch {}
+    }
+
+    function withdraw(uint256 actorSeed, uint256 sharesSeed) external {
+        address actor = actors[actorSeed % actors.length];
+        uint256 held = vault.shareBalance(actor);
+        if (held == 0) return;
+        uint256 shares = bound(sharesSeed, 1, held);
+        vm.prank(actor);
+        try vault.withdraw(shares) returns (uint256 net) {
+            totalWithdrawn += net;
+        } catch {}
+    }
+
+    function accrueAaveInterest(uint256 amount) external {
+        uint256 position = pool.aToken().balanceOf(address(vault));
+        if (position == 0) return;
+        amount = bound(amount, 1, position / 100 + 1); // up to ~1% interest
+        pool.accrue(address(vault), amount);
+    }
+}
+
+/// @notice Invariants that any honest share-accounted vault must hold.
+///         Run with: forge test --match-path 'test/audit/Invariants.t.sol' -vv
+contract VaultInvariantTest is StdInvariant, Test {
+    MockUSDT internal usdt;
+    YieldAavePool internal pool;
+    YieldAToken internal aUsdt;
+    UsdtYieldVault internal vault;
+    VaultHandler internal handler;
+
+    function setUp() public {
+        usdt = new MockUSDT();
+        pool = new YieldAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 10, address(this));
+
+        handler = new VaultHandler(vault, usdt, pool);
+        targetContract(address(handler));
+    }
+
+    /// @notice The vault's internal accounting must describe the position it
+    ///         actually holds in Aave. If these drift, the difference belongs
+    ///         to nobody and can never be withdrawn by anyone.
+    function invariant_AccountedAssetsMatchAavePosition() public view {
+        uint256 real = aUsdt.balanceOf(address(vault));
+        uint256 accounted = vault.totalAssetsStored();
+        assertEq(accounted, real, "totalAssetsStored drifted from the real aUSDT position");
+    }
+
+    /// @notice Shares outstanding must always be backed by accounted assets,
+    ///         otherwise convertToShares() divides by zero and deposits brick.
+    function invariant_SharesAreBackedByAssets() public view {
+        if (vault.totalShares() > 0) {
+            assertGt(vault.totalAssetsStored(), 0, "shares outstanding with zero accounted assets");
+        }
+    }
+}
