@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: MIT
+pragma solidity 0.8.28;
+
+import {Test, console2} from "forge-std/Test.sol";
+
+import {UsdtYieldVault} from "../../src/UsdtYieldVault.sol";
+import {MockUSDT} from "../mocks/MockUSDT.sol";
+import {YieldAavePool, YieldAToken} from "./AuditMocks.sol";
+
+/// @notice Attacks that were tried against the vault and did NOT work.
+///         These PASS on purpose - they record what was checked and cleared,
+///         so the report is not just a list of hits.
+///
+///         Run with: forge test --match-path 'test/audit/NegativeResults.t.sol' -vv
+contract NegativeResultsTest is Test {
+    MockUSDT internal usdt;
+    YieldAavePool internal pool;
+    YieldAToken internal aUsdt;
+    UsdtYieldVault internal vault;
+
+    address internal owner = makeAddr("owner");
+    address internal attacker = makeAddr("attacker");
+    address internal victim = makeAddr("victim");
+
+    function setUp() public {
+        usdt = new MockUSDT();
+        pool = new YieldAavePool(address(usdt));
+        aUsdt = pool.aToken();
+        vault = new UsdtYieldVault(address(usdt), address(aUsdt), address(pool), 10, owner);
+
+        usdt.mint(attacker, 1_000_000e6);
+        usdt.mint(victim, 1_000_000e6);
+        vm.prank(attacker);
+        usdt.approve(address(vault), type(uint256).max);
+        vm.prank(victim);
+        usdt.approve(address(vault), type(uint256).max);
+    }
+
+    /// @notice CLEARED: the classic ERC4626 first-depositor inflation attack does
+    ///         not apply. Share price is computed from internal accounting, not
+    ///         from a token balance, so donations cannot move it.
+    function test_Clear_DonationDoesNotMoveSharePrice() public {
+        vm.prank(attacker);
+        vault.deposit(1e6); // 1 USDT, the minimum
+
+        uint256 priceBefore = vault.sharePrice();
+
+        // Donate directly to the vault, and donate an aUSDT position too.
+        vm.prank(attacker);
+        usdt.transfer(address(vault), 500_000e6);
+        vm.startPrank(attacker);
+        usdt.approve(address(pool), type(uint256).max);
+        pool.supply(address(usdt), 100_000e6, address(vault), 0);
+        vm.stopPrank();
+
+        assertEq(vault.sharePrice(), priceBefore, "donations must not move the share price");
+
+        vm.prank(victim);
+        uint256 shares = vault.deposit(1_000e6);
+        console2.log("victim shares after donation attack:", shares);
+        assertGe(vault.balanceOfUnderlying(victim), 999e6, "victim keeps ~all of their deposit");
+    }
+
+    /// @notice CLEARED: repeated deposit/withdraw cycles cannot extract value
+    ///         from other depositors. Every rounding step floors in the vault's
+    ///         favour, so the attacker only ever loses fees.
+    function testFuzz_Clear_NoRoundingDrain(uint256 cycles, uint256 amount) public {
+        cycles = bound(cycles, 1, 30);
+        amount = bound(amount, 1e6, 10_000e6);
+
+        vm.prank(victim);
+        vault.deposit(100_000e6);
+        uint256 victimBefore = vault.balanceOfUnderlying(victim);
+
+        uint256 attackerStart = usdt.balanceOf(attacker);
+        for (uint256 i = 0; i < cycles; i++) {
+            vm.prank(attacker);
+            uint256 shares = vault.deposit(amount);
+            vm.prank(attacker);
+            vault.withdraw(shares);
+        }
+
+        assertLe(usdt.balanceOf(attacker), attackerStart, "attacker must not profit from cycling");
+        assertGe(vault.balanceOfUnderlying(victim), victimBefore, "victim must not lose value to cycling");
+    }
+
+    /// @notice CLEARED: the vault is never under-collateralised against its own
+    ///         accounting, so a withdrawal never fails for lack of aUSDT. The
+    ///         drift found elsewhere is always in the depositors' disfavour
+    ///         (stranded surplus), never a shortfall.
+    function testFuzz_Clear_NoShortfallAgainstAccounting(uint256 a, uint256 b) public {
+        a = bound(a, 1e6, 100_000e6);
+        b = bound(b, 1e6, 100_000e6);
+
+        vm.prank(victim);
+        uint256 vShares = vault.deposit(a);
+        vm.prank(attacker);
+        vault.deposit(b);
+        pool.accrue(address(vault), 1_000e6);
+
+        vm.prank(victim);
+        vault.withdraw(vShares); // must not revert
+
+        assertGe(
+            aUsdt.balanceOf(address(vault)), vault.totalAssetsStored(), "real position must cover accounted position"
+        );
+    }
+}
