# --- chain ---
RPC_URL=https://mainnet.base.org
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ETHERSCAN_API_KEY=

# --- deploy (script/Deploy.s.sol) ---
# USDC on Base mainnet: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# USDC on Base Sepolia: 0x036CbD53842c5426634e7929541eC2318f3dCF7e
BILLING_TOKEN=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
BILLING_OWNER=            # address that ends up owning the contract (use a Safe)
HOBBY_PRICE=5000000       # $5, USDC has 6 decimals
PRO_PRICE=20000000        # $20

# --- ops (ops/collect.mjs) ---
BILLING_CONTRACT=
DEPLOY_BLOCK=             # block the contract was deployed in; keeps log scans cheap
PAYOUT_ADDRESS=           # where swept revenue goes
PRIVATE_KEY=              # only needed for --settle / --withdraw; prefer a hot key
                          # that is NOT the owner for settle-only runs
MIN_SWEEP_USDC=50         # don't spend gas sweeping less than this

# --- api gate (backend/subscription-gate.mjs) ---
# same RPC_URL and BILLING_CONTRACT as above
