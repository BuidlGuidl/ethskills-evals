# ---------------------------------------------------------------------------
# Deploying and operating the billing contract
# ---------------------------------------------------------------------------

# Deployer / operator key. Use a hardware wallet or `cast wallet` keystore for mainnet;
# see NOTES.md — this key controls your revenue, but never your customers' balances.
PRIVATE_KEY=0x...

# Who collects revenue and manages plans. A multisig is a better answer than an EOA.
BILLING_OWNER=0x...

# Filled in after deployment.
BILLING_ADDRESS=0x...
DEPLOY_BLOCK=0

BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ETHERSCAN_API_KEY=

# Optional: override plan prices at deploy time, in USDC units (6 decimals).
# HOBBY_PRICE=5000000
# PRO_PRICE=20000000

# ---------------------------------------------------------------------------
# The API backend
# ---------------------------------------------------------------------------

CHAIN=base
RPC_URL=https://mainnet.base.org
# Optional but recommended: reacts to top-ups within a block instead of within a minute.
WS_RPC_URL=

# 32+ random bytes. `openssl rand -hex 32`. Rotating it logs every customer out.
AUTH_SECRET=

# Keep serving for this long after a subscription lapses. See NOTES.md.
GRACE_SECONDS=3600

# What to do if the RPC is unreachable and nothing is cached: allow | deny
RPC_FAILURE_MODE=allow

PORT=8080
