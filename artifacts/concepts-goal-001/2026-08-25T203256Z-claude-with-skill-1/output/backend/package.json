{
  "name": "weather-api-billing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Subscription gate for the weather API: reads onchain billing state, per request.",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "dev": "tsc && node dist/src/server.js",
    "test": "tsc && node --test dist/test/*.test.js",
    "cli": "tsc && node dist/src/cli.js"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
