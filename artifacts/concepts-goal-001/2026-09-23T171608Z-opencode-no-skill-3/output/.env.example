# Copy to .env and fill in. Never commit .env.

# Deployer key (owns the contract: can set plans, sweep fees).
PRIVATE_KEY=0x...

# RPC for the target network.
RPC_URL=https://sepolia.base.org

# USDC token address on the target network.
#   Base mainnet:  0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
#   Base Sepolia:  0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Leave empty for local Anvil dev (deploys a MockUSDC instead).
USDC_ADDRESS=

# Block explorer API key, only needed for `forge script --verify`.
ETHERSCAN_API_KEY=
