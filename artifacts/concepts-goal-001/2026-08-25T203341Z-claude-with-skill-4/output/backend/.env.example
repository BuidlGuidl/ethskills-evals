# ---- deployment (forge script) -------------------------------------------------------------
# Leave BILLING_TOKEN unset on Base / Base Sepolia and the deploy script fills in Circle's
# native USDC for that chain. Set it explicitly for anything else.
# BILLING_TOKEN=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
BILLING_OWNER=0xYourOwnerSafeOrHardwareWallet
BILLING_RECIPIENT=0xWhereRevenueShouldLand

BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ETHERSCAN_API_KEY=

# ---- the API gate (backend/) ---------------------------------------------------------------
CHAIN_ID=8453
RPC_URL=https://mainnet.base.org
# A second provider from a different company. See NOTES.md — one RPC endpoint is one party who
# can tell you a paying customer is unsubscribed.
FALLBACK_RPC_URL=
BILLING_ADDRESS=0xDeployedContract
BILLING_START_BLOCK=0

# openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_SECONDS=3600
NONCE_TTL_SECONDS=300

CACHE_TTL_MS=60000
DEGRADED_CACHE_TTL_MS=5000
WATCHER_STALE_MS=120000

PORT=8080
QUOTA_HOBBY=60
QUOTA_PRO=600
