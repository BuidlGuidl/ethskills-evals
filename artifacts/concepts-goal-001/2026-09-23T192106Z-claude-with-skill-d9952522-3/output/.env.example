# Owner of the deployed contract. Can withdraw revenue and open/close plans; cannot
# touch customer balances. Use something you will still control in two years.
OWNER=0x0000000000000000000000000000000000000000

# --- operating ---------------------------------------------------------------
SUBSCRIPTIONS=0x0000000000000000000000000000000000000000
PAYOUT=0x0000000000000000000000000000000000000000
ACCOUNTS=0xaaa...,0xbbb...   # comma separated, for `make collect`

# --- backend -----------------------------------------------------------------
SUBSCRIPTIONS_ADDRESS=0x0000000000000000000000000000000000000000
RPC_URL=https://mainnet.base.org
RPC_URL_FALLBACK=
TOKEN_SECRET=   # openssl rand -hex 32
