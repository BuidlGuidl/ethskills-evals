# --- chain ---------------------------------------------------------------
# An L2. On mainnet a $5 subscription would lose a meaningful slice of itself to the gas cost of
# topping up; on Base/OP/Arbitrum a top-up is well under a cent.
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# --- deploy --------------------------------------------------------------
# USDC, 6 decimals. VERIFY THIS AGAINST https://developers.circle.com/stablecoins/usdc-contract-addresses
# before broadcasting — the deploy script checks decimals, which catches the worst mistakes but not
# a wrong-but-plausible token.
#   Base mainnet   0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
#   Base Sepolia   0x036CbD53842c5426634e7929541eC2318f3dCF7e
#   OP mainnet     0x0b2C639c533813f4Aa9D7837CAf62653d097Ff85
#   Arbitrum One   0xaf88d065e77c8cC2239327C5EDb3A432268e5831
USDC_ADDRESS=
# The address that can add plans and withdraw revenue. Use a multisig or a hardware wallet.
BILLING_OWNER=
ETHERSCAN_API_KEY=

# --- operations ----------------------------------------------------------
BILLING_ADDRESS=
PAYOUT_ADDRESS=

# --- backend gate --------------------------------------------------------
RPC_URL=
WS_RPC_URL=
CHAIN_ID=8453
