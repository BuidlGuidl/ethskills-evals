# RPC endpoint for the chain you're deploying to (e.g. Base, Arbitrum)
RPC_URL=https://mainnet.base.org

# Canonical USDC on the target chain — see script/Deploy.s.sol for addresses
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Deployer key — becomes the contract owner (fee recipient). Use a dedicated
# hot key with just enough ETH for gas, not your treasury key.
PRIVATE_KEY=0x...

# For --verify on deployment
ETHERSCAN_API_KEY=
