# Copy to .env and fill in. Never commit .env.
# Source it before deploying:  source .env

# Where you are deploying. Mainnet and most L2s have native Circle USDC (6 decimals).
RPC_URL=https://mainnet.base.org

# Circle native USDC:
#   Base:      0x833589fCDBeDDBa51428aA13F5f21BC3baB1A5a7
#   Ethereum:  0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
#   Arbitrum:  0xaf88d065e77c8cC2239327C5EDb3A432268e5831
USDC_ADDRESS=

# The operational key that owns the contract. If unset, the deployer becomes owner.
OWNER_ADDRESS=

# Deployer key. Use a dedicated hot key with only what you need for gas.
PRIVATE_KEY=
