# Copy to .env and fill in. Never commit real values.

# Deployer key. Needs a little ETH for gas. On Base a deployment is a few cents.
PRIVATE_KEY=

# RPC endpoint, e.g. https://mainnet.base.org (Base) or an Alchemy/Infura URL.
RPC_URL=https://mainnet.base.org

# Who can add plans and collect revenue. Use a Safe (safe.global) or at least a
# dedicated key — see NOTES.md "Owner key". Customers' deposits are NOT
# reachable by this key, only accrued revenue is.
OWNER_ADDRESS=

# Token contract. VERIFY against https://developers.circle.com/stablecoins/usdc-contract-addresses
# Base mainnet:  0x833589fCD6eDb6E08f4c7C32D4f71B54bdA02913
# Base Sepolia:  0x036CbD53842c5426634e7929541eC2318f3dCF7e
USDC_ADDRESS=

# Basescan API key (https://basescan.org/apis) for --verify. Optional.
ETHERSCAN_API_KEY=
