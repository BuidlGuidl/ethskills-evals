# ---- deployment ----
# Where subscription revenue is sent. Use a multisig (Safe) — this address receives real money.
TREASURY=0x0000000000000000000000000000000000000000

# Can add plans / close plans to new signups / change the treasury.
# Cannot touch customer balances or block cancellations. Defaults to TREASURY if unset.
OWNER=0x0000000000000000000000000000000000000000

# Optional. Defaults to canonical Circle USDC on Base (8453) and Base Sepolia (84532).
# USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# ---- rpc / verification ----
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ETHERSCAN_API_KEY=

# ---- ops ----
BILLING_ADDRESS=
# Comma-separated, for the sweep script
SUBSCRIBERS=
