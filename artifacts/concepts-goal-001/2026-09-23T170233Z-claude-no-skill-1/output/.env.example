# Copy to .env and fill in. .env is gitignored; never commit a key.

# --- deploy / ops -----------------------------------------------------
# Address that owns the contract: receives revenue, administers plans.
# Use a multisig (Safe) for mainnet, not an EOA.
BILLING_OWNER=0x0000000000000000000000000000000000000000

# Optional: override the built-in per-chain USDC address in script/Addresses.sol.
# USDC_ADDRESS=

# Optional: override the plan prices seeded at deploy (USDC base units, 6 dp).
HOBBY_PRICE=5000000
PRO_PRICE=20000000

# Optional: skip the deployments/<chain>.json lookup in the ops scripts.
# BILLING_ADDRESS=

BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ETHERSCAN_API_KEY=

# --- backend gateway --------------------------------------------------
CHAIN=base
RPC_URL=https://mainnet.base.org
PORT=8787
