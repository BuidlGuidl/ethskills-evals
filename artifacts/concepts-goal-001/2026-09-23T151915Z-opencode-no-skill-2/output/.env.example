# Copy to .env and fill in. Never commit .env.

# Chain connection (Base mainnet example)
RPC_URL=https://mainnet.base.org
# For `forge script --verify`
ETHERSCAN_API_KEY=

# Deployment parameters
# Canonical USDC addresses:
#   Base:     0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
#   Arbitrum: 0xaf88d065e77c8cC2239327C5EDb3A432268e5831
#   Ethereum: 0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Operator: receives revenue withdrawals, can update plans. Use a wallet you
# control with good key hygiene (hardware wallet / multisig for mainnet).
OWNER_ADDRESS=

# Plan prices in USDC base units (6 decimals). Defaults: $5 / $20 per 30 days.
HOBBY_PRICE=5000000
PRO_PRICE=20000000

# Deployed contract address (fill in after deploying; backend + keeper use it)
BILLING_ADDRESS=
