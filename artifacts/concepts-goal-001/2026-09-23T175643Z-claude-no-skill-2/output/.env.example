# ---- deployment ----------------------------------------------------------
# Operator address. Use a multisig for anything holding real money.
OWNER=0x0000000000000000000000000000000000000000

# Which [rpc_endpoints] entry in foundry.toml to target: base, base_sepolia, mainnet
NETWORK=base_sepolia

BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
MAINNET_RPC_URL=

ETHERSCAN_API_KEY=

# Optional overrides. USDC defaults to the canonical address for the chain, prices to $5 / $20.
# USDC=
# HOBBY_PRICE=5000000
# PRO_PRICE=20000000

# ---- backend -------------------------------------------------------------
BILLING_CONTRACT=
RPC_URL=https://sepolia.base.org
SERVICE_HOST=api.example-weather.com
PORT=3000

# How long the gate may trust a cached answer. Higher = fewer RPC calls, slower
# to notice a cancellation. Never exceeds the on-chain expiry either way.
GATE_CACHE_TTL_MS=15000

# If the RPC is unreachable, serve everyone (true) or nobody (false). See NOTES.md.
GATE_FAIL_OPEN=false

# ---- monitoring ----------------------------------------------------------
SUBSCRIBERS=
SWEEP_THRESHOLD_USDC=50
EXPIRY_WARNING_DAYS=5
