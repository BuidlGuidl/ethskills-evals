# Copy to .env and fill in.  .env is gitignored — never commit it, never paste
# a private key into Slack, a ticket, a PR, or a chat window.

# Sepolia JSON-RPC endpoint. Get one from Alchemy, Infura, or use a public node.
SEPOLIA_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"

# Private key of the deployer account, 0x + 64 hex chars.
# Use a burner key that only ever holds testnet ETH.
DEPLOYER_PRIVATE_KEY=""

# Where sweep.ts returns the leftover Sepolia ETH. This is the team account.
TEAM_ACCOUNT="0xfB047366a183DDEF3F40ff3e4ebf34f8d01FD3Fc"

# Which contract in contracts/ to deploy (must match the contract name).
CONTRACT_NAME="Counter"
