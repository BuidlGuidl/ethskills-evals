# Copy to .env and fill in. .env is gitignored — keep it that way.

# JSON-RPC endpoint for Sepolia (Alchemy, Infura, your own node, ...).
SEPOLIA_RPC_URL=

# Deployer private key, 0x-prefixed, 32 bytes.
#
# This is a hot key. It signs unattended, so treat everything it holds as
# already lost: fund it with just enough Sepolia ETH for the deploys you are
# about to run, and never reuse it on mainnet or for anything holding value.
# Generate a fresh one per developer:  npm run new-key
#
# Leave this blank in the repo. Never paste a real key into a chat, a ticket,
# a PR, or an example file.
DEPLOYER_PRIVATE_KEY=

# Where `npm run sweep` returns the leftover balance. Checksummed address.
TEAM_ACCOUNT=0xfB047366a183DDEF3F40ff3e4ebf34f8d01FD3Fc

# Address that should own/administer the contract after deploy. Point this at
# the team Safe, not at the deployer EOA.
CONTRACT_OWNER=
