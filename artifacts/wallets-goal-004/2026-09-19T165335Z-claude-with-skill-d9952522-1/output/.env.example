# Copy to .env (gitignored) and fill in. Never commit .env.

# Sepolia RPC endpoint (Alchemy, Infura, etc.)
SEPOLIA_RPC_URL=

# Private key of YOUR OWN fresh deployer account (0x-prefixed, 64 hex chars).
# Generate one with: npm run new-key
DEPLOYER_PRIVATE_KEY=

# Where sweep.ts sends leftover Sepolia ETH: the team account.
# Copy it from the team's source of truth (wallet UI / Etherscan), not from chat.
# Must be all-lowercase or correctly EIP-55 checksummed; sweep.ts rejects bad checksums.
TEAM_ADDRESS=

# Contract to deploy: Solidity file under contracts/ and the contract name in it.
CONTRACT_FILE=contracts/Example.sol
CONTRACT_NAME=Example
# Constructor args as a JSON array, e.g. ["hello", 42]. Leave empty for none.
CONSTRUCTOR_ARGS=["hello sepolia"]
