# Copy to .env (git-ignored) and fill in. Never commit .env.

# Sepolia RPC endpoint. Keyed URLs (Alchemy/Infura) are secrets too.
# A public endpoint works for occasional deploys:
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Private key of the deployer account (0x + 64 hex chars).
# Use a dedicated, testnet-only key; never a key that has ever held mainnet funds.
DEPLOYER_PRIVATE_KEY=

# Team account that `npm run sweep` returns leftover ETH to.
# Paste the EIP-55 checksummed address copied from the team wallet UI.
TEAM_ADDRESS=
