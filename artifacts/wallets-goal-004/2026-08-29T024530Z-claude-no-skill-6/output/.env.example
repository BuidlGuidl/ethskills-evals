# Copy to .env and fill in.  .env is gitignored — never commit it.

# JSON-RPC endpoint for Sepolia (Alchemy, Infura, or your own node).
# The public fallback is rate-limited; use your own key for real deploys.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Private key of the deployer account, 0x-prefixed, 32 bytes.
# Use a throwaway key that only ever holds testnet ETH.
# Generate one with: npm run new-account
DEPLOYER_PRIVATE_KEY=

# Where sweep.ts returns leftover Sepolia ETH. Defaults to the team account.
TEAM_ADDRESS=0xfB047366A183ddEf3f40FF3e4EbF34F8D01Fd3FC

# Contract to deploy: the name of a contract in contracts/*.sol
CONTRACT=Counter

# Constructor arguments as a JSON array, e.g. [42,"0xabc..."]. Empty = none.
CONSTRUCTOR_ARGS=[]

# Optional: set to verify on Etherscan by hand later (not used by the scripts).
ETHERSCAN_API_KEY=
