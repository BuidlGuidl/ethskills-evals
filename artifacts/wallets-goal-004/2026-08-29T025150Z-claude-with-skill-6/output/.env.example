# Copy to .env and fill in. .env is gitignored -- never commit real values.

# Sepolia JSON-RPC endpoint (Alchemy, Infura, or your own node).
SEPOLIA_RPC_URL=

# Private key of the deploy account, 0x + 64 hex characters.
# Generate a fresh one with `npm run newkey` -- do NOT reuse a key that has
# ever been pasted into a chat, a ticket, or a prompt.
DEPLOYER_PRIVATE_KEY=

# Optional. Where `npm run sweep` returns leftover ETH.
# Defaults to the team account in lib/config.ts.
TEAM_ACCOUNT=
