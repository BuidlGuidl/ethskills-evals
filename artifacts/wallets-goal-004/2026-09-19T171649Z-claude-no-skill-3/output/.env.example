# Copy to .env (which is gitignored) and fill in. NEVER commit .env.

# Sepolia JSON-RPC endpoint (Alchemy, Infura, QuickNode, your own node, ...).
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY

# Deployer private key (0x-prefixed, 64 hex chars). Get it from the team's
# password manager -- never paste it into code, chat, issues, or commits.
DEPLOYER_PRIVATE_KEY=

# Which contract to deploy.
CONTRACT_PATH=contracts/Example.sol
CONTRACT_NAME=Example

# Constructor arguments as a JSON array, e.g. ["hello", 42]. Leave as [] if none.
CONSTRUCTOR_ARGS=["hello, sepolia"]

# Where sweep.ts sends leftover ETH: the team account. Copy it from the team's
# canonical source (password manager / wallet UI), checksummed. sweep.ts
# rejects addresses whose EIP-55 checksum doesn't match, to catch typos.
SWEEP_TO=
