# Copy to .env (which is gitignored) and fill in. NEVER commit .env.

# Sepolia JSON-RPC endpoint (Alchemy, Infura, QuickNode, your own node, ...).
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Private key of the deployer account (0x-prefixed, 64 hex chars).
# Get it from the team's secret manager -- never paste it into code, chat, or git.
DEPLOYER_PRIVATE_KEY=

# Which contract to deploy.
CONTRACT_PATH=contracts/Greeter.sol
CONTRACT_NAME=Greeter

# Constructor arguments as a JSON array, e.g. ["hello", 42]. Leave empty for none.
CONSTRUCTOR_ARGS=["Hello, Sepolia!"]

# Team account that receives the deployer's leftover ETH (checksummed, EIP-55).
# Copy it from the team's trusted source; sweep.ts rejects addresses whose checksum doesn't match.
SWEEP_TO=
