SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
DEPLOYER_PRIVATE_KEY=0x...

# Path to a Forge or Hardhat artifact JSON file for the contract being deployed.
CONTRACT_ARTIFACT=./out/MyContract.sol/MyContract.json

# Optional JSON array passed to the contract constructor.
CONTRACT_CONSTRUCTOR_ARGS=[]

# Optional sweep destination. Defaults to the team Sepolia account in sweep.ts.
# SWEEP_TO=0xfB047366A183ddEf3f40FF3e4EbF34F8D01Fd3FC
