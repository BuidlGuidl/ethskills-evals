# Copy to .env and fill in. .env is gitignored — never commit it.

# RPC endpoint for Sepolia. Any provider works (Alchemy, Infura, drpc, ...).
SEPOLIA_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"

# Private key of the deployer account, 0x-prefixed, 64 hex chars.
# This key controls real (test) funds — treat it like a password.
# Generate a fresh one with: npm run new-key
DEPLOYER_PRIVATE_KEY=""

# Where sweep.ts returns leftover Sepolia ETH after a deploy.
TEAM_ACCOUNT="0xfB047366a183DDEF3F40ff3e4ebf34f8d01FD3Fc"
