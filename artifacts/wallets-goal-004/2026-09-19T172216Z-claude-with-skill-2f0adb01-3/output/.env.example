# Copy to .env (which is gitignored) and fill in. NEVER commit .env.

# Sepolia RPC endpoint. Keyed provider URLs (Alchemy/Infura) are secrets too.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Deployer private key (0x-prefixed, 64 hex chars).
# Optional: leave unset and the scripts will prompt for it with hidden input,
# so it never touches disk.
DEPLOYER_PRIVATE_KEY=

# Solidity source file and contract name to deploy.
CONTRACT_FILE=contracts/Greeter.sol
CONTRACT_NAME=Greeter

# Constructor args as a JSON array, e.g. ["hello"] or [42, "0xabc..."]
CONSTRUCTOR_ARGS=["Hello, Sepolia"]

# Where sweep.ts sends leftover ETH. Defaults to the team account.
# SWEEP_TO=0xfB047366A183ddEf3f40FF3e4EbF34F8D01Fd3FC
