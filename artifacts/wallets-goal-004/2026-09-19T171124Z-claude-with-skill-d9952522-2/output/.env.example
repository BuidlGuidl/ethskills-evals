# Copy to .env (gitignored) — or run `npm run new-deployer`, which creates it for you.
# Never put a real value in this file; it is committed.

# Private key of YOUR OWN throwaway Sepolia deployer (0x + 64 hex chars).
DEPLOYER_PRIVATE_KEY=

# Sepolia RPC endpoint (Alchemy, Infura, etc.). Optional: falls back to a public, rate-limited RPC.
SEPOLIA_RPC_URL=
