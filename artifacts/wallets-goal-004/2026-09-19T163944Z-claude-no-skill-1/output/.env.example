# Copy to .env (which is gitignored) and fill in. Never commit .env.

# Sepolia RPC endpoint, e.g. https://eth-sepolia.g.alchemy.com/v2/<key>
# or https://sepolia.infura.io/v3/<key>
SEPOLIA_RPC_URL=

# Private key of the deployer account (0x-prefixed, 64 hex chars).
# Use a key that exists only for deploying to Sepolia and holds only test ETH.
DEPLOYER_PRIVATE_KEY=

# Where sweep.ts sends leftover ETH. Must be EIP-55 checksummed (mixed case)
# or all lowercase; a mixed-case address with a bad checksum is rejected.
TEAM_ADDRESS=

# Optional default for `npm run deploy` when --contract isn't passed.
CONTRACT_NAME=Counter
