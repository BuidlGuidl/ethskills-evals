# Copy to .env (gitignored) and fill in. Nothing in here is a private key.

# Sepolia RPC endpoint. If it embeds an API key (Alchemy/Infura), it is a secret — keep it in .env only.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Name of the Foundry keystore holding the deployer key (see README, step 3).
# Resolved to ~/.foundry/keystores/<name>. Or set DEPLOYER_KEYSTORE_PATH to a full path instead.
DEPLOYER_KEYSTORE=sepolia-deployer

# Where sweep.ts sends leftover ETH. Must be an EIP-55 checksummed address
# (or all-lowercase). Double-check it against a trusted source before sweeping.
TEAM_ADDRESS=
