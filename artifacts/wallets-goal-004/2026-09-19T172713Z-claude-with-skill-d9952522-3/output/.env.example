# Copy to .env (gitignored) and fill in. Never commit .env.

# Which network to use: "sepolia" (default) or "anvil" (local, chain id 31337).
NETWORK=sepolia

# Sepolia JSON-RPC endpoint (Alchemy, Infura, your own node, ...).
SEPOLIA_RPC_URL=

# Private key for the deploy account: 0x followed by 64 hex characters.
# Create a fresh key just for deploying (see README). Keep only small amounts of ETH in it.
DEPLOYER_PRIVATE_KEY=

# Where sweep.ts sends the deployer's leftover ETH. Must be a checksummed address.
# Get it from the team's source of truth. Don't copy it from chat.
SWEEP_TO=
