# Copy to .env and fill in.  .env is gitignored — keep it that way.
#   cp .env.example .env

# --- Signing key -------------------------------------------------------------
# Private key of the throwaway deploy EOA (0x + 64 hex chars).
# Generate a fresh one:  npm run new-deployer
# Fund it with ONLY what this deploy needs. Never reuse it on mainnet, never
# paste it into chat/tickets/PRs, never give it ownership of the contract.
DEPLOYER_PRIVATE_KEY=

# --- Network -----------------------------------------------------------------
# Sepolia JSON-RPC endpoint (Alchemy / Infura / your own node).
SEPOLIA_RPC_URL=

# --- Addresses (public, not secret) ------------------------------------------
# Who owns the deployed contract. Use the team Safe, NOT the deploy EOA.
CONTRACT_OWNER=

# Where sweep.ts returns leftover Sepolia ETH.
# NOTE: verify this against the team Safe out-of-band before sweeping.
SWEEP_DESTINATION=0xfB047366a183DDEF3F40ff3e4ebf34f8d01FD3Fc

# --- Optional ----------------------------------------------------------------
# Etherscan API key, only needed for `npm run verify`.
ETHERSCAN_API_KEY=
