diff --git a/packages/nextjs/hooks/useWalletDeepLink.ts b/packages/nextjs/hooks/useWalletDeepLink.ts
new file mode 100644
index 0000000..88f8763
--- /dev/null
+++ b/packages/nextjs/hooks/useWalletDeepLink.ts
@@ -0,0 +1,30 @@
+import { useCallback } from "react";
+import { useAccount } from "wagmi";
+
+type WalletConnectProvider = {
+  session?: { peer?: { metadata?: { redirect?: { native?: string; universal?: string } } } };
+};
+
+const isMobile = () => typeof navigator !== "undefined" && /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
+
+// Inside a wallet's in-app browser the wallet is already the foreground app, and it injects
+// its own provider instead of connecting over WalletConnect.
+const isInAppBrowser = () => typeof window !== "undefined" && "ethereum" in window;
+
+/**
+ * On mobile WalletConnect the signature request lands in the wallet app while the browser stays
+ * in front, so nothing appears to happen. Call this right after firing a write (never before it,
+ * or navigating away cancels the write) to bring the connected wallet forward.
+ */
+export const useWalletDeepLink = () => {
+  const { connector } = useAccount();
+
+  return useCallback(async () => {
+    if (connector?.id !== "walletConnect" || !isMobile() || isInAppBrowser()) return;
+
+    const provider = (await connector.getProvider()) as WalletConnectProvider;
+    const redirect = provider?.session?.peer?.metadata?.redirect;
+    const target = redirect?.native || redirect?.universal;
+    if (target) window.location.href = target;
+  }, [connector]);
+};
