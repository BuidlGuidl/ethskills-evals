diff --git a/packages/nextjs/utils/ssrWebStorageShim.ts b/packages/nextjs/utils/ssrWebStorageShim.ts
new file mode 100644
index 0000000..c12a810
--- /dev/null
+++ b/packages/nextjs/utils/ssrWebStorageShim.ts
@@ -0,0 +1,37 @@
+/**
+ * Node 22+ exposes a global `localStorage`, but its methods only work when the process was started
+ * with `--localstorage-file`. Next's prerender workers are not, so libraries that feature-detect
+ * with `typeof localStorage !== "undefined"` (RainbowKit, wagmi) pass the guard and then throw
+ * `localStorage.getItem is not a function`, failing `next build`.
+ *
+ * Replace the broken global with an in-memory shim on the server. Imported for side effects from
+ * the root layout so it is installed before anything renders.
+ */
+if (typeof window === "undefined") {
