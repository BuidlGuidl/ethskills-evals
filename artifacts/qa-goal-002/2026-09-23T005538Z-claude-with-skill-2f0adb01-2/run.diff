diff --git a/packages/nextjs/hooks/useWalletDeepLink.ts b/packages/nextjs/hooks/useWalletDeepLink.ts
new file mode 100644
index 0000000..722c3e6
--- /dev/null
+++ b/packages/nextjs/hooks/useWalletDeepLink.ts
@@ -0,0 +1,68 @@
+"use client";
+
+import { useCallback } from "react";
+import { useAccount } from "wagmi";
+
+const WALLET_SCHEMES: [string[], string][] = [
+  [["rainbow"], "rainbow://"],
+  [["metamask"], "metamask://"],
+  [["coinbase", "cbwallet", "baseaccount", "base account"], "cbwallet://"],
+  [["trust"], "trust://"],
+  [["phantom"], "phantom://"],
+  [["ledger"], "ledgerlive://"],
+];
+
+// WalletConnect v2 relies on push notifications instead of deep linking, which is slow and
+// unreliable. `writeContractAsync` needs time to simulate, encode and relay the request through the
+// WC relay before the wallet has anything to show, so we hand off ~2s after firing the call.
+const HANDOFF_DELAY_MS = 2000;
+
+/**
+ * On mobile WalletConnect sessions, switches the user over to their wallet app after a transaction
+ * request has been relayed. Wrap every write call in `writeAndOpen`.
+ */
+export const useWalletDeepLink = () => {
+  const { connector } = useAccount();
+
+  const openWallet = useCallback(() => {
+    if (typeof window === "undefined") return;
+
+    const isMobile = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);
+    // `window.ethereum` means we're already inside a wallet's in-app browser — nothing to open.
+    if (!isMobile || (window as any).ethereum) return;
+
+    // `connector.id` reads "walletConnect" rather than the actual wallet, so also check what wagmi
+    // and the WalletConnect session stashed in localStorage.
+    const connectorHints = [connector?.id, connector?.name, localStorage.getItem("wagmi.recentConnectorId")]
+      .filter(Boolean)
+      .join(" ");
+
+    let wcSession = "";
+    try {
+      const wcKey = Object.keys(localStorage).find(key => key.startsWith("wc@2:client"));
+      if (wcKey) wcSession = localStorage.getItem(wcKey) || "";
+    } catch {
+      // localStorage can throw in private-browsing modes; the connector hints alone will have to do.
+    }
+
+    const search = `${connectorHints} ${wcSession}`.toLowerCase();
+
+    for (const [keywords, scheme] of WALLET_SCHEMES) {
+      if (keywords.some(keyword => search.includes(keyword))) {
+        window.location.href = scheme;
+        return;
+      }
+    }
+  }, [connector]);
+
+  const writeAndOpen = useCallback(
+    <T>(writeFn: () => Promise<T>): Promise<T> => {
+      const promise = writeFn();
+      setTimeout(openWallet, HANDOFF_DELAY_MS);
+      return promise;
+    },
+    [openWallet],
+  );
+
+  return { openWallet, writeAndOpen };
+};
