diff --git a/packages/nextjs/utils/removeServerLocalStorage.ts b/packages/nextjs/utils/removeServerLocalStorage.ts
new file mode 100644
index 0000000..1b41f77
--- /dev/null
+++ b/packages/nextjs/utils/removeServerLocalStorage.ts
@@ -0,0 +1,12 @@
+/**
+ * Next.js runs its build/prerender workers with Node's Web Storage enabled, so `localStorage`
+ * exists on the server as a stub whose methods are missing. Libraries that feature-detect with
+ * `typeof localStorage !== "undefined"` (RainbowKit's recent-wallet lookup, among others) then
+ * take the browser branch and throw `localStorage.getItem is not a function`, which fails the
+ * production build. Removing the stub restores the "not a browser" answer those guards expect.
+ *
+ * Imported for its side effect from the root layout so it runs before any route renders.
+ */
+if (typeof window === "undefined" && typeof globalThis.localStorage !== "undefined") {
+  delete (globalThis as { localStorage?: unknown }).localStorage;
+}
