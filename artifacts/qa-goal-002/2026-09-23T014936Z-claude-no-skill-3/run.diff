+//SPDX-License-Identifier: MIT
+pragma solidity >=0.8.20 <0.9.0;
+
+import { ERC20 } from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+
+/**
+ * Test-only stand-in for USDC: 6 decimals and freely mintable.
+ */
+contract MockERC20 is ERC20 {
+    constructor() ERC20("Mock USD Coin", "USDC") {}
+
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    function mint(address to, uint256 amount) external {
+        _mint(to, amount);
+    }
+}
+
+/**
+ * Test-only token whose `transferFrom` reports failure by returning false instead of
+ * reverting, so we can cover the `Payouts: transfer failed` branch.
+ */
+contract FalseReturningERC20 is ERC20 {
+    constructor() ERC20("False Returning", "FALSE") {}
+
+    function transferFrom(address, address, uint256) public pure override returns (bool) {
+        return false;
+    }
+}
