+// Canonical (native) USDC per chain. The address is baked into the contract as an
+// immutable, so deploying against the wrong one produces a permanently broken Payouts.
+const USDC_BY_CHAIN_ID: Record<number, `0x${string}`> = {
+  8453: "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913", // Base
+  84532: "0x036CbD53842c5426634e7929541eC2318f3dCF7e", // Base Sepolia
+};
+
+const LOCAL_CHAIN_IDS = [31337, 1337];
 
 /**
- * Deploys the Payouts contract pointed at Base USDC.
+ * Deploys the Payouts contract pointed at the USDC of the target chain. Local chains have
+ * no USDC, so they get a mintable mock deployed under the same `USDC` name the frontend uses.
  *
  * @param env Rocketh environment object.
  */
 export default deployScript(
   async env => {
     const { deployer } = env.namedAccounts;
+    const chainId = env.network.chain.id;
+
+    let usdcAddress = USDC_BY_CHAIN_ID[chainId];
+
+    if (!usdcAddress) {
+      if (!LOCAL_CHAIN_IDS.includes(chainId)) {
+        throw new Error(
+          `No USDC address configured for chain ${chainId}. Add it to USDC_BY_CHAIN_ID in deploy/00_deploy_payouts.ts before deploying.`,
+        );
+      }
+
+      const mockUsdc = await env.deploy("USDC", {
+        account: deployer,
+        artifact: artifacts.MockERC20,
+        args: [],
+      });
+      usdcAddress = mockUsdc.address;
+    }
 
     await env.deploy("Payouts", {
       account: deployer,
       artifact: artifacts.Payouts,
       // Contract constructor arguments
-      args: [USDC_ADDRESS],
+      args: [usdcAddress],
     });
   },
   {
