+import { expect } from "chai";
+import { network } from "hardhat";
+import type { Signer } from "ethers";
+
+const { ethers } = await network.connect();
+
+const usdc = (amount: string) => ethers.parseUnits(amount, 6);
+
+describe("Payouts", function () {
+  let payouts: any;
+  let token: any;
+  let payer: Signer;
+  let recipient: Signer;
+  let payerAddress: string;
+  let recipientAddress: string;
+
+  beforeEach(async function () {
+    [payer, recipient] = await ethers.getSigners();
+    payerAddress = await payer.getAddress();
+    recipientAddress = await recipient.getAddress();
+
+    token = await (await ethers.getContractFactory("MockERC20")).deploy();
+    payouts = await (await ethers.getContractFactory("Payouts")).deploy(await token.getAddress());
+
+    await token.mint(payerAddress, usdc("1000"));
+  });
+
+  it("exposes the USDC address it was deployed with", async function () {
+    expect(await payouts.usdc()).to.equal(await token.getAddress());
+  });
+
+  describe("pay", function () {
+    beforeEach(async function () {
+      await token.connect(payer).approve(await payouts.getAddress(), usdc("1000"));
+    });
+
+    it("moves USDC from the payer straight to the recipient", async function () {
+      await payouts.connect(payer).pay(recipientAddress, usdc("250"), "October invoice");
+
+      expect(await token.balanceOf(recipientAddress)).to.equal(usdc("250"));
+      expect(await token.balanceOf(payerAddress)).to.equal(usdc("750"));
+    });
+
+    it("never custodies funds itself", async function () {
+      await payouts.connect(payer).pay(recipientAddress, usdc("250"), "");
+
+      expect(await token.balanceOf(await payouts.getAddress())).to.equal(0n);
+    });
+
+    it("emits Paid with the payer, recipient, amount and memo", async function () {
+      await expect(payouts.connect(payer).pay(recipientAddress, usdc("10"), "coffee"))
+        .to.emit(payouts, "Paid")
+        .withArgs(payerAddress, recipientAddress, usdc("10"), "coffee");
+    });
+
+    it("spends only the amount paid from the allowance", async function () {
+      await payouts.connect(payer).pay(recipientAddress, usdc("400"), "");
+
+      expect(await token.allowance(payerAddress, await payouts.getAddress())).to.equal(usdc("600"));
+    });
