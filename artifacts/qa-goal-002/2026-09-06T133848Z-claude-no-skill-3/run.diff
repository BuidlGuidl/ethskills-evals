diff --git a/packages/hardhat/test/Payouts.ts b/packages/hardhat/test/Payouts.ts
new file mode 100644
index 0000000..728d78c
--- /dev/null
+++ b/packages/hardhat/test/Payouts.ts
@@ -0,0 +1,53 @@
+import { expect } from "chai";
+import { network } from "hardhat";
+
+const { ethers } = await network.getOrCreate();
+
+const usdc = (amount: string) => ethers.parseUnits(amount, 6);
+
+describe("Payouts", function () {
+  const deployFixture = async () => {
+    const [payer, recipient] = await ethers.getSigners();
+    const mockUsdc = await ethers.deployContract("MockUSDC");
+    const payouts = await ethers.deployContract("Payouts", [await mockUsdc.getAddress()]);
+    await mockUsdc.mint(payer.address, usdc("1000"));
+    return { payer, recipient, mockUsdc, payouts };
+  };
+
+  it("stores the USDC address", async function () {
+    const { mockUsdc, payouts } = await deployFixture();
+    expect(await payouts.usdc()).to.equal(await mockUsdc.getAddress());
+  });
+
+  it("moves USDC to the recipient and emits Paid", async function () {
+    const { payer, recipient, mockUsdc, payouts } = await deployFixture();
+    await mockUsdc.approve(await payouts.getAddress(), usdc("100"));
+
+    await expect(payouts.pay(recipient.address, usdc("100"), "design work"))
+      .to.emit(payouts, "Paid")
+      .withArgs(payer.address, recipient.address, usdc("100"), "design work");
+
+    expect(await mockUsdc.balanceOf(recipient.address)).to.equal(usdc("100"));
+    expect(await mockUsdc.balanceOf(payer.address)).to.equal(usdc("900"));
+  });
+
+  it("rejects a zero recipient", async function () {
+    const { payouts } = await deployFixture();
+    await expect(payouts.pay(ethers.ZeroAddress, usdc("1"), "")).to.be.revertedWith("Payouts: zero recipient");
+  });
+
+  it("rejects a zero amount", async function () {
+    const { recipient, payouts } = await deployFixture();
+    await expect(payouts.pay(recipient.address, 0n, "")).to.be.revertedWith("Payouts: zero amount");
+  });
+
+  it("reverts when the payer has not approved enough", async function () {
+    const { recipient, mockUsdc, payouts } = await deployFixture();
+    await mockUsdc.approve(await payouts.getAddress(), usdc("10"));
+
+    await expect(payouts.pay(recipient.address, usdc("11"), "")).to.be.revertedWithCustomError(
+      mockUsdc,
+      "ERC20InsufficientAllowance",
+    );
+  });
+});
