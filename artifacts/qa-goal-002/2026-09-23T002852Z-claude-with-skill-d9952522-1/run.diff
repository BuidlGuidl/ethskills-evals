index 0000000..e3c35c1
--- /dev/null
+++ b/packages/nextjs/utils/scaffold-eth/walletRedirect.ts
@@ -0,0 +1,36 @@
+/**
+ * On mobile, a WalletConnect session signs in a separate app. The browser has no way to raise that
+ * app on its own, so without a deep link the user taps "Send" and nothing visible happens.
+ *
+ * WalletConnect records the wallet the user actually connected with under
+ * `WALLETCONNECT_DEEPLINK_CHOICE`, so we reuse that rather than guessing a wallet.
+ *
+ * Wire this to the write's `onMutate` rather than calling it before `writeContractAsync`:
+ * useScaffoldWriteContract simulates first, so a redirect at the call site raises the wallet app
+ * a full RPC round trip before the request is actually published.
+ *
+ * Inside a wallet's in-app browser there is nothing to redirect to, so it is a no-op there.
+ */
+export const redirectToWalletApp = (connectorType?: string) => {
+  if (typeof window === "undefined") return;
+  // Check `type`, not `id`: RainbowKit builds metaMask/rainbow/ledger/phantom on top of the
+  // WalletConnect connector, and only the injected path rewrites `id`.
+  if (connectorType !== "walletConnect") return;
+
+  // A desktop browser connected by QR has no app to raise, but can still hold a stale deeplink
+  // choice in localStorage - navigating that tab away mid-transaction would lose the request.
+  const isTouchDevice = navigator.maxTouchPoints > 0;
+  if (!isTouchDevice) return;
+
+  const raw = localStorage.getItem("WALLETCONNECT_DEEPLINK_CHOICE");
+  if (!raw) return;
+
+  try {
+    // `href` is either a native scheme ("metamask://") or a universal link; both raise the app.
+    const { href } = JSON.parse(raw) as { href?: string };
+    if (!href) return;
+    window.location.href = href;
+  } catch {
+    // A malformed entry is not worth breaking the transaction over.
+  }
+};

