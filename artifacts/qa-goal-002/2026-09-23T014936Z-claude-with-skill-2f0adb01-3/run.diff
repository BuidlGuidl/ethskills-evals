index 0000000..0b67d96
--- /dev/null
+++ b/packages/hardhat/test/Payouts.ts
@@ -0,0 +1,72 @@
+import { expect } from "chai";
+import { network } from "hardhat";
+
+const { ethers } = await network.connect();
+
+const usdc = (amount: string) => ethers.parseUnits(amount, 6);
+
+describe("Payouts", function () {
+  const deployFixture = async () => {
+    const [payer, recipient] = await ethers.getSigners();
+
+    const token = await (await ethers.getContractFactory("MockERC20")).deploy();
+    const payouts = await (await ethers.getContractFactory("Payouts")).deploy(await token.getAddress());
+
+    await token.mint(payer.address, usdc("1000"));
+
+    return { payer, recipient, token, payouts };
+  };
+
+  it("transfers USDC to the recipient and emits Paid", async function () {
+    const { payer, recipient, token, payouts } = await deployFixture();
+    await token.approve(await payouts.getAddress(), usdc("100"));
+
+    await expect(payouts.pay(recipient.address, usdc("100"), "October invoice"))
+      .to.emit(payouts, "Paid")
+      .withArgs(payer.address, recipient.address, usdc("100"), "October invoice");
+
+    expect(await token.balanceOf(recipient.address)).to.equal(usdc("100"));
+    expect(await token.balanceOf(payer.address)).to.equal(usdc("900"));
+  });
+
+  it("spends only the paid amount of the allowance", async function () {
+    const { recipient, token, payouts } = await deployFixture();
+    const payoutsAddress = await payouts.getAddress();
+    await token.approve(payoutsAddress, usdc("100"));
+
+    await payouts.pay(recipient.address, usdc("40"), "");
+
+    const [payer] = await ethers.getSigners();
+    expect(await token.allowance(payer.address, payoutsAddress)).to.equal(usdc("60"));
+  });
+
+  it("rejects the zero address", async function () {
+    const { token, payouts } = await deployFixture();
+    await token.approve(await payouts.getAddress(), usdc("10"));
+
+    await expect(payouts.pay(ethers.ZeroAddress, usdc("10"), "")).to.be.revertedWith("Payouts: zero recipient");
+  });
+
+  it("rejects a zero amount", async function () {
+    const { recipient, payouts } = await deployFixture();
+
+    await expect(payouts.pay(recipient.address, 0, "")).to.be.revertedWith("Payouts: zero amount");
+  });
+
+  it("reverts when the token reports a failed transfer", async function () {
+    const [, recipient] = await ethers.getSigners();
+    const token = await (await ethers.getContractFactory("FalseReturningERC20")).deploy();
+    const payouts = await (await ethers.getContractFactory("Payouts")).deploy(await token.getAddress());
+
+    await expect(payouts.pay(recipient.address, usdc("10"), "")).to.be.revertedWith("Payouts: transfer failed");
+  });
+
+  it("reverts when the allowance is too low", async function () {
+    const { recipient, token, payouts } = await deployFixture();
+    await token.approve(await payouts.getAddress(), usdc("10"));
+
+    await expect(payouts.pay(recipient.address, usdc("20"), "")).to.be.revertedWith(
+      "MockERC20: insufficient allowance",
+    );
+  });
+});
