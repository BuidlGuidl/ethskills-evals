diff --git a/packages/nextjs/hooks/useWalletDeepLink.ts b/packages/nextjs/hooks/useWalletDeepLink.ts
new file mode 100644
index 0000000..f89a394
--- /dev/null
+++ b/packages/nextjs/hooks/useWalletDeepLink.ts
@@ -0,0 +1,68 @@
+"use client";
+
+import { useCallback } from "react";
+import { useAccount } from "wagmi";
+
+// WalletConnect v2 relies on push notifications to bring the user back to their
+// wallet, which is slow and unreliable. We deep link manually instead.
+const WALLET_SCHEMES: [string[], string][] = [
+  [["rainbow"], "rainbow://"],
+  [["metamask"], "metamask://"],
+  [["coinbase", "cbwallet", "baseaccount"], "cbwallet://"],
+  [["trust"], "trust://"],
+  [["phantom"], "phantom://"],
+  [["ledger"], "ledgerlive://"],
+];
+
+// `writeContractAsync` needs time to simulate, encode and relay the request
+// through the WalletConnect servers before the wallet has anything to show.
+const DEEP_LINK_DELAY_MS = 2000;
+
+/**
+ * Returns a `writeAndOpen` helper that fires a transaction and then switches the
+ * user to their wallet app on mobile. Wrap every write call with it.
+ */
+export const useWalletDeepLink = () => {
+  const { connector } = useAccount();
+
+  const openWallet = useCallback(() => {
+    if (typeof window === "undefined") return;
+
+    const isMobile = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);
+    // `window.ethereum` means we are already inside a wallet's in-app browser.
+    if (!isMobile || (window as any).ethereum) return;
+
+    // `connector.id` is just "walletConnect", so the actual wallet name has to
+    // come out of the WalletConnect session stored in localStorage. Reading it can
+    // throw in private browsing modes, so the whole lookup is guarded.
+    let storedHints = "";
+    try {
+      const wcKey = Object.keys(localStorage).find(key => key.startsWith("wc@2:client"));
+      storedHints = [localStorage.getItem("wagmi.recentConnectorId"), wcKey && localStorage.getItem(wcKey)]
+        .filter(Boolean)
+        .join(" ");
+    } catch {
+      // Fall back to whatever the connector itself tells us.
+    }
+
+    const search = `${connector?.id ?? ""} ${connector?.name ?? ""} ${storedHints}`.toLowerCase();
+    const match = WALLET_SCHEMES.find(([keywords]) => keywords.some(keyword => search.includes(keyword)));
+    if (match) {
+      window.location.href = match[1];
+    }
+  }, [connector]);
+
+  const writeAndOpen = useCallback(
+    <T>(writeFn: () => Promise<T>): Promise<T> => {
+      const promise = writeFn();
+      const timer = setTimeout(openWallet, DEEP_LINK_DELAY_MS);
+      // Don't drag the user into their wallet if the request never made it there
+      // (simulation reverted, a guard rejected it, the user bailed early).
+      promise.catch(() => clearTimeout(timer));
+      return promise;
+    },
+    [openWallet],
+  );
+
+  return { writeAndOpen, openWallet };
+};
