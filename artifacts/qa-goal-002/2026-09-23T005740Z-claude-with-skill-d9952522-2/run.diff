diff --git a/packages/nextjs/utils/scaffold-eth/openWalletApp.ts b/packages/nextjs/utils/scaffold-eth/openWalletApp.ts
new file mode 100644
index 0000000..4dc20d7
--- /dev/null
+++ b/packages/nextjs/utils/scaffold-eth/openWalletApp.ts
@@ -0,0 +1,26 @@
+import { Connector } from "wagmi";
+
+const isMobile = () => typeof navigator !== "undefined" && /android|iphone|ipad|ipod/i.test(navigator.userAgent);
+
+/**
+ * On mobile WalletConnect the signing request lands in a wallet app the browser never surfaces,
+ * so the user sees a button that "does nothing". Push them to the wallet they actually connected
+ * with, using the redirect target the wallet advertised in its session metadata.
+ *
+ * Call this *after* firing the write — navigating away first means the request never leaves.
+ * No-op on desktop and inside a wallet's in-app browser (those connect via an injected provider).
+ */
+export const openWalletApp = async (connector?: Connector) => {
+  if (!isMobile() || connector?.id !== "walletConnect") return;
+
+  try {
+    const provider = (await connector.getProvider()) as {
+      session?: { peer?: { metadata?: { redirect?: { native?: string; universal?: string } } } };
+    };
+    const redirect = provider?.session?.peer?.metadata?.redirect;
+    const target = redirect?.native || redirect?.universal;
+    if (target) window.location.href = target;
+  } catch {
+    // A missing or malformed session is not worth failing the transaction over.
+  }
+};

