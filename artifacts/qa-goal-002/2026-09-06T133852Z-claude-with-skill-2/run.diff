diff --git a/packages/nextjs/utils/scaffold-eth/openWalletApp.ts b/packages/nextjs/utils/scaffold-eth/openWalletApp.ts
new file mode 100644
index 0000000..ff45ad8
--- /dev/null
+++ b/packages/nextjs/utils/scaffold-eth/openWalletApp.ts
@@ -0,0 +1,27 @@
+// WalletConnect records the wallet the user picked here, e.g.
+// {"href":"https://metamask.app.link/","name":"MetaMask"}
+const DEEPLINK_CHOICE_KEY = "WALLETCONNECT_DEEPLINK_CHOICE";
+
+const isMobile = () => /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
+
+/**
+ * On mobile WalletConnect the signing request lands in a wallet app the user is not looking at,
+ * so nothing appears to happen. Send them there.
+ *
+ * Call this *after* firing the write — navigating away first means the request is never sent.
+ * Inside a wallet's in-app browser the connector is injected rather than WalletConnect and the
+ * prompt is already on screen, so that case falls through untouched.
+ */
+export const openWalletApp = (connectorId?: string) => {
+  if (typeof window === "undefined" || connectorId !== "walletConnect" || !isMobile()) return;
+
+  let href: string | undefined;
+  try {
+    const choice = localStorage.getItem(DEEPLINK_CHOICE_KEY);
+    href = choice ? JSON.parse(choice).href : undefined;
+  } catch {
+    // Malformed entry: fall back to the generic wc: handler below.
+  }
+
+  window.location.href = href || "wc:";
+};

