+ * Deploys the Payouts contract pointed at the USDC of the current chain.
  *
  * @param env Rocketh environment object.
  */
 export default deployScript(
   async env => {
     const { deployer } = env.namedAccounts;
+    const chainId = Number(env.network.chain.id);
+
+    let usdcAddress = USDC_BY_CHAIN_ID[chainId];
+
+    if (!usdcAddress) {
+      if (!LOCAL_CHAIN_IDS.includes(chainId)) {
+        throw new Error(
+          `No USDC address configured for chain ${chainId}. Add it to USDC_BY_CHAIN_ID before deploying Payouts.`,
+        );
+      }
+      // Local chain: deploy a mock so the approve -> pay flow is testable end to end.
+      // Saved as "USDC" so the frontend finds it under the same contract name as on Base.
+      const mock = await env.deploy("USDC", {
+        account: deployer,
+        artifact: artifacts.MockUSDC,
+        args: [],
+      });
+      usdcAddress = mock.address;
+    }
 
     await env.deploy("Payouts", {
       account: deployer,
       artifact: artifacts.Payouts,
       // Contract constructor arguments
-      args: [USDC_ADDRESS],
+      args: [usdcAddress],
     });
