+//SPDX-License-Identifier: MIT
+pragma solidity >=0.8.0 <0.9.0;
+
+import { ERC20 } from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+
+/**
+ * Stand-in for Base USDC on local chains only. Never deployed to a live network:
+ * `deploy/00_deploy_payouts.ts` only deploys it when the chain id is not in USDC_BY_CHAIN_ID.
+ * Freely mintable on purpose so anyone can fund a test payout.
+ */
+contract MockUSDC is ERC20 {
+    constructor() ERC20("Mock USD Coin", "USDC") {}
+
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    function mint(address to, uint256 amount) external {
+        _mint(to, amount);
+    }
+}
