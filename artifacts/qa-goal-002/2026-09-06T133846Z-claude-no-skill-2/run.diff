+// Canonical USDC per chain. Payouts is only useful where real USDC exists, so any chain
+// missing from this map gets a locally deployed MockUSDC instead of a silent misconfiguration.
+const USDC_BY_CHAIN_ID: Record<number, `0x${string}`> = {
+  8453: "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913", // Base
+  84532: "0x036CbD53842c5426634e7929541eC2318f3dCF7e", // Base Sepolia
