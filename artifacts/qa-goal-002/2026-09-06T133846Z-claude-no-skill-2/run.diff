diff --git a/packages/hardhat/test/Payouts.ts b/packages/hardhat/test/Payouts.ts
new file mode 100644
index 0000000..96bbb6a
--- /dev/null
+++ b/packages/hardhat/test/Payouts.ts
@@ -0,0 +1,79 @@
+import { expect } from "chai";
+import { network } from "hardhat";
+
+const { ethers } = await network.connect();
+
+const usdc = (whole: string) => ethers.parseUnits(whole, 6);
+
+describe("Payouts", () => {
+  const deployFixture = async () => {
+    const [payer, recipient] = await ethers.getSigners();
+
+    const token = await ethers.deployContract("MockUSDC");
+    const payouts = await ethers.deployContract("Payouts", [await token.getAddress()]);
+
+    await token.mint(payer.address, usdc("1000"));
+
+    return { payer, recipient, token, payouts };
+  };
+
+  it("points at the token it was constructed with", async () => {
+    const { token, payouts } = await deployFixture();
+    expect(await payouts.usdc()).to.equal(await token.getAddress());
+  });
+
+  it("moves USDC from the payer to the recipient and emits Paid", async () => {
+    const { payer, recipient, token, payouts } = await deployFixture();
+    await token.approve(await payouts.getAddress(), usdc("100"));
+
+    await expect(payouts.pay(recipient.address, usdc("100"), "March invoice"))
+      .to.emit(payouts, "Paid")
+      .withArgs(payer.address, recipient.address, usdc("100"), "March invoice");
+
+    expect(await token.balanceOf(recipient.address)).to.equal(usdc("100"));
+    expect(await token.balanceOf(payer.address)).to.equal(usdc("900"));
+  });
+
+  it("spends only the paid amount of the allowance", async () => {
+    const { recipient, token, payouts } = await deployFixture();
+    await token.approve(await payouts.getAddress(), usdc("100"));
+    await payouts.pay(recipient.address, usdc("40"), "");
+
+    const [payer] = await ethers.getSigners();
+    expect(await token.allowance(payer.address, await payouts.getAddress())).to.equal(usdc("60"));
+  });
+
+  it("rejects a zero recipient", async () => {
+    const { token, payouts } = await deployFixture();
+    await token.approve(await payouts.getAddress(), usdc("100"));
+
+    await expect(payouts.pay(ethers.ZeroAddress, usdc("1"), "")).to.be.revertedWith("Payouts: zero recipient");
+  });
