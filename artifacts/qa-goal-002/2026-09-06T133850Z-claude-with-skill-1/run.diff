new file mode 100644
index 0000000..a3fa069
--- /dev/null
+++ b/packages/nextjs/utils/openWalletApp.ts
@@ -0,0 +1,22 @@
+/**
+ * On mobile the dApp runs in a normal browser and the wallet is a separate app, so a signature
+ * request raises no UI here. WalletConnect stores the deep link of the wallet the user actually
+ * connected with; opening it brings that wallet to the foreground with the request waiting.
+ *
+ * Call this right after firing the write (not before — navigating away first means the write never
+ * runs). It is a no-op on desktop and inside a wallet's in-app browser, where the connection is
+ * injected and no deep link is stored.
+ */
+export const openWalletApp = () => {
+  if (typeof window === "undefined") return;
+
+  try {
+    const choice = window.localStorage.getItem("WALLETCONNECT_DEEPLINK_CHOICE");
+    if (!choice) return;
+
+    const { href } = JSON.parse(choice) as { href?: string };
+    if (href) window.open(href, "_self");
+  } catch {
+    // Malformed or unreadable storage: leave the user on the page rather than throwing.
+  }
+};
