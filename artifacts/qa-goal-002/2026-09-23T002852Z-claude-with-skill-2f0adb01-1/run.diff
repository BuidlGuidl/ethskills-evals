diff --git a/packages/nextjs/hooks/scaffold-eth/useWriteAndOpenWallet.ts b/packages/nextjs/hooks/scaffold-eth/useWriteAndOpenWallet.ts
new file mode 100644
index 0000000..538e784
--- /dev/null
+++ b/packages/nextjs/hooks/scaffold-eth/useWriteAndOpenWallet.ts
@@ -0,0 +1,66 @@
+import { useCallback } from "react";
+import { useAccount } from "wagmi";
+
+const WALLET_SCHEMES: [string[], string][] = [
+  [["rainbow"], "rainbow://"],
+  [["metamask"], "metamask://"],
+  [["coinbase", "cbwallet", "baseaccount", "base account"], "cbwallet://"],
+  [["trust"], "trust://"],
+  [["phantom"], "phantom://"],
+  [["ledger"], "ledgerlive://"],
+];
+
+// WalletConnect relays the signing request through its servers before the wallet
+// can show it, so switching apps immediately would land the user on an empty wallet.
+const DEEP_LINK_DELAY_MS = 2000;
+
+/**
+ * Wraps a contract write so that mobile WalletConnect users are switched to their
+ * wallet app once the request has been relayed.
+ *
+ * RainbowKit v2 relies on push notifications for this, which are slow and often
+ * never arrive, so the deep link is done explicitly.
+ */
+export const useWriteAndOpenWallet = () => {
+  const { connector } = useAccount();
+
+  const openWallet = useCallback(() => {
+    if (typeof window === "undefined") return;
+
+    const isMobile = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);
+    // `window.ethereum` on mobile means we are already inside a wallet's in-app
+    // browser, where deep linking would just bounce the user out of the flow.
+    if (!isMobile || window.ethereum) return;
+
+    // `connector.id` is "walletConnect" regardless of which wallet the user picked,
+    // so the stored WalletConnect session is what actually identifies the wallet.
+    let wcSession = "";
+    try {
+      const wcKey = Object.keys(localStorage).find(key => key.startsWith("wc@2:client"));
+      if (wcKey) wcSession = (localStorage.getItem(wcKey) || "").toLowerCase();
+    } catch {
+      // localStorage can throw in private browsing modes; fall through to connector info.
+    }
+
+    const search = [connector?.id, connector?.name, localStorage.getItem("wagmi.recentConnectorId"), wcSession]
+      .filter(Boolean)
+      .join(" ")
+      .toLowerCase();
+
+    for (const [keywords, scheme] of WALLET_SCHEMES) {
+      if (keywords.some(keyword => search.includes(keyword))) {
+        window.location.href = scheme;
+        return;
+      }
+    }
+  }, [connector]);
+
+  return useCallback(
+    <T>(writeFn: () => Promise<T>): Promise<T> => {
+      const promise = writeFn();
+      setTimeout(openWallet, DEEP_LINK_DELAY_MS);
+      return promise;
+    },
+    [openWallet],
+  );
+};
