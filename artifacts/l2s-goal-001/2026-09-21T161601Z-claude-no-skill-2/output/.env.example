# Copy to .env (never commit it). Both scripts load ./.env automatically.

# --- RPC -------------------------------------------------------------------
# Use paid/dedicated endpoints in production. Public ones (forno.celo.org,
# publicnode) rate-limit and sometimes miss receipts or historical state.
CELO_RPC_URL=https://forno.celo.org
# Used only by `sweep.ts prove`: must serve eth_getProof for Celo blocks ~1h+ old.
# Leave unset to use CELO_RPC_URL.
# CELO_ARCHIVE_RPC_URL=
ETH_RPC_URL=

# --- Ops wallet (Celo) -----------------------------------------------------
# Address is required for dry runs; the key is only read when --execute is used.
OPS_ADDRESS=
OPS_PRIVATE_KEY=

# --- Payout guardrails (required) ------------------------------------------
PAYOUT_MAX_ROW_USDC=5000
PAYOUT_MAX_TOTAL_USDC=250000

# --- Sweep -------------------------------------------------------------------
# Ethereum mainnet treasury. It receives CELO as an ERC-20 on Ethereum
# (0x057898f3C43F129a17517B9056D23851F124b19f), not ETH.
TREASURY_L1_ADDRESS=0x1111111111111111111111111111111111111111
# CELO kept in the ops wallet to pay Celo gas for payouts and the sweep itself.
CELO_GAS_RESERVE=10
# SWEEP_MIN_CELO=1

# Ethereum key that sends the prove + finalize txs (pays ETH gas only; it never
# holds or controls the swept funds). May be the same key as OPS_PRIVATE_KEY.
L1_ADDRESS=
L1_PRIVATE_KEY=

# --- Tuning (optional) -------------------------------------------------------
# CELO_CONFIRMATIONS=5
# CELO_MAX_FEE_GWEI=1000     # Celo base fee is ~200 gwei (Sept 2026)
# CELO_TX_TIMEOUT_SEC=120
# L1_MAX_FEE_GWEI=30
# LEDGER_DIR=./ledger
