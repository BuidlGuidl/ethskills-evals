# --- Celo (payouts + sweep initiate) ---------------------------------------
CELO_RPC_URL=                # dedicated Celo mainnet RPC (chainId 42220). Not public forno for production.
OPS_ADDRESS=                 # ops wallet address (checksummed). Dry runs need only this.
OPS_PRIVATE_KEY=             # only for --execute. Must control OPS_ADDRESS.
PAYOUT_MAX_ROW_USDC=         # optional per-row cap, e.g. 5000

# --- Sweep -------------------------------------------------------------------
ETH_RPC_URL=                 # dedicated Ethereum mainnet RPC (chainId 1)
TREASURY_ADDRESS=            # Ethereum mainnet treasury. 0x1111… placeholder is rejected.
GAS_RESERVE_CELO=            # CELO left in the ops wallet for payout gas, e.g. 25
L1_PRIVATE_KEY=              # prove/finalize only. Any key with a little ETH; holds no funds.
