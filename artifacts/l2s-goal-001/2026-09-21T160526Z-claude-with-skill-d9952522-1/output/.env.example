# --- RPC (use paid providers in production; see NOTES.md "RPCs") ---
CELO_RPC_URL=https://forno.celo.org
ETH_RPC_URL=

# --- Ops wallet on Celo: pays USDC out, holds CELO revenue, initiates sweeps ---
OPS_ADDRESS=
# Only needed with --execute; must derive OPS_ADDRESS.
OPS_PRIVATE_KEY=

# --- Relayer on Ethereum mainnet: sends prove/finalize, holds only ETH for gas ---
RELAYER_ADDRESS=
# Only needed for `sweep.ts advance --execute`.
RELAYER_PRIVATE_KEY=

# --- Treasury on Ethereum mainnet. Receives CELO as the L1 ERC-20 0x0578…b19f. ---
# The scripts refuse the 0x1111… placeholder.
TREASURY_ADDRESS=0x1111111111111111111111111111111111111111

# USDC (default): gas paid in USDC via the CIP-64 fee adapter; the ops wallet needs no CELO for gas.
# CELO: gas paid in CELO, which then comes out of revenue.
GAS_CURRENCY=USDC

# Optional: refuse any CSV row above this many USDC.
PAYOUT_MAX_ROW_USDC=

# Where journals and reports live. Back this directory up; it is what makes re-runs safe.
STATE_DIR=state
