# Dedicated providers in production; forno / public nodes are rate-limited.
CELO_RPC_URL=https://forno.celo.org
ETH_RPC_URL=
# Ops wallet on Celo: holds USDC for payouts and the CELO revenue. Signs payouts and the sweep's initiate step.
OPS_PRIVATE_KEY=
# Ethereum key that only pays ETH gas for prove + finalize. Never holds treasury funds.
L1_RELAYER_PRIVATE_KEY=
# Ethereum mainnet treasury. sweep.ts refuses to run while this is the 0x1111… placeholder.
TREASURY_ADDRESS=
