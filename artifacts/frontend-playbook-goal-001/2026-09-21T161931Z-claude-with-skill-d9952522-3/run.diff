@@ -0,0 +1,65 @@
+"use client";
+
+import { Address } from "@scaffold-ui/components";
+import { formatUnits } from "viem";
+import {
+  useDeployedContractInfo,
+  useScaffoldEventHistory,
+  useScaffoldReadContract,
+  useTargetNetwork,
+} from "~~/hooks/scaffold-eth";
+
+export const TipFeed = () => {
+  const { targetNetwork } = useTargetNetwork();
+
+  const { data: tips, isLoading } = useScaffoldEventHistory({
+    contractName: "TipJar",
+    eventName: "Tip",
+    watch: true,
+    blockData: true,
+  });
+  const { data: tipJar } = useDeployedContractInfo({ contractName: "TipJar" });
+  const { data: jarBalance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "balanceOf",
+    args: [tipJar?.address],
+    watch: true,
+  });
+
+  const sortedTips = [...(tips ?? [])].sort((a, b) =>
+    a.blockNumber === b.blockNumber ? b.logIndex - a.logIndex : Number(b.blockNumber - a.blockNumber),
+  );
+
+  return (
+    <div className="card bg-base-100 shadow-xl">
+      <div className="card-body">
+        <h2 className="card-title justify-between">
+          Tip feed
+          {jarBalance !== undefined && (
+            <span className="badge badge-secondary">In jar: {formatUnits(jarBalance, 6)} USDC</span>
+          )}
+        </h2>
+        {isLoading ? (
+          <span className="loading loading-dots" />
+        ) : sortedTips.length === 0 ? (
+          <p className="opacity-70">No tips yet. Be the first!</p>
+        ) : (
+          <ul className="flex flex-col gap-3">
+            {sortedTips.map(tip => (
+              <li key={`${tip.transactionHash}-${tip.logIndex}`} className="bg-base-200 rounded-box p-3">
+                <div className="flex flex-wrap items-center justify-between gap-2">
+                  <Address address={tip.args.from} chain={targetNetwork} size="sm" />
+                  <span className="font-bold">{formatUnits(tip.args.amount ?? 0n, 6)} USDC</span>
+                </div>
+                {tip.args.message && <p className="my-1 break-words">{tip.args.message}</p>}
+                <p className="text-xs opacity-60">
+                  {new Date(Number(tip.blockData.timestamp) * 1000).toLocaleString()}
+                </p>
+              </li>
+            ))}
+          </ul>
+        )}
+      </div>
+    </div>
+  );
+};
diff --git a/packages/nextjs/app/_components/TipForm.tsx b/packages/nextjs/app/_components/TipForm.tsx
new file mode 100644
index 0000000..fe35142
--- /dev/null
+++ b/packages/nextjs/app/_components/TipForm.tsx
@@ -0,0 +1,98 @@
+"use client";
+
+import { useState } from "react";
+import { formatUnits, parseUnits } from "viem";
+import { useAccount } from "wagmi";
+import { useDeployedContractInfo, useScaffoldReadContract, useScaffoldWriteContract } from "~~/hooks/scaffold-eth";
+
+const USDC_DECIMALS = 6;
+const MAX_MESSAGE_LENGTH = 280;
+
+export const TipForm = () => {
+  const { address } = useAccount();
+  const [amount, setAmount] = useState("");
+  const [message, setMessage] = useState("");
+
+  const { data: tipJar } = useDeployedContractInfo({ contractName: "TipJar" });
+
+  const { data: balance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "balanceOf",
+    args: [address],
+    watch: true,
+  });
+  const { data: allowance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "allowance",
+    args: [address, tipJar?.address],
+    watch: true,
+  });
+
+  const { writeContractAsync: writeUsdc, isPending: isApproving } = useScaffoldWriteContract({
+    contractName: "USDC",
+  });
+  const { writeContractAsync: writeTipJar, isPending: isTipping } = useScaffoldWriteContract({
+    contractName: "TipJar",
+  });
+
+  let amountUnits: bigint | undefined;
+  try {
+    amountUnits = amount ? parseUnits(amount, USDC_DECIMALS) : undefined;
+  } catch {
+    amountUnits = undefined;
+  }
+
+  const needsApproval = amountUnits !== undefined && (allowance ?? 0n) < amountUnits;
+  const insufficientBalance = amountUnits !== undefined && balance !== undefined && amountUnits > balance;
+  const isBusy = isApproving || isTipping;
+  const canSubmit = !!address && !!tipJar && !!amountUnits && !insufficientBalance && !isBusy;
+
+  const handleTip = async () => {
+    if (!tipJar || !amountUnits) return;
+    try {
+      if (needsApproval) {
+        await writeUsdc({ functionName: "approve", args: [tipJar.address, amountUnits] });
+      }
+      await writeTipJar({ functionName: "tip", args: [amountUnits, message] });
+      setAmount("");
+      setMessage("");
+    } catch (e) {
+      // Transaction errors are already surfaced as notifications by useTransactor.
+      console.error("Tip failed", e);
+    }
+  };
+
+  return (
+    <div className="card bg-base-100 shadow-xl">
+      <div className="card-body gap-4">
+        <h2 className="card-title">Send a tip</h2>
+        <p className="text-sm opacity-70">
+          Your USDC balance: {balance !== undefined ? formatUnits(balance, USDC_DECIMALS) : "—"}
+        </p>
+        <label className="input w-full">
+          <input
+            type="text"
+            inputMode="decimal"
+            placeholder="Amount"
+            value={amount}
+            onChange={e => setAmount(e.target.value)}
+          />
+          <span className="label">USDC</span>
+        </label>
+        {amount && amountUnits === undefined && <p className="text-error text-sm">Enter a valid amount</p>}
+        {insufficientBalance && <p className="text-error text-sm">Not enough USDC</p>}
+        <textarea
+          className="textarea w-full"
+          placeholder="Say something nice (optional)"
+          maxLength={MAX_MESSAGE_LENGTH}
+          value={message}
+          onChange={e => setMessage(e.target.value)}
+        />
+        <button className="btn btn-primary" disabled={!canSubmit} onClick={handleTip}>
+          {isBusy && <span className="loading loading-spinner loading-sm" />}
+          {!address ? "Connect a wallet" : needsApproval ? "Approve & tip" : "Tip"}
+        </button>
+      </div>
+    </div>
+  );
+};
