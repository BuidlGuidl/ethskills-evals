+
+import "./DeployHelpers.s.sol";
+import "../contracts/TipJar.sol";
+
+/**
+ * @notice Deploys TipJar against Base USDC.
+ * @dev Works on Base (8453) and on a local fork of Base (`yarn fork --network base`, chain id 31337).
+ *      A plain `yarn chain` has no USDC at this address, so the script refuses to run there.
+ *
+ * yarn deploy --file DeployTipJar.s.sol                 # local Base fork
+ * yarn deploy --file DeployTipJar.s.sol --network base  # real Base (requires keystore)
+ */
+contract DeployTipJar is ScaffoldETHDeploy {
+    address constant BASE_USDC = 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913;
+
+    function run() external ScaffoldEthDeployerRunner {
+        require(BASE_USDC.code.length > 0, "Base USDC not found: run against Base or `yarn fork --network base`");
+        new TipJar(IERC20(BASE_USDC), deployer);
+    }
+}
