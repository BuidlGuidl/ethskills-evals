diff --git a/packages/foundry/scripts-sh/fund_usdc.sh b/packages/foundry/scripts-sh/fund_usdc.sh
new file mode 100755
index 0000000..3187269
--- /dev/null
+++ b/packages/foundry/scripts-sh/fund_usdc.sh
@@ -0,0 +1,34 @@
+#!/usr/bin/env bash
+# Moves real Base USDC from an existing holder to a demo account on the LOCAL fork.
+# Nothing is broadcast to Base: impersonation only exists inside anvil.
+#
+# Usage: yarn fund <address> [amountUsdc=1000]
+# Env:   RPC_URL (default http://127.0.0.1:8545), USDC_WHALE (default Morpho Blue on Base)
+set -euo pipefail
+
+TO="${1:?usage: yarn fund <address> [amountUsdc]}"
+AMOUNT="${2:-1000}"
+RPC_URL="${RPC_URL:-http://127.0.0.1:8545}"
+USDC=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
+WHALE="${USDC_WHALE:-0xBBBBBbbBBb9cC5e90e3b3Af64bdAF62C37EEFFCb}"
+
+if [ "$(cast chain-id --rpc-url "$RPC_URL")" != "31337" ]; then
+  echo "Refusing: $RPC_URL is not the local fork (chain id 31337)." >&2
+  exit 1
+fi
+if [ "$(cast code "$USDC" --rpc-url "$RPC_URL")" = "0x" ]; then
+  echo "No USDC at $USDC: start the chain with 'yarn fork --network base', not 'yarn chain'." >&2
+  exit 1
+fi
+
+cast rpc anvil_impersonateAccount "$WHALE" --rpc-url "$RPC_URL" > /dev/null
+# The whale may be a contract with no ETH for gas; give it some on the fork.
+cast rpc anvil_setBalance "$WHALE" 0x8ac7230489e80000 --rpc-url "$RPC_URL" > /dev/null
+cast send "$USDC" "transfer(address,uint256)" "$TO" "$(cast parse-units "$AMOUNT" 6)" \
+  --from "$WHALE" --unlocked --rpc-url "$RPC_URL" > /dev/null
+cast rpc anvil_stopImpersonatingAccount "$WHALE" --rpc-url "$RPC_URL" > /dev/null
+# Demo accounts need ETH for gas too.
+cast rpc anvil_setBalance "$TO" 0x8ac7230489e80000 --rpc-url "$RPC_URL" > /dev/null
+
+BALANCE=$(cast call "$USDC" "balanceOf(address)(uint256)" "$TO" --rpc-url "$RPC_URL" | cut -d' ' -f1)
+echo "Sent $AMOUNT USDC + 10 ETH to $TO. USDC balance now: $(cast format-units "$BALANCE" 6)"
diff --git a/packages/foundry/test/TipJar.t.sol b/packages/foundry/test/TipJar.t.sol
new file mode 100644
index 0000000..d25d8dd
--- /dev/null
+++ b/packages/foundry/test/TipJar.t.sol
@@ -0,0 +1,93 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import "forge-std/Test.sol";
+import { Ownable } from "@openzeppelin/contracts/access/Ownable.sol";
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { ERC20Mock } from "@openzeppelin/contracts/mocks/token/ERC20Mock.sol";
+import "../contracts/TipJar.sol";
+
+contract TipJarTest is Test {
+    ERC20Mock usdc;
+    TipJar jar;
+    address owner = makeAddr("owner");
+    address alice = makeAddr("alice");
+
+    function setUp() public {
+        usdc = new ERC20Mock();
+        jar = new TipJar(IERC20(address(usdc)), owner);
+        usdc.mint(alice, 100e6);
+    }
+
+    function test_Tip() public {
+        vm.startPrank(alice);
+        usdc.approve(address(jar), 5e6);
+        vm.expectEmit(address(jar));
+        emit TipJar.Tip(alice, 5e6, "gm");
+        jar.tip(5e6, "gm");
+        vm.stopPrank();
+
+        assertEq(usdc.balanceOf(address(jar)), 5e6);
+        assertEq(usdc.balanceOf(alice), 95e6);
+    }
+
+    function test_RevertWhen_ZeroAmount() public {
+        vm.prank(alice);
+        vm.expectRevert(TipJar.ZeroAmount.selector);
+        jar.tip(0, "");
+    }
+
+    function test_RevertWhen_MessageTooLong() public {
+        vm.prank(alice);
+        vm.expectRevert(TipJar.MessageTooLong.selector);
+        jar.tip(1e6, string(new bytes(281)));
+    }
+
+    function test_RevertWhen_NotApproved() public {
+        vm.prank(alice);
+        vm.expectRevert();
+        jar.tip(1e6, "");
+    }
+
+    function test_Withdraw() public {
+        vm.startPrank(alice);
+        usdc.approve(address(jar), 5e6);
+        jar.tip(5e6, "");
+        vm.stopPrank();
+
+        vm.prank(owner);
+        jar.withdraw(owner);
+        assertEq(usdc.balanceOf(owner), 5e6);
+        assertEq(usdc.balanceOf(address(jar)), 0);
+    }
+
+    function test_RevertWhen_WithdrawNotOwner() public {
+        vm.prank(alice);
+        vm.expectRevert(abi.encodeWithSelector(Ownable.OwnableUnauthorizedAccount.selector, alice));
+        jar.withdraw(alice);
+    }
+}
+
+/// @dev Runs against real Base USDC. Opt in with: FORK_TESTS=true forge test --match-contract Fork
+contract TipJarForkTest is Test {
+    IERC20 constant USDC = IERC20(0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913);
+    TipJar jar;
+    address alice = makeAddr("alice");
+
+    function setUp() public {
+        vm.skip(!vm.envOr("FORK_TESTS", false));
+        vm.createSelectFork(vm.rpcUrl("base"));
+        jar = new TipJar(USDC, address(this));
+        deal(address(USDC), alice, 10e6);
+    }
+
+    function test_TipWithRealUsdc() public {
+        vm.startPrank(alice);
+        USDC.approve(address(jar), 3e6);
+        jar.tip(3e6, "gm base");
+        vm.stopPrank();
+
+        assertEq(USDC.balanceOf(address(jar)), 3e6);
+        assertEq(USDC.balanceOf(alice), 7e6);
+    }
+}
