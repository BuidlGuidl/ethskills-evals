diff --git a/packages/foundry/scripts-js/fundUsdc.js b/packages/foundry/scripts-js/fundUsdc.js
new file mode 100644
index 0000000..786ae8b
--- /dev/null
+++ b/packages/foundry/scripts-js/fundUsdc.js
@@ -0,0 +1,67 @@
+// Moves real Base USDC to a test identity on the LOCAL fork by impersonating an existing holder.
+// Nothing is broadcast to Base: impersonation only exists inside Anvil.
+import { ethers } from "ethers";
+
+const RPC_URL = "http://127.0.0.1:8545";
+const USDC = "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913";
+// Uniswap v4 PoolManager on Base — holds millions of USDC. Override with USDC_WHALE if it ever runs dry.
+const WHALE =
+  process.env.USDC_WHALE || "0x498581fF718922c3f8e6A244956aF099B2652b2b";
+const ERC20_ABI = [
+  "function balanceOf(address) view returns (uint256)",
+  "function transfer(address,uint256) returns (bool)",
+];
+
+const [recipient, amountArg = "1000"] = process.argv.slice(2);
+if (!recipient || !ethers.utils.isAddress(recipient)) {
+  console.log("Usage: yarn fund-usdc <address> [amount=1000]");
+  process.exit(1);
+}
+
+const provider = new ethers.providers.JsonRpcProvider(RPC_URL);
+const { chainId } = await provider.getNetwork();
+if (chainId !== 31337) {
+  console.error(
+    `❌ Refusing to run: ${RPC_URL} is chain ${chainId}, expected local fork 31337.`
+  );
+  process.exit(1);
+}
+if ((await provider.getCode(USDC)) === "0x") {
+  console.error(
+    "❌ No USDC contract found. Start the Base fork with `yarn fork --network base`, not `yarn chain`."
+  );
+  process.exit(1);
+}
+
+const amount = ethers.utils.parseUnits(amountArg, 6);
+const usdc = new ethers.Contract(USDC, ERC20_ABI, provider);
+const whaleBalance = await usdc.balanceOf(WHALE);
+if (whaleBalance.lt(amount)) {
+  console.error(
+    `❌ Whale ${WHALE} only holds ${ethers.utils.formatUnits(
+      whaleBalance,
+      6
+    )} USDC. Set USDC_WHALE.`
+  );
+  process.exit(1);
+}
+
+await provider.send("anvil_impersonateAccount", [WHALE]);
+// Gas money for the impersonated sender (fork-only override)
+await provider.send("anvil_setBalance", [
+  WHALE,
+  ethers.utils.hexValue(ethers.utils.parseEther("1")),
+]);
+const tx = await usdc
+  .connect(provider.getUncheckedSigner(WHALE))
+  .transfer(recipient, amount);
+await tx.wait();
+await provider.send("anvil_stopImpersonatingAccount", [WHALE]);
+
+const balance = await usdc.balanceOf(recipient);
+console.log(
+  `✅ Sent ${amountArg} USDC to ${recipient}. Balance: ${ethers.utils.formatUnits(
+    balance,
+    6
+  )} USDC`
+);
diff --git a/packages/foundry/test/TipJar.t.sol b/packages/foundry/test/TipJar.t.sol
new file mode 100644
index 0000000..d4024ad
--- /dev/null
+++ b/packages/foundry/test/TipJar.t.sol
@@ -0,0 +1,62 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.19;
+
+import { Test } from "forge-std/Test.sol";
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { TipJar } from "../contracts/TipJar.sol";
+
+/// @dev Runs against real Base USDC on a fork. Set BASE_RPC_URL to run (skipped otherwise).
+contract TipJarTest is Test {
+    address constant BASE_USDC = 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913;
+
+    IERC20 usdc = IERC20(BASE_USDC);
+    TipJar tipJar;
+    address recipient = makeAddr("recipient");
+    address tipper = makeAddr("tipper");
+
+    function setUp() public {
+        string memory rpc = vm.envOr("BASE_RPC_URL", string(""));
+        vm.skip(bytes(rpc).length == 0);
+        vm.createSelectFork(rpc);
+
+        tipJar = new TipJar(BASE_USDC, recipient);
+        deal(BASE_USDC, tipper, 100e6);
+        vm.prank(tipper);
+        usdc.approve(address(tipJar), type(uint256).max);
+    }
+
+    function test_TipForwardsUsdcAndEmits() public {
+        vm.expectEmit(address(tipJar));
+        emit TipJar.Tip(tipper, 5e6, "gm");
+
+        vm.prank(tipper);
+        tipJar.tip(5e6, "gm");
+
+        assertEq(usdc.balanceOf(recipient), 5e6);
+        assertEq(usdc.balanceOf(tipper), 95e6);
+        assertEq(usdc.balanceOf(address(tipJar)), 0);
+        assertEq(tipJar.totalTipped(), 5e6);
+        assertEq(tipJar.tipCount(), 1);
+    }
+
+    function test_RevertZeroAmount() public {
+        vm.prank(tipper);
+        vm.expectRevert(TipJar.ZeroAmount.selector);
+        tipJar.tip(0, "");
+    }
+
+    function test_RevertMessageTooLong() public {
+        bytes memory long = new bytes(281);
+        vm.prank(tipper);
+        vm.expectRevert(TipJar.MessageTooLong.selector);
+        tipJar.tip(1e6, string(long));
+    }
+
+    function test_RevertWithoutApproval() public {
+        address stranger = makeAddr("stranger");
+        deal(BASE_USDC, stranger, 1e6);
+        vm.prank(stranger);
+        vm.expectRevert();
+        tipJar.tip(1e6, "");
+    }
+}
