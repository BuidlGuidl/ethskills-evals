--- /dev/null
+++ b/packages/foundry/script/DeployTipJar.s.sol
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import "./DeployHelpers.s.sol";
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import "../contracts/TipJar.sol";
+
+/**
+ * @notice Deploys TipJar against Base USDC.
+ * Local (31337, Base fork): recipient defaults to the deployer, override with TIP_RECIPIENT.
+ * Live networks: TIP_RECIPIENT is required.
+ */
+contract DeployTipJar is ScaffoldETHDeploy {
+    address constant BASE_USDC = 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913;
+
+    function run() external ScaffoldEthDeployerRunner {
+        require(BASE_USDC.code.length > 0, "Base USDC not found: run `yarn fork` (Base fork), not `yarn chain`");
+        require(block.chainid == 31337 || block.chainid == 8453, "TipJar targets Base (8453) or a local Base fork");
+
+        address recipient =
+            block.chainid == 31337 ? vm.envOr("TIP_RECIPIENT", deployer) : vm.envAddress("TIP_RECIPIENT");
+
+        TipJar tipJar = new TipJar(IERC20(BASE_USDC), recipient);
+        console.log("TipJar:", address(tipJar));
+        console.log("Recipient:", recipient);
+    }
+}
