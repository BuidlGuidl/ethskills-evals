diff --git a/packages/foundry/scripts-js/fundUsdc.js b/packages/foundry/scripts-js/fundUsdc.js
new file mode 100644
index 0000000..f940e3b
--- /dev/null
+++ b/packages/foundry/scripts-js/fundUsdc.js
@@ -0,0 +1,52 @@
+import { ethers } from "ethers";
+
+// Gives test identities USDC on the local Base fork (yarn fork:base). Never touches a live network.
+const BASE_USDC = "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913";
+const LOCAL_RPC = "http://127.0.0.1:8545";
+const USDC_ABI = ["function balanceOf(address) view returns (uint256)"];
+
+const [address, amount = "1000"] = process.argv.slice(2);
+
+if (!address || !ethers.utils.isAddress(address)) {
+  console.log("Usage: yarn fund-usdc <address> [amountUsdc=1000]");
+  process.exit(1);
+}
+
+const provider = new ethers.providers.JsonRpcProvider(LOCAL_RPC);
+
+const { chainId } = await provider.getNetwork();
+if (chainId !== 31337) {
+  console.error(
+    `❌ Refusing to run: ${LOCAL_RPC} is chain ${chainId}, expected local fork 31337`
+  );
+  process.exit(1);
+}
+if ((await provider.getCode(BASE_USDC)) === "0x") {
+  console.error(
+    "❌ Base USDC not found on the local chain. Start it with `yarn fork:base`, not `yarn chain`."
+  );
+  process.exit(1);
+}
+
+const usdc = new ethers.Contract(BASE_USDC, USDC_ABI, provider);
+const balance = (await usdc.balanceOf(address)).add(
+  ethers.utils.parseUnits(amount, 6)
+);
+
+// Sets the balance directly in the real USDC contract's storage on the fork
+await provider.send("anvil_dealERC20", [
+  address,
+  BASE_USDC,
+  balance.toHexString(),
+]);
+// Fresh identities also need gas money
+const minEth = ethers.utils.parseEther("1");
+if ((await provider.getBalance(address)).lt(minEth)) {
+  await provider.send("anvil_setBalance", [address, minEth.toHexString()]);
+}
+// Storage writes don't create a block; mine one so the frontend (which refetches per block) picks up the change
+await provider.send("evm_mine", []);
+
+const usdcBalance = ethers.utils.formatUnits(await usdc.balanceOf(address), 6);
+const ethBalance = ethers.utils.formatEther(await provider.getBalance(address));
+console.log(`✅ ${address}: ${usdcBalance} USDC, ${ethBalance} ETH`);
diff --git a/packages/foundry/test/TipJar.t.sol b/packages/foundry/test/TipJar.t.sol
new file mode 100644
index 0000000..81b1498
--- /dev/null
+++ b/packages/foundry/test/TipJar.t.sol
@@ -0,0 +1,103 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import "forge-std/Test.sol";
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { ERC20 } from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+import "../contracts/TipJar.sol";
+
+contract MockUSDC is ERC20("USD Coin", "USDC") {
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    function mint(address to, uint256 amount) external {
+        _mint(to, amount);
+    }
+}
+
+contract TipJarTest is Test {
+    MockUSDC usdc;
+    TipJar tipJar;
+    address recipient = makeAddr("recipient");
+    address alice = makeAddr("alice");
+
+    function setUp() public {
+        usdc = new MockUSDC();
+        tipJar = new TipJar(IERC20(address(usdc)), recipient);
+        usdc.mint(alice, 100e6);
+        vm.prank(alice);
+        usdc.approve(address(tipJar), type(uint256).max);
+    }
+
+    function testTipMovesUsdcToRecipient() public {
+        vm.expectEmit(address(tipJar));
+        emit TipJar.TipSent(alice, 5e6, "gm");
+        vm.prank(alice);
+        tipJar.tip(5e6, "gm");
+
+        assertEq(usdc.balanceOf(recipient), 5e6);
+        assertEq(usdc.balanceOf(alice), 95e6);
+        assertEq(usdc.balanceOf(address(tipJar)), 0);
+        assertEq(tipJar.totalTipped(), 5e6);
+        assertEq(tipJar.tipCount(), 1);
+    }
+
+    function testRecentTipsNewestFirst() public {
+        vm.startPrank(alice);
+        tipJar.tip(1e6, "first");
+        tipJar.tip(2e6, "second");
+        tipJar.tip(3e6, "third");
+        vm.stopPrank();
+
+        TipJar.Tip[] memory recent = tipJar.getRecentTips(2);
+        assertEq(recent.length, 2);
+        assertEq(recent[0].message, "third");
+        assertEq(recent[1].amount, 2e6);
+        assertEq(tipJar.getRecentTips(10).length, 3);
+    }
+
+    function testRevertsOnZeroAmount() public {
+        vm.prank(alice);
+        vm.expectRevert(TipJar.ZeroAmount.selector);
+        tipJar.tip(0, "");
+    }
+
+    function testRevertsOnLongMessage() public {
+        vm.prank(alice);
+        vm.expectRevert(TipJar.MessageTooLong.selector);
+        tipJar.tip(1e6, string(new bytes(281)));
+    }
+
+    function testRevertsWithoutAllowance() public {
+        address bob = makeAddr("bob");
+        usdc.mint(bob, 1e6);
+        vm.prank(bob);
+        vm.expectRevert();
+        tipJar.tip(1e6, "");
+    }
+}
+
+/// @notice Runs against real Base USDC. Skipped unless BASE_RPC_URL is set.
+contract TipJarBaseForkTest is Test {
+    IERC20 constant BASE_USDC = IERC20(0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913);
+
+    function testTipWithRealUsdc() public {
+        string memory rpc = vm.envOr("BASE_RPC_URL", string(""));
+        vm.skip(bytes(rpc).length == 0);
+        vm.createSelectFork(rpc);
+
+        address recipient = makeAddr("recipient");
+        address alice = makeAddr("alice");
+        TipJar tipJar = new TipJar(BASE_USDC, recipient);
+        deal(address(BASE_USDC), alice, 10e6);
+
+        vm.startPrank(alice);
+        BASE_USDC.approve(address(tipJar), 10e6);
+        tipJar.tip(10e6, "real usdc");
+        vm.stopPrank();
+
+        assertEq(BASE_USDC.balanceOf(recipient), 10e6);
+        assertEq(BASE_USDC.balanceOf(alice), 0);
+    }
+}
