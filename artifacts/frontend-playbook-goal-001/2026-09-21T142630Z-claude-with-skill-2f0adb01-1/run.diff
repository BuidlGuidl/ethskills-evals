diff --git a/packages/nextjs/polyfill-localstorage.cjs b/packages/nextjs/polyfill-localstorage.cjs
new file mode 100644
index 0000000..adfa518
--- /dev/null
+++ b/packages/nextjs/polyfill-localstorage.cjs
@@ -0,0 +1,16 @@
+// Node 25+ ships a global `localStorage` without the WebStorage methods, which breaks next-themes / RainbowKit
+// during SSR and static prerendering. Loaded via NODE_OPTIONS="--require ./polyfill-localstorage.cjs" (dev + IPFS build)
+// so it also runs inside Next's build worker processes.
+if (typeof globalThis.localStorage !== "undefined" && typeof globalThis.localStorage.getItem !== "function") {
+  const store = new Map();
+  globalThis.localStorage = {
+    getItem: key => store.get(key) ?? null,
+    setItem: (key, value) => store.set(key, String(value)),
+    removeItem: key => store.delete(key),
+    clear: () => store.clear(),
+    key: index => [...store.keys()][index] ?? null,
+    get length() {
+      return store.size;
+    },
+  };
+}
