diff --git a/packages/foundry/scripts-js/fund-usdc.sh b/packages/foundry/scripts-js/fund-usdc.sh
new file mode 100755
index 0000000..2578b83
--- /dev/null
+++ b/packages/foundry/scripts-js/fund-usdc.sh
@@ -0,0 +1,45 @@
+#!/usr/bin/env bash
+# Fund test identities with real Base USDC + gas ETH on the LOCAL Anvil fork.
+# Impersonates USDC's real masterMinter (only possible on a fork) and mints through the real FiatToken contract.
+#
+# Usage: yarn fund [address ...]        (defaults to Anvil accounts #0 and #1)
+# Env:   AMOUNT=1000 (whole USDC per address), RPC_URL=http://127.0.0.1:8545
+set -euo pipefail
+
+RPC_URL="${RPC_URL:-http://127.0.0.1:8545}"
+AMOUNT="${AMOUNT:-1000}"
+USDC=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
+DEFAULT_ACCOUNTS=(0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266 0x70997970C51812dc3A010C7d01b50e0d17dc79C8)
+
+# Refuse to touch anything that is not a local fork
+if [ "$(cast chain-id --rpc-url "$RPC_URL")" != "31337" ]; then
+  echo "❌ $RPC_URL is not the local fork (chain id 31337). Run 'yarn fork --network base' first." >&2
+  exit 1
+fi
+if [ "$(cast code $USDC --rpc-url "$RPC_URL")" = "0x" ]; then
+  echo "❌ No USDC at $USDC — the local chain is not a Base fork. Use 'yarn fork --network base', not 'yarn chain'." >&2
+  exit 1
+fi
+
+accounts=("$@")
+[ ${#accounts[@]} -eq 0 ] && accounts=("${DEFAULT_ACCOUNTS[@]}")
+units=$((AMOUNT * 1000000))
+
+master=$(cast call $USDC "masterMinter()(address)" --rpc-url "$RPC_URL")
+cast rpc anvil_impersonateAccount "$master" --rpc-url "$RPC_URL" >/dev/null
+cast rpc anvil_setBalance "$master" "$(cast to-hex "$(cast to-wei 1)")" --rpc-url "$RPC_URL" >/dev/null
+cast send $USDC "configureMinter(address,uint256)" "$master" $((units * ${#accounts[@]})) \
+  --from "$master" --unlocked --rpc-url "$RPC_URL" >/dev/null
+
+for account in "${accounts[@]}"; do
+  cast send $USDC "mint(address,uint256)" "$account" $units --from "$master" --unlocked --rpc-url "$RPC_URL" >/dev/null
+  # Top up gas money for fresh burner wallets
+  eth=$(cast balance "$account" --ether --rpc-url "$RPC_URL")
+  if awk "BEGIN { exit !($eth < 1) }"; then
+    cast rpc anvil_setBalance "$account" "$(cast to-hex "$(cast to-wei 10)")" --rpc-url "$RPC_URL" >/dev/null
+  fi
+  balance=$(cast call $USDC "balanceOf(address)(uint256)" "$account" --rpc-url "$RPC_URL" | cut -d' ' -f1)
+  echo "✅ $account: $(cast to-unit "$balance" 6) USDC"
+done
+
+cast rpc anvil_stopImpersonatingAccount "$master" --rpc-url "$RPC_URL" >/dev/null
diff --git a/packages/foundry/test/TipJar.t.sol b/packages/foundry/test/TipJar.t.sol
new file mode 100644
index 0000000..209e8ea
--- /dev/null
+++ b/packages/foundry/test/TipJar.t.sol
@@ -0,0 +1,114 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import { Test } from "forge-std/Test.sol";
+import { ERC20 } from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { IERC20Errors } from "@openzeppelin/contracts/interfaces/draft-IERC6093.sol";
+import { TipJar } from "../contracts/TipJar.sol";
+
+contract MockUSDC is ERC20("USD Coin", "USDC") {
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    function mint(address to, uint256 amount) external {
+        _mint(to, amount);
+    }
+}
+
+contract TipJarTest is Test {
+    MockUSDC usdc;
+    TipJar jar;
+    address recipient = makeAddr("recipient");
+    address alice = makeAddr("alice");
+
+    function setUp() public {
+        usdc = new MockUSDC();
+        jar = new TipJar(IERC20(address(usdc)), recipient);
+        usdc.mint(alice, 100e6);
+    }
+
+    function test_TipForwardsUsdcAndEmits() public {
+        vm.startPrank(alice);
+        usdc.approve(address(jar), 5e6);
+        vm.expectEmit(address(jar));
+        emit TipJar.Tip(alice, 5e6, "gm");
+        jar.tip(5e6, "gm");
+        vm.stopPrank();
+
+        assertEq(usdc.balanceOf(recipient), 5e6);
+        assertEq(usdc.balanceOf(alice), 95e6);
+        assertEq(usdc.balanceOf(address(jar)), 0);
+        assertEq(jar.totalTipped(), 5e6);
+    }
+
+    function test_RevertZeroAmount() public {
+        vm.prank(alice);
+        vm.expectRevert(TipJar.ZeroAmount.selector);
+        jar.tip(0, "");
+    }
+
+    function test_RevertMessageTooLong() public {
+        vm.prank(alice);
+        vm.expectRevert(TipJar.MessageTooLong.selector);
+        jar.tip(1, string(new bytes(281)));
+    }
+
+    function test_RevertWithoutApproval() public {
+        vm.prank(alice);
+        vm.expectRevert(abi.encodeWithSelector(IERC20Errors.ERC20InsufficientAllowance.selector, address(jar), 0, 1e6));
+        jar.tip(1e6, "");
+    }
+
+    function test_RevertZeroAddressConstructor() public {
+        vm.expectRevert(TipJar.ZeroAddress.selector);
+        new TipJar(IERC20(address(usdc)), address(0));
+    }
+
+    function testFuzz_Tip(uint256 amount) public {
+        amount = bound(amount, 1, 100e6);
+        vm.startPrank(alice);
+        usdc.approve(address(jar), amount);
+        jar.tip(amount, "fuzz");
+        vm.stopPrank();
+        assertEq(usdc.balanceOf(recipient), amount);
+        assertEq(jar.totalTipped(), amount);
+    }
+}
+
+interface IFiatToken {
+    function masterMinter() external view returns (address);
+    function configureMinter(address minter, uint256 allowance) external returns (bool);
+    function mint(address to, uint256 amount) external returns (bool);
+}
+
+/// @notice Runs against real Base USDC. Skipped unless BASE_FORK_URL is set:
+/// BASE_FORK_URL=https://base-mainnet.g.alchemy.com/v2/<key> forge test --mt test_Fork
+contract TipJarForkTest is Test {
+    address constant BASE_USDC = 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913;
+
+    function test_ForkTipWithRealUsdc() public {
+        string memory forkUrl = vm.envOr("BASE_FORK_URL", string(""));
+        if (bytes(forkUrl).length == 0) vm.skip(true);
+        vm.createSelectFork(forkUrl);
+
+        IERC20 usdc = IERC20(BASE_USDC);
+        address recipient = makeAddr("recipient");
+        address alice = makeAddr("alice");
+        TipJar jar = new TipJar(usdc, recipient);
+
+        // Mint real USDC the same way scripts/fund-usdc.sh does
+        vm.prank(IFiatToken(BASE_USDC).masterMinter());
+        IFiatToken(BASE_USDC).configureMinter(address(this), 10e6);
+        IFiatToken(BASE_USDC).mint(alice, 10e6);
+
+        vm.startPrank(alice);
+        usdc.approve(address(jar), 3e6);
+        jar.tip(3e6, "real usdc");
+        vm.stopPrank();
+
+        assertEq(usdc.balanceOf(recipient), 3e6);
+        assertEq(usdc.balanceOf(alice), 7e6);
+    }
+}
