@@ -0,0 +1,28 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.19;
+
+import "./DeployHelpers.s.sol";
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import "../contracts/TipJar.sol";
+
+/**
+ * @notice Deploys TipJar wired to Base USDC.
+ * Works on Base (8453) and on a local Anvil fork of Base (31337), where USDC lives at the same address.
+ * Tip recipient = `TIP_RECIPIENT` env var if set, else the deployer.
+ *
+ * yarn deploy --file DeployTipJar.s.sol                  # local Base fork
+ * yarn deploy --file DeployTipJar.s.sol --network base   # real Base (real gas!)
+ */
+contract DeployTipJar is ScaffoldETHDeploy {
+    address constant BASE_USDC = 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913;
+
+    error UsdcNotFound();
+
+    function run() external ScaffoldEthDeployerRunner {
+        // Catches deploying to a plain `yarn chain` (no fork) where USDC does not exist
+        if (BASE_USDC.code.length == 0) revert UsdcNotFound();
+
+        address recipient = vm.envOr("TIP_RECIPIENT", deployer);
+        new TipJar(IERC20(BASE_USDC), recipient);
+    }
+}
