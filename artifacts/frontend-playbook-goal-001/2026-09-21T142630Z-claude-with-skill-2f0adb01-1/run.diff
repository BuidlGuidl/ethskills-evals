index 0000000..fc58623
--- /dev/null
+++ b/packages/foundry/contracts/TipJar.sol
@@ -0,0 +1,38 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { SafeERC20 } from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+
+/// @notice Accepts USDC tips with a short message. Tips are forwarded straight to `recipient`; the jar never holds funds.
+contract TipJar {
+    using SafeERC20 for IERC20;
+
+    uint256 public constant MAX_MESSAGE_LENGTH = 280;
+
+    IERC20 public immutable usdc;
+    address public immutable recipient;
+    uint256 public totalTipped;
+
+    event Tip(address indexed tipper, uint256 amount, string message);
+
+    error ZeroAmount();
+    error ZeroAddress();
+    error MessageTooLong();
+
+    constructor(IERC20 _usdc, address _recipient) {
+        if (address(_usdc) == address(0) || _recipient == address(0)) revert ZeroAddress();
+        usdc = _usdc;
+        recipient = _recipient;
+    }
+
+    /// @param amount USDC amount in base units (6 decimals). Caller must approve this contract first.
+    function tip(uint256 amount, string calldata message) external {
+        if (amount == 0) revert ZeroAmount();
+        if (bytes(message).length > MAX_MESSAGE_LENGTH) revert MessageTooLong();
+
+        totalTipped += amount;
+        emit Tip(msg.sender, amount, message);
+        usdc.safeTransferFrom(msg.sender, recipient, amount);
+    }
+}
