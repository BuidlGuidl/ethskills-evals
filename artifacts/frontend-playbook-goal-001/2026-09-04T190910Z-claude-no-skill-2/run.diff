diff --git a/packages/nextjs/utils/usdc.ts b/packages/nextjs/utils/usdc.ts
new file mode 100644
index 0000000..fdb8ad3
--- /dev/null
+++ b/packages/nextjs/utils/usdc.ts
@@ -0,0 +1,24 @@
+import { formatUnits, parseUnits } from "viem";
+
+/** USDC uses 6 decimals on every chain Circle deploys it to. */
+export const USDC_DECIMALS = 6;
+
+/** Formats token units for display, e.g. 1500000n -> "1.50". */
+export const formatUsdc = (amount: bigint) =>
+  Number(formatUnits(amount, USDC_DECIMALS)).toLocaleString("en-US", {
+    minimumFractionDigits: 2,
+    maximumFractionDigits: USDC_DECIMALS,
+  });
+
+/** Parses an amount field into token units, or null when it is not a usable amount. */
+export const parseUsdc = (amount: string) => {
+  if (amount === "" || !/^\d*\.?\d{0,6}$/.test(amount)) return null;
+  try {
+    return parseUnits(amount, USDC_DECIMALS);
+  } catch {
+    return null;
+  }
+};
+
+/** Keeps the amount field to digits and at most 6 decimals, so what is typed always parses exactly. */
+export const isAllowedUsdcInput = (value: string) => /^\d*\.?\d{0,6}$/.test(value);

