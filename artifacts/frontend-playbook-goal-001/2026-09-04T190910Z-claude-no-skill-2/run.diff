--- /dev/null
+++ b/packages/foundry/contracts/TipJar.sol
@@ -0,0 +1,83 @@
+//SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { SafeERC20 } from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+import { Ownable } from "@openzeppelin/contracts/access/Ownable.sol";
+
+/**
+ * @notice A tip jar that collects USDC tips, each with a short public message.
+ * @dev Tips are pulled with `transferFrom`, so a tipper approves the jar before calling `tip`.
+ *      The token is fixed at construction so the jar can never be pointed at a different asset.
+ */
+contract TipJar is Ownable {
+    using SafeERC20 for IERC20;
+
+    /// @notice Longest message a tip can carry, in bytes (keeps calldata and the feed bounded).
+    uint256 public constant MAX_MESSAGE_BYTES = 140;
+
+    /// @notice The token tips are denominated in (USDC).
+    IERC20 public immutable token;
+
+    /// @notice Total amount ever tipped, in token units (USDC has 6 decimals).
+    uint256 public totalTipped;
+
+    /// @notice Number of tips ever received.
+    uint256 public tipCount;
+
+    /// @notice Total ever tipped per address.
+    mapping(address tipper => uint256 total) public tippedBy;
+
+    event Tipped(address indexed from, uint256 amount, string message);
+    event Withdrawn(address indexed to, uint256 amount);
+
+    error AmountIsZero();
+    error OwnershipCannotBeRenounced();
+    error MessageTooLong(uint256 length, uint256 maxLength);
+    error NothingToWithdraw();
+
+    constructor(IERC20 _token, address initialOwner) Ownable(initialOwner) {
+        token = _token;
+    }
+
+    /**
+     * @notice Send a tip to the jar. The caller must have approved at least `amount` first.
+     * @param amount Amount of token units to tip (1 USDC = 1_000_000).
+     * @param message Public message shown in the tip feed. May be empty.
+     */
+    function tip(uint256 amount, string calldata message) external {
+        if (amount == 0) revert AmountIsZero();
+        uint256 messageLength = bytes(message).length;
+        if (messageLength > MAX_MESSAGE_BYTES) revert MessageTooLong(messageLength, MAX_MESSAGE_BYTES);
+
+        totalTipped += amount;
+        tipCount += 1;
+        tippedBy[msg.sender] += amount;
+
+        token.safeTransferFrom(msg.sender, address(this), amount);
+
+        emit Tipped(msg.sender, amount, message);
+    }
+
+    /// @notice Move the jar's whole balance to `to`.
+    function withdraw(address to) external onlyOwner {
+        uint256 amount = balance();
+        if (amount == 0) revert NothingToWithdraw();
+
+        token.safeTransfer(to, amount);
+
+        emit Withdrawn(to, amount);
+    }
+
+    /// @notice The jar's token balance: everything tipped and not yet withdrawn, plus anything
+    ///         transferred straight to the jar (which never shows up in `totalTipped`).
+    function balance() public view returns (uint256) {
+        return token.balanceOf(address(this));
+    }
+
+    /// @dev `withdraw` is the only way tips leave the jar, so giving up ownership would strand
+    ///      every tip in it forever.
+    function renounceOwnership() public pure override {
+        revert OwnershipCannotBeRenounced();
+    }
+}
