diff --git a/packages/foundry/scripts-js/fundUsdc.js b/packages/foundry/scripts-js/fundUsdc.js
new file mode 100644
index 0000000..2e93433
--- /dev/null
+++ b/packages/foundry/scripts-js/fundUsdc.js
@@ -0,0 +1,162 @@
+/**
+ * Hands out real Base USDC to test identities on a local anvil fork of Base.
+ *
+ * It impersonates USDC's own master minter (read live from the forked state), authorises a
+ * throwaway minter and mints. The token contract, its rules and its accounting are the real ones;
+ * only the chain is local, so no real money moves.
+ *
+ * Usage:
+ *   yarn fund                          # 1000 USDC to the first 3 anvil accounts
+ *   yarn fund 0xYourBurnerAddress      # ...plus the address you pass (repeatable)
+ *   yarn fund --amount 25 0xabc...     # custom amount per recipient
+ *   RPC_URL=http://127.0.0.1:8546 yarn fund
+ */
+import { ethers } from "ethers";
+
+const USDC_ADDRESS = "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913";
+const USDC_DECIMALS = 6;
+const LOCAL_CHAIN_ID = 31337;
+const DEFAULT_AMOUNT = "1000";
+const DEFAULT_RECIPIENT_COUNT = 3;
+const MIN_GAS_ETH = "0.05";
+const TOP_UP_ETH = "10";
+
+const USDC_ABI = [
+  "function symbol() view returns (string)",
+  "function decimals() view returns (uint8)",
+  "function balanceOf(address) view returns (uint256)",
+  "function masterMinter() view returns (address)",
+  "function paused() view returns (bool)",
+  "function configureMinter(address minter, uint256 minterAllowedAmount) returns (bool)",
+  "function mint(address to, uint256 amount) returns (bool)",
+];
+
+function fail(message) {
+  console.error(`\n❌ ${message}\n`);
+  process.exit(1);
+}
+
+function parseArgs(argv) {
+  const recipients = [];
+  let amount = DEFAULT_AMOUNT;
+
+  for (let i = 0; i < argv.length; i++) {
+    const arg = argv[i];
+    if (arg === "--amount" || arg === "-a") {
+      amount = argv[++i];
+      if (!amount) fail("`--amount` needs a value, e.g. `--amount 25`.");
+    } else if (arg === "--help" || arg === "-h") {
+      console.log("Usage: yarn fund [--amount <usdc>] [0xaddress ...]");
+      process.exit(0);
+    } else if (ethers.utils.isAddress(arg)) {
+      recipients.push(ethers.utils.getAddress(arg));
+    } else {
+      fail(`Not an address or known flag: '${arg}'. Run \`yarn fund --help\`.`);
+    }
+  }
+
+  return { recipients, amount };
+}
+
+async function assertLocalBaseFork(provider) {
+  let network;
+  try {
+    network = await provider.getNetwork();
+  } catch {
+    fail(`No JSON-RPC node at ${provider.connection.url}. Start one with \`yarn fork:base\`.`);
+  }
+
+  if (network.chainId !== LOCAL_CHAIN_ID) {
+    fail(
+      `Refusing to run: connected to chain ${network.chainId}, expected the local fork (${LOCAL_CHAIN_ID}).\n` +
+        "   This script only ever runs against a local anvil fork — never a live network."
+    );
+  }
+
+  let nodeInfo;
+  try {
+    nodeInfo = await provider.send("anvil_nodeInfo", []);
+  } catch {
+    fail("Refusing to run: the node does not speak anvil's RPC methods, so it is not a local anvil fork.");
+  }
+
+  const forkUrl = nodeInfo?.forkConfig?.forkUrl;
+  if (!forkUrl) {
+    fail(
+      "The local anvil node is not forking anything, so there is no USDC to hand out.\n" +
+        "   Restart it with `yarn fork:base`."
+    );
+  }
+
+  if ((await provider.getCode(USDC_ADDRESS)) === "0x") {
+    fail(
+      `No USDC code at ${USDC_ADDRESS} on this fork (forking ${forkUrl}).\n` +
+        "   Restart the node with `yarn fork:base` so it forks Base."
+    );
+  }
+
+  return { forkUrl, blockNumber: await provider.getBlockNumber() };
+}
+
+async function main() {
+  const rpcUrl = process.env.RPC_URL || "http://127.0.0.1:8545";
+  const { recipients: extraRecipients, amount } = parseArgs(process.argv.slice(2));
+  const provider = new ethers.providers.JsonRpcProvider(rpcUrl);
+
+  const { forkUrl, blockNumber } = await assertLocalBaseFork(provider);
+  console.log(`\n🍴 Local anvil fork of ${forkUrl} at block ${blockNumber} (chain ${LOCAL_CHAIN_ID})`);
+
+  const usdc = new ethers.Contract(USDC_ADDRESS, USDC_ABI, provider);
+  if (await usdc.paused()) fail("USDC is paused on the forked state, so minting is not possible.");
+
+  const anvilAccounts = await provider.listAccounts();
+  if (anvilAccounts.length === 0) fail("The anvil node exposes no unlocked accounts.");
+
+  const recipients = [...new Set([...anvilAccounts.slice(0, DEFAULT_RECIPIENT_COUNT), ...extraRecipients])];
+  let amountPerRecipient;
+  try {
+    amountPerRecipient = ethers.utils.parseUnits(amount, USDC_DECIMALS);
+  } catch {
+    fail(`'${amount}' is not a valid USDC amount.`);
+  }
+  if (amountPerRecipient.isZero()) fail("Amount must be greater than zero.");
+
+  // USDC only lets the master minter authorise minters. On a fork we can simply be them.
+  const masterMinter = await usdc.masterMinter();
+  const minter = anvilAccounts[0];
+  const totalAllowance = amountPerRecipient.mul(recipients.length);
+
+  console.log(`👑 USDC master minter: ${masterMinter} (impersonated)`);
+  await provider.send("anvil_setBalance", [masterMinter, ethers.utils.parseEther(TOP_UP_ETH).toHexString()]);
+  await provider.send("anvil_impersonateAccount", [masterMinter]);
+  try {
+    const tx = await usdc.connect(provider.getSigner(masterMinter)).configureMinter(minter, totalAllowance);
+    await tx.wait();
+  } finally {
+    await provider.send("anvil_stopImpersonatingAccount", [masterMinter]);
+  }
+  console.log(`🔑 Authorised ${minter} to mint ${ethers.utils.formatUnits(totalAllowance, USDC_DECIMALS)} USDC`);
+
+  const minterUsdc = usdc.connect(provider.getSigner(minter));
+  for (const recipient of recipients) {
+    const tx = await minterUsdc.mint(recipient, amountPerRecipient);
+    await tx.wait();
+
+    // Browser burner wallets start with no ETH, so make sure everyone can pay for gas.
+    if ((await provider.getBalance(recipient)).lt(ethers.utils.parseEther(MIN_GAS_ETH))) {
+      await provider.send("anvil_setBalance", [recipient, ethers.utils.parseEther(TOP_UP_ETH).toHexString()]);
+    }
+  }
+
+  console.log(`\n💸 Funded ${recipients.length} address(es) with ${amount} USDC each:\n`);
+  for (const recipient of recipients) {
+    const usdcBalance = ethers.utils.formatUnits(await usdc.balanceOf(recipient), USDC_DECIMALS);
+    const ethBalance = ethers.utils.formatEther(await provider.getBalance(recipient));
+    console.log(`   ${recipient}  ${usdcBalance.padStart(12)} USDC  ${Number(ethBalance).toFixed(2).padStart(10)} ETH`);
+  }
+  console.log("");
+}
+
+main().catch(error => {
+  fail(error.reason || error.message || error);
+});
diff --git a/packages/foundry/test/TipJar.t.sol b/packages/foundry/test/TipJar.t.sol
new file mode 100644
index 0000000..25fc594
--- /dev/null
+++ b/packages/foundry/test/TipJar.t.sol
@@ -0,0 +1,179 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import { Test } from "forge-std/Test.sol";
+import { ERC20 } from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { Ownable } from "@openzeppelin/contracts/access/Ownable.sol";
+import { TipJar } from "../contracts/TipJar.sol";
+
+/// @dev Stand-in for USDC: 6 decimals, open mint.
+contract MockUSDC is ERC20 {
+    constructor() ERC20("USD Coin", "USDC") { }
+
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    function mint(address to, uint256 amount) external {
+        _mint(to, amount);
+    }
+}
+
+contract TipJarTest is Test {
+    MockUSDC internal usdc;
+    TipJar internal jar;
+
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+    address internal bob = makeAddr("bob");
+
+    uint256 internal constant ONE_USDC = 1e6;
+
+    event Tipped(address indexed from, uint256 amount, string message);
+    event Withdrawn(address indexed to, uint256 amount);
+
+    function setUp() public {
+        usdc = new MockUSDC();
+        jar = new TipJar(IERC20(address(usdc)), owner);
+
+        usdc.mint(alice, 100 * ONE_USDC);
+        usdc.mint(bob, 100 * ONE_USDC);
+    }
+
+    function test_ConstructorSetsTokenAndOwner() public view {
+        assertEq(address(jar.token()), address(usdc));
+        assertEq(jar.owner(), owner);
+    }
+
+    function test_TipMovesTokensAndRecordsTotals() public {
+        vm.startPrank(alice);
+        usdc.approve(address(jar), 5 * ONE_USDC);
+
+        vm.expectEmit(true, false, false, true, address(jar));
+        emit Tipped(alice, 5 * ONE_USDC, "thanks!");
+        jar.tip(5 * ONE_USDC, "thanks!");
+        vm.stopPrank();
+
+        assertEq(jar.balance(), 5 * ONE_USDC);
+        assertEq(usdc.balanceOf(alice), 95 * ONE_USDC);
+        assertEq(jar.totalTipped(), 5 * ONE_USDC);
+        assertEq(jar.tipCount(), 1);
+        assertEq(jar.tippedBy(alice), 5 * ONE_USDC);
+    }
+
+    function test_TipAccumulatesAcrossTippers() public {
+        _tip(alice, 5 * ONE_USDC, "one");
+        _tip(alice, 2 * ONE_USDC, "two");
+        _tip(bob, 3 * ONE_USDC, "three");
+
+        assertEq(jar.totalTipped(), 10 * ONE_USDC);
+        assertEq(jar.tipCount(), 3);
+        assertEq(jar.tippedBy(alice), 7 * ONE_USDC);
+        assertEq(jar.tippedBy(bob), 3 * ONE_USDC);
+    }
+
+    function test_TipAcceptsEmptyMessage() public {
+        _tip(alice, ONE_USDC, "");
+        assertEq(jar.tipCount(), 1);
+    }
+
+    function test_RevertWhen_TipIsZero() public {
+        vm.prank(alice);
+        vm.expectRevert(TipJar.AmountIsZero.selector);
+        jar.tip(0, "nothing");
+    }
+
+    function test_RevertWhen_MessageTooLong() public {
+        string memory tooLong = _repeat("a", jar.MAX_MESSAGE_BYTES() + 1);
+
+        vm.startPrank(alice);
+        usdc.approve(address(jar), ONE_USDC);
+        vm.expectRevert(
+            abi.encodeWithSelector(TipJar.MessageTooLong.selector, jar.MAX_MESSAGE_BYTES() + 1, jar.MAX_MESSAGE_BYTES())
+        );
+        jar.tip(ONE_USDC, tooLong);
+        vm.stopPrank();
+    }
+
+    function test_TipAcceptsMessageAtMaxLength() public {
+        string memory maxMessage = _repeat("a", jar.MAX_MESSAGE_BYTES());
+
+        vm.startPrank(alice);
+        usdc.approve(address(jar), ONE_USDC);
+        jar.tip(ONE_USDC, maxMessage);
+        vm.stopPrank();
+
+        assertEq(jar.tipCount(), 1);
+    }
+
+    function test_RevertWhen_TipWithoutApproval() public {
+        vm.prank(alice);
+        vm.expectRevert();
+        jar.tip(ONE_USDC, "no approval");
+    }
+
+    function test_WithdrawSendsWholeBalance() public {
+        _tip(alice, 5 * ONE_USDC, "thanks!");
+
+        vm.expectEmit(true, false, false, true, address(jar));
+        emit Withdrawn(owner, 5 * ONE_USDC);
+        vm.prank(owner);
+        jar.withdraw(owner);
+
+        assertEq(usdc.balanceOf(owner), 5 * ONE_USDC);
+        assertEq(jar.balance(), 0);
+        // Withdrawing does not rewrite history.
+        assertEq(jar.totalTipped(), 5 * ONE_USDC);
+    }
+
+    function test_RevertWhen_WithdrawCalledByNonOwner() public {
+        _tip(alice, ONE_USDC, "thanks!");
+
+        vm.prank(alice);
+        vm.expectRevert(abi.encodeWithSelector(Ownable.OwnableUnauthorizedAccount.selector, alice));
+        jar.withdraw(alice);
+    }
+
+    function test_RevertWhen_RenouncingOwnership() public {
+        _tip(alice, ONE_USDC, "thanks!");
+
+        vm.prank(owner);
+        vm.expectRevert(TipJar.OwnershipCannotBeRenounced.selector);
+        jar.renounceOwnership();
+
+        // The jar is still emptiable.
+        vm.prank(owner);
+        jar.withdraw(owner);
+        assertEq(usdc.balanceOf(owner), ONE_USDC);
+    }
+
+    function test_RevertWhen_WithdrawFromEmptyJar() public {
+        vm.prank(owner);
+        vm.expectRevert(TipJar.NothingToWithdraw.selector);
+        jar.withdraw(owner);
+    }
+
+    function testFuzz_TipRecordsAnyNonZeroAmount(uint96 amount) public {
+        amount = uint96(bound(amount, 1, 100 * ONE_USDC));
+        _tip(alice, amount, "fuzz");
+
+        assertEq(jar.totalTipped(), amount);
+        assertEq(jar.balance(), amount);
+    }
+
+    function _tip(address from, uint256 amount, string memory message) internal {
+        vm.startPrank(from);
+        usdc.approve(address(jar), amount);
+        jar.tip(amount, message);
+        vm.stopPrank();
+    }
+
+    function _repeat(bytes1 char, uint256 length) internal pure returns (string memory) {
+        bytes memory out = new bytes(length);
+        for (uint256 i = 0; i < length; i++) {
+            out[i] = char;
+        }
+        return string(out);
+    }
+}
diff --git a/packages/foundry/test/TipJarBaseFork.t.sol b/packages/foundry/test/TipJarBaseFork.t.sol
new file mode 100644
index 0000000..30f9a76
--- /dev/null
+++ b/packages/foundry/test/TipJarBaseFork.t.sol
@@ -0,0 +1,85 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import { Test } from "forge-std/Test.sol";
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { TipJar } from "../contracts/TipJar.sol";
+
+/// @dev The bits of Circle's FiatToken we need to hand out test USDC on a fork.
+interface IFiatToken {
+    function masterMinter() external view returns (address);
+    function configureMinter(address minter, uint256 minterAllowedAmount) external returns (bool);
+    function mint(address to, uint256 amount) external returns (bool);
+}
+
+/**
+ * @notice Runs the jar against the real USDC contract on a Base fork.
+ * @dev This is the same trick `yarn fund` uses: impersonate USDC's master minter, authorise a
+ *      throwaway minter, and mint. Nothing here touches Base itself — it needs network access to
+ *      read Base state (`base` in foundry.toml resolves to https://mainnet.base.org).
+ */
+contract TipJarBaseForkTest is Test {
+    address internal constant BASE_USDC = 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913;
+    uint256 internal constant ONE_USDC = 1e6;
+
+    IFiatToken internal usdc = IFiatToken(BASE_USDC);
+    TipJar internal jar;
+
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+
+    function setUp() public {
+        vm.createSelectFork(vm.rpcUrl("base"));
+        jar = new TipJar(IERC20(BASE_USDC), owner);
+    }
+
+    function test_ForkUsesRealUsdc() public view {
+        assertEq(BASE_USDC.code.length > 0, true, "no USDC code on the fork");
+        assertEq(IERC20Metadata(BASE_USDC).symbol(), "USDC");
+        assertEq(IERC20Metadata(BASE_USDC).decimals(), 6);
+    }
+
+    function test_TipAndWithdrawWithRealUsdc() public {
+        _mintUsdc(alice, 100 * ONE_USDC);
+
+        vm.startPrank(alice);
+        IERC20(BASE_USDC).approve(address(jar), 25 * ONE_USDC);
+        jar.tip(25 * ONE_USDC, "gm from a Base fork");
+        vm.stopPrank();
+
+        assertEq(jar.balance(), 25 * ONE_USDC);
+        assertEq(jar.totalTipped(), 25 * ONE_USDC);
+        assertEq(IERC20(BASE_USDC).balanceOf(alice), 75 * ONE_USDC);
+
+        vm.prank(owner);
+        jar.withdraw(owner);
+
+        assertEq(IERC20(BASE_USDC).balanceOf(owner), 25 * ONE_USDC);
+        assertEq(jar.balance(), 0);
+    }
+
+    function test_RevertWhen_TipExceedsApproval() public {
+        _mintUsdc(alice, 10 * ONE_USDC);
+
+        vm.startPrank(alice);
+        IERC20(BASE_USDC).approve(address(jar), ONE_USDC);
+        vm.expectRevert();
+        jar.tip(2 * ONE_USDC, "too much");
+        vm.stopPrank();
+    }
+
+    function _mintUsdc(address to, uint256 amount) internal {
+        address minter = makeAddr("minter");
+
+        vm.prank(usdc.masterMinter());
+        usdc.configureMinter(minter, amount);
+
+        vm.prank(minter);
+        usdc.mint(to, amount);
+    }
+}
+
+interface IERC20Metadata {
+    function symbol() external view returns (string memory);
+    function decimals() external view returns (uint8);
+}
