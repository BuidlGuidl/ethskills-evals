+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import "./DeployHelpers.s.sol";
+import { TipJar } from "../contracts/TipJar.sol";
+
+/**
+ * @notice Deploy script for the USDC TipJar
+ * @dev The jar is pinned to Circle's native USDC on Base. That same address holds real USDC code on
+ *      an anvil fork of Base, which is where we develop and demo, so one constant covers both.
+ * Example:
+ * yarn deploy --file DeployTipJar.s.sol            # local anvil fork of Base (see README)
+ * yarn deploy --file DeployTipJar.s.sol --network base
+ */
+contract DeployTipJar is ScaffoldETHDeploy {
+    /// @dev Circle's native USDC on Base (https://basescan.org/token/0x833589fcd6edb6e08f4c7c32d4f71b54bda02913)
+    address public constant BASE_USDC = 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913;
+
+    function run() external ScaffoldEthDeployerRunner {
+        require(
+            BASE_USDC.code.length != 0,
+            "No USDC at 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913 on this chain. Run `yarn fork:base` for a local Base fork, or deploy with `--network base`."
+        );
+
+        new TipJar(IERC20(BASE_USDC), deployer);
+    }
+}
