@@ -0,0 +1,81 @@
+"use client";
+
+import { Address } from "@scaffold-ui/components";
+import { useAccount } from "wagmi";
+import {
+  useDeployedContractInfo,
+  useScaffoldReadContract,
+  useScaffoldWriteContract,
+  useTargetNetwork,
+} from "~~/hooks/scaffold-eth";
+import { formatUsdc } from "~~/utils/usdc";
+
+const Stat = ({ label, value }: { label: string; value: string }) => (
+  <div className="flex flex-col items-center px-6 py-2">
+    <span className="text-xs uppercase tracking-wide opacity-60">{label}</span>
+    <span className="text-2xl font-bold">{value}</span>
+  </div>
+);
+
+export const JarSummary = () => {
+  const { address: connectedAddress } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+  const { data: tipJar, isLoading: isLoadingJar } = useDeployedContractInfo({ contractName: "TipJar" });
+
+  const { data: totalTipped } = useScaffoldReadContract({ contractName: "TipJar", functionName: "totalTipped" });
+  const { data: tipCount } = useScaffoldReadContract({ contractName: "TipJar", functionName: "tipCount" });
+  const { data: jarBalance } = useScaffoldReadContract({ contractName: "TipJar", functionName: "balance" });
+  // Ownership changes are rare; no need to re-read it on every block like the tip counters.
+  const { data: owner } = useScaffoldReadContract({ contractName: "TipJar", functionName: "owner", watch: false });
+
+  const { writeContractAsync: writeTipJar, isMining } = useScaffoldWriteContract({ contractName: "TipJar" });
+
+  const isOwner = Boolean(connectedAddress && owner && connectedAddress.toLowerCase() === owner.toLowerCase());
+
+  const withdraw = async () => {
+    if (!owner) return;
+    try {
+      await writeTipJar({ functionName: "withdraw", args: [owner] });
+    } catch (error) {
+      console.error("Failed to withdraw", error);
+    }
+  };
+
+  // Also covers a stale address, e.g. after the local fork was restarted without redeploying.
+  if (!isLoadingJar && !tipJar) {
+    return (
+      <div className="alert alert-warning">
+        <span>
+          No TipJar found on {targetNetwork.name}. Deploy it there (see README.md for local, DEPLOY.md for Base) — the
+          frontend reads the address from <code>contracts/deployedContracts.ts</code>.
+        </span>
+      </div>
+    );
+  }
+
+  return (
+    <div className="card bg-base-100 shadow-xl w-full">
+      <div className="card-body items-center gap-4">
+        <div className="flex flex-wrap justify-center divide-x divide-base-300">
+          <Stat label="Tipped so far" value={`${formatUsdc(totalTipped ?? 0n)} USDC`} />
+          <Stat label="Tips" value={(tipCount ?? 0n).toString()} />
+          <Stat label="In the jar" value={`${formatUsdc(jarBalance ?? 0n)} USDC`} />
+        </div>
+
+        <div className="flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-sm">
+          <span className="opacity-60">Jar</span>
+          <Address address={tipJar?.address} size="sm" chain={targetNetwork} />
+          <span className="opacity-60">pays out to</span>
+          <Address address={owner} size="sm" chain={targetNetwork} />
+        </div>
+
+        {isOwner && (
+          <button className="btn btn-secondary btn-sm" disabled={isMining || !jarBalance} onClick={withdraw}>
+            {isMining && <span className="loading loading-spinner loading-xs" />}
+            Withdraw {formatUsdc(jarBalance ?? 0n)} USDC
+          </button>
+        )}
+      </div>
+    </div>
+  );
+};
diff --git a/packages/nextjs/app/_components/TipFeed.tsx b/packages/nextjs/app/_components/TipFeed.tsx
new file mode 100644
index 0000000..bdea307
--- /dev/null
+++ b/packages/nextjs/app/_components/TipFeed.tsx
@@ -0,0 +1,64 @@
+"use client";
+
+import { Address } from "@scaffold-ui/components";
+import { useScaffoldEventHistory, useTargetNetwork } from "~~/hooks/scaffold-eth";
+import { formatUsdc } from "~~/utils/usdc";
+
+/**
+ * `blockData: true` makes the hook fetch the block for every log, but its return type only exposes
+ * that on the array rather than on each event, so read it back here.
+ */
+const tipTime = (tip: object) => {
+  const timestamp = (tip as { blockData?: { timestamp: bigint } }).blockData?.timestamp;
+  return timestamp === undefined
+    ? ""
+    : new Date(Number(timestamp) * 1000).toLocaleString("en-US", { dateStyle: "medium", timeStyle: "short" });
+};
+
+export const TipFeed = () => {
+  const { targetNetwork } = useTargetNetwork();
+  const {
+    data: tips,
+    isLoading,
+    error,
+  } = useScaffoldEventHistory({
+    contractName: "TipJar",
+    eventName: "Tipped",
+    watch: true,
+    blockData: true,
+  });
+
+  return (
+    <div className="card bg-base-100 shadow-xl w-full">
+      <div className="card-body gap-4">
+        <h2 className="card-title">Tip feed</h2>
+
+        {isLoading && <span className="loading loading-spinner self-center" />}
+
+        {error && !isLoading && <div className="alert alert-error text-sm">Could not load tips: {error.message}</div>}
+
+        {!isLoading && !error && tips?.length === 0 && (
+          <p className="opacity-70 my-0">No tips yet. Be the first one.</p>
+        )}
+
+        <ul className="list-none flex flex-col gap-3 p-0 m-0 max-h-[28rem] overflow-y-auto">
+          {tips?.map(tip => (
+            <li
+              key={`${tip.transactionHash}-${tip.logIndex}`}
+              className="flex flex-col gap-1 border border-base-300 rounded-2xl px-4 py-3"
+            >
+              <div className="flex items-center justify-between gap-2 flex-wrap">
+                <Address address={tip.args.from} size="sm" chain={targetNetwork} />
+                <span className="badge badge-primary badge-lg whitespace-nowrap">
+                  {formatUsdc(tip.args.amount ?? 0n)} USDC
+                </span>
+              </div>
+              {tip.args.message && <p className="m-0 break-words">{tip.args.message}</p>}
+              <span className="text-xs opacity-60">{tipTime(tip)}</span>
+            </li>
+          ))}
+        </ul>
+      </div>
+    </div>
+  );
+};
diff --git a/packages/nextjs/app/_components/TipForm.tsx b/packages/nextjs/app/_components/TipForm.tsx
new file mode 100644
index 0000000..992cae9
--- /dev/null
+++ b/packages/nextjs/app/_components/TipForm.tsx
@@ -0,0 +1,151 @@
+"use client";
+
+import { useState } from "react";
+import { BaseInput } from "@scaffold-ui/components";
+import { useAccount } from "wagmi";
+import {
+  useDeployedContractInfo,
+  useScaffoldReadContract,
+  useScaffoldWriteContract,
+  useTargetNetwork,
+} from "~~/hooks/scaffold-eth";
+import { formatUsdc, isAllowedUsdcInput, parseUsdc } from "~~/utils/usdc";
+
+const DEFAULT_MAX_MESSAGE_BYTES = 140n;
+
+export const TipForm = () => {
+  const [amount, setAmount] = useState("");
+  const [message, setMessage] = useState("");
+
+  const { address: connectedAddress } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+  const { data: tipJar } = useDeployedContractInfo({ contractName: "TipJar" });
+
+  const { data: usdcBalance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "balanceOf",
+    args: [connectedAddress],
+  });
+  const { data: allowance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "allowance",
+    args: [connectedAddress, tipJar?.address],
+  });
+  const { data: maxMessageBytes } = useScaffoldReadContract({
+    contractName: "TipJar",
+    functionName: "MAX_MESSAGE_BYTES",
+    watch: false,
+  });
+
+  const { writeContractAsync: writeUsdc, isMining: isApproving } = useScaffoldWriteContract({ contractName: "USDC" });
+  const { writeContractAsync: writeTipJar, isMining: isTipping } = useScaffoldWriteContract({ contractName: "TipJar" });
+
+  const parsedAmount = parseUsdc(amount);
+  const messageBytes = new TextEncoder().encode(message).length;
+  const messageLimit = Number(maxMessageBytes ?? DEFAULT_MAX_MESSAGE_BYTES);
+  // Until both reads land we cannot tell approval or balance apart from "fine", so treat it as not ready.
+  const isReady = usdcBalance !== undefined && allowance !== undefined;
+  const needsApproval = isReady && parsedAmount !== null && allowance < parsedAmount;
+  const isBroke = isReady && parsedAmount !== null && usdcBalance < parsedAmount;
+  const isBusy = isApproving || isTipping;
+
+  const approve = async () => {
+    if (!tipJar || parsedAmount === null) return;
+    try {
+      await writeUsdc({ functionName: "approve", args: [tipJar.address, parsedAmount] });
+    } catch (error) {
+      console.error("Failed to approve USDC", error);
+    }
+  };
+
+  const sendTip = async () => {
+    if (parsedAmount === null) return;
+    try {
+      // Returns undefined when the write never went out (wrong network, no wallet, jar not deployed);
+      // useScaffoldWriteContract has already explained why, so only clear the form on a real send.
+      const txHash = await writeTipJar({ functionName: "tip", args: [parsedAmount, message] });
+      if (!txHash) return;
+      setAmount("");
+      setMessage("");
+    } catch (error) {
+      console.error("Failed to send tip", error);
+    }
+  };
+
+  const buttonLabel = () => {
+    if (!connectedAddress) return "Connect a wallet to tip";
+    if (parsedAmount === null || parsedAmount === 0n) return "Enter an amount";
+    if (!isReady) return "Checking your USDC...";
+    if (isBroke) return "Not enough USDC";
+    if (messageBytes > messageLimit) return "Message too long";
+    if (needsApproval) return `Approve ${amount} USDC`;
+    return `Tip ${amount} USDC`;
+  };
+
+  const isDisabled =
+    !connectedAddress ||
+    !isReady ||
+    parsedAmount === null ||
+    parsedAmount === 0n ||
+    isBroke ||
+    messageBytes > messageLimit ||
+    isBusy;
+
+  return (
+    <div className="card bg-base-100 shadow-xl w-full">
+      <div className="card-body gap-4">
+        <h2 className="card-title">Leave a tip</h2>
+
+        <div className="flex flex-col gap-1">
+          <BaseInput
+            name="amount"
+            value={amount}
+            onChange={value => isAllowedUsdcInput(value) && setAmount(value)}
+            placeholder="0.00"
+            suffix={<span className="self-center pr-4 text-neutral-content/70">USDC</span>}
+            disabled={isBusy}
+          />
+          <div className="flex justify-between px-1 text-xs opacity-70">
+            <span>
+              {connectedAddress ? `Your balance: ${formatUsdc(usdcBalance ?? 0n)} USDC` : "Wallet not connected"}
+            </span>
+            {needsApproval && <span>Approval needed first</span>}
+          </div>
+        </div>
+
+        <div className="flex flex-col gap-1">
+          <textarea
+            className="textarea textarea-bordered w-full bg-base-200 rounded-full px-4"
+            placeholder="Say something nice (optional)"
+            value={message}
+            onChange={event => setMessage(event.target.value)}
+            disabled={isBusy}
+            rows={2}
+          />
+          <span className={`self-end px-1 text-xs ${messageBytes > messageLimit ? "text-error" : "opacity-70"}`}>
+            {messageBytes}/{messageLimit} bytes
+          </span>
+        </div>
+
+        <button
+          className="btn btn-primary w-full"
+          disabled={isDisabled}
+          onClick={needsApproval ? approve : sendTip}
+          aria-busy={isBusy}
+        >
+          {isBusy && <span className="loading loading-spinner loading-sm" />}
+          {buttonLabel()}
+        </button>
+
+        {connectedAddress && usdcBalance === 0n && targetNetwork.id === 31337 && (
+          <div className="alert alert-info text-sm">
+            <span>
+              No USDC on the fork yet. Run <code className="font-bold">yarn fund {connectedAddress}</code> to mint
+              yourself some.
+            </span>
+          </div>
+        )}
+      </div>
+    </div>
+  );
+};
