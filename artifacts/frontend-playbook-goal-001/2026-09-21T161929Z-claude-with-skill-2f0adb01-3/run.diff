diff --git a/packages/foundry/scripts/fund-usdc.sh b/packages/foundry/scripts/fund-usdc.sh
new file mode 100755
index 0000000..aea9532
--- /dev/null
+++ b/packages/foundry/scripts/fund-usdc.sh
@@ -0,0 +1,34 @@
+#!/usr/bin/env bash
+# Local Base fork only: moves real USDC from a large Base holder to a test identity
+# by impersonating the holder on anvil. Nothing touches the real network.
+set -euo pipefail
+
+TO=${1:?usage: yarn fund:usdc <address> [amount-in-usdc]}
+AMOUNT=${2:-1000}
+RPC=${RPC_URL:-http://127.0.0.1:8545}
+USDC=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
+# Morpho Blue holds >100M USDC on Base; override with USDC_WHALE if it ever runs dry
+WHALE=${USDC_WHALE:-0xBBBBBbbBBb9cC5e90e3b3Af64bdAF62C37EEFFCb}
+
+if [ "$(cast chain-id --rpc-url "$RPC")" != "31337" ]; then
+  echo "❌ $RPC is not the local fork (chain id 31337). Refusing to run." >&2
+  exit 1
+fi
+if [ "$(cast code "$USDC" --rpc-url "$RPC")" = "0x" ]; then
+  echo "❌ No USDC at $USDC. Start the fork with 'yarn fork:base', not 'yarn chain'." >&2
+  exit 1
+fi
+
+# Gas money for the whale (may be a contract with 0 ETH) and for the recipient if empty
+cast rpc anvil_setBalance "$WHALE" 0xde0b6b3a7640000 --rpc-url "$RPC" >/dev/null
+if [ "$(cast balance "$TO" --rpc-url "$RPC")" = "0" ]; then
+  cast rpc anvil_setBalance "$TO" 0x8ac7230489e80000 --rpc-url "$RPC" >/dev/null # 10 ETH
+fi
+
+cast rpc anvil_impersonateAccount "$WHALE" --rpc-url "$RPC" >/dev/null
+cast send "$USDC" "transfer(address,uint256)" "$TO" "$(cast parse-units "$AMOUNT" 6)" \
+  --from "$WHALE" --unlocked --rpc-url "$RPC" >/dev/null
+cast rpc anvil_stopImpersonatingAccount "$WHALE" --rpc-url "$RPC" >/dev/null
+
+echo "✅ Sent $AMOUNT USDC to $TO"
+echo "   Balance: $(cast call "$USDC" "balanceOf(address)(uint256)" "$TO" --rpc-url "$RPC" | cut -d' ' -f1) (6 decimals)"
diff --git a/packages/foundry/test/TipJar.t.sol b/packages/foundry/test/TipJar.t.sol
new file mode 100644
index 0000000..5453915
--- /dev/null
+++ b/packages/foundry/test/TipJar.t.sol
@@ -0,0 +1,114 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import { Test } from "forge-std/Test.sol";
+import { Ownable } from "@openzeppelin/contracts/access/Ownable.sol";
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { TipJar } from "../contracts/TipJar.sol";
+
+/// @dev Runs against real Base USDC on a fork. Needs a Base RPC:
+///      forge test --fork-url base   (alias from foundry.toml)
+contract TipJarTest is Test {
+    IERC20 constant USDC = IERC20(0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913);
+
+    TipJar tipJar;
+    address owner = makeAddr("owner");
+    address alice = makeAddr("alice");
+    address bob = makeAddr("bob");
+
+    function setUp() public {
+        // Skip cleanly when not run against a Base fork
+        vm.skip(address(USDC).code.length == 0);
+        tipJar = new TipJar(USDC, owner);
+        deal(address(USDC), alice, 1_000e6);
+        deal(address(USDC), bob, 1_000e6);
+    }
+
+    function _tip(address from, uint256 amount, string memory message) internal {
+        vm.startPrank(from);
+        USDC.approve(address(tipJar), amount);
+        tipJar.tip(amount, message);
+        vm.stopPrank();
+    }
+
+    function test_TipMovesUsdcAndRecordsFeed() public {
+        _tip(alice, 5e6, "gm");
+        _tip(bob, 2e6, "great demo");
+
+        assertEq(USDC.balanceOf(address(tipJar)), 7e6);
+        assertEq(USDC.balanceOf(alice), 995e6);
+        assertEq(tipJar.totalTipped(), 7e6);
+        assertEq(tipJar.tipCount(), 2);
+
+        TipJar.Tip[] memory recent = tipJar.getRecentTips(10);
+        assertEq(recent.length, 2);
+        assertEq(recent[0].from, bob);
+        assertEq(recent[0].message, "great demo");
+        assertEq(recent[1].from, alice);
+        assertEq(recent[1].amount, 5e6);
+    }
+
+    function test_GetRecentTipsRespectsLimit() public {
+        _tip(alice, 1e6, "1");
+        _tip(alice, 1e6, "2");
+        _tip(alice, 1e6, "3");
+
+        TipJar.Tip[] memory recent = tipJar.getRecentTips(2);
+        assertEq(recent.length, 2);
+        assertEq(recent[0].message, "3");
+        assertEq(recent[1].message, "2");
+        assertEq(tipJar.getRecentTips(0).length, 0);
+    }
+
+    function test_EmitsTipReceived() public {
+        vm.startPrank(alice);
+        USDC.approve(address(tipJar), 1e6);
+        vm.expectEmit(address(tipJar));
+        emit TipJar.TipReceived(alice, 1e6, "hi");
+        tipJar.tip(1e6, "hi");
+        vm.stopPrank();
+    }
+
+    function test_RevertWhen_ZeroAmount() public {
+        vm.prank(alice);
+        vm.expectRevert(TipJar.ZeroAmount.selector);
+        tipJar.tip(0, "");
+    }
+
+    function test_RevertWhen_MessageTooLong() public {
+        bytes memory long = new bytes(281);
+        vm.startPrank(alice);
+        USDC.approve(address(tipJar), 1e6);
+        vm.expectRevert(TipJar.MessageTooLong.selector);
+        tipJar.tip(1e6, string(long));
+        vm.stopPrank();
+    }
+
+    function test_RevertWhen_NotApproved() public {
+        vm.prank(alice);
+        vm.expectRevert();
+        tipJar.tip(1e6, "no approval");
+    }
+
+    function test_OwnerWithdrawsAll() public {
+        _tip(alice, 5e6, "gm");
+        vm.prank(owner);
+        tipJar.withdraw(owner);
+        assertEq(USDC.balanceOf(owner), 5e6);
+        assertEq(USDC.balanceOf(address(tipJar)), 0);
+    }
+
+    function test_RevertWhen_NonOwnerWithdraws() public {
+        _tip(alice, 5e6, "gm");
+        vm.prank(alice);
+        vm.expectRevert(abi.encodeWithSelector(Ownable.OwnableUnauthorizedAccount.selector, alice));
+        tipJar.withdraw(alice);
+    }
+
+    function testFuzz_Tip(uint256 amount) public {
+        amount = bound(amount, 1, 1_000e6);
+        _tip(alice, amount, "fuzz");
+        assertEq(USDC.balanceOf(address(tipJar)), amount);
+        assertEq(tipJar.totalTipped(), amount);
+    }
+}
