diff --git a/packages/foundry/script/DeployTipJar.s.sol b/packages/foundry/script/DeployTipJar.s.sol
new file mode 100644
index 0000000..2cb3a87
--- /dev/null
+++ b/packages/foundry/script/DeployTipJar.s.sol
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.19;
+
+import "./DeployHelpers.s.sol";
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import "../contracts/TipJar.sol";
+
+/**
+ * @notice Deploys TipJar wired to Base USDC.
+ * yarn deploy                   # local Base fork (yarn fork:base)
+ * yarn deploy --network base    # real Base (requires funded keystore)
+ * Optional env: TIP_JAR_OWNER (defaults to deployer)
+ */
+contract DeployTipJar is ScaffoldETHDeploy {
+    address constant BASE_USDC = 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913;
+
+    error UsdcNotFound();
+
+    function run() external ScaffoldEthDeployerRunner {
+        // Catches deploying to a plain `yarn chain` instead of a Base fork
+        if (BASE_USDC.code.length == 0) revert UsdcNotFound();
+
+        address owner = vm.envOr("TIP_JAR_OWNER", deployer);
+        TipJar tipJar = new TipJar(IERC20(BASE_USDC), owner);
+        deployments.push(Deployment("TipJar", address(tipJar)));
+    }
+}
