+"use client";
+
+import { Address } from "@scaffold-ui/components";
+import { formatUsdc } from "~~/app/_components/usdc";
+import { useScaffoldReadContract, useTargetNetwork } from "~~/hooks/scaffold-eth";
+
+const FEED_SIZE = 20n;
+
+export const TipFeed = () => {
+  const { targetNetwork } = useTargetNetwork();
+  const { data: tips } = useScaffoldReadContract({
+    contractName: "TipJar",
+    functionName: "getRecentTips",
+    args: [FEED_SIZE],
+  });
+
+  return (
+    <div className="card bg-base-100 shadow-xl">
+      <div className="card-body">
+        <h2 className="card-title">Recent tips</h2>
+        {tips === undefined ? (
+          <span className="loading loading-dots loading-md" />
+        ) : tips.length === 0 ? (
+          <p className="opacity-70">No tips yet. Be the first!</p>
+        ) : (
+          <ul className="list">
+            {tips.map((tip, i) => (
+              <li key={`${tip.from}-${tip.timestamp}-${i}`} className="list-row items-center">
+                <div className="list-col-grow">
+                  <Address address={tip.from} chain={targetNetwork} size="sm" />
+                  {tip.message && <p className="mt-1 break-words">{tip.message}</p>}
+                  <p className="text-xs opacity-60">{new Date(Number(tip.timestamp) * 1000).toLocaleString()}</p>
+                </div>
+                <span className="badge badge-success badge-lg whitespace-nowrap">{formatUsdc(tip.amount)} USDC</span>
+              </li>
+            ))}
+          </ul>
+        )}
+      </div>
+    </div>
+  );
+};
diff --git a/packages/nextjs/app/_components/TipForm.tsx b/packages/nextjs/app/_components/TipForm.tsx
new file mode 100644
index 0000000..9b45837
--- /dev/null
+++ b/packages/nextjs/app/_components/TipForm.tsx
@@ -0,0 +1,149 @@
+"use client";
+
+import { useState } from "react";
+import { foundry } from "viem/chains";
+import { useAccount } from "wagmi";
+import { USDC_INPUT_REGEX, formatUsdc, parseUsdc } from "~~/app/_components/usdc";
+import {
+  useDeployedContractInfo,
+  useScaffoldReadContract,
+  useScaffoldWriteContract,
+  useTargetNetwork,
+} from "~~/hooks/scaffold-eth";
+
+// Must match TipJar.MAX_MESSAGE_LENGTH (bytes, not characters)
+const MAX_MESSAGE_BYTES = 280;
+const PRESET_AMOUNTS = ["1", "5", "10"];
+
+export const TipForm = () => {
+  const { address } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+  const [amount, setAmount] = useState("");
+  const [message, setMessage] = useState("");
+
+  const { data: tipJar } = useDeployedContractInfo({ contractName: "TipJar" });
+  const { data: balance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "balanceOf",
+    args: [address],
+  });
+  const { data: allowance, refetch: refetchAllowance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "allowance",
+    args: [address, tipJar?.address],
+  });
+
+  const { writeContractAsync: writeUsdc, isMining: isApproving } = useScaffoldWriteContract({
+    contractName: "USDC",
+  });
+  const { writeContractAsync: writeTipJar, isMining: isTipping } = useScaffoldWriteContract({
+    contractName: "TipJar",
+  });
+
+  const amountRaw = parseUsdc(amount);
+  const messageBytes = new TextEncoder().encode(message).length;
+  const isBusy = isApproving || isTipping;
+  const needsApproval = allowance !== undefined && allowance < amountRaw;
+  const isLocalFork = targetNetwork.id === foundry.id;
+
+  const handleApprove = async () => {
+    if (!tipJar) return;
+    try {
+      const hash = await writeUsdc({ functionName: "approve", args: [tipJar.address, amountRaw] });
+      if (hash) await refetchAllowance();
+    } catch (e) {
+      console.error("Approve failed", e);
+    }
+  };
+
+  const handleTip = async () => {
+    try {
+      // Resolves to undefined (after a toast) on wrong network: keep the form as typed
+      const hash = await writeTipJar({ functionName: "tip", args: [amountRaw, message] });
+      if (!hash) return;
+      setAmount("");
+      setMessage("");
+    } catch (e) {
+      console.error("Tip failed", e);
+    }
+  };
+
+  let blocker: string | undefined;
+  if (!address) blocker = "Connect a wallet to tip";
+  else if (amountRaw === 0n) blocker = "Enter an amount";
+  else if (balance !== undefined && balance < amountRaw) blocker = "Not enough USDC";
+  else if (messageBytes > MAX_MESSAGE_BYTES) blocker = "Message too long";
+  else if (allowance === undefined) blocker = "Loading…";
+
+  return (
+    <div className="card bg-base-100 shadow-xl">
+      <div className="card-body gap-4">
+        <h2 className="card-title">Send a tip</h2>
+
+        <fieldset className="fieldset">
+          <legend className="fieldset-legend">Amount (USDC)</legend>
+          <input
+            className="input w-full"
+            inputMode="decimal"
+            placeholder="0.00"
+            value={amount}
+            disabled={isBusy}
+            onChange={e => USDC_INPUT_REGEX.test(e.target.value) && setAmount(e.target.value)}
+          />
+          <div className="flex gap-2">
+            {PRESET_AMOUNTS.map(preset => (
+              <button
+                key={preset}
+                className="btn btn-xs btn-outline"
+                disabled={isBusy}
+                onClick={() => setAmount(preset)}
+              >
+                ${preset}
+              </button>
+            ))}
+          </div>
+          {address && balance !== undefined && <p className="label">Your balance: {formatUsdc(balance)} USDC</p>}
+        </fieldset>
+
+        <fieldset className="fieldset">
+          <legend className="fieldset-legend">Message (optional)</legend>
+          <textarea
+            className="textarea w-full"
+            placeholder="Say something nice"
+            value={message}
+            disabled={isBusy}
+            onChange={e => setMessage(e.target.value)}
+          />
+          <p className={`label ${messageBytes > MAX_MESSAGE_BYTES ? "text-error" : ""}`}>
+            {messageBytes}/{MAX_MESSAGE_BYTES}
+          </p>
+        </fieldset>
+
+        {blocker ? (
+          <button className="btn btn-primary" disabled>
+            {blocker}
+          </button>
+        ) : needsApproval ? (
+          <button className="btn btn-primary" disabled={isApproving || !tipJar} onClick={handleApprove}>
+            {isApproving && <span className="loading loading-spinner loading-sm" />}
+            Approve {formatUsdc(amountRaw)} USDC
+          </button>
+        ) : (
+          <button className="btn btn-primary" disabled={isTipping} onClick={handleTip}>
+            {isTipping && <span className="loading loading-spinner loading-sm" />}
+            Send {formatUsdc(amountRaw)} USDC tip
+          </button>
+        )}
+
+        {isLocalFork && address && balance === 0n && (
+          <div role="alert" className="alert alert-info alert-soft text-sm">
+            <span>
+              No USDC on the local fork yet. Fund this wallet with
+              <code className="block mt-1 break-all">yarn fund:usdc {address}</code>
+            </span>
+          </div>
+        )}
+      </div>
+    </div>
