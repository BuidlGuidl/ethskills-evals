@@ -0,0 +1,10 @@
+import { formatUnits, parseUnits } from "viem";
+
+export const USDC_DECIMALS = 6;
+// Cents are enough for tips and keep what the user typed identical to what is displayed
+export const USDC_INPUT_REGEX = /^\d*\.?\d{0,2}$/;
+
+export const parseUsdc = (value: string) => (value && value !== "." ? parseUnits(value, USDC_DECIMALS) : 0n);
+
+export const formatUsdc = (value: bigint) =>
+  Number(formatUnits(value, USDC_DECIMALS)).toLocaleString(undefined, { maximumFractionDigits: 2 });
