diff --git a/packages/nextjs/scripts/ipfs-preflight.mjs b/packages/nextjs/scripts/ipfs-preflight.mjs
new file mode 100644
index 0000000..052837d
--- /dev/null
+++ b/packages/nextjs/scripts/ipfs-preflight.mjs
@@ -0,0 +1,24 @@
+// Fails the IPFS build early instead of shipping a site that points at nothing.
+import { readFileSync } from "fs";
+
+const errors = [];
+
+const productionUrl = process.env.NEXT_PUBLIC_PRODUCTION_URL;
+if (!productionUrl?.startsWith("https://")) {
+  errors.push("NEXT_PUBLIC_PRODUCTION_URL must be set to the https URL the site will be served from");
+}
+if (!process.env.NEXT_PUBLIC_ALCHEMY_API_KEY) {
+  errors.push("NEXT_PUBLIC_ALCHEMY_API_KEY must be set (the shared default key is rate limited)");
+}
+
+const deployed = readFileSync(new URL("../contracts/deployedContracts.ts", import.meta.url), "utf-8");
+const baseSection = deployed.split(/\n  8453: \{/)[1];
+if (!baseSection || !/^\s{4}TipJar: \{/m.test(baseSection.split(/\n  \d+: \{/)[0])) {
+  errors.push("TipJar is not deployed on Base (8453). Run `yarn deploy --network base` first");
+}
+
+if (errors.length) {
+  console.error(`❌ IPFS preflight failed:\n - ${errors.join("\n - ")}`);
+  process.exit(1);
+}
+console.log("✅ IPFS preflight passed");
