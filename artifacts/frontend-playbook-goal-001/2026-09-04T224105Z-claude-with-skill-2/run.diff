diff --git a/packages/foundry/scripts-js/fork.js b/packages/foundry/scripts-js/fork.js
new file mode 100644
index 0000000..558f064
--- /dev/null
+++ b/packages/foundry/scripts-js/fork.js
@@ -0,0 +1,55 @@
+import { spawnSync } from "child_process";
+import { dirname, join } from "path";
+import { readFileSync } from "fs";
+import { parse } from "toml";
+import { fileURLToPath } from "url";
+
+const __dirname = dirname(fileURLToPath(import.meta.url));
+
+const args = process.argv.slice(2);
+
+if (args.includes("--help") || args.includes("-h")) {
+  console.log(`
+Usage: yarn fork [options]
+Options:
+  --network <network>      Network alias from foundry.toml to fork (default: base)
+  --block-time <seconds>   Anvil mining interval (default: 1, use 0 to mine on demand)
+  --help, -h               Show this help message
+Examples:
+  yarn fork                        # fork Base with 1s blocks
+  yarn fork --network mainnet
+  yarn fork --network base --block-time 0
+  `);
+  process.exit(0);
+}
+
+let network = "base";
+let blockTime = "1";
+
+for (let i = 0; i < args.length; i++) {
+  if (args[i] === "--network" && args[i + 1]) {
+    network = args[++i];
+  } else if (args[i] === "--block-time" && args[i + 1]) {
+    blockTime = args[++i];
+  }
+}
+
+const foundryToml = parse(
+  readFileSync(join(__dirname, "..", "foundry.toml"), "utf-8")
+);
+
+if (!foundryToml.rpc_endpoints[network]) {
+  console.log(
+    `\n❌ Error: Network '${network}' not found in foundry.toml!`,
+    "\nPlease check `foundry.toml` for available networks in the [rpc_endpoints] section or add a new network."
+  );
+  process.exit(1);
+}
+
+// Anvil resolves the alias against foundry.toml itself, so pass it through unexpanded
+// and keep API keys out of the process list.
+process.env.FORK_URL = network;
+process.env.FORK_BLOCK_TIME = blockTime;
+
+const result = spawnSync("make", ["fork"], { stdio: "inherit", shell: true });
+process.exit(result.status);
diff --git a/packages/foundry/scripts-js/fundDemoAccounts.js b/packages/foundry/scripts-js/fundDemoAccounts.js
new file mode 100644
index 0000000..45efaff
--- /dev/null
+++ b/packages/foundry/scripts-js/fundDemoAccounts.js
@@ -0,0 +1,154 @@
+/**
+ * Funds demo identities with real Base USDC on a local Anvil fork.
+ *
+ * Nothing here is broadcast to Base: the fork is a local copy, so impersonating a
+ * whale and moving its balance costs nothing and puts no real money at risk. The
+ * script refuses to run against anything that is not a local fork.
+ */
+import { parseArgs } from "node:util";
+
+const RPC_URL = process.env.RPC_URL || "http://127.0.0.1:8545";
+const USDC =
+  process.env.USDC_ADDRESS || "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913";
+// Aave v3 Base aUSDC reserve: a large, stable USDC holder to source demo funds from.
+const DEFAULT_WHALE =
+  process.env.USDC_WHALE || "0x4e65fE4DbA92790696d040ac24Aa414708F5c0AB";
+
+// Anvil's first three default accounts (well-known test mnemonic, no real funds).
+const DEFAULT_RECIPIENTS = [
+  "0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266",
+  "0x70997970C51812dc3A010C7d01b50e0d17dc79C8",
+  "0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC",
+];
+
+const { values } = parseArgs({
+  options: {
+    to: { type: "string", multiple: true },
+    amount: { type: "string", default: "10000" },
+    whale: { type: "string", default: DEFAULT_WHALE },
+    help: { type: "boolean", short: "h" },
+  },
+});
+
+if (values.help) {
+  console.log(`
+Usage: yarn fund-demo [options]
+Options:
+  --to <address>      Address to fund (repeatable). Defaults to Anvil accounts #0, #1 and #2.
+  --amount <usdc>     USDC per address, in whole USDC (default: 10000)
+  --whale <address>   Account to source USDC from (default: Aave v3 Base aUSDC reserve)
+  --help, -h          Show this help message
+Examples:
+  yarn fund-demo
+  yarn fund-demo --to 0xYourBurnerWallet
+  yarn fund-demo --to 0xAlice --to 0xBob --amount 250
+`);
+  process.exit(0);
+}
+
+let rpcId = 0;
+const rpc = async (method, params = []) => {
+  const res = await fetch(RPC_URL, {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: JSON.stringify({ jsonrpc: "2.0", id: ++rpcId, method, params }),
+  }).catch(() => {
+    throw new Error(
+      `Cannot reach ${RPC_URL}. Start the fork first: yarn fork --network base`
+    );
+  });
+  const json = await res.json();
+  if (json.error) throw new Error(`${method}: ${json.error.message}`);
+  return json.result;
+};
+
+const pad = (value) => BigInt(value).toString(16).padStart(64, "0");
+const toHex = (value) => `0x${BigInt(value).toString(16)}`;
+const formatUsdc = (units) =>
+  (Number(units) / 1e6).toLocaleString("en-US", { maximumFractionDigits: 2 });
+
+const balanceOf = async (account) =>
+  BigInt(
+    await rpc("eth_call", [
+      { to: USDC, data: `0x70a08231${pad(account)}` },
+      "latest",
+    ])
+  );
+
+const waitForReceipt = async (hash) => {
+  for (let i = 0; i < 60; i++) {
+    const receipt = await rpc("eth_getTransactionReceipt", [hash]);
+    if (receipt) return receipt;
+    await new Promise((resolve) => setTimeout(resolve, 250));
+  }
+  throw new Error(
+    `Timed out waiting for ${hash}. Is Anvil mining? (yarn fork sets --block-time 1)`
+  );
+};
+
+const main = async () => {
+  const chainId = Number(await rpc("eth_chainId"));
+  if (chainId !== 31337) {
+    throw new Error(
+      `Refusing to run against chain ${chainId}: this script is for a local Anvil fork only.`
+    );
+  }
+  if ((await rpc("eth_getCode", [USDC, "latest"])) === "0x") {
+    throw new Error(
+      `No USDC at ${USDC}. Fork Base first: yarn fork --network base`
+    );
+  }
+
+  const recipients = values.to?.length ? values.to : DEFAULT_RECIPIENTS;
+  const amount = BigInt(Math.round(Number(values.amount) * 1e6));
+  const whale = values.whale;
+
+  const whaleBalance = await balanceOf(whale);
+  const needed = amount * BigInt(recipients.length);
+  if (whaleBalance < needed) {
+    throw new Error(
+      `Whale ${whale} holds ${formatUsdc(whaleBalance)} USDC but ${formatUsdc(
+        needed
+      )} is needed. ` + `Pass a different holder with --whale <address>.`
+    );
+  }
+
+  // Anvil mines on demand unless started with --block-time, which freezes block.timestamp between
+  // transactions and makes every tip in the feed look like it happened at the same instant. Warn
+  // rather than force it, since `yarn fork --block-time 0` is a deliberate mode.
+  const latestBlock = await rpc("eth_getBlockByNumber", ["latest", false]);
+  if (Math.floor(Date.now() / 1000) - Number(latestBlock.timestamp) > 60) {
+    console.warn(
+      `⚠️  Anvil's latest block is stale, so feed timestamps will look frozen.\n` +
+        `   Restart with \`yarn fork --network base\`, or run \`cast rpc anvil_setIntervalMining 1\`.\n`
+    );
+  }
+
+  await rpc("anvil_setBalance", [whale, toHex(10n ** 18n)]);
+  await rpc("anvil_impersonateAccount", [whale]);
+
+  try {
+    for (const to of recipients) {
+      // Burner wallets start with no ETH, so top up gas money as well.
+      await rpc("anvil_setBalance", [to, toHex(10n * 10n ** 18n)]);
+      const hash = await rpc("eth_sendTransaction", [
+        { from: whale, to: USDC, data: `0xa9059cbb${pad(to)}${pad(amount)}` },
+      ]);
+      const receipt = await waitForReceipt(hash);
+      if (receipt.status !== "0x1")
+        throw new Error(`USDC transfer to ${to} reverted (${hash})`);
+      console.log(`✅ ${to}  ${formatUsdc(await balanceOf(to))} USDC  10 ETH`);
+    }
+  } finally {
+    await rpc("anvil_stopImpersonatingAccount", [whale]);
+  }
+
+  console.log(
+    `\nFunded from ${whale} on the local fork. No Base transaction was broadcast.`
+  );
+};
+
+main().catch((error) => {
+  console.error(`\n❌ ${error.message}`);
+  process.exit(1);
+});
diff --git a/packages/foundry/test/TipJar.t.sol b/packages/foundry/test/TipJar.t.sol
new file mode 100644
index 0000000..2072342
--- /dev/null
+++ b/packages/foundry/test/TipJar.t.sol
@@ -0,0 +1,138 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import { Test } from "forge-std/Test.sol";
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { Ownable } from "@openzeppelin/contracts/access/Ownable.sol";
+import { TipJar } from "../contracts/TipJar.sol";
+
+/**
+ * Exercised against a Base fork so the jar is tested against the real USDC
+ * implementation (proxy, 6 decimals, legacy string reverts) rather than a mock.
+ * Requires network access to the `base` RPC endpoint in foundry.toml on the first run.
+ *
+ * The fork block is pinned: Forge only caches fork state for pinned blocks, and pinning also
+ * freezes the whale's balance, so the suite does not depend on a third party's live holdings.
+ */
+contract TipJarTest is Test {
+    address constant USDC = 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913;
+    address constant USDC_WHALE = 0x4e65fE4DbA92790696d040ac24Aa414708F5c0AB;
+    uint256 constant FORK_BLOCK = 50_800_000;
+
+    uint256 constant ONE_USDC = 1e6;
+
+    TipJar jar;
+    IERC20 usdc = IERC20(USDC);
+    address owner = makeAddr("owner");
+    address alice = makeAddr("alice");
+    address bob = makeAddr("bob");
+
+    event Tipped(address indexed sender, uint256 amount, string message);
+
+    function setUp() public {
+        vm.createSelectFork("base", FORK_BLOCK);
+
+        jar = new TipJar(usdc, owner);
+
+        vm.startPrank(USDC_WHALE);
+        usdc.transfer(alice, 1000 * ONE_USDC);
+        usdc.transfer(bob, 1000 * ONE_USDC);
+        vm.stopPrank();
+    }
+
+    function _tip(address from, uint256 amount, string memory message) internal {
+        vm.startPrank(from);
+        usdc.approve(address(jar), amount);
+        jar.tip(amount, message);
+        vm.stopPrank();
+    }
+
+    function test_TipMovesUsdcAndRecordsFeedEntry() public {
+        uint256 amount = 5 * ONE_USDC;
+
+        vm.startPrank(alice);
+        usdc.approve(address(jar), amount);
+        vm.expectEmit(true, false, false, true, address(jar));
+        emit Tipped(alice, amount, "gm");
+        jar.tip(amount, "gm");
+        vm.stopPrank();
+
+        assertEq(usdc.balanceOf(address(jar)), amount);
+        assertEq(usdc.balanceOf(alice), 995 * ONE_USDC);
+        assertEq(jar.totalTipped(), amount);
+        assertEq(jar.tipCount(), 1);
+
+        TipJar.Tip[] memory feed = jar.getTips(0, 10);
+        assertEq(feed.length, 1);
+        assertEq(feed[0].sender, alice);
+        assertEq(feed[0].amount, amount);
+        assertEq(feed[0].message, "gm");
+        assertEq(feed[0].timestamp, uint64(block.timestamp));
+    }
+
+    function test_FeedIsNewestFirstAndPages() public {
+        _tip(alice, ONE_USDC, "first");
+        _tip(bob, 2 * ONE_USDC, "second");
+        _tip(alice, 3 * ONE_USDC, "third");
+
+        TipJar.Tip[] memory page = jar.getTips(0, 2);
+        assertEq(page.length, 2);
+        assertEq(page[0].message, "third");
+        assertEq(page[1].message, "second");
+
+        page = jar.getTips(2, 2);
+        assertEq(page.length, 1);
+        assertEq(page[0].message, "first");
+
+        assertEq(jar.getTips(3, 2).length, 0);
+        assertEq(jar.totalTipped(), 6 * ONE_USDC);
+    }
+
+    function test_RevertWhen_AmountIsZero() public {
+        vm.prank(alice);
+        vm.expectRevert(TipJar.ZeroAmount.selector);
+        jar.tip(0, "gm");
+    }
+
+    function test_RevertWhen_MessageTooLong() public {
+        string memory message = new string(141);
+
+        vm.prank(alice);
+        vm.expectRevert(abi.encodeWithSelector(TipJar.MessageTooLong.selector, 141));
+        jar.tip(ONE_USDC, message);
+    }
+
+    /// @dev Base USDC is FiatTokenV2.2, which still reverts with a legacy string rather than
+    ///      an OZ v5 custom error. SafeERC20 bubbles it up unchanged.
+    function test_RevertWhen_NotApproved() public {
+        vm.prank(alice);
+        vm.expectRevert("ERC20: transfer amount exceeds allowance");
+        jar.tip(ONE_USDC, "gm");
+    }
+
+    function test_OwnerWithdrawsEverything() public {
+        _tip(alice, 7 * ONE_USDC, "gm");
+
+        vm.prank(owner);
+        jar.withdraw();
+
+        assertEq(usdc.balanceOf(owner), 7 * ONE_USDC);
+        assertEq(usdc.balanceOf(address(jar)), 0);
+        // totalTipped is a lifetime counter, not the current balance
+        assertEq(jar.totalTipped(), 7 * ONE_USDC);
+    }
+
+    function test_RevertWhen_NonOwnerWithdraws() public {
+        _tip(alice, ONE_USDC, "gm");
+
+        vm.prank(alice);
+        vm.expectRevert(abi.encodeWithSelector(Ownable.OwnableUnauthorizedAccount.selector, alice));
+        jar.withdraw();
+    }
+
+    function test_RevertWhen_WithdrawingEmptyJar() public {
+        vm.prank(owner);
+        vm.expectRevert(TipJar.NothingToWithdraw.selector);
+        jar.withdraw();
+    }
+}
