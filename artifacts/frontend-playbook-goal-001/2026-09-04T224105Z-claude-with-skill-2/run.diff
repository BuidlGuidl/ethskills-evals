@@ -0,0 +1,49 @@
+"use client";
+
+import { Address } from "@scaffold-ui/components";
+import { useScaffoldReadContract, useTargetNetwork } from "~~/hooks/scaffold-eth";
+import { formatTimeAgo, formatUsdc } from "~~/utils/usdc";
+
+const FEED_SIZE = 25n;
+
+export const TipFeed = () => {
+  const { targetNetwork } = useTargetNetwork();
+  const { data: tips, isLoading } = useScaffoldReadContract({
+    contractName: "TipJar",
+    functionName: "getTips",
+    args: [0n, FEED_SIZE],
+  });
+
+  return (
+    <div className="card bg-base-100 shadow-xl">
+      <div className="card-body gap-4">
+        <h2 className="card-title m-0">Recent tips</h2>
+
+        {isLoading ? (
+          <div className="flex flex-col gap-3">
+            {[0, 1, 2].map(row => (
+              <div key={row} className="skeleton h-16 w-full" />
+            ))}
+          </div>
+        ) : !tips?.length ? (
+          <p className="m-0 text-sm opacity-70">No tips yet. Be the first.</p>
+        ) : (
+          <ul className="list-none m-0 p-0 flex flex-col divide-y divide-base-300">
+            {tips.map((tip, index) => (
+              <li key={`${tip.timestamp}-${index}`} className="flex flex-col gap-1 py-3 first:pt-0 last:pb-0">
+                <div className="flex items-center justify-between gap-2">
+                  <Address address={tip.sender} chain={targetNetwork} size="sm" />
+                  <div className="flex items-center gap-2 shrink-0">
+                    <span className="badge badge-primary badge-lg">{formatUsdc(tip.amount)} USDC</span>
+                    <span className="text-xs opacity-60">{formatTimeAgo(tip.timestamp)}</span>
+                  </div>
+                </div>
+                {tip.message ? <p className="m-0 text-sm opacity-80 break-words">{tip.message}</p> : null}
+              </li>
+            ))}
+          </ul>
+        )}
+      </div>
+    </div>
+  );
+};
diff --git a/packages/nextjs/app/_components/TipForm.tsx b/packages/nextjs/app/_components/TipForm.tsx
new file mode 100644
index 0000000..eb0acf3
--- /dev/null
+++ b/packages/nextjs/app/_components/TipForm.tsx
@@ -0,0 +1,166 @@
+"use client";
+
+import { useMemo, useState } from "react";
+import { parseUnits } from "viem";
+import { useAccount } from "wagmi";
+import { RainbowKitCustomConnectButton } from "~~/components/scaffold-eth";
+import { useDeployedContractInfo, useScaffoldReadContract, useScaffoldWriteContract } from "~~/hooks/scaffold-eth";
+import { USDC_DECIMALS, formatUsdc } from "~~/utils/usdc";
+
+const QUICK_AMOUNTS = ["1", "5", "25"];
+
+// The contract limits the message in UTF-8 *bytes*; JS string length counts UTF-16 code units,
+// so a 140-character emoji message is well over the limit. Count bytes the same way Solidity does.
+const byteLength = (value: string) => new TextEncoder().encode(value).length;
+
+export const TipForm = () => {
+  const { address: connectedAddress } = useAccount();
+  const { data: tipJar } = useDeployedContractInfo({ contractName: "TipJar" });
+
+  const [amount, setAmount] = useState("");
+  const [message, setMessage] = useState("");
+
+  const parsedAmount = useMemo(() => {
+    if (!amount.trim()) return undefined;
+    try {
+      return parseUnits(amount.trim(), USDC_DECIMALS);
+    } catch {
+      return undefined;
+    }
+  }, [amount]);
+
+  const { data: maxMessageLength } = useScaffoldReadContract({
+    contractName: "TipJar",
+    functionName: "MAX_MESSAGE_LENGTH",
+  });
+  const { data: balance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "balanceOf",
+    args: [connectedAddress],
+  });
+  const { data: allowance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "allowance",
+    args: [connectedAddress, tipJar?.address],
+  });
+
+  const { writeContractAsync: writeUsdc, isMining: isApproving } = useScaffoldWriteContract({ contractName: "USDC" });
+  const { writeContractAsync: writeTipJar, isMining: isTipping } = useScaffoldWriteContract({
+    contractName: "TipJar",
+  });
+
+  const messageBytes = byteLength(message);
+  const messageLimit = Number(maxMessageLength ?? 140n);
+
+  const needsApproval = parsedAmount !== undefined && allowance !== undefined && allowance < parsedAmount;
+  const notEnoughUsdc = parsedAmount !== undefined && balance !== undefined && balance < parsedAmount;
+
+  const error = (() => {
+    if (amount.trim() && parsedAmount === undefined) return "Enter a valid USDC amount";
+    if (parsedAmount === 0n) return "Tip must be more than 0";
+    if (notEnoughUsdc) return "Not enough USDC in your wallet";
+    if (messageBytes > messageLimit) return `Message is ${messageBytes - messageLimit} bytes too long`;
+    return undefined;
+  })();
+
+  const isBusy = isApproving || isTipping;
+  // Wait for the allowance read: while it is undefined `needsApproval` is false, and submitting
+  // would skip the approve and fail the simulate.
+  const canSubmit = !!parsedAmount && !error && !isBusy && !!tipJar && allowance !== undefined;
+
+  const onSubmit = async (event: React.FormEvent) => {
+    event.preventDefault();
+    if (!canSubmit || !parsedAmount || !tipJar) return;
+
+    try {
+      if (needsApproval) {
+        // Returns undefined instead of throwing when the wallet is missing or on the wrong
+        // network; continuing would fire a second, redundant failure notification.
+        const approvalHash = await writeUsdc({ functionName: "approve", args: [tipJar.address, parsedAmount] });
+        if (!approvalHash) return;
+      }
+      await writeTipJar({ functionName: "tip", args: [parsedAmount, message] });
+      setAmount("");
+      setMessage("");
+    } catch {
+      // useScaffoldWriteContract already surfaced the parsed error as a notification
+    }
+  };
+
+  if (!connectedAddress) {
+    return (
+      <div className="card bg-base-100 shadow-xl">
+        <div className="card-body items-center text-center gap-4">
+          <h2 className="card-title">Leave a tip</h2>
+          <p className="m-0 text-sm opacity-70">Connect a wallet holding Base USDC to send a tip.</p>
+          <RainbowKitCustomConnectButton />
+        </div>
+      </div>
+    );
+  }
+
+  return (
+    <div className="card bg-base-100 shadow-xl">
+      <form className="card-body gap-4" onSubmit={onSubmit}>
+        <div className="flex items-baseline justify-between">
+          <h2 className="card-title m-0">Leave a tip</h2>
+          <span className="text-sm opacity-70">Balance: {balance === undefined ? "—" : formatUsdc(balance)} USDC</span>
+        </div>
+
+        <label className="form-control">
+          <div className="label">
+            <span className="label-text">Amount</span>
+          </div>
+          <div className="join">
+            <input
+              className="input input-bordered join-item w-full"
+              placeholder="0.00"
+              inputMode="decimal"
+              value={amount}
+              onChange={event => setAmount(event.target.value)}
+            />
+            <span className="btn btn-neutral join-item no-animation pointer-events-none">USDC</span>
+          </div>
+        </label>
+
+        <div className="flex gap-2">
+          {QUICK_AMOUNTS.map(quick => (
+            <button key={quick} type="button" className="btn btn-sm btn-outline" onClick={() => setAmount(quick)}>
+              ${quick}
+            </button>
+          ))}
+        </div>
+
+        <label className="form-control">
+          <div className="label">
+            <span className="label-text">Message</span>
+            <span className={`label-text-alt ${messageBytes > messageLimit ? "text-error" : ""}`}>
+              {messageBytes}/{messageLimit}
+            </span>
+          </div>
+          <textarea
+            className="textarea textarea-bordered"
+            placeholder="Say something nice (optional)"
+            rows={2}
+            value={message}
+            onChange={event => setMessage(event.target.value)}
+          />
+        </label>
+
+        {error ? <p className="m-0 text-sm text-error">{error}</p> : null}
+
+        <button type="submit" className="btn btn-primary" disabled={!canSubmit}>
+          {isBusy ? <span className="loading loading-spinner loading-sm" /> : null}
+          {needsApproval ? "Approve & send tip" : "Send tip"}
+        </button>
+
+        {needsApproval ? (
+          <p className="m-0 text-xs opacity-60">
+            USDC is pull-based, so the jar needs an approval for this exact amount first. That makes it two
+            transactions.
+          </p>
+        ) : null}
+      </form>
+    </div>
+  );
+};
