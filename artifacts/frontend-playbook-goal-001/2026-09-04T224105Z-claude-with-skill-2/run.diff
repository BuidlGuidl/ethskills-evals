diff --git a/packages/nextjs/utils/usdc.ts b/packages/nextjs/utils/usdc.ts
new file mode 100644
index 0000000..f5bb025
--- /dev/null
+++ b/packages/nextjs/utils/usdc.ts
@@ -0,0 +1,19 @@
+import { formatUnits } from "viem";
+
+export const USDC_DECIMALS = 6;
+
+/** Base USDC amounts are 6-decimal base units; render them as a plain dollar-ish figure. */
+export const formatUsdc = (amount: bigint) =>
+  Number(formatUnits(amount, USDC_DECIMALS)).toLocaleString("en-US", {
+    minimumFractionDigits: 2,
+    maximumFractionDigits: 2,
+  });
+
+/** Compact relative time for the feed. Anvil forks run with 1s blocks, so this stays live. */
+export const formatTimeAgo = (timestamp: bigint) => {
+  const seconds = Math.max(0, Math.floor(Date.now() / 1000) - Number(timestamp));
+  if (seconds < 60) return "just now";
+  if (seconds < 3600) return `${Math.floor(seconds / 60)}m ago`;
+  if (seconds < 86400) return `${Math.floor(seconds / 3600)}h ago`;
+  return `${Math.floor(seconds / 86400)}d ago`;
+};

