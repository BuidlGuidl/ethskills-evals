+"use client";
+
+import { Address } from "@scaffold-ui/components";
+import { useDeployedContractInfo, useScaffoldReadContract, useTargetNetwork } from "~~/hooks/scaffold-eth";
+import { formatUsdc } from "~~/utils/usdc";
+
+export const JarSummary = () => {
+  const { targetNetwork } = useTargetNetwork();
+  const { data: tipJar } = useDeployedContractInfo({ contractName: "TipJar" });
+
+  const { data: totalTipped } = useScaffoldReadContract({ contractName: "TipJar", functionName: "totalTipped" });
+  const { data: tipCount } = useScaffoldReadContract({ contractName: "TipJar", functionName: "tipCount" });
+  const { data: jarBalance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "balanceOf",
+    args: [tipJar?.address],
+  });
+
+  return (
+    <div className="stats stats-vertical sm:stats-horizontal bg-base-100 shadow w-full">
+      <div className="stat">
+        <div className="stat-title">Tipped all time</div>
+        <div className="stat-value text-primary text-3xl">
+          {totalTipped === undefined ? "—" : formatUsdc(totalTipped)}
+        </div>
+        <div className="stat-desc">USDC</div>
+      </div>
+      <div className="stat">
+        <div className="stat-title">In the jar</div>
+        <div className="stat-value text-3xl">{jarBalance === undefined ? "—" : formatUsdc(jarBalance)}</div>
+        <div className="stat-desc">USDC awaiting withdrawal</div>
+      </div>
+      <div className="stat">
+        <div className="stat-title">Tips</div>
+        <div className="stat-value text-3xl">{tipCount === undefined ? "—" : tipCount.toString()}</div>
+        <div className="stat-desc flex items-center gap-1">
+          Jar
+          {tipJar ? <Address address={tipJar.address} chain={targetNetwork} size="xs" onlyEnsOrAddress /> : null}
+        </div>
+      </div>
+    </div>
+  );
+};
diff --git a/packages/nextjs/app/_components/TipFeed.tsx b/packages/nextjs/app/_components/TipFeed.tsx
