@@ -0,0 +1,39 @@
+"use client";
+
+import { JarSummary } from "./JarSummary";
+import { TipFeed } from "./TipFeed";
+import { TipForm } from "./TipForm";
+import { useDeployedContractInfo, useTargetNetwork } from "~~/hooks/scaffold-eth";
+
+export const TipJarPage = () => {
+  const { targetNetwork } = useTargetNetwork();
+  const { data: tipJar, isLoading } = useDeployedContractInfo({ contractName: "TipJar" });
+
+  return (
+    <div className="flex flex-col grow items-center px-5 py-10">
+      <div className="w-full max-w-2xl flex flex-col gap-6">
+        <header className="text-center">
+          <h1 className="text-4xl font-bold m-0">USDC Tip Jar</h1>
+          <p className="mt-2 mb-0 opacity-70">Tip in USDC on Base and leave a note.</p>
+        </header>
+
+        {!isLoading && !tipJar ? (
+          // Without this the reads simply stay disabled and the page renders an empty feed and
+          // dashes, which looks like a working jar that nobody has tipped yet.
+          <div role="alert" className="alert alert-error">
+            <span>
+              No TipJar deployed on {targetNetwork.name} (chain {targetNetwork.id}). Run <code>yarn deploy</code>{" "}
+              against the fork, or check the target network in <code>scaffold.config.ts</code>.
+            </span>
+          </div>
+        ) : (
+          <>
+            <JarSummary />
+            <TipForm />
+            <TipFeed />
+          </>
+        )}
+      </div>
+    </div>
+  );
+};
