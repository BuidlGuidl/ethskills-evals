@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import "./DeployHelpers.s.sol";
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { TipJar } from "../contracts/TipJar.sol";
+
+/**
+ * @notice Deploy script for the TipJar contract
+ * @dev The tip token is Base USDC, which only exists on Base and on a Base fork. It is not
+ *      configurable here on purpose: the frontend reads USDC from `externalContracts.ts` at a
+ *      fixed address, so a jar pointed at some other token would leave the UI approving and
+ *      reading balances on a token the jar never touches.
+ * Example:
+ * yarn fork --network base                  # local Anvil fork of Base, chain id 31337
+ * yarn deploy --file DeployTipJar.s.sol     # deploys against the fork
+ * yarn deploy --file DeployTipJar.s.sol --network base # live network (requires keystore)
+ */
+contract DeployTipJar is ScaffoldETHDeploy {
+    /// @dev Native USDC on Base mainnet (6 decimals)
+    address public constant BASE_USDC = 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913;
+
+    function run() external ScaffoldEthDeployerRunner {
+        // A bare `yarn chain` has no USDC, so the jar would deploy but every tip would revert.
+        require(
+            BASE_USDC.code.length > 0, "No USDC code at the Base USDC address - run `yarn fork --network base` first"
+        );
+
+        TipJar tipJar = new TipJar(IERC20(BASE_USDC), deployer);
+        console.logString(string.concat("TipJar deployed at ", vm.toString(address(tipJar))));
+    }
+}
