+++ b/packages/foundry/contracts/TipJar.sol
@@ -0,0 +1,84 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { SafeERC20 } from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+
+contract TipJar {
+    using SafeERC20 for IERC20;
+
+    error InvalidAddress();
+    error InvalidAmount();
+    error MessageTooLong();
+
+    struct Tip {
+        uint256 id;
+        address sender;
+        uint256 amount;
+        string message;
+        uint256 timestamp;
+    }
+
+    IERC20 public immutable usdc;
+    address public immutable recipient;
+    uint256 public tipCount;
+    uint256 public totalTipped;
+
+    mapping(uint256 id => Tip tip) private tips;
+
+    event TipSent(
+        uint256 indexed tipId,
+        address indexed sender,
+        address indexed recipient,
+        uint256 amount,
+        string message,
+        uint256 timestamp
+    );
+
+    constructor(address usdc_, address recipient_) {
+        if (usdc_ == address(0) || recipient_ == address(0)) {
+            revert InvalidAddress();
+        }
+
+        usdc = IERC20(usdc_);
+        recipient = recipient_;
+    }
+
+    function tip(uint256 amount, string calldata message) external {
+        if (amount == 0) {
+            revert InvalidAmount();
+        }
+        if (bytes(message).length > 160) {
+            revert MessageTooLong();
+        }
+
+        usdc.safeTransferFrom(msg.sender, recipient, amount);
+
+        uint256 tipId = tipCount + 1;
+        tipCount = tipId;
+        totalTipped += amount;
+
+        tips[tipId] =
+            Tip({ id: tipId, sender: msg.sender, amount: amount, message: message, timestamp: block.timestamp });
+
+        emit TipSent(tipId, msg.sender, recipient, amount, message, block.timestamp);
+    }
+
+    function getTip(uint256 tipId) external view returns (Tip memory) {
+        return tips[tipId];
+    }
+
+    function latestTips(uint256 count) external view returns (Tip[] memory) {
+        uint256 available = tipCount;
+        if (count > available) {
+            count = available;
+        }
+
+        Tip[] memory results = new Tip[](count);
+        for (uint256 i = 0; i < count; i++) {
+            results[i] = tips[available - i];
+        }
+
+        return results;
+    }
+}
