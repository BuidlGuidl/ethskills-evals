diff --git a/packages/foundry/test/TipJar.t.sol b/packages/foundry/test/TipJar.t.sol
new file mode 100644
index 0000000..094604c
--- /dev/null
+++ b/packages/foundry/test/TipJar.t.sol
@@ -0,0 +1,87 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import { Test } from "forge-std/Test.sol";
+import { ERC20 } from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+import { TipJar } from "../contracts/TipJar.sol";
+
+contract MockUSDC is ERC20 {
+    constructor() ERC20("USD Coin", "USDC") { }
+
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    function mint(address to, uint256 amount) external {
+        _mint(to, amount);
+    }
+}
+
+contract TipJarTest is Test {
+    MockUSDC internal usdc;
+    TipJar internal tipJar;
+
+    address internal recipient = makeAddr("recipient");
+    address internal tipper = makeAddr("tipper");
+
+    function setUp() public {
+        usdc = new MockUSDC();
+        tipJar = new TipJar(address(usdc), recipient);
+        usdc.mint(tipper, 100e6);
+    }
+
+    function testTipTransfersUsdcAndStoresFeedItem() public {
+        vm.startPrank(tipper);
+        usdc.approve(address(tipJar), 25e6);
+        vm.expectEmit(true, true, true, true);
+        emit TipJar.TipSent(1, tipper, recipient, 25e6, "great work", block.timestamp);
+        tipJar.tip(25e6, "great work");
+        vm.stopPrank();
+
+        assertEq(usdc.balanceOf(recipient), 25e6);
+        assertEq(usdc.balanceOf(tipper), 75e6);
+        assertEq(tipJar.tipCount(), 1);
+        assertEq(tipJar.totalTipped(), 25e6);
+
+        TipJar.Tip memory storedTip = tipJar.getTip(1);
+        assertEq(storedTip.id, 1);
+        assertEq(storedTip.sender, tipper);
+        assertEq(storedTip.amount, 25e6);
+        assertEq(storedTip.message, "great work");
+    }
+
+    function testLatestTipsReturnsNewestFirst() public {
+        vm.startPrank(tipper);
+        usdc.approve(address(tipJar), 6e6);
+        tipJar.tip(1e6, "first");
+        tipJar.tip(2e6, "second");
+        tipJar.tip(3e6, "third");
+        vm.stopPrank();
+
+        TipJar.Tip[] memory latest = tipJar.latestTips(2);
+        assertEq(latest.length, 2);
+        assertEq(latest[0].id, 3);
+        assertEq(latest[0].message, "third");
+        assertEq(latest[1].id, 2);
+        assertEq(latest[1].message, "second");
+    }
+
+    function testRejectsZeroAmount() public {
+        vm.startPrank(tipper);
+        usdc.approve(address(tipJar), 1);
+        vm.expectRevert(TipJar.InvalidAmount.selector);
+        tipJar.tip(0, "nope");
+        vm.stopPrank();
+    }
+
+    function testRejectsLongMessage() public {
+        string memory longMessage =
+            "this message is intentionally longer than one hundred sixty bytes so it should be rejected by the tip jar before it tries to transfer any USDC from the connected wallet";
+
+        vm.startPrank(tipper);
+        usdc.approve(address(tipJar), 1e6);
+        vm.expectRevert(TipJar.MessageTooLong.selector);
+        tipJar.tip(1e6, longMessage);
+        vm.stopPrank();
+    }
+}
