diff --git a/packages/foundry/scripts-js/seedForkUsdc.js b/packages/foundry/scripts-js/seedForkUsdc.js
new file mode 100644
index 0000000..f636683
--- /dev/null
+++ b/packages/foundry/scripts-js/seedForkUsdc.js
@@ -0,0 +1,83 @@
+import { ethers } from "ethers";
+
+const USDC_ADDRESS = "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913";
+const DEFAULT_WHALE = "0xf70202e3bbb8e42208a4fb5efc0780acb4fc8260";
+const DEFAULT_RECIPIENTS = [
+  "0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266",
+  "0x70997970C51812dc3A010C7d01b50e0d17dc79C8",
+];
+
+const rpcUrl = process.env.RPC_URL || "http://127.0.0.1:8545";
+const whale = process.env.USDC_WHALE || DEFAULT_WHALE;
+const seedAmount = process.env.SEED_USDC_AMOUNT || "50";
+const recipients = (process.env.SEED_RECIPIENTS || DEFAULT_RECIPIENTS.join(","))
+  .split(",")
+  .map((address) => address.trim())
+  .filter(Boolean);
+
+const provider = new ethers.providers.JsonRpcProvider(rpcUrl);
+const usdc = new ethers.Contract(
+  USDC_ADDRESS,
+  [
+    "function balanceOf(address account) view returns (uint256)",
+    "function transfer(address to, uint256 amount) returns (bool)",
+  ],
+  provider
+);
+
+const formatUsdc = (amount) => ethers.utils.formatUnits(amount, 6);
+
+async function main() {
+  if (recipients.length === 0) {
+    throw new Error("Set SEED_RECIPIENTS to at least one address.");
+  }
+
+  const network = await provider.getNetwork();
+  if (network.chainId !== 31337) {
+    throw new Error(
+      `Refusing to seed chain ${network.chainId}. Start the local Base fork with chain id 31337.`
+    );
+  }
+
+  const code = await provider.getCode(USDC_ADDRESS);
+  if (code === "0x") {
+    throw new Error(
+      "Base USDC code was not found. Start Anvil with --fork-url https://mainnet.base.org."
+    );
+  }
+
+  const amount = ethers.utils.parseUnits(seedAmount, 6);
+  const totalNeeded = amount.mul(recipients.length);
+  const whaleBalance = await usdc.balanceOf(whale);
+  if (whaleBalance.lt(totalNeeded)) {
+    throw new Error(
+      `USDC_WHALE only has ${formatUsdc(
+        whaleBalance
+      )} USDC on the fork, but ${formatUsdc(totalNeeded)} is needed.`
+    );
+  }
+
+  await provider.send("anvil_impersonateAccount", [whale]);
+  await provider.send("anvil_setBalance", [whale, "0x56BC75E2D63100000"]);
+
+  const whaleSigner = provider.getSigner(whale);
+  const seededUsdc = usdc.connect(whaleSigner);
+
+  for (const recipient of recipients) {
+    const tx = await seededUsdc.transfer(recipient, amount);
+    await tx.wait();
+    const balance = await usdc.balanceOf(recipient);
+    console.log(
+      `Seeded ${formatUsdc(amount)} USDC to ${recipient}. Balance: ${formatUsdc(
+        balance
+      )} USDC`
+    );
+  }
+
+  await provider.send("anvil_stopImpersonatingAccount", [whale]);
+}
+
+main().catch((error) => {
+  console.error(error);
+  process.exitCode = 1;
+});
