new file mode 100644
index 0000000..17ade31
--- /dev/null
+++ b/packages/foundry/test/USDCTipJar.t.sol
@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import { Test } from "forge-std/Test.sol";
+import { ERC20 } from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+import { USDCTipJar } from "../contracts/USDCTipJar.sol";
+
+contract MockUSDC is ERC20 {
+    constructor() ERC20("USD Coin", "USDC") { }
+
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    function mint(address to, uint256 amount) external {
+        _mint(to, amount);
+    }
+}
+
+contract USDCTipJarTest is Test {
+    address internal constant BASE_USDC = 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913;
+
+    address internal tipper = makeAddr("tipper");
+    address internal recipient = makeAddr("recipient");
+    MockUSDC internal usdc;
+    USDCTipJar internal tipJar;
+
+    function setUp() public {
+        usdc = new MockUSDC();
+        vm.etch(BASE_USDC, address(usdc).code);
+        MockUSDC(BASE_USDC).mint(tipper, 100e6);
+
+        tipJar = new USDCTipJar(recipient);
+    }
+
+    function testTipTransfersUSDCAndRecordsTotals() public {
+        vm.startPrank(tipper);
+        MockUSDC(BASE_USDC).approve(address(tipJar), 25e6);
+
+        vm.expectEmit(true, true, true, true, address(tipJar));
+        emit USDCTipJar.TipSent(1, tipper, recipient, 25e6, "shipping fund", block.timestamp);
+        tipJar.tip(25e6, "shipping fund");
+        vm.stopPrank();
+
+        assertEq(MockUSDC(BASE_USDC).balanceOf(tipper), 75e6);
+        assertEq(MockUSDC(BASE_USDC).balanceOf(recipient), 25e6);
+        assertEq(tipJar.tipCount(), 1);
+        assertEq(tipJar.totalTipped(), 25e6);
+        assertEq(tipJar.totalTippedBy(tipper), 25e6);
+    }
+
+    function testCannotTipZero() public {
+        vm.prank(tipper);
+        vm.expectRevert(USDCTipJar.AmountMustBeGreaterThanZero.selector);
+        tipJar.tip(0, "nope");
+    }
+
+    function testCannotDeployWithZeroRecipient() public {
+        vm.expectRevert(USDCTipJar.InvalidRecipient.selector);
+        new USDCTipJar(address(0));
+    }
+
+    function testCannotTipWithLongMessage() public {
+        string memory longMessage =
+            "this message is intentionally longer than one hundred sixty bytes so the contract rejects event spam before it tries to pull any USDC from the tipper and keeps the feed compact for the static site";
+
+        vm.prank(tipper);
+        vm.expectRevert(USDCTipJar.MessageTooLong.selector);
+        tipJar.tip(1e6, longMessage);
+    }
+}
