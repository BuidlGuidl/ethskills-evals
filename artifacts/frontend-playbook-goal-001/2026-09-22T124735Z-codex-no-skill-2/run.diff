+import { useAccount, useConfig, useReadContract, useWriteContract } from "wagmi";
+import {
+  useDeployedContractInfo,
+  useScaffoldEventHistory,
+  useScaffoldReadContract,
+  useScaffoldWriteContract,
+  useTargetNetwork,
+} from "~~/hooks/scaffold-eth";
+import { getParsedError, notification } from "~~/utils/scaffold-eth";
+
+const BASE_USDC_ADDRESS = "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913";
+const ZERO_ADDRESS = "0x0000000000000000000000000000000000000000";
+const USDC_DECIMALS = 6;
+
+const usdcAbi = [
+  {
+    type: "function",
+    name: "approve",
+    stateMutability: "nonpayable",
+    inputs: [
+      { name: "spender", type: "address" },
+      { name: "amount", type: "uint256" },
+    ],
+    outputs: [{ name: "", type: "bool" }],
+  },
+  {
+    type: "function",
+    name: "allowance",
+    stateMutability: "view",
+    inputs: [
+      { name: "owner", type: "address" },
+      { name: "spender", type: "address" },
+    ],
+    outputs: [{ name: "", type: "uint256" }],
+  },
+  {
+    type: "function",
+    name: "balanceOf",
+    stateMutability: "view",
+    inputs: [{ name: "account", type: "address" }],
+    outputs: [{ name: "", type: "uint256" }],
+  },
+] as const;
+
+const quickAmounts = ["1", "5", "10"];
+
+const formatUsdc = (amount?: bigint) => {
+  if (amount === undefined) return "0.00";
+  return Number(formatUnits(amount, USDC_DECIMALS)).toLocaleString(undefined, {
+    minimumFractionDigits: 2,
+    maximumFractionDigits: 2,
+  });
+};
+
+const Home: NextPage = () => {
+  const { address: connectedAddress } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+  const wagmiConfig = useConfig();
+  const [amount, setAmount] = useState("5");
+  const [message, setMessage] = useState("Thanks for building on Base.");
+  const [isSubmitting, setIsSubmitting] = useState(false);
+
+  const parsedAmount = useMemo(() => {
+    try {
+      return amount ? parseUnits(amount, USDC_DECIMALS) : 0n;
+    } catch {
+      return 0n;
+    }
+  }, [amount]);
+
+  const { data: tipJar } = useDeployedContractInfo({ contractName: "USDCTipJar" });
+  const { writeContractAsync: writeTokenAsync } = useWriteContract();
+  const { writeContractAsync: writeTipAsync, isMining } = useScaffoldWriteContract({ contractName: "USDCTipJar" });
+
+  const { data: recipient } = useScaffoldReadContract({
+    contractName: "USDCTipJar",
+    functionName: "recipient",
+  });
+
+  const { data: totalTipped } = useScaffoldReadContract({
+    contractName: "USDCTipJar",
+    functionName: "totalTipped",
+  });
+
+  const { data: tipCount } = useScaffoldReadContract({
+    contractName: "USDCTipJar",
+    functionName: "tipCount",
+  });
+
+  const { data: usdcBalance, refetch: refetchBalance } = useReadContract({
+    address: BASE_USDC_ADDRESS,
+    abi: usdcAbi,
+    functionName: "balanceOf",
+    args: [connectedAddress ?? ZERO_ADDRESS],
+    chainId: targetNetwork.id,
+    query: {
+      enabled: Boolean(connectedAddress),
+    },
+  });
+
+  const { data: allowance, refetch: refetchAllowance } = useReadContract({
+    address: BASE_USDC_ADDRESS,
+    abi: usdcAbi,
+    functionName: "allowance",
+    args: [connectedAddress ?? ZERO_ADDRESS, tipJar?.address ?? ZERO_ADDRESS],
+    chainId: targetNetwork.id,
+    query: {
+      enabled: Boolean(connectedAddress && tipJar?.address),
+    },
+  });
+
+  const { data: tips, isLoading: isFeedLoading, refetch: refetchTips } = useScaffoldEventHistory({
+    contractName: "USDCTipJar",
+    eventName: "TipSent",
+    watch: true,
+    blockData: true,
+    blocksBatchSize: 2000,
+  });
+
+  const needsApproval = parsedAmount > 0n && (allowance ?? 0n) < parsedAmount;
+  const isInvalidAmount = parsedAmount <= 0n || (amount.includes(".") && amount.split(".")[1].length > USDC_DECIMALS);
+  const isMessageTooLong = new TextEncoder().encode(message).length > 160;
+  const isDisabled =
+    !connectedAddress || !tipJar?.address || isInvalidAmount || isMessageTooLong || isSubmitting || isMining;
+
+  const handleSubmit = async (event: FormEvent) => {
+    event.preventDefault();
+    if (isDisabled) return;
+
+    try {
+      setIsSubmitting(true);
+
+      if (needsApproval) {
+        const approveHash = await writeTokenAsync({
+          address: BASE_USDC_ADDRESS,
+          abi: usdcAbi,
+          functionName: "approve",
+          args: [tipJar.address, parsedAmount],
+          chainId: targetNetwork.id,
+        });
+        await waitForTransactionReceipt(wagmiConfig, {
+          hash: approveHash,
+          chainId: targetNetwork.id,
+        });
+      }
+
+      await writeTipAsync({
+        functionName: "tip",
+        args: [parsedAmount, message],
+      });
+
+      notification.success("USDC tip sent");
+      await Promise.all([refetchBalance(), refetchAllowance(), refetchTips()]);
