+                <span className="grid h-7 w-7 place-items-center rounded-full bg-primary text-primary-content">$</span>
+                Base USDC
+              </div>
+              <h1 className="text-4xl font-bold tracking-normal sm:text-5xl">USDC Tip Jar</h1>
+              <p className="mt-3 max-w-2xl text-base text-base-content/70">
+                Send forked Base USDC locally, then ship the same static interface to IPFS.
+              </p>
+            </div>
+            <div className="stats stats-vertical border border-base-300 bg-base-200 sm:stats-horizontal">
+              <div className="stat min-w-36">
+                <div className="stat-title">Tips</div>
+                <div className="stat-value text-2xl">{tipCount?.toString() ?? "0"}</div>
+              </div>
+              <div className="stat min-w-44">
+                <div className="stat-title">Total</div>
+                <div className="stat-value text-2xl">{formatUsdc(totalTipped)} USDC</div>
+              </div>
+            </div>
+          </div>
+        </div>
+      </section>
+
+      <section className="mx-auto grid w-full max-w-6xl gap-6 px-4 py-6 sm:px-6 lg:grid-cols-[minmax(0,0.95fr)_minmax(340px,1.05fr)] lg:px-8">
+        <form onSubmit={handleSubmit} className="border border-base-300 bg-base-100 p-5 shadow-sm">
+          <div className="mb-5 flex items-center justify-between gap-3">
+            <div>
+              <h2 className="text-xl font-bold">Send Tip</h2>
+              <div className="mt-1 text-sm text-base-content/70">Balance: {formatUsdc(usdcBalance)} USDC</div>
+            </div>
+            <BanknotesIcon className="h-8 w-8 text-primary" />
+          </div>
+
+          <label className="form-control">
+            <span className="label pb-2">
+              <span className="label-text font-semibold">Amount</span>
+            </span>
+            <div className="join w-full">
+              <input
+                className="input join-item input-bordered w-full text-lg"
+                inputMode="decimal"
+                min="0"
+                placeholder="5.00"
+                step="0.01"
+                type="number"
+                value={amount}
+                onChange={event => setAmount(event.target.value)}
+              />
+              <span className="join-item flex min-w-20 items-center justify-center border border-base-300 bg-base-200 px-4 font-semibold">
+                USDC
+              </span>
+            </div>
+          </label>
+
+          <div className="mt-3 flex flex-wrap gap-2">
+            {quickAmounts.map(value => (
+              <button
+                className={`btn btn-sm ${amount === value ? "btn-primary" : "btn-outline"}`}
+                key={value}
+                type="button"
+                onClick={() => setAmount(value)}
+              >
+                ${value}
+              </button>
+            ))}
+          </div>
+
+          <label className="form-control mt-5">
+            <span className="label pb-2">
+              <span className="label-text font-semibold">Message</span>
+              <span className={`label-text-alt ${isMessageTooLong ? "text-error" : ""}`}>
+                {new TextEncoder().encode(message).length}/160
+              </span>
+            </span>
+            <textarea
+              className="textarea textarea-bordered min-h-28 resize-none"
+              maxLength={160}
+              value={message}
+              onChange={event => setMessage(event.target.value)}
+            />
+          </label>
+
+          <button className="btn btn-primary mt-6 w-full" disabled={isDisabled} type="submit">
+            {isSubmitting || isMining ? (
+              <span className="loading loading-spinner" />
+            ) : (
+              <PaperAirplaneIcon className="h-5 w-5" />
+            )}
+            {needsApproval ? "Approve and Tip" : "Send Tip"}
+          </button>
+
+          {!connectedAddress && <div className="alert alert-warning mt-4">Connect a local wallet to tip.</div>}
+          {!tipJar?.address && <div className="alert alert-error mt-4">Deploy USDCTipJar to the local fork.</div>}
+          {isInvalidAmount && amount && <div className="alert alert-error mt-4">Enter a positive USDC amount.</div>}
+        </form>
+
+        <div className="flex flex-col gap-6">
+          <div className="border border-base-300 bg-base-100 p-5 shadow-sm">
+            <div className="mb-4 flex items-center justify-between gap-3">
+              <h2 className="text-xl font-bold">Jar</h2>
+              <SignalIcon className="h-7 w-7 text-success" />
+            </div>
+            <div className="grid gap-4">
+              <div>
+                <div className="mb-2 text-sm font-semibold text-base-content/70">Connected</div>
+                <Address address={connectedAddress} chain={targetNetwork} />
+              </div>
+              <div>
+                <div className="mb-2 text-sm font-semibold text-base-content/70">Recipient</div>
+                <Address address={recipient} chain={targetNetwork} />
+              </div>
+              <div>
+                <div className="mb-2 text-sm font-semibold text-base-content/70">Contract</div>
+                <Address address={tipJar?.address} chain={targetNetwork} />
+              </div>
+            </div>
+          </div>
+
+          <div className="border border-base-300 bg-base-100 p-5 shadow-sm">
+            <div className="mb-4 flex items-center justify-between gap-3">
+              <h2 className="text-xl font-bold">Feed</h2>
+              <button className="btn btn-ghost btn-sm" type="button" onClick={() => refetchTips()}>
+                <ArrowPathIcon className="h-5 w-5" />
+              </button>
+            </div>
+            <div className="flex max-h-[34rem] flex-col gap-3 overflow-y-auto pr-1">
+              {isFeedLoading && (
+                <div className="flex items-center gap-3 border border-base-300 bg-base-200 p-4">
+                  <span className="loading loading-spinner" />
+                  <span className="font-medium">Loading feed</span>
+                </div>
+              )}
+              {!isFeedLoading && tips?.length === 0 && (
+                <div className="border border-dashed border-base-300 bg-base-200 p-6 text-center text-base-content/70">
+                  No tips yet.
+                </div>
+              )}
+              {tips?.map(tip => (
+                <article className="border border-base-300 bg-base-200 p-4" key={`${tip.transactionHash}-${tip.logIndex}`}>
+                  <div className="mb-3 flex items-start justify-between gap-3">
+                    <div>
+                      <div className="text-lg font-bold">{formatUsdc(tip.args.amount)} USDC</div>
+                      <div className="text-xs text-base-content/60">Tip #{tip.args.tipId?.toString()}</div>
+                    </div>
+                    <CheckCircleIcon className="h-6 w-6 shrink-0 text-success" />
+                  </div>
+                  <p className="my-3 break-words text-base">{tip.args.message}</p>
+                  <div className="flex flex-col gap-2 text-sm">
+                    <div>
+                      <span className="font-semibold text-base-content/70">From </span>
+                      <Address address={tip.args.tipper} chain={targetNetwork} />
+                    </div>
+                    <div className="text-base-content/60">
+                      {tip.args.timestamp ? new Date(Number(tip.args.timestamp) * 1000).toLocaleString() : "Pending"}
+                    </div>
+                  </div>
+                </article>
+              ))}
+            </div>
+          </div>
+        </div>
+      </section>
+    </main>
+  );
+};
+
+export default Home;
