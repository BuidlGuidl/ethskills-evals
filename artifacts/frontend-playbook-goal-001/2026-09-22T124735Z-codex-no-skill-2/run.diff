index 0000000..c4e50c3
--- /dev/null
+++ b/packages/foundry/contracts/USDCTipJar.sol
@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { SafeERC20 } from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+
+contract USDCTipJar {
+    using SafeERC20 for IERC20;
+
+    error AmountMustBeGreaterThanZero();
+    error InvalidRecipient();
+    error MessageTooLong();
+
+    address public constant BASE_USDC = 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913;
+    uint256 public constant MAX_MESSAGE_LENGTH = 160;
+
+    IERC20 public immutable usdc;
+    address public immutable recipient;
+    uint256 public tipCount;
+    uint256 public totalTipped;
+    mapping(address tipper => uint256 amount) public totalTippedBy;
+
+    event TipSent(
+        uint256 indexed tipId,
+        address indexed tipper,
+        address indexed recipient,
+        uint256 amount,
+        string message,
+        uint256 timestamp
+    );
+
+    constructor(address _recipient) {
+        if (_recipient == address(0)) {
+            revert InvalidRecipient();
+        }
+
+        usdc = IERC20(BASE_USDC);
+        recipient = _recipient;
+    }
+
+    function tip(uint256 amount, string calldata message) external {
+        if (amount == 0) {
+            revert AmountMustBeGreaterThanZero();
+        }
+        if (bytes(message).length > MAX_MESSAGE_LENGTH) {
+            revert MessageTooLong();
+        }
+
+        tipCount += 1;
+        totalTipped += amount;
+        totalTippedBy[msg.sender] += amount;
+
+        usdc.safeTransferFrom(msg.sender, recipient, amount);
+
+        emit TipSent(tipCount, msg.sender, recipient, amount, message, block.timestamp);
+    }
+}
