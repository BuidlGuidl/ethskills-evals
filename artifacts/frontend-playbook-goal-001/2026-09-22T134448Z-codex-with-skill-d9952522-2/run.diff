diff --git a/packages/foundry/test/USDCTipJar.t.sol b/packages/foundry/test/USDCTipJar.t.sol
new file mode 100644
index 0000000..5482ea8
--- /dev/null
+++ b/packages/foundry/test/USDCTipJar.t.sol
@@ -0,0 +1,96 @@
+// SPDX-License-Identifier: UNLICENSED
+pragma solidity ^0.8.20;
+
+import { Test } from "forge-std/Test.sol";
+import { ERC20 } from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+import { USDCTipJar } from "../contracts/USDCTipJar.sol";
+
+contract MockUSDC is ERC20 {
+    constructor() ERC20("USD Coin", "USDC") { }
+
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    function mint(address to, uint256 amount) external {
+        _mint(to, amount);
+    }
+}
+
+contract USDCTipJarTest is Test {
+    address public constant BASE_USDC = 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913;
+
+    USDCTipJar public tipJar;
+    MockUSDC public usdc;
+
+    address public recipient = makeAddr("recipient");
+    address public tipper = makeAddr("tipper");
+
+    event Tip(address indexed tipper, uint256 amount, string message, uint256 timestamp);
+    event Withdraw(address indexed recipient, uint256 amount);
+
+    function setUp() public {
+        MockUSDC mockUsdc = new MockUSDC();
+        vm.etch(BASE_USDC, address(mockUsdc).code);
+        usdc = MockUSDC(BASE_USDC);
+        tipJar = new USDCTipJar(recipient);
+
+        usdc.mint(tipper, 100e6);
+    }
+
+    function testTipTransfersUSDCIntoJarAndEmitsFeedEvent() public {
+        vm.startPrank(tipper);
+        usdc.approve(address(tipJar), 25e6);
+
+        vm.expectEmit(true, false, false, true, address(tipJar));
+        emit Tip(tipper, 25e6, "keep building", block.timestamp);
+        tipJar.tip(25e6, "keep building");
+        vm.stopPrank();
+
+        assertEq(usdc.balanceOf(address(tipJar)), 25e6);
+        assertEq(usdc.balanceOf(tipper), 75e6);
+        assertEq(tipJar.totalTips(), 25e6);
+        assertEq(tipJar.tipCount(), 1);
+        assertEq(tipJar.totalTippedBy(tipper), 25e6);
+    }
+
+    function testRecipientCanWithdrawTips() public {
+        vm.startPrank(tipper);
+        usdc.approve(address(tipJar), 10e6);
+        tipJar.tip(10e6, "");
+        vm.stopPrank();
+
+        vm.prank(recipient);
+        vm.expectEmit(true, false, false, true, address(tipJar));
+        emit Withdraw(recipient, 10e6);
+        tipJar.withdraw(10e6);
+
+        assertEq(usdc.balanceOf(address(tipJar)), 0);
+        assertEq(usdc.balanceOf(recipient), 10e6);
+    }
+
+    function testOnlyRecipientCanWithdraw() public {
+        vm.prank(tipper);
+        vm.expectRevert(USDCTipJar.OnlyRecipient.selector);
+        tipJar.withdraw(1);
+    }
+
+    function testRejectsZeroTips() public {
+        vm.prank(tipper);
+        vm.expectRevert(USDCTipJar.ZeroAmount.selector);
+        tipJar.tip(0, "");
+    }
+
+    function testRejectsLongMessages() public {
+        bytes memory tooLong = new bytes(281);
+        for (uint256 i = 0; i < tooLong.length; i++) {
+            tooLong[i] = "x";
+        }
+
+        vm.startPrank(tipper);
+        usdc.approve(address(tipJar), 1e6);
+        vm.expectRevert(USDCTipJar.MessageTooLong.selector);
+        tipJar.tip(1e6, string(tooLong));
+        vm.stopPrank();
+    }
+}
