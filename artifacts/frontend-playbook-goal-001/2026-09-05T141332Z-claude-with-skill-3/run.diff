diff --git a/packages/foundry/contracts/TipJar.sol b/packages/foundry/contracts/TipJar.sol
new file mode 100644
index 0000000..7a320ff
--- /dev/null
+++ b/packages/foundry/contracts/TipJar.sol
@@ -0,0 +1,124 @@
+//SPDX-License-Identifier: MIT
+pragma solidity ^0.8.19;
+
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { SafeERC20 } from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+import { Ownable } from "@openzeppelin/contracts/access/Ownable.sol";
+
+/**
+ * A tip jar that collects tips in a single ERC-20 token (USDC on Base).
+ *
+ * Tips are kept in contract storage rather than derived from logs so the feed can be read with a
+ * plain `eth_call` from a static frontend, with no log-range scanning and no indexer.
+ *
+ * @dev Accounting assumes a standard ERC-20 that moves exactly the requested amount: the recorded
+ * tip is the amount asked for, not a measured balance delta. Fee-on-transfer and rebasing tokens
+ * would make the feed disagree with the balance. USDC is neither.
+ *
+ * @author BuidlGuidl
+ */
+contract TipJar is Ownable {
+    using SafeERC20 for IERC20;
+
+    struct Tip {
+        // sender + timestamp share one storage slot
+        address sender;
+        uint64 timestamp;
+        uint256 amount;
+        string message;
+    }
+
+    uint256 public constant MAX_MESSAGE_LENGTH = 140;
+
+    /// @notice The only token this jar accepts. USDC on Base: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
+    IERC20 public immutable token;
+
+    Tip[] private tips;
+
+    /// @notice Total ever tipped, in token units. Not reduced by withdrawals.
+    uint256 public totalTipped;
+
+    mapping(address sender => uint256 total) public totalTippedBy;
+
+    event Tipped(address indexed sender, uint256 amount, string message, uint256 index);
+    event Withdrawn(address indexed to, uint256 amount);
+
+    error AmountIsZero();
+    error MessageTooLong(uint256 length);
+    error NothingToWithdraw();
+    error OwnershipCannotBeRenounced();
+    error InvalidRecipient();
+    error TokenHasNoCode();
+
+    constructor(IERC20 _token, address _owner) Ownable(_owner) {
+        if (address(_token).code.length == 0) revert TokenHasNoCode();
+        token = _token;
+    }
+
+    /**
+     * Pulls `amount` of `token` from the caller into the jar and appends it to the feed.
+     * The caller must have approved the jar for at least `amount` first.
+     */
+    function tip(uint256 amount, string calldata message) external {
+        if (amount == 0) revert AmountIsZero();
+        if (bytes(message).length > MAX_MESSAGE_LENGTH) revert MessageTooLong(bytes(message).length);
+
+        // Recorded before the transfer so the feed matches the emitted event even if the token
+        // implementation calls back. USDC does not, but the jar takes the token as a parameter.
+        uint256 index = tips.length;
+        tips.push(Tip({ sender: msg.sender, timestamp: uint64(block.timestamp), amount: amount, message: message }));
+        totalTipped += amount;
+        totalTippedBy[msg.sender] += amount;
+
+        token.safeTransferFrom(msg.sender, address(this), amount);
+
+        emit Tipped(msg.sender, amount, message, index);
+    }
+
+    /// @notice Sends the jar's whole balance to `to`.
+    function withdraw(address to) external onlyOwner {
+        if (to == address(0)) revert InvalidRecipient();
+
+        uint256 amount = token.balanceOf(address(this));
+        if (amount == 0) revert NothingToWithdraw();
+
+        token.safeTransfer(to, amount);
+
+        emit Withdrawn(to, amount);
+    }
+
+    /// @dev The jar custodies other people's money. An ownerless jar could never be emptied again.
+    function renounceOwnership() public pure override {
+        revert OwnershipCannotBeRenounced();
+    }
+
+    function tipCount() external view returns (uint256) {
+        return tips.length;
+    }
+
+    function balance() external view returns (uint256) {
+        return token.balanceOf(address(this));
+    }
+
+    /**
+     * Newest-first page of the feed. `offset` counts back from the most recent tip, so
+     * `getLatestTips(0, 10)` is the ten newest tips and `getLatestTips(10, 10)` is the ten before those.
+     * Returns fewer than `limit` entries (possibly none) when the page runs past the oldest tip.
+     *
+     * `total` is the feed length at the time of the call. It comes back with the page so a caller can
+     * work out each entry's position in the feed — `total - offset - 1 - i` for `page[i]` — without a
+     * second call that might land on a different block.
+     */
+    function getLatestTips(uint256 offset, uint256 limit) external view returns (Tip[] memory page, uint256 total) {
+        total = tips.length;
+        if (offset >= total) return (new Tip[](0), total);
+
+        uint256 remaining = total - offset;
+        uint256 size = remaining < limit ? remaining : limit;
+
+        page = new Tip[](size);
+        for (uint256 i = 0; i < size; i++) {
+            page[i] = tips[total - offset - 1 - i];
+        }
+    }
+}
