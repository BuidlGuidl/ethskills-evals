index b57486d..512e5b4 100644
--- a/packages/nextjs/.env.example
+++ b/packages/nextjs/.env.example
@@ -12,3 +12,11 @@
 NEXT_PUBLIC_ALCHEMY_API_KEY=
 NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
 
+
+# Absolute origin of the live site. A static IPFS build has no server to infer its own origin, so
+# without this og:image and the canonical URL point at localhost. Required for the IPFS build.
+NEXT_PUBLIC_PRODUCTION_URL=
+
+# Dedicated Base RPC for the production build. Without it Base falls back to the shared
+# Scaffold-ETH Alchemy key, which is rate-limited and not meant to carry a live site.
+NEXT_PUBLIC_BASE_RPC_URL=
