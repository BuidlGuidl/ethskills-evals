diff --git a/packages/nextjs/polyfill-localstorage.cjs b/packages/nextjs/polyfill-localstorage.cjs
new file mode 100644
index 0000000..7a5e8c9
--- /dev/null
+++ b/packages/nextjs/polyfill-localstorage.cjs
@@ -0,0 +1,33 @@
+/**
+ * Node 25 exposes a `localStorage` global, but with no backing file configured it is a truthy
+ * object without the Web Storage methods. Libraries that feature-detect it — next-themes,
+ * RainbowKit, wagmi — find the global and then crash on `localStorage.getItem is not a function`,
+ * which shows up as a 500 in `next dev` and as "Error occurred prerendering page" in `next build`.
+ *
+ * Next.js prerenders in separate worker processes, so a fix inside next.config.ts or
+ * instrumentation.ts never reaches the code that crashes. This file is loaded through NODE_OPTIONS
+ * (see the `dev` and `build` scripts in package.json), which every child process inherits.
+ *
+ * A `--require` shim rather than `--no-experimental-webstorage`: that flag only exists on Node 25,
+ * and this package supports Node >= 20.18.3, where an unknown flag is a hard startup error.
+ */
+if (typeof globalThis.localStorage !== "undefined" && typeof globalThis.localStorage.getItem !== "function") {
+  const store = new Map();
+
+  // defineProperty rather than assignment: `localStorage` is installed as an accessor, and a bare
+  // assignment to a getter-only global fails silently in sloppy-mode CJS, leaving a no-op shim.
+  Object.defineProperty(globalThis, "localStorage", {
+    configurable: true,
+    writable: true,
+    value: {
+      getItem: key => (store.has(String(key)) ? store.get(String(key)) : null),
+      setItem: (key, value) => void store.set(String(key), String(value)),
+      removeItem: key => void store.delete(String(key)),
+      clear: () => store.clear(),
+      key: index => [...store.keys()][index] ?? null,
+      get length() {
+        return store.size;
+      },
+    },
+  });
+}
