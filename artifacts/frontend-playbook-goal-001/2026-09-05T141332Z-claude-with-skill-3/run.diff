diff --git a/packages/foundry/scripts-js/fundDemoUsdc.js b/packages/foundry/scripts-js/fundDemoUsdc.js
new file mode 100644
index 0000000..02aea8f
--- /dev/null
+++ b/packages/foundry/scripts-js/fundDemoUsdc.js
@@ -0,0 +1,180 @@
+/**
+ * Moves real Base USDC to demo identities on a local Base fork.
+ *
+ * The fork is a local copy of Base, so impersonating a real holder and transferring its balance
+ * costs nothing and is broadcast nowhere. That is what makes the demo use real USDC with no real
+ * money at risk. Never point this at a live network — it only works against anvil anyway.
+ *
+ * Usage:
+ *   yarn fund:usdc                          # 1000 USDC to anvil accounts #0, #1, #2
+ *   yarn fund:usdc 0xabc... 0xdef...        # 1000 USDC to the given addresses instead
+ *   yarn fund:usdc --amount 250 0xabc...    # 250 USDC to one address
+ *   yarn fund:usdc --whale 0x...            # take the USDC from a specific holder
+ */
+import { spawnSync } from "child_process";
+
+const RPC_URL = process.env.RPC_URL || "http://127.0.0.1:8545";
+const USDC = "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913";
+const USDC_DECIMALS = 6n;
+
+// Anvil's first three prefunded accounts. Deterministic, so they can be imported into a browser
+// wallet once and stay funded across fork restarts.
+const DEFAULT_RECIPIENTS = [
+  "0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266",
+  "0x70997970C51812dc3A010C7d01b50e0d17dc79C8",
+  "0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC",
+];
+
+// Real Base USDC holders, richest first. The script picks the first one that still holds enough,
+// so a balance moving on mainnet does not break the demo.
+const WHALES = [
+  {
+    address: "0x4e65fE4DbA92790696d040ac24Aa414708F5c0AB",
+    label: "Aave v3 Base USDC reserve",
+  },
+  {
+    address: "0x20FE51A9229EEf2cF8Ad9E89d91CAb9312cF3b7A",
+    label: "USDC EOA holder",
+  },
+  {
+    address: "0xcDAC0d6c6C59727a65F871236188350531885C43",
+    label: "Aerodrome vAMM WETH/USDC",
+  },
+];
+
+const cast = (...args) => {
+  const result = spawnSync("cast", args, { encoding: "utf8" });
+  if (result.error) {
+    if (result.error.code === "ENOENT")
+      die("`cast` not found. Install Foundry: https://getfoundry.sh");
+    throw result.error;
+  }
+  if (result.status !== 0)
+    die(`cast ${args.slice(0, 2).join(" ")} failed:\n${result.stderr.trim()}`);
+  return result.stdout.trim();
+};
+
+const die = (message) => {
+  console.error(`\n❌ ${message}\n`);
+  process.exit(1);
+};
+
+const formatUsdc = (units) =>
+  `${(Number(units) / 1e6).toLocaleString("en-US")} USDC`;
+
+const parseArgs = (argv) => {
+  const recipients = [];
+  let amount = 1000n;
+  let whale = null;
+
+  for (let i = 0; i < argv.length; i++) {
+    if (argv[i] === "--amount" && argv[i + 1]) {
+      amount = BigInt(argv[++i]);
+    } else if (argv[i] === "--whale" && argv[i + 1]) {
+      whale = { address: argv[++i], label: "holder passed with --whale" };
+    } else if (/^0x[0-9a-fA-F]{40}$/.test(argv[i])) {
+      recipients.push(argv[i]);
+    } else {
+      die(`Unrecognised argument: ${argv[i]}`);
+    }
+  }
+
+  return {
+    recipients: recipients.length ? recipients : DEFAULT_RECIPIENTS,
+    amount,
+    whale,
+  };
+};
+
+const balanceOf = (holder) =>
+  BigInt(
+    cast(
+      "call",
+      USDC,
+      "balanceOf(address)(uint256)",
+      holder,
+      "--rpc-url",
+      RPC_URL
+    ).split(" ")[0]
+  );
+
+const main = () => {
+  const {
+    recipients,
+    amount,
+    whale: requestedWhale,
+  } = parseArgs(process.argv.slice(2));
+  const amountUnits = amount * 10n ** USDC_DECIMALS;
+
+  const chainId = cast("chain-id", "--rpc-url", RPC_URL);
+  if (chainId !== "31337") {
+    die(
+      `Expected the local fork on chain 31337 at ${RPC_URL}, got chain ${chainId}. This script only runs against anvil.`
+    );
+  }
+
+  if (cast("code", USDC, "--rpc-url", RPC_URL) === "0x") {
+    die(
+      `No USDC at ${USDC}. This is a bare chain, not a Base fork — start one with:\n\n   yarn fork --network base`
+    );
+  }
+
+  const needed = amountUnits * BigInt(recipients.length);
+  const candidates = requestedWhale ? [requestedWhale] : WHALES;
+  const whale = candidates.find(
+    (candidate) => balanceOf(candidate.address) >= needed
+  );
+  if (!whale) {
+    die(
+      `None of the known holders still has ${formatUsdc(needed)} on Base.\n` +
+        `   Pick a current holder from https://basescan.org/token/${USDC}#balances and pass it:\n\n` +
+        `   yarn fund:usdc --whale 0x...`
+    );
+  }
+
+  console.log(`\n🍯 Funding from ${whale.label} (${whale.address})`);
+  console.log(`   holds ${formatUsdc(balanceOf(whale.address))}\n`);
+
+  cast("rpc", "anvil_impersonateAccount", whale.address, "--rpc-url", RPC_URL);
+  // The holder may be a contract with no ETH; it still needs gas to send on the fork.
+  cast(
+    "rpc",
+    "anvil_setBalance",
+    whale.address,
+    "0xde0b6b3a7640000",
+    "--rpc-url",
+    RPC_URL
+  );
+
+  try {
+    for (const recipient of recipients) {
+      cast(
+        "send",
+        USDC,
+        "transfer(address,uint256)",
+        recipient,
+        amountUnits.toString(),
+        "--from",
+        whale.address,
+        "--unlocked",
+        "--rpc-url",
+        RPC_URL
+      );
+      console.log(`   ✅ ${recipient}  →  ${formatUsdc(balanceOf(recipient))}`);
+    }
+  } finally {
+    cast(
+      "rpc",
+      "anvil_stopImpersonatingAccount",
+      whale.address,
+      "--rpc-url",
+      RPC_URL
+    );
+  }
+
+  console.log(
+    "\n   Import these accounts into your wallet to tip between them (see README.md).\n"
+  );
+};
+
+main();
