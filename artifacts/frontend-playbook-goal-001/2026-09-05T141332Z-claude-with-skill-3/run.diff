@@ -0,0 +1,61 @@
+"use client";
+
+import { useState } from "react";
+import { AddressInput } from "@scaffold-ui/components";
+import { isAddress } from "viem";
+import { useAccount } from "wagmi";
+import { useScaffoldReadContract, useScaffoldWriteContract } from "~~/hooks/scaffold-eth";
+import { formatUsdc } from "~~/utils/usdc";
+
+/** Only rendered for the jar owner. Everyone else gets nothing. */
+export const OwnerWithdraw = () => {
+  const { address: connectedAddress } = useAccount();
+  const [recipient, setRecipient] = useState("");
+
+  const { data: owner } = useScaffoldReadContract({ contractName: "TipJar", functionName: "owner" });
+  const { data: balance } = useScaffoldReadContract({ contractName: "TipJar", functionName: "balance" });
+  const { writeContractAsync, isMining } = useScaffoldWriteContract({ contractName: "TipJar" });
+
+  if (!connectedAddress || !owner || connectedAddress.toLowerCase() !== owner.toLowerCase()) return null;
+
+  // AddressInput hands back whatever is typed, including half-written addresses and ENS names it
+  // has not resolved yet. Only a real address is a destination.
+  const destination = recipient === "" ? connectedAddress : isAddress(recipient) ? recipient : undefined;
+  const isEmpty = balance === 0n;
+
+  const handleWithdraw = async () => {
+    if (!destination) return;
+    try {
+      const txHash = await writeContractAsync({ functionName: "withdraw", args: [destination] });
+      if (!txHash) return;
+      setRecipient("");
+    } catch (error) {
+      console.error("withdraw failed", error);
+    }
+  };
+
+  return (
+    <div className="card bg-base-100 border border-base-300">
+      <div className="card-body gap-4">
+        <h2 className="card-title">
+          Owner
+          <span className="badge badge-ghost badge-sm">${formatUsdc(balance ?? 0n)} to collect</span>
+        </h2>
+        <AddressInput
+          value={recipient}
+          onChange={setRecipient}
+          disabled={isMining}
+          placeholder={`Send to (defaults to you)`}
+        />
+        <button
+          className="btn btn-secondary"
+          disabled={isMining || isEmpty || balance === undefined || !destination}
+          onClick={handleWithdraw}
+        >
+          {isMining && <span className="loading loading-spinner loading-sm" />}
+          {isEmpty ? "Jar is empty" : !destination ? "Enter a valid address" : "Withdraw everything"}
+        </button>
+      </div>
+    </div>
+  );
+};
diff --git a/packages/nextjs/app/_components/TipFeed.tsx b/packages/nextjs/app/_components/TipFeed.tsx
new file mode 100644
index 0000000..af0f1c6
--- /dev/null
+++ b/packages/nextjs/app/_components/TipFeed.tsx
@@ -0,0 +1,105 @@
+"use client";
+
+import { useState } from "react";
+import { Address } from "@scaffold-ui/components";
+import { hardhat } from "viem/chains";
+import { useScaffoldReadContract, useTargetNetwork } from "~~/hooks/scaffold-eth";
+import { formatUsdc } from "~~/utils/usdc";
+
+const PAGE_SIZE = 10n;
+// The whole visible page is re-read on every block, so it has to stay bounded. A jar that needs
+// deeper history than this wants an indexer, not a bigger eth_call.
+const MAX_VISIBLE = 50n;
+
+const formatTimeAgo = (timestamp: bigint) => {
+  const seconds = Math.max(0, Math.floor(Date.now() / 1000) - Number(timestamp));
+  if (seconds < 60) return "just now";
+  const minutes = Math.floor(seconds / 60);
+  if (minutes < 60) return `${minutes}m ago`;
+  const hours = Math.floor(minutes / 60);
+  if (hours < 24) return `${hours}h ago`;
+  return `${Math.floor(hours / 24)}d ago`;
+};
+
+export const TipFeed = () => {
+  const [limit, setLimit] = useState(PAGE_SIZE);
+  const { targetNetwork } = useTargetNetwork();
+  // On the local fork the only block explorer would be Scaffold-ETH's own, which this app drops
+  // for the static export — so the addresses are plain text there rather than dead links.
+  const disableAddressLink = targetNetwork.id === hardhat.id;
+
+  // One call returns the page and the feed length, so the "load more" check and the per-tip feed
+  // position always come from the same block.
+  const { data, isLoading, isFetching, error } = useScaffoldReadContract({
+    contractName: "TipJar",
+    functionName: "getLatestTips",
+    args: [0n, limit],
+  });
+
+  const feed = data && { tips: data[0], total: data[1] };
+  const hasMore = feed !== undefined && feed.total > limit && limit < MAX_VISIBLE;
+
+  return (
+    <div className="card bg-base-100 border border-base-300">
+      <div className="card-body gap-4">
+        <h2 className="card-title">Recent tips</h2>
+
+        {error ? (
+          // Without this an unreachable RPC looks exactly like an empty jar.
+          <div className="alert alert-error text-sm">Could not reach the network to load the feed.</div>
+        ) : isLoading && !feed ? (
+          <div className="flex flex-col gap-3">
+            {[0, 1, 2].map(row => (
+              <div key={row} className="skeleton h-16 w-full" />
+            ))}
+          </div>
+        ) : !feed?.tips.length ? (
+          <p className="opacity-60 m-0">No tips yet. Be the first.</p>
+        ) : (
+          <ul className="list-none flex flex-col gap-3 p-0 m-0">
+            {feed.tips.map((tip, index) => {
+              // Position in the append-only feed, newest first. A plain array index would shift
+              // under every row each time a tip arrives.
+              // Kept out of the JSX attribute: eslint-plugin-jsx-a11y tries to constant-fold
+              // attribute expressions and throws on BigInt arithmetic.
+              const feedPosition = String(feed.total - 1n - BigInt(index));
+              return (
+                <li key={feedPosition} className="flex flex-col gap-1 bg-base-200 rounded-box p-3">
+                  <div className="flex items-center justify-between gap-2">
+                    <Address
+                      address={tip.sender}
+                      chain={targetNetwork}
+                      size="sm"
+                      onlyEnsOrAddress
+                      disableAddressLink={disableAddressLink}
+                    />
+                    <span className="badge badge-primary badge-sm whitespace-nowrap">${formatUsdc(tip.amount)}</span>
+                  </div>
+                  {tip.message && <p className="m-0 text-sm break-words">{tip.message}</p>}
+                  <span className="text-xs opacity-50">{formatTimeAgo(tip.timestamp)}</span>
+                </li>
+              );
+            })}
+          </ul>
+        )}
+
+        {hasMore && (
+          <button
+            className="btn btn-sm btn-ghost self-center"
+            disabled={isFetching}
+            onClick={() => setLimit(current => (current + PAGE_SIZE > MAX_VISIBLE ? MAX_VISIBLE : current + PAGE_SIZE))}
+          >
+            {isFetching && <span className="loading loading-spinner loading-xs" />}
+            Load more
+          </button>
+        )}
+
+        {feed !== undefined && feed.total > MAX_VISIBLE && limit >= MAX_VISIBLE && (
+          <p className="text-xs opacity-60 m-0 self-center">
+            Showing the {MAX_VISIBLE.toString()} most recent of {feed.total.toString()} tips.
+          </p>
+        )}
+      </div>
+    </div>
+  );
+};
diff --git a/packages/nextjs/app/_components/TipForm.tsx b/packages/nextjs/app/_components/TipForm.tsx
new file mode 100644
index 0000000..14469db
--- /dev/null
+++ b/packages/nextjs/app/_components/TipForm.tsx
@@ -0,0 +1,164 @@
+"use client";
+
+import { useMemo, useState } from "react";
+import { BaseInput } from "@scaffold-ui/components";
+import { useAccount } from "wagmi";
+import { useDeployedContractInfo, useScaffoldReadContract, useScaffoldWriteContract } from "~~/hooks/scaffold-eth";
+import { formatUsdc, isUsdcInput, parseUsdcInput } from "~~/utils/usdc";
+
+/** Matches `TipJar.MAX_MESSAGE_LENGTH`. The contract counts bytes, so the counter below does too. */
+const MAX_MESSAGE_BYTES = 140;
+const QUICK_AMOUNTS = ["1", "5", "25"];
+
+export const TipForm = () => {
+  const [amount, setAmount] = useState("");
+  const [message, setMessage] = useState("");
+
+  const { address: connectedAddress } = useAccount();
+  const { data: jar } = useDeployedContractInfo({ contractName: "TipJar" });
+
+  const { data: usdcBalance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "balanceOf",
+    args: [connectedAddress],
+  });
+  const { data: allowance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "allowance",
+    args: [connectedAddress, jar?.address],
+  });
+  const { data: tippedSoFar } = useScaffoldReadContract({
+    contractName: "TipJar",
+    functionName: "totalTippedBy",
+    args: [connectedAddress],
+  });
+
+  const { writeContractAsync: writeUsdc, isMining: isApproving } = useScaffoldWriteContract({ contractName: "USDC" });
+  const { writeContractAsync: writeTipJar, isMining: isTipping } = useScaffoldWriteContract({
+    contractName: "TipJar",
+  });
+
+  const parsedAmount = useMemo(() => parseUsdcInput(amount), [amount]);
+  // One emoji is a single textarea character but four bytes onchain, so count what the contract counts.
+  const messageBytes = useMemo(() => new TextEncoder().encode(message).length, [message]);
+
+  // Until the allowance and balance are in, "does this need an approval" has no answer — offering
+  // "Send tip" on that guess sends a transaction that reverts on the allowance check.
+  const isReady = allowance !== undefined && usdcBalance !== undefined;
+  const isOverBalance = parsedAmount !== undefined && usdcBalance !== undefined && parsedAmount > usdcBalance;
+  const isMessageTooLong = messageBytes > MAX_MESSAGE_BYTES;
+  const needsApproval = parsedAmount !== undefined && allowance !== undefined && allowance < parsedAmount;
+  const isBusy = isApproving || isTipping;
+
+  const handleApprove = async () => {
+    if (!parsedAmount || !jar) return;
+    try {
+      await writeUsdc({ functionName: "approve", args: [jar.address, parsedAmount] });
+    } catch (error) {
+      // useScaffoldWriteContract already surfaced the reason; nothing to add.
+      console.error("approve failed", error);
+    }
+  };
+
+  const handleTip = async () => {
+    if (!parsedAmount) return;
+    try {
+      // Returns undefined without throwing when the hook refuses to send (contract missing, wallet
+      // disconnected, wrong network). It has already told the user why, so only clear on a real hash.
+      const txHash = await writeTipJar({ functionName: "tip", args: [parsedAmount, message] });
+      if (!txHash) return;
+      setAmount("");
+      setMessage("");
+    } catch (error) {
+      console.error("tip failed", error);
+    }
+  };
+
+  return (
+    <div className="card bg-base-100 border border-base-300">
+      <div className="card-body gap-4">
+        <h2 className="card-title">Send a tip</h2>
+
+        <div className="flex flex-col gap-2">
+          <BaseInput
+            name="amount"
+            value={amount}
+            placeholder="0.00"
+            disabled={isBusy}
+            error={isOverBalance}
+            onChange={value => {
+              if (isUsdcInput(value)) setAmount(value);
+            }}
+            suffix={<span className="self-center px-4 font-bold opacity-70">USDC</span>}
+          />
+          <div className="flex items-center justify-between gap-2 text-xs">
+            <div className="flex gap-1">
+              {QUICK_AMOUNTS.map(quickAmount => (
+                <button
+                  key={quickAmount}
+                  type="button"
+                  className="btn btn-xs btn-ghost"
+                  disabled={isBusy}
+                  onClick={() => setAmount(quickAmount)}
+                >
+                  ${quickAmount}
+                </button>
+              ))}
+            </div>
+            {connectedAddress && usdcBalance !== undefined && (
+              <span className={isOverBalance ? "text-error" : "opacity-70"}>Balance: ${formatUsdc(usdcBalance)}</span>
+            )}
+          </div>
+        </div>
+
+        <div className="flex flex-col gap-1">
+          <textarea
+            className="textarea textarea-bordered w-full"
+            rows={2}
+            placeholder="Say something nice (optional)"
+            disabled={isBusy}
+            value={message}
+            onChange={event => setMessage(event.target.value)}
+          />
+          <span className={`text-xs self-end ${isMessageTooLong ? "text-error" : "opacity-60"}`}>
+            {messageBytes}/{MAX_MESSAGE_BYTES}
+          </span>
+        </div>
+
+        {!connectedAddress ? (
+          <button className="btn btn-primary" disabled>
+            Connect a wallet to tip
+          </button>
+        ) : isOverBalance ? (
+          <button className="btn btn-primary" disabled>
+            Not enough USDC
+          </button>
+        ) : isMessageTooLong ? (
+          <button className="btn btn-primary" disabled>
+            Message is too long
+          </button>
+        ) : needsApproval ? (
+          <button className="btn btn-primary" disabled={isBusy} onClick={handleApprove}>
+            {isApproving && <span className="loading loading-spinner loading-sm" />}
+            Approve ${amount} USDC
+          </button>
+        ) : (
+          <button className="btn btn-primary" disabled={isBusy || !parsedAmount || !isReady} onClick={handleTip}>
+            {isTipping && <span className="loading loading-spinner loading-sm" />}
+            Send tip
+          </button>
+        )}
+
