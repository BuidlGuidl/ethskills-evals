+"use client";
+
+import { Address } from "@scaffold-ui/components";
+import { hardhat } from "viem/chains";
+import { useDeployedContractInfo, useScaffoldReadContract, useTargetNetwork } from "~~/hooks/scaffold-eth";
+import { formatUsdc } from "~~/utils/usdc";
+
+const Stat = ({ label, value, isLoading }: { label: string; value: string | undefined; isLoading: boolean }) => (
+  <div className="stat place-items-center">
+    <div className="stat-title">{label}</div>
+    {isLoading || value === undefined ? (
+      <div className="skeleton h-9 w-28" />
+    ) : (
+      <div className="stat-value text-2xl md:text-3xl">{value}</div>
+    )}
+  </div>
+);
+
+export const JarStats = () => {
+  const { targetNetwork } = useTargetNetwork();
+  const { data: jar } = useDeployedContractInfo({ contractName: "TipJar" });
+
+  const { data: totalTipped, isLoading: isTotalLoading } = useScaffoldReadContract({
+    contractName: "TipJar",
+    functionName: "totalTipped",
+  });
+  const { data: tipCount, isLoading: isCountLoading } = useScaffoldReadContract({
+    contractName: "TipJar",
+    functionName: "tipCount",
+  });
+  const {
+    data: balance,
+    isLoading: isBalanceLoading,
+    error,
+  } = useScaffoldReadContract({ contractName: "TipJar", functionName: "balance" });
+
+  return (
+    <div className="card bg-base-100 border border-base-300 w-full">
+      <div className="card-body gap-4 items-center">
+        {error && (
+          // Falling back to $0.00 here would state, confidently, that the jar is empty.
+          <div className="alert alert-error text-sm">Could not reach the network to read the jar.</div>
+        )}
+        <div className="stats stats-vertical sm:stats-horizontal bg-transparent">
+          <Stat
+            label="Tipped all time"
+            value={totalTipped === undefined ? undefined : `$${formatUsdc(totalTipped)}`}
+            isLoading={isTotalLoading}
+          />
+          <Stat label="Tips" value={tipCount?.toString()} isLoading={isCountLoading} />
+          <Stat
+            label="In the jar"
+            value={balance === undefined ? undefined : `$${formatUsdc(balance)}`}
+            isLoading={isBalanceLoading}
+          />
+        </div>
+        <div className="flex items-center gap-2 text-sm">
+          <span className="opacity-70">Jar</span>
+          <Address
+            address={jar?.address}
+            chain={targetNetwork}
+            size="sm"
+            disableAddressLink={targetNetwork.id === hardhat.id}
+          />
+        </div>
+      </div>
+    </div>
+  );
+};
