@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.19;
+
+import "./DeployHelpers.s.sol";
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { TipJar } from "../contracts/TipJar.sol";
+
+/**
+ * @notice Deploy script for the TipJar contract
+ * @dev Inherits ScaffoldETHDeploy which:
+ *      - Includes forge-std/Script.sol for deployment
+ *      - Includes ScaffoldEthDeployerRunner modifier
+ *      - Provides `deployer` variable
+ * Example:
+ * yarn deploy --file DeployTipJar.s.sol            # local anvil fork of Base
+ * yarn deploy --file DeployTipJar.s.sol --network base
+ */
+contract DeployTipJar is ScaffoldETHDeploy {
+    /// @dev USDC is deployed at the same address on Base and on any fork of it.
+    address public constant BASE_USDC = 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913;
+
+    function run() external ScaffoldEthDeployerRunner {
+        // A bare `yarn chain` has no USDC, so the jar would deploy against an empty address and
+        // every tip would revert. Fail here instead, with the command that fixes it.
+        require(
+            BASE_USDC.code.length > 0,
+            "No USDC at the Base USDC address. Start a Base fork first: yarn fork --network base"
+        );
+
+        TipJar tipJar = new TipJar(IERC20(BASE_USDC), deployer);
+        console.logString(string.concat("TipJar deployed at ", vm.toString(address(tipJar))));
+    }
+}
