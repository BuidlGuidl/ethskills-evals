diff --git a/packages/foundry/test/TipJar.t.sol b/packages/foundry/test/TipJar.t.sol
new file mode 100644
index 0000000..ad51226
--- /dev/null
+++ b/packages/foundry/test/TipJar.t.sol
@@ -0,0 +1,208 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.19;
+
+import { Test } from "forge-std/Test.sol";
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { IERC20Errors } from "@openzeppelin/contracts/interfaces/draft-IERC6093.sol";
+import { Ownable } from "@openzeppelin/contracts/access/Ownable.sol";
+import { TipJar } from "../contracts/TipJar.sol";
+import { MockERC20 } from "./mocks/MockERC20.sol";
+
+contract TipJarTest is Test {
+    uint256 internal constant ONE_USDC = 1e6;
+
+    MockERC20 internal usdc;
+    TipJar internal jar;
+
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+    address internal bob = makeAddr("bob");
+
+    event Tipped(address indexed sender, uint256 amount, string message, uint256 index);
+    event Withdrawn(address indexed to, uint256 amount);
+
+    function setUp() public {
+        usdc = new MockERC20();
+        jar = new TipJar(IERC20(address(usdc)), owner);
+
+        usdc.mint(alice, 1000 * ONE_USDC);
+        usdc.mint(bob, 1000 * ONE_USDC);
+    }
+
+    function _tip(address from, uint256 amount, string memory message) internal {
+        vm.startPrank(from);
+        usdc.approve(address(jar), amount);
+        jar.tip(amount, message);
+        vm.stopPrank();
+    }
+
+    function test_Constructor() public view {
+        assertEq(address(jar.token()), address(usdc));
+        assertEq(jar.owner(), owner);
+        assertEq(jar.tipCount(), 0);
+        assertEq(jar.totalTipped(), 0);
+    }
+
+    function test_ConstructorRevertsOnTokenWithoutCode() public {
+        vm.expectRevert(TipJar.TokenHasNoCode.selector);
+        new TipJar(IERC20(alice), owner);
+    }
+
+    function test_TipMovesTokensAndRecordsFeedEntry() public {
+        vm.warp(1_700_000_000);
+
+        vm.startPrank(alice);
+        usdc.approve(address(jar), 5 * ONE_USDC);
+        vm.expectEmit(true, false, false, true, address(jar));
+        emit Tipped(alice, 5 * ONE_USDC, "gm", 0);
+        jar.tip(5 * ONE_USDC, "gm");
+        vm.stopPrank();
+
+        assertEq(usdc.balanceOf(address(jar)), 5 * ONE_USDC);
+        assertEq(usdc.balanceOf(alice), 995 * ONE_USDC);
+        assertEq(jar.balance(), 5 * ONE_USDC);
+        assertEq(jar.totalTipped(), 5 * ONE_USDC);
+        assertEq(jar.totalTippedBy(alice), 5 * ONE_USDC);
+        assertEq(jar.tipCount(), 1);
+
+        (TipJar.Tip[] memory page,) = jar.getLatestTips(0, 10);
+        assertEq(page.length, 1);
+        assertEq(page[0].sender, alice);
+        assertEq(page[0].amount, 5 * ONE_USDC);
+        assertEq(page[0].message, "gm");
+        assertEq(page[0].timestamp, 1_700_000_000);
+    }
+
+    function test_TipAccumulatesPerSender() public {
+        _tip(alice, 5 * ONE_USDC, "one");
+        _tip(alice, 7 * ONE_USDC, "two");
+        _tip(bob, 3 * ONE_USDC, "three");
+
+        assertEq(jar.totalTipped(), 15 * ONE_USDC);
+        assertEq(jar.totalTippedBy(alice), 12 * ONE_USDC);
+        assertEq(jar.totalTippedBy(bob), 3 * ONE_USDC);
+        assertEq(jar.tipCount(), 3);
+    }
+
+    function test_TipRevertsOnZeroAmount() public {
+        vm.prank(alice);
+        vm.expectRevert(TipJar.AmountIsZero.selector);
+        jar.tip(0, "gm");
+    }
+
+    function test_TipRevertsOnOverlongMessage() public {
+        string memory tooLong = new string(141);
+        vm.prank(alice);
+        vm.expectRevert(abi.encodeWithSelector(TipJar.MessageTooLong.selector, 141));
+        jar.tip(ONE_USDC, tooLong);
+    }
+
+    function test_TipAcceptsMessageAtTheLimit() public {
+        string memory atLimit = new string(jar.MAX_MESSAGE_LENGTH());
+        _tip(alice, ONE_USDC, atLimit);
+        assertEq(jar.tipCount(), 1);
+    }
+
+    function test_TipRevertsWithoutApproval() public {
+        vm.prank(alice);
+        vm.expectRevert(
+            abi.encodeWithSelector(IERC20Errors.ERC20InsufficientAllowance.selector, address(jar), 0, ONE_USDC)
+        );
+        jar.tip(ONE_USDC, "gm");
+    }
+
+    function test_TipRevertsOnInsufficientBalance() public {
+        vm.startPrank(alice);
+        usdc.approve(address(jar), type(uint256).max);
+        vm.expectRevert(
+            abi.encodeWithSelector(
+                IERC20Errors.ERC20InsufficientBalance.selector, alice, 1000 * ONE_USDC, 1001 * ONE_USDC
+            )
+        );
+        jar.tip(1001 * ONE_USDC, "too much");
+        vm.stopPrank();
+    }
+
+    function test_GetLatestTipsIsNewestFirstAndPages() public {
+        _tip(alice, 1 * ONE_USDC, "first");
+        _tip(bob, 2 * ONE_USDC, "second");
+        _tip(alice, 3 * ONE_USDC, "third");
+
+        (TipJar.Tip[] memory page, uint256 total) = jar.getLatestTips(0, 2);
+        assertEq(total, 3, "total is the whole feed, not the page");
+        assertEq(page.length, 2);
+        assertEq(page[0].message, "third");
+        assertEq(page[1].message, "second");
+
+        (page,) = jar.getLatestTips(2, 2);
+        assertEq(page.length, 1, "last page is short, not padded");
+        assertEq(page[0].message, "first");
+
+        (TipJar.Tip[] memory pastEnd, uint256 pastEndTotal) = jar.getLatestTips(3, 2);
+        assertEq(pastEnd.length, 0, "offset past the oldest tip is empty");
+        assertEq(pastEndTotal, 3, "total still reported when the page is empty");
+        (TipJar.Tip[] memory emptyPage,) = jar.getLatestTips(0, 0);
+        assertEq(emptyPage.length, 0);
+    }
+
+    function test_GetLatestTipsOnEmptyJar() public view {
+        (TipJar.Tip[] memory page, uint256 total) = jar.getLatestTips(0, 10);
+        assertEq(page.length, 0);
+        assertEq(total, 0);
+    }
+
+    function test_WithdrawSendsWholeBalanceToOwnerChoice() public {
+        _tip(alice, 5 * ONE_USDC, "gm");
+        _tip(bob, 5 * ONE_USDC, "gn");
+
+        vm.expectEmit(true, false, false, true, address(jar));
+        emit Withdrawn(bob, 10 * ONE_USDC);
+        vm.prank(owner);
+        jar.withdraw(bob);
+
+        assertEq(usdc.balanceOf(address(jar)), 0);
+        assertEq(usdc.balanceOf(bob), 1005 * ONE_USDC);
+        assertEq(jar.totalTipped(), 10 * ONE_USDC, "totalTipped is lifetime, not current balance");
+        assertEq(jar.tipCount(), 2, "withdrawing does not clear the feed");
+    }
+
+    function test_WithdrawRevertsForNonOwner() public {
+        _tip(alice, 5 * ONE_USDC, "gm");
+        vm.prank(alice);
+        vm.expectRevert(abi.encodeWithSelector(Ownable.OwnableUnauthorizedAccount.selector, alice));
+        jar.withdraw(alice);
+    }
+
+    function test_WithdrawRevertsOnEmptyJar() public {
+        vm.prank(owner);
+        vm.expectRevert(TipJar.NothingToWithdraw.selector);
+        jar.withdraw(owner);
+    }
+
+    function test_RenounceOwnershipIsBlocked() public {
+        vm.prank(owner);
+        vm.expectRevert(TipJar.OwnershipCannotBeRenounced.selector);
+        jar.renounceOwnership();
+
+        assertEq(jar.owner(), owner, "a jar holding funds must keep an owner who can empty it");
+    }
+
+    function test_WithdrawRevertsOnZeroRecipient() public {
+        _tip(alice, 5 * ONE_USDC, "gm");
+        vm.prank(owner);
+        vm.expectRevert(TipJar.InvalidRecipient.selector);
+        jar.withdraw(address(0));
+    }
+
+    function testFuzz_TipRecordsExactAmount(uint256 amount, uint8 messageLength) public {
+        amount = bound(amount, 1, 1000 * ONE_USDC);
+        string memory message = new string(bound(messageLength, 0, jar.MAX_MESSAGE_LENGTH()));
+
+        _tip(alice, amount, message);
+
+        assertEq(jar.totalTipped(), amount);
+        assertEq(usdc.balanceOf(address(jar)), amount);
+        (TipJar.Tip[] memory page,) = jar.getLatestTips(0, 1);
+        assertEq(page[0].amount, amount);
+    }
+}
diff --git a/packages/foundry/test/TipJarFork.t.sol b/packages/foundry/test/TipJarFork.t.sol
new file mode 100644
index 0000000..0e9416b
--- /dev/null
+++ b/packages/foundry/test/TipJarFork.t.sol
@@ -0,0 +1,70 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.19;
+
+import { Test } from "forge-std/Test.sol";
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { TipJar } from "../contracts/TipJar.sol";
+
+/**
+ * The same flow the local demo runs: real Base USDC, funded from a real holder, no mock token.
+ *
+ * Skipped automatically when the `base` RPC in foundry.toml is unreachable, so `yarn test` still
+ * works offline.
+ */
+contract TipJarForkTest is Test {
+    uint256 internal constant ONE_USDC = 1e6;
+
+    /// @dev Same address on Base and on any fork of it.
+    IERC20 internal constant USDC = IERC20(0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913);
+    /// @dev Aave v3 Base aUSDC reserve — held ~17.9M USDC at FORK_BLOCK.
+    address internal constant USDC_WHALE = 0x4e65fE4DbA92790696d040ac24Aa414708F5c0AB;
+    uint256 internal constant FORK_BLOCK = 50_900_000;
+
+    TipJar internal jar;
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+
+    function setUp() public {
+        try vm.createSelectFork("base", FORK_BLOCK) returns (uint256) { }
+        catch {
+            vm.skip(true);
+            return;
+        }
+
+        jar = new TipJar(USDC, owner);
+
+        // Fund the demo identity from a real holder rather than minting a mock.
+        vm.prank(USDC_WHALE);
+        USDC.transfer(alice, 1000 * ONE_USDC);
+    }
+
+    function test_ForkTipMovesRealUsdc() public {
+        assertEq(USDC.balanceOf(alice), 1000 * ONE_USDC);
+
+        vm.startPrank(alice);
+        USDC.approve(address(jar), 25 * ONE_USDC);
+        jar.tip(25 * ONE_USDC, "thanks for the fork");
+        vm.stopPrank();
+
+        assertEq(USDC.balanceOf(address(jar)), 25 * ONE_USDC);
+        assertEq(USDC.balanceOf(alice), 975 * ONE_USDC);
+        assertEq(jar.totalTipped(), 25 * ONE_USDC);
+
+        (TipJar.Tip[] memory page,) = jar.getLatestTips(0, 1);
+        assertEq(page[0].sender, alice);
+        assertEq(page[0].message, "thanks for the fork");
+    }
+
+    function test_ForkWithdrawSendsRealUsdc() public {
+        vm.startPrank(alice);
+        USDC.approve(address(jar), 25 * ONE_USDC);
+        jar.tip(25 * ONE_USDC, "gm");
+        vm.stopPrank();
+
+        vm.prank(owner);
+        jar.withdraw(owner);
+
+        assertEq(USDC.balanceOf(owner), 25 * ONE_USDC);
+        assertEq(USDC.balanceOf(address(jar)), 0);
+    }
+}
