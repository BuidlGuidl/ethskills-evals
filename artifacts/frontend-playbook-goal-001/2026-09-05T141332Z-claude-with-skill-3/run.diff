@@ -0,0 +1,21 @@
+import { formatUnits, parseUnits } from "viem";
+
+export const USDC_DECIMALS = 6;
+
+/** Digits, optionally followed by a decimal point and up to six more. Also accepts "" and "1.". */
+const USDC_INPUT_PATTERN = /^\d*(\.\d{0,6})?$/;
+
+export const isUsdcInput = (value: string) => USDC_INPUT_PATTERN.test(value);
+
+/** Returns undefined for input that is empty or not a positive amount. */
+export const parseUsdcInput = (value: string) => {
+  if (!isUsdcInput(value) || value === "" || value === ".") return undefined;
+  const parsed = parseUnits(value, USDC_DECIMALS);
+  return parsed > 0n ? parsed : undefined;
+};
+
+export const formatUsdc = (amount: bigint, maximumFractionDigits = 2) =>
+  Number(formatUnits(amount, USDC_DECIMALS)).toLocaleString("en-US", {
+    minimumFractionDigits: 2,
+    maximumFractionDigits,
+  });

