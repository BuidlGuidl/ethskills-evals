+++ b/packages/foundry/scripts-js/fundBaseForkUsdc.sh
@@ -0,0 +1,21 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+RPC_URL="${RPC_URL:-http://127.0.0.1:8545}"
+USDC="${USDC:-0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913}"
+USDC_HOLDER="${USDC_HOLDER:-0xba7973e10d4282b96eaffa12030877217f8aa80e}"
+DEMO_A="${DEMO_A:-0xf39fd6e51aad88f6f4ce6ab8827279cfffb92266}"
+DEMO_B="${DEMO_B:-0x70997970c51812dc3a010c7d01b50e0d17dc79c8}"
+AMOUNT="${AMOUNT:-100000000}"
+
+cast rpc anvil_setBalance "$USDC_HOLDER" 0x56BC75E2D63100000 --rpc-url "$RPC_URL" >/dev/null
+cast rpc anvil_impersonateAccount "$USDC_HOLDER" --rpc-url "$RPC_URL" >/dev/null
+
+cast send "$USDC" "transfer(address,uint256)" "$DEMO_A" "$AMOUNT" --from "$USDC_HOLDER" --unlocked --rpc-url "$RPC_URL"
+cast send "$USDC" "transfer(address,uint256)" "$DEMO_B" "$AMOUNT" --from "$USDC_HOLDER" --unlocked --rpc-url "$RPC_URL"
+
+cast rpc anvil_stopImpersonatingAccount "$USDC_HOLDER" --rpc-url "$RPC_URL" >/dev/null
+
+echo "Funded demo accounts with Base USDC on the local fork:"
+cast call "$USDC" "balanceOf(address)(uint256)" "$DEMO_A" --rpc-url "$RPC_URL"
+cast call "$USDC" "balanceOf(address)(uint256)" "$DEMO_B" --rpc-url "$RPC_URL"
