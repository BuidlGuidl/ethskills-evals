+// SPDX-License-Identifier: UNLICENSED
+pragma solidity ^0.8.20;
+
+import "forge-std/Test.sol";
+import { Ownable } from "@openzeppelin/contracts/access/Ownable.sol";
+import { ERC20 } from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+import { UsdcTipJar } from "../contracts/UsdcTipJar.sol";
+
+contract MockUsdc is ERC20 {
+    constructor() ERC20("USD Coin", "USDC") { }
+
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    function mint(address to, uint256 amount) external {
+        _mint(to, amount);
+    }
+}
+
+contract UsdcTipJarTest is Test {
+    address private constant BASE_USDC = 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913;
+
+    address private owner = makeAddr("owner");
+    address private recipient = makeAddr("recipient");
+    address private tipper = makeAddr("tipper");
+    address private nextRecipient = makeAddr("nextRecipient");
+
+    MockUsdc private usdc;
+    UsdcTipJar private tipJar;
+
+    function setUp() public {
+        MockUsdc mockUsdc = new MockUsdc();
+
+        vm.etch(BASE_USDC, address(mockUsdc).code);
+        usdc = MockUsdc(BASE_USDC);
+        tipJar = new UsdcTipJar(owner, recipient);
+
+        usdc.mint(tipper, 250e6);
+    }
+
+    function testTipsMoveUsdcToRecipientAndTrackTotals() public {
+        vm.startPrank(tipper);
+        usdc.approve(address(tipJar), 25e6);
+        tipJar.tip(25e6, "nice build");
+        vm.stopPrank();
+
+        assertEq(usdc.balanceOf(recipient), 25e6);
+        assertEq(usdc.balanceOf(tipper), 225e6);
+        assertEq(tipJar.tipCount(), 1);
+        assertEq(tipJar.totalTipped(), 25e6);
+        assertEq(tipJar.totalTippedBy(tipper), 25e6);
+    }
+
+    function testTipRequiresApproval() public {
+        vm.prank(tipper);
+        vm.expectRevert();
+        tipJar.tip(1e6, "no allowance");
+    }
+
+    function testRejectsZeroAmount() public {
+        vm.prank(tipper);
+        vm.expectRevert(UsdcTipJar.ZeroAmount.selector);
+        tipJar.tip(0, "");
+    }
+
+    function testOwnerCanChangeRecipient() public {
+        vm.prank(owner);
+        tipJar.setRecipient(nextRecipient);
+
+        vm.startPrank(tipper);
+        usdc.approve(address(tipJar), 10e6);
+        tipJar.tip(10e6, "to the new jar");
+        vm.stopPrank();
+
+        assertEq(tipJar.recipient(), nextRecipient);
+        assertEq(usdc.balanceOf(nextRecipient), 10e6);
+    }
+
+    function testOnlyOwnerCanChangeRecipient() public {
+        vm.prank(tipper);
+        vm.expectRevert(abi.encodeWithSelector(Ownable.OwnableUnauthorizedAccount.selector, tipper));
+        tipJar.setRecipient(nextRecipient);
+    }
+}
