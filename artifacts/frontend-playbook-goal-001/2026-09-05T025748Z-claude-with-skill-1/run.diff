+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import "./DeployHelpers.s.sol";
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { TipJar } from "../contracts/TipJar.sol";
+
+/**
+ * @notice Deploy script for the USDC TipJar.
+ * @dev Defaults to canonical USDC on Base. Because the address is read from chain state,
+ *      a local run only works against a Base fork (`yarn fork`) — on an empty
+ *      `yarn chain` there is no code at that address and this script stops with a hint.
+ *
+ * Example:
+ * yarn deploy --file DeployTipJar.s.sol             # local Base fork
+ * yarn deploy --file DeployTipJar.s.sol --network base
+ */
+contract DeployTipJar is ScaffoldETHDeploy {
+    /// @dev Canonical (native, Circle-issued) USDC on Base mainnet.
+    address constant BASE_USDC = 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913;
+
+    function run() external ScaffoldEthDeployerRunner {
+        address usdc = vm.envOr("USDC_ADDRESS", BASE_USDC);
+
+        // A string revert rather than a custom error: forge hides the `== Logs ==` section
+        // for a reverted script, so this is the only place the hint is certain to be seen.
+        require(
+            usdc.code.length != 0,
+            string.concat(
+                "No ERC-20 code at ",
+                vm.toString(usdc),
+                " on chain ",
+                vm.toString(block.chainid),
+                ". The TipJar needs real USDC to exist - start a Base fork first: yarn fork"
+            )
+        );
+
+        new TipJar(IERC20(usdc), deployer);
+    }
+}
