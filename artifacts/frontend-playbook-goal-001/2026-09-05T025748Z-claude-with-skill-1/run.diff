new file mode 100644
index 0000000..00e9b6e
--- /dev/null
+++ b/packages/foundry/contracts/TipJar.sol
@@ -0,0 +1,99 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { SafeERC20 } from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+import { Ownable, Ownable2Step } from "@openzeppelin/contracts/access/Ownable2Step.sol";
+
+/**
+ * @notice A tip jar that accepts tips in a single ERC-20 token (USDC on Base).
+ * @dev The token is fixed at deploy time. Tippers must `approve` the jar first; the
+ *      feed is reconstructed from `Tipped` events, so only aggregates live in storage.
+ * @author BuidlGuidl
+ */
+contract TipJar is Ownable2Step {
+    using SafeERC20 for IERC20;
+
+    /// @notice Longest tip message accepted, in bytes (not characters).
+    uint256 public constant MAX_MESSAGE_BYTES = 140;
+
+    /// @notice The only token this jar accepts.
+    IERC20 public immutable token;
+
+    /// @notice Sum of every tip ever received, in token base units.
+    uint256 public totalTipped;
+
+    /// @notice Number of tips ever received.
+    uint256 public tipCount;
+
+    /// @notice Total tipped per address, in token base units.
+    mapping(address tipper => uint256 total) public tippedBy;
+
+    event Tipped(address indexed tipper, uint256 amount, string message);
+    event Withdrawn(address indexed to, uint256 amount);
+
+    error AmountIsZero();
+    error MessageTooLong(uint256 length, uint256 maxLength);
+    error TokenHasNoCode(address token);
+    error WithdrawToZeroAddress();
+    error InsufficientBalance(uint256 requested, uint256 available);
+    error OwnershipCannotBeRenounced();
+
+    /**
+     * @param _token The ERC-20 accepted as tips. Must already be deployed, which on a
+     *        local chain means you are forked from a network where it exists.
+     */
+    constructor(IERC20 _token, address initialOwner) Ownable(initialOwner) {
+        if (address(_token).code.length == 0) revert TokenHasNoCode(address(_token));
+        token = _token;
+    }
+
+    /**
+     * @notice Send a tip. Requires an ERC-20 allowance of at least `amount` for this contract.
+     * @param amount Tip size in token base units (USDC has 6 decimals, so 1 USDC is 1e6).
+     * @param message Public note shown in the feed. May be empty.
+     */
+    function tip(uint256 amount, string calldata message) external {
+        if (amount == 0) revert AmountIsZero();
+        uint256 messageLength = bytes(message).length;
+        if (messageLength > MAX_MESSAGE_BYTES) revert MessageTooLong(messageLength, MAX_MESSAGE_BYTES);
+
+        totalTipped += amount;
+        tipCount += 1;
+        tippedBy[msg.sender] += amount;
+
+        token.safeTransferFrom(msg.sender, address(this), amount);
+
+        emit Tipped(msg.sender, amount, message);
+    }
+
+    /// @notice Tokens currently sitting in the jar, in token base units.
+    function jarBalance() public view returns (uint256) {
+        return token.balanceOf(address(this));
+    }
+
+    /// @notice Move `amount` out of the jar. Owner only.
+    function withdraw(address to, uint256 amount) public onlyOwner {
+        if (to == address(0)) revert WithdrawToZeroAddress();
+        if (amount == 0) revert AmountIsZero();
+        uint256 available = jarBalance();
+        if (amount > available) revert InsufficientBalance(amount, available);
+
+        emit Withdrawn(to, amount);
+        token.safeTransfer(to, amount);
+    }
+
+    /// @notice Empty the jar into `to`. Owner only.
+    function withdrawAll(address to) external onlyOwner {
+        withdraw(to, jarBalance());
+    }
+
+    /**
+     * @notice Disabled. Renouncing would set the owner to the zero address, and since
+     *         `withdraw` is the jar's only exit, that would lock every tip it holds — and
+     *         every tip it goes on to accept — forever.
+     */
+    function renounceOwnership() public pure override {
+        revert OwnershipCannotBeRenounced();
+    }
+}
