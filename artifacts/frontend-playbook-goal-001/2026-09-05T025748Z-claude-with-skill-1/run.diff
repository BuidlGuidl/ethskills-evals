diff --git a/packages/foundry/scripts-js/fork.js b/packages/foundry/scripts-js/fork.js
new file mode 100644
index 0000000..55d39e2
--- /dev/null
+++ b/packages/foundry/scripts-js/fork.js
@@ -0,0 +1,84 @@
+/**
+ * Starts an Anvil fork of a live network.
+ *
+ * Defaults to Base, because that is where this dApp's USDC lives and every local
+ * demo needs real Base state to be interesting.
+ *
+ * Usage:
+ *   yarn fork                          # fork Base
+ *   yarn fork --network mainnet        # any alias from foundry.toml [rpc_endpoints]
+ *   yarn fork https://my.rpc/base      # or a URL directly
+ *
+ * Set BASE_RPC_URL to fork Base through your own provider instead of the public
+ * endpoint, which rate-limits the archive reads a fork performs.
+ */
+import { spawnSync } from "child_process";
+import { readFileSync } from "fs";
+import { dirname, join } from "path";
+import { fileURLToPath } from "url";
+import { config } from "dotenv";
+import { parse } from "toml";
+
+const __dirname = dirname(fileURLToPath(import.meta.url));
+config();
+
+const DEFAULT_NETWORK = "base";
+
+const args = process.argv.slice(2);
+
+if (args.includes("--help") || args.includes("-h")) {
+  console.log(`
+Usage: yarn fork [network|rpc-url]
+Options:
+  --network <network>   Alias from foundry.toml [rpc_endpoints] (default: ${DEFAULT_NETWORK})
+  --help, -h            Show this help message
+Examples:
+  yarn fork
+  yarn fork --network mainnet
+  yarn fork https://base-mainnet.g.alchemy.com/v2/<key>
+  `);
+  process.exit(0);
+}
+
+let target = DEFAULT_NETWORK;
+for (let i = 0; i < args.length; i++) {
+  if (args[i] === "--network" && args[i + 1]) {
+    target = args[++i];
+  } else if (!args[i].startsWith("-")) {
+    target = args[i];
+  }
+}
+
+const isUrl = /^https?:\/\//.test(target);
+
+if (!isUrl) {
+  const foundryToml = parse(
+    readFileSync(join(__dirname, "..", "foundry.toml"), "utf-8")
+  );
+  if (!foundryToml.rpc_endpoints?.[target]) {
+    console.log(
+      `\n❌ Error: Network '${target}' not found in foundry.toml!`,
+      "\nAdd it to the [rpc_endpoints] section, or pass an RPC URL directly."
+    );
+    process.exit(1);
+  }
+}
+
+// Anvil resolves foundry.toml aliases itself, so only override when the user has
+// pointed Base at their own provider.
+const forkUrl =
+  !isUrl && target === "base" && process.env.BASE_RPC_URL
+    ? process.env.BASE_RPC_URL
+    : target;
+
+console.log(
+  `\n🍴 Forking ${target} on chain 31337 (local only — nothing is broadcast)\n`
+);
+
+const result = spawnSync("make", ["fork"], {
+  stdio: "inherit",
+  shell: true,
+  env: { ...process.env, FORK_URL: forkUrl },
+});
+
+process.exit(result.status ?? 1);
diff --git a/packages/foundry/scripts-js/fundDemo.js b/packages/foundry/scripts-js/fundDemo.js
new file mode 100644
index 0000000..9e9e70a
--- /dev/null
+++ b/packages/foundry/scripts-js/fundDemo.js
@@ -0,0 +1,207 @@
+/**
+ * Funds demo identities with REAL USDC on a local Anvil fork of Base.
+ *
+ * Nothing here is broadcast to Base. The fork is a local copy of Base state, so the
+ * USDC is real in the sense that it is the actual Circle contract with real holders,
+ * and fake in the sense that moving it costs nobody anything.
+ *
+ * Usage:
+ *   yarn fund-demo                          # 1000 USDC to Anvil accounts #0-#3
+ *   yarn fund-demo 0xYourBurnerAddress      # ...and to any extra addresses you list
+ *   yarn fund-demo --amount 25000           # different amount per account
+ */
+
+const RPC_URL = process.env.RPC_URL || "http://127.0.0.1:8545";
+const USDC =
+  process.env.USDC_ADDRESS || "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913";
+const USDC_DECIMALS = 6n;
+
+// Anvil's deterministic accounts #0-#3. Import their well-known private keys into
+// MetaMask (they are printed by `yarn fork`) to demo tips between browser identities.
+const DEMO_ACCOUNTS = [
+  "0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266",
+  "0x70997970C51812dc3A010C7d01b50e0d17dc79C8",
+  "0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC",
+  "0x90F79bf6EB2c4f870365E785982E1f101E93b906",
+];
+
+// Whale balances drift, so try several known Base USDC holders and take the first
+// one that still holds enough.
+const WHALE_CANDIDATES = [
+  {
+    address: "0xBBBBBbbBBb9cC5e90e3b3Af64bdAF62C37EEFFCb",
+    label: "Morpho Blue",
+  },
+  {
+    address: "0x4e65fE4DbA92790696d040ac24Aa414708F5c0AB",
+    label: "Aave v3 aBasUSDC",
+  },
+  { address: "0x20FE51A9229EEf2cF8Ad9E89d91CAb9312cF3b7A", label: "Coinbase" },
+];
+
+const BALANCE_OF_SELECTOR = "0x70a08231";
+const TRANSFER_SELECTOR = "0xa9059cbb";
+
+let requestId = 0;
+
+async function rpc(method, params = []) {
+  let response;
+  try {
+    response = await fetch(RPC_URL, {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ jsonrpc: "2.0", id: ++requestId, method, params }),
+    });
+  } catch (error) {
+    throw new Error(
+      `Cannot reach ${RPC_URL}. Is the fork running? Start it with \`yarn fork\`.\n${error.message}`
+    );
+  }
+
+  const body = await response.json();
+  if (body.error) throw new Error(`${method} failed: ${body.error.message}`);
+  return body.result;
+}
+
+const padAddress = (address) =>
+  address.toLowerCase().replace("0x", "").padStart(64, "0");
+const padUint = (value) => value.toString(16).padStart(64, "0");
+const toHexQuantity = (value) => `0x${value.toString(16)}`;
+
+async function usdcBalanceOf(address) {
+  const result = await rpc("eth_call", [
+    { to: USDC, data: `${BALANCE_OF_SELECTOR}${padAddress(address)}` },
+    "latest",
+  ]);
+  return BigInt(result);
+}
+
+function formatUsdc(baseUnits) {
+  const whole = baseUnits / 10n ** USDC_DECIMALS;
+  const fraction = (baseUnits % 10n ** USDC_DECIMALS)
+    .toString()
+    .padStart(Number(USDC_DECIMALS), "0");
+  return `${whole.toLocaleString("en-US")}.${fraction.slice(0, 2)}`;
+}
+
+function parseArgs(argv) {
+  const extraAccounts = [];
+  let amount = 1000n;
+
+  for (let i = 0; i < argv.length; i++) {
+    if (argv[i] === "--amount") {
+      const raw = argv[++i];
+      if (!/^\d+$/.test(raw ?? ""))
+        throw new Error(
+          "--amount expects a whole number of USDC, e.g. --amount 25000"
+        );
+      amount = BigInt(raw);
+    } else if (/^0x[0-9a-fA-F]{40}$/.test(argv[i])) {
+      extraAccounts.push(argv[i]);
+    } else {
+      throw new Error(
+        `Unrecognised argument "${argv[i]}". Expected an 0x address or --amount <whole USDC>.`
+      );
+    }
+  }
+
+  return { extraAccounts, amount: amount * 10n ** USDC_DECIMALS };
+}
+
+async function assertRunningAgainstABaseFork() {
+  const chainId = BigInt(await rpc("eth_chainId"));
+  if (chainId !== 31337n) {
+    throw new Error(
+      `Expected the local fork on chain 31337 but ${RPC_URL} reports chain ${chainId}.`
+    );
+  }
+
+  const code = await rpc("eth_getCode", [USDC, "latest"]);
+  if (!code || code === "0x") {
+    throw new Error(
+      `No USDC at ${USDC} on ${RPC_URL}.\n` +
+        "That address only has code on Base, so this chain is not a Base fork.\n" +
+        "Stop `yarn chain` and run `yarn fork` instead."
+    );
+  }
+}
+
+async function pickWhale(needed) {
+  for (const candidate of WHALE_CANDIDATES) {
+    const balance = await usdcBalanceOf(candidate.address);
+    if (balance >= needed) return { ...candidate, balance };
+  }
+  throw new Error(
+    `No known Base USDC holder has ${formatUsdc(needed)} USDC left.\n` +
+      "Add a current holder to WHALE_CANDIDATES in scripts-js/fundDemo.js."
+  );
+}
+
+async function main() {
+  const { extraAccounts, amount } = parseArgs(process.argv.slice(2));
+  const recipients = [...DEMO_ACCOUNTS, ...extraAccounts];
+  const total = amount * BigInt(recipients.length);
+
+  await assertRunningAgainstABaseFork();
+
+  const whale = await pickWhale(total);
+  console.log(
+    `Funding from ${whale.label} (${whale.address}) — holds ${formatUsdc(
+      whale.balance
+    )} USDC\n`
+  );
+
+  // The whale is usually a contract with no ETH of its own; give it gas money.
+  await rpc("anvil_setBalance", [whale.address, toHexQuantity(10n ** 18n)]);
+  await rpc("anvil_impersonateAccount", [whale.address]);
+
+  try {
+    for (const recipient of recipients) {
+      // Addresses supplied on the command line (a browser burner wallet, say) start empty.
+      if (BigInt(await rpc("eth_getBalance", [recipient, "latest"])) === 0n) {
+        await rpc("anvil_setBalance", [recipient, toHexQuantity(10n ** 19n)]);
+      }
+
+      const txHash = await rpc("eth_sendTransaction", [
+        {
+          from: whale.address,
+          to: USDC,
+          data: `${TRANSFER_SELECTOR}${padAddress(recipient)}${padUint(
+            amount
+          )}`,
+        },
+      ]);
+
+      const receipt = await waitForReceipt(txHash);
+      if (receipt.status !== "0x1")
+        throw new Error(`USDC transfer to ${recipient} reverted (${txHash})`);
+
+      console.log(
+        `  ${recipient}  ${formatUsdc(await usdcBalanceOf(recipient))} USDC`
+      );
+    }
+  } finally {
+    await rpc("anvil_stopImpersonatingAccount", [whale.address]);
+  }
+
+  console.log(
+    `\nDone. ${formatUsdc(
+      total
+    )} USDC moved on the fork — no real funds touched.`
+  );
+}
+
+async function waitForReceipt(txHash) {
+  // `yarn fork` mines on an interval, so a receipt is not available immediately.
+  for (let attempt = 0; attempt < 60; attempt++) {
+    const receipt = await rpc("eth_getTransactionReceipt", [txHash]);
+    if (receipt) return receipt;
+    await new Promise((resolve) => setTimeout(resolve, 250));
+  }
+  throw new Error(`Timed out waiting for ${txHash} to be mined.`);
+}
+
+main().catch((error) => {
+  console.error(`\n${error.message}\n`);
+  process.exit(1);
+});
