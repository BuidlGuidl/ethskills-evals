@@ -0,0 +1,38 @@
+"use client";
+
+import { useScaffoldReadContract } from "~~/hooks/scaffold-eth";
+import { formatUsdc } from "~~/utils/usdc";
+
+const Stat = ({ label, value, isPending }: { label: string; value: string; isPending: boolean }) => (
+  <div className="stat place-items-center">
+    <div className="stat-title">{label}</div>
+    {isPending ? (
+      <div className="skeleton h-9 w-28 my-1" />
+    ) : (
+      <div className="stat-value text-2xl md:text-3xl">{value}</div>
+    )}
+  </div>
+);
+
+export const JarStats = () => {
+  const { data: totalTipped } = useScaffoldReadContract({
+    contractName: "TipJar",
+    functionName: "totalTipped",
+  });
+  const { data: tipCount } = useScaffoldReadContract({
+    contractName: "TipJar",
+    functionName: "tipCount",
+  });
+  const { data: jarBalance } = useScaffoldReadContract({
+    contractName: "TipJar",
+    functionName: "jarBalance",
+  });
+
+  return (
+    <div className="stats stats-vertical sm:stats-horizontal bg-base-100 shadow w-full">
+      <Stat label="Tipped all time" value={`$${formatUsdc(totalTipped ?? 0n)}`} isPending={totalTipped === undefined} />
+      <Stat label="Tips" value={(tipCount ?? 0n).toString()} isPending={tipCount === undefined} />
+      <Stat label="In the jar now" value={`$${formatUsdc(jarBalance ?? 0n)}`} isPending={jarBalance === undefined} />
+    </div>
+  );
+};
