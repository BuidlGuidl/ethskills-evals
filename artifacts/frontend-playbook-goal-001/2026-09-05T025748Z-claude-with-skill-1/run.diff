--- /dev/null
+++ b/packages/nextjs/app/_components/OwnerPanel.tsx
@@ -0,0 +1,61 @@
+"use client";
+
+import { useState } from "react";
+import { AddressInput } from "@scaffold-ui/components";
+import { isAddress } from "viem";
+import { useAccount } from "wagmi";
+import { useScaffoldReadContract, useScaffoldWriteContract } from "~~/hooks/scaffold-eth";
+import { formatUsdc } from "~~/utils/usdc";
+
+/** Only rendered for the jar owner — everyone else gets nothing. */
+export const OwnerPanel = () => {
+  const { address: connectedAddress } = useAccount();
+  const [destination, setDestination] = useState("");
+
+  const { data: owner } = useScaffoldReadContract({ contractName: "TipJar", functionName: "owner" });
+  const { data: jarBalance, refetch: refetchJarBalance } = useScaffoldReadContract({
+    contractName: "TipJar",
+    functionName: "jarBalance",
+  });
+  const { writeContractAsync: writeTipJar, isMining: isWithdrawing } = useScaffoldWriteContract({
+    contractName: "TipJar",
+  });
+
+  const isOwner = Boolean(connectedAddress && owner && connectedAddress.toLowerCase() === owner.toLowerCase());
+  if (!isOwner) return null;
+
+  const payTo = destination || connectedAddress || "";
+  const destinationAddress = isAddress(payTo) ? payTo : undefined;
+  const hasBalance = (jarBalance ?? 0n) > 0n;
+
+  const handleWithdraw = async () => {
+    if (!destinationAddress) return;
+    try {
+      const hash = await writeTipJar({ functionName: "withdrawAll", args: [destinationAddress] });
+      if (!hash) return;
+      await refetchJarBalance();
+    } catch {
+      // useTransactor has already surfaced the reason.
+    }
+  };
+
+  return (
+    <div className="card bg-base-200 border border-base-300 w-full">
+      <div className="card-body gap-3">
+        <h2 className="card-title text-base">Jar owner</h2>
+        <p className="m-0 text-sm text-base-content/70">
+          Empty the jar into any address. Defaults to the connected wallet.
+        </p>
+        <AddressInput name="withdrawTo" value={destination} onChange={setDestination} placeholder={connectedAddress} />
+        <button
+          className="btn btn-accent btn-sm self-start"
+          disabled={!hasBalance || isWithdrawing || !destinationAddress}
+          onClick={handleWithdraw}
+        >
+          {isWithdrawing && <span className="loading loading-spinner loading-xs" />}
+          Withdraw ${formatUsdc(jarBalance ?? 0n)}
+        </button>
+      </div>
+    </div>
+  );
+};
diff --git a/packages/nextjs/app/_components/TipFeed.tsx b/packages/nextjs/app/_components/TipFeed.tsx
new file mode 100644
index 0000000..38460cf
--- /dev/null
+++ b/packages/nextjs/app/_components/TipFeed.tsx
@@ -0,0 +1,73 @@
+"use client";
+
+import { Address } from "@scaffold-ui/components";
+import { useScaffoldEventHistory, useTargetNetwork } from "~~/hooks/scaffold-eth";
+import { formatUsdc, timeAgo } from "~~/utils/usdc";
+
+/**
+ * `UseScaffoldEventHistoryData` intersects its per-event fields with `Log[]`, so indexing
+ * the array drops `blockData` from the element type even though `blockData: true` returns it.
+ */
+type TipEventBlock = { blockData: { timestamp: bigint } | null };
+
+export const TipFeed = () => {
+  const { targetNetwork } = useTargetNetwork();
+
+  const {
+    data: tips,
+    isLoading,
+    error,
+  } = useScaffoldEventHistory({
+    contractName: "TipJar",
+    eventName: "Tipped",
+    watch: true,
+    blockData: true,
+  });
+
+  return (
+    <div className="card bg-base-100 shadow-xl">
+      <div className="card-body gap-4">
+        <h2 className="card-title">Recent tips</h2>
+
+        {error && (
+          <div className="alert alert-error">
+            <span>Could not load the tip feed. Check that your RPC is reachable.</span>
+          </div>
+        )}
+
+        {isLoading && !tips?.length && (
+          <div className="flex flex-col gap-3">
+            {[0, 1, 2].map(row => (
+              <div key={row} className="skeleton h-16 w-full" />
+            ))}
+          </div>
+        )}
+
+        {!isLoading && !error && !tips?.length && (
+          <p className="text-base-content/60">No tips yet. Be the first one in the jar.</p>
+        )}
+
+        <ul className="list-none p-0 m-0 flex flex-col gap-3 max-h-[28rem] overflow-y-auto">
+          {tips?.map(rawTip => {
+            const tip = rawTip as typeof rawTip & TipEventBlock;
+            return (
+              <li
+                key={`${tip.transactionHash}-${tip.logIndex}`}
+                className="flex flex-col gap-1 border border-base-300 p-3"
+              >
+                <div className="flex items-center justify-between gap-2 flex-wrap">
+                  <Address address={tip.args.tipper} size="sm" chain={targetNetwork} />
+                  <span className="font-bold text-primary whitespace-nowrap">${formatUsdc(tip.args.amount ?? 0n)}</span>
+                </div>
+                {tip.args.message && <p className="m-0 break-words">{tip.args.message}</p>}
+                {tip.blockData && (
+                  <span className="text-xs text-base-content/50">{timeAgo(tip.blockData.timestamp)}</span>
+                )}
+              </li>
+            );
+          })}
+        </ul>
+      </div>
+    </div>
+  );
+};
diff --git a/packages/nextjs/app/_components/TipForm.tsx b/packages/nextjs/app/_components/TipForm.tsx
new file mode 100644
index 0000000..d0e439d
--- /dev/null
+++ b/packages/nextjs/app/_components/TipForm.tsx
@@ -0,0 +1,168 @@
+"use client";
+
+import { useState } from "react";
+import { BaseInput } from "@scaffold-ui/components";
+import { useAccount } from "wagmi";
+import { useDeployedContractInfo, useScaffoldReadContract, useScaffoldWriteContract } from "~~/hooks/scaffold-eth";
+import { formatUsdc, formatUsdcExact, isValidUsdcInput, messageByteLength, parseUsdcAmount } from "~~/utils/usdc";
+
+const QUICK_AMOUNTS = ["1", "5", "25"];
+
+export const TipForm = () => {
+  const [amount, setAmount] = useState("");
+  const [message, setMessage] = useState("");
+
+  const { address: connectedAddress } = useAccount();
+  const { data: tipJar } = useDeployedContractInfo({ contractName: "TipJar" });
+
+  const { data: usdcBalance, refetch: refetchBalance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "balanceOf",
+    args: [connectedAddress],
+  });
+  const { data: allowance, refetch: refetchAllowance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "allowance",
+    args: [connectedAddress, tipJar?.address],
+  });
+  // Read the cap from the contract so the counter can never drift from what `tip` enforces.
+  const { data: maxMessageBytes } = useScaffoldReadContract({
+    contractName: "TipJar",
+    functionName: "MAX_MESSAGE_BYTES",
+    watch: false,
+  });
+
+  const { writeContractAsync: writeUsdc, isMining: isApproving } = useScaffoldWriteContract({ contractName: "USDC" });
+  const { writeContractAsync: writeTipJar, isMining: isTipping } = useScaffoldWriteContract({
+    contractName: "TipJar",
+  });
+
+  const parsedAmount = parseUsdcAmount(amount);
+  const messageBytes = messageByteLength(message);
+  const messageLimit = Number(maxMessageBytes ?? 140n);
+
+  const exceedsBalance = parsedAmount !== null && usdcBalance !== undefined && parsedAmount > usdcBalance;
+  const messageTooLong = messageBytes > messageLimit;
+  const needsApproval = parsedAmount !== null && parsedAmount > 0n && (allowance ?? 0n) < parsedAmount;
+
+  const amountError =
+    amount.trim() && parsedAmount === null
+      ? "Enter an amount with at most 6 decimals"
+      : parsedAmount === 0n
+        ? "Tips have to be more than zero"
+        : exceedsBalance
+          ? `You only have $${formatUsdc(usdcBalance ?? 0n)} USDC`
+          : null;
+
+  const canSubmit =
+    Boolean(connectedAddress) && parsedAmount !== null && parsedAmount > 0n && !exceedsBalance && !messageTooLong;
+
+  const handleApprove = async () => {
+    if (!parsedAmount || !tipJar) return;
+    try {
+      // Returns undefined without throwing when the wallet is missing or on the wrong
+      // chain — it has already shown the error, so there is nothing to celebrate.
+      const hash = await writeUsdc({ functionName: "approve", args: [tipJar.address, parsedAmount] });
+      if (!hash) return;
+      await refetchAllowance();
+    } catch {
+      // useTransactor has already surfaced the reason.
+    }
+  };
+
+  const handleTip = async () => {
+    if (!parsedAmount) return;
+    try {
+      const hash = await writeTipJar({ functionName: "tip", args: [parsedAmount, message] });
+      // Keep what the user typed if the tip never went out.
+      if (!hash) return;
+      setAmount("");
+      setMessage("");
+      await Promise.all([refetchAllowance(), refetchBalance()]);
+    } catch {
+      // useTransactor has already surfaced the reason.
+    }
+  };
+
+  return (
+    <div className="card bg-base-100 shadow-xl">
+      <div className="card-body gap-4">
+        <h2 className="card-title">Leave a tip</h2>
+
+        <div className="flex flex-col gap-1">
+          <div className="flex items-center justify-between text-sm">
+            <span className="font-medium">Amount</span>
+            {connectedAddress && usdcBalance !== undefined && (
+              <span className="text-base-content/60">Balance ${formatUsdc(usdcBalance)} USDC</span>
+            )}
+          </div>
+          <BaseInput
+            name="amount"
+            value={amount}
+            onChange={value => {
+              if (value === "" || isValidUsdcInput(value)) setAmount(value);
+            }}
+            placeholder="0.00"
+            prefix={<span className="pl-4 text-base-content/60 self-center">$</span>}
+            suffix={<span className="pr-4 text-base-content/60 self-center">USDC</span>}
+            error={Boolean(amountError)}
+          />
+          <div className="flex gap-2 mt-1">
+            {QUICK_AMOUNTS.map(quickAmount => (
+              <button
+                key={quickAmount}
+                type="button"
+                className="btn btn-xs btn-outline"
+                onClick={() => setAmount(quickAmount)}
+              >
+                ${quickAmount}
+              </button>
+            ))}
+          </div>
+          {amountError && <p className="text-error text-sm mt-1 mb-0">{amountError}</p>}
+        </div>
+
+        <div className="flex flex-col gap-1">
+          <div className="flex items-center justify-between text-sm">
+            <span className="font-medium">Message</span>
+            <span className={messageTooLong ? "text-error" : "text-base-content/60"}>
+              {messageBytes}/{messageLimit}
+            </span>
+          </div>
+          <BaseInput
+            name="message"
+            value={message}
+            onChange={setMessage}
+            placeholder="Say something nice (optional)"
+            error={messageTooLong}
+          />
+        </div>
+
+        <div className="card-actions flex-col gap-2 mt-2">
+          {needsApproval && (
+            <button className="btn btn-secondary w-full" disabled={!canSubmit || isApproving} onClick={handleApprove}>
+              {isApproving && <span className="loading loading-spinner loading-sm" />}
+              Approve ${parsedAmount === null ? amount : formatUsdcExact(parsedAmount)} USDC
+            </button>
+          )}
+          <button
+            className="btn btn-primary w-full"
+            disabled={!canSubmit || needsApproval || isTipping}
+            onClick={handleTip}
+          >
+            {isTipping && <span className="loading loading-spinner loading-sm" />}
+            Send tip
+          </button>
+          {!connectedAddress && (
+            <p className="text-sm text-center text-base-content/60 mb-0">Connect a wallet to tip.</p>
+          )}
+          {needsApproval && connectedAddress && (
+            <p className="text-sm text-center text-base-content/60 mb-0">
+              USDC needs an allowance before the jar can pull your tip.
+            </p>
+          )}
+        </div>
+      </div>
+    </div>
+  );
+};
