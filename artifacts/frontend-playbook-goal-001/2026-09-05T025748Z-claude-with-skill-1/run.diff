diff --git a/packages/foundry/test/TipJar.t.sol b/packages/foundry/test/TipJar.t.sol
new file mode 100644
index 0000000..cb068c0
--- /dev/null
+++ b/packages/foundry/test/TipJar.t.sol
@@ -0,0 +1,265 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import { Test, console } from "forge-std/Test.sol";
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { Ownable } from "@openzeppelin/contracts/access/Ownable.sol";
+import { TipJar } from "../contracts/TipJar.sol";
+
+/**
+ * @notice Tests run against a fork of Base so the jar is exercised with the real,
+ *         Circle-issued USDC contract (upgradeable proxy, 6 decimals, blocklist and all)
+ *         rather than a mock that only behaves the way we assumed.
+ *
+ * Test USDC comes from a real holder via `vm.prank`, the same trick `yarn fund-demo`
+ * uses against the running fork. Set BASE_RPC_URL to use your own RPC endpoint, and
+ * BASE_FORK_BLOCK to pin the fork: a pinned block makes the run deterministic and lets
+ * foundry serve it from cache, at the cost of needing an archive RPC as it ages.
+ */
+contract TipJarForkTest is Test {
+    address constant USDC = 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913;
+    string constant DEFAULT_BASE_RPC = "https://mainnet.base.org";
+
+    uint256 constant ONE_USDC = 1e6;
+
+    IERC20 usdc = IERC20(USDC);
+    TipJar jar;
+
+    address owner = makeAddr("owner");
+    address alice = makeAddr("alice");
+    address bob = makeAddr("bob");
+
+    bool forkAvailable;
+
+    function setUp() public {
+        string memory rpcUrl = vm.envOr("BASE_RPC_URL", DEFAULT_BASE_RPC);
+        uint256 forkBlock = vm.envOr("BASE_FORK_BLOCK", uint256(0));
+
+        if (forkBlock == 0) {
+            try vm.createSelectFork(rpcUrl) {
+                forkAvailable = true;
+            } catch {
+                return;
+            }
+        } else {
+            try vm.createSelectFork(rpcUrl, forkBlock) {
+                forkAvailable = true;
+            } catch {
+                return;
+            }
+        }
+
+        jar = new TipJar(usdc, owner);
+
+        address whale = findUsdcWhale(20_000 * ONE_USDC);
+        vm.startPrank(whale);
+        usdc.transfer(alice, 10_000 * ONE_USDC);
+        usdc.transfer(bob, 10_000 * ONE_USDC);
+        vm.stopPrank();
+    }
+
+    /// @dev Skips instead of failing so the suite still runs offline or behind a dead RPC.
+    modifier requiresFork() {
+        vm.skip(!forkAvailable, "Base fork unavailable - set BASE_RPC_URL to run these tests");
+        _;
+    }
+
+    function test_TipMovesRealUsdcIntoTheJar() public requiresFork {
+        uint256 amount = 25 * ONE_USDC;
+        uint256 aliceBefore = usdc.balanceOf(alice);
+
+        vm.startPrank(alice);
+        usdc.approve(address(jar), amount);
+
+        vm.expectEmit(true, false, false, true, address(jar));
+        emit TipJar.Tipped(alice, amount, "coffee money");
+        jar.tip(amount, "coffee money");
+        vm.stopPrank();
+
+        assertEq(usdc.balanceOf(address(jar)), amount, "jar did not receive the USDC");
+        assertEq(usdc.balanceOf(alice), aliceBefore - amount, "tipper was not debited");
+        assertEq(jar.jarBalance(), amount);
+        assertEq(jar.totalTipped(), amount);
+        assertEq(jar.tipCount(), 1);
+        assertEq(jar.tippedBy(alice), amount);
+    }
+
+    function test_TipsFromSeveralAccountsAccumulate() public requiresFork {
+        tipAs(alice, 5 * ONE_USDC, "one");
+        tipAs(bob, 7 * ONE_USDC, "two");
+        tipAs(alice, 3 * ONE_USDC, "three");
+
+        assertEq(jar.totalTipped(), 15 * ONE_USDC);
+        assertEq(jar.tipCount(), 3);
+        assertEq(jar.tippedBy(alice), 8 * ONE_USDC);
+        assertEq(jar.tippedBy(bob), 7 * ONE_USDC);
+        assertEq(jar.jarBalance(), 15 * ONE_USDC);
+    }
+
+    function test_TipAcceptsAnEmptyMessage() public requiresFork {
+        tipAs(alice, ONE_USDC, "");
+        assertEq(jar.tipCount(), 1);
+    }
+
+    function test_TipRevertsOnZeroAmount() public requiresFork {
+        vm.prank(alice);
+        vm.expectRevert(TipJar.AmountIsZero.selector);
+        jar.tip(0, "nothing");
+    }
+
+    function test_TipRevertsWhenMessageIsTooLong() public requiresFork {
+        string memory tooLong = new string(141);
+
+        vm.startPrank(alice);
+        usdc.approve(address(jar), ONE_USDC);
+        vm.expectRevert(abi.encodeWithSelector(TipJar.MessageTooLong.selector, 141, 140));
+        jar.tip(ONE_USDC, tooLong);
+        vm.stopPrank();
+    }
+
+    function test_TipAcceptsAMessageAtTheLimit() public requiresFork {
+        string memory atLimit = new string(140);
+
+        vm.startPrank(alice);
+        usdc.approve(address(jar), ONE_USDC);
+        jar.tip(ONE_USDC, atLimit);
+        vm.stopPrank();
+
+        assertEq(jar.tipCount(), 1);
+    }
+
+    function test_TipRevertsWithoutAllowance() public requiresFork {
+        vm.prank(alice);
+        vm.expectRevert();
+        jar.tip(ONE_USDC, "no approval");
+    }
+
+    function test_TipRevertsWhenTipperCannotCoverIt() public requiresFork {
+        address broke = makeAddr("broke");
+        vm.startPrank(broke);
+        usdc.approve(address(jar), ONE_USDC);
+        vm.expectRevert();
+        jar.tip(ONE_USDC, "empty wallet");
+        vm.stopPrank();
+    }
+
+    function test_OwnerCanWithdraw() public requiresFork {
+        tipAs(alice, 40 * ONE_USDC, "thanks");
+        address payout = makeAddr("payout");
+
+        vm.prank(owner);
+        jar.withdraw(payout, 15 * ONE_USDC);
+
+        assertEq(usdc.balanceOf(payout), 15 * ONE_USDC);
+        assertEq(jar.jarBalance(), 25 * ONE_USDC);
+        // Withdrawing must not rewrite the tip history.
+        assertEq(jar.totalTipped(), 40 * ONE_USDC);
+    }
+
+    function test_OwnerCanWithdrawAll() public requiresFork {
+        tipAs(alice, 40 * ONE_USDC, "thanks");
+        address payout = makeAddr("payout");
+
+        vm.prank(owner);
+        jar.withdrawAll(payout);
+
+        assertEq(usdc.balanceOf(payout), 40 * ONE_USDC);
+        assertEq(jar.jarBalance(), 0);
+    }
+
+    function test_WithdrawRevertsForNonOwner() public requiresFork {
+        tipAs(alice, ONE_USDC, "hi");
+
+        vm.prank(alice);
+        vm.expectRevert(abi.encodeWithSelector(Ownable.OwnableUnauthorizedAccount.selector, alice));
+        jar.withdraw(alice, ONE_USDC);
+    }
+
+    function test_WithdrawRevertsAboveBalance() public requiresFork {
+        tipAs(alice, ONE_USDC, "hi");
+
+        vm.prank(owner);
+        vm.expectRevert(abi.encodeWithSelector(TipJar.InsufficientBalance.selector, 2 * ONE_USDC, ONE_USDC));
+        jar.withdraw(owner, 2 * ONE_USDC);
+    }
+
+    function test_WithdrawRevertsToZeroAddress() public requiresFork {
+        tipAs(alice, ONE_USDC, "hi");
+
+        vm.prank(owner);
+        vm.expectRevert(TipJar.WithdrawToZeroAddress.selector);
+        jar.withdraw(address(0), ONE_USDC);
+    }
+
+    function test_ConstructorRejectsAnAddressWithoutCode() public requiresFork {
+        address notAToken = makeAddr("notAToken");
+        vm.expectRevert(abi.encodeWithSelector(TipJar.TokenHasNoCode.selector, notAToken));
+        new TipJar(IERC20(notAToken), owner);
+    }
+
+    function test_WithdrawRevertsOnZeroAmount() public requiresFork {
+        tipAs(alice, ONE_USDC, "hi");
+
+        vm.prank(owner);
+        vm.expectRevert(TipJar.AmountIsZero.selector);
+        jar.withdraw(owner, 0);
+    }
+
+    /// @dev Renouncing would zero the owner and strand every tip, since withdraw is the only exit.
+    function test_OwnershipCannotBeRenounced() public requiresFork {
+        vm.prank(owner);
+        vm.expectRevert(TipJar.OwnershipCannotBeRenounced.selector);
+        jar.renounceOwnership();
+
+        assertEq(jar.owner(), owner);
+    }
+
+    /// @dev Ownership only moves after the new owner accepts, so a typo'd address cannot brick the jar.
+    function test_OwnershipTransferIsTwoStep() public requiresFork {
+        address newOwner = makeAddr("newOwner");
+
+        vm.prank(owner);
+        jar.transferOwnership(newOwner);
+        assertEq(jar.owner(), owner, "ownership must not move before acceptance");
+
+        vm.prank(newOwner);
+        jar.acceptOwnership();
+        assertEq(jar.owner(), newOwner);
+    }
+
+    /// forge-config: default.fuzz.runs = 32
+    function testFuzz_TipAccounting(uint256 amount) public requiresFork {
+        amount = bound(amount, 1, usdc.balanceOf(alice));
+
+        tipAs(alice, amount, "fuzz");
+
+        assertEq(jar.totalTipped(), amount);
+        assertEq(jar.tippedBy(alice), amount);
+        assertEq(jar.jarBalance(), amount);
+    }
+
+    function tipAs(address tipper, uint256 amount, string memory message) internal {
+        vm.startPrank(tipper);
+        usdc.approve(address(jar), amount);
+        jar.tip(amount, message);
+        vm.stopPrank();
+    }
+
+    /**
+     * @dev Whale balances drift over time, so try a few known Base USDC holders and take
+     *      the first one that still has enough rather than pinning a single address.
+     */
+    function findUsdcWhale(uint256 needed) internal view returns (address) {
+        address[3] memory candidates = [
+            0xBBBBBbbBBb9cC5e90e3b3Af64bdAF62C37EEFFCb, // Morpho Blue
+            0x4e65fE4DbA92790696d040ac24Aa414708F5c0AB, // Aave v3 aBasUSDC
+            0x20FE51A9229EEf2cF8Ad9E89d91CAb9312cF3b7A // Coinbase
+        ];
+
+        for (uint256 i = 0; i < candidates.length; i++) {
+            if (usdc.balanceOf(candidates[i]) >= needed) return candidates[i];
+        }
+
+        revert("No known Base USDC holder has enough left - add a fresh address to findUsdcWhale");
+    }
+}
