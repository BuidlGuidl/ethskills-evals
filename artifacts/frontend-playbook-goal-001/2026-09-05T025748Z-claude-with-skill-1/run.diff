index 0000000..d8f4be3
--- /dev/null
+++ b/packages/nextjs/utils/usdc.ts
@@ -0,0 +1,70 @@
+import { formatUnits, parseUnits } from "viem";
+
+export const USDC_DECIMALS = 6;
+
+/**
+ * What the amount field is allowed to contain while being typed — a partial entry like
+ * "1." has to survive keystroke-by-keystroke even though it is not yet a valid amount.
+ */
+const USDC_INPUT_PATTERN = /^\d*\.?\d{0,6}$/;
+
+/** A complete amount: at least one digit, at most 6 decimal places. */
+const USDC_AMOUNT_PATTERN = /^(?:\d+\.?\d{0,6}|\.\d{1,6})$/;
+
+export const isValidUsdcInput = (value: string) => USDC_INPUT_PATTERN.test(value);
+
+/** Base units for a user-typed amount, or null when the input is empty or incomplete. */
+export const parseUsdcAmount = (value: string): bigint | null => {
+  const trimmed = value.trim();
+  if (!USDC_AMOUNT_PATTERN.test(trimmed)) return null;
+  try {
+    return parseUnits(trimmed, USDC_DECIMALS);
+  } catch {
+    return null;
+  }
+};
+
+/**
+ * Truncates rather than rounds. Rounding a balance up produces an amount the user can
+ * read but not spend: 0.999999 USDC shown as "$1.00" would reject a tip of 1.
+ */
+export const formatUsdc = (baseUnits: bigint, fractionDigits = 2) => {
+  const scale = 10n ** BigInt(USDC_DECIMALS - fractionDigits);
+  const truncated = (baseUnits / scale) * scale;
+  return Number(formatUnits(truncated, USDC_DECIMALS)).toLocaleString("en-US", {
+    minimumFractionDigits: fractionDigits,
+    maximumFractionDigits: fractionDigits,
+  });
+};
+
+/**
+ * The exact amount, to as many decimals as it needs. Use where the number is the thing
+ * being authorised (an approval) rather than a balance being summarised.
+ */
+export const formatUsdcExact = (baseUnits: bigint) =>
+  Number(formatUnits(baseUnits, USDC_DECIMALS)).toLocaleString("en-US", {
+    minimumFractionDigits: 2,
+    maximumFractionDigits: USDC_DECIMALS,
+  });
+
+/** The contract limits messages by byte length, not character count — emoji cost more than one. */
+export const messageByteLength = (message: string) => new TextEncoder().encode(message).length;
+
+export const timeAgo = (timestampSeconds: bigint, now = Date.now()) => {
+  const seconds = Math.max(0, Math.floor(now / 1000 - Number(timestampSeconds)));
+  if (seconds < 60) return "just now";
+
+  const units: [Intl.RelativeTimeFormatUnit, number][] = [
+    ["minute", 60],
+    ["hour", 3600],
+    ["day", 86400],
+  ];
+
+  const formatter = new Intl.RelativeTimeFormat("en-US", { numeric: "auto" });
+  let [unit, size] = units[0];
+  for (const [candidateUnit, candidateSize] of units) {
+    if (seconds >= candidateSize) [unit, size] = [candidateUnit, candidateSize];
+  }
+
+  return formatter.format(-Math.floor(seconds / size), unit);
+};

