+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.19;
+
+import "./DeployHelpers.s.sol";
+import "../contracts/TipJar.sol";
+
+/**
+ * @notice Deploys TipJar against Base USDC.
+ * @dev Only Base (8453) or a local Base fork (31337) make sense: USDC must exist at BASE_USDC.
+ *      Tips are forwarded to TIP_RECIPIENT (env). `recipient` is immutable, so it is required on live
+ *      networks; on the local fork it defaults to the deployer (anvil account #9).
+ * Example:
+ * yarn deploy                   # local Base fork (yarn fork:base)
+ * yarn deploy --network base    # Base mainnet (requires keystore)
+ */
+contract DeployTipJar is ScaffoldETHDeploy {
+    address constant BASE_USDC = 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913;
+
+    error UsdcNotFound();
+
+    function run() external ScaffoldEthDeployerRunner {
+        // Catches deploying to a plain `yarn chain` instead of the Base fork
+        if (BASE_USDC.code.length == 0) revert UsdcNotFound();
+
+        address recipient =
+            block.chainid == 31337 ? vm.envOr("TIP_RECIPIENT", deployer) : vm.envAddress("TIP_RECIPIENT");
+        new TipJar(BASE_USDC, recipient);
+    }
+}
