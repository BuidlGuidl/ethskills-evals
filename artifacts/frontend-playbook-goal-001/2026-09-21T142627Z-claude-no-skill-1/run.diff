+"use client";
+
+import { Address } from "@scaffold-ui/components";
+import { formatUnits } from "viem";
+import { useScaffoldReadContract, useTargetNetwork } from "~~/hooks/scaffold-eth";
+
+const FEED_SIZE = 25n;
+
+export const TipFeed = () => {
+  const { targetNetwork } = useTargetNetwork();
+
+  const { data: tips, isLoading } = useScaffoldReadContract({
+    contractName: "TipJar",
+    functionName: "recentTips",
+    args: [FEED_SIZE],
+  });
+  const { data: totalTipped } = useScaffoldReadContract({ contractName: "TipJar", functionName: "totalTipped" });
+  const { data: tipCount } = useScaffoldReadContract({ contractName: "TipJar", functionName: "tipCount" });
+  const { data: recipient } = useScaffoldReadContract({ contractName: "TipJar", functionName: "recipient" });
+
+  return (
+    <div className="card bg-base-100 shadow-xl w-full">
+      <div className="card-body gap-4">
+        <h2 className="card-title">Tip feed</h2>
+
+        <div className="stats stats-vertical sm:stats-horizontal bg-base-200">
+          <div className="stat">
+            <div className="stat-title">Total tipped</div>
+            <div className="stat-value text-2xl">
+              {totalTipped === undefined ? "–" : `${formatUnits(totalTipped, 6)} USDC`}
+            </div>
+          </div>
+          <div className="stat">
+            <div className="stat-title">Tips</div>
+            <div className="stat-value text-2xl">{tipCount?.toString() ?? "–"}</div>
+          </div>
+          <div className="stat">
+            <div className="stat-title">Goes to</div>
+            <div className="stat-value text-base">
+              <Address address={recipient} chain={targetNetwork} />
+            </div>
+          </div>
+        </div>
+
+        {isLoading ? (
+          <span className="loading loading-spinner mx-auto" />
+        ) : !tips?.length ? (
+          <p className="text-center opacity-70">No tips yet. Be the first!</p>
+        ) : (
+          <ul className="flex flex-col gap-3">
+            {tips.map((tip, i) => (
+              <li key={`${tip.from}-${tip.timestamp}-${i}`} className="bg-base-200 rounded-box p-4">
+                <div className="flex flex-wrap items-center justify-between gap-2">
+                  <Address address={tip.from} chain={targetNetwork} size="sm" />
+                  <span className="badge badge-primary">{formatUnits(tip.amount, 6)} USDC</span>
+                </div>
+                {tip.message && <p className="my-2 break-words">{tip.message}</p>}
+                <time className="text-xs opacity-60">{new Date(Number(tip.timestamp) * 1000).toLocaleString()}</time>
+              </li>
+            ))}
+          </ul>
+        )}
+      </div>
+    </div>
+  );
+};
diff --git a/packages/nextjs/app/_components/TipForm.tsx b/packages/nextjs/app/_components/TipForm.tsx
new file mode 100644
index 0000000..6c180c9
--- /dev/null
+++ b/packages/nextjs/app/_components/TipForm.tsx
@@ -0,0 +1,122 @@
+"use client";
+
+import { useState } from "react";
+import { formatUnits, parseUnits } from "viem";
+import { useAccount } from "wagmi";
+import { useDeployedContractInfo, useScaffoldReadContract, useScaffoldWriteContract } from "~~/hooks/scaffold-eth";
+
+const USDC_DECIMALS = 6;
+const MAX_MESSAGE_BYTES = 280;
+
+const parseUsdc = (value: string) => {
+  try {
+    return parseUnits(value, USDC_DECIMALS);
+  } catch {
+    return 0n;
+  }
+};
+
+export const TipForm = () => {
+  const { address: connectedAddress } = useAccount();
+  const [amount, setAmount] = useState("");
+  const [message, setMessage] = useState("");
+
+  const { data: tipJar } = useDeployedContractInfo({ contractName: "TipJar" });
+
+  const { data: balance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "balanceOf",
+    args: [connectedAddress],
+  });
+  const { data: allowance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "allowance",
+    args: [connectedAddress, tipJar?.address],
+  });
+
+  const { writeContractAsync: writeUsdc, isMining: isApproving } = useScaffoldWriteContract({
+    contractName: "USDC",
+  });
+  const { writeContractAsync: writeTipJar, isMining: isTipping } = useScaffoldWriteContract({
+    contractName: "TipJar",
+  });
+
+  const amountUnits = parseUsdc(amount);
+  const messageBytes = new TextEncoder().encode(message).length;
+  const needsApproval = allowance === undefined || allowance < amountUnits;
+  const hasBalance = balance !== undefined && balance >= amountUnits;
+  const isValid = amountUnits > 0n && messageBytes <= MAX_MESSAGE_BYTES && hasBalance;
+
+  const handleApprove = async () => {
+    if (!tipJar) return;
+    try {
+      await writeUsdc({ functionName: "approve", args: [tipJar.address, amountUnits] });
+    } catch (e) {
+      console.error("Error approving USDC", e);
+    }
+  };
+
+  const handleTip = async () => {
+    try {
+      await writeTipJar({ functionName: "tip", args: [amountUnits, message] });
+      setAmount("");
+      setMessage("");
+    } catch (e) {
+      console.error("Error sending tip", e);
+    }
+  };
+
+  return (
+    <div className="card bg-base-100 shadow-xl w-full">
+      <div className="card-body gap-4">
+        <h2 className="card-title">Send a tip</h2>
+
+        <label className="flex flex-col gap-1">
+          <span className="text-sm">Amount (USDC)</span>
+          <input
+            type="text"
+            inputMode="decimal"
+            placeholder="5.00"
+            className="input input-bordered w-full"
+            value={amount}
+            onChange={e => setAmount(e.target.value.trim())}
+          />
+          <span className="text-xs opacity-70">
+            Your balance: {balance === undefined ? "–" : `${formatUnits(balance, USDC_DECIMALS)} USDC`}
+          </span>
+        </label>
+
+        <label className="flex flex-col gap-1">
+          <span className="text-sm">Message (optional)</span>
+          <textarea
+            className="textarea textarea-bordered w-full"
+            placeholder="Thanks for the great work!"
+            value={message}
+            onChange={e => setMessage(e.target.value)}
+          />
+          <span className={`text-xs ${messageBytes > MAX_MESSAGE_BYTES ? "text-error" : "opacity-70"}`}>
+            {messageBytes}/{MAX_MESSAGE_BYTES} bytes
+          </span>
+        </label>
+
+        {amountUnits > 0n && !hasBalance && balance !== undefined && (
+          <p className="text-error text-sm m-0">Not enough USDC.</p>
+        )}
+
+        {!connectedAddress ? (
+          <p className="text-sm m-0">Connect a wallet to tip.</p>
+        ) : needsApproval ? (
+          <button className="btn btn-primary" disabled={!isValid || isApproving} onClick={handleApprove}>
+            {isApproving && <span className="loading loading-spinner loading-sm" />}
+            Step 1/2: Approve {amount || "0"} USDC
+          </button>
+        ) : (
+          <button className="btn btn-primary" disabled={!isValid || isTipping} onClick={handleTip}>
+            {isTipping && <span className="loading loading-spinner loading-sm" />}
+            Send {amount || "0"} USDC tip
+          </button>
+        )}
+      </div>
+    </div>
+  );
+};
