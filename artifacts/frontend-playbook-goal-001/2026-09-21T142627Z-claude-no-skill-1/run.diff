index 0000000..ff6595e
--- /dev/null
+++ b/packages/foundry/contracts/TipJar.sol
@@ -0,0 +1,66 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { SafeERC20 } from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+
+/**
+ * @notice USDC tip jar. Tips go straight to `recipient`; the contract never holds funds.
+ * @dev Tips are also stored on-chain so a static frontend can render the feed with one
+ *      view call instead of scanning logs (no indexer needed on IPFS).
+ */
+contract TipJar {
+    using SafeERC20 for IERC20;
+
+    struct Tip {
+        address from;
+        uint96 amount;
+        uint64 timestamp;
+        string message;
+    }
+
+    uint256 public constant MAX_MESSAGE_LENGTH = 280;
+
+    IERC20 public immutable usdc;
+    address public immutable recipient;
+
+    uint256 public totalTipped;
+    Tip[] private tips;
+
+    event TipSent(address indexed from, uint256 amount, string message);
+
+    error ZeroAddress();
+    error ZeroAmount();
+    error MessageTooLong();
+
+    constructor(address _usdc, address _recipient) {
+        if (_usdc == address(0) || _recipient == address(0)) revert ZeroAddress();
+        usdc = IERC20(_usdc);
+        recipient = _recipient;
+    }
+
+    /// @notice Requires prior `usdc.approve(address(this), amount)`.
+    function tip(uint96 amount, string calldata message) external {
+        if (amount == 0) revert ZeroAmount();
+        if (bytes(message).length > MAX_MESSAGE_LENGTH) revert MessageTooLong();
+
+        totalTipped += amount;
+        tips.push(Tip(msg.sender, amount, uint64(block.timestamp), message));
+        emit TipSent(msg.sender, amount, message);
+
+        usdc.safeTransferFrom(msg.sender, recipient, amount);
+    }
+
+    function tipCount() external view returns (uint256) {
+        return tips.length;
+    }
+
+    /// @notice Up to `limit` most recent tips, newest first.
+    function recentTips(uint256 limit) external view returns (Tip[] memory result) {
+        uint256 count = tips.length < limit ? tips.length : limit;
+        result = new Tip[](count);
+        for (uint256 i = 0; i < count; i++) {
+            result[i] = tips[tips.length - 1 - i];
+        }
+    }
+}
