diff --git a/packages/nextjs/scripts/verify-ipfs.sh b/packages/nextjs/scripts/verify-ipfs.sh
new file mode 100755
index 0000000..2cbea61
--- /dev/null
+++ b/packages/nextjs/scripts/verify-ipfs.sh
@@ -0,0 +1,34 @@
+#!/usr/bin/env bash
+# Post-deploy check: every file in the local static build (out/) must be served
+# byte-identical from IPFS under the given CID.
+#
+# Usage: scripts/verify-ipfs.sh <CID> [gateway]
+#   gateway defaults to https://dweb.link (redirects to the <cid>.ipfs.dweb.link subdomain form)
+set -euo pipefail
+
+CID="${1:?usage: verify-ipfs.sh <CID> [gateway]}"
+GATEWAY="${2:-https://dweb.link}"
+OUT_DIR="$(cd "$(dirname "$0")/.." && pwd)/out"
+
+[ -d "$OUT_DIR" ] || { echo "❌ $OUT_DIR not found. Run the production build first."; exit 1; }
+
+sha() { shasum -a 256 | cut -d' ' -f1; }
+
+total=0
+failed=0
+while IFS= read -r file; do
+  rel="${file#"$OUT_DIR"/}"
+  total=$((total + 1))
+  local_hash=$(sha < "$file")
+  remote_hash=$(curl -sfL --retry 3 "$GATEWAY/ipfs/$CID/$rel" | sha) || remote_hash="fetch-failed"
+  if [ "$local_hash" != "$remote_hash" ]; then
+    echo "❌ $rel"
+    failed=$((failed + 1))
+  fi
+done < <(find "$OUT_DIR" -type f | sort)
+
+if [ "$failed" -ne 0 ]; then
+  echo "❌ $failed of $total files missing or different on IPFS"
+  exit 1
+fi
+echo "✅ All $total files match: $GATEWAY/ipfs/$CID/"
