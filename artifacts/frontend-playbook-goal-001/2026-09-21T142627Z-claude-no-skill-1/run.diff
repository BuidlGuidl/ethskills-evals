diff --git a/packages/foundry/scripts-js/fundUsdc.js b/packages/foundry/scripts-js/fundUsdc.js
new file mode 100644
index 0000000..2541146
--- /dev/null
+++ b/packages/foundry/scripts-js/fundUsdc.js
@@ -0,0 +1,82 @@
+/**
+ * Mints real Base USDC to test identities on the LOCAL Base fork (chain 31337 only).
+ *
+ * It impersonates USDC's actual masterMinter on the fork, makes it a minter and mints,
+ * so balances go through the real FiatToken code (totalSupply, Transfer events, blacklist checks).
+ * Nothing here can touch real Base: anvil impersonation only exists on the local node.
+ *
+ * Usage:
+ *   yarn fund-usdc                          # anvil accounts #0-#2, 1000 USDC each
+ *   yarn fund-usdc 0xYourBurner 0xOther     # specific addresses
+ *   yarn fund-usdc 0xYourBurner --amount 50
+ */
+import { ethers } from "ethers";
+
+const RPC_URL = process.env.RPC_URL || "http://127.0.0.1:8545";
+const LOCAL_CHAIN_ID = 31337;
+const BASE_USDC = "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913";
+const ANVIL_TEST_ACCOUNTS = [
+  "0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266",
+  "0x70997970C51812dc3A010C7d01b50e0d17dc79C8",
+  "0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC",
+];
+const MIN_ETH_FOR_GAS = ethers.utils.parseEther("1");
+
+const USDC_ABI = [
+  "function masterMinter() view returns (address)",
+  "function configureMinter(address minter, uint256 allowance) returns (bool)",
+  "function mint(address to, uint256 amount) returns (bool)",
+  "function balanceOf(address) view returns (uint256)",
+];
+
+function parseArgs(args) {
+  let amount = "1000";
+  const addresses = [];
+  for (let i = 0; i < args.length; i++) {
+    if (args[i] === "--amount") amount = args[++i];
+    else addresses.push(ethers.utils.getAddress(args[i]));
+  }
+  return {
+    amount: ethers.utils.parseUnits(amount, 6),
+    recipients: addresses.length ? addresses : ANVIL_TEST_ACCOUNTS,
+  };
+}
+
+async function main() {
+  const { amount, recipients } = parseArgs(process.argv.slice(2));
+  const provider = new ethers.providers.JsonRpcProvider(RPC_URL);
+
+  const { chainId } = await provider.getNetwork();
+  if (chainId !== LOCAL_CHAIN_ID) {
+    throw new Error(`Refusing to run: ${RPC_URL} is chain ${chainId}, expected local fork ${LOCAL_CHAIN_ID}`);
+  }
+  if ((await provider.getCode(BASE_USDC)) === "0x") {
+    throw new Error("No USDC at the Base address. Is the node a Base fork? Start it with `yarn fork:base`.");
+  }
+
+  const usdc = new ethers.Contract(BASE_USDC, USDC_ABI, provider);
+  const masterMinter = await usdc.masterMinter();
+
+  await provider.send("anvil_impersonateAccount", [masterMinter]);
+  await provider.send("anvil_setBalance", [masterMinter, ethers.utils.hexValue(MIN_ETH_FOR_GAS)]);
+  const minter = usdc.connect(provider.getSigner(masterMinter));
+
+  await (await minter.configureMinter(masterMinter, amount.mul(recipients.length))).wait();
+  for (const recipient of recipients) {
+    await (await minter.mint(recipient, amount)).wait();
+
+    // Fresh burner wallets have no ETH on the fork; top them up so they can pay gas
+    if ((await provider.getBalance(recipient)).lt(MIN_ETH_FOR_GAS)) {
+      await provider.send("anvil_setBalance", [recipient, ethers.utils.hexValue(MIN_ETH_FOR_GAS)]);
+    }
+    const balance = await usdc.balanceOf(recipient);
+    console.log(`💵 ${recipient}: ${ethers.utils.formatUnits(balance, 6)} USDC`);
+  }
+
+  await provider.send("anvil_stopImpersonatingAccount", [masterMinter]);
+}
+
+main().catch(error => {
+  console.error(`❌ ${error.message}`);
+  process.exit(1);
+});
diff --git a/packages/foundry/test/TipJar.t.sol b/packages/foundry/test/TipJar.t.sol
new file mode 100644
index 0000000..f7286de
--- /dev/null
+++ b/packages/foundry/test/TipJar.t.sol
@@ -0,0 +1,93 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import "forge-std/Test.sol";
+import { ERC20 } from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+import { IERC20Errors } from "@openzeppelin/contracts/interfaces/draft-IERC6093.sol";
+import "../contracts/TipJar.sol";
+
+contract MockUSDC is ERC20("USD Coin", "USDC") {
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    function mint(address to, uint256 amount) external {
+        _mint(to, amount);
+    }
+}
+
+contract TipJarTest is Test {
+    MockUSDC usdc;
+    TipJar tipJar;
+    address recipient = makeAddr("recipient");
+    address alice = makeAddr("alice");
+    address bob = makeAddr("bob");
+
+    function setUp() public {
+        usdc = new MockUSDC();
+        tipJar = new TipJar(address(usdc), recipient);
+        usdc.mint(alice, 100e6);
+        usdc.mint(bob, 100e6);
+    }
+
+    function _tip(address from, uint96 amount, string memory message) internal {
+        vm.startPrank(from);
+        usdc.approve(address(tipJar), amount);
+        tipJar.tip(amount, message);
+        vm.stopPrank();
+    }
+
+    function testTipForwardsUsdcAndRecords() public {
+        vm.startPrank(alice);
+        usdc.approve(address(tipJar), 5e6);
+        vm.expectEmit(address(tipJar));
+        emit TipJar.TipSent(alice, 5e6, "gm");
+        tipJar.tip(5e6, "gm");
+        vm.stopPrank();
+
+        assertEq(usdc.balanceOf(recipient), 5e6);
+        assertEq(usdc.balanceOf(alice), 95e6);
+        assertEq(usdc.balanceOf(address(tipJar)), 0);
+        assertEq(tipJar.totalTipped(), 5e6);
+        assertEq(tipJar.tipCount(), 1);
+    }
+
+    function testRecentTipsNewestFirstAndCapped() public {
+        _tip(alice, 1e6, "first");
+        _tip(bob, 2e6, "second");
+        _tip(alice, 3e6, "third");
+
+        TipJar.Tip[] memory recent = tipJar.recentTips(2);
+        assertEq(recent.length, 2);
+        assertEq(recent[0].message, "third");
+        assertEq(recent[1].from, bob);
+        assertEq(recent[1].amount, 2e6);
+
+        assertEq(tipJar.recentTips(10).length, 3);
+    }
+
+    function testRevertsOnZeroAmount() public {
+        vm.prank(alice);
+        vm.expectRevert(TipJar.ZeroAmount.selector);
+        tipJar.tip(0, "");
+    }
+
+    function testRevertsOnLongMessage() public {
+        vm.prank(alice);
+        vm.expectRevert(TipJar.MessageTooLong.selector);
+        tipJar.tip(1e6, string(new bytes(281)));
+    }
+
+    function testRevertsWithoutApproval() public {
+        vm.prank(alice);
+        vm.expectRevert(
+            abi.encodeWithSelector(IERC20Errors.ERC20InsufficientAllowance.selector, address(tipJar), 0, 1e6)
+        );
+        tipJar.tip(1e6, "");
+    }
+
+    function testConstructorRejectsZeroAddress() public {
+        vm.expectRevert(TipJar.ZeroAddress.selector);
+        new TipJar(address(usdc), address(0));
+    }
+}
