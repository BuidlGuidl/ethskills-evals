diff --git a/packages/nextjs/scripts/run-next.mjs b/packages/nextjs/scripts/run-next.mjs
new file mode 100644
index 0000000..ccebed3
--- /dev/null
+++ b/packages/nextjs/scripts/run-next.mjs
@@ -0,0 +1,37 @@
+/**
+ * Runs the Next.js CLI, working around a Node 25 pitfall.
+ *
+ * Node 25 installs a built-in `localStorage` global. With no backing file configured it is an object
+ * without the Web Storage methods, so wallet libraries feature-detect the global and then crash on
+ * `localStorage.getItem()` during server render and static prerender — including the IPFS export.
+ * `--no-experimental-webstorage` removes the global so those libraries take their non-browser path.
+ *
+ * The flag goes into NODE_OPTIONS rather than onto this process alone, so Next's build workers
+ * inherit it. It is only added when the global is actually present, because Node versions that do
+ * not know the flag reject it outright. The global is detected via its property descriptor: reading
+ * `localStorage` itself would emit a `--localstorage-file` warning on every run.
+ */
+import { spawn } from "child_process";
+import { createRequire } from "module";
+import os from "os";
+
+const FLAG = "--no-experimental-webstorage";
+
+const hasWebStorageGlobal = !!Object.getOwnPropertyDescriptor(globalThis, "localStorage");
+const needsFlag = hasWebStorageGlobal && process.allowedNodeEnvironmentFlags.has(FLAG);
+
+const nodeOptions = [process.env.NODE_OPTIONS, needsFlag ? FLAG : ""].filter(Boolean).join(" ");
+const nextBin = createRequire(import.meta.url).resolve("next/dist/bin/next");
+
+const child = spawn(process.execPath, [nextBin, ...process.argv.slice(2)], {
+  stdio: "inherit",
+  env: nodeOptions ? { ...process.env, NODE_OPTIONS: nodeOptions } : process.env,
+});
+
+child.on("error", error => {
+  console.error("Failed to start next:", error);
+  process.exit(1);
+});
+
+// Report a signal the way a shell does, so Ctrl-C in `yarn dev` is not a failure.
+child.on("exit", (code, signal) => process.exit(signal ? 128 + (os.constants.signals[signal] ?? 0) : (code ?? 1)));
