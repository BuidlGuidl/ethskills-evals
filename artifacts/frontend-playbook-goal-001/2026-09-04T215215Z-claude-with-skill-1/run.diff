+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.19;
+
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { SafeERC20 } from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+import { Ownable } from "@openzeppelin/contracts/access/Ownable.sol";
+import { ReentrancyGuard } from "@openzeppelin/contracts/utils/ReentrancyGuard.sol";
+
+/**
+ * @notice Collects ERC20 tips (USDC on Base) and keeps the feed readable on-chain.
+ * @dev Tips are stored in an array as well as emitted as events. A static frontend with no
+ *      indexer cannot scan `eth_getLogs` over the life of a mainnet chain, so `getTips`
+ *      is the source of truth for the feed and the event is for indexers/analytics.
+ */
+contract TipJar is Ownable, ReentrancyGuard {
+    using SafeERC20 for IERC20;
+
+    struct Tip {
+        address sender; // packs with `amount` into one slot
+        uint96 amount;
+        uint64 timestamp;
+        string message;
+    }
+
+    /// @notice Longest message a tipper may attach, in bytes.
+    uint256 public constant MAX_MESSAGE_LENGTH = 200;
+
+    /// @notice The token tips are denominated in (Base USDC: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913).
+    IERC20 public immutable token;
+
+    Tip[] private tips;
+
+    /// @notice Running total of every tip ever received, in token base units.
+    uint256 public totalTipped;
+
+    /// @notice Total tipped per sender, in token base units.
+    mapping(address => uint256) public tippedBy;
+
+    event TipReceived(address indexed sender, uint256 amount, string message, uint256 index);
+    event Withdrawn(address indexed to, uint256 amount);
+
+    error AmountZero();
+    error AmountTooLarge();
+    error MessageTooLong();
+    error NothingToWithdraw();
+    error TokenHasNoCode();
+    error OwnershipCannotBeRenounced();
+
+    constructor(IERC20 _token, address _owner) Ownable(_owner) {
+        if (address(_token).code.length == 0) revert TokenHasNoCode();
+        token = _token;
+    }
+
+    /**
+     * @notice Send a tip. The sender must have approved this contract for at least `amount` first.
+     * @param amount Tip size in token base units (USDC has 6 decimals, so 1 USDC == 1_000_000).
+     * @param message Public note shown in the feed; may be empty.
+     */
+    function tip(uint256 amount, string calldata message) external nonReentrant {
+        if (amount == 0) revert AmountZero();
+        if (amount > type(uint96).max) revert AmountTooLarge();
+        if (bytes(message).length > MAX_MESSAGE_LENGTH) revert MessageTooLong();
+
+        // `amount` is bounded above; a uint64 unix timestamp overflows far past any chain's lifetime.
+        tips.push(
+            Tip({
+                sender: msg.sender,
+                // forge-lint: disable-next-line(unsafe-typecast)
+                amount: uint96(amount),
+                // forge-lint: disable-next-line(unsafe-typecast)
+                timestamp: uint64(block.timestamp),
+                message: message
+            })
+        );
+
+        totalTipped += amount;
+        tippedBy[msg.sender] += amount;
+
+        emit TipReceived(msg.sender, amount, message, tips.length - 1);
+
+        // Effects before interaction: a failed pull reverts the whole call, so the feed cannot
+        // record a tip that was never paid.
+        token.safeTransferFrom(msg.sender, address(this), amount);
+    }
+
+    /// @notice Number of tips in the feed.
+    function tipCount() external view returns (uint256) {
+        return tips.length;
+    }
+
+    /**
+     * @notice Read a page of the feed, newest first.
+     * @param offset How many of the newest tips to skip.
+     * @param limit Maximum number of tips to return.
+     * @return page The tips, newest first.
+     * @return total The length of the whole feed, so a caller can turn a position in `page` into a
+     *         stable tip id: `id = total - 1 - offset - i`. Returned from the same call as the page
+     *         so the two cannot come from different blocks.
+     * @dev Returns fewer than `limit` entries near the end of the feed, and an empty array once
+     *      `offset` is past it, so a paging frontend never needs a bounds check. Note that `offset`
+     *      counts back from the newest tip: a tip arriving between two page reads shifts every
+     *      later page by one. Page with `total` (a tip id) rather than `offset` if that matters.
+     */
+    function getTips(uint256 offset, uint256 limit) external view returns (Tip[] memory page, uint256 total) {
+        total = tips.length;
+        if (offset >= total) return (new Tip[](0), total);
+
+        uint256 remaining = total - offset;
+        uint256 size = remaining < limit ? remaining : limit;
+        page = new Tip[](size);
+        for (uint256 i = 0; i < size; i++) {
+            // total - 1 - offset is the newest unskipped tip; walk backwards from there.
+            page[i] = tips[total - 1 - offset - i];
+        }
+    }
+
+    /**
+     * @notice Disabled. `withdraw` is the only way tips ever leave this contract, so renouncing
+     *         ownership would strand every tip received from that point on.
+     */
+    function renounceOwnership() public pure override {
+        revert OwnershipCannotBeRenounced();
+    }
+
+    /// @notice Send the full token balance to `to`.
+    function withdraw(address to) external onlyOwner {
+        uint256 balance = token.balanceOf(address(this));
+        if (balance == 0) revert NothingToWithdraw();
+
+        token.safeTransfer(to, balance);
+        emit Withdrawn(to, balance);
+    }
+}
