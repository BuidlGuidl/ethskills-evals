diff --git a/packages/foundry/scripts-js/fundDemoAccounts.js b/packages/foundry/scripts-js/fundDemoAccounts.js
new file mode 100644
index 0000000..20d40f8
--- /dev/null
+++ b/packages/foundry/scripts-js/fundDemoAccounts.js
@@ -0,0 +1,222 @@
+/**
+ * Funds local demo identities with real Base USDC on an Anvil fork.
+ *
+ * Nothing here is broadcast anywhere: the USDC is moved out of an existing Base holder inside the
+ * local fork, which is a throwaway copy of Base state. The script refuses to run against anything
+ * that is not a local Anvil fork carrying Base state, so it cannot touch real funds.
+ */
+import { spawnSync } from "child_process";
+
+const RPC_URL = process.env.FUND_RPC_URL ?? "http://127.0.0.1:8545";
+const USDC = "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913";
+const USDC_DECIMALS = 6;
+
+// Aave v3 Base aUSDC holds millions of USDC. Swap it for any other holder if it ever runs dry.
+const USDC_WHALE = "0x4e65fE4DbA92790696d040ac24Aa414708F5c0AB";
+
+// Anvil's first four deterministic accounts, the default demo identities.
+const DEFAULT_ACCOUNTS = [
+  "0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266",
+  "0x70997970C51812dc3A010C7d01b50e0d17dc79C8",
+  "0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC",
+  "0x90F79bf6EB2c4f870365E785982E1f101E93b906",
+];
+
+const args = process.argv.slice(2);
+
+if (args.includes("--help") || args.includes("-h")) {
+  console.log(`
+Usage: yarn fund [options] [address...]
+
+Moves real Base USDC from a whale to demo accounts on the local Anvil fork, and tops up ETH for gas.
+
+Options:
+  --amount <usdc>   USDC per account (default: 1000)
+  --eth <ether>     ETH per account (default: 1)
+  --help, -h        Show this help message
+
+Examples:
+  yarn fund                                              # Anvil accounts #0-#3
+  yarn fund 0xYourBurnerAddress                          # the burner shown in the app header
+  yarn fund --amount 250 0xAlice 0xBob
+  `);
+  process.exit(0);
+}
+
+let usdcAmount = "1000";
+let ethAmount = "1";
+const accounts = [];
+
+for (let i = 0; i < args.length; i++) {
+  if (args[i] === "--amount" && args[i + 1]) {
+    usdcAmount = args[++i];
+  } else if (args[i] === "--eth" && args[i + 1]) {
+    ethAmount = args[++i];
+  } else if (/^0x[0-9a-fA-F]{40}$/.test(args[i])) {
+    accounts.push(args[i]);
+  } else {
+    console.error(
+      `\n❌ Unrecognized argument: ${args[i]}\nRun \`yarn fund --help\` for usage.`
+    );
+    process.exit(1);
+  }
+}
+
+const targets = accounts.length > 0 ? accounts : DEFAULT_ACCOUNTS;
+
+function cast(castArgs, { allowFailure = false } = {}) {
+  const result = spawnSync("cast", castArgs, { encoding: "utf8" });
+  if (result.status !== 0 || result.error) {
+    if (allowFailure) return null;
+    console.error(
+      `\n❌ cast ${castArgs[0]} failed:\n${result.stderr || result.stdout}`
+    );
+    process.exit(1);
+  }
+  return result.stdout.trim();
+}
+
+function rpc(method, ...params) {
+  return cast(["rpc", "--rpc-url", RPC_URL, method, ...params], {
+    allowFailure: true,
+  });
+}
+
+function abort(message) {
+  console.error(`\n❌ ${message}\n`);
+  process.exit(1);
+}
+
+// --- Guards: only ever touch a local Anvil fork of Base ---------------------------------------
+
+if (!/^https?:\/\/(127\.0\.0\.1|localhost|0\.0\.0\.0)(:|\/|$)/.test(RPC_URL)) {
+  abort(
+    `Refusing to run against a non-local RPC (${RPC_URL}). This script only funds a local fork.`
+  );
+}
+
+const chainId = cast(["chain-id", "--rpc-url", RPC_URL], {
+  allowFailure: true,
+});
+if (chainId === null) {
+  abort(
+    `No node answering at ${RPC_URL}. Start the fork first:\n\n   yarn fork --network base`
+  );
+}
+if (chainId !== "31337") {
+  abort(
+    `Expected chain id 31337 (local Anvil), got ${chainId}. Refusing to continue.`
+  );
+}
+
+if (rpc("anvil_nodeInfo") === null) {
+  abort(
+    "The node at this RPC is not Anvil (no anvil_nodeInfo). Refusing to impersonate accounts."
+  );
+}
+
+if (cast(["code", USDC, "--rpc-url", RPC_URL]) === "0x") {
+  abort(
+    `No USDC code at ${USDC}: this Anvil is not forking Base.\n` +
+      `   Restart it with:  yarn fork --network base`
+  );
+}
+
+// --- Fund ---------------------------------------------------------------------------------------
+
+function toBaseUnits(decimalAmount, decimals) {
+  const [whole, fraction = ""] = decimalAmount.split(".");
+  if (
+    !/^\d+$/.test(whole) ||
+    !/^\d*$/.test(fraction) ||
+    fraction.length > decimals
+  ) {
+    abort(
+      `Invalid amount "${decimalAmount}" for a token with ${decimals} decimals.`
+    );
+  }
+  return BigInt(whole + fraction.padEnd(decimals, "0"));
+}
+
+const usdcBaseUnits = toBaseUnits(usdcAmount, USDC_DECIMALS);
+const ethWei = toBaseUnits(ethAmount, 18);
+
+const whaleBalance = BigInt(
+  cast([
+    "call",
+    USDC,
+    "balanceOf(address)(uint256)",
+    USDC_WHALE,
+    "--rpc-url",
+    RPC_URL,
+  ]).split(" ")[0]
+);
+const needed = usdcBaseUnits * BigInt(targets.length);
+if (whaleBalance < needed) {
+  abort(
+    `Whale ${USDC_WHALE} only holds ${whaleBalance} USDC base units, need ${needed}.\n` +
+      `   Pick another holder and update USDC_WHALE in this script.`
+  );
+}
+
+console.log(
+  `\n🍴 Funding ${targets.length} account(s) on the local Base fork (${RPC_URL})`
+);
+console.log(
+  `   ${usdcAmount} USDC + ${ethAmount} ETH each, USDC impersonated from ${USDC_WHALE}\n`
+);
+
+rpc("anvil_impersonateAccount", USDC_WHALE);
+// The whale is a contract with no ETH of its own on the fork; it still needs gas money to send.
+cast([
+  "rpc",
+  "--rpc-url",
+  RPC_URL,
+  "anvil_setBalance",
+  USDC_WHALE,
+  "0xde0b6b3a7640000",
+]);
+
+try {
+  for (const account of targets) {
+    cast([
+      "rpc",
+      "--rpc-url",
+      RPC_URL,
+      "anvil_setBalance",
+      account,
+      `0x${ethWei.toString(16)}`,
+    ]);
+    cast([
+      "send",
+      USDC,
+      "transfer(address,uint256)",
+      account,
+      usdcBaseUnits.toString(),
+      "--from",
+      USDC_WHALE,
+      "--unlocked",
+      "--rpc-url",
+      RPC_URL,
+    ]);
+
+    const balance = cast([
+      "call",
+      USDC,
+      "balanceOf(address)(uint256)",
+      account,
+      "--rpc-url",
+      RPC_URL,
+    ]).split(" ")[0];
+    const formatted = (Number(BigInt(balance)) / 10 ** USDC_DECIMALS).toFixed(
+      2
+    );
+    console.log(`   ✅ ${account}  ${formatted} USDC`);
+  }
+} finally {
+  rpc("anvil_stopImpersonatingAccount", USDC_WHALE);
+}
+
+console.log(
+  "\n🎉 Done. These identities can now tip each other with real USDC and no real money at risk.\n"
+);
