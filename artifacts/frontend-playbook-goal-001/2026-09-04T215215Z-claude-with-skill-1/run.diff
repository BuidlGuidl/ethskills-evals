diff --git a/packages/foundry/scripts-js/parseForkArgs.js b/packages/foundry/scripts-js/parseForkArgs.js
new file mode 100644
index 0000000..ecfc13d
--- /dev/null
+++ b/packages/foundry/scripts-js/parseForkArgs.js
@@ -0,0 +1,86 @@
+import { spawnSync } from "child_process";
+import { config } from "dotenv";
+import { join, dirname } from "path";
+import { readFileSync } from "fs";
+import { parse } from "toml";
+import { fileURLToPath } from "url";
+
+const __dirname = dirname(fileURLToPath(import.meta.url));
+config();
+
+const args = process.argv.slice(2);
+let network = "mainnet";
+let blockTime = "1";
+let blockNumber = null;
+
+if (args.includes("--help") || args.includes("-h")) {
+  console.log(`
+Usage: yarn fork [options]
+Options:
+  --network <network>       Network to fork, must exist in foundry.toml (default: mainnet)
+  --block-number <number>   Pin the fork to a block instead of forking the chain tip
+  --block-time <seconds>    Anvil mining interval (default: 1, use 0 to mine on demand)
+  --help, -h                Show this help message
+Examples:
+  yarn fork --network base
+  yarn fork --network base --block-number 50884742
+  `);
+  process.exit(0);
+}
+
+const fail = (message) => {
+  console.error(`\n\u274c ${message}\nRun \`yarn fork --help\` for usage.`);
+  process.exit(1);
+};
+
+const readNumber = (flag, value) => {
+  if (!/^\d+$/.test(value ?? ""))
+    fail(`${flag} expects a whole number, got "${value ?? ""}".`);
+  return value;
+};
+
+for (let i = 0; i < args.length; i++) {
+  if (args[i] === "--network" && args[i + 1]) {
+    network = args[++i];
+  } else if (args[i] === "--block-number") {
+    blockNumber = readNumber("--block-number", args[++i]);
+  } else if (args[i] === "--block-time") {
+    blockTime = readNumber("--block-time", args[++i]);
+  } else {
+    // Silently ignoring this would mean `yarn fork --network=base` quietly forks mainnet.
+    fail(`Unrecognized argument: ${args[i]}`);
+  }
+}
+
+try {
+  const parsedToml = parse(
+    readFileSync(join(__dirname, "..", "foundry.toml"), "utf-8")
+  );
+  if (!parsedToml.rpc_endpoints[network]) {
+    console.log(
+      `\n❌ Error: Network '${network}' not found in foundry.toml!`,
+      "\nPlease check `foundry.toml` for available networks in the [rpc_endpoints] section or add a new network."
+    );
+    process.exit(1);
+  }
+} catch (error) {
+  console.error("\n❌ Error reading or parsing foundry.toml:", error);
+  process.exit(1);
+}
+
+// Anvil resolves the alias against foundry.toml's [rpc_endpoints] itself.
+const anvilArgs = ["--fork-url", network, "--chain-id", "31337"];
+
+// Without interval mining, anvil only mines when a transaction arrives, so `block.timestamp`
+// (and every "x minutes ago" in the tip feed) freezes between demo transactions.
+if (blockTime !== "0") {
+  anvilArgs.push("--block-time", blockTime);
+}
+if (blockNumber) {
+  anvilArgs.push("--fork-block-number", blockNumber);
+}
+
+process.env.ANVIL_ARGS = anvilArgs.join(" ");
+
+const result = spawnSync("make", ["fork"], { stdio: "inherit", shell: true });
+process.exit(result.status ?? 1);
