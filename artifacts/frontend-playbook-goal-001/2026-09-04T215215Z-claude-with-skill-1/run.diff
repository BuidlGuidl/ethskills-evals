--- /dev/null
+++ b/packages/foundry/script/DeployTipJar.s.sol
@@ -0,0 +1,39 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.19;
+
+import "./DeployHelpers.s.sol";
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { TipJar } from "../contracts/TipJar.sol";
+
+/**
+ * @notice Deploy script for the USDC TipJar
+ * @dev The local chain is expected to be an Anvil *fork of Base* (`yarn fork --network base`),
+ *      which keeps chain id 31337 while serving real Base state. Canonical USDC therefore lives
+ *      at its Base address on the fork too, so we resolve the token by address and assert it has
+ *      code rather than deploying a mock.
+ * Example:
+ * yarn deploy --file DeployTipJar.s.sol            # local anvil fork of Base
+ * yarn deploy --file DeployTipJar.s.sol --network base
+ */
+contract DeployTipJar is ScaffoldETHDeploy {
+    address constant BASE_USDC = 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913;
+
+    error UnsupportedChain(uint256 chainId);
+    error NoUsdcCode();
+
+    function run() external ScaffoldEthDeployerRunner {
+        new TipJar(IERC20(_usdc()), deployer);
+    }
+
+    function _usdc() internal view returns (address) {
+        // 8453 = Base mainnet, 31337 = local Anvil fork of Base.
+        if (block.chainid != 8453 && block.chainid != 31337) {
+            revert UnsupportedChain(block.chainid);
+        }
+        if (BASE_USDC.code.length == 0) {
+            // A bare `yarn chain` lands here: chain id matches but there is no Base state behind it.
+            revert NoUsdcCode();
+        }
+        return BASE_USDC;
+    }
+}
