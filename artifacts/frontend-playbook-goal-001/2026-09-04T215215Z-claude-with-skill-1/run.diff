diff --git a/packages/nextjs/components/tipjar/utils.ts b/packages/nextjs/components/tipjar/utils.ts
new file mode 100644
index 0000000..08e0798
--- /dev/null
+++ b/packages/nextjs/components/tipjar/utils.ts
@@ -0,0 +1,31 @@
+import { formatUnits } from "viem";
+
+export const USDC_DECIMALS = 6;
+
+/**
+ * Formats a USDC base-unit amount for display, e.g. 1500000n -> "1.50".
+ *
+ * Grouping is applied to the integer part as a bigint rather than going through Number, because
+ * `totalTipped` is a uint256 accumulator that can outgrow a double.
+ */
+export const formatUsdc = (baseUnits: bigint) => {
+  const [whole, fraction = ""] = formatUnits(baseUnits, USDC_DECIMALS).split(".");
+  const grouped = BigInt(whole).toLocaleString("en-US");
+  return `${grouped}.${fraction.padEnd(2, "0").slice(0, 2)}`;
+};
+
+const plural = (value: number, unit: string) => `${value} ${unit}${value === 1 ? "" : "s"} ago`;
+
+/** Renders a unix timestamp as a coarse "time ago" label, relative to `nowSeconds`. */
+export const timeAgo = (timestamp: bigint, nowSeconds: number) => {
+  const seconds = Math.max(0, nowSeconds - Number(timestamp));
+  if (seconds < 60) return "just now";
+
+  const minutes = Math.floor(seconds / 60);
+  if (minutes < 60) return plural(minutes, "minute");
+
+  const hours = Math.floor(minutes / 60);
+  if (hours < 24) return plural(hours, "hour");
+
+  return plural(Math.floor(hours / 24), "day");
+};
