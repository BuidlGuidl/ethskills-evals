diff --git a/packages/foundry/test/TipJar.t.sol b/packages/foundry/test/TipJar.t.sol
new file mode 100644
index 0000000..95548d1
--- /dev/null
+++ b/packages/foundry/test/TipJar.t.sol
@@ -0,0 +1,234 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.19;
+
+import { Test } from "forge-std/Test.sol";
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { Ownable } from "@openzeppelin/contracts/access/Ownable.sol";
+import { TipJar } from "../contracts/TipJar.sol";
+import { MockERC20 } from "./mocks/MockERC20.sol";
+
+contract TipJarTest is Test {
+    TipJar private jar;
+    MockERC20 private usdc;
+
+    address private owner = makeAddr("owner");
+    address private alice = makeAddr("alice");
+    address private bob = makeAddr("bob");
+
+    uint256 private constant ONE_USDC = 1e6;
+
+    event TipReceived(address indexed sender, uint256 amount, string message, uint256 index);
+    event Withdrawn(address indexed to, uint256 amount);
+
+    function setUp() public {
+        usdc = new MockERC20("USD Coin", "USDC", 6);
+        jar = new TipJar(IERC20(address(usdc)), owner);
+
+        usdc.mint(alice, 1000 * ONE_USDC);
+        usdc.mint(bob, 1000 * ONE_USDC);
+        vm.prank(alice);
+        usdc.approve(address(jar), type(uint256).max);
+        vm.prank(bob);
+        usdc.approve(address(jar), type(uint256).max);
+    }
+
+    function test_TipMovesTokensAndRecordsFeedEntry() public {
+        vm.expectEmit(true, false, false, true, address(jar));
+        emit TipReceived(alice, 5 * ONE_USDC, "thanks!", 0);
+
+        vm.prank(alice);
+        jar.tip(5 * ONE_USDC, "thanks!");
+
+        assertEq(usdc.balanceOf(address(jar)), 5 * ONE_USDC);
+        assertEq(usdc.balanceOf(alice), 995 * ONE_USDC);
+        assertEq(jar.totalTipped(), 5 * ONE_USDC);
+        assertEq(jar.tippedBy(alice), 5 * ONE_USDC);
+        assertEq(jar.tipCount(), 1);
+
+        (TipJar.Tip[] memory page,) = jar.getTips(0, 10);
+        assertEq(page.length, 1);
+        assertEq(page[0].sender, alice);
+        assertEq(page[0].amount, 5 * ONE_USDC);
+        assertEq(page[0].message, "thanks!");
+        assertEq(page[0].timestamp, uint64(block.timestamp));
+    }
+
+    function test_TipRevertsWithoutApproval() public {
+        address carol = makeAddr("carol");
+        usdc.mint(carol, ONE_USDC);
+
+        vm.prank(carol);
+        vm.expectRevert();
+        jar.tip(ONE_USDC, "");
+    }
+
+    function test_TipRevertsOnZeroAmount() public {
+        vm.prank(alice);
+        vm.expectRevert(TipJar.AmountZero.selector);
+        jar.tip(0, "nice");
+    }
+
+    function test_ConstructorWiresTokenAndOwner() public view {
+        assertEq(address(jar.token()), address(usdc));
+        assertEq(jar.owner(), owner);
+    }
+
+    function test_ConstructorRejectsTokenWithoutCode() public {
+        vm.expectRevert(TipJar.TokenHasNoCode.selector);
+        new TipJar(IERC20(makeAddr("notAToken")), owner);
+    }
+
+    /// @dev The sole guard for the `uint96` downcast that stores the amount.
+    function test_TipRevertsAboveUint96Max() public {
+        uint256 tooBig = uint256(type(uint96).max) + 1;
+
+        vm.prank(alice);
+        vm.expectRevert(TipJar.AmountTooLarge.selector);
+        jar.tip(tooBig, "");
+    }
+
+    function test_TipAcceptsUint96Max() public {
+        usdc.mint(alice, type(uint96).max);
+
+        vm.prank(alice);
+        jar.tip(type(uint96).max, "");
+
+        (TipJar.Tip[] memory page,) = jar.getTips(0, 1);
+        assertEq(page[0].amount, type(uint96).max, "the boundary itself is not rejected");
+    }
+
+    function test_RenounceOwnershipIsDisabled() public {
+        vm.prank(owner);
+        vm.expectRevert(TipJar.OwnershipCannotBeRenounced.selector);
+        jar.renounceOwnership();
+
+        assertEq(jar.owner(), owner, "the jar always has someone who can withdraw");
+    }
+
+    /// @dev Effects run before the token pull, so a failing pull must roll the feed back.
+    function test_FailedTransferLeavesNoFeedEntry() public {
+        address broke = makeAddr("broke");
+        vm.startPrank(broke);
+        usdc.approve(address(jar), type(uint256).max);
+        vm.expectRevert();
+        jar.tip(ONE_USDC, "should not appear");
+        vm.stopPrank();
+
+        assertEq(jar.tipCount(), 0);
+        assertEq(jar.totalTipped(), 0);
+    }
+
+    function test_TipRevertsOnOversizedMessage() public {
+        string memory tooLong = new string(jar.MAX_MESSAGE_LENGTH() + 1);
+
+        vm.prank(alice);
+        vm.expectRevert(TipJar.MessageTooLong.selector);
+        jar.tip(ONE_USDC, tooLong);
+    }
+
+    function test_TipAcceptsMessageAtMaxLength() public {
+        string memory atLimit = new string(jar.MAX_MESSAGE_LENGTH());
+
+        vm.prank(alice);
+        jar.tip(ONE_USDC, atLimit);
+
+        (TipJar.Tip[] memory page,) = jar.getTips(0, 1);
+        assertEq(bytes(page[0].message).length, jar.MAX_MESSAGE_LENGTH());
+    }
+
+    function test_GetTipsReturnsNewestFirstAndPages() public {
+        _tip(alice, 1 * ONE_USDC, "one");
+        _tip(bob, 2 * ONE_USDC, "two");
+        _tip(alice, 3 * ONE_USDC, "three");
+
+        (TipJar.Tip[] memory firstPage, uint256 total) = jar.getTips(0, 2);
+        assertEq(total, 3, "total is the whole feed, not the page");
+        assertEq(firstPage.length, 2);
+        assertEq(firstPage[0].message, "three");
+        assertEq(firstPage[1].message, "two");
+
+        (TipJar.Tip[] memory secondPage,) = jar.getTips(2, 2);
+        assertEq(secondPage.length, 1, "truncates at the end of the feed");
+        assertEq(secondPage[0].message, "one");
+
+        (TipJar.Tip[] memory pastEnd, uint256 totalPastEnd) = jar.getTips(3, 2);
+        assertEq(pastEnd.length, 0, "past the end is empty, not a revert");
+        assertEq(totalPastEnd, 3, "total is still reported past the end");
+
+        (TipJar.Tip[] memory zeroLimit,) = jar.getTips(0, 0);
+        assertEq(zeroLimit.length, 0);
+    }
+
+    function test_GetTipsOnEmptyFeed() public view {
+        (TipJar.Tip[] memory page, uint256 total) = jar.getTips(0, 10);
+        assertEq(page.length, 0);
+        assertEq(total, 0);
+    }
+
+    function test_TippedByAccumulatesPerSender() public {
+        _tip(alice, 1 * ONE_USDC, "");
+        _tip(alice, 2 * ONE_USDC, "");
+        _tip(bob, 4 * ONE_USDC, "");
+
+        assertEq(jar.tippedBy(alice), 3 * ONE_USDC);
+        assertEq(jar.tippedBy(bob), 4 * ONE_USDC);
+        assertEq(jar.totalTipped(), 7 * ONE_USDC);
+    }
+
+    function test_WithdrawSendsFullBalanceToOwnerChoice() public {
+        _tip(alice, 10 * ONE_USDC, "");
+        address payout = makeAddr("payout");
+
+        vm.expectEmit(true, false, false, true, address(jar));
+        emit Withdrawn(payout, 10 * ONE_USDC);
+
+        vm.prank(owner);
+        jar.withdraw(payout);
+
+        assertEq(usdc.balanceOf(payout), 10 * ONE_USDC);
+        assertEq(usdc.balanceOf(address(jar)), 0);
+    }
+
+    function test_WithdrawRevertsForNonOwner() public {
+        _tip(alice, ONE_USDC, "");
+
+        vm.prank(alice);
+        vm.expectRevert(abi.encodeWithSelector(Ownable.OwnableUnauthorizedAccount.selector, alice));
+        jar.withdraw(alice);
+    }
+
+    function test_WithdrawRevertsWhenEmpty() public {
+        vm.prank(owner);
+        vm.expectRevert(TipJar.NothingToWithdraw.selector);
+        jar.withdraw(owner);
+    }
+
+    /// @dev The feed keeps history: withdrawing does not erase past tips.
+    function test_WithdrawKeepsFeedIntact() public {
+        _tip(alice, ONE_USDC, "kept");
+
+        vm.prank(owner);
+        jar.withdraw(owner);
+
+        assertEq(jar.tipCount(), 1);
+        (TipJar.Tip[] memory page,) = jar.getTips(0, 1);
+        assertEq(page[0].message, "kept");
+        assertEq(jar.totalTipped(), ONE_USDC);
+    }
+
+    function testFuzz_TipRecordsExactAmount(uint96 amount) public {
+        amount = uint96(bound(amount, 1, uint96(1000 * ONE_USDC)));
+
+        vm.prank(alice);
+        jar.tip(amount, "");
+
+        assertEq(usdc.balanceOf(address(jar)), amount);
+        (TipJar.Tip[] memory page,) = jar.getTips(0, 1);
+        assertEq(page[0].amount, amount);
+    }
+
+    function _tip(address from, uint256 amount, string memory message) private {
+        vm.prank(from);
+        jar.tip(amount, message);
+    }
+}
diff --git a/packages/foundry/test/TipJarFork.t.sol b/packages/foundry/test/TipJarFork.t.sol
new file mode 100644
index 0000000..fc5310c
--- /dev/null
+++ b/packages/foundry/test/TipJarFork.t.sol
@@ -0,0 +1,89 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.19;
+
+import { Test, console } from "forge-std/Test.sol";
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { TipJar } from "../contracts/TipJar.sol";
+
+/**
+ * @notice Exercises TipJar against the real Base USDC contract on a Base fork.
+ * @dev Needs network access to the `base` RPC endpoint in foundry.toml. When the fork cannot be
+ *      created the suite skips instead of failing, so `yarn test` stays useful offline.
+ *      Run explicitly with: forge test --match-contract TipJarFork -vv
+ */
+contract TipJarForkTest is Test {
+    IERC20 constant USDC = IERC20(0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913);
+
+    /// @dev Aave v3 Base aUSDC holds millions of USDC and is the same address the demo funding script uses.
+    address constant USDC_WHALE = 0x4e65fE4DbA92790696d040ac24Aa414708F5c0AB;
+
+    uint256 constant ONE_USDC = 1e6;
+
+    /// @dev Pinned so the whale's balance and the RPC cache are deterministic across runs.
+    uint256 constant FORK_BLOCK = 50884742;
+
+    TipJar private jar;
+    address private owner = makeAddr("owner");
+    address private tipper = makeAddr("tipper");
+
+    function setUp() public {
+        // vm.rpcUrl is evaluated here rather than inside try(), which only catches the call itself.
+        string memory rpcUrl = vm.rpcUrl("base");
+        try vm.createSelectFork(rpcUrl, FORK_BLOCK) {
+            jar = new TipJar(USDC, owner);
+            _fundFromWhale(tipper, 100 * ONE_USDC);
+        } catch {
+            console.log("Skipping fork tests: could not reach the `base` RPC endpoint.");
+            vm.skip(true);
+        }
+    }
+
+    function test_ForkUsesCanonicalBaseUsdc() public view {
+        assertEq(address(jar.token()), address(USDC));
+        assertGt(address(USDC).code.length, 0, "no USDC code: not a Base fork");
+    }
+
+    function test_TipMovesRealUsdc() public {
+        vm.startPrank(tipper);
+        USDC.approve(address(jar), 25 * ONE_USDC);
+        jar.tip(25 * ONE_USDC, "gm from the fork");
+        vm.stopPrank();
+
+        assertEq(USDC.balanceOf(address(jar)), 25 * ONE_USDC);
+        assertEq(USDC.balanceOf(tipper), 75 * ONE_USDC);
+        (TipJar.Tip[] memory page,) = jar.getTips(0, 1);
+        assertEq(page[0].message, "gm from the fork");
+    }
+
+    /// @dev USDC's `approve` returns a bool; SafeERC20 must not choke on the real implementation.
+    function test_ExactAllowanceIsConsumed() public {
+        vm.startPrank(tipper);
+        USDC.approve(address(jar), 10 * ONE_USDC);
+        jar.tip(10 * ONE_USDC, "");
+        vm.stopPrank();
+
+        assertEq(USDC.allowance(tipper, address(jar)), 0);
+
+        vm.prank(tipper);
+        vm.expectRevert();
+        jar.tip(1, "no allowance left");
+    }
+
+    function test_OwnerWithdrawsRealUsdc() public {
+        vm.startPrank(tipper);
+        USDC.approve(address(jar), 40 * ONE_USDC);
+        jar.tip(40 * ONE_USDC, "");
+        vm.stopPrank();
+
+        vm.prank(owner);
+        jar.withdraw(owner);
+
+        assertEq(USDC.balanceOf(owner), 40 * ONE_USDC);
+    }
+
+    function _fundFromWhale(address to, uint256 amount) private {
+        require(USDC.balanceOf(USDC_WHALE) >= amount, "whale is drained; pick another holder");
+        vm.prank(USDC_WHALE);
+        USDC.transfer(to, amount);
+    }
+}
