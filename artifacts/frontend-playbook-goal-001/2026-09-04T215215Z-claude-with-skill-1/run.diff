diff --git a/packages/nextjs/components/tipjar/TipFeed.tsx b/packages/nextjs/components/tipjar/TipFeed.tsx
new file mode 100644
index 0000000..acc963a
--- /dev/null
+++ b/packages/nextjs/components/tipjar/TipFeed.tsx
@@ -0,0 +1,72 @@
+"use client";
+
+import { formatUsdc, timeAgo } from "./utils";
+import { Address } from "@scaffold-ui/components";
+import { useBlock } from "wagmi";
+import { useScaffoldReadContract, useTargetNetwork } from "~~/hooks/scaffold-eth";
+
+const PAGE_SIZE = 25n;
+
+export const TipFeed = () => {
+  const { targetNetwork } = useTargetNetwork();
+  const { data, isLoading } = useScaffoldReadContract({
+    contractName: "TipJar",
+    functionName: "getTips",
+    args: [0n, PAGE_SIZE],
+  });
+  // getTips returns the page and the whole feed length from one call, so the id below cannot be
+  // skewed by a tip landing between two separate reads.
+  const [tips, total] = data ?? [];
+  const feedLength = total ?? 0n;
+
+  // Chain time, not wall-clock time: on a fork these only match while anvil keeps mining. Seeding
+  // from Date.now() instead would be impure during render and would not survive hydration of the
+  // static export, so the label holds a placeholder until the first block lands.
+  const { data: latestBlock } = useBlock({ watch: true, chainId: targetNetwork.id });
+  const now = latestBlock ? Number(latestBlock.timestamp) : undefined;
+
+  if (isLoading) {
+    return (
+      <div className="flex flex-col gap-3">
+        {[0, 1, 2].map(i => (
+          <div key={i} className="skeleton h-20 w-full" />
+        ))}
+      </div>
+    );
+  }
+
+  if (!tips?.length) {
+    return (
+      <div className="card bg-base-100 shadow-xl">
+        <div className="card-body items-center text-center">
+          <p className="m-0 opacity-70">No tips yet. Be the first.</p>
+        </div>
+      </div>
+    );
+  }
+
+  return (
+    <ul className="flex flex-col gap-3 list-none p-0 m-0">
+      {tips.map((tip, i) => {
+        // The tip's index in the feed. Position within the page is not stable — new tips prepend —
+        // and content is not unique: the same sender can tip the same amount twice in one block.
+        const id = String(feedLength - 1n - BigInt(i));
+
+        return (
+          <li key={id} className="card bg-base-100 shadow-xl">
+            <div className="card-body py-4 gap-2">
+              <div className="flex items-center justify-between gap-3 flex-wrap">
+                <Address address={tip.sender} chain={targetNetwork} size="sm" />
+                <div className="flex items-baseline gap-2">
+                  <span className="badge badge-primary badge-lg font-semibold">{formatUsdc(tip.amount)} USDC</span>
+                  <span className="text-xs opacity-60">{now === undefined ? "…" : timeAgo(tip.timestamp, now)}</span>
+                </div>
+              </div>
+              {tip.message && <p className="m-0 break-words">{tip.message}</p>}
+            </div>
+          </li>
+        );
+      })}
+    </ul>
+  );
+};
diff --git a/packages/nextjs/components/tipjar/TipForm.tsx b/packages/nextjs/components/tipjar/TipForm.tsx
new file mode 100644
index 0000000..857551a
--- /dev/null
+++ b/packages/nextjs/components/tipjar/TipForm.tsx
@@ -0,0 +1,164 @@
+"use client";
+
+import { useState } from "react";
+import { USDC_DECIMALS, formatUsdc } from "./utils";
+import { BaseInput } from "@scaffold-ui/components";
+import { parseUnits } from "viem";
+import { useAccount } from "wagmi";
+import { useDeployedContractInfo, useScaffoldReadContract, useScaffoldWriteContract } from "~~/hooks/scaffold-eth";
+
+const QUICK_AMOUNTS = ["1", "5", "25"];
+
+// Mirrors TipJar.MAX_MESSAGE_LENGTH, used only until the on-chain value loads.
+const FALLBACK_MAX_MESSAGE_BYTES = 200;
+
+const byteLength = (value: string) => new TextEncoder().encode(value).length;
+
+/** Parses a user-typed USDC amount, returning undefined for anything unusable. */
+const parseAmount = (value: string) => {
+  const trimmed = value.trim();
+  // parseUnits silently rounds anything finer than USDC's 6 decimals, so reject it instead.
+  if (!/^\d+(\.\d{1,6})?$/.test(trimmed)) return undefined;
+
+  const parsed = parseUnits(trimmed, USDC_DECIMALS);
+  return parsed > 0n ? parsed : undefined;
+};
+
+export const TipForm = () => {
+  const [amount, setAmount] = useState("");
+  const [message, setMessage] = useState("");
+
+  const { address: connectedAddress } = useAccount();
+  const { data: tipJar } = useDeployedContractInfo({ contractName: "TipJar" });
+
+  const { data: maxMessageLength } = useScaffoldReadContract({
+    contractName: "TipJar",
+    functionName: "MAX_MESSAGE_LENGTH",
+  });
+  const { data: balance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "balanceOf",
+    args: [connectedAddress],
+  });
+  const { data: allowance, refetch: refetchAllowance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "allowance",
+    args: [connectedAddress, tipJar?.address],
+  });
+
+  const { writeContractAsync: writeUsdc, isMining: isApproving } = useScaffoldWriteContract({ contractName: "USDC" });
+  const { writeContractAsync: writeTipJar, isMining: isTipping } = useScaffoldWriteContract({
+    contractName: "TipJar",
+  });
+
+  const parsedAmount = parseAmount(amount);
+  const messageBytes = byteLength(message);
+
+  const insufficientBalance = parsedAmount !== undefined && balance !== undefined && parsedAmount > balance;
+  const maxMessageBytes = maxMessageLength !== undefined ? Number(maxMessageLength) : FALLBACK_MAX_MESSAGE_BYTES;
+  const messageTooLong = messageBytes > maxMessageBytes;
+  const needsApproval = parsedAmount !== undefined && allowance !== undefined && allowance < parsedAmount;
+
+  const amountError = amount.trim() !== "" && parsedAmount === undefined;
+  const isBusy = isApproving || isTipping;
+  const canSubmit = !!connectedAddress && parsedAmount !== undefined && !insufficientBalance && !messageTooLong;
+
+  const handleApprove = async () => {
+    if (!parsedAmount || !tipJar) return;
+    try {
+      // Resolves to undefined without throwing when the wallet is disconnected or on the wrong
+      // chain — it has already notified the user, so there is nothing to refetch.
+      const hash = await writeUsdc({ functionName: "approve", args: [tipJar.address, parsedAmount] });
+      if (!hash) return;
+      await refetchAllowance();
+    } catch (error) {
+      // useScaffoldWriteContract already surfaced this to the user.
+      console.error("approve failed", error);
+    }
+  };
+
+  const handleTip = async () => {
+    if (!parsedAmount) return;
+    try {
+      const hash = await writeTipJar({ functionName: "tip", args: [parsedAmount, message] });
+      // Keep what the user typed unless the tip actually landed.
+      if (!hash) return;
+      setAmount("");
+      setMessage("");
+      await refetchAllowance();
+    } catch (error) {
+      console.error("tip failed", error);
+    }
+  };
+
+  return (
+    <div className="card bg-base-100 shadow-xl w-full">
+      <div className="card-body gap-4">
+        <div className="flex items-baseline justify-between gap-2">
+          <h2 className="card-title">Send a tip</h2>
+          {balance !== undefined && <span className="text-sm opacity-70">Balance: {formatUsdc(balance)} USDC</span>}
+        </div>
+
+        <div className="flex flex-col gap-2">
+          <BaseInput
+            name="amount"
+            value={amount}
+            onChange={setAmount}
+            placeholder="0.00"
+            error={amountError || insufficientBalance}
+            disabled={isBusy}
+            suffix={<span className="self-center px-3 font-medium opacity-70">USDC</span>}
+          />
+          <div className="flex gap-2">
+            {QUICK_AMOUNTS.map(quick => (
+              <button
+                key={quick}
+                type="button"
+                className="btn btn-xs btn-ghost"
+                disabled={isBusy}
+                onClick={() => setAmount(quick)}
+              >
+                {quick} USDC
+              </button>
+            ))}
+          </div>
+          {insufficientBalance && <span className="text-error text-sm">Not enough USDC in this wallet.</span>}
+        </div>
+
+        <div className="flex flex-col gap-1">
+          <BaseInput
+            name="message"
+            value={message}
+            onChange={setMessage}
+            placeholder="Say something nice (optional)"
+            error={messageTooLong}
+            disabled={isBusy}
+          />
+          <span className={`text-xs self-end ${messageTooLong ? "text-error" : "opacity-60"}`}>
+            {messageBytes}/{maxMessageBytes}
+          </span>
+        </div>
+
+        <div className="card-actions">
+          {needsApproval ? (
+            <button className="btn btn-primary w-full" disabled={!canSubmit || isBusy} onClick={handleApprove}>
+              {isApproving ? <span className="loading loading-spinner loading-sm" /> : `Approve ${amount} USDC`}
+            </button>
+          ) : (
+            <button className="btn btn-primary w-full" disabled={!canSubmit || isBusy} onClick={handleTip}>
+              {isTipping ? <span className="loading loading-spinner loading-sm" /> : "Send tip"}
+            </button>
+          )}
+        </div>
+
+        {!connectedAddress && <p className="text-sm text-center opacity-70 m-0">Connect a wallet to tip.</p>}
+        {needsApproval && canSubmit && (
+          <p className="text-xs text-center opacity-60 m-0">
+            USDC is pull-based, so each tip is approve-then-send. The approval is for exactly this amount and the tip
+            consumes all of it.
+          </p>
+        )}
+      </div>
+    </div>
+  );
+};
