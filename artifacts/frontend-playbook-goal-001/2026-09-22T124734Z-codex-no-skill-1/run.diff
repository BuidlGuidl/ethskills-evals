new file mode 100644
index 0000000..3970177
--- /dev/null
+++ b/packages/foundry/test/USDCTipJar.t.sol
@@ -0,0 +1,74 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import { ERC20 } from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+import { Test } from "forge-std/Test.sol";
+import { USDCTipJar } from "../contracts/USDCTipJar.sol";
+
+contract MockUSDC is ERC20 {
+    constructor() ERC20("USD Coin", "USDC") { }
+
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    function mint(address to, uint256 amount) external {
+        _mint(to, amount);
+    }
+}
+
+contract USDCTipJarTest is Test {
+    event TipSent(
+        address indexed tipper, address indexed recipient, uint256 indexed tipId, uint256 amount, string message
+    );
+
+    MockUSDC internal usdc;
+    USDCTipJar internal tipJar;
+
+    address internal recipient = makeAddr("recipient");
+    address internal tipper = makeAddr("tipper");
+
+    function setUp() public {
+        usdc = new MockUSDC();
+        tipJar = new USDCTipJar(recipient, usdc);
+        usdc.mint(tipper, 100e6);
+    }
+
+    function testConstructorStoresRecipientAndToken() public view {
+        assertEq(tipJar.recipient(), recipient);
+        assertEq(address(tipJar.usdc()), address(usdc));
+    }
+
+    function testTipTransfersUSDCAndEmitsEvent() public {
+        vm.startPrank(tipper);
+        usdc.approve(address(tipJar), 25e6);
+
+        vm.expectEmit(true, true, true, true);
+        emit TipSent(tipper, recipient, 1, 25e6, "ship it");
+
+        uint256 tipId = tipJar.tip(25e6, "ship it");
+        vm.stopPrank();
+
+        assertEq(tipId, 1);
+        assertEq(usdc.balanceOf(recipient), 25e6);
+        assertEq(usdc.balanceOf(tipper), 75e6);
+        assertEq(tipJar.tipCount(), 1);
+        assertEq(tipJar.totalTips(), 25e6);
+        assertEq(tipJar.totalTippedBy(tipper), 25e6);
+    }
+
+    function testTipRevertsForZeroAmount() public {
+        vm.expectRevert(USDCTipJar.ZeroAmount.selector);
+        tipJar.tip(0, "");
+    }
+
+    function testConstructorRevertsForInvalidRecipient() public {
+        vm.expectRevert(USDCTipJar.InvalidRecipient.selector);
+        new USDCTipJar(address(0), usdc);
+    }
+
+    function testConstructorRevertsForInvalidToken() public {
+        vm.expectRevert(USDCTipJar.InvalidToken.selector);
+        new USDCTipJar(recipient, MockUSDC(address(0)));
+    }
+}
