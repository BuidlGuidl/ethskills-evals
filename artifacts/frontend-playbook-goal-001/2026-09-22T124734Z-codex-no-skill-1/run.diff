+++ b/packages/foundry/contracts/USDCTipJar.sol
@@ -0,0 +1,50 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { SafeERC20 } from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+
+contract USDCTipJar {
+    using SafeERC20 for IERC20;
+
+    error InvalidRecipient();
+    error InvalidToken();
+    error ZeroAmount();
+
+    IERC20 public immutable usdc;
+    address public immutable recipient;
+    uint256 public tipCount;
+    uint256 public totalTips;
+
+    mapping(address tipper => uint256 amount) public totalTippedBy;
+
+    event TipSent(
+        address indexed tipper, address indexed recipient, uint256 indexed tipId, uint256 amount, string message
+    );
+
+    constructor(address _recipient, IERC20 _usdc) {
+        if (_recipient == address(0)) {
+            revert InvalidRecipient();
+        }
+        if (address(_usdc) == address(0)) {
+            revert InvalidToken();
+        }
+
+        recipient = _recipient;
+        usdc = _usdc;
+    }
+
+    function tip(uint256 amount, string calldata message) external returns (uint256 tipId) {
+        if (amount == 0) {
+            revert ZeroAmount();
+        }
+
+        tipId = ++tipCount;
+        totalTips += amount;
+        totalTippedBy[msg.sender] += amount;
+
+        usdc.safeTransferFrom(msg.sender, recipient, amount);
+
+        emit TipSent(msg.sender, recipient, tipId, amount, message);
+    }
+}
