+};
diff --git a/packages/nextjs/app/_components/TipForm.tsx b/packages/nextjs/app/_components/TipForm.tsx
new file mode 100644
index 0000000..a51c362
--- /dev/null
+++ b/packages/nextjs/app/_components/TipForm.tsx
@@ -0,0 +1,111 @@
+"use client";
+
+import { useState } from "react";
+import { formatUnits, parseUnits } from "viem";
+import { useAccount } from "wagmi";
+import { useDeployedContractInfo, useScaffoldReadContract, useScaffoldWriteContract } from "~~/hooks/scaffold-eth";
+
+const USDC_DECIMALS = 6;
+// Mirrors TipJar.MAX_MESSAGE_LENGTH (bytes, not characters).
+const MAX_MESSAGE_BYTES = 280;
+
+const parseUsdc = (value: string) => {
+  try {
+    const amount = parseUnits(value, USDC_DECIMALS);
+    return amount > 0n ? amount : undefined;
+  } catch {
+    return undefined;
+  }
+};
+
+export const TipForm = () => {
+  const { address } = useAccount();
+  const [amount, setAmount] = useState("");
+  const [message, setMessage] = useState("");
+
+  const { data: tipJar } = useDeployedContractInfo({ contractName: "TipJar" });
+  const { data: balance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "balanceOf",
+    args: [address],
+  });
+  const { data: allowance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "allowance",
+    args: [address, tipJar?.address],
+  });
+
+  const { writeContractAsync: writeUsdc, isMining: isApproving } = useScaffoldWriteContract({ contractName: "USDC" });
+  const { writeContractAsync: writeTipJar, isMining: isTipping } = useScaffoldWriteContract({ contractName: "TipJar" });
+
+  const parsedAmount = parseUsdc(amount);
+  const messageBytes = new TextEncoder().encode(message).length;
+  const needsApproval = parsedAmount !== undefined && (allowance ?? 0n) < parsedAmount;
+  const insufficientBalance = parsedAmount !== undefined && balance !== undefined && balance < parsedAmount;
+  const isBusy = isApproving || isTipping;
+  const canSubmit =
+    address && tipJar && parsedAmount && !insufficientBalance && messageBytes <= MAX_MESSAGE_BYTES && !isBusy;
+
+  const handleTip = async () => {
+    if (!tipJar || !parsedAmount) return;
+    try {
+      if (needsApproval) {
+        await writeUsdc({ functionName: "approve", args: [tipJar.address, parsedAmount] });
+      }
+      await writeTipJar({ functionName: "tip", args: [parsedAmount, message] });
+      setAmount("");
+      setMessage("");
+    } catch (e) {
+      // useTransactor already shows the error notification
+      console.error("Tip failed", e);
+    }
+  };
+
+  const buttonLabel = isApproving ? "Approving…" : isTipping ? "Sending…" : needsApproval ? "Approve & tip" : "Tip";
+
+  return (
+    <div className="card bg-base-100 shadow-xl w-full">
+      <div className="card-body gap-4">
+        <h2 className="card-title">Send a tip</h2>
+
+        <label className="form-control w-full">
+          <div className="label">
+            <span className="label-text">Amount (USDC)</span>
+            <span className="label-text-alt">
+              Balance: {balance !== undefined ? formatUnits(balance, USDC_DECIMALS) : "–"} USDC
+            </span>
+          </div>
+          <input
+            className={`input input-bordered w-full ${insufficientBalance ? "input-error" : ""}`}
+            inputMode="decimal"
+            placeholder="5.00"
+            value={amount}
+            onChange={e => setAmount(e.target.value.trim())}
+          />
+        </label>
+
+        <label className="form-control w-full">
+          <div className="label">
+            <span className="label-text">Message</span>
+            <span className={`label-text-alt ${messageBytes > MAX_MESSAGE_BYTES ? "text-error" : ""}`}>
+              {messageBytes}/{MAX_MESSAGE_BYTES}
+            </span>
+          </div>
+          <textarea
+            className="textarea textarea-bordered w-full"
+            placeholder="Thanks for the great work!"
+            value={message}
+            onChange={e => setMessage(e.target.value)}
+          />
+        </label>
+
+        {insufficientBalance && <p className="text-error text-sm m-0">Not enough USDC.</p>}
+
+        <button className="btn btn-primary" disabled={!canSubmit} onClick={handleTip}>
+          {isBusy && <span className="loading loading-spinner loading-sm" />}
+          {address ? buttonLabel : "Connect a wallet to tip"}
+        </button>
+      </div>
+    </div>
+  );
+};
