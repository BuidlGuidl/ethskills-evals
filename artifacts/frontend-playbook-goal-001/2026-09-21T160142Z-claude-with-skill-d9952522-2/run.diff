@@ -0,0 +1,61 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.19;
+
+import "forge-std/Test.sol";
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import "../contracts/TipJar.sol";
+
+/// @notice Runs against real Base USDC on a Base fork. Set BASE_RPC_URL to run; skipped otherwise.
+contract TipJarForkTest is Test {
+    IERC20 constant USDC = IERC20(0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913);
+
+    TipJar tipJar;
+    address recipient = makeAddr("recipient");
+    address tipper = makeAddr("tipper");
+
+    event Tip(address indexed tipper, uint256 amount, string message);
+
+    function setUp() public {
+        string memory rpc = vm.envOr("BASE_RPC_URL", string(""));
+        if (bytes(rpc).length == 0) vm.skip(true);
+        vm.createSelectFork(rpc);
+
+        tipJar = new TipJar(USDC, recipient);
+        deal(address(USDC), tipper, 100e6);
+        vm.prank(tipper);
+        USDC.approve(address(tipJar), type(uint256).max);
+    }
+
+    function testTipMovesUsdcToRecipient() public {
+        vm.expectEmit(address(tipJar));
+        emit Tip(tipper, 5e6, "gm");
+        vm.prank(tipper);
+        tipJar.tip(5e6, "gm");
+
+        assertEq(USDC.balanceOf(recipient), 5e6);
+        assertEq(USDC.balanceOf(tipper), 95e6);
+        assertEq(USDC.balanceOf(address(tipJar)), 0);
+        assertEq(tipJar.totalTipped(), 5e6);
+    }
+
+    function testRevertsOnZeroAmount() public {
+        vm.prank(tipper);
+        vm.expectRevert(TipJar.ZeroAmount.selector);
+        tipJar.tip(0, "gm");
+    }
+
+    function testRevertsOnLongMessage() public {
+        vm.prank(tipper);
+        vm.expectRevert(TipJar.MessageTooLong.selector);
+        tipJar.tip(1e6, string(new bytes(281)));
+    }
+
+    function testRevertsWithoutBalance() public {
+        address broke = makeAddr("broke");
+        vm.startPrank(broke);
+        USDC.approve(address(tipJar), 1e6);
+        vm.expectRevert();
+        tipJar.tip(1e6, "gm");
+        vm.stopPrank();
+    }
+}
