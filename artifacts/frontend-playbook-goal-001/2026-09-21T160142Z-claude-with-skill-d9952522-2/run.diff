diff --git a/packages/foundry/scripts/fund_usdc.sh b/packages/foundry/scripts/fund_usdc.sh
new file mode 100755
index 0000000..4f426cf
--- /dev/null
+++ b/packages/foundry/scripts/fund_usdc.sh
@@ -0,0 +1,41 @@
+#!/usr/bin/env bash
+# Moves real Base USDC from an existing holder to <address> on the LOCAL Base fork.
+# Nothing is broadcast to Base: impersonation only exists on Anvil.
+set -euo pipefail
+
+TO=${1:?usage: yarn fund:usdc <address> [amountUsdc=1000]}
+AMOUNT=${2:-1000}
+RPC=${RPC_URL:-http://127.0.0.1:8545}
+USDC=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
+# Morpho Blue singleton, one of the largest USDC holders on Base. Override if it ever runs dry.
+WHALE=${USDC_WHALE:-0xBBBBBbbBBb9cC5e90e3b3Af64bdAF62C37EEFFCb}
+
+if [ "$(cast chain-id --rpc-url "$RPC")" != "31337" ]; then
+  echo "❌ $RPC is not the local fork (chain id 31337). Refusing." >&2
+  exit 1
+fi
+if [ "$(cast code "$USDC" --rpc-url "$RPC")" = "0x" ]; then
+  echo "❌ No USDC at $USDC. Start the chain with 'yarn fork base', not 'yarn chain'." >&2
+  exit 1
+fi
+
+RAW=$(cast parse-units "$AMOUNT" 6)
+WHALE_BAL=$(cast call "$USDC" "balanceOf(address)(uint256)" "$WHALE" --rpc-url "$RPC" | cut -d' ' -f1)
+if [ "$WHALE_BAL" -lt "$RAW" ]; then
+  echo "❌ Whale $WHALE holds only $WHALE_BAL (raw). Set USDC_WHALE to another holder." >&2
+  exit 1
+fi
+
+# Gas money for the whale (may be a contract) and the demo identity.
+cast rpc anvil_setBalance "$WHALE" 0x56BC75E2D63100000 --rpc-url "$RPC" > /dev/null
+if [ "$(cast balance "$TO" --rpc-url "$RPC")" = "0" ]; then
+  cast rpc anvil_setBalance "$TO" 0x56BC75E2D63100000 --rpc-url "$RPC" > /dev/null
+fi
+
+cast rpc anvil_impersonateAccount "$WHALE" --rpc-url "$RPC" > /dev/null
+cast send "$USDC" "transfer(address,uint256)" "$TO" "$RAW" \
+  --from "$WHALE" --unlocked --rpc-url "$RPC" > /dev/null
+cast rpc anvil_stopImpersonatingAccount "$WHALE" --rpc-url "$RPC" > /dev/null
+
+BAL=$(cast call "$USDC" "balanceOf(address)(uint256)" "$TO" --rpc-url "$RPC" | cut -d' ' -f1)
+echo "✅ Sent $AMOUNT USDC to $TO. Balance now: $(cast format-units "$BAL" 6) USDC"
