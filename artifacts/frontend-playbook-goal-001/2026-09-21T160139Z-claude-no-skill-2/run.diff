diff --git a/packages/nextjs/scripts/verify-ipfs.sh b/packages/nextjs/scripts/verify-ipfs.sh
new file mode 100755
index 0000000..4fbce63
--- /dev/null
+++ b/packages/nextjs/scripts/verify-ipfs.sh
@@ -0,0 +1,47 @@
+#!/usr/bin/env bash
+# Checks that an uploaded CID serves byte-for-byte the local static build in packages/nextjs/out.
+# Uses a subdomain gateway (<cid>.ipfs.<gateway>), because the export uses root-absolute /_next/ asset paths.
+# Usage: yarn ipfs:verify <CID> [gateway=dweb.link]
+set -euo pipefail
+
+CID=${1:?usage: yarn ipfs:verify <CID> [gateway]}
+GATEWAY=${2:-dweb.link}
+OUT_DIR="$(cd "$(dirname "$0")/../out" && pwd)"
+# Path-style URL: the gateway redirects it to the subdomain form (and converts CIDv0 to CIDv1)
+SITE="https://$GATEWAY/ipfs/$CID"
+
+failures=0
+check() {
+  local label=$1 ok=$2
+  if [ "$ok" = "true" ]; then echo "  ✅ $label"; else echo "  ❌ $label"; failures=$((failures + 1)); fi
+}
+
+echo "Routes on $SITE"
+for route in / /debug/; do
+  status=$(curl -sL -o /dev/null -w '%{http_code} %{content_type}' "$SITE$route")
+  [[ "$status" == "200 text/html"* ]] && check "$route → $status" true || check "$route → $status" false
+done
+final_url=$(curl -sL -o /dev/null -w '%{url_effective}' "$SITE/")
+[[ "$final_url" == "https://"*".ipfs.$GATEWAY/" ]] && check "served from subdomain origin $final_url" true \
+  || check "not served from a subdomain origin ($final_url): /_next assets will 404" false
+
+echo "Files in $OUT_DIR vs gateway"
+total=0
+mismatched=0
+while IFS= read -r file; do
+  rel=${file#"$OUT_DIR"}
+  total=$((total + 1))
+  local_hash=$(shasum -a 256 "$file" | cut -d' ' -f1)
+  remote_hash=$({ curl -sfL --retry 3 "$SITE$rel" || true; } | shasum -a 256 | cut -d' ' -f1)
+  if [ "$local_hash" != "$remote_hash" ]; then
+    echo "  ❌ $rel"
+    mismatched=$((mismatched + 1))
+  fi
+done < <(find "$OUT_DIR" -type f)
+[ "$mismatched" = "0" ] && check "all $total files match" true || check "$mismatched/$total files differ" false
+
+if [ "$failures" -gt 0 ]; then
+  echo "❌ $failures check(s) failed"
+  exit 1
+fi
+echo "✅ $CID serves the local build"

