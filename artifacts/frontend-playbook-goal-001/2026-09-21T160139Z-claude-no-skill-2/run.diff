+++ b/packages/nextjs/app/_components/ForkUsdcFaucet.tsx
@@ -0,0 +1,80 @@
+"use client";
+
+import { useState } from "react";
+import { Address, createTestClient, http, parseAbi, parseEther, parseUnits, publicActions, walletActions } from "viem";
+import { hardhat } from "viem/chains";
+import { useAccount } from "wagmi";
+import { USDC_ADDRESS, USDC_DECIMALS } from "~~/contracts/externalContracts";
+import { useTargetNetwork } from "~~/hooks/scaffold-eth";
+import { getParsedError, notification } from "~~/utils/scaffold-eth";
+
+const FAUCET_AMOUNT = parseUnits("100", USDC_DECIMALS);
+// Throwaway address that USDC's masterMinter authorizes on the fork
+const FORK_MINTER = "0x000000000000000000000000000000000000f00d";
+const FIAT_TOKEN_ABI = parseAbi([
+  "function masterMinter() view returns (address)",
+  "function configureMinter(address minter, uint256 minterAllowedAmount) returns (bool)",
+  "function mint(address to, uint256 amount) returns (bool)",
+]);
+
+const forkClient = createTestClient({ chain: hardhat, mode: "anvil", transport: http() })
+  .extend(publicActions)
+  .extend(walletActions);
+
+// Same flow as `yarn fund`: impersonate `from` on the fork and send a USDC admin call from it.
+const sendAs = async (from: Address, functionName: "configureMinter" | "mint", args: readonly [Address, bigint]) => {
+  await forkClient.setBalance({ address: from, value: parseEther("1") });
+  await forkClient.impersonateAccount({ address: from });
+  try {
+    const hash = await forkClient.writeContract({
+      account: from,
+      address: USDC_ADDRESS,
+      abi: FIAT_TOKEN_ABI,
+      functionName,
+      args,
+    });
+    await forkClient.waitForTransactionReceipt({ hash });
+  } finally {
+    await forkClient.stopImpersonatingAccount({ address: from });
+  }
+};
+
+/**
+ * Mints real (forked) Base USDC to the connected wallet. Only rendered on the local fork.
+ */
+export const ForkUsdcFaucet = () => {
+  const [loading, setLoading] = useState(false);
+  const { address } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+
+  if (targetNetwork.id !== hardhat.id || !address) return null;
+
+  const mintTestUsdc = async () => {
+    setLoading(true);
+    try {
+      const masterMinter = await forkClient.readContract({
+        address: USDC_ADDRESS,
+        abi: FIAT_TOKEN_ABI,
+        functionName: "masterMinter",
+      });
+      await sendAs(masterMinter, "configureMinter", [FORK_MINTER, FAUCET_AMOUNT]);
+      await sendAs(FORK_MINTER, "mint", [address, FAUCET_AMOUNT]);
+      // Non-burner wallets (e.g. MetaMask) may have no gas on the fork
+      if ((await forkClient.getBalance({ address })) === 0n) {
+        await forkClient.setBalance({ address, value: parseEther("1") });
+      }
+      notification.success("Minted 100 test USDC on the local fork");
+    } catch (e) {
+      notification.error(`Is \`yarn fork\` running? ${getParsedError(e)}`);
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  return (
+    <button className="btn btn-secondary btn-sm" onClick={mintTestUsdc} disabled={loading}>
+      {loading && <span className="loading loading-spinner loading-xs" />}
+      Get 100 test USDC (local fork only)
+    </button>
+  );
+};
