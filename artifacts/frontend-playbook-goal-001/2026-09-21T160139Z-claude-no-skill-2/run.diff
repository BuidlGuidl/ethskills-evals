+++ b/packages/foundry/contracts/TipJar.sol
@@ -0,0 +1,66 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import { Ownable } from "@openzeppelin/contracts/access/Ownable.sol";
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { SafeERC20 } from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+
+/// @notice USDC tip jar. Tips go straight to the owner, so the contract never holds funds.
+/// Tips are also kept in storage so a static frontend can render the feed without an indexer.
+contract TipJar is Ownable {
+    using SafeERC20 for IERC20;
+
+    struct Tip {
+        address from;
+        uint96 amount;
+        uint64 timestamp;
+        string message;
+    }
+
+    uint256 public constant MAX_MESSAGE_LENGTH = 280;
+
+    IERC20 public immutable usdc;
+    Tip[] private tips;
+
+    event TipSent(address indexed from, uint256 amount, string message);
+
+    error ZeroAmount();
+    error AmountTooLarge();
+    error MessageTooLong();
+    error RenounceDisabled();
+
+    constructor(IERC20 _usdc, address _owner) Ownable(_owner) {
+        usdc = _usdc;
+    }
+
+    /// @notice Requires a prior `usdc.approve(tipJar, amount)`.
+    function tip(uint256 amount, string calldata message) external {
+        if (amount == 0) revert ZeroAmount();
+        if (amount > type(uint96).max) revert AmountTooLarge();
+        if (bytes(message).length > MAX_MESSAGE_LENGTH) revert MessageTooLong();
+
+        tips.push(Tip(msg.sender, uint96(amount), uint64(block.timestamp), message));
+        emit TipSent(msg.sender, amount, message);
+
+        usdc.safeTransferFrom(msg.sender, owner(), amount);
+    }
+
+    /// @dev USDC rejects transfers to address(0), so an ownerless jar could never accept tips again.
+    function renounceOwnership() public pure override {
+        revert RenounceDisabled();
+    }
+
+    function tipCount() external view returns (uint256) {
+        return tips.length;
+    }
+
+    /// @notice Newest tips first, at most `limit` of them.
+    function getLatestTips(uint256 limit) external view returns (Tip[] memory latest) {
+        uint256 total = tips.length;
+        if (limit > total) limit = total;
+        latest = new Tip[](limit);
+        for (uint256 i = 0; i < limit; i++) {
+            latest[i] = tips[total - 1 - i];
+        }
+    }
+}
