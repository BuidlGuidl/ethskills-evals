diff --git a/packages/foundry/scripts/fund-usdc.sh b/packages/foundry/scripts/fund-usdc.sh
new file mode 100755
index 0000000..94a6526
--- /dev/null
+++ b/packages/foundry/scripts/fund-usdc.sh
@@ -0,0 +1,41 @@
+#!/usr/bin/env bash
+# Mints real Base USDC to an address on the LOCAL Base fork (plus 1 ETH for gas if it has none).
+# Impersonates USDC's masterMinter to authorize a throwaway minter, exactly like Circle mints.
+# Refuses to run against anything but a chain-id 31337 node, so it can never touch real Base.
+# Usage: yarn fund <address> [usdcAmount=1000]
+set -euo pipefail
+
+TO=${1:?usage: yarn fund <address> [usdcAmount]}
+AMOUNT=${2:-1000}
+RPC=${RPC_URL:-http://127.0.0.1:8545}
+USDC=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
+MINTER=0x000000000000000000000000000000000000f00d
+ONE_ETH=0xDE0B6B3A7640000
+
+if [ "$(cast chain-id -r "$RPC")" != "31337" ]; then
+  echo "❌ $RPC is not the local fork (chain id 31337). Start it with: yarn fork" >&2
+  exit 1
+fi
+if [ "$(cast code $USDC -r "$RPC")" = "0x" ]; then
+  echo "❌ No USDC at $USDC. This is a plain chain, not a Base fork. Start it with: yarn fork" >&2
+  exit 1
+fi
+
+UNITS=$(cast parse-units "$AMOUNT" 6)
+MASTER_MINTER=$(cast call $USDC "masterMinter()(address)" -r "$RPC")
+
+for acct in "$MASTER_MINTER" "$MINTER"; do
+  cast rpc anvil_setBalance "$acct" $ONE_ETH -r "$RPC" > /dev/null
+  cast rpc anvil_impersonateAccount "$acct" -r "$RPC" > /dev/null
+done
+cast send $USDC "configureMinter(address,uint256)" $MINTER "$UNITS" --from "$MASTER_MINTER" --unlocked -r "$RPC" > /dev/null
+cast send $USDC "mint(address,uint256)" "$TO" "$UNITS" --from $MINTER --unlocked -r "$RPC" > /dev/null
+for acct in "$MASTER_MINTER" "$MINTER"; do
+  cast rpc anvil_stopImpersonatingAccount "$acct" -r "$RPC" > /dev/null
+done
+if [ "$(cast balance "$TO" -r "$RPC")" = "0" ]; then
+  cast rpc anvil_setBalance "$TO" $ONE_ETH -r "$RPC" > /dev/null
+fi
+
+BALANCE=$(cast call $USDC "balanceOf(address)(uint256)" "$TO" -r "$RPC" | cut -d' ' -f1)
+echo "✅ $TO now has $(cast format-units "$BALANCE" 6) USDC on the local fork"
diff --git a/packages/foundry/test/TipJar.t.sol b/packages/foundry/test/TipJar.t.sol
new file mode 100644
index 0000000..a75fdbc
--- /dev/null
+++ b/packages/foundry/test/TipJar.t.sol
@@ -0,0 +1,113 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import "forge-std/Test.sol";
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { Ownable } from "@openzeppelin/contracts/access/Ownable.sol";
+import { TipJar } from "../contracts/TipJar.sol";
+
+interface IFiatToken {
+    function masterMinter() external view returns (address);
+    function configureMinter(address minter, uint256 allowance) external returns (bool);
+    function mint(address to, uint256 amount) external returns (bool);
+}
+
+/// @dev Runs against a fork of Base mainnet (rpc alias `base` in foundry.toml).
+contract TipJarTest is Test {
+    IERC20 constant USDC = IERC20(0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913);
+    // Pinned so runs are deterministic and forge caches the fork state locally
+    uint256 constant FORK_BLOCK = 35_000_000;
+
+    TipJar tipJar;
+    address owner = makeAddr("owner");
+    address alice = makeAddr("alice");
+
+    function setUp() public {
+        vm.createSelectFork("base", FORK_BLOCK);
+        tipJar = new TipJar(USDC, owner);
+        _mintUsdc(alice, 100e6);
+    }
+
+    /// @dev USDC's balance slot is packed with blacklist state, so `deal` can't be used; mint like Circle does.
+    function _mintUsdc(address to, uint256 amount) internal {
+        IFiatToken fiat = IFiatToken(address(USDC));
+        vm.prank(fiat.masterMinter());
+        fiat.configureMinter(address(this), amount);
+        fiat.mint(to, amount);
+    }
+
+    function _tip(address from, uint256 amount, string memory message) internal {
+        vm.startPrank(from);
+        USDC.approve(address(tipJar), amount);
+        tipJar.tip(amount, message);
+        vm.stopPrank();
+    }
+
+    function testTipMovesUsdcToOwner() public {
+        vm.startPrank(alice);
+        USDC.approve(address(tipJar), 5e6);
+        vm.expectEmit(address(tipJar));
+        emit TipJar.TipSent(alice, 5e6, "gm");
+        tipJar.tip(5e6, "gm");
+        vm.stopPrank();
+
+        assertEq(USDC.balanceOf(alice), 95e6);
+        assertEq(USDC.balanceOf(owner), 5e6);
+        assertEq(USDC.balanceOf(address(tipJar)), 0);
+        assertEq(tipJar.tipCount(), 1);
+    }
+
+    function testLatestTipsNewestFirst() public {
+        _tip(alice, 1e6, "first");
+        vm.warp(block.timestamp + 60);
+        _tip(alice, 2e6, "second");
+
+        TipJar.Tip[] memory latest = tipJar.getLatestTips(10);
+        assertEq(latest.length, 2);
+        assertEq(latest[0].message, "second");
+        assertEq(latest[0].amount, 2e6);
+        assertEq(latest[0].from, alice);
+        assertEq(latest[1].message, "first");
+
+        assertEq(tipJar.getLatestTips(1).length, 1);
+    }
+
+    function testTipFollowsOwnershipTransfer() public {
+        address newOwner = makeAddr("newOwner");
+        vm.prank(owner);
+        tipJar.transferOwnership(newOwner);
+
+        _tip(alice, 3e6, "");
+        assertEq(USDC.balanceOf(newOwner), 3e6);
+    }
+
+    function testRevertsOnZeroAmount() public {
+        vm.prank(alice);
+        vm.expectRevert(TipJar.ZeroAmount.selector);
+        tipJar.tip(0, "");
+    }
+
+    function testRevertsOnLongMessage() public {
+        vm.prank(alice);
+        vm.expectRevert(TipJar.MessageTooLong.selector);
+        tipJar.tip(1e6, string(new bytes(281)));
+    }
+
+    function testRevertsWithoutAllowance() public {
+        vm.prank(alice);
+        vm.expectRevert();
+        tipJar.tip(1e6, "no approve");
+    }
+
+    function testCannotRenounceOwnership() public {
+        vm.prank(owner);
+        vm.expectRevert(TipJar.RenounceDisabled.selector);
+        tipJar.renounceOwnership();
+    }
+
+    function testOnlyOwnerTransfersOwnership() public {
+        vm.prank(alice);
+        vm.expectRevert(abi.encodeWithSelector(Ownable.OwnableUnauthorizedAccount.selector, alice));
+        tipJar.transferOwnership(alice);
+    }
+}
