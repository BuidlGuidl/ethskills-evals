@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: UNLICENSED
+pragma solidity ^0.8.20;
+
+import { ERC20 } from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+import { Test } from "forge-std/Test.sol";
+import { TipJar } from "../contracts/TipJar.sol";
+
+contract MockUSDC is ERC20 {
+    constructor() ERC20("USD Coin", "USDC") { }
+
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    function mint(address to, uint256 amount) external {
+        _mint(to, amount);
+    }
+}
+
+contract TipJarTest is Test {
+    MockUSDC internal usdc;
+    TipJar internal tipJar;
+
+    address internal recipient = makeAddr("recipient");
+    address internal tipper = makeAddr("tipper");
+
+    function setUp() public {
+        usdc = new MockUSDC();
+        tipJar = new TipJar(recipient, address(usdc));
+        usdc.mint(tipper, 100e6);
+    }
+
+    function testTipTransfersUsdcToRecipientAndRecordsFeed() public {
+        vm.startPrank(tipper);
+        usdc.approve(address(tipJar), 25e6);
+
+        vm.expectEmit(true, true, false, true, address(tipJar));
+        emit TipJar.TipReceived(tipper, recipient, 25e6, "great work", block.timestamp);
+        tipJar.tip(25e6, "great work");
+        vm.stopPrank();
+
+        assertEq(usdc.balanceOf(recipient), 25e6);
+        assertEq(usdc.balanceOf(tipper), 75e6);
+        assertEq(tipJar.totalTips(), 1);
+        assertEq(tipJar.totalAmount(), 25e6);
+        assertEq(tipJar.amountTippedBy(tipper), 25e6);
+
+        TipJar.Tip memory recordedTip = tipJar.getTip(0);
+        assertEq(recordedTip.tipper, tipper);
+        assertEq(recordedTip.amount, 25e6);
+        assertEq(recordedTip.message, "great work");
+        assertEq(recordedTip.timestamp, block.timestamp);
+    }
+
+    function testRevertsForZeroAmount() public {
+        vm.prank(tipper);
+        vm.expectRevert(TipJar.ZeroAmount.selector);
+        tipJar.tip(0, "nope");
+    }
+
+    function testRevertsForMessageOverLimit() public {
+        string memory longMessage =
+            "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
+
+        vm.startPrank(tipper);
+        usdc.approve(address(tipJar), 1e6);
+        vm.expectRevert(TipJar.MessageTooLong.selector);
+        tipJar.tip(1e6, longMessage);
+        vm.stopPrank();
+    }
+}
