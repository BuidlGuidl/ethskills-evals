diff --git a/packages/foundry/test/USDCTipJar.t.sol b/packages/foundry/test/USDCTipJar.t.sol
new file mode 100644
index 0000000..a2bbc88
--- /dev/null
+++ b/packages/foundry/test/USDCTipJar.t.sol
@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: UNLICENSED
+pragma solidity ^0.8.20;
+
+import { ERC20 } from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+import { Test } from "forge-std/Test.sol";
+import { USDCTipJar } from "../contracts/USDCTipJar.sol";
+
+contract MockUSDC is ERC20 {
+    constructor() ERC20("Mock USDC", "USDC") { }
+
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    function mint(address to, uint256 amount) external {
+        _mint(to, amount);
+    }
+}
+
+contract USDCTipJarTest is Test {
+    event TipSent(address indexed tipper, address indexed recipient, uint256 amount, string message);
+
+    MockUSDC public usdc;
+    USDCTipJar public tipJar;
+
+    address public tipper = address(0xA11CE);
+    address public recipient = address(0xB0B);
+
+    function setUp() public {
+        usdc = new MockUSDC();
+        tipJar = new USDCTipJar(usdc, recipient);
+        usdc.mint(tipper, 100e6);
+    }
+
+    function testConstructorStoresUSDCAndRecipient() public view {
+        assertEq(address(tipJar.usdc()), address(usdc));
+        assertEq(tipJar.recipient(), recipient);
+    }
+
+    function testSendTipTransfersUSDCAndEmitsFeedEvent() public {
+        uint256 tipAmount = 25e6;
+
+        vm.startPrank(tipper);
+        usdc.approve(address(tipJar), tipAmount);
+
+        vm.expectEmit(true, true, false, true, address(tipJar));
+        emit TipSent(tipper, recipient, tipAmount, "coffee for the builders");
+        tipJar.sendTip(tipAmount, "coffee for the builders");
+        vm.stopPrank();
+
+        assertEq(usdc.balanceOf(tipper), 75e6);
+        assertEq(usdc.balanceOf(recipient), tipAmount);
+        assertEq(usdc.balanceOf(address(tipJar)), 0);
+        assertEq(tipJar.totalTips(), tipAmount);
+        assertEq(tipJar.tipperTotals(tipper), tipAmount);
+    }
+
+    function testCannotSendZeroAmount() public {
+        vm.expectRevert(USDCTipJar.ZeroAmount.selector);
+        tipJar.sendTip(0, "nope");
+    }
+
+    function testCannotSendMessageOver280Bytes() public {
+        string memory longMessage =
+            "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
+
+        vm.expectRevert(abi.encodeWithSelector(USDCTipJar.MessageTooLong.selector, 281));
+        tipJar.sendTip(1, longMessage);
+    }
+
+    function testCannotTipWithoutAllowance() public {
+        vm.prank(tipper);
+        vm.expectRevert();
+        tipJar.sendTip(1e6, "forgot approval");
+    }
+}
