index 0000000..43ec262
--- /dev/null
+++ b/packages/foundry/contracts/USDCTipJar.sol
@@ -0,0 +1,44 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { SafeERC20 } from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+
+contract USDCTipJar {
+    using SafeERC20 for IERC20;
+
+    error InvalidUSDC();
+    error InvalidRecipient();
+    error ZeroAmount();
+    error MessageTooLong(uint256 length);
+
+    IERC20 public immutable usdc;
+    address public immutable recipient;
+    uint256 public totalTips;
+
+    mapping(address tipper => uint256 totalAmount) public tipperTotals;
+
+    event TipSent(address indexed tipper, address indexed recipient, uint256 amount, string message);
+
+    constructor(IERC20 _usdc, address _recipient) {
+        if (address(_usdc) == address(0)) revert InvalidUSDC();
+        if (_recipient == address(0)) revert InvalidRecipient();
+
+        usdc = _usdc;
+        recipient = _recipient;
+    }
+
+    function sendTip(uint256 amount, string calldata message) external {
+        if (amount == 0) revert ZeroAmount();
+
+        uint256 messageLength = bytes(message).length;
+        if (messageLength > 280) revert MessageTooLong(messageLength);
+
+        totalTips += amount;
+        tipperTotals[msg.sender] += amount;
+
+        usdc.safeTransferFrom(msg.sender, recipient, amount);
+
+        emit TipSent(msg.sender, recipient, amount, message);
+    }
+}
