@@ -0,0 +1,84 @@
+// SPDX-License-Identifier: UNLICENSED
+pragma solidity ^0.8.20;
+
+import { ERC20 } from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+import { Test } from "forge-std/Test.sol";
+import { BaseUsdcTipJar } from "../contracts/BaseUsdcTipJar.sol";
+
+contract MockUSDC is ERC20 {
+    constructor() ERC20("USD Coin", "USDC") { }
+
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    function mint(address to, uint256 amount) external {
+        _mint(to, amount);
+    }
+}
+
+contract BaseUsdcTipJarTest is Test {
+    MockUSDC public usdc;
+    BaseUsdcTipJar public tipJar;
+
+    address public tipper = makeAddr("tipper");
+    address public recipient = makeAddr("recipient");
+
+    event TipSent(
+        address indexed tipper, address indexed recipient, uint256 amount, string message, uint256 newTotalTipped
+    );
+
+    function setUp() public {
+        usdc = new MockUSDC();
+        tipJar = new BaseUsdcTipJar(address(usdc), recipient);
+        usdc.mint(tipper, 100e6);
+    }
+
+    function testConstructorStoresBaseUsdcAndRecipient() public view {
+        assertEq(address(tipJar.usdc()), address(usdc));
+        assertEq(tipJar.recipient(), recipient);
+    }
+
+    function testRejectsZeroAddresses() public {
+        vm.expectRevert(BaseUsdcTipJar.ZeroAddress.selector);
+        new BaseUsdcTipJar(address(0), recipient);
+
+        vm.expectRevert(BaseUsdcTipJar.ZeroAddress.selector);
+        new BaseUsdcTipJar(address(usdc), address(0));
+    }
+
+    function testTipTransfersUsdcAndEmitsFeedEvent() public {
+        uint256 amount = 12_500_000;
+
+        vm.startPrank(tipper);
+        usdc.approve(address(tipJar), amount);
+
+        vm.expectEmit(true, true, false, true);
+        emit TipSent(tipper, recipient, amount, "thank you", amount);
+
+        tipJar.tip(amount, "thank you");
+        vm.stopPrank();
+
+        assertEq(usdc.balanceOf(recipient), amount);
+        assertEq(usdc.balanceOf(tipper), 87_500_000);
+        assertEq(tipJar.totalTipped(), amount);
+        assertEq(tipJar.tippedBy(tipper), amount);
+    }
+
+    function testRejectsZeroTip() public {
+        vm.prank(tipper);
+        vm.expectRevert(BaseUsdcTipJar.ZeroAmount.selector);
+        tipJar.tip(0, "zero");
+    }
+
+    function testRejectsLongMessage() public {
+        string memory longMessage =
+            "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
+
+        vm.startPrank(tipper);
+        usdc.approve(address(tipJar), 1e6);
+        vm.expectRevert(BaseUsdcTipJar.MessageTooLong.selector);
+        tipJar.tip(1e6, longMessage);
+        vm.stopPrank();
+    }
+}
