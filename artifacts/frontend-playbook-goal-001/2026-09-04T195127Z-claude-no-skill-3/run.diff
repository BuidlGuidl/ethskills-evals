diff --git a/packages/foundry/scripts-js/fundTestIdentity.js b/packages/foundry/scripts-js/fundTestIdentity.js
new file mode 100644
index 0000000..3f19a28
--- /dev/null
+++ b/packages/foundry/scripts-js/fundTestIdentity.js
@@ -0,0 +1,121 @@
+/**
+ * Provisions a test identity on the local Base fork: real Base USDC state, balances written
+ * straight into the fork with anvil's `anvil_dealERC20` cheat RPC. Nothing here touches Base itself,
+ * and it refuses to run against any chain that is not a local anvil node.
+ *
+ * Usage: yarn fund <address> [usdcAmount]
+ */
+const RPC_URL = process.env.RPC_URL || "http://127.0.0.1:8545";
+const LOCAL_CHAIN_ID = 31337;
+const USDC = "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913";
+const USDC_DECIMALS = 6;
+const MIN_GAS_ETH = 10n ** 17n; // 0.1 ETH
+const TOP_UP_ETH = 10n ** 18n; // 1 ETH
+
+let rpcId = 0;
+
+async function rpc(method, params = []) {
+  let response;
+  try {
+    response = await fetch(RPC_URL, {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ jsonrpc: "2.0", id: ++rpcId, method, params }),
+    });
+  } catch (cause) {
+    throw new Error(
+      `Cannot reach ${RPC_URL}. Is the Base fork running? Start it with \`yarn fork\`.`,
+      { cause }
+    );
+  }
+
+  const body = await response.json();
+  if (body.error) throw new Error(`${method} failed: ${body.error.message}`);
+  return body.result;
+}
+
+function parseUsdc(input) {
+  if (!/^\d+(\.\d{1,6})?$/.test(input)) {
+    throw new Error(
+      `Invalid amount "${input}". Use a plain number with at most ${USDC_DECIMALS} decimals.`
+    );
+  }
+  const [whole, fraction = ""] = input.split(".");
+  return BigInt(whole + fraction.padEnd(USDC_DECIMALS, "0"));
+}
+
+function formatUsdc(value) {
+  const asString = value.toString().padStart(USDC_DECIMALS + 1, "0");
+  const whole = asString.slice(0, -USDC_DECIMALS);
+  const fraction = asString.slice(-USDC_DECIMALS).replace(/0+$/, "");
+  return fraction ? `${whole}.${fraction}` : whole;
+}
+
+async function main() {
+  const [address, amountInput = "1000"] = process.argv.slice(2);
+
+  if (!address || !/^0x[0-9a-fA-F]{40}$/.test(address)) {
+    console.error(`
+Usage: yarn fund <address> [usdcAmount]
+
+Gives a test identity USDC (and enough ETH for gas) on the local Base fork.
+
+  yarn fund 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266        # 1000 USDC
+  yarn fund 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266 25.5   # 25.5 USDC
+`);
+    process.exit(1);
+  }
+
+  const amount = parseUsdc(amountInput);
+
+  const chainId = Number(await rpc("eth_chainId"));
+  if (chainId !== LOCAL_CHAIN_ID) {
+    throw new Error(
+      `Refusing to run: ${RPC_URL} reports chain id ${chainId}, not the local fork's ${LOCAL_CHAIN_ID}. ` +
+        `This script only ever funds a local anvil node.`
+    );
+  }
+
+  if ((await rpc("eth_getCode", [USDC, "latest"])) === "0x") {
+    throw new Error(
+      `No USDC at ${USDC} on this node. It is a plain anvil chain, not a Base fork — restart it with \`yarn fork\`.`
+    );
+  }
+
+  await rpc("anvil_dealERC20", [
+    address,
+    USDC,
+    `0x${amount.toString(16)}`,
+  ]).catch((error) => {
+    throw new Error(
+      `${error.message}\nanvil_dealERC20 needs Foundry >= 1.0. Run \`foundryup\` to update.`
+    );
+  });
+
+  const gasBalance = BigInt(await rpc("eth_getBalance", [address, "latest"]));
+  if (gasBalance < MIN_GAS_ETH) {
+    await rpc("anvil_setBalance", [address, `0x${TOP_UP_ETH.toString(16)}`]);
+  }
+
+  const balanceCall = await rpc("eth_call", [
+    {
+      to: USDC,
+      data: `0x70a08231${address.slice(2).toLowerCase().padStart(64, "0")}`,
+    },
+    "latest",
+  ]);
+
+  console.log(
+    `💵 ${address} now holds ${formatUsdc(
+      BigInt(balanceCall)
+    )} USDC on the local Base fork`
+  );
+  if (gasBalance < MIN_GAS_ETH) {
+    console.log(`⛽ Topped up to 1 ETH for gas`);
+  }
+}
+
+main().catch((error) => {
+  console.error(`❌ ${error.message}`);
+  process.exitCode = 1;
+});
diff --git a/packages/foundry/scripts-js/verify.js b/packages/foundry/scripts-js/verify.js
new file mode 100644
index 0000000..974955e
--- /dev/null
+++ b/packages/foundry/scripts-js/verify.js
@@ -0,0 +1,38 @@
+/**
+ * Verifies the contracts from the latest broadcast on a block explorer.
+ *
+ * Usage: yarn verify [--network <network>]
+ *
+ * `<network>` is an alias from the `[rpc_endpoints]` table in foundry.toml (default: localhost), and
+ * needs a matching `[etherscan]` entry plus ETHERSCAN_API_KEY in .env.
+ */
+import { spawnSync } from "child_process";
+
+const args = process.argv.slice(2);
+
+if (args.includes("--help") || args.includes("-h")) {
+  console.log(`
+Usage: yarn verify [options]
+Options:
+  --network <network>   Network to verify on, as named in foundry.toml (default: localhost)
+  --help, -h            Show this message
+Example:
+  yarn verify --network base
+`);
+  process.exit(0);
+}
+
+const networkFlag = args.indexOf("--network");
+if (networkFlag !== -1 && !args[networkFlag + 1]) {
+  console.error(
+    "❌ --network needs a value, e.g. `yarn verify --network base`"
+  );
+  process.exit(1);
+}
+const network = networkFlag !== -1 ? args[networkFlag + 1] : "localhost";
+
+const result = spawnSync("make", ["verify", `RPC_URL=${network}`], {
+  stdio: "inherit",
+  shell: false,
+});
+process.exitCode = result.status ?? 1;
diff --git a/packages/foundry/test/UsdcTipJar.t.sol b/packages/foundry/test/UsdcTipJar.t.sol
new file mode 100644
index 0000000..316a7f0
--- /dev/null
+++ b/packages/foundry/test/UsdcTipJar.t.sol
@@ -0,0 +1,161 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import { Test } from "forge-std/Test.sol";
+import { Ownable } from "@openzeppelin/contracts/access/Ownable.sol";
+import { Ownable2Step } from "@openzeppelin/contracts/access/Ownable2Step.sol";
+import { ERC20 } from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { UsdcTipJar } from "../contracts/UsdcTipJar.sol";
+
+/// @dev Stand-in for USDC: same 6 decimals, freely mintable.
+contract MockUSDC is ERC20 {
+    constructor() ERC20("USD Coin", "USDC") { }
+
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    function mint(address to, uint256 amount) external {
+        _mint(to, amount);
+    }
+}
+
+contract UsdcTipJarTest is Test {
+    MockUSDC internal usdc;
+    UsdcTipJar internal jar;
+
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+    address internal bob = makeAddr("bob");
+
+    function setUp() public {
+        usdc = new MockUSDC();
+        jar = new UsdcTipJar(IERC20(address(usdc)), owner);
+
+        usdc.mint(alice, 1000e6);
+        usdc.mint(bob, 1000e6);
+        vm.prank(alice);
+        usdc.approve(address(jar), type(uint256).max);
+        vm.prank(bob);
+        usdc.approve(address(jar), type(uint256).max);
+    }
+
+    function test_TipMovesUsdcAndRecordsFeedEntry() public {
+        vm.prank(alice);
+        jar.tip(25e6, "thanks for the tool");
+
+        assertEq(usdc.balanceOf(address(jar)), 25e6);
+        assertEq(usdc.balanceOf(alice), 975e6);
+        assertEq(jar.totalTipped(), 25e6);
+        assertEq(jar.tipCount(), 1);
+
+        UsdcTipJar.Tip[] memory page = jar.latestTips(0, 10);
+        assertEq(page.length, 1);
+        assertEq(page[0].sender, alice);
+        assertEq(page[0].amount, 25e6);
+        assertEq(page[0].message, "thanks for the tool");
+        assertEq(page[0].timestamp, uint64(block.timestamp));
+    }
+
+    function test_LatestTipsIsNewestFirstAndPaginates() public {
+        vm.prank(alice);
+        jar.tip(1e6, "first");
+        vm.prank(bob);
+        jar.tip(2e6, "second");
+        vm.prank(alice);
+        jar.tip(3e6, "third");
+
+        UsdcTipJar.Tip[] memory firstPage = jar.latestTips(0, 2);
+        assertEq(firstPage.length, 2);
+        assertEq(firstPage[0].message, "third");
+        assertEq(firstPage[1].message, "second");
+
+        UsdcTipJar.Tip[] memory secondPage = jar.latestTips(2, 2);
+        assertEq(secondPage.length, 1, "page is truncated at the oldest tip");
+        assertEq(secondPage[0].message, "first");
+
+        assertEq(jar.latestTips(3, 2).length, 0, "offset past the end is empty, not a revert");
+    }
+
+    function test_RevertWhen_TipBelowMinimum() public {
+        uint256 minimum = jar.MIN_TIP();
+
+        vm.prank(alice);
+        vm.expectRevert(abi.encodeWithSelector(UsdcTipJar.TipTooSmall.selector, minimum - 1, minimum));
+        jar.tip(minimum - 1, "dust");
+    }
+
+    function test_RevertWhen_MessageTooLong() public {
+        uint256 maximum = jar.MAX_MESSAGE_BYTES();
+        string memory tooLong = new string(maximum + 1);
+
+        vm.prank(alice);
+        vm.expectRevert(abi.encodeWithSelector(UsdcTipJar.MessageTooLong.selector, maximum + 1, maximum));
+        jar.tip(1e6, tooLong);
+    }
+
+    function test_RevertWhen_TipperHasNotApproved() public {
+        address carol = makeAddr("carol");
+        usdc.mint(carol, 10e6);
+
+        vm.prank(carol);
+        vm.expectRevert();
+        jar.tip(1e6, "no allowance");
+    }
+
+    function test_WithdrawSendsWholeBalanceToOwner() public {
+        vm.prank(alice);
+        jar.tip(10e6, "one");
+        vm.prank(bob);
+        jar.tip(5e6, "two");
+
+        vm.prank(owner);
+        jar.withdraw();
+
+        assertEq(usdc.balanceOf(owner), 15e6);
+        assertEq(usdc.balanceOf(address(jar)), 0);
+        assertEq(jar.totalTipped(), 15e6, "totalTipped is lifetime, not the current balance");
+        assertEq(jar.tipCount(), 2, "withdrawing does not clear the feed");
+    }
+
+    function test_RevertWhen_NonOwnerWithdraws() public {
+        vm.prank(alice);
+        jar.tip(10e6, "one");
+
+        vm.prank(alice);
+        vm.expectRevert(abi.encodeWithSelector(Ownable.OwnableUnauthorizedAccount.selector, alice));
+        jar.withdraw();
+    }
+
+    function test_RevertWhen_RenouncingOwnership() public {
+        vm.prank(owner);
+        vm.expectRevert(UsdcTipJar.OwnershipCannotBeRenounced.selector);
+        jar.renounceOwnership();
+    }
+
+    function test_OwnershipTransferTakesTwoSteps() public {
+        address newOwner = makeAddr("newOwner");
+
+        vm.prank(owner);
+        jar.transferOwnership(newOwner);
+        assertEq(jar.owner(), owner, "transfer alone does not move ownership");
+        assertEq(jar.pendingOwner(), newOwner);
+
+        vm.prank(newOwner);
+        jar.acceptOwnership();
+        assertEq(jar.owner(), newOwner);
+
+        vm.prank(alice);
+        jar.tip(1e6, "for the new owner");
+        vm.prank(newOwner);
+        jar.withdraw();
+        assertEq(usdc.balanceOf(newOwner), 1e6);
+    }
+
+    function test_RevertWhen_WithdrawingAnEmptyJar() public {
+        vm.prank(owner);
+        vm.expectRevert(UsdcTipJar.NothingToWithdraw.selector);
+        jar.withdraw();
+    }
+}
diff --git a/packages/foundry/test/UsdcTipJarFork.t.sol b/packages/foundry/test/UsdcTipJarFork.t.sol
