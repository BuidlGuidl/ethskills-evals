@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import "./DeployHelpers.s.sol";
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { IERC20Metadata } from "@openzeppelin/contracts/token/ERC20/extensions/IERC20Metadata.sol";
+import { UsdcTipJar } from "../contracts/UsdcTipJar.sol";
+
+/**
+ * @notice Deploy script for UsdcTipJar
+ * @dev The jar is pinned to Circle's native USDC on Base. A local Base fork (`yarn fork`) serves the
+ *      very same address out of real Base state, so the same constant works locally and in production.
+ *
+ * Example:
+ * yarn deploy                  # local Base fork
+ * yarn deploy --network base   # Base mainnet (requires keystore)
+ *
+ * Deploy via `Deploy.s.sol` (the default) rather than `--file`: `yarn verify` reads the broadcast written
+ * by `Deploy.s.sol` and cannot find a run recorded under any other script name.
+ */
+contract DeployUsdcTipJar is ScaffoldETHDeploy {
+    /// @dev Circle's native USDC on Base (8453).
+    address public constant BASE_USDC = 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913;
+
+    function run() external ScaffoldEthDeployerRunner {
+        // 8453 is Base; 31337 is the local fork of it. Anywhere else, `BASE_USDC` is either empty or,
+        // worse, some unrelated contract — and the jar's token is immutable once deployed.
+        require(
+            block.chainid == 8453 || block.chainid == 31337,
+            "UsdcTipJar only deploys to Base (8453) or a local fork of it (31337)."
+        );
+        require(
+            BASE_USDC.code.length > 0,
+            "No USDC at the Base USDC address on this chain. Locally, the node must be a Base fork: `yarn fork`."
+        );
+        require(IERC20Metadata(BASE_USDC).decimals() == 6, "The token at the Base USDC address is not USDC.");
+
+        UsdcTipJar tipJar = new UsdcTipJar(IERC20(BASE_USDC), deployer);
+        console.log("UsdcTipJar deployed at", address(tipJar));
+        console.log("  owner:", deployer);
+    }
+}
