--- /dev/null
+++ b/packages/foundry/test/UsdcTipJarFork.t.sol
@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import { Test } from "forge-std/Test.sol";
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { UsdcTipJar } from "../contracts/UsdcTipJar.sol";
+
+/**
+ * @notice Exercises the jar against the real USDC contract on Base.
+ * @dev Needs network access to the `base` RPC endpoint in foundry.toml. The whole suite skips itself
+ *      when that endpoint is unreachable, so `yarn test` still works offline.
+ */
+contract UsdcTipJarForkTest is Test {
+    IERC20 internal constant USDC = IERC20(0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913);
+
+    UsdcTipJar internal jar;
+    bool internal forked;
+
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+
+    function setUp() public {
+        try vm.createSelectFork("base") {
+            forked = true;
+        } catch {
+            return;
+        }
+
+        jar = new UsdcTipJar(USDC, owner);
+
+        // Real Base USDC state, fake balance: `deal` writes the balance slot, no live funds involved.
+        deal(address(USDC), alice, 500e6);
+        vm.prank(alice);
+        USDC.approve(address(jar), type(uint256).max);
+    }
+
+    modifier onlyForked() {
+        vm.skip(!forked, "base RPC unreachable");
+        _;
+    }
+
+    function test_TipAndWithdrawAgainstRealUsdc() public onlyForked {
+        vm.prank(alice);
+        jar.tip(42e6, "gm from the fork");
+
+        assertEq(USDC.balanceOf(address(jar)), 42e6);
+        assertEq(USDC.balanceOf(alice), 458e6);
+
+        UsdcTipJar.Tip[] memory page = jar.latestTips(0, 1);
+        assertEq(page[0].sender, alice);
+        assertEq(page[0].amount, 42e6);
+        assertEq(page[0].message, "gm from the fork");
+
+        vm.prank(owner);
+        jar.withdraw();
+
+        assertEq(USDC.balanceOf(owner), 42e6);
+        assertEq(USDC.balanceOf(address(jar)), 0);
+    }
+}
