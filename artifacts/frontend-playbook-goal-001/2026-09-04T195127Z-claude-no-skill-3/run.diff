+// `ConfiguredChainId` is a union when the build can target more than one chain (see scaffold.config.ts).
+// Indexing straight into it would leave only the contract names *every* target has in common, so take
+// the union of names instead: a contract missing on the selected chain still type-checks and surfaces at
+// runtime as `useDeployedContractInfo` returning no data. Each name then maps to the *union* of its
+// per-chain declarations — intersecting them instead would reduce `address` to `never` as soon as the
+// same contract is deployed to two chains at different addresses.
+type Contracts = {
+  [TName in keyof UnionToIntersection<ContractsPerChain>]: ContractForName<ContractsPerChain, TName>;
+};
 
 export type ContractName = keyof Contracts;
 
