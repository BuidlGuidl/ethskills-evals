@@ -0,0 +1,75 @@
+"use client";
+
+import { Address } from "@scaffold-ui/components";
+import { useAccount } from "wagmi";
+import {
+  useDeployedContractInfo,
+  useScaffoldReadContract,
+  useScaffoldWriteContract,
+  useTargetNetwork,
+} from "~~/hooks/scaffold-eth";
+import { formatUsdc } from "~~/utils/usdc";
+
+export const JarStats = () => {
+  const { address: connectedAddress } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+  const { data: tipJar } = useDeployedContractInfo({ contractName: "UsdcTipJar" });
+
+  const { data: owner } = useScaffoldReadContract({ contractName: "UsdcTipJar", functionName: "owner" });
+  const { data: totalTipped } = useScaffoldReadContract({ contractName: "UsdcTipJar", functionName: "totalTipped" });
+  const { data: tipCount } = useScaffoldReadContract({ contractName: "UsdcTipJar", functionName: "tipCount" });
+  const { data: jarBalance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "balanceOf",
+    args: [tipJar?.address],
+  });
+
+  const { writeContractAsync: writeTipJar, isMining } = useScaffoldWriteContract({ contractName: "UsdcTipJar" });
+
+  const isOwner = Boolean(connectedAddress && owner && connectedAddress.toLowerCase() === owner.toLowerCase());
+  const hasBalance = jarBalance !== undefined && jarBalance > 0n;
+
+  const handleWithdraw = async () => {
+    try {
+      await writeTipJar({ functionName: "withdraw" });
+    } catch (error) {
+      console.error("Withdraw failed", error);
+    }
+  };
+
+  return (
+    <div className="card bg-base-100 shadow-xl w-full">
+      <div className="card-body gap-4">
+        <div className="stats stats-vertical sm:stats-horizontal bg-base-200">
+          <div className="stat">
+            <div className="stat-title">In the jar</div>
+            <div className="stat-value text-2xl">{jarBalance !== undefined ? formatUsdc(jarBalance) : "—"}</div>
+            <div className="stat-desc">USDC</div>
+          </div>
+          <div className="stat">
+            <div className="stat-title">Tipped all time</div>
+            <div className="stat-value text-2xl">{totalTipped !== undefined ? formatUsdc(totalTipped) : "—"}</div>
+            <div className="stat-desc">USDC</div>
+          </div>
+          <div className="stat">
+            <div className="stat-title">Tips</div>
+            <div className="stat-value text-2xl">{tipCount !== undefined ? tipCount.toString() : "—"}</div>
+            <div className="stat-desc">and counting</div>
+          </div>
+        </div>
+
+        <div className="flex items-center justify-between gap-3 flex-wrap">
+          <div className="flex items-center gap-2 text-sm">
+            <span className="opacity-60">Jar owner</span>
+            {owner ? <Address address={owner} size="sm" chain={targetNetwork} /> : <span>—</span>}
+          </div>
+          {isOwner && (
+            <button className="btn btn-sm btn-secondary" disabled={!hasBalance || isMining} onClick={handleWithdraw}>
+              {isMining ? <span className="loading loading-spinner loading-xs" /> : "Withdraw to owner"}
+            </button>
+          )}
+        </div>
+      </div>
+    </div>
+  );
+};
diff --git a/packages/nextjs/app/_components/TipFeed.tsx b/packages/nextjs/app/_components/TipFeed.tsx
new file mode 100644
index 0000000..60e6c5c
--- /dev/null
+++ b/packages/nextjs/app/_components/TipFeed.tsx
@@ -0,0 +1,90 @@
+"use client";
+
+import { useEffect, useState } from "react";
+import { Address } from "@scaffold-ui/components";
+import { keepPreviousData } from "@tanstack/react-query";
+import { useScaffoldReadContract, useTargetNetwork } from "~~/hooks/scaffold-eth";
+import { formatUsdc } from "~~/utils/usdc";
+
+const PAGE_SIZE = 10;
+/** Keeps a single `latestTips` call — and the response an RPC has to encode — bounded. */
+const MAX_VISIBLE = 200;
+
+const formatWhen = (timestamp: bigint) =>
+  new Date(Number(timestamp) * 1000).toLocaleString(undefined, {
+    dateStyle: "medium",
+    timeStyle: "short",
+  });
+
+export const TipFeed = () => {
+  const [limit, setLimit] = useState(PAGE_SIZE);
+  const { targetNetwork } = useTargetNetwork();
+
+  // Poll the cheap counter every block; re-read the feed itself only when it actually changes. Watching
+  // `latestTips` directly would re-download every message on every block, for every open tab.
+  const { data: tipCount } = useScaffoldReadContract({
+    contractName: "UsdcTipJar",
+    functionName: "tipCount",
+  });
+  const {
+    data: tips,
+    isLoading,
+    refetch,
+  } = useScaffoldReadContract({
+    contractName: "UsdcTipJar",
+    functionName: "latestTips",
+    args: [0n, BigInt(limit)],
+    watch: false,
+    // Keep the current page on screen while a longer one loads, instead of flashing the spinner.
+    query: { placeholderData: keepPreviousData },
+  });
+
+  useEffect(() => {
+    if (tipCount !== undefined) void refetch();
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [tipCount]);
+
+  const total = tipCount !== undefined ? Number(tipCount) : (tips?.length ?? 0);
+  const hasMore = tipCount !== undefined && tipCount > BigInt(limit) && limit < MAX_VISIBLE;
+
+  return (
+    <div className="card bg-base-100 shadow-xl w-full">
+      <div className="card-body gap-4">
+        <h2 className="card-title">
+          Tip feed
+          {tipCount !== undefined && <span className="badge badge-neutral">{tipCount.toString()}</span>}
+        </h2>
+
+        {isLoading && !tips ? (
+          <span className="loading loading-spinner loading-md self-center" />
+        ) : !tips?.length ? (
+          <p className="opacity-60 m-0">No tips yet. Be the first.</p>
+        ) : (
+          <ul className="list-none p-0 m-0 flex flex-col gap-3">
+            {tips.map((tip, index) => (
+              // The feed is newest-first, so entry `index` is tip number `total - 1 - index`. That is a
+              // stable identity across renders; the position in the list is not.
+              <li key={total - 1 - index} className="border border-base-300 rounded-box p-4 flex flex-col gap-2">
+                <div className="flex items-center justify-between gap-3 flex-wrap">
+                  <Address address={tip.sender} size="sm" chain={targetNetwork} />
+                  <span className="font-bold whitespace-nowrap">{formatUsdc(tip.amount)} USDC</span>
+                </div>
+                {tip.message && <p className="m-0 break-words">{tip.message}</p>}
+                <span className="text-xs opacity-60">{formatWhen(tip.timestamp)}</span>
+              </li>
+            ))}
+          </ul>
+        )}
+
+        {hasMore && (
+          <button
+            className="btn btn-sm btn-ghost self-center"
+            onClick={() => setLimit(current => Math.min(current + PAGE_SIZE, MAX_VISIBLE))}
+          >
+            Show older tips
+          </button>
+        )}
+      </div>
+    </div>
+  );
+};
diff --git a/packages/nextjs/app/_components/TipForm.tsx b/packages/nextjs/app/_components/TipForm.tsx
new file mode 100644
index 0000000..3d76d52
--- /dev/null
+++ b/packages/nextjs/app/_components/TipForm.tsx
@@ -0,0 +1,169 @@
+"use client";
+
+import { useState } from "react";
+import { BaseInput } from "@scaffold-ui/components";
+import { useAccount } from "wagmi";
+import { useDeployedContractInfo, useScaffoldReadContract, useScaffoldWriteContract } from "~~/hooks/scaffold-eth";
+import { USDC_DECIMALS, formatUsdc, isValidUsdcAmount, parseUsdc } from "~~/utils/usdc";
+
+const PRESETS = ["1", "5", "25"];
+
+export const TipForm = () => {
+  const [amount, setAmount] = useState("");
+  const [message, setMessage] = useState("");
+
+  const { address: connectedAddress } = useAccount();
+  const { data: tipJar } = useDeployedContractInfo({ contractName: "UsdcTipJar" });
+
+  // Limits live in the contract; read them once rather than duplicating the numbers here.
+  const { data: minTip } = useScaffoldReadContract({
+    contractName: "UsdcTipJar",
+    functionName: "MIN_TIP",
+    watch: false,
+  });
+  const { data: maxMessageBytes } = useScaffoldReadContract({
+    contractName: "UsdcTipJar",
+    functionName: "MAX_MESSAGE_BYTES",
+    watch: false,
+  });
+
+  const { data: usdcBalance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "balanceOf",
+    args: [connectedAddress],
+  });
+  const { data: allowance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "allowance",
+    args: [connectedAddress, tipJar?.address],
+  });
+
+  const { writeContractAsync: writeUsdc, isMining: isApproving } = useScaffoldWriteContract({ contractName: "USDC" });
+  const { writeContractAsync: writeTipJar, isMining: isTipping } = useScaffoldWriteContract({
+    contractName: "UsdcTipJar",
+  });
+
+  const amountIsValid = isValidUsdcAmount(amount);
+  const parsedAmount = amountIsValid ? parseUsdc(amount) : undefined;
+  const messageBytes = new TextEncoder().encode(message).length;
+
+  const amountError =
+    amount === "" || amountIsValid
+      ? parsedAmount !== undefined && minTip !== undefined && parsedAmount < minTip
+        ? `Minimum tip is ${formatUsdc(minTip)} USDC`
+        : parsedAmount !== undefined && usdcBalance !== undefined && parsedAmount > usdcBalance
+          ? `You only hold ${formatUsdc(usdcBalance)} USDC`
+          : undefined
+      : `Enter a number with at most ${USDC_DECIMALS} decimals`;
+
+  const messageError =
+    maxMessageBytes !== undefined && messageBytes > Number(maxMessageBytes)
+      ? `Message is ${messageBytes} bytes, limit is ${maxMessageBytes}`
+      : undefined;
+
+  // `allowance` is undefined while the read is in flight, and stays undefined if it fails (wrong chain,
+  // RPC down). Treat that as "not known yet" rather than "approved", or the tip button offers itself and
+  // then reverts with ERC20InsufficientAllowance.
+  const allowanceKnown = allowance !== undefined;
+  const needsApproval = parsedAmount !== undefined && allowanceKnown && allowance < parsedAmount;
+  const canSubmit =
+    Boolean(connectedAddress) &&
+    allowanceKnown &&
+    parsedAmount !== undefined &&
+    !amountError &&
+    !messageError &&
+    !isApproving;
+
+  const handleApprove = async () => {
+    if (!parsedAmount || !tipJar) return;
+    try {
+      await writeUsdc({ functionName: "approve", args: [tipJar.address, parsedAmount] });
+    } catch (error) {
+      console.error("USDC approval failed", error);
+    }
+  };
+
+  const handleTip = async () => {
+    if (!parsedAmount) return;
+    try {
+      await writeTipJar({ functionName: "tip", args: [parsedAmount, message] });
+      setAmount("");
+      setMessage("");
+    } catch (error) {
+      console.error("Tip failed", error);
+    }
+  };
+
+  return (
+    <div className="card bg-base-100 shadow-xl w-full">
+      <div className="card-body gap-4">
+        <h2 className="card-title">Leave a tip</h2>
+
+        <div className="flex flex-col gap-1">
+          <BaseInput
+            name="amount"
+            value={amount}
+            onChange={setAmount}
+            placeholder="0.00"
+            error={Boolean(amountError)}
+            suffix={<span className="self-center pr-4 font-medium">USDC</span>}
+          />
+          <div className="flex items-center justify-between gap-2 px-1">
+            <div className="flex gap-2">
+              {PRESETS.map(preset => (
+                <button key={preset} type="button" className="btn btn-xs btn-ghost" onClick={() => setAmount(preset)}>
+                  ${preset}
+                </button>
+              ))}
+            </div>
+            {usdcBalance !== undefined && (
+              <span className="text-xs opacity-60">Balance: {formatUsdc(usdcBalance)} USDC</span>
+            )}
+          </div>
+          {amountError && <span className="text-xs text-error px-1">{amountError}</span>}
+        </div>
+
+        <div className="flex flex-col gap-1">
+          <BaseInput
+            name="message"
+            value={message}
+            onChange={setMessage}
+            placeholder="Say something nice (optional)"
+            error={Boolean(messageError)}
+          />
+          {maxMessageBytes !== undefined && (
+            <span className={`text-xs px-1 ${messageError ? "text-error" : "opacity-60"}`}>
+              {messageBytes}/{maxMessageBytes.toString()} bytes
+            </span>
+          )}
+        </div>
+
+        <div className="card-actions">
+          {!connectedAddress ? (
+            <button className="btn btn-primary w-full" disabled>
+              Connect a wallet to tip
+            </button>
+          ) : !allowanceKnown ? (
+            <button className="btn btn-primary w-full" disabled>
+              <span className="loading loading-spinner loading-sm" />
+            </button>
+          ) : needsApproval ? (
+            <button className="btn btn-primary w-full" disabled={!canSubmit} onClick={handleApprove}>
+              {isApproving ? <span className="loading loading-spinner loading-sm" /> : `Approve ${amount} USDC`}
+            </button>
+          ) : (
+            <button className="btn btn-primary w-full" disabled={!canSubmit || isTipping} onClick={handleTip}>
+              {isTipping ? <span className="loading loading-spinner loading-sm" /> : "Send tip"}
+            </button>
+          )}
+        </div>
+
+        {needsApproval && (
+          <p className="text-xs opacity-60 m-0">
+            USDC needs a one-off approval before the jar can pull your tip. You will sign twice.
+          </p>
+        )}
+      </div>
+    </div>
+  );
+};
