+
+/**
+ * @notice A jar that collects USDC tips, each with a short public message.
+ * @dev The feed is kept in contract storage rather than only in events: the frontend ships as a
+ *      static bundle with no indexer behind it, so it has to render the feed from plain `eth_call`s.
+ *      Events are still emitted for anyone who does want to index them.
+ */
+contract UsdcTipJar is Ownable2Step {
+    using SafeERC20 for IERC20;
+    using SafeCast for uint256;
+
+    struct Tip {
+        address sender; // 20 bytes, shares a slot with `amount`
+        uint96 amount; // USDC has 6 decimals, so its total supply fits ~13 orders of magnitude below uint96
+        uint64 timestamp;
+        string message;
+    }
+
+    /// @notice The token this jar accepts. Fixed at deployment.
+    IERC20 public immutable usdc;
+
+    /// @notice Smallest accepted tip: 0.01 USDC.
+    uint256 public constant MIN_TIP = 10_000;
+
+    /// @notice Longest accepted message, in bytes. Caps the storage a single tip can buy.
+    uint256 public constant MAX_MESSAGE_BYTES = 140;
+
+    /// @notice Everything ever tipped, including amounts already withdrawn.
+    uint256 public totalTipped;
+
+    Tip[] private _tips;
+
+    error TipTooSmall(uint256 amount, uint256 minimum);
+    error MessageTooLong(uint256 length, uint256 maximum);
+    error NothingToWithdraw();
+    error OwnershipCannotBeRenounced();
+
+    event TipReceived(address indexed sender, uint256 indexed index, uint256 amount, string message);
+    event Withdrawn(address indexed to, uint256 amount);
+
+    constructor(IERC20 usdc_, address initialOwner) Ownable(initialOwner) {
+        usdc = usdc_;
+    }
+
+    /**
+     * @notice Send a tip. The caller must have approved this jar for at least `amount` USDC first.
+     * @param amount Tip size in USDC base units (6 decimals).
+     * @param message Public note shown in the feed. May be empty.
+     */
+    function tip(uint256 amount, string calldata message) external {
+        if (amount < MIN_TIP) revert TipTooSmall(amount, MIN_TIP);
+
+        uint256 messageLength = bytes(message).length;
+        if (messageLength > MAX_MESSAGE_BYTES) revert MessageTooLong(messageLength, MAX_MESSAGE_BYTES);
+
+        uint256 index = _tips.length;
+        _tips.push(
+            Tip({ sender: msg.sender, amount: amount.toUint96(), timestamp: uint64(block.timestamp), message: message })
+        );
+        totalTipped += amount;
+
+        emit TipReceived(msg.sender, index, amount, message);
+
+        // Interaction last. USDC is not fee-on-transfer, so the amount recorded above is the amount that lands here.
+        usdc.safeTransferFrom(msg.sender, address(this), amount);
+    }
+
+    /// @notice Send the jar's entire balance to the owner.
+    function withdraw() external onlyOwner {
+        address to = owner();
+        uint256 amount = usdc.balanceOf(address(this));
+        if (amount == 0) revert NothingToWithdraw();
+
+        usdc.safeTransfer(to, amount);
+        emit Withdrawn(to, amount);
+    }
+
+    /**
+     * @dev Ownership is two-step (see {Ownable2Step}) and cannot be renounced. `withdraw()` is the jar's
+     *      only exit and it pays `owner()`, so a renounced or mistyped owner would strand the balance and
+     *      every tip that arrives afterwards.
+     */
+    function renounceOwnership() public pure override {
+        revert OwnershipCannotBeRenounced();
+    }
+
+    function tipCount() external view returns (uint256) {
+        return _tips.length;
+    }
+
+    /**
+     * @notice Read a page of the feed, newest first: `offset` 0 is the most recent tip.
+     * @dev Returns fewer than `limit` entries when the page runs past the oldest tip, and an empty
+     *      page when `offset` is past the end.
+     */
+    function latestTips(uint256 offset, uint256 limit) external view returns (Tip[] memory page) {
+        uint256 total = _tips.length;
+        if (offset >= total) return new Tip[](0);
+
+        uint256 available = total - offset;
+        uint256 size = limit < available ? limit : available;
+
+        page = new Tip[](size);
+        for (uint256 i = 0; i < size; i++) {
+            page[i] = _tips[total - 1 - offset - i];
+        }
+    }
+}
