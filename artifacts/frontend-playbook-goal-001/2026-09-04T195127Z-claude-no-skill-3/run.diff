+import { formatUnits, parseUnits } from "viem";
+
+export const USDC_DECIMALS = 6;
+
+/** Rejects anything `parseUsdc` could not turn into base units: digits, one dot, at most 6 decimals. */
+export const isValidUsdcAmount = (value: string) => /^\d+(\.\d{1,6})?$/.test(value);
+
+export const parseUsdc = (value: string) => parseUnits(value, USDC_DECIMALS);
+
+/** "1234567890" -> "1,234.56789". Groups the whole part without going through a float. */
+export const formatUsdc = (amount: bigint) => {
+  const [whole, fraction] = formatUnits(amount, USDC_DECIMALS).split(".");
+  const grouped = BigInt(whole).toLocaleString("en-US");
+  return fraction ? `${grouped}.${fraction}` : grouped;
+};

