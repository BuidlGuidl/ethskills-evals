@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { SafeERC20 } from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+
+contract USDCTipJar {
+    using SafeERC20 for IERC20;
+
+    uint256 public constant MAX_MESSAGE_LENGTH = 160;
+
+    IERC20 public immutable usdc;
+    address public immutable tipRecipient;
+    uint256 public tipCount;
+    uint256 public totalTipped;
+
+    mapping(address tipper => uint256 amount) public totalTippedBy;
+
+    event Tip(address indexed tipper, address indexed recipient, uint256 amount, string message, uint256 timestamp);
+
+    error AmountIsZero();
+    error EmptyRecipient();
+    error EmptyToken();
+    error MessageTooLong();
+
+    constructor(IERC20 _usdc, address _tipRecipient) {
+        if (address(_usdc) == address(0)) {
+            revert EmptyToken();
+        }
+        if (_tipRecipient == address(0)) {
+            revert EmptyRecipient();
+        }
+
+        usdc = _usdc;
+        tipRecipient = _tipRecipient;
+    }
+
+    function tip(uint256 amount, string calldata message) external {
+        if (amount == 0) {
+            revert AmountIsZero();
+        }
+        if (bytes(message).length > MAX_MESSAGE_LENGTH) {
+            revert MessageTooLong();
+        }
+
+        tipCount += 1;
+        totalTipped += amount;
+        totalTippedBy[msg.sender] += amount;
+
+        usdc.safeTransferFrom(msg.sender, tipRecipient, amount);
+
+        emit Tip(msg.sender, tipRecipient, amount, message, block.timestamp);
+    }
+}
