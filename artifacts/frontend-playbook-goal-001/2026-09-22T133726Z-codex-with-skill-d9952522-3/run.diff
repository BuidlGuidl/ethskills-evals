@@ -0,0 +1,56 @@
+// SPDX-License-Identifier: UNLICENSED
+pragma solidity ^0.8.20;
+
+import "forge-std/Test.sol";
+import { ERC20Mock } from "@openzeppelin/contracts/mocks/token/ERC20Mock.sol";
+import { USDCTipJar } from "../contracts/USDCTipJar.sol";
+
+contract USDCTipJarTest is Test {
+    ERC20Mock internal usdc;
+    USDCTipJar internal tipJar;
+
+    address internal recipient = makeAddr("recipient");
+    address internal tipper = makeAddr("tipper");
+
+    event Tip(address indexed tipper, address indexed recipient, uint256 amount, string message, uint256 timestamp);
+
+    function setUp() public {
+        usdc = new ERC20Mock();
+        tipJar = new USDCTipJar(usdc, recipient);
+        usdc.mint(tipper, 100e18);
+    }
+
+    function testTipTransfersTokensAndRecordsTotals() public {
+        vm.startPrank(tipper);
+        usdc.approve(address(tipJar), 12e18);
+
+        vm.expectEmit(true, true, false, true);
+        emit Tip(tipper, recipient, 12e18, "solid work", block.timestamp);
+
+        tipJar.tip(12e18, "solid work");
+        vm.stopPrank();
+
+        assertEq(usdc.balanceOf(recipient), 12e18);
+        assertEq(usdc.balanceOf(tipper), 88e18);
+        assertEq(tipJar.tipCount(), 1);
+        assertEq(tipJar.totalTipped(), 12e18);
+        assertEq(tipJar.totalTippedBy(tipper), 12e18);
+    }
+
+    function testRevertsForZeroAmount() public {
+        vm.prank(tipper);
+        vm.expectRevert(USDCTipJar.AmountIsZero.selector);
+        tipJar.tip(0, "nope");
+    }
+
+    function testRevertsForLongMessage() public {
+        string memory message =
+            "This message is intentionally longer than one hundred sixty bytes so the tip jar rejects it before moving any USDC from the tipper account, preserving balances and avoiding giant event payloads.";
+
+        vm.startPrank(tipper);
+        usdc.approve(address(tipJar), 1e18);
+        vm.expectRevert(USDCTipJar.MessageTooLong.selector);
+        tipJar.tip(1e18, message);
+        vm.stopPrank();
+    }
+}
