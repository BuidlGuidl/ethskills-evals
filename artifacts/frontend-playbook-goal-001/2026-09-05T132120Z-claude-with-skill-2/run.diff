diff --git a/packages/foundry/test/TipJar.t.sol b/packages/foundry/test/TipJar.t.sol
new file mode 100644
index 0000000..0d331a9
--- /dev/null
+++ b/packages/foundry/test/TipJar.t.sol
@@ -0,0 +1,175 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.19;
+
+import { Test } from "forge-std/Test.sol";
+import { ERC20 } from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { Ownable } from "@openzeppelin/contracts/access/Ownable.sol";
+import { TipJar } from "../contracts/TipJar.sol";
+
+/// @dev Stand-in for USDC in the offline unit tests: same 6 decimals, same plain ERC-20 behaviour.
+contract MockUSDC is ERC20 {
+    constructor() ERC20("USD Coin", "USDC") { }
+
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    function mint(address to, uint256 amount) external {
+        _mint(to, amount);
+    }
+}
+
+contract TipJarTest is Test {
+    MockUSDC internal usdc;
+    TipJar internal jar;
+
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+    address internal bob = makeAddr("bob");
+
+    uint256 internal constant ONE_USDC = 1e6;
+
+    event Tipped(address indexed tipper, uint256 amount, string message, uint256 timestamp);
+    event Withdrawn(address indexed to, uint256 amount);
+
+    function setUp() public {
+        usdc = new MockUSDC();
+        jar = new TipJar(IERC20(address(usdc)), owner);
+
+        usdc.mint(alice, 1000 * ONE_USDC);
+        usdc.mint(bob, 1000 * ONE_USDC);
+    }
+
+    function _tip(address from, uint256 amount, string memory message) internal {
+        vm.startPrank(from);
+        usdc.approve(address(jar), amount);
+        jar.tip(amount, message);
+        vm.stopPrank();
+    }
+
+    function test_TipMovesTokensAndRecordsTotals() public {
+        _tip(alice, 25 * ONE_USDC, "gm");
+
+        assertEq(usdc.balanceOf(address(jar)), 25 * ONE_USDC);
+        assertEq(usdc.balanceOf(alice), 975 * ONE_USDC);
+        assertEq(jar.totalTipped(), 25 * ONE_USDC);
+        assertEq(jar.tipCount(), 1);
+        assertEq(jar.tippedBy(alice), 25 * ONE_USDC);
+        assertEq(jar.jarBalance(), 25 * ONE_USDC);
+    }
+
+    function test_TipEmitsEventForTheFeed() public {
+        vm.prank(alice);
+        usdc.approve(address(jar), ONE_USDC);
+
+        vm.expectEmit(true, false, false, true, address(jar));
+        emit Tipped(alice, ONE_USDC, "thanks for the fix", block.timestamp);
+
+        vm.prank(alice);
+        jar.tip(ONE_USDC, "thanks for the fix");
+    }
+
+    function test_TipsAccumulateAcrossTippers() public {
+        _tip(alice, 10 * ONE_USDC, "one");
+        _tip(bob, 5 * ONE_USDC, "two");
+        _tip(alice, 1, "dust");
+
+        assertEq(jar.totalTipped(), 15 * ONE_USDC + 1);
+        assertEq(jar.tipCount(), 3);
+        assertEq(jar.tippedBy(alice), 10 * ONE_USDC + 1);
+        assertEq(jar.tippedBy(bob), 5 * ONE_USDC);
+    }
+
+    function test_RevertWhen_AmountIsZero() public {
+        vm.prank(alice);
+        vm.expectRevert(TipJar.ZeroAmount.selector);
+        jar.tip(0, "free");
+    }
+
+    function test_RevertWhen_MessageTooLong() public {
+        string memory long = new string(141);
+        vm.prank(alice);
+        vm.expectRevert(abi.encodeWithSelector(TipJar.MessageTooLong.selector, 141));
+        jar.tip(ONE_USDC, long);
+    }
+
+    /// @dev 100 accented characters are 100 UTF-16 units but 200 UTF-8 bytes. A frontend that
+    /// counts characters would let this through; the contract counts bytes and must reject it.
+    function test_RevertWhen_MultiByteMessageExceedsByteLimit() public {
+        string memory accented = "";
+        for (uint256 i = 0; i < 100; i++) {
+            accented = string.concat(accented, unicode"é");
+        }
+        assertEq(bytes(accented).length, 200);
+
+        vm.prank(alice);
+        vm.expectRevert(abi.encodeWithSelector(TipJar.MessageTooLong.selector, 200));
+        jar.tip(ONE_USDC, accented);
+    }
+
+    function test_MessageAtMaxLengthIsAccepted() public {
+        vm.startPrank(alice);
+        usdc.approve(address(jar), ONE_USDC);
+        jar.tip(ONE_USDC, new string(140));
+        vm.stopPrank();
+
+        assertEq(jar.tipCount(), 1);
+    }
+
+    function test_RevertWhen_TipperDidNotApprove() public {
+        vm.prank(alice);
+        vm.expectRevert(); // ERC20InsufficientAllowance
+        jar.tip(ONE_USDC, "no approval");
+    }
+
+    function test_RevertWhen_TipperHasInsufficientBalance() public {
+        vm.startPrank(alice);
+        usdc.approve(address(jar), type(uint256).max);
+        vm.expectRevert(); // ERC20InsufficientBalance
+        jar.tip(1001 * ONE_USDC, "too rich");
+        vm.stopPrank();
+    }
+
+    function test_WithdrawSweepsJarToOwner() public {
+        _tip(alice, 40 * ONE_USDC, "gm");
+
+        vm.expectEmit(true, false, false, true, address(jar));
+        emit Withdrawn(owner, 40 * ONE_USDC);
+
+        vm.prank(owner);
+        jar.withdraw();
+
+        assertEq(usdc.balanceOf(owner), 40 * ONE_USDC);
+        assertEq(jar.jarBalance(), 0);
+        // Historical totals survive a withdrawal.
+        assertEq(jar.totalTipped(), 40 * ONE_USDC);
+    }
+
+    function test_RevertWhen_NonOwnerWithdraws() public {
+        _tip(alice, ONE_USDC, "gm");
+
+        vm.prank(alice);
+        vm.expectRevert(abi.encodeWithSelector(Ownable.OwnableUnauthorizedAccount.selector, alice));
+        jar.withdraw();
+    }
+
+    function test_RevertWhen_WithdrawingEmptyJar() public {
+        vm.prank(owner);
+        vm.expectRevert(TipJar.NothingToWithdraw.selector);
+        jar.withdraw();
+    }
+
+    function testFuzz_TipAccounting(uint96 amount, bytes calldata rawMessage) public {
+        amount = uint96(bound(amount, 1, 1000 * ONE_USDC));
+        // Truncate rather than `vm.assume`, which would reject most generated inputs.
+        uint256 length = rawMessage.length > jar.MAX_MESSAGE_LENGTH() ? jar.MAX_MESSAGE_LENGTH() : rawMessage.length;
+        string memory message = string(rawMessage[:length]);
+
+        _tip(alice, amount, message);
+
+        assertEq(jar.totalTipped(), amount);
+        assertEq(usdc.balanceOf(address(jar)), amount);
+        assertEq(usdc.balanceOf(alice), 1000 * ONE_USDC - amount);
+    }
+}
