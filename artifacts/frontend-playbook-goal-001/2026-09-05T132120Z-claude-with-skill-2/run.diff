@@ -0,0 +1,42 @@
+"use client";
+
+import { useAccount } from "wagmi";
+import { useScaffoldReadContract, useScaffoldWriteContract } from "~~/hooks/scaffold-eth";
+import { logHandledTxError } from "~~/utils/logHandledTxError";
+import { formatUsdc } from "~~/utils/usdc";
+
+/** Only rendered for the jar owner: sweeps the collected USDC out of the contract. */
+export const OwnerPanel = () => {
+  const { address: connectedAddress } = useAccount();
+  const { data: owner } = useScaffoldReadContract({ contractName: "TipJar", functionName: "owner" });
+  const { data: jarBalance } = useScaffoldReadContract({ contractName: "TipJar", functionName: "jarBalance" });
+  const { writeContractAsync, isMining } = useScaffoldWriteContract({ contractName: "TipJar" });
+
+  const isOwner = Boolean(connectedAddress && owner && connectedAddress.toLowerCase() === owner.toLowerCase());
+  if (!isOwner) return null;
+
+  const handleWithdraw = async () => {
+    try {
+      await writeContractAsync({ functionName: "withdraw" });
+    } catch (error) {
+      logHandledTxError("withdraw", error);
+    }
+  };
+
+  return (
+    <div className="card bg-base-200 border border-base-300 w-full">
+      <div className="card-body flex-row items-center justify-between gap-4 flex-wrap py-4">
+        <div>
+          <p className="font-semibold m-0">You own this jar</p>
+          <p className="text-sm opacity-70 m-0">
+            {jarBalance !== undefined ? `${formatUsdc(jarBalance)} USDC ready to withdraw` : "Loading balance…"}
+          </p>
+        </div>
+        <button className="btn btn-secondary" disabled={isMining || !jarBalance} onClick={handleWithdraw}>
+          {isMining && <span className="loading loading-spinner loading-sm" />}
+          Withdraw
+        </button>
+      </div>
+    </div>
+  );
+};
diff --git a/packages/nextjs/app/_components/TipFeed.tsx b/packages/nextjs/app/_components/TipFeed.tsx
new file mode 100644
index 0000000..f160ac3
--- /dev/null
+++ b/packages/nextjs/app/_components/TipFeed.tsx
@@ -0,0 +1,65 @@
+"use client";
+
+import { Address } from "@scaffold-ui/components";
+import { useScaffoldEventHistory, useTargetNetwork } from "~~/hooks/scaffold-eth";
+import { formatTimeAgo } from "~~/utils/formatTimeAgo";
+import { formatUsdc } from "~~/utils/usdc";
+
+export const TipFeed = () => {
+  const { targetNetwork } = useTargetNetwork();
+  const {
+    data: tips,
+    isLoading,
+    error,
+  } = useScaffoldEventHistory({
+    contractName: "TipJar",
+    eventName: "Tipped",
+    watch: true,
+    // The hook pages backwards from the deploy block in batches. The 500-block default means
+    // thousands of eth_getLogs calls on Base (2s blocks); 5k stays inside the usual provider cap.
+    // Past a busy jar this belongs in an indexer — see DEPLOY.md.
+    blocksBatchSize: 5000,
+  });
+
+  return (
+    <div className="card bg-base-100 shadow-xl w-full">
+      <div className="card-body gap-4">
+        <h2 className="card-title">Recent tips</h2>
+
+        {error && <div className="alert alert-error text-sm">Could not load the tip feed: {error.message}</div>}
+
+        {isLoading && (
+          <div className="flex flex-col gap-3">
+            {[0, 1, 2].map(i => (
+              <div key={i} className="skeleton h-16 w-full" />
+            ))}
+          </div>
+        )}
+
+        {!isLoading && tips?.length === 0 && (
+          <p className="opacity-70 m-0">No tips yet. Be the first one in the jar.</p>
+        )}
+
+        <ul className="list-none p-0 m-0 flex flex-col gap-3 max-h-96 overflow-y-auto">
+          {tips?.map(tip => (
+            <li key={`${tip.transactionHash}-${tip.logIndex}`} className="border border-base-300 rounded-box px-4 py-3">
+              <div className="flex items-center justify-between gap-2 flex-wrap">
+                <Address address={tip.args.tipper} chain={targetNetwork} size="sm" />
+                <span className="badge badge-primary badge-lg font-semibold">
+                  {formatUsdc(tip.args.amount ?? 0n)} USDC
+                </span>
+              </div>
+              {tip.args.message && <p className="mt-2 mb-0 break-words">{tip.args.message}</p>}
+              <p
+                className="mt-1 mb-0 text-xs opacity-60"
+                title={new Date(Number(tip.args.timestamp ?? 0n) * 1000).toISOString()}
+              >
+                {formatTimeAgo(tip.args.timestamp ?? 0n)}
+              </p>
+            </li>
+          ))}
+        </ul>
+      </div>
+    </div>
+  );
+};
diff --git a/packages/nextjs/app/_components/TipForm.tsx b/packages/nextjs/app/_components/TipForm.tsx
new file mode 100644
index 0000000..40121fb
--- /dev/null
+++ b/packages/nextjs/app/_components/TipForm.tsx
@@ -0,0 +1,176 @@
+"use client";
+
+import { useState } from "react";
+import { formatUnits } from "viem";
+import { useAccount } from "wagmi";
+import { useDeployedContractInfo, useScaffoldReadContract, useScaffoldWriteContract } from "~~/hooks/scaffold-eth";
+import { logHandledTxError } from "~~/utils/logHandledTxError";
+import { USDC_DECIMALS, formatUsdc, parseUsdc } from "~~/utils/usdc";
+
+const PRESET_AMOUNTS = ["1", "5", "25"];
+const encoder = new TextEncoder();
+
+export const TipForm = () => {
+  const [amount, setAmount] = useState("");
+  const [message, setMessage] = useState("");
+
+  const { address: connectedAddress } = useAccount();
+  const { data: tipJar } = useDeployedContractInfo({ contractName: "TipJar" });
+
+  // Read the limit from the contract so the counter can't drift away from what `tip()` enforces.
+  const { data: maxMessageLength } = useScaffoldReadContract({
+    contractName: "TipJar",
+    functionName: "MAX_MESSAGE_LENGTH",
+    watch: false,
+  });
+  const { data: usdcBalance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "balanceOf",
+    args: [connectedAddress],
+  });
+  const {
+    data: allowance,
+    isLoading: isLoadingAllowance,
+    refetch: refetchAllowance,
+  } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "allowance",
+    args: [connectedAddress, tipJar?.address],
+  });
+  const { data: tippedSoFar } = useScaffoldReadContract({
+    contractName: "TipJar",
+    functionName: "tippedBy",
+    args: [connectedAddress],
+  });
+
+  const { writeContractAsync: writeUsdc, isMining: isApproving } = useScaffoldWriteContract({ contractName: "USDC" });
+  const { writeContractAsync: writeTipJar, isMining: isTipping } = useScaffoldWriteContract({
+    contractName: "TipJar",
+  });
+
+  const amountUnits = parseUsdc(amount);
+  const hasAmountError = amount.trim() !== "" && amountUnits === undefined;
+  const isOverBalance = amountUnits !== undefined && usdcBalance !== undefined && amountUnits > usdcBalance;
+
+  // The contract counts UTF-8 bytes, so "é" costs 2 and "😀" costs 4. Counting characters here
+  // would let a 140-emoji message through and revert after the user already paid for the approve.
+  const messageBytes = encoder.encode(message).length;
+  const messageLimit = Number(maxMessageLength ?? 140n);
+  const isMessageTooLong = messageBytes > messageLimit;
+
+  const needsApproval = amountUnits !== undefined && !isLoadingAllowance && (allowance ?? 0n) < amountUnits;
+  const canSubmit = Boolean(
+    connectedAddress && tipJar && amountUnits !== undefined && !isOverBalance && !isMessageTooLong,
+  );
+
+  const handleApprove = async () => {
+    if (!tipJar || amountUnits === undefined) return;
+    try {
+      await writeUsdc({ functionName: "approve", args: [tipJar.address, amountUnits] });
+    } catch (error) {
+      return logHandledTxError("approve", error);
+    }
+    // Don't make the user stare at "Approve" until the next poll.
+    await refetchAllowance();
+  };
+
+  const handleTip = async () => {
+    if (amountUnits === undefined) return;
+    try {
+      await writeTipJar({ functionName: "tip", args: [amountUnits, message] });
+    } catch (error) {
+      return logHandledTxError("tip", error);
+    }
+    setAmount("");
+    setMessage("");
+  };
+
+  return (
+    <div className="card bg-base-100 shadow-xl w-full">
+      <div className="card-body gap-4">
+        <h2 className="card-title">Leave a tip</h2>
+
+        <div className="form-control">
+          <label className="label" htmlFor="tip-amount">
+            <span className="label-text">Amount (USDC)</span>
+            {usdcBalance !== undefined && <span className="label-text-alt">Balance: {formatUsdc(usdcBalance)}</span>}
+          </label>
+          <div className="join w-full">
+            <input
+              id="tip-amount"
+              className={`input input-bordered join-item w-full ${hasAmountError || isOverBalance ? "input-error" : ""}`}
+              placeholder="0.00"
+              inputMode="decimal"
+              value={amount}
+              onChange={e => setAmount(e.target.value)}
+            />
+            <button
+              type="button"
+              className="btn btn-ghost join-item border border-base-300"
+              disabled={usdcBalance === undefined || usdcBalance === 0n}
+              onClick={() => usdcBalance !== undefined && setAmount(formatUnits(usdcBalance, USDC_DECIMALS))}
+            >
+              Max
+            </button>
+          </div>
+          <div className="flex gap-2 mt-2">
+            {PRESET_AMOUNTS.map(preset => (
+              <button key={preset} type="button" className="btn btn-xs btn-outline" onClick={() => setAmount(preset)}>
+                ${preset}
+              </button>
+            ))}
+          </div>
+          {hasAmountError && (
+            <span className="label-text-alt text-error mt-1">
+              Enter an amount above 0 with at most {USDC_DECIMALS} decimals.
+            </span>
+          )}
+          {isOverBalance && <span className="label-text-alt text-error mt-1">More than your USDC balance.</span>}
+        </div>
+
+        <div className="form-control">
+          <label className="label" htmlFor="tip-message">
+            <span className="label-text">Message (optional)</span>
+            <span className={`label-text-alt ${isMessageTooLong ? "text-error" : ""}`}>
+              {messageBytes}/{messageLimit} bytes
+            </span>
+          </label>
+          <textarea
+            id="tip-message"
+            className={`textarea textarea-bordered w-full ${isMessageTooLong ? "textarea-error" : ""}`}
+            rows={2}
+            placeholder="gm, thanks for the fix"
+            value={message}
+            onChange={e => setMessage(e.target.value)}
+          />
+          {isMessageTooLong && (
+            <span className="label-text-alt text-error mt-1">
+              Too long. Emoji and accented characters take more than one byte each.
+            </span>
+          )}
+        </div>
+
+        {!connectedAddress ? (
+          <button className="btn btn-primary" disabled>
+            Connect a wallet to tip
+          </button>
+        ) : needsApproval ? (
+          <button className="btn btn-primary" disabled={!canSubmit || isApproving} onClick={handleApprove}>
+            {isApproving && <span className="loading loading-spinner loading-sm" />}
+            Approve {amountUnits !== undefined ? formatUsdc(amountUnits) : ""} USDC
+          </button>
+        ) : (
+          <button className="btn btn-primary" disabled={!canSubmit || isTipping} onClick={handleTip}>
+            {isTipping && <span className="loading loading-spinner loading-sm" />}
+            Send tip
+          </button>
+        )}
+
+        <p className="text-xs opacity-70 m-0">
+          Tipping takes two transactions: approve the jar to move that much USDC, then send the tip.
+          {tippedSoFar !== undefined && tippedSoFar > 0n && ` You have tipped ${formatUsdc(tippedSoFar)} USDC so far.`}
+        </p>
+      </div>
+    </div>
+  );
+};
