diff --git a/packages/nextjs/polyfill-localstorage.cjs b/packages/nextjs/polyfill-localstorage.cjs
new file mode 100644
index 0000000..a28745d
--- /dev/null
+++ b/packages/nextjs/polyfill-localstorage.cjs
@@ -0,0 +1,38 @@
+// Node 25 exposes a built-in `localStorage` global. With no backing file it is a truthy object
+// without the Web Storage methods, so libraries that feature-detect it (next-themes, RainbowKit)
+// find it and then crash on `localStorage.getItem(...)` during SSR and static prerendering.
+//
+// This has to be injected with `node --require`, carried in NODE_OPTIONS: Next.js renders in
+// separate worker processes, and neither next.config.ts nor instrumentation.ts runs inside them.
+// Unlike `--no-experimental-webstorage` this is a no-op on Node < 25 instead of a fatal bad option.
+
+const isUsable = () => {
+  try {
+    // Reading the global can itself throw when web storage is enabled without a valid store.
+    return typeof globalThis.localStorage?.getItem === "function";
+  } catch {
+    return false;
+  }
+};
+
+if (!isUsable()) {
+  const store = new Map();
+  const shim = {
+    getItem: key => store.get(String(key)) ?? null,
+    setItem: (key, value) => store.set(String(key), String(value)),
+    removeItem: key => store.delete(String(key)),
+    clear: () => store.clear(),
+    key: index => [...store.keys()][index] ?? null,
+    get length() {
+      return store.size;
+    },
+  };
+
+  // defineProperty rather than assignment: the built-in global is an accessor, and a future Node
+  // could ship it without a setter, which would make `globalThis.localStorage = shim` a silent no-op.
+  Object.defineProperty(globalThis, "localStorage", { value: shim, writable: true, configurable: true });
+
+  if (!isUsable()) {
+    throw new Error("polyfill-localstorage.cjs could not install a usable localStorage global");
+  }
+}
