--- /dev/null
+++ b/packages/nextjs/utils/usdc.ts
@@ -0,0 +1,25 @@
+import { formatUnits, parseUnits } from "viem";
+
+export const USDC_DECIMALS = 6;
+
+/**
+ * Formats base units as a human USDC amount. Locale is pinned so static HTML and client agree.
+ * Amounts below a cent render as "<0.01" rather than a misleading "0.00".
+ */
+export const formatUsdc = (amount: bigint, maximumFractionDigits = 2) => {
+  const formatted = Number(formatUnits(amount, USDC_DECIMALS)).toLocaleString("en-US", {
+    minimumFractionDigits: 2,
+    maximumFractionDigits,
+  });
+  return amount > 0n && Number(formatted.replace(/,/g, "")) === 0 ? "<0.01" : formatted;
+};
+
+/** Parses a user-typed USDC amount into base units, or undefined if it isn't a usable amount. */
+export const parseUsdc = (value: string) => {
+  const trimmed = value.trim();
+  if (!/^\d+(\.\d+)?$/.test(trimmed)) return undefined;
+  // parseUnits silently rounds anything past 6 decimals, so reject it instead.
+  if ((trimmed.split(".")[1]?.length ?? 0) > USDC_DECIMALS) return undefined;
+  const units = parseUnits(trimmed, USDC_DECIMALS);
+  return units > 0n ? units : undefined;
+};
