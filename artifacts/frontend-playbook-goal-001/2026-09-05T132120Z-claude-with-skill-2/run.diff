@@ -0,0 +1,71 @@
+#!/usr/bin/env bash
+# Fund a demo identity with real Base USDC on the local fork.
+#
+# Usage: yarn fund-usdc <address> [amount-in-usdc]     (default: 250)
+#
+# Nothing here is broadcast anywhere: anvil is a local copy of Base, so the USDC is
+# real state but the money is not. This is what makes the demo safe.
+set -euo pipefail
+
+RPC="${RPC:-http://127.0.0.1:8545}"
+USDC="0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913"
+# Morpho Blue on Base — holds hundreds of millions of USDC. Swap it if it ever runs dry:
+#   cast call $USDC "balanceOf(address)(uint256)" <candidate> --rpc-url https://mainnet.base.org
+WHALE="${WHALE:-0xBBBBBbbBBb9cC5e90e3b3Af64bdAF62C37EEFFCb}"
+
+RECIPIENT="${1:-}"
+AMOUNT="${2:-250}"
+
+# Bash arithmetic is 64-bit and anvil hands out 10000 ETH (1e22 wei), so compare with awk.
+lt() { awk "BEGIN { exit !($1 < $2) }"; }
+
+if [[ ! "$WHALE" =~ ^0x[0-9a-fA-F]{40}$ ]]; then
+  echo "❌ WHALE='$WHALE' is not a 20-byte address." >&2
+  exit 1
+fi
+
+if [[ ! "$RECIPIENT" =~ ^0x[0-9a-fA-F]{40}$ ]]; then
+  echo "Usage: yarn fund-usdc <address> [amount-in-usdc]" >&2
+  [[ -n "$RECIPIENT" ]] && echo "  '$RECIPIENT' is not a 20-byte address." >&2
+  exit 1
+fi
+
+CHAIN_ID=$(cast chain-id --rpc-url "$RPC" 2>/dev/null || true)
+if [[ "$CHAIN_ID" != "31337" ]]; then
+  echo "❌ No local chain at $RPC (chain id: '${CHAIN_ID:-none}'). Run: yarn fork --network base" >&2
+  exit 1
+fi
+
+if [[ "$(cast code "$USDC" --rpc-url "$RPC")" == "0x" ]]; then
+  echo "❌ No USDC at $USDC on this chain." >&2
+  echo "   You are on a bare anvil. Restart it as a Base fork: yarn fork --network base" >&2
+  exit 1
+fi
+
+UNITS=$(cast to-wei "$AMOUNT" mwei)  # USDC has 6 decimals, so mwei is the right unit
+
+WHALE_BALANCE=$(cast call "$USDC" "balanceOf(address)(uint256)" "$WHALE" --rpc-url "$RPC" | cut -d' ' -f1)
+if lt "$WHALE_BALANCE" "$UNITS"; then
+  echo "❌ Whale $WHALE only holds $(cast to-unit "$WHALE_BALANCE" mwei) USDC, less than the $AMOUNT requested." >&2
+  echo "   Find another holder and pass it through WHALE=0x… (see README.md)." >&2
+  exit 1
+fi
+
+# Gas money. anvil cheats are free here and never leave this machine. Only top up accounts that
+# are actually short, so this stays safe to re-run mid-demo without resetting anyone's balance.
+top_up_gas() {
+  local account="$1"
+  if lt "$(cast balance "$account" --rpc-url "$RPC")" 1000000000000000000; then
+    cast rpc anvil_setBalance "$account" 0x8ac7230489e80000 --rpc-url "$RPC" >/dev/null  # 10 ETH
+  fi
+}
+top_up_gas "$WHALE"
+top_up_gas "$RECIPIENT"
+
+cast rpc anvil_impersonateAccount "$WHALE" --rpc-url "$RPC" >/dev/null
+cast send "$USDC" "transfer(address,uint256)" "$RECIPIENT" "$UNITS" \
+  --from "$WHALE" --unlocked --rpc-url "$RPC" >/dev/null
+cast rpc anvil_stopImpersonatingAccount "$WHALE" --rpc-url "$RPC" >/dev/null
+
+BALANCE=$(cast call "$USDC" "balanceOf(address)(uint256)" "$RECIPIENT" --rpc-url "$RPC" | cut -d' ' -f1)
+echo "✅ $RECIPIENT now holds $(cast to-unit "$BALANCE" mwei) USDC and $(cast to-unit "$(cast balance "$RECIPIENT" --rpc-url "$RPC")" ether) ETH on the fork."

