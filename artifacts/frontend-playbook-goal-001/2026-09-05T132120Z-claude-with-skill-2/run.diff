--- /dev/null
+++ b/packages/nextjs/utils/formatTimeAgo.ts
@@ -0,0 +1,14 @@
+const UNITS = [
+  { limit: 60, seconds: 1, label: "s" },
+  { limit: 3600, seconds: 60, label: "m" },
+  { limit: 86400, seconds: 3600, label: "h" },
+  { limit: Infinity, seconds: 86400, label: "d" },
+] as const;
+
+/** "just now" / "42s ago" / "3h ago". `timestamp` is unix seconds. */
+export const formatTimeAgo = (timestamp: bigint, now = Date.now()) => {
+  const elapsed = Math.max(0, Math.floor(now / 1000) - Number(timestamp));
+  if (elapsed < 5) return "just now";
+  const unit = UNITS.find(({ limit }) => elapsed < limit) ?? UNITS[UNITS.length - 1];
+  return `${Math.floor(elapsed / unit.seconds)}${unit.label} ago`;
+};
