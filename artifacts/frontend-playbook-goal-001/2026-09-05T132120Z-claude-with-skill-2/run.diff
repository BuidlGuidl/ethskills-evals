+
+/**
+ * @notice The same flow the demo runs, but against real Base state instead of a mock token.
+ * @dev Network-dependent, so it is opt-in: `FORK_TESTS=true forge test --match-contract TipJarBaseFork`.
+ *      A plain `forge test` skips it and stays offline.
+ *      This also pins down the two addresses README.md tells operators to impersonate.
+ */
+contract TipJarBaseForkTest is Test {
+    address internal constant BASE_USDC = 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913;
+    /// @dev Morpho Blue on Base — holds hundreds of millions of USDC, the whale README.md uses.
+    address internal constant USDC_WHALE = 0xBBBBBbbBBb9cC5e90e3b3Af64bdAF62C37EEFFCb;
+    /// @dev Defaults to the chain head. Pin one with `FORK_BLOCK=<n>` for a reproducible run —
+    /// but only against an archive-capable endpoint, since the public Base RPC prunes state.
+    uint256 internal forkBlock = vm.envOr("FORK_BLOCK", uint256(0));
+
+    IERC20 internal usdc = IERC20(BASE_USDC);
+    TipJar internal jar;
+
+    address internal owner = makeAddr("jarOwner");
+    address internal tipper = makeAddr("tipper");
+
+    uint256 internal constant ONE_USDC = 1e6;
+
+    function setUp() public {
+        if (!vm.envOr("FORK_TESTS", false)) {
+            vm.skip(true);
+            return;
+        }
+        if (forkBlock == 0) {
+            vm.createSelectFork(vm.rpcUrl("base"));
+        } else {
+            vm.createSelectFork(vm.rpcUrl("base"), forkBlock);
+        }
+        jar = new TipJar(usdc, owner);
+    }
+
+    function test_DeployScriptTargetsTheRealBaseUsdc() public {
+        assertEq(new DeployTipJar().BASE_USDC(), BASE_USDC);
+        // The assertions that actually mean something: the address the script deploys against is a
+        // live 6-decimal USDC on Base, not just a constant matching another constant.
+        assertEq(IERC20Metadata(BASE_USDC).symbol(), "USDC");
+        assertEq(IERC20Metadata(BASE_USDC).decimals(), 6);
+    }
+
+    function test_WhaleStillHoldsEnoughToFundDemoIdentities() public view {
+        uint256 whaleBalance = usdc.balanceOf(USDC_WHALE);
+        console.log("whale USDC balance:", whaleBalance / ONE_USDC);
+        assertGt(whaleBalance, 1_000_000 * ONE_USDC);
+    }
+
+    function test_RealUsdcMovesFromWhaleToTipperToJarToOwner() public {
+        // 1. Fund a test identity from a real holder — the `cast rpc anvil_impersonateAccount` step.
+        vm.prank(USDC_WHALE);
+        usdc.transfer(tipper, 500 * ONE_USDC);
+        assertEq(usdc.balanceOf(tipper), 500 * ONE_USDC);
+
+        // 2. Approve + tip, exactly what the frontend does.
+        vm.startPrank(tipper);
+        usdc.approve(address(jar), 120 * ONE_USDC);
+        jar.tip(120 * ONE_USDC, "real USDC, fake money");
+        vm.stopPrank();
+
+        assertEq(usdc.balanceOf(tipper), 380 * ONE_USDC);
+        assertEq(jar.jarBalance(), 120 * ONE_USDC);
+        assertEq(jar.totalTipped(), 120 * ONE_USDC);
+
+        // 3. Owner sweeps the jar.
+        vm.prank(owner);
+        jar.withdraw();
+
+        assertEq(usdc.balanceOf(owner), 120 * ONE_USDC);
+        assertEq(jar.jarBalance(), 0);
+    }
+}
