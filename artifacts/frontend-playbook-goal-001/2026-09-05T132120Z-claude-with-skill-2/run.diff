+// Preflight for the static IPFS build. Both of these produce a build that looks fine locally and
+// is broken once it is on a gateway, so fail/warn here instead of after the upload.
+import nextEnv from "@next/env";
+
+// This script runs before `next build`, so nothing has loaded .env.local yet — do it the same way
+// Next does, or a correctly configured .env.local looks empty and the build fails for no reason.
+nextEnv.loadEnvConfig(process.cwd(), false, { info: () => {}, error: console.error });
+
+const productionUrl = process.env.NEXT_PUBLIC_PRODUCTION_URL;
+
+if (!productionUrl) {
+  console.error(
+    "\n❌ NEXT_PUBLIC_PRODUCTION_URL is not set.\n" +
+      "   The static export bakes og:image in as an absolute URL, so without it every unfurl\n" +
+      "   points at http://localhost:3000.\n" +
+      "   Set it in packages/nextjs/.env.local, or inline:\n" +
+      '   NEXT_PUBLIC_PRODUCTION_URL="https://tipjar.yourname.eth.link" yarn ipfs:build\n',
+  );
+  process.exit(1);
+}
+
+if (!/^https:\/\//.test(productionUrl) || productionUrl.endsWith("/")) {
+  console.error(
+    `\n❌ NEXT_PUBLIC_PRODUCTION_URL must be an https URL with no trailing slash (got "${productionUrl}").\n`,
+  );
+  process.exit(1);
+}
+
+if (!process.env.NEXT_PUBLIC_BASE_RPC_URL) {
+  console.warn(
+    "\n⚠️  NEXT_PUBLIC_BASE_RPC_URL is not set.\n" +
+      "   The build will fall back to viem's public Base endpoint (https://mainnet.base.org),\n" +
+      "   which rate-limits hard and should not back a public site. Set a private endpoint in\n" +
+      "   packages/nextjs/.env.local before shipping.\n",
+  );
+}
+
+console.log(`✅ IPFS build preflight passed (production URL: ${productionUrl})`);
