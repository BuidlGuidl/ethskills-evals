@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import "./DeployHelpers.s.sol";
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { TipJar } from "../contracts/TipJar.sol";
+
+/**
+ * @notice Deploy script for TipJar.
+ * @dev Defaults to the canonical Base USDC address, which is also the right address on a Base fork
+ *      (`yarn fork:base`) because the fork carries real Base state. Override with `USDC_ADDRESS`
+ *      when deploying somewhere else.
+ *
+ * Example:
+ * yarn deploy --file DeployTipJar.s.sol             # local Base fork
+ * yarn deploy --file DeployTipJar.s.sol --network base
+ */
+contract DeployTipJar is ScaffoldETHDeploy {
+    address constant BASE_USDC = 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913;
+
+    function run() external ScaffoldEthDeployerRunner {
+        address usdc = vm.envOr("USDC_ADDRESS", BASE_USDC);
+
+        // A jar wired to an address with no code accepts no tips and fails silently in the UI.
+        // On a bare `yarn chain` anvil there is no USDC at this address -- use `yarn fork:base`.
+        require(
+            usdc.code.length > 0,
+            "No token at USDC_ADDRESS on this chain. Start a Base fork with `yarn fork:base`, or set USDC_ADDRESS."
+        );
+
+        new TipJar(IERC20(usdc), deployer);
+    }
+}
