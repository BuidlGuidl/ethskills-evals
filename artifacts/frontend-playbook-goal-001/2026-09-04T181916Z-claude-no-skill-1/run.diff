diff --git a/packages/nextjs/app/_components/TipFeed.tsx b/packages/nextjs/app/_components/TipFeed.tsx
new file mode 100644
index 0000000..803c8ec
--- /dev/null
+++ b/packages/nextjs/app/_components/TipFeed.tsx
@@ -0,0 +1,92 @@
+"use client";
+
+import { useState } from "react";
+import { Address } from "@scaffold-ui/components";
+import { useScaffoldReadContract, useTargetNetwork } from "~~/hooks/scaffold-eth";
+import { formatUsdc } from "~~/utils/usdc";
+
+const PAGE_SIZE = 10;
+
+const formatAge = (timestamp: bigint) => {
+  const seconds = Math.max(0, Math.floor(Date.now() / 1000) - Number(timestamp));
+  if (seconds < 60) return "just now";
+  const minutes = Math.floor(seconds / 60);
+  if (minutes < 60) return `${minutes}m ago`;
+  const hours = Math.floor(minutes / 60);
+  if (hours < 24) return `${hours}h ago`;
+  return `${Math.floor(hours / 24)}d ago`;
+};
+
+/**
+ * The feed is read straight off the contract with a paginated `eth_call` rather than assembled from
+ * `Tipped` logs. The published site is a static bundle with no indexer behind it, and public RPCs cap
+ * how far back `eth_getLogs` may reach — a view call keeps working however old the jar gets.
+ */
+export const TipFeed = () => {
+  const [page, setPage] = useState(0);
+  const { targetNetwork } = useTargetNetwork();
+
+  const { data: tipCount } = useScaffoldReadContract({ contractName: "TipJar", functionName: "tipCount" });
+  const { data: tips, isLoading } = useScaffoldReadContract({
+    contractName: "TipJar",
+    functionName: "getTips",
+    args: [BigInt(page * PAGE_SIZE), BigInt(PAGE_SIZE)],
+  });
+
+  const pageCount = tipCount === undefined ? 0 : Math.ceil(Number(tipCount) / PAGE_SIZE);
+
+  return (
+    <div className="card bg-base-100 shadow-xl w-full">
+      <div className="card-body gap-4">
+        <div className="flex items-center justify-between">
+          <h2 className="card-title">Tip feed</h2>
+          {tipCount !== undefined && tipCount > 0n && (
+            <span className="badge badge-ghost">{tipCount.toString()} total</span>
+          )}
+        </div>
+
+        {isLoading && tips === undefined ? (
+          <div className="flex flex-col gap-3">
+            {[0, 1, 2].map(i => (
+              <div key={i} className="skeleton h-20 w-full" />
+            ))}
+          </div>
+        ) : !tips || tips.length === 0 ? (
+          <p className="opacity-70 m-0">No tips yet. Be the first.</p>
+        ) : (
+          <ul className="list-none flex flex-col gap-3 p-0 m-0">
+            {tips.map((tip, i) => (
+              // Position from the newest tip. Two tips can otherwise be identical in every field.
+              <li key={page * PAGE_SIZE + i} className="bg-base-200 p-4 flex flex-col gap-2">
+                <div className="flex items-center justify-between gap-2 flex-wrap">
+                  <Address address={tip.sender} size="sm" chain={targetNetwork} />
+                  <span className="badge badge-primary badge-lg font-semibold">{formatUsdc(tip.amount)} USDC</span>
+                </div>
+                {tip.message && <p className="m-0 break-words">{tip.message}</p>}
+                <span className="text-xs opacity-60">{formatAge(tip.timestamp)}</span>
+              </li>
+            ))}
+          </ul>
+        )}
+
+        {pageCount > 1 && (
+          <div className="join self-center">
+            <button className="join-item btn btn-sm" disabled={page === 0} onClick={() => setPage(p => p - 1)}>
+              «
+            </button>
+            <span className="join-item btn btn-sm btn-disabled">
+              {page + 1} / {pageCount}
+            </span>
+            <button
+              className="join-item btn btn-sm"
+              disabled={page >= pageCount - 1}
+              onClick={() => setPage(p => p + 1)}
+            >
+              »
+            </button>
+          </div>
+        )}
+      </div>
+    </div>
+  );
+};
diff --git a/packages/nextjs/app/_components/TipForm.tsx b/packages/nextjs/app/_components/TipForm.tsx
new file mode 100644
index 0000000..1960352
--- /dev/null
+++ b/packages/nextjs/app/_components/TipForm.tsx
@@ -0,0 +1,163 @@
+"use client";
+
+import { useState } from "react";
+import { BaseInput } from "@scaffold-ui/components";
+import { hardhat } from "viem/chains";
+import { useAccount } from "wagmi";
+import {
+  useDeployedContractInfo,
+  useScaffoldReadContract,
+  useScaffoldWriteContract,
+  useTargetNetwork,
+} from "~~/hooks/scaffold-eth";
+import { MAX_MESSAGE_BYTES, formatUsdc, messageByteLength, parseUsdc } from "~~/utils/usdc";
+
+const QUICK_AMOUNTS = ["1", "5", "25"];
+
+/** USDC has 6 decimals, so anything finer than that cannot be sent. Reject it at the keystroke. */
+const isTypableAmount = (value: string) => /^\d*\.?\d{0,6}$/.test(value);
+
+/**
+ * USDC is a plain ERC-20, so tipping is the usual two-step approve-then-spend dance. The form only
+ * ever asks for the allowance the current tip needs, so a stale approval can never outlive it.
+ */
+export const TipForm = () => {
+  const [amount, setAmount] = useState("");
+  const [message, setMessage] = useState("");
+
+  const { address: connectedAddress, isConnected } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+  const { data: tipJar } = useDeployedContractInfo({ contractName: "TipJar" });
+
+  const { data: usdcBalance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "balanceOf",
+    args: [connectedAddress],
+  });
+  const { data: allowance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "allowance",
+    args: [connectedAddress, tipJar?.address],
+  });
+
+  const { writeContractAsync: writeUsdc, isMining: isApproving } = useScaffoldWriteContract({ contractName: "USDC" });
+  const { writeContractAsync: writeTipJar, isMining: isTipping } = useScaffoldWriteContract({ contractName: "TipJar" });
+
+  const tipUnits = parseUsdc(amount);
+  const messageBytes = messageByteLength(message);
+  const isOverBalance = tipUnits !== null && usdcBalance !== undefined && tipUnits > usdcBalance;
+  const isMessageTooLong = messageBytes > MAX_MESSAGE_BYTES;
+  const needsApproval = tipUnits !== null && (allowance ?? 0n) < tipUnits;
+  const isBusy = isApproving || isTipping;
+
+  const canSubmit = isConnected && tipUnits !== null && !isOverBalance && !isMessageTooLong && !isBusy;
+  // On the local Base fork an empty wallet is the normal starting state, and the fix is one command.
+  const needsLocalFunding = isConnected && usdcBalance === 0n && targetNetwork.id === hardhat.id;
+
+  const handleApprove = async () => {
+    if (!canSubmit || !tipJar || tipUnits === null) return;
+    try {
+      await writeUsdc({ functionName: "approve", args: [tipJar.address, tipUnits] });
+    } catch (error) {
+      console.error("Approve failed", error);
+    }
+  };
+
+  const handleTip = async () => {
+    if (!canSubmit || tipUnits === null) return;
+    try {
+      await writeTipJar({ functionName: "tip", args: [tipUnits, message] });
+      setAmount("");
+      setMessage("");
+    } catch (error) {
+      console.error("Tip failed", error);
+    }
+  };
+
+  return (
+    <div className="card bg-base-100 shadow-xl w-full">
+      <div className="card-body gap-4">
+        <h2 className="card-title">Send a tip</h2>
+
+        <div className="flex flex-col gap-2">
+          <div className="flex justify-between items-baseline">
+            <span className="text-sm font-medium">Amount</span>
+            <span className="text-xs opacity-70">
+              {usdcBalance === undefined ? "—" : `${formatUsdc(usdcBalance)} USDC available`}
+            </span>
+          </div>
+          <BaseInput
+            name="amount"
+            value={amount}
+            onChange={value => isTypableAmount(value) && setAmount(value)}
+            placeholder="0.00"
+            disabled={isBusy}
+            error={isOverBalance}
+            suffix={<span className="self-center px-4 font-medium">USDC</span>}
+          />
+          <div className="flex gap-2">
+            {QUICK_AMOUNTS.map(quickAmount => (
+              <button
+                key={quickAmount}
+                type="button"
+                className="btn btn-xs btn-outline"
+                disabled={isBusy}
+                onClick={() => setAmount(quickAmount)}
+              >
+                {quickAmount} USDC
+              </button>
+            ))}
+          </div>
+        </div>
+
+        <div className="flex flex-col gap-2">
+          <div className="flex justify-between items-baseline">
+            <span className="text-sm font-medium">Message</span>
+            <span className={`text-xs ${isMessageTooLong ? "text-error" : "opacity-70"}`}>
+              {messageBytes}/{MAX_MESSAGE_BYTES}
+            </span>
+          </div>
+          <BaseInput
+            name="message"
+            value={message}
+            onChange={setMessage}
+            placeholder="Say something nice (optional)"
+            disabled={isBusy}
+            error={isMessageTooLong}
+          />
+        </div>
+
+        {isOverBalance && <p className="text-error text-sm m-0">That is more USDC than this wallet holds.</p>}
+
+        {needsLocalFunding && (
+          <div role="alert" className="alert alert-info text-sm">
+            <span>
+              This wallet holds no USDC on the fork. Mint some with{" "}
+              <code className="font-bold break-all">yarn fund-usdc --to {connectedAddress}</code>
+            </span>
+          </div>
+        )}
+
+        {!isConnected ? (
+          <p className="text-sm opacity-70 m-0">Connect a wallet to send a tip.</p>
+        ) : needsApproval ? (
+          <button className="btn btn-primary" disabled={!canSubmit} onClick={handleApprove}>
+            {isApproving && <span className="loading loading-spinner loading-xs" />}
+            Approve {tipUnits !== null ? formatUsdc(tipUnits) : ""} USDC
+          </button>
+        ) : (
+          <button className="btn btn-primary" disabled={!canSubmit} onClick={handleTip}>
+            {isTipping && <span className="loading loading-spinner loading-xs" />}
+            Send tip
+          </button>
+        )}
+
+        {needsApproval && isConnected && (
+          <p className="text-xs opacity-70 m-0">
+            Step 1 of 2 — USDC needs your approval before the tip jar can pull it.
+          </p>
+        )}
+      </div>
+    </div>
+  );
+};
