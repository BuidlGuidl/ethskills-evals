diff --git a/packages/foundry/scripts-js/fundLocalUsdc.js b/packages/foundry/scripts-js/fundLocalUsdc.js
new file mode 100644
index 0000000..4f79c59
--- /dev/null
+++ b/packages/foundry/scripts-js/fundLocalUsdc.js
@@ -0,0 +1,201 @@
+/**
+ * Funds local test identities with real Base USDC on a local Anvil fork.
+ *
+ * Instead of poking storage slots or chasing a whale address that may have moved its balance, this
+ * impersonates USDC's own on-chain `masterMinter`, grants a throwaway minter role, and mints. Every
+ * transfer the demo then makes runs through the real FiatToken code deployed on Base.
+ *
+ * Refuses to run unless the RPC is a local Anvil node on chain 31337, so it can never touch mainnet.
+ */
+import { execFileSync } from "child_process";
+
+const USDC = "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913";
+const RPC_URL = process.env.RPC_URL || "http://127.0.0.1:8545";
+const LOCAL_CHAIN_ID = "31337";
+const GAS_MONEY_WEI = "0x56bc75e2d63100000"; // 100 ETH
+// Throwaway address used as the USDC minter on the fork. Local-only, holds nothing on real Base.
+const LOCAL_MINTER = "0x00000000000000000000000000000000cafeF00D";
+
+// Anvil's default accounts. #9 is the Scaffold-ETH deployer / tip jar owner.
+const DEFAULT_RECIPIENTS = [
+  {
+    label: "anvil #0 (Alice)",
+    address: "0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266",
+  },
+  {
+    label: "anvil #1 (Bob)",
+    address: "0x70997970C51812dc3A010C7d01b50e0d17dc79C8",
+  },
+  {
+    label: "anvil #2 (Carol)",
+    address: "0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC",
+  },
+];
+
+const cast = (...args) =>
+  execFileSync("cast", args, { encoding: "utf8" }).trim();
+
+function parseArgs(argv) {
+  const recipients = [];
+  let amount = "1000";
+
+  for (let i = 0; i < argv.length; i++) {
+    if (argv[i] === "--to" && argv[i + 1]) {
+      recipients.push({ label: "custom", address: argv[++i] });
+    } else if (argv[i] === "--amount" && argv[i + 1]) {
+      amount = argv[++i];
+    } else if (argv[i] === "--help" || argv[i] === "-h") {
+      console.log(`
+Usage: yarn fund-usdc [options]
+
+Mints real Base USDC to local test identities on a running Anvil fork of Base.
+
+Options:
+  --to <address>     Recipient. Repeatable. Defaults to Anvil accounts #0, #1 and #2.
+  --amount <usdc>    Amount per recipient, in whole USDC (default: 1000)
+  --help, -h         Show this message
+
+Examples:
+  yarn fund-usdc
+  yarn fund-usdc --amount 250
+  yarn fund-usdc --to 0xYourBurnerWalletAddress --amount 50
+`);
+      process.exit(0);
+    } else {
+      console.error(`\n❌ Unknown argument: ${argv[i]} (try --help)`);
+      process.exit(1);
+    }
+  }
+
+  if (!/^\d+(\.\d{1,6})?$/.test(amount)) {
+    console.error(
+      `\n❌ --amount must be a positive number with at most 6 decimals, got "${amount}"`
+    );
+    process.exit(1);
+  }
+
+  return {
+    recipients: recipients.length > 0 ? recipients : DEFAULT_RECIPIENTS,
+    amount,
+  };
+}
+
+function assertLocalFork() {
+  const { hostname } = new URL(RPC_URL);
+  if (!["localhost", "127.0.0.1", "0.0.0.0", "[::1]"].includes(hostname)) {
+    console.error(
+      `\n❌ Refusing to run against a non-local RPC (${RPC_URL}). This script only targets local Anvil.`
+    );
+    process.exit(1);
+  }
+
+  let chainId;
+  try {
+    chainId = cast("chain-id", "-r", RPC_URL);
+  } catch {
+    console.error(
+      `\n❌ No node answering at ${RPC_URL}. Start the fork first:\n\n   yarn fork:base\n`
+    );
+    process.exit(1);
+  }
+
+  if (chainId !== LOCAL_CHAIN_ID) {
+    console.error(
+      `\n❌ Expected chain id ${LOCAL_CHAIN_ID} (local Anvil), got ${chainId}. Refusing to continue.`
+    );
+    process.exit(1);
+  }
+
+  try {
+    cast("rpc", "anvil_nodeInfo", "-r", RPC_URL);
+  } catch {
+    console.error(
+      `\n❌ ${RPC_URL} is not an Anvil node (no anvil_* RPC methods). Refusing to continue.`
+    );
+    process.exit(1);
+  }
+
+  if (cast("code", USDC, "-r", RPC_URL) === "0x") {
+    console.error(
+      `\n❌ No USDC at ${USDC} on this chain.\n` +
+        `   This is a plain Anvil chain, not a Base fork. Restart it with:\n\n   yarn fork:base\n`
+    );
+    process.exit(1);
+  }
+}
+
+const { recipients, amount } = parseArgs(process.argv.slice(2));
+
+assertLocalFork();
+
+// USDC has 6 decimals, so "mwei" (1e6) is the right scale factor for whole USDC.
+const amountUnits = cast("to-wei", amount, "mwei");
+
+// Unlock every account on the node so we can send as USDC's minter roles.
+cast("rpc", "anvil_autoImpersonateAccount", "true", "-r", RPC_URL);
+
+const masterMinter = cast(
+  "call",
+  USDC,
+  "masterMinter()(address)",
+  "-r",
+  RPC_URL
+);
+
+console.log(`\n🍴 Local Base fork at ${RPC_URL}`);
+console.log(`   USDC masterMinter: ${masterMinter}`);
+
+for (const account of [masterMinter, LOCAL_MINTER]) {
+  cast("rpc", "anvil_setBalance", account, GAS_MONEY_WEI, "-r", RPC_URL);
+}
+
+const send = (from, to, sig, ...args) =>
+  cast(
+    "send",
+    to,
+    sig,
+    ...args,
+    "--from",
+    from,
+    "--unlocked",
+    "-r",
+    RPC_URL,
+    "--json"
+  );
+
+// Allowance is per configureMinter call, so re-authorise on every run.
+const totalToMint = (
+  BigInt(amountUnits) * BigInt(recipients.length)
+).toString();
+send(
+  masterMinter,
+  USDC,
+  "configureMinter(address,uint256)",
+  LOCAL_MINTER,
+  totalToMint
+);
+
+for (const { label, address } of recipients) {
+  send(LOCAL_MINTER, USDC, "mint(address,uint256)", address, amountUnits);
+  // Anvil's dev accounts are pre-funded with ETH, but a burner wallet passed via --to is not.
+  if (BigInt(cast("balance", address, "-r", RPC_URL)) === 0n) {
+    cast("rpc", "anvil_setBalance", address, GAS_MONEY_WEI, "-r", RPC_URL);
+  }
+  const balance = cast(
+    "call",
+    USDC,
+    "balanceOf(address)(uint256)",
+    address,
+    "-r",
+    RPC_URL
+  ).split(" ")[0];
+  console.log(
+    `   ✅ ${address}  ${(
+      Number(balance) / 1e6
+    ).toLocaleString()} USDC  ${label}`
+  );
+}
+
+console.log(
+  `\n💸 Minted ${amount} USDC to ${recipients.length} account(s). No real money moved: this is a local fork.\n`
+);
diff --git a/packages/foundry/test/TipJar.t.sol b/packages/foundry/test/TipJar.t.sol
new file mode 100644
index 0000000..cf035b2
--- /dev/null
+++ b/packages/foundry/test/TipJar.t.sol
@@ -0,0 +1,146 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import { Test } from "forge-std/Test.sol";
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { Ownable } from "@openzeppelin/contracts/access/Ownable.sol";
+import { ERC20Mock } from "@openzeppelin/contracts/mocks/token/ERC20Mock.sol";
+import { TipJar } from "../contracts/TipJar.sol";
+
+contract TipJarTest is Test {
+    ERC20Mock token;
+    TipJar jar;
+
+    address owner = makeAddr("owner");
+    address alice = makeAddr("alice");
+    address bob = makeAddr("bob");
+
+    function setUp() public {
+        token = new ERC20Mock();
+        jar = new TipJar(IERC20(address(token)), owner);
+
+        token.mint(alice, 1_000e6);
+        token.mint(bob, 1_000e6);
+        vm.prank(alice);
+        token.approve(address(jar), type(uint256).max);
+        vm.prank(bob);
+        token.approve(address(jar), type(uint256).max);
+    }
+
+    function test_TipMovesTokensAndRecordsFeedEntry() public {
+        vm.prank(alice);
+        jar.tip(25e6, "coffee money");
+
+        assertEq(token.balanceOf(address(jar)), 25e6);
+        assertEq(token.balanceOf(alice), 975e6);
+        assertEq(jar.totalTipped(), 25e6);
+        assertEq(jar.jarBalance(), 25e6);
+        assertEq(jar.tipCount(), 1);
+
+        TipJar.Tip[] memory page = jar.getTips(0, 10);
+        assertEq(page.length, 1);
+        assertEq(page[0].sender, alice);
+        assertEq(page[0].amount, 25e6);
+        assertEq(page[0].message, "coffee money");
+        assertEq(page[0].timestamp, uint64(block.timestamp));
+    }
+
+    function test_FeedIsNewestFirstAndPaginates() public {
+        vm.prank(alice);
+        jar.tip(1e6, "first");
+        vm.prank(bob);
+        jar.tip(2e6, "second");
+        vm.prank(alice);
+        jar.tip(3e6, "third");
+
+        TipJar.Tip[] memory firstPage = jar.getTips(0, 2);
+        assertEq(firstPage.length, 2);
+        assertEq(firstPage[0].message, "third");
+        assertEq(firstPage[1].message, "second");
+
+        TipJar.Tip[] memory secondPage = jar.getTips(2, 2);
+        assertEq(secondPage.length, 1);
+        assertEq(secondPage[0].message, "first");
+
+        assertEq(jar.getTips(3, 2).length, 0);
+        assertEq(jar.getTips(99, 2).length, 0);
+        assertEq(jar.totalTipped(), 6e6);
+    }
+
+    function test_TipEmitsEvent() public {
+        vm.expectEmit(true, false, false, true, address(jar));
+        emit TipJar.Tipped(alice, 5e6, "hi", 0);
+        vm.prank(alice);
+        jar.tip(5e6, "hi");
+    }
+
+    function test_RevertWhen_AmountIsZero() public {
+        vm.prank(alice);
+        vm.expectRevert(TipJar.ZeroAmount.selector);
+        jar.tip(0, "nothing");
+    }
+
+    function test_RevertWhen_MessageTooLong() public {
+        string memory tooLong = new string(141);
+        vm.prank(alice);
+        vm.expectRevert(abi.encodeWithSelector(TipJar.MessageTooLong.selector, 141));
+        jar.tip(1e6, tooLong);
+    }
+
+    function test_RevertWhen_AmountExceedsUint96() public {
+        uint256 tooBig = uint256(type(uint96).max) + 1;
+        token.mint(alice, tooBig);
+        vm.prank(alice);
+        vm.expectRevert(TipJar.AmountTooLarge.selector);
+        jar.tip(tooBig, "whale");
+    }
+
+    function test_RevertWhen_AllowanceIsMissing() public {
+        address carol = makeAddr("carol");
+        token.mint(carol, 10e6);
+        vm.prank(carol);
+        vm.expectRevert();
+        jar.tip(1e6, "no approval");
+    }
+
+    function test_OwnerWithdraws() public {
+        vm.prank(alice);
+        jar.tip(100e6, "thanks");
+
+        vm.prank(owner);
+        jar.withdraw(bob, 40e6);
+
+        assertEq(token.balanceOf(bob), 1_040e6);
+        assertEq(jar.jarBalance(), 60e6);
+        // withdrawing does not rewrite history
+        assertEq(jar.totalTipped(), 100e6);
+        assertEq(jar.tipCount(), 1);
+    }
+
+    function test_RevertWhen_NonOwnerWithdraws() public {
+        vm.prank(alice);
+        jar.tip(100e6, "thanks");
+
+        vm.prank(alice);
+        vm.expectRevert(abi.encodeWithSelector(Ownable.OwnableUnauthorizedAccount.selector, alice));
+        jar.withdraw(alice, 1e6);
+    }
+
+    function test_RevertWhen_ConstructedWithZeroToken() public {
+        vm.expectRevert(TipJar.ZeroAddress.selector);
+        new TipJar(IERC20(address(0)), owner);
+    }
+
+    function testFuzz_TipAccumulates(uint96 first, uint96 second) public {
+        first = uint96(bound(first, 1, 1_000e6));
+        second = uint96(bound(second, 1, 1_000e6));
+
+        vm.prank(alice);
+        jar.tip(first, "a");
+        vm.prank(bob);
+        jar.tip(second, "b");
+
+        assertEq(jar.totalTipped(), uint256(first) + uint256(second));
+        assertEq(jar.jarBalance(), uint256(first) + uint256(second));
+    }
+}
diff --git a/packages/foundry/test/TipJarFork.t.sol b/packages/foundry/test/TipJarFork.t.sol
new file mode 100644
index 0000000..281f7e2
--- /dev/null
+++ b/packages/foundry/test/TipJarFork.t.sol
@@ -0,0 +1,81 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import { Test } from "forge-std/Test.sol";
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { TipJar } from "../contracts/TipJar.sol";
+
+interface IFiatToken {
+    function masterMinter() external view returns (address);
+    function configureMinter(address minter, uint256 minterAllowedAmount) external returns (bool);
+    function mint(address to, uint256 amount) external returns (bool);
+}
+
+/**
+ * @notice Exercises TipJar against the real Base USDC contract on a fork.
+ * @dev Opt-in: skipped unless BASE_RPC_URL is set, so the default `yarn test` stays offline.
+ *      Run with `yarn test:fork`.
+ *
+ *      Test identities are funded through USDC's own minter role (impersonating the on-chain
+ *      masterMinter) rather than by poking storage or by hunting for a whale that still holds a
+ *      balance. This is the same mechanism `yarn fund-usdc` uses against the local fork, so this
+ *      test is a check on the documented demo workflow as much as on the contract.
+ */
+contract TipJarForkTest is Test {
+    address constant BASE_USDC = 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913;
+
+    IFiatToken usdc = IFiatToken(BASE_USDC);
+    TipJar jar;
+
+    address owner = makeAddr("owner");
+    address alice = makeAddr("alice");
+
+    function setUp() public {
+        string memory rpcUrl = vm.envOr("BASE_RPC_URL", string(""));
+        if (bytes(rpcUrl).length == 0) {
+            vm.skip(true);
+            return;
+        }
+        vm.createSelectFork(rpcUrl);
+
+        jar = new TipJar(IERC20(BASE_USDC), owner);
+
+        address minter = makeAddr("minter");
+        vm.prank(usdc.masterMinter());
+        usdc.configureMinter(minter, 1_000_000e6);
+        vm.prank(minter);
+        usdc.mint(alice, 500e6);
+    }
+
+    function test_RealUsdcMovesIntoTheJar() public {
+        assertEq(block.chainid, 8453, "not forking Base");
+        assertEq(IERC20(BASE_USDC).balanceOf(alice), 500e6);
+
+        vm.startPrank(alice);
+        IERC20(BASE_USDC).approve(address(jar), 120e6);
+        jar.tip(120e6, "gm from a Base fork");
+        vm.stopPrank();
+
+        assertEq(IERC20(BASE_USDC).balanceOf(alice), 380e6);
+        assertEq(jar.jarBalance(), 120e6);
+        assertEq(IERC20(BASE_USDC).allowance(alice, address(jar)), 0);
+
+        TipJar.Tip[] memory page = jar.getTips(0, 1);
+        assertEq(page[0].sender, alice);
+        assertEq(page[0].amount, 120e6);
+        assertEq(page[0].message, "gm from a Base fork");
+    }
+
+    function test_OwnerWithdrawsRealUsdc() public {
+        vm.startPrank(alice);
+        IERC20(BASE_USDC).approve(address(jar), 200e6);
+        jar.tip(200e6, "for the docs");
+        vm.stopPrank();
+
+        vm.prank(owner);
+        jar.withdraw(owner, 200e6);
+
+        assertEq(IERC20(BASE_USDC).balanceOf(owner), 200e6);
+        assertEq(jar.jarBalance(), 0);
+    }
+}
