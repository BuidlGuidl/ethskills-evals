@@ -0,0 +1,110 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { SafeERC20 } from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+import { Ownable } from "@openzeppelin/contracts/access/Ownable.sol";
+
+/**
+ * @notice A tip jar that collects ERC-20 tips (USDC on Base) together with a short public message.
+ * @dev The feed is stored on-chain and served through {getTips} instead of only being emitted as
+ *      events. The frontend ships as a static bundle on IPFS with no indexer behind it, and public
+ *      RPCs cap `eth_getLogs` ranges, so a paginated `eth_call` is the only feed that keeps working
+ *      once the contract is more than a few days old.
+ *
+ *      `usdc` is fixed at construction. The accounting below records the requested `amount` rather
+ *      than a measured balance delta, which is correct for USDC and any other non-rebasing token
+ *      without a transfer fee. Do not point this contract at a fee-on-transfer token.
+ */
+contract TipJar is Ownable {
+    using SafeERC20 for IERC20;
+
+    struct Tip {
+        address sender;
+        uint96 amount;
+        uint64 timestamp;
+        string message;
+    }
+
+    /// @notice Upper bound on a tip message, in bytes, so a single tip cannot bloat {getTips} pages.
+    uint256 public constant MAX_MESSAGE_BYTES = 140;
+
+    /// @notice The token this jar accepts. Base USDC: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
+    IERC20 public immutable usdc;
+
+    /// @notice Sum of every tip ever recorded, in token units. Not reduced by {withdraw}.
+    uint256 public totalTipped;
+
+    Tip[] private tips;
+
+    event Tipped(address indexed sender, uint256 amount, string message, uint256 index);
+    event Withdrawn(address indexed to, uint256 amount);
+
+    error ZeroAmount();
+    error AmountTooLarge();
+    error MessageTooLong(uint256 length);
+    error ZeroAddress();
+
+    constructor(IERC20 _usdc, address initialOwner) Ownable(initialOwner) {
+        if (address(_usdc) == address(0)) revert ZeroAddress();
+        usdc = _usdc;
+    }
+
+    /**
+     * @notice Send a tip. The caller must have approved this contract for at least `amount` first.
+     * @param amount Tip size in token units (USDC has 6 decimals, so 1 USDC == 1_000_000).
+     * @param message Public note attached to the tip, up to {MAX_MESSAGE_BYTES} bytes.
+     */
+    function tip(uint256 amount, string calldata message) external {
+        if (amount == 0) revert ZeroAmount();
+        if (amount > type(uint96).max) revert AmountTooLarge();
+        if (bytes(message).length > MAX_MESSAGE_BYTES) revert MessageTooLong(bytes(message).length);
+
+        tips.push(
+            Tip({ sender: msg.sender, amount: uint96(amount), timestamp: uint64(block.timestamp), message: message })
+        );
+        totalTipped += amount;
+
+        emit Tipped(msg.sender, amount, message, tips.length - 1);
+
+        usdc.safeTransferFrom(msg.sender, address(this), amount);
+    }
+
+    /// @notice Move collected tips out of the jar.
+    function withdraw(address to, uint256 amount) external onlyOwner {
+        if (to == address(0)) revert ZeroAddress();
+        if (amount == 0) revert ZeroAmount();
+
+        emit Withdrawn(to, amount);
+
+        usdc.safeTransfer(to, amount);
+    }
+
+    /// @notice Number of tips in the feed.
+    function tipCount() external view returns (uint256) {
+        return tips.length;
+    }
+
+    /// @notice Current balance of the jar, in token units.
+    function jarBalance() external view returns (uint256) {
+        return usdc.balanceOf(address(this));
+    }
+
+    /**
+     * @notice One page of the tip feed, newest first.
+     * @param offset How many of the newest tips to skip.
+     * @param limit Maximum page size. Returns fewer entries at the end of the feed.
+     */
+    function getTips(uint256 offset, uint256 limit) external view returns (Tip[] memory page) {
+        uint256 total = tips.length;
+        if (offset >= total) return new Tip[](0);
+
+        uint256 remaining = total - offset;
+        uint256 size = remaining < limit ? remaining : limit;
+
+        page = new Tip[](size);
+        for (uint256 i = 0; i < size; i++) {
+            page[i] = tips[total - 1 - offset - i];
+        }
+    }
+}
