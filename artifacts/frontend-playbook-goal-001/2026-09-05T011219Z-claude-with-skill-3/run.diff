diff --git a/packages/nextjs/utils/usdc.ts b/packages/nextjs/utils/usdc.ts
new file mode 100644
index 0000000..5789474
--- /dev/null
+++ b/packages/nextjs/utils/usdc.ts
@@ -0,0 +1,21 @@
+import { formatUnits } from "viem";
+import { USDC_DECIMALS } from "~~/contracts/externalContracts";
+
+/** Two decimals for normal amounts, more for sub-cent ones so dust never renders as "0.00". */
+export const formatUsdc = (amount: bigint) =>
+  Number(formatUnits(amount, USDC_DECIMALS)).toLocaleString("en-US", {
+    minimumFractionDigits: 2,
+    maximumFractionDigits: amount > 0n && amount < 10_000n ? USDC_DECIMALS : 2,
+  });
+
+/** The contract limits messages in bytes, not characters — one emoji costs four. */
+export const messageByteLength = (message: string) => new TextEncoder().encode(message).length;
+
+/** Short "3m ago" style stamp. `now` is passed in so a list of tips shares one clock. */
+export const formatRelativeTime = (timestamp: bigint, now: number) => {
+  const seconds = Math.max(0, Math.floor(now / 1000) - Number(timestamp));
+  if (seconds < 60) return `${seconds}s ago`;
+  if (seconds < 3600) return `${Math.floor(seconds / 60)}m ago`;
+  if (seconds < 86400) return `${Math.floor(seconds / 3600)}h ago`;
+  return `${Math.floor(seconds / 86400)}d ago`;
+};

