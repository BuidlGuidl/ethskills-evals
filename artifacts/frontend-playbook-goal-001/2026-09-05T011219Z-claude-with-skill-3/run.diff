diff --git a/packages/foundry/scripts-js/fundUsdc.js b/packages/foundry/scripts-js/fundUsdc.js
new file mode 100644
index 0000000..17d3397
--- /dev/null
+++ b/packages/foundry/scripts-js/fundUsdc.js
@@ -0,0 +1,153 @@
+/**
+ * Fund a local test identity with real Base USDC, taken from a real holder on the fork.
+ *
+ *   yarn fund <address> [amountInUsdc]
+ *
+ * Nothing is broadcast: impersonation and balance overrides only exist inside the local
+ * Anvil fork, so the "real" USDC that moves is a local copy of Base state.
+ */
+const RPC_URL = process.env.RPC_URL || "http://127.0.0.1:8545";
+const USDC = "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913";
+const FORK_CHAIN_ID = 31337n;
+const GAS_TOP_UP = 10n * 10n ** 18n; // 10 ETH, enough for any local demo
+
+// Large USDC holders on Base. The first one still holding enough wins; override with WHALE=0x...
+const WHALE_CANDIDATES = [
+  "0x4e65fE4DbA92790696d040ac24Aa414708F5c0AB", // Aave v3 Base aUSDC
+  "0x20FE51A9229EEf2cF8Ad9E89d91CAb9312cF3b7A", // Coinbase custody
+  "0xcbB7C0000aB88B473b1f5aFd9ef808440eed33Bf", // cbBTC / Aerodrome liquidity
+];
+
+let requestId = 0;
+
+async function rpc(method, params = []) {
+  const response = await fetch(RPC_URL, {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify({ jsonrpc: "2.0", id: ++requestId, method, params }),
+  }).catch(() => {
+    throw new Error(`Cannot reach ${RPC_URL}. Start the fork first: yarn fork`);
+  });
+
+  if (!response.ok) {
+    throw new Error(
+      `${method} failed: ${RPC_URL} answered HTTP ${response.status} ${response.statusText}`
+    );
+  }
+
+  const { result, error } = await response.json();
+  if (error) throw new Error(`${method} failed: ${error.message}`);
+  return result;
+}
+
+const pad = (value) => value.replace(/^0x/, "").toLowerCase().padStart(64, "0");
+const toHex = (value) => `0x${value.toString(16)}`;
+
+const balanceOf = async (account) =>
+  BigInt(
+    await rpc("eth_call", [
+      { to: USDC, data: `0x70a08231${pad(account)}` },
+      "latest",
+    ])
+  );
+
+const formatUsdc = (units) =>
+  `${(Number(units) / 1e6).toLocaleString("en-US", {
+    maximumFractionDigits: 6,
+  })} USDC`;
+
+function parseUsdc(amount) {
+  if (!/^\d+(\.\d{1,6})?$/.test(amount)) {
+    throw new Error(
+      `Invalid amount "${amount}". Use a number with at most 6 decimals, e.g. 250 or 12.5`
+    );
+  }
+  const [whole, fraction = ""] = amount.split(".");
+  return BigInt(whole + fraction.padEnd(6, "0"));
+}
+
+async function main() {
+  const [recipient, amountArg = "500"] = process.argv.slice(2);
+
+  if (!recipient || !/^0x[0-9a-fA-F]{40}$/.test(recipient)) {
+    throw new Error("Usage: yarn fund <address> [amountInUsdc]");
+  }
+  const amount = parseUsdc(amountArg);
+
+  const chainId = BigInt(await rpc("eth_chainId"));
+  if (chainId !== FORK_CHAIN_ID) {
+    throw new Error(
+      `Expected the local fork (chain id ${FORK_CHAIN_ID}), got ${chainId}. Run: yarn fork`
+    );
+  }
+  if ((await rpc("eth_getCode", [USDC, "latest"])) === "0x") {
+    throw new Error(
+      "No USDC code at the Base USDC address. This chain is not a Base fork — run: yarn fork"
+    );
+  }
+
+  let whale = process.env.WHALE;
+  if (whale) {
+    const held = await balanceOf(whale);
+    if (held < amount)
+      throw new Error(`WHALE ${whale} only holds ${formatUsdc(held)}`);
+  } else {
+    for (const candidate of WHALE_CANDIDATES) {
+      if ((await balanceOf(candidate)) >= amount) {
+        whale = candidate;
+        break;
+      }
+    }
+    if (!whale) {
+      throw new Error(
+        `None of the known holders still has ${formatUsdc(
+          amount
+        )} at this fork block.\n` +
+          "Pick any current holder from https://basescan.org/token/tokenholderchart/" +
+          `${USDC} and rerun with WHALE=0x... yarn fund ${recipient} ${amountArg}`
+      );
+    }
+  }
+
+  await rpc("anvil_setBalance", [whale, toHex(GAS_TOP_UP)]);
+  await rpc("anvil_impersonateAccount", [whale]);
+  const txHash = await rpc("eth_sendTransaction", [
+    {
+      from: whale,
+      to: USDC,
+      data: `0xa9059cbb${pad(recipient)}${pad(toHex(amount))}`,
+    },
+  ]);
+  await rpc("anvil_stopImpersonatingAccount", [whale]);
+
+  let receipt = null;
+  for (let attempt = 0; attempt < 30 && !receipt; attempt++) {
+    receipt = await rpc("eth_getTransactionReceipt", [txHash]);
+    if (!receipt) await new Promise((resolve) => setTimeout(resolve, 300));
+  }
+  if (!receipt)
+    throw new Error(
+      `Transfer ${txHash} was not mined. Is the fork still running?`
+    );
+  if (receipt.status !== "0x1") throw new Error(`Transfer ${txHash} reverted`);
+
+  // Gas money, so a fresh browser/burner account can actually send the tip.
+  if (BigInt(await rpc("eth_getBalance", [recipient, "latest"])) < GAS_TOP_UP) {
+    await rpc("anvil_setBalance", [recipient, toHex(GAS_TOP_UP)]);
+  }
+
+  console.log(`Funded ${recipient} with ${formatUsdc(amount)} from ${whale}`);
+  console.log(`  USDC balance: ${formatUsdc(await balanceOf(recipient))}`);
+  console.log(
+    `  ETH balance:  ${
+      Number(
+        BigInt(await rpc("eth_getBalance", [recipient, "latest"])) / 10n ** 15n
+      ) / 1000
+    } ETH`
+  );
+}
+
+main().catch((error) => {
+  console.error(`\n${error.message}\n`);
+  process.exit(1);
+});
diff --git a/packages/foundry/test/TipJar.t.sol b/packages/foundry/test/TipJar.t.sol
new file mode 100644
index 0000000..358281b
--- /dev/null
+++ b/packages/foundry/test/TipJar.t.sol
@@ -0,0 +1,205 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.19;
+
+import { Test } from "forge-std/Test.sol";
+import { ERC20 } from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { IERC20Errors } from "@openzeppelin/contracts/interfaces/draft-IERC6093.sol";
+import { Ownable } from "@openzeppelin/contracts/access/Ownable.sol";
+import { TipJar } from "../contracts/TipJar.sol";
+
+contract MockUSDC is ERC20 {
+    constructor() ERC20("USD Coin", "USDC") { }
+
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    function mint(address to, uint256 amount) external {
+        _mint(to, amount);
+    }
+}
+
+contract TipJarTest is Test {
+    uint256 internal constant MIN_TIP = 0.01e6;
+
+    MockUSDC internal usdc;
+    TipJar internal jar;
+
+    address internal owner = makeAddr("owner");
+    address internal alice = makeAddr("alice");
+    address internal bob = makeAddr("bob");
+
+    event TipReceived(address indexed sender, uint256 amount, string message, uint256 index);
+    event Withdrawn(address indexed to, uint256 amount);
+
+    function setUp() public {
+        usdc = new MockUSDC();
+        jar = new TipJar(IERC20(address(usdc)), MIN_TIP, owner);
+
+        usdc.mint(alice, 1000e6);
+        usdc.mint(bob, 1000e6);
+        vm.prank(alice);
+        usdc.approve(address(jar), type(uint256).max);
+        vm.prank(bob);
+        usdc.approve(address(jar), type(uint256).max);
+    }
+
+    function test_TipMovesTokensAndRecordsFeed() public {
+        vm.expectEmit(true, false, false, true, address(jar));
+        emit TipReceived(alice, 5e6, "gm", 0);
+
+        vm.prank(alice);
+        jar.tip(5e6, "gm");
+
+        assertEq(usdc.balanceOf(address(jar)), 5e6);
+        assertEq(usdc.balanceOf(alice), 995e6);
+        assertEq(jar.totalTipped(), 5e6);
+        assertEq(jar.totalTippedBy(alice), 5e6);
+        assertEq(jar.tipCount(), 1);
+
+        TipJar.Tip[] memory tips = jar.getTips(0, 10);
+        assertEq(tips.length, 1);
+        assertEq(tips[0].sender, alice);
+        assertEq(tips[0].amount, 5e6);
+        assertEq(tips[0].message, "gm");
+        assertEq(tips[0].timestamp, uint64(block.timestamp));
+    }
+
+    function test_RecentTipsAreNewestFirstAndCapped() public {
+        vm.prank(alice);
+        jar.tip(1e6, "first");
+        vm.prank(bob);
+        jar.tip(2e6, "second");
+        vm.prank(alice);
+        jar.tip(3e6, "third");
+
+        TipJar.Tip[] memory recent = jar.getTips(0, 2);
+        assertEq(recent.length, 2);
+        assertEq(recent[0].message, "third");
+        assertEq(recent[1].message, "second");
+
+        // Asking for more than exists returns everything, without reverting.
+        assertEq(jar.getTips(0, 100).length, 3);
+        assertEq(jar.totalTipped(), 6e6);
+        assertEq(jar.totalTippedBy(alice), 4e6);
+    }
+
+    function test_RevertWhen_TipIsBelowMinimum() public {
+        vm.startPrank(alice);
+        vm.expectRevert(abi.encodeWithSelector(TipJar.TipTooSmall.selector, 0, MIN_TIP));
+        jar.tip(0, "free");
+
+        vm.expectRevert(abi.encodeWithSelector(TipJar.TipTooSmall.selector, 1, MIN_TIP));
+        jar.tip(1, "dust");
+        vm.stopPrank();
+
+        // Exactly the minimum is fine.
+        vm.prank(alice);
+        jar.tip(MIN_TIP, "smallest allowed");
+        assertEq(jar.tipCount(), 1);
+    }
+
+    function test_PagesThroughOlderTips() public {
+        for (uint256 i = 0; i < 5; i++) {
+            vm.prank(alice);
+            jar.tip(1e6 + i, string.concat("tip ", vm.toString(i)));
+        }
+
+        TipJar.Tip[] memory secondPage = jar.getTips(2, 2);
+        assertEq(secondPage.length, 2);
+        assertEq(secondPage[0].message, "tip 2");
+        assertEq(secondPage[1].message, "tip 1");
+
+        // A page starting past the end is empty, not a revert.
+        assertEq(jar.getTips(5, 10).length, 0);
+        assertEq(jar.getTips(4, 10).length, 1);
+    }
+
+    function test_OwnershipTransferIsTwoStep() public {
+        vm.prank(owner);
+        jar.transferOwnership(alice);
+        assertEq(jar.owner(), owner, "owner changes only on acceptance");
+
+        vm.prank(alice);
+        jar.acceptOwnership();
+        assertEq(jar.owner(), alice);
+    }
+
+    function test_RevertWhen_RenouncingOwnership() public {
+        vm.prank(owner);
+        vm.expectRevert(TipJar.OwnershipCannotBeRenounced.selector);
+        jar.renounceOwnership();
+    }
+
+    function test_RevertWhen_MessageTooLong() public {
+        string memory long = new string(141);
+        vm.prank(alice);
+        vm.expectRevert(abi.encodeWithSelector(TipJar.MessageTooLong.selector, 141));
+        jar.tip(1e6, long);
+    }
+
+    function test_RevertWhen_TipperDidNotApprove() public {
+        address carol = makeAddr("carol");
+        usdc.mint(carol, 10e6);
+
+        vm.prank(carol);
+        vm.expectRevert(abi.encodeWithSelector(IERC20Errors.ERC20InsufficientAllowance.selector, address(jar), 0, 1e6));
+        jar.tip(1e6, "no approval");
+    }
+
+    function test_OwnerWithdrawsEverything() public {
+        vm.prank(alice);
+        jar.tip(7e6, "thanks");
+
+        vm.expectEmit(true, false, false, true, address(jar));
+        emit Withdrawn(bob, 7e6);
+
+        vm.prank(owner);
+        jar.withdraw(bob);
+
+        assertEq(usdc.balanceOf(address(jar)), 0);
+        assertEq(usdc.balanceOf(bob), 1007e6);
+        // The feed is history, not a balance: it survives the withdrawal.
+        assertEq(jar.tipCount(), 1);
+        assertEq(jar.totalTipped(), 7e6);
+    }
+
+    function test_RevertWhen_NonOwnerWithdraws() public {
+        vm.prank(alice);
+        jar.tip(1e6, "hi");
+
+        vm.prank(alice);
+        vm.expectRevert(abi.encodeWithSelector(Ownable.OwnableUnauthorizedAccount.selector, alice));
+        jar.withdraw(alice);
+    }
+
+    function test_RevertWhen_WithdrawingEmptyJar() public {
+        vm.prank(owner);
+        vm.expectRevert(TipJar.NothingToWithdraw.selector);
+        jar.withdraw(owner);
+    }
+
+    function test_RevertWhen_WithdrawingToZeroAddress() public {
+        vm.prank(alice);
+        jar.tip(1e6, "hi");
+
+        vm.prank(owner);
+        vm.expectRevert(TipJar.InvalidRecipient.selector);
+        jar.withdraw(address(0));
+    }
+
+    function testFuzz_TipAccumulates(uint96 first, uint96 second) public {
+        vm.assume(first >= MIN_TIP && second >= MIN_TIP);
+        uint256 total = uint256(first) + second;
+        usdc.mint(alice, total);
+
+        vm.startPrank(alice);
+        jar.tip(first, "a");
+        jar.tip(second, "b");
+        vm.stopPrank();
+
+        assertEq(usdc.balanceOf(address(jar)), total);
+        assertEq(jar.totalTippedBy(alice), total);
+    }
+}
diff --git a/packages/foundry/test/TipJarFork.t.sol b/packages/foundry/test/TipJarFork.t.sol
new file mode 100644
index 0000000..b0248df
--- /dev/null
+++ b/packages/foundry/test/TipJarFork.t.sol
@@ -0,0 +1,77 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.19;
+
+import { Test, console } from "forge-std/Test.sol";
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { IERC20Metadata } from "@openzeppelin/contracts/token/ERC20/extensions/IERC20Metadata.sol";
+import { TipJar } from "../contracts/TipJar.sol";
+import { DeployTipJar } from "../script/DeployTipJar.s.sol";
+
+/**
+ * @notice Exercises the jar against the real Base USDC contract, the same way the local demo does:
+ *         fund a test identity from an existing holder, approve, tip.
+ * @dev Skips itself when the Base RPC is unreachable, so `yarn test` stays green offline.
+ */
+contract TipJarForkTest is Test {
+    IERC20Metadata internal constant USDC = IERC20Metadata(0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913);
+    /// @dev Aave v3 Base aUSDC holds the pool's USDC. Any large holder works.
+    address internal constant WHALE = 0x4e65fE4DbA92790696d040ac24Aa414708F5c0AB;
+    uint256 internal constant FUNDING = 100e6;
+
+    TipJar internal jar;
+    address internal owner = makeAddr("owner");
+    address internal tipper = makeAddr("tipper");
+    bool internal forked;
+
+    function setUp() public {
+        try vm.createFork("base") returns (uint256 forkId) {
+            vm.selectFork(forkId);
+        } catch {
+            console.log("Fork tests skipped: the Base RPC is unreachable.");
+            return;
+        }
+
+        // The whale is live state and can move. Skip loudly instead of failing the suite on it.
+        if (USDC.balanceOf(WHALE) < FUNDING) {
+            console.log("Fork tests skipped: whale no longer holds enough USDC. Pick another holder.");
+            return;
+        }
+
+        jar = new TipJar(USDC, 0.01e6, owner);
+
+        vm.prank(WHALE);
+        USDC.transfer(tipper, FUNDING);
+        forked = true;
+    }
+
+    function test_TipRealUsdcOnBaseFork() public {
+        if (!forked) return vm.skip(true);
+
+        assertEq(USDC.symbol(), "USDC");
+        assertEq(USDC.decimals(), 6);
+        assertEq(USDC.balanceOf(tipper), FUNDING);
+
+        vm.startPrank(tipper);
+        USDC.approve(address(jar), 25e6);
+        jar.tip(25e6, "real USDC, fake money");
+        vm.stopPrank();
+
+        assertEq(USDC.balanceOf(address(jar)), 25e6);
+        assertEq(USDC.balanceOf(tipper), 75e6);
+
+        TipJar.Tip[] memory tips = jar.getTips(0, 1);
+        assertEq(tips[0].sender, tipper);
+        assertEq(tips[0].amount, 25e6);
+
+        vm.prank(owner);
+        jar.withdraw(owner);
+        assertEq(USDC.balanceOf(owner), 25e6);
+    }
+
+    function test_DeployScriptPicksRealUsdc() public {
+        if (!forked) return vm.skip(true);
+
+        assertEq(address(USDC), new DeployTipJar().BASE_USDC());
+        assertGt(address(USDC).code.length, 0);
+    }
+}
