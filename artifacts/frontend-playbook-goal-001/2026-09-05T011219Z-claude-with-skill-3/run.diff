diff --git a/packages/nextjs/app/_components/TipFeed.tsx b/packages/nextjs/app/_components/TipFeed.tsx
new file mode 100644
index 0000000..c0b6c58
--- /dev/null
+++ b/packages/nextjs/app/_components/TipFeed.tsx
@@ -0,0 +1,66 @@
+"use client";
+
+import { useEffect, useState } from "react";
+import { Address } from "@scaffold-ui/components";
+import { useScaffoldReadContract, useTargetNetwork } from "~~/hooks/scaffold-eth";
+import { formatRelativeTime, formatUsdc } from "~~/utils/usdc";
+
+const FEED_SIZE = 25n;
+
+export const TipFeed = () => {
+  const { targetNetwork } = useTargetNetwork();
+  const [now, setNow] = useState(() => Date.now());
+
+  useEffect(() => {
+    const interval = setInterval(() => setNow(Date.now()), 10_000);
+    return () => clearInterval(interval);
+  }, []);
+
+  const {
+    data: tips,
+    isLoading,
+    isError,
+  } = useScaffoldReadContract({
+    contractName: "TipJar",
+    functionName: "getTips",
+    args: [0n, FEED_SIZE],
+  });
+
+  return (
+    <div className="card bg-base-100 shadow-xl w-full">
+      <div className="card-body gap-4">
+        <h2 className="card-title">Recent tips</h2>
+
+        {isError ? (
+          <div className="alert alert-error">
+            <span>Could not reach the jar. Is your local chain still running?</span>
+          </div>
+        ) : isLoading && !tips ? (
+          <div className="flex flex-col gap-3">
+            {[0, 1, 2].map(row => (
+              <div key={row} className="skeleton h-16 w-full" />
+            ))}
+          </div>
+        ) : tips?.length ? (
+          <ul className="flex flex-col gap-3">
+            {tips.map((tip, index) => (
+              <li
+                key={`${tip.sender}-${tip.timestamp}-${index}`}
+                className="flex flex-col gap-2 rounded-box bg-base-200 p-4"
+              >
+                <div className="flex items-center justify-between gap-2 flex-wrap">
+                  <Address address={tip.sender} chain={targetNetwork} size="sm" />
+                  <span className="badge badge-primary badge-lg font-bold">${formatUsdc(tip.amount)}</span>
+                </div>
+                {tip.message && <p className="m-0 break-words">{tip.message}</p>}
+                <span className="text-xs opacity-60">{formatRelativeTime(tip.timestamp, now)}</span>
+              </li>
+            ))}
+          </ul>
+        ) : (
+          <p className="m-0 opacity-70">No tips yet. Be the first one.</p>
+        )}
+      </div>
+    </div>
+  );
+};
diff --git a/packages/nextjs/app/_components/TipForm.tsx b/packages/nextjs/app/_components/TipForm.tsx
new file mode 100644
index 0000000..9a4d326
--- /dev/null
+++ b/packages/nextjs/app/_components/TipForm.tsx
@@ -0,0 +1,165 @@
+"use client";
+
+import { useMemo, useState } from "react";
+import { BaseInput } from "@scaffold-ui/components";
+import { parseUnits } from "viem";
+import { useAccount } from "wagmi";
+import { USDC_DECIMALS } from "~~/contracts/externalContracts";
+import { useDeployedContractInfo, useScaffoldReadContract, useScaffoldWriteContract } from "~~/hooks/scaffold-eth";
+import { notification } from "~~/utils/scaffold-eth";
+import { formatUsdc, messageByteLength } from "~~/utils/usdc";
+
+const QUICK_AMOUNTS = ["1", "5", "25"];
+
+export const TipForm = () => {
+  const [amount, setAmount] = useState("");
+  const [message, setMessage] = useState("");
+
+  const { address: connectedAddress } = useAccount();
+  const { data: tipJar } = useDeployedContractInfo({ contractName: "TipJar" });
+
+  const { data: maxMessageLength } = useScaffoldReadContract({
+    contractName: "TipJar",
+    functionName: "MAX_MESSAGE_LENGTH",
+  });
+  const { data: minTipAmount } = useScaffoldReadContract({ contractName: "TipJar", functionName: "minTipAmount" });
+  const { data: balance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "balanceOf",
+    args: [connectedAddress],
+  });
+  const { data: allowance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "allowance",
+    args: [connectedAddress, tipJar?.address],
+  });
+
+  const { writeContractAsync: writeUsdc, isMining: isApproving } = useScaffoldWriteContract({ contractName: "USDC" });
+  const { writeContractAsync: writeTipJar, isMining: isTipping } = useScaffoldWriteContract({
+    contractName: "TipJar",
+  });
+
+  const parsedAmount = useMemo(() => {
+    if (!amount) return undefined;
+    try {
+      const parsed = parseUnits(amount, USDC_DECIMALS);
+      return parsed > 0n ? parsed : undefined;
+    } catch {
+      return undefined;
+    }
+  }, [amount]);
+
+  const messageBytes = messageByteLength(message);
+  const messageLimit = Number(maxMessageLength ?? 140n);
+  const isMessageTooLong = messageBytes > messageLimit;
+  // An undefined allowance means the read has not landed yet, not that no approval is needed.
+  const isAllowanceLoading = Boolean(connectedAddress) && Boolean(tipJar) && allowance === undefined;
+  const needsApproval = parsedAmount !== undefined && allowance !== undefined && allowance < parsedAmount;
+  const isBusy = isApproving || isTipping;
+
+  const sendTip = async () => {
+    if (!parsedAmount) {
+      return notification.error("Enter a tip amount above 0");
+    }
+    if (minTipAmount !== undefined && parsedAmount < minTipAmount) {
+      return notification.error(`The smallest tip this jar accepts is ${formatUsdc(minTipAmount)} USDC`);
+    }
+    if (balance !== undefined && parsedAmount > balance) {
+      return notification.error(`You only have ${formatUsdc(balance)} USDC`);
+    }
+    if (isMessageTooLong) {
+      return notification.error(`Your message is ${messageBytes} bytes; the limit is ${messageLimit}`);
+    }
+    if (!tipJar) {
+      return notification.error("TipJar is not deployed on this network. Did you run `yarn deploy`?");
+    }
+
+    try {
+      if (needsApproval) {
+        await writeUsdc({ functionName: "approve", args: [tipJar.address, parsedAmount] });
+      }
+      await writeTipJar({ functionName: "tip", args: [parsedAmount, message] });
+      setAmount("");
+      setMessage("");
+    } catch (error) {
+      // useScaffoldWriteContract already surfaces the reason as a notification.
+      console.error("Tip failed:", error);
+    }
+  };
+
+  return (
+    <div className="card bg-base-100 shadow-xl w-full">
+      <div className="card-body gap-4">
+        <div className="flex items-baseline justify-between gap-2 flex-wrap">
+          <h2 className="card-title m-0">Send a tip</h2>
+          {connectedAddress && (
+            <span className="text-sm opacity-70">
+              Balance: {balance === undefined ? "…" : `${formatUsdc(balance)} USDC`}
+            </span>
+          )}
+        </div>
+
+        <div className="flex flex-col gap-2">
+          <BaseInput
+            name="amount"
+            value={amount}
+            onChange={setAmount}
+            placeholder="0.00"
+            prefix={<span className="pl-4 text-accent self-center">$</span>}
+            suffix={<span className="pr-4 self-center opacity-60">USDC</span>}
+            error={amount !== "" && parsedAmount === undefined}
+            disabled={isBusy}
+          />
+          <div className="flex gap-2 items-center">
+            {QUICK_AMOUNTS.map(quickAmount => (
+              <button
+                key={quickAmount}
+                type="button"
+                className="btn btn-xs btn-outline"
+                onClick={() => setAmount(quickAmount)}
+                disabled={isBusy}
+              >
+                ${quickAmount}
+              </button>
+            ))}
+            {minTipAmount !== undefined && <span className="text-xs opacity-60">min ${formatUsdc(minTipAmount)}</span>}
+          </div>
+        </div>
+
+        <div className="flex flex-col gap-1">
+          <textarea
+            className={`textarea textarea-bordered w-full ${isMessageTooLong ? "textarea-error" : ""}`}
+            placeholder="Say something nice (optional)"
+            value={message}
+            onChange={event => setMessage(event.target.value)}
+            disabled={isBusy}
+          />
+          <span className={`text-xs self-end ${isMessageTooLong ? "text-error" : "opacity-60"}`}>
+            {messageBytes}/{messageLimit} bytes
+          </span>
+        </div>
+
+        <button
+          className="btn btn-primary"
+          onClick={sendTip}
+          disabled={!connectedAddress || isBusy || isAllowanceLoading || isMessageTooLong}
+        >
+          {isBusy && <span className="loading loading-spinner loading-sm" />}
+          {!connectedAddress
+            ? "Connect a wallet to tip"
+            : isApproving
+              ? "Approving USDC…"
+              : isTipping
+                ? "Sending tip…"
+                : needsApproval
+                  ? "Approve & send tip"
+                  : "Send tip"}
+        </button>
+
+        <p className="m-0 text-xs opacity-60">
+          Each tip spends its USDC approval exactly, so sending one is always two transactions: approve, then tip.
+        </p>
+      </div>
+    </div>
+  );
+};
