@@ -0,0 +1,114 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { SafeERC20 } from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+import { SafeCast } from "@openzeppelin/contracts/utils/math/SafeCast.sol";
+import { Ownable, Ownable2Step } from "@openzeppelin/contracts/access/Ownable2Step.sol";
+
+/**
+ * @title TipJar
+ * @notice Collects ERC-20 tips (USDC on Base) with a short public message, and keeps the
+ *         feed on-chain so a frontend can render it with a single `eth_call` — no log
+ *         indexing over millions of pre-fork blocks.
+ * @dev Assumes a plain, non-rebasing, non fee-on-transfer token: the amount pulled in is
+ *      the amount recorded. That holds for USDC.
+ */
+contract TipJar is Ownable2Step {
+    using SafeERC20 for IERC20;
+    using SafeCast for uint256;
+
+    struct Tip {
+        address sender;
+        uint64 timestamp;
+        uint128 amount;
+        string message;
+    }
+
+    /// @notice Message limit in bytes, not characters — one emoji costs 4.
+    uint256 public constant MAX_MESSAGE_LENGTH = 140;
+
+    /// @notice Floor on a tip, so the public feed cannot be buried under dust for free.
+    uint256 public immutable minTipAmount;
+
+    IERC20 public immutable token;
+
+    Tip[] private _tips;
+
+    /// @notice Lifetime amount tipped, per sender. Withdrawals do not reduce it.
+    mapping(address sender => uint256 total) public totalTippedBy;
+
+    /// @notice Lifetime amount tipped by everyone. Withdrawals do not reduce it.
+    uint256 public totalTipped;
+
+    error TipTooSmall(uint256 amount, uint256 minimum);
+    error MessageTooLong(uint256 length);
+    error NothingToWithdraw();
+    error InvalidRecipient();
+    error OwnershipCannotBeRenounced();
+
+    event TipReceived(address indexed sender, uint256 amount, string message, uint256 index);
+    event Withdrawn(address indexed to, uint256 amount);
+
+    constructor(IERC20 _token, uint256 _minTipAmount, address initialOwner) Ownable(initialOwner) {
+        token = _token;
+        minTipAmount = _minTipAmount;
+    }
+
+    /// @notice Pull `amount` of `token` from the caller, who must have approved this contract first.
+    function tip(uint256 amount, string calldata message) external {
+        if (amount < minTipAmount) revert TipTooSmall(amount, minTipAmount);
+        if (bytes(message).length > MAX_MESSAGE_LENGTH) revert MessageTooLong(bytes(message).length);
+
+        uint256 index = _tips.length;
+        _tips.push(
+            Tip({
+                sender: msg.sender, timestamp: uint64(block.timestamp), amount: amount.toUint128(), message: message
+            })
+        );
+        totalTippedBy[msg.sender] += amount;
+        totalTipped += amount;
+
+        token.safeTransferFrom(msg.sender, address(this), amount);
+
+        emit TipReceived(msg.sender, amount, message, index);
+    }
+
+    /// @notice Send the whole balance to `to`.
+    function withdraw(address to) external onlyOwner {
+        if (to == address(0)) revert InvalidRecipient();
+
+        uint256 balance = token.balanceOf(address(this));
+        if (balance == 0) revert NothingToWithdraw();
+
+        token.safeTransfer(to, balance);
+        emit Withdrawn(to, balance);
+    }
+
+    /// @dev The owner is the only withdrawal path, so renouncing would strand every future tip.
+    function renounceOwnership() public view override onlyOwner {
+        revert OwnershipCannotBeRenounced();
+    }
+
+    function tipCount() external view returns (uint256) {
+        return _tips.length;
+    }
+
+    /**
+     * @notice A page of the feed, newest first.
+     * @param offset How many of the newest tips to skip (0 starts at the newest).
+     * @param limit Maximum number of tips to return; the page is clamped to what exists.
+     */
+    function getTips(uint256 offset, uint256 limit) external view returns (Tip[] memory page) {
+        uint256 total = _tips.length;
+        if (offset >= total) return new Tip[](0);
+
+        uint256 remaining = total - offset;
+        uint256 count = limit < remaining ? limit : remaining;
+
+        page = new Tip[](count);
+        for (uint256 i = 0; i < count; i++) {
+            page[i] = _tips[total - 1 - offset - i];
+        }
+    }
+}
