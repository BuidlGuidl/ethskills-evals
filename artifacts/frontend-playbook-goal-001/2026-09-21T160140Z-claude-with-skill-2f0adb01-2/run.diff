new file mode 100644
index 0000000..1fc985c
--- /dev/null
+++ b/packages/nextjs/app/_components/TipFeed.tsx
@@ -0,0 +1,53 @@
+"use client";
+
+import { Address } from "@scaffold-ui/components";
+import { useDeployedContractInfo, useScaffoldEventHistory, useTargetNetwork } from "~~/hooks/scaffold-eth";
+import { formatUsdc } from "~~/utils/formatUsdc";
+
+export const TipFeed = () => {
+  const { targetNetwork } = useTargetNetwork();
+  const { data: tipJar, isLoading: isTipJarLoading } = useDeployedContractInfo({ contractName: "TipJar" });
+  const {
+    data: tips,
+    isLoading,
+    error,
+  } = useScaffoldEventHistory({
+    contractName: "TipJar",
+    eventName: "Tip",
+    watch: true,
+  });
+
+  // The hook mixes live and historical pages; show newest first
+  const sortedTips = [...(tips ?? [])].sort((a, b) =>
+    a.blockNumber === b.blockNumber ? b.logIndex - a.logIndex : Number(b.blockNumber - a.blockNumber),
+  );
+
+  return (
+    <div className="card bg-base-100 shadow-xl w-full">
+      <div className="card-body">
+        <h2 className="card-title">Tip feed</h2>
+        {!isTipJarLoading && !tipJar ? (
+          <p className="text-error">TipJar is not deployed on {targetNetwork.name}.</p>
+        ) : isLoading || isTipJarLoading ? (
+          <span className="loading loading-dots loading-md" />
+        ) : error ? (
+          <p className="text-error">Could not load tips.</p>
+        ) : !sortedTips.length ? (
+          <p className="opacity-70">No tips yet — be the first!</p>
+        ) : (
+          <ul className="flex flex-col divide-y divide-base-300">
+            {sortedTips.map(tip => (
+              <li key={`${tip.transactionHash}-${tip.logIndex}`} className="py-3 flex flex-col gap-1">
+                <div className="flex flex-wrap items-center justify-between gap-2">
+                  <Address address={tip.args.tipper} chain={targetNetwork} size="sm" />
+                  <span className="badge badge-primary">{formatUsdc(tip.args.amount ?? 0n)} USDC</span>
+                </div>
+                {tip.args.message && <p className="m-0 break-words">{tip.args.message}</p>}
+              </li>
+            ))}
+          </ul>
+        )}
+      </div>
+    </div>
+  );
+};
diff --git a/packages/nextjs/app/_components/TipForm.tsx b/packages/nextjs/app/_components/TipForm.tsx
new file mode 100644
index 0000000..eccd343
--- /dev/null
+++ b/packages/nextjs/app/_components/TipForm.tsx
@@ -0,0 +1,142 @@
+"use client";
+
+import { useState } from "react";
+import { parseUnits } from "viem";
+import { useAccount } from "wagmi";
+import { useDeployedContractInfo, useScaffoldReadContract, useScaffoldWriteContract } from "~~/hooks/scaffold-eth";
+import { formatUsdc } from "~~/utils/formatUsdc";
+
+// Must match TipJar.MAX_MESSAGE_LENGTH, which counts UTF-8 bytes
+const MAX_MESSAGE_BYTES = 280;
+const USDC_AMOUNT_REGEX = /^\d+(\.\d{0,6})?$|^\.\d{1,6}$/;
+
+const parseAmount = (value: string) => {
+  if (!USDC_AMOUNT_REGEX.test(value)) return undefined;
+  const amount = parseUnits(value, 6);
+  return amount > 0n ? amount : undefined;
+};
+
+export const TipForm = () => {
+  const { address } = useAccount();
+  const [amountInput, setAmountInput] = useState("");
+  const [message, setMessage] = useState("");
+
+  const { data: tipJar } = useDeployedContractInfo({ contractName: "TipJar" });
+
+  const { data: balance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "balanceOf",
+    args: [address],
+    query: { enabled: Boolean(address) },
+  });
+  const { data: allowance, refetch: refetchAllowance } = useScaffoldReadContract({
+    contractName: "USDC",
+    functionName: "allowance",
+    args: [address, tipJar?.address],
+    query: { enabled: Boolean(address && tipJar) },
+  });
+
+  // isPending covers wallet signing, isMining covers waiting for the receipt
+  const {
+    writeContractAsync: writeUsdc,
+    isPending: isApprovePending,
+    isMining: isApproveMining,
+  } = useScaffoldWriteContract({ contractName: "USDC" });
+  const {
+    writeContractAsync: writeTipJar,
+    isPending: isTipPending,
+    isMining: isTipMining,
+  } = useScaffoldWriteContract({ contractName: "TipJar" });
+
+  const isApproving = isApprovePending || isApproveMining;
+  const isTipping = isTipPending || isTipMining;
+
+  const amount = parseAmount(amountInput);
+  const messageBytes = new TextEncoder().encode(message).length;
+  const isMessageTooLong = messageBytes > MAX_MESSAGE_BYTES;
+  const hasEnoughBalance = amount !== undefined && balance !== undefined && balance >= amount;
+  const needsApproval = amount !== undefined && allowance !== undefined && allowance < amount;
+  const canSubmit =
+    Boolean(address) && hasEnoughBalance && allowance !== undefined && !isMessageTooLong && !isApproving && !isTipping;
+
+  const approve = async () => {
+    if (!amount || !tipJar) return;
+    try {
+      // Exact amount only: the tip jar never gets a standing allowance
+      const hash = await writeUsdc({ functionName: "approve", args: [tipJar.address, amount] });
+      if (hash) await refetchAllowance();
+    } catch (e) {
+      console.error("Approve failed", e);
+    }
+  };
+
+  const sendTip = async () => {
+    if (!amount) return;
+    try {
+      // Resolves undefined without sending (wrong network, no wallet): keep the form in that case
+      const hash = await writeTipJar({ functionName: "tip", args: [amount, message] });
+      if (!hash) return;
+      setAmountInput("");
+      setMessage("");
+      await refetchAllowance();
+    } catch (e) {
+      console.error("Tip failed", e);
+    }
+  };
+
+  return (
+    <div className="card bg-base-100 shadow-xl w-full">
+      <div className="card-body gap-4">
+        <h2 className="card-title">Send a tip</h2>
+
+        <label className="form-control w-full">
+          <span className="label-text mb-1">Amount (USDC)</span>
+          <input
+            className="input input-bordered w-full"
+            inputMode="decimal"
+            placeholder="5.00"
+            value={amountInput}
+            onChange={e => setAmountInput(e.target.value.trim())}
+          />
+          <span className="label-text-alt mt-1 opacity-70">
+            {address ? `Balance: ${balance === undefined ? "…" : formatUsdc(balance)} USDC` : "Connect a wallet to tip"}
+          </span>
+        </label>
+
+        <label className="form-control w-full">
+          <span className="label-text mb-1">Message (optional)</span>
+          <textarea
+            className="textarea textarea-bordered w-full"
+            placeholder="Thanks for the great work!"
+            value={message}
+            onChange={e => setMessage(e.target.value)}
+          />
+          <span className={`label-text-alt mt-1 ${isMessageTooLong ? "text-error" : "opacity-70"}`}>
+            {messageBytes}/{MAX_MESSAGE_BYTES} bytes
+          </span>
+        </label>
+
+        {amountInput && !amount && (
+          <p className="text-error text-sm m-0">Enter a positive USDC amount with at most 6 decimals.</p>
+        )}
+        {amount !== undefined && balance !== undefined && !hasEnoughBalance && (
+          <p className="text-error text-sm m-0">Not enough USDC.</p>
+        )}
+
+        <div className="card-actions justify-end">
+          {needsApproval ? (
+            <button className="btn btn-primary" disabled={!canSubmit} onClick={approve}>
+              {isApproving && <span className="loading loading-spinner loading-sm" />}
+              Approve {amount !== undefined ? formatUsdc(amount) : ""} USDC
+            </button>
+          ) : (
+            <button className="btn btn-primary" disabled={!canSubmit} onClick={sendTip}>
+              {isTipping && <span className="loading loading-spinner loading-sm" />}
+              Send tip
+            </button>
+          )}
+        </div>
+      </div>
+    </div>
+  );
+};
