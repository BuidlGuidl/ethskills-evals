@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.19;
+
+import "./DeployHelpers.s.sol";
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { TipJar } from "../contracts/TipJar.sol";
+
+/**
+ * Local (fork of Base):  yarn deploy
+ * Base mainnet:          TIP_RECIPIENT=0x... yarn deploy --network base
+ */
+contract DeployTipJar is ScaffoldETHDeploy {
+    address constant BASE_USDC = 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913;
+
+    error UsdcNotFound();
+    error RecipientRequired();
+
+    function run() external ScaffoldEthDeployerRunner {
+        // Catches `yarn chain` (empty chain) instead of `yarn fork --network base`
+        if (BASE_USDC.code.length == 0) revert UsdcNotFound();
+
+        // Locally the deployer (anvil account #9) receives tips; on Base the recipient must be explicit
+        address recipient = vm.envOr("TIP_RECIPIENT", address(0));
+        if (recipient == address(0)) {
+            if (block.chainid != 31337) revert RecipientRequired();
+            recipient = deployer;
+        }
+
+        TipJar tipJar = new TipJar(IERC20(BASE_USDC), recipient);
+        deployments.push(Deployment("TipJar", address(tipJar)));
+    }
+}
