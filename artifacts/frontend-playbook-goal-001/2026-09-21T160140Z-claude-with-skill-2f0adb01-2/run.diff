diff --git a/packages/foundry/scripts-js/fundUsdc.sh b/packages/foundry/scripts-js/fundUsdc.sh
new file mode 100755
index 0000000..8dc66fc
--- /dev/null
+++ b/packages/foundry/scripts-js/fundUsdc.sh
@@ -0,0 +1,46 @@
+#!/usr/bin/env bash
+# Local fork only: gives test identities real Base USDC (minted through the real USDC contract)
+# plus ETH for gas. Usage: yarn fund [address ...] [--amount <whole USDC>]
+set -euo pipefail
+
+RPC_URL="${RPC_URL:-http://127.0.0.1:8545}"
+USDC=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
+AMOUNT=1000
+ADDRESSES=()
+
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --amount) AMOUNT="$2"; shift 2 ;;
+    *) ADDRESSES+=("$1"); shift ;;
+  esac
+done
+# Default demo tippers: anvil accounts #0 and #1
+[ ${#ADDRESSES[@]} -eq 0 ] && ADDRESSES=(0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266 0x70997970C51812dc3A010C7d01b50e0d17dc79C8)
+
+# Refuse to touch anything that isn't the local fork
+if [ "$(cast chain-id --rpc-url "$RPC_URL")" != "31337" ]; then
+  echo "❌ $RPC_URL is not the local fork (chain id 31337). Run 'yarn fork --network base' first." >&2
+  exit 1
+fi
+if [ "$(cast code "$USDC" --rpc-url "$RPC_URL")" = "0x" ]; then
+  echo "❌ No USDC at $USDC — this chain is not a Base fork. Use 'yarn fork --network base', not 'yarn chain'." >&2
+  exit 1
+fi
+
+RAW_AMOUNT=$(cast parse-units "$AMOUNT" 6)
+MASTER_MINTER=$(cast call "$USDC" "masterMinter()(address)" --rpc-url "$RPC_URL")
+
+cast rpc anvil_impersonateAccount "$MASTER_MINTER" --rpc-url "$RPC_URL" >/dev/null
+cast rpc anvil_setBalance "$MASTER_MINTER" 0x56BC75E2D63100000 --rpc-url "$RPC_URL" >/dev/null
+cast send --unlocked --from "$MASTER_MINTER" "$USDC" "configureMinter(address,uint256)" \
+  "$MASTER_MINTER" "$(cast max-uint)" --rpc-url "$RPC_URL" >/dev/null
+
+for addr in "${ADDRESSES[@]}"; do
+  cast send --unlocked --from "$MASTER_MINTER" "$USDC" "mint(address,uint256)" "$addr" "$RAW_AMOUNT" \
+    --rpc-url "$RPC_URL" >/dev/null
+  cast rpc anvil_setBalance "$addr" 0x56BC75E2D63100000 --rpc-url "$RPC_URL" >/dev/null # 100 ETH for gas
+  balance=$(cast call "$USDC" "balanceOf(address)(uint256)" "$addr" --rpc-url "$RPC_URL" | cut -d' ' -f1)
+  echo "✅ $addr: $(cast format-units "$balance" 6) USDC, 100 ETH"
+done
+
+cast rpc anvil_stopImpersonatingAccount "$MASTER_MINTER" --rpc-url "$RPC_URL" >/dev/null
diff --git a/packages/foundry/test/TipJar.t.sol b/packages/foundry/test/TipJar.t.sol
new file mode 100644
index 0000000..730490e
--- /dev/null
+++ b/packages/foundry/test/TipJar.t.sol
@@ -0,0 +1,101 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import { Test } from "forge-std/Test.sol";
+import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import { ERC20 } from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+import { TipJar } from "../contracts/TipJar.sol";
+
+contract MockUSDC is ERC20("USD Coin", "USDC") {
+    function decimals() public pure override returns (uint8) {
+        return 6;
+    }
+
+    function mint(address to, uint256 amount) external {
+        _mint(to, amount);
+    }
+}
+
+contract TipJarTest is Test {
+    event Tip(address indexed tipper, uint256 amount, string message);
+
+    MockUSDC usdc;
+    TipJar tipJar;
+    address recipient = makeAddr("recipient");
+    address alice = makeAddr("alice");
+
+    function setUp() public {
+        usdc = new MockUSDC();
+        tipJar = new TipJar(IERC20(address(usdc)), recipient);
+        usdc.mint(alice, 100e6);
+    }
+
+    function test_TipMovesUsdcToRecipient() public {
+        vm.startPrank(alice);
+        usdc.approve(address(tipJar), 5e6);
+        vm.expectEmit(address(tipJar));
+        emit Tip(alice, 5e6, "gm");
+        tipJar.tip(5e6, "gm");
+        vm.stopPrank();
+
+        assertEq(usdc.balanceOf(recipient), 5e6);
+        assertEq(usdc.balanceOf(alice), 95e6);
+        assertEq(usdc.balanceOf(address(tipJar)), 0);
+        assertEq(tipJar.totalTipped(), 5e6);
+        assertEq(tipJar.tipCount(), 1);
+    }
+
+    function test_RevertsOnZeroAmount() public {
+        vm.prank(alice);
+        vm.expectRevert(TipJar.ZeroAmount.selector);
+        tipJar.tip(0, "");
+    }
+
+    function test_RevertsOnLongMessage() public {
+        vm.prank(alice);
+        vm.expectRevert(TipJar.MessageTooLong.selector);
+        tipJar.tip(1, string(new bytes(281)));
+    }
+
+    function test_RevertsWithoutApproval() public {
+        vm.prank(alice);
+        vm.expectRevert();
+        tipJar.tip(1e6, "");
+    }
+
+    function test_RevertsOnZeroAddresses() public {
+        vm.expectRevert(TipJar.ZeroAddress.selector);
+        new TipJar(IERC20(address(0)), recipient);
+        vm.expectRevert(TipJar.ZeroAddress.selector);
+        new TipJar(IERC20(address(usdc)), address(0));
+    }
+
+    function testFuzz_Tip(uint256 amount) public {
+        amount = bound(amount, 1, 100e6);
+        vm.startPrank(alice);
+        usdc.approve(address(tipJar), amount);
+        tipJar.tip(amount, "fuzz");
+        vm.stopPrank();
+        assertEq(usdc.balanceOf(recipient), amount);
+    }
+}
+
+/// Runs against real Base state: `forge test --match-contract TipJarForkTest --fork-url base`
+contract TipJarForkTest is Test {
+    IERC20 constant USDC = IERC20(0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913);
+
+    function test_TipWithRealBaseUsdc() public {
+        vm.skip(block.chainid != 8453);
+        address recipient = makeAddr("recipient");
+        address alice = makeAddr("alice");
+        TipJar tipJar = new TipJar(USDC, recipient);
+        deal(address(USDC), alice, 10e6);
+
+        vm.startPrank(alice);
+        USDC.approve(address(tipJar), 10e6);
+        tipJar.tip(10e6, "real USDC, fake money");
+        vm.stopPrank();
+
+        assertEq(USDC.balanceOf(recipient), 10e6);
+    }
+}
