{
  "name": "usdc-tip-jar",
  "version": "1.0.0",
  "private": true,
  "description": "A USDC tip jar for Base: onchain tip feed plus a web frontend, running against a local fork.",
  "scripts": {
    "install:web": "npm --prefix web install",
    "chain": "./scripts/chain.sh",
    "setup": "./scripts/setup.sh",
    "fund": "./scripts/fund.sh",
    "deploy": "./scripts/deploy.sh",
    "seed": "./scripts/seed.sh",
    "sync-abi": "./scripts/sync-abi.sh",
    "web": "npm --prefix web run dev",
    "build:web": "npm --prefix web run build",
    "typecheck": "npm --prefix web run typecheck",
    "test": "cd contracts && forge test --no-match-path 'test/TipJarFork.t.sol'",
    "test:fork": "cd contracts && BASE_RPC_URL=${BASE_RPC_URL:-https://mainnet.base.org} forge test"
  }
}
