# Optional overrides for the frontend. Copy to `.env.local` to use.

# WalletConnect projectId (only needed for WalletConnect-based wallets).
# MetaMask / injected wallets work locally without it.
# Get one at https://cloud.reown.com
VITE_WC_PROJECT_ID=

# Override the deployed contract addresses. Defaults match a fresh anvil deploy.
# On Base mainnet, set VITE_USDC_ADDRESS to the real USDC below.
# VITE_TIP_JAR_ADDRESS=0x...
# VITE_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
