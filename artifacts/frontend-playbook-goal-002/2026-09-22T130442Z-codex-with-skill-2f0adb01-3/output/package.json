{
  "name": "eval-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Local USDC tip jar for Base with a Hardhat contract and Vite web app.",
  "scripts": {
    "compile": "env -u NODE_OPTIONS node scripts/compile-solc.js",
    "test": "npm run compile && env -u NODE_OPTIONS hardhat test --no-compile",
    "node": "env -u NODE_OPTIONS hardhat node",
    "deploy:local": "npm run compile && env -u NODE_OPTIONS hardhat run --no-compile scripts/deploy.js --network localhost",
    "dev": "env -u NODE_OPTIONS vite --host 127.0.0.1",
    "build": "env -u NODE_OPTIONS vite build",
    "preview": "env -u NODE_OPTIONS vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "ethers": "^6.13.5",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "2.0.8",
    "@nomicfoundation/hardhat-ethers": "3.0.8",
    "chai": "^4.5.0",
    "hardhat": "2.22.17",
    "solc": "^0.8.24"
  }
}
