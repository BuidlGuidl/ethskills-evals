{
  "name": "base-usdc-tip-jar",
  "version": "0.1.0",
  "private": true,
  "description": "Local Base USDC tip jar with a Solidity contract and React wallet UI.",
  "scripts": {
    "chain": "hardhat node --hostname 127.0.0.1",
    "compile": "hardhat compile",
    "deploy:local": "hardhat run scripts/deploy-local.js --network localhost",
    "dev:web": "vite --host 127.0.0.1",
    "dev": "bash scripts/dev-local.sh",
    "build": "vite build",
    "test": "hardhat test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "ethers": "^6.13.5",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "2.0.8",
    "@nomicfoundation/hardhat-ethers": "3.0.8",
    "@nomicfoundation/hardhat-network-helpers": "1.0.12",
    "chai": "^4.5.0",
    "concurrently": "^9.1.0",
    "hardhat": "2.22.17"
  }
}
