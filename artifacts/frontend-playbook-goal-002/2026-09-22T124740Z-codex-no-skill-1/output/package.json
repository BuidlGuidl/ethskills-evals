{
  "name": "base-usdc-tip-jar",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "chain": "env -u NODE_OPTIONS hardhat node --hostname 127.0.0.1",
    "deploy:local": "env -u NODE_OPTIONS hardhat run scripts/deploy-local.ts --network localhost",
    "test": "env -u NODE_OPTIONS hardhat test",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p frontend/tsconfig.json && vite build"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2",
    "@tanstack/react-query": "^5.56.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.21.45",
    "wagmi": "^2.12.30"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/node": "^22.5.5",
    "@types/mocha": "^10.0.7",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.13",
    "solc": "0.8.24",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
