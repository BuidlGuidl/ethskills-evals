# Copy to .env.local, or let `npm run deploy:local` write it for you.

# 31337 = local anvil, 8453 = Base mainnet.
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# Printed by `npm run deploy:local`.
NEXT_PUBLIC_TIP_JAR_ADDRESS=
# Base USDC is 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913. On a plain anvil chain the
# deploy script puts a MockUSDC here instead.
NEXT_PUBLIC_USDC_ADDRESS=

# `true` when the address above is a MockUSDC, which adds a faucet button to the page.
NEXT_PUBLIC_MOCK_TOKEN=false

# Comma-separated addresses anvil has unlocked, exposed as one-click "dev wallet"
# connectors so you can use the app without a browser extension.
# MUST be empty on any public network.
NEXT_PUBLIC_DEV_ACCOUNTS=
