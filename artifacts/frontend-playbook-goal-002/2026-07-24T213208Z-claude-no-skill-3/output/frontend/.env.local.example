# Copy to .env.local and adjust if needed. All values have working defaults
# for local development, so you can also just run without this file.

# RPC endpoint for your local chain (anvil/hardhat).
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# Optional: a WalletConnect Cloud projectId (https://cloud.walletconnect.com).
# Not required for MetaMask / injected wallets during local development.
NEXT_PUBLIC_WC_PROJECT_ID=
