# scripts/deploy-local.sh writes web/.env.local for you; this file documents
# every variable the front end understands.

# TipJar on the local Anvil chain.
VITE_TIPJAR_ADDRESS=0x0000000000000000000000000000000000000000
# Token the local jar collects. On a Base fork this is the real USDC address.
VITE_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
VITE_LOCAL_RPC_URL=http://127.0.0.1:8545
VITE_LOCAL_CHAIN_ID=31337

# Optional: a TipJar deployed to Base mainnet.
# VITE_TIPJAR_ADDRESS_BASE=

# Optional: enables the WalletConnect connector (https://cloud.reown.com).
# VITE_WALLETCONNECT_PROJECT_ID=

# Optional, local only: transact as one of Anvil's unlocked accounts so the app
# is usable without a browser wallet. Never point this at a real network.
# VITE_DEV_WALLET=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
