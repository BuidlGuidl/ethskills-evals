{
  "name": "usdc-tip-jar",
  "private": true,
  "version": "0.1.0",
  "description": "USDC tip jar for Base: Foundry contract + React front end, runnable locally against a Base fork.",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "chain": "./scripts/anvil.sh",
    "deploy:local": "./scripts/deploy-local.sh",
    "seed": "./scripts/seed-tips.sh",
    "fund": "./scripts/fund-usdc.sh",
    "abi": "./scripts/sync-abi.sh",
    "dev": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "preview": "npm run preview --workspace web",
    "lint": "npm run lint --workspace web",
    "test:contracts": "forge test --root contracts",
    "test:fork": "BASE_RPC_URL=${BASE_RPC_URL:-https://mainnet.base.org} forge test --root contracts --match-contract TipJarForkTest"
  }
}
