{
  "name": "base-usdc-tip-jar",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "compile": "env -u NODE_OPTIONS hardhat compile",
    "test": "env -u NODE_OPTIONS hardhat test",
    "dev:chain": "env -u NODE_OPTIONS hardhat node",
    "deploy:local": "env -u NODE_OPTIONS hardhat run scripts/deploy-local.ts --network localhost",
    "dev:web": "env -u NODE_OPTIONS vite --host 127.0.0.1",
    "dev": "env -u NODE_OPTIONS vite --host 127.0.0.1",
    "build": "env -u NODE_OPTIONS tsc && env -u NODE_OPTIONS vite build",
    "lint": "env -u NODE_OPTIONS tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.3.1",
    "ethers": "6.14.0",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "5.4.2"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "2.0.7",
    "@nomicfoundation/hardhat-ethers": "3.0.8",
    "@types/chai": "4.3.16",
    "@types/mocha": "10.0.7",
    "@types/node": "20.14.15",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "chai": "4.3.10",
    "hardhat": "2.22.10",
    "solc": "0.8.24",
    "ts-node": "10.9.2",
    "typescript": "5.5.4"
  }
}
