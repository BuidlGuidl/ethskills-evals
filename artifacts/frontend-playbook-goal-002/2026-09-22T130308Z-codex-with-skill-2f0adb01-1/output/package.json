{
  "name": "base-usdc-tip-jar",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "compile": "env -u NODE_OPTIONS hardhat compile",
    "test": "env -u NODE_OPTIONS hardhat test",
    "node": "env -u NODE_OPTIONS hardhat node",
    "deploy:local": "env -u NODE_OPTIONS hardhat run scripts/deploy.js --network localhost",
    "dev": "env -u NODE_OPTIONS vite --host 127.0.0.1",
    "build": "env -u NODE_OPTIONS vite build",
    "preview": "env -u NODE_OPTIONS vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "ethers": "6.13.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "5.4.11"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "3.0.8",
    "hardhat": "2.22.19",
    "solc": "0.8.26"
  }
}
