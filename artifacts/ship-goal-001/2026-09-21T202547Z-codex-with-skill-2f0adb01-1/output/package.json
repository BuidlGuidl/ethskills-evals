{
  "name": "toolshed",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat test",
    "compile": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat compile",
    "deploy:local": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat run scripts/deploy.ts --network localhost",
    "deploy:sepolia": "TS_NODE_PROJECT=tsconfig.hardhat.json hardhat run scripts/deploy.ts --network sepolia"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2",
    "@tanstack/react-query": "^5.56.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.21.22",
    "wagmi": "^2.12.15"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.7",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.12",
    "@types/node": "^22.7.5",
    "@types/mocha": "^10.0.9",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "chai": "^4.5.0",
    "ethers": "^6.13.4",
    "hardhat": "^2.22.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
