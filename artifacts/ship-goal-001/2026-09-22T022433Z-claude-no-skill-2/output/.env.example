# Copy to .env (docker compose reads it) or export these in your shell.
# Every value below is the default, so an empty .env also works in development.

# --- server ---------------------------------------------------------------
PORT=8080
NODE_ENV=development
DATABASE_PATH=server/data/toolshed.db
UPLOAD_DIR=server/data/uploads
WEB_DIST_DIR=web/dist

# --- membership -----------------------------------------------------------
# Anyone with this code can join. Rotate it when the roster changes.
INVITE_CODE=maple-street
# Comma-separated; these accounts get the admin flag when they sign up.
ADMIN_EMAILS=
SESSION_TTL_DAYS=30
# Leave unset in dev (http). Must be true behind HTTPS.
SECURE_COOKIES=false

# --- money ----------------------------------------------------------------
# 'mock' credits balances on request. No other provider ships in v0.1.
PAYMENT_PROVIDER=mock
MOCK_MAX_TOPUP_MICROS=5000000000
# Upper bounds on what a listing may ask for, in micro-USDC (1 USDC = 1e6).
MAX_DEPOSIT_MICROS=2000000000
MAX_LATE_FEE_MICROS=50000000
MAX_LOAN_DAYS=90

# --- late fees ------------------------------------------------------------
# Hours past the due date before the first late fee lands.
LATE_GRACE_HOURS=0
# How often the sweep runs. Fees are idempotent, so this only affects promptness.
ACCRUAL_INTERVAL_MINUTES=15
# Set to false if you run the sweep from an external scheduler instead.
RUN_ACCRUAL_WORKER=true

# --- photos ---------------------------------------------------------------
MAX_PHOTO_BYTES=8388608
