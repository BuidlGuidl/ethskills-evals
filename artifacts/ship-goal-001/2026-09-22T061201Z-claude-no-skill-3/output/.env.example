# Copy to .env and load it however your process manager prefers
# (systemd EnvironmentFile=, `set -a; . ./.env; set +a`, etc).

PORT=3000
NODE_ENV=production

# Calendar days -- due dates and late-day counting -- are computed in this zone.
TOOLSHED_TZ=America/New_York

# Where the SQLite file and uploaded photos live. Both must be on a disk that
# is backed up; they are the entire state of the application.
TOOLSHED_DB=/var/lib/toolshed/toolshed.sqlite
TOOLSHED_UPLOADS=/var/lib/toolshed/uploads

# Required in production. `openssl rand -hex 32`. Changing it signs everyone out.
TOOLSHED_SESSION_SECRET=

# Handed out with the membership packet; rotate it when someone leaves.
TOOLSHED_INVITE_CODE=change-me

# Set to true once Toolshed is behind HTTPS, so cookies are marked Secure.
TOOLSHED_SECURE_COOKIES=true

# Escrow driver: 'ledger' (internal double-entry ledger) or 'onchain' (not built yet).
TOOLSHED_ESCROW=ledger

# Development only: lets a member mint test USDC into their own balance.
# TOOLSHED_DEV_FAUCET=true
