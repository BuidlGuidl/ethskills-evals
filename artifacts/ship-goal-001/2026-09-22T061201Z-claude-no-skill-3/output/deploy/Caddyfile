# Toolshed speaks plain HTTP and expects something in front of it to terminate
# TLS. Caddy does that with no further configuration; nginx or a load balancer
# is equally fine. Remember TOOLSHED_SECURE_COOKIES=true once this is in place.

toolshed.example.org {
	encode gzip
	# Photos can be large; the app caps uploads at TOOLSHED_MAX_PHOTO_BYTES (5 MB).
	request_body {
		max_size 8MB
	}
	reverse_proxy 127.0.0.1:3000
}
