# /etc/systemd/system/toolshed.service
#
#   sudo useradd --system --home /var/lib/toolshed --create-home toolshed
#   sudo cp deploy/toolshed.service /etc/systemd/system/
#   sudo systemctl enable --now toolshed

[Unit]
Description=Toolshed
After=network.target

[Service]
Type=simple
User=toolshed
Group=toolshed
WorkingDirectory=/srv/toolshed
EnvironmentFile=/etc/toolshed.env
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning src/main.js
Restart=on-failure
RestartSec=2

# The app writes to exactly one directory and needs nothing else.
StateDirectory=toolshed
ReadWritePaths=/var/lib/toolshed
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
