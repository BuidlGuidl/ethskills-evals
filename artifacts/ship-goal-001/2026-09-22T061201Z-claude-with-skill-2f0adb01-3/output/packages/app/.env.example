# Toolshed frontend configuration. Copy to .env.local and fill in.

# Deployed Toolshed contract, printed by the deploy script.
NEXT_PUBLIC_TOOLSHED_ADDRESS=0x0000000000000000000000000000000000000000
# USDC on the same chain. Base mainnet: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
NEXT_PUBLIC_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# 8453 Base, 84532 Base Sepolia, 31337 local anvil.
NEXT_PUBLIC_CHAIN_ID=8453

# Optional: your own RPC (Alchemy/QuickNode). Falls back to the chain's public RPC.
NEXT_PUBLIC_RPC_URL=

# WalletConnect project id, from https://cloud.reown.com. Needed for mobile wallets;
# browser-extension and Coinbase Smart Wallet connectors work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional: pin tool photos to IPFS via Pinata (https://pinata.cloud). Server-side only.
# Without it, listing falls back to an inline metadata URI plus a pasted image URL.
PINATA_JWT=
# Gateway used to read ipfs:// URIs.
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/

# Block the Toolshed contract was deployed in. The steward's roster screen scans
# MemberAdmitted logs from here; without it, public RPCs may refuse a from-genesis scan.
NEXT_PUBLIC_DEPLOY_BLOCK=0
