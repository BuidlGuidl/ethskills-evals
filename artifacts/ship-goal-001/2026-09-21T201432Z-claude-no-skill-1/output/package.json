{
  "name": "toolshed",
  "private": true,
  "description": "A lending library for a neighbourhood association: tools, USDC deposits, late fees, track records.",
  "scripts": {
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test",
    "contracts:deploy:local": "cd contracts && forge script script/Deploy.s.sol --rpc-url ${RPC_URL:-http://127.0.0.1:8545} --broadcast",
    "contracts:seed:local": "cd contracts && ./script/seed.sh",
    "web:dev": "cd web && npm run dev",
    "web:build": "cd web && npm run build",
    "web:sync-abis": "cd web && npm run sync-abis"
  }
}
