{
  "name": "toolshed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test:contracts": "forge test",
    "deploy:local": "forge script script/DeployLocal.s.sol:DeployLocal --rpc-url http://127.0.0.1:8545 --broadcast",
    "deploy:base-sepolia": "forge script script/Deploy.s.sol:DeployToolshed --rpc-url \"$BASE_SEPOLIA_RPC_URL\" --broadcast --verify"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "viem": "2.56.8"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "5.2.0",
    "forge-std": "^1.1.2",
    "typescript": "5.7.2",
    "vite": "6.4.3"
  }
}
