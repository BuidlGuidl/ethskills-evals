{
  "name": "toolshed",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "npm --workspace web run dev",
    "build": "npm --workspace web run build",
    "lint": "npm --workspace web run lint",
    "test": "forge test --root contracts",
    "contracts:build": "forge build --root contracts",
    "contracts:deploy:local": "forge script script/Deploy.s.sol:DeployToolshed --root contracts --rpc-url http://127.0.0.1:8545 --broadcast",
    "contracts:deploy:sepolia": "forge script script/Deploy.s.sol:DeployToolshed --root contracts --rpc-url $SEPOLIA_RPC_URL --broadcast --verify"
  },
  "workspaces": ["web"]
}

