diff --git a/script/Deploy.s.sol b/script/Deploy.s.sol
new file mode 100644
index 0000000..cf8f481
--- /dev/null
+++ b/script/Deploy.s.sol
@@ -0,0 +1,17 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+import "../contracts/Toolshed.sol";
+
+interface Vm { function envAddress(string calldata) external returns (address); function startBroadcast() external; function stopBroadcast() external; }
+
+contract Deploy {
+    Vm constant vm = Vm(address(uint160(uint256(keccak256("hevm cheat code")))));
+    function run() external returns (Toolshed deployed) {
+        address usdc = vm.envAddress("USDC_ADDRESS");
+        address admin = vm.envAddress("ADMIN_ADDRESS");
+        vm.startBroadcast();
+        deployed = new Toolshed(usdc, admin);
+        vm.stopBroadcast();
+    }
+}
diff --git a/src/App.tsx b/src/App.tsx
new file mode 100644
index 0000000..06b75e9
--- /dev/null
+++ b/src/App.tsx
@@ -0,0 +1,43 @@
+import { FormEvent, useCallback, useEffect, useMemo, useState } from 'react'
+import { createPublicClient, createWalletClient, custom, formatUnits, http, parseUnits, type Address } from 'viem'
+import { baseSepolia } from 'viem/chains'
+import { erc20Abi, toolshedAbi } from './abi'
+
+declare global { interface Window { ethereum?: { request(args:{method:string;params?:unknown[]}):Promise<unknown> } } }
+type Tool = { id:bigint; owner:Address; name:string; description:string; imageURI:string; condition:string; deposit:bigint; dailyLateFee:bigint; available:boolean }
+type Loan = { id:bigint; toolId:bigint; borrower:Address; durationDays:bigint; dueAt:bigint; returnedAt:bigint; status:number; completed:number; late:number }
+const contract = import.meta.env.VITE_TOOLSHED_ADDRESS as Address
+const usdc = import.meta.env.VITE_USDC_ADDRESS as Address
+const chain = { ...baseSepolia, id:Number(import.meta.env.VITE_CHAIN_ID || 84532), rpcUrls:{ default:{ http:[import.meta.env.VITE_RPC_URL || 'https://sepolia.base.org'] } } }
+const publicClient = createPublicClient({ chain, transport:http(chain.rpcUrls.default.http[0]) })
+const short = (a:string) => `${a.slice(0,6)}…${a.slice(-4)}`
+const money = (n:bigint) => formatUnits(n,6)
+const statusNames = ['—','Requested','Active','Returned','Completed','Rejected','Cancelled']
+
+export default function App() {
+  const [account,setAccount]=useState<Address>(); const [tools,setTools]=useState<Tool[]>([]); const [loans,setLoans]=useState<Loan[]>([])
+  const [tab,setTab]=useState<'browse'|'loans'|'list'>('browse'); const [notice,setNotice]=useState(''); const [loading,setLoading]=useState(false); const [member,setMember]=useState(false)
+  const wallet = useMemo(()=>window.ethereum ? createWalletClient({account,chain,transport:custom(window.ethereum)}) : undefined,[account])
+  const refresh=useCallback(async()=>{ if(!contract || /^0x0+$/.test(contract)) return
+    const [tc,lc]=await Promise.all([publicClient.readContract({address:contract,abi:toolshedAbi,functionName:'toolCount'}),publicClient.readContract({address:contract,abi:toolshedAbi,functionName:'loanCount'})])
+    const ts=await Promise.all(Array.from({length:Number(tc)},(_,i)=>publicClient.readContract({address:contract,abi:toolshedAbi,functionName:'tools',args:[BigInt(i+1)]})))
+    setTools(ts.map(t=>({id:t[0],owner:t[1],name:t[2],description:t[3],imageURI:t[4],condition:t[5],deposit:t[6],dailyLateFee:t[7],available:t[8]})))
+    const ls=await Promise.all(Array.from({length:Number(lc)},(_,i)=>publicClient.readContract({address:contract,abi:toolshedAbi,functionName:'loans',args:[BigInt(i+1)]})))
+    const reps=await Promise.all(ls.map(l=>publicClient.readContract({address:contract,abi:toolshedAbi,functionName:'reputation',args:[l[2]]})))
+    setLoans(ls.map((l,i)=>({id:l[0],toolId:l[1],borrower:l[2],durationDays:l[3],dueAt:l[4],returnedAt:l[5],status:l[6],completed:reps[i][0],late:reps[i][1]})))
+    if(account) setMember(await publicClient.readContract({address:contract,abi:toolshedAbi,functionName:'isMember',args:[account]}))
+  },[account])
+  useEffect(()=>{ refresh().catch(e=>setNotice(e.shortMessage||e.message)) },[refresh])
+  async function connect(){ if(!window.ethereum)return setNotice('Install a browser wallet to continue.'); const a=await window.ethereum.request({method:'eth_requestAccounts'}) as Address[]; setAccount(a[0]) }
+  async function write(name:string,args:readonly unknown[]){ if(!wallet||!account)return connect(); setLoading(true);setNotice('Confirm in your wallet…'); try { const hash=await wallet.writeContract({address:contract,abi:toolshedAbi,functionName:name as never,args:args as never,account}); setNotice('Transaction submitted. Waiting for confirmation…'); await publicClient.waitForTransactionReceipt({hash}); setNotice('Done. The neighborhood ledger is up to date.'); await refresh() } catch(e:unknown){setNotice(e instanceof Error?e.message:'Transaction failed')} finally{setLoading(false)} }
+  async function borrow(t:Tool){ if(!wallet||!account)return connect(); const days=Number(prompt('How many days? (1–30)','3')); if(!days||days<1||days>30)return; setLoading(true); try { setNotice('First, approve the refundable USDC deposit…'); const h=await wallet.writeContract({address:usdc,abi:erc20Abi,functionName:'approve',args:[contract,t.deposit],account}); await publicClient.waitForTransactionReceipt({hash:h}); await write('requestLoan',[t.id,BigInt(days)]) } catch(e:unknown){setNotice(e instanceof Error?e.message:'Transaction failed');setLoading(false)} }
+  async function listTool(e:FormEvent<HTMLFormElement>){e.preventDefault();const d=new FormData(e.currentTarget);await write('listTool',[d.get('name'),d.get('description'),d.get('image'),d.get('condition'),parseUnits(String(d.get('deposit')),6),parseUnits(String(d.get('fee')),6)]);e.currentTarget.reset()}
+  const sortedLoans=[...loans].sort((a,b)=>(a.late/Math.max(a.completed,1))-(b.late/Math.max(b.completed,1))||b.completed-a.completed)
+  const configured=contract&&!/^0x0+$/.test(contract)
+  return <><header><a className="brand" href="#"><span>Toolshed</span><small>Borrow nearby. Build trust.</small></a><nav>{(['browse','loans','list'] as const).map(x=><button className={tab===x?'active':''} onClick={()=>setTab(x)} key={x}>{x==='loans'?'Loan board':x==='list'?'List a tool':'Browse'}</button>)}</nav><button className="connect" onClick={connect}>{account?short(account):'Connect wallet'}</button></header>
+  <main>{!configured&&<div className="notice">Set VITE_TOOLSHED_ADDRESS and VITE_USDC_ADDRESS in <code>.env</code> to connect this UI.</div>}{notice&&<div className="toast" onClick={()=>setNotice('')}>{notice}<b>×</b></div>}
+  {tab==='browse'&&<><section className="hero"><div><p className="eyebrow">THE NEIGHBORHOOD TOOL LIBRARY</p><h1>Good tools should<br/><em>get used.</em></h1><p>Borrow from people around the corner. A refundable deposit keeps it neighborly.</p></div><div className="hero-stat"><strong>{tools.filter(t=>t.available).length}</strong><span>tools ready to borrow</span></div></section><div className="section-head"><div><p className="eyebrow">AVAILABLE NOW</p><h2>What are you working on?</h2></div><span>{tools.length} community listings</span></div><section className="grid">{tools.map(t=><article className="card" key={String(t.id)}><div className="photo">{t.imageURI?<img src={t.imageURI} alt={t.name}/>:<span>🛠️</span>}<i className={t.available?'available':'busy'}>{t.available?'Available':'On loan'}</i></div><div className="card-body"><h3>{t.name}</h3><p>{t.description}</p><div className="condition"><b>Condition</b> {t.condition}</div><div className="owner"><span className="avatar">{t.owner.slice(2,4).toUpperCase()}</span><div><small>Listed by</small><strong>{short(t.owner)}</strong></div></div><div className="terms"><span><small>Deposit</small><b>{money(t.deposit)} USDC</b></span><span><small>Late fee</small><b>{money(t.dailyLateFee)}/day</b></span></div><button disabled={!t.available||loading||t.owner===account} onClick={()=>borrow(t)}>Request to borrow →</button></div></article>)}</section></>}
+  {tab==='loans'&&<><div className="page-title"><p className="eyebrow">TRUST, EARNED OVER TIME</p><h1>Loan board</h1><p>Requests are ordered by reliable return history, then completed loans.</p></div><section className="loan-list">{sortedLoans.map(l=>{const t=tools.find(x=>x.id===l.toolId);const mine=l.borrower===account;const owned=t?.owner===account;return <article className="loan" key={String(l.id)}><div><small>#{String(l.id)} · {statusNames[l.status]}</small><h3>{t?.name||`Tool #${l.toolId}`}</h3><p>{short(l.borrower)} · {String(l.durationDays)} days {l.dueAt>0n&&`· due ${new Date(Number(l.dueAt)*1000).toLocaleDateString()}`}</p></div><div className="record"><strong>{l.completed}</strong><span>completed</span><strong>{l.late}</strong><span>late</span></div><div className="actions">{owned&&l.status===1&&<><button onClick={()=>write('acceptLoan',[l.id])}>Accept</button><button className="ghost" onClick={()=>write('rejectLoan',[l.id])}>Decline</button></>}{mine&&l.status===1&&<button className="ghost" onClick={()=>write('cancelRequest',[l.id])}>Cancel</button>}{mine&&l.status===2&&<button onClick={()=>write('markReturned',[l.id])}>Mark returned</button>}{owned&&l.status===3&&<button onClick={()=>write('confirmReturn',[l.id])}>Confirm & settle</button>}</div></article>})}{!loans.length&&<div className="empty">No loan requests yet.</div>}</section></>}
+  {tab==='list'&&<div className="form-wrap"><div><p className="eyebrow">SHARE WHAT YOU HAVE</p><h1>List a tool</h1><p>Clear notes and a good photo help neighbors return it in the same shape.</p></div>{account&&!member?<div className="notice">This wallet is not an active association member. Ask the admin to add it.</div>:<form onSubmit={listTool}><label>Tool name<input required name="name" placeholder="18V cordless drill"/></label><label>What is it?<textarea required name="description" placeholder="What it includes and what it’s good for"/></label><label>Photo URL<input required type="url" name="image" placeholder="https://…"/></label><label>Condition notes<textarea required name="condition" placeholder="Scratches, quirks, missing pieces…"/></label><div className="row"><label>Deposit (USDC)<input required name="deposit" type="number" min="1" step="0.01"/></label><label>Late fee / day<input required name="fee" type="number" min="0" step="0.01"/></label></div><button disabled={loading||!account}>Publish listing →</button></form>}</div>}
+  </main><footer><b>Toolshed</b><span>Built for neighbors, not profit.</span><span>USDC escrow · Onchain reputation</span></footer></>
