{
  "name": "toolshed-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env src/scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env src/scripts/seed.ts",
    "indexer": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env src/indexer/run.ts",
    "test": "tsx --test src/core/*.test.ts",
    "smoke": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env src/scripts/smoke.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.7",
    "better-sqlite3": "^11.7.0",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.21.55",
    "wagmi": "^2.14.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
