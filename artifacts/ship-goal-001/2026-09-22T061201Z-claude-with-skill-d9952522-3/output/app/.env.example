# ---------------------------------------------------------------- chain
# Base mainnet = 8453, Base Sepolia = 84532.
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org

# Deployed ToolshedEscrow (from `forge script script/Deploy.s.sol` — see README).
NEXT_PUBLIC_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
# Circle USDC: Base mainnet 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
#              Base Sepolia 0x036CbD53842c5426634e7929541eC2318f3dCF7e
NEXT_PUBLIC_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# ---------------------------------------------------------------- server
# Any random 32+ byte string. Rotating it signs every member out.
SESSION_SECRET=change-me-openssl-rand-hex-32
DATABASE_PATH=./data/toolshed.db
UPLOAD_DIR=./public/uploads

# Comma-separated addresses that may invite and suspend members.
TOOLSHED_ADMINS=0x0000000000000000000000000000000000000000

# ---------------------------------------------------------------- indexer
# Block the escrow was deployed at. Indexing from 0 on mainnet takes hours.
INDEXER_START_BLOCK=0
# Blocks to rewind each pass so a reorg can't strand a loan in the wrong state.
INDEXER_CONFIRMATIONS=12
INDEXER_POLL_MS=5000
