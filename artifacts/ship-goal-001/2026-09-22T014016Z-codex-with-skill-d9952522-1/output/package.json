{
  "name": "toolshed",
  "version": "0.1.0",
  "private": true,
  "description": "Neighborhood tool lending library with USDC deposit escrow.",
  "scripts": {
    "dev": "concurrently \"npm:api\" \"npm:app\"",
    "api": "node server/src/index.js",
    "app": "vite --config app/vite.config.js --host 0.0.0.0",
    "build": "vite build --config app/vite.config.js",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:base-sepolia": "hardhat run scripts/deploy.js --network baseSepolia",
    "smoke:open-loan": "hardhat run scripts/smoke-open-loan.js --network baseSepolia",
    "smoke:settle-loan": "hardhat run scripts/smoke-settle-loan.js --network baseSepolia"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.2",
    "express": "^4.19.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "hardhat": "^2.22.9",
    "vite": "^5.4.2"
  }
}
