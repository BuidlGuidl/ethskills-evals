# ---------------------------------------------------------------------------
# Chain
# ---------------------------------------------------------------------------
# "base" for production, "baseSepolia" for the testnet dry run, "foundry" for a
# local anvil node.
NEXT_PUBLIC_CHAIN=baseSepolia

# Your own RPC endpoint. The public default works for local development but
# will rate-limit a real deployment — use Alchemy, QuickNode, or a Base node.
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org

# Filled in by the deploy step (see README).
NEXT_PUBLIC_TOOLSHED_ADDRESS=
TOOLSHED_DEPLOY_BLOCK=0

# Only needed on a local anvil chain; on Base the address is built in.
# NEXT_PUBLIC_USDC_ADDRESS=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
TOOLSHED_DB_PATH=./data/toolshed.db
TOOLSHED_UPLOAD_DIR=./public/uploads

# Comma-separated addresses that may approve new members.
TOOLSHED_ADMIN_ADDRESSES=

# Set to 1 to let anyone who connects a wallet join without admin approval.
# Fine for a pilot; turn it off before the association goes live.
TOOLSHED_OPEN_SIGNUP=0

# ---------------------------------------------------------------------------
# Indexer
# ---------------------------------------------------------------------------
INDEXER_POLL_MS=5000
INDEXER_BATCH_SIZE=2000
INDEXER_CONFIRMATIONS=2
