{
  "name": "toolshed-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file=.env.local src/server/migrate.ts",
    "indexer": "tsx --env-file=.env.local src/indexer/run.ts",
    "indexer:watch": "tsx --env-file=.env.local src/indexer/run.ts --watch",
    "seed": "tsx --env-file=.env.local src/server/seed.ts",
    "smoke": "tsx --env-file=.env.local src/e2e/smoke.ts"
  },
  "dependencies": {
    "@coinbase/wallet-sdk": "^4.3.7",
    "@tanstack/react-query": "^5.103.2",
    "better-sqlite3": "^11.10.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "viem": "^2.56.8",
    "wagmi": "^3.7.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
