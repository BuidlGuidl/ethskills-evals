# ---------------------------------------------------------------------------
# Toolshed app configuration. Copy to .env.local for development.
# ---------------------------------------------------------------------------

# Chain: 8453 Base mainnet · 84532 Base Sepolia · 31337 local anvil
NEXT_PUBLIC_CHAIN_ID=84532

# RPC endpoint used by the browser, the server and the indexer.
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org

# Deployed Toolshed contract (printed by contracts/script/Deploy.s.sol).
NEXT_PUBLIC_TOOLSHED_ADDRESS=0x0000000000000000000000000000000000000000

# USDC. Optional on Base and Base Sepolia, where the address is built in;
# required on anvil, where you deploy your own mock.
# NEXT_PUBLIC_USDC_ADDRESS=

# Block the contract was deployed in, so the indexer does not scan from genesis.
NEXT_PUBLIC_DEPLOY_BLOCK=0

# Signs session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-at-least-32-characters-long

# Offchain storage.
DATABASE_PATH=./data/toolshed.db
UPLOAD_DIR=./data/uploads

# Indexer tuning (optional).
# INDEXER_INTERVAL_MS=15000
# INDEXER_CONFIRMATIONS=2
# INDEXER_CHUNK=9000
