pragma solidity ^0.8.28;

import {Script} from "forge-std/Script.sol";
import {console2} from "forge-std/console2.sol";
import {MemberRegistry, IMembershipNFT} from "../src/MemberRegistry.sol";
import {MembershipNFT} from "../src/MembershipNFT.sol";
import {PrivateBallot, IVerifier} from "../src/PrivateBallot.sol";
import {HonkVerifier} from "../src/verifier/HonkVerifier.sol";

/// @notice Stands the whole system up on a local chain and wires it together.
///
/// Usage (anvil on :8545):
///   forge script script/Deploy.s.sol:Deploy \
///     --rpc-url http://127.0.0.1:8545 --broadcast
///
/// Env (all optional):
///   DEPLOYER_KEY        private key to broadcast from (default: anvil account 0)
///   MEMBER_COUNT        membership NFTs to mint       (default: 150)
///   MIN_ANONYMITY_SET   min members before a proposal can open (default: 20)
///   MNEMONIC            mnemonic the member wallets come from (default: anvil's)
///
/// Writes deployments/<chainid>.json for the Node scripts to read.
contract Deploy is Script {
    string constant DEFAULT_MNEMONIC = "test test test test test test test test test test test junk";
    /// @dev Members are derived well past anvil's pre-funded accounts, so that no
    ///      member wallet is ever also the admin or the relayer. Keeping those
    ///      roles on disjoint keys is the whole point of the design.
    uint32 constant MEMBER_INDEX_OFFSET = 1000;
    uint256 constant DEFAULT_DEPLOYER_KEY = 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80;

    function run() external {
        uint256 deployerKey = vm.envOr("DEPLOYER_KEY", DEFAULT_DEPLOYER_KEY);
        uint256 memberCount = vm.envOr("MEMBER_COUNT", uint256(150));
        uint256 minAnonymitySet = vm.envOr("MIN_ANONYMITY_SET", uint256(20));
        string memory mnemonic = vm.envOr("MNEMONIC", DEFAULT_MNEMONIC);

        address admin = vm.addr(deployerKey);

        vm.startBroadcast(deployerKey);

        // 1. The membership NFT. In production this already exists and you skip
        //    straight to step 2 with its address.
        MembershipNFT nft = new MembershipNFT();

        // 2. Registry, wired to the NFT: only token holders can join the tree.
        MemberRegistry registry = new MemberRegistry(IMembershipNFT(address(nft)));

        // 3. The circuit's verifier, generated by `bb write_solidity_verifier`.
        HonkVerifier verifier = new HonkVerifier();

        // 4. The ballot, wired to both. This is the only wiring that matters:
        //    the ballot reads the member root from `registry` and checks every
        //    proof with `verifier`.
        PrivateBallot ballot =
            new PrivateBallot(registry, IVerifier(address(verifier)), admin, minAnonymitySet);

        // 5. Hand each member their membership NFT. tokenId i goes to the wallet
        //    at derivation index MEMBER_INDEX_OFFSET + i, so the Node scripts can
        //    find their own token.
        for (uint256 i = 0; i < memberCount; i++) {
            nft.mint(vm.addr(vm.deriveKey(mnemonic, MEMBER_INDEX_OFFSET + uint32(i))), i);
        }

        vm.stopBroadcast();

        console2.log("MembershipNFT  ", address(nft));
        console2.log("MemberRegistry ", address(registry));
        console2.log("HonkVerifier   ", address(verifier));
        console2.log("PrivateBallot  ", address(ballot));
        console2.log("admin          ", admin);
        console2.log("members minted ", memberCount);

        _write(address(nft), address(registry), address(verifier), address(ballot), admin, memberCount, minAnonymitySet);
    }

    function _write(
        address nft,
        address registry,
        address verifier,
        address ballot,
        address admin,
        uint256 memberCount,
        uint256 minAnonymitySet
    ) private {
        string memory obj = "deployment";
        vm.serializeAddress(obj, "membershipNFT", nft);
        vm.serializeAddress(obj, "memberRegistry", registry);
        vm.serializeAddress(obj, "honkVerifier", verifier);
        vm.serializeAddress(obj, "privateBallot", ballot);
        vm.serializeAddress(obj, "admin", admin);
        vm.serializeUint(obj, "memberCount", memberCount);
        vm.serializeUint(obj, "minAnonymitySet", minAnonymitySet);
        string memory json = vm.serializeUint(obj, "chainId", block.chainid);

        string memory path = string.concat("deployments/", vm.toString(block.chainid), ".json");
        vm.writeJson(json, path);
        console2.log("wrote", path);
    }
}
