{
  "name": "dao-private-ballot",
  "private": true,
  "type": "module",
  "description": "Anonymous yes/no DAO voting with Noir + Solidity",
  "scripts": {
    "setup": "npm install && cd contracts && forge install foundry-rs/forge-std@v1.16.2",
    "circuit:build": "cd circuits/vote && nargo compile && bb write_vk -b target/vote.json -o target/vk -t evm",
    "circuit:verifier": "bb write_solidity_verifier -k circuits/vote/target/vk/vk -o contracts/src/verifier/HonkVerifier.sol -t evm",
    "circuit:test": "cd circuits/vote && nargo test",
    "build": "cd contracts && forge build",
    "test": "cd contracts && forge test",
    "chain": "anvil --port 8545",
    "deploy": "cd contracts && forge script script/Deploy.s.sol:Deploy --rpc-url ${RPC_URL:-http://127.0.0.1:8545} --broadcast",
    "register": "NODE_OPTIONS= node scripts/register-members.mjs",
    "propose": "NODE_OPTIONS= node scripts/create-proposal.mjs",
    "vote": "NODE_OPTIONS= node scripts/vote.mjs",
    "tally": "NODE_OPTIONS= node scripts/tally.mjs",
    "fixtures": "NODE_OPTIONS= node scripts/make-fixture.mjs",
    "demo": "./scripts/e2e.sh"
  },
  "dependencies": {
    "ethers": "^6.13.0"
  }
}
