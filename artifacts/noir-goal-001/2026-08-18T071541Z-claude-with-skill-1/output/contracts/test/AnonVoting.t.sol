pragma solidity ^0.8.27;

import {Test} from "forge-std/Test.sol";
import {AnonVoting} from "../src/AnonVoting.sol";
import {MemberRegistry} from "../src/MemberRegistry.sol";
import {MembershipNFT} from "../src/MembershipNFT.sol";
import {IVerifier} from "../src/IVerifier.sol";
import {HonkVerifier} from "../src/verifiers/HonkVerifier.sol";
import {IERC721} from "@openzeppelin/contracts/token/ERC721/IERC721.sol";

/// @notice End-to-end against the *real* generated verifier and real Honk proofs.
/// Proofs come from `contracts/test/fixtures/vote.json`, regenerated by `npm run fixture`.
/// No MockVerifier anywhere: a mock would happily accept the malformed inputs these tests rely on
/// being rejected.
contract AnonVotingTest is Test {
    struct Ballot {
        uint8 support;
        bytes32 nullifierHash;
        bytes proof;
    }

    uint256 constant MEMBER_COUNT = 150;
    uint64 constant VOTING_PERIOD = 3 days;

    MembershipNFT nft;
    MemberRegistry registry;
    AnonVoting voting;
    HonkVerifier verifier;

    address dao = makeAddr("dao");
    address relayer = makeAddr("relayer");

    string fixtureJson;
    uint256 fixtureRoot;
    uint256 proposalId;

    function setUp() public {
        fixtureJson = vm.readFile("test/fixtures/vote.json");
        fixtureRoot = uint256(vm.parseJsonBytes32(fixtureJson, ".merkleRoot"));

        vm.startPrank(dao);
        nft = new MembershipNFT(dao);
        verifier = new HonkVerifier();
        registry = new MemberRegistry(IERC721(address(nft)));
        voting = new AnonVoting(IVerifier(address(verifier)), registry);
        vm.stopPrank();

        _registerAllMembers();

        vm.prank(_member(0));
        proposalId = voting.createProposal(keccak256("Ship the thing"), uint64(block.timestamp) + VOTING_PERIOD);
    }

    /* ------------------------------------------------------------------ helpers */

    function _member(uint256 i) internal pure returns (address) {
        return address(uint160(0x1000 + i));
    }

    function _registerAllMembers() internal {
        bytes32[] memory commitments = vm.parseJsonBytes32Array(fixtureJson, ".commitments");
        assertEq(commitments.length, MEMBER_COUNT, "fixture member count drifted");

        for (uint256 i = 0; i < MEMBER_COUNT; i++) {
            vm.prank(dao);
            uint256 tokenId = nft.mint(_member(i));
            vm.prank(_member(i));
            registry.register(tokenId, uint256(commitments[i]));
        }
    }

    function _ballot(string memory key) internal view returns (Ballot memory b) {
        b.support = uint8(vm.parseJsonUint(fixtureJson, string.concat(key, ".support")));
        b.nullifierHash = vm.parseJsonBytes32(fixtureJson, string.concat(key, ".nullifierHash"));
        b.proof = vm.parseJsonBytes(fixtureJson, string.concat(key, ".proof"));
    }

    /* ------------------------------------------------------------------ happy path */

    function test_RegistrySnapshotMatchesOffchainTree() public view {
        assertEq(registry.size(), MEMBER_COUNT);
        assertEq(registry.root(), fixtureRoot, "onchain LeanIMT root differs from the offchain mirror");
        assertEq(voting.getProposal(proposalId).merkleRoot, fixtureRoot);
    }

    function test_RelayerCastsBallotForAnonymousMember() public {
        Ballot memory b = _ballot(".yesVote");

        // The relayer has no NFT, no registration, no relationship to any member.
        vm.prank(relayer);
        voting.castVote(proposalId, b.proof, b.nullifierHash, b.support);

        assertEq(voting.getProposal(proposalId).yesVotes, 1);
        assertEq(voting.getProposal(proposalId).noVotes, 0);
        assertTrue(voting.nullifierUsed(proposalId, b.nullifierHash));
    }

    function test_RaggedLastLeafCanVote() public {
        Ballot memory b = _ballot(".noVoteLastLeaf");
        vm.prank(relayer);
        voting.castVote(proposalId, b.proof, b.nullifierHash, b.support);
        assertEq(voting.getProposal(proposalId).noVotes, 1);
    }

    function test_TallyReadableAfterDeadline() public {
        Ballot memory yes = _ballot(".yesVote");
        Ballot memory no = _ballot(".noVoteLastLeaf");
        vm.startPrank(relayer);
        voting.castVote(proposalId, yes.proof, yes.nullifierHash, yes.support);
        voting.castVote(proposalId, no.proof, no.nullifierHash, no.support);
        vm.stopPrank();

        vm.expectRevert(AnonVoting.VotingOpen.selector);
        voting.result(proposalId);

        vm.warp(block.timestamp + VOTING_PERIOD);
        (uint64 yesVotes, uint64 noVotes, bool passed) = voting.result(proposalId);
        assertEq(yesVotes, 1);
        assertEq(noVotes, 1);
        assertFalse(passed, "a tie is not a pass");
    }

    /* ------------------------------------------------------------------ failure paths */

    function test_RevertWhen_SameMemberVotesTwice() public {
        Ballot memory first = _ballot(".yesVote");
        Ballot memory second = _ballot(".yesVoteRecast");

        vm.prank(relayer);
        voting.castVote(proposalId, first.proof, first.nullifierHash, first.support);

        // Different ballot value, freshly generated valid proof — but the identity is the same, so
        // it produces the same nullifier hash and is refused.
        assertEq(second.nullifierHash, first.nullifierHash, "nullifier is not identity-stable");
        vm.prank(relayer);
        vm.expectRevert(AnonVoting.NullifierAlreadyUsed.selector);
        voting.castVote(proposalId, second.proof, second.nullifierHash, second.support);
    }

    function test_RevertWhen_BallotIsFlippedInFlight() public {
        Ballot memory b = _ballot(".yesVote");
        // A hostile relayer tries to turn a yes into a no. `vote` is a bound public input, so the
        // proof no longer matches and HonkVerifier rejects it.
        vm.prank(relayer);
        vm.expectRevert();
        voting.castVote(proposalId, b.proof, b.nullifierHash, 0);
    }

    function test_RevertWhen_NullifierIsTamperedWith() public {
        Ballot memory b = _ballot(".yesVote");
        vm.prank(relayer);
        vm.expectRevert();
        voting.castVote(proposalId, b.proof, bytes32(uint256(b.nullifierHash) ^ 1), b.support);
    }

    function test_RevertWhen_ProofIsReplayedOnAnotherProposal() public {
        vm.prank(_member(0));
        uint256 other = voting.createProposal(keccak256("Something else"), uint64(block.timestamp) + VOTING_PERIOD);

        Ballot memory b = _ballot(".yesVote");
        // proposal_id is a public input, so a ballot cannot be lifted onto a different proposal.
        vm.prank(relayer);
        vm.expectRevert();
        voting.castVote(other, b.proof, b.nullifierHash, b.support);
    }

    function test_RevertWhen_VotingAfterDeadline() public {
        Ballot memory b = _ballot(".yesVote");
        vm.warp(block.timestamp + VOTING_PERIOD);
        vm.prank(relayer);
        vm.expectRevert(AnonVoting.VotingClosed.selector);
        voting.castVote(proposalId, b.proof, b.nullifierHash, b.support);
    }

    function test_RevertWhen_SupportOutOfRange() public {
        Ballot memory b = _ballot(".yesVote");
        vm.prank(relayer);
        vm.expectRevert(AnonVoting.InvalidSupport.selector);
        voting.castVote(proposalId, b.proof, b.nullifierHash, 2);
    }

    /* ------------------------------------------------------------------ registry rules */

    function test_RevertWhen_TokenRegistersTwice() public {
        vm.prank(_member(0));
        vm.expectRevert(MemberRegistry.TokenAlreadyRegistered.selector);
        registry.register(1, uint256(keccak256("another commitment")) >> 4);
    }

    function test_RevertWhen_NewOwnerReusesTransferredToken() public {
        address buyer = makeAddr("buyer");
        vm.prank(_member(0));
        nft.transferFrom(_member(0), buyer, 1);

        // Buying a registered NFT does not buy a second commitment slot.
        vm.prank(buyer);
        vm.expectRevert(MemberRegistry.TokenAlreadyRegistered.selector);
        registry.register(1, uint256(keccak256("buyer commitment")) >> 4);
    }

    function test_RevertWhen_NonHolderRegisters() public {
        address outsider = makeAddr("outsider");
        vm.prank(dao);
        uint256 tokenId = nft.mint(_member(0));

        vm.prank(outsider);
        vm.expectRevert(MemberRegistry.NotTokenOwner.selector);
        registry.register(tokenId, uint256(keccak256("outsider")) >> 4);
    }

    function test_RevertWhen_LateJoinerVotesOnEarlierProposal() public {
        // Registering after the snapshot changes the live root but not the proposal's, so the
        // newcomer has no witness against the root this proposal pinned.
        uint256 rootBefore = voting.getProposal(proposalId).merkleRoot;
        vm.prank(dao);
        uint256 tokenId = nft.mint(_member(900));
        vm.prank(_member(900));
        registry.register(tokenId, uint256(keccak256("latecomer")) >> 4);

        assertTrue(registry.root() != rootBefore, "registry root should have moved");
        assertEq(voting.getProposal(proposalId).merkleRoot, rootBefore, "snapshot must not move");
    }

    function test_RevertWhen_ProposalOpenedByNonMember() public {
        vm.prank(makeAddr("nobody"));
        vm.expectRevert(AnonVoting.NotAMember.selector);
        voting.createProposal(keccak256("hostile"), uint64(block.timestamp) + VOTING_PERIOD);
    }
}
