{
  "name": "dao-anon-voting",
  "private": true,
  "type": "module",
  "description": "Anonymous yes/no governance voting for a public 150-member DAO \u2014 Noir circuit, Solidity contracts, and the client that ties them together.",
  "scripts": {
    "circuit": "./circuits/build.sh",
    "fixture": "node scripts/gen-fixture.mjs",
    "parity": "node scripts/hash-parity.mjs",
    "test": "cd contracts && forge test",
    "deploy": "cd contracts && forge script script/Deploy.s.sol --rpc-url ${RPC_URL:-http://127.0.0.1:8545} --broadcast --skip-simulation",
    "register": "node scripts/register.mjs",
    "propose": "node scripts/propose.mjs",
    "vote": "node scripts/vote.mjs",
    "tally": "node scripts/tally.mjs",
    "demo": "./scripts/demo.sh"
  },
  "dependencies": {
    "@aztec/bb.js": "5.1.0",
    "@noir-lang/noir_js": "1.0.0-beta.26",
    "@zk-kit/lean-imt": "^2.2.2",
    "ethers": "^6.13.4",
    "poseidon-lite": "^0.3.0"
  }
}
