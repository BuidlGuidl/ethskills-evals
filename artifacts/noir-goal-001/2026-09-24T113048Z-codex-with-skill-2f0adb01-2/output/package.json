{
  "name": "eval-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build:circuit": "HOME=$PWD/.home XDG_CACHE_HOME=$PWD/.cache-local sh -c 'cd circuits/vote && nargo compile && bb write_vk --oracle_hash keccak -b target/vote.json -o target && bb write_solidity_verifier -k target/vk -o ../../contracts/src/verifiers/HonkVerifier.sol'",
    "build": "npm run build:circuit && forge build",
    "deploy:local": "forge script script/DeployLocal.s.sol:DeployLocal --rpc-url ${RPC_URL:-http://127.0.0.1:8545} --private-key ${PRIVATE_KEY:-0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80} --broadcast",
    "vote:local": "env -u NODE_OPTIONS node scripts/cast-vote.mjs"
  },
  "devDependencies": {
    "@aztec/bb.js": "^5.1.0",
    "@noir-lang/noir_js": "^1.0.0-rc.3",
    "@zk-kit/lean-imt": "^2.2.5",
    "@zk-kit/lean-imt.sol": "^2.0.1",
    "ethers": "^6.17.0",
    "forge-std": "^1.1.2",
    "poseidon-lite": "^0.3.0"
  }
}
