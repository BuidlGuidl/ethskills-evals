{
  "name": "anon-dao-voting",
  "private": true,
  "type": "module",
  "description": "Anonymous yes/no DAO governance: public membership, unattributable ballots (Noir + Solidity).",
  "scripts": {
    "build:circuit": "./scripts/build-circuit.sh",
    "build:contracts": "cd contracts && forge build",
    "test:circuit": "cd circuits/ballot && nargo test",
    "test:contracts": "cd contracts && forge test",
    "test": "npm run test:circuit && npm run test:contracts",
    "fixtures": "node js/fixtures.mjs",
    "deploy:local": "cd contracts && forge script script/Deploy.s.sol --rpc-url ${RPC_URL:-http://127.0.0.1:8545} --broadcast",
    "demo": "node js/demo.mjs"
  },
  "dependencies": {
    "@aztec/bb.js": "^5.1.0",
    "@noir-lang/noir_js": "^1.0.0-beta.26",
    "@zk-kit/lean-imt": "^2.2.4",
    "ethers": "^6.13.5",
    "poseidon-lite": "^0.3.0"
  }
}
