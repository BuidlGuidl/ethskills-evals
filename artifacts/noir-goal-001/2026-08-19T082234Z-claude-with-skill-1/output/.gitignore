# Generated. Nothing here is written by hand; all of it is reproducible with
# `npm install`, `nargo compile` and `forge build`.
node_modules/
out/
cache/
broadcast/
circuits/vote/target/

# Local chain addresses, rewritten by every deploy.
deployments/

# MEMBER SECRETS. A note file is the only thing that can cast that member's
# ballot: anyone who reads one can vote as them, and can also recompute their
# nullifiers and prove after the fact how they voted. Never commit, never sync.
notes/

# NOTE: lib/ is deliberately NOT ignored — forge-std and poseidon-solidity are
# git submodules (see .gitmodules), which is how their exact revisions are
# pinned. Restore them with `git submodule update --init --recursive`.
