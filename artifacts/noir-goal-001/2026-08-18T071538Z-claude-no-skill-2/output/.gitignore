# Generated — nothing in here is written by hand.
node_modules/
out/
cache/
broadcast/

# forge-std, installed by `forge install`
lib/

# nargo/bb build output (acir, vk, proofs) and the per-proof Prover.toml
# that js/lib/prover.js writes
circuits/*/target/
circuits/*/Prover.toml

# written by script/Deploy.s.sol
deployments/*.json

# Member voting secrets. Losing one lets someone vote as that member;
# leaking one lets them prove how that member voted.
.secrets/
