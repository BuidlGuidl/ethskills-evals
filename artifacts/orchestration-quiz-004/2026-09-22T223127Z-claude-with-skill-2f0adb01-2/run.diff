@@ -15,6 +17,19 @@ chain: setup-anvil-wallet
 fork: setup-anvil-wallet
 	anvil --fork-url ${FORK_URL} --chain-id 31337
 
+# Verify the local node is really a fork of Base.
+# `cast chain-id` cannot tell you this: the `fork` target pins --chain-id 31337,
+# so every fork (and a bare `yarn chain`) reports 31337. Probe chain-specific
+# state instead -- Base USDC, which only has code on Base.
+fork-check:
+	@USDC=$$(cast code 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913 --rpc-url $(RPC)); \
+	if [ "$$USDC" = "0x" ] || [ -z "$$USDC" ]; then \
+		echo "FAIL: no code at Base USDC on $(RPC) -- this is not a fork of Base."; \
+		exit 1; \
+	fi; \
+	SYM=$$(cast call 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913 "symbol()(string)" --rpc-url $(RPC)); \
+	echo "OK: Base USDC present, symbol()=$$SYM"
+
 # Deploy the contracts
 deploy:
 	@if [ ! -f "$(DEPLOY_SCRIPT)" ]; then 		echo "Error: Deploy script '$(DEPLOY_SCRIPT)' not found"; 		exit 1; 	fi
