+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.28;
+
+/// @notice Base mainnet (chainid 8453) addresses used by the strategy.
+/// @dev Each of these was read back onchain during development; see README "Integration
+///      verification" for the exact calls and their results.
+library BaseAddresses {
+    // Tokens
+    address internal constant USDC = 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913; // native Circle USDC, 6dp
+    address internal constant WETH = 0x4200000000000000000000000000000000000006; // canonical OP-stack WETH
+    address internal constant AERO = 0x940181a94A35A4569E4529A3CDfB74e38FD98631;
+
+    // Aerodrome core
+    address internal constant ROUTER = 0xcF77a3Ba9A5CA399B7c97c74d54e5b1Beb874E43;
+    address internal constant POOL_FACTORY = 0x420DD381b31aEf6683db6B902084cB0FFECe40Da;
+    address internal constant VOTER = 0x16613524e02ad97eDfeF371bC883F2F5d6C480A5;
+
+    // vAMM-WETH/USDC pool and its gauge
+    address internal constant POOL_WETH_USDC = 0xcDAC0d6c6C59727a65F871236188350531885C43;
+    address internal constant GAUGE_WETH_USDC = 0x519BBD1Dd8C6A94C46080E24f316c14Ee758C025;
+
+    // Fork pin. Chosen while the gauge was live (isAlive == true, rewardRate > 0).
+    uint256 internal constant FORK_BLOCK = 50_243_000;
+}
diff --git a/test/fork/BaseFork.t.sol b/test/fork/BaseFork.t.sol
new file mode 100644
index 0000000..df65a3e
--- /dev/null
+++ b/test/fork/BaseFork.t.sol
@@ -0,0 +1,559 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.28;
+
+import {Test, console2} from "forge-std/Test.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+
+import {YieldVault} from "../../src/YieldVault.sol";
+import {AerodromeUsdcWethStrategy} from "../../src/AerodromeUsdcWethStrategy.sol";
+import {IPool, IRouter, IGauge, IVoter, IPoolFactory} from "../../src/interfaces/IAerodrome.sol";
+import {BaseAddresses as A} from "../BaseAddresses.sol";
+
+/// @notice Fork tests against live Base state. These are the tests that actually prove the
+///         integration composes: everything else is mocked and can only prove our own logic.
+contract BaseForkTest is Test {
+    YieldVault vault;
+    AerodromeUsdcWethStrategy strategy;
+
+    IERC20 usdc = IERC20(A.USDC);
+    IERC20 weth = IERC20(A.WETH);
+    IERC20 aero = IERC20(A.AERO);
+    IPool pool = IPool(A.POOL_WETH_USDC);
+    IGauge gauge = IGauge(A.GAUGE_WETH_USDC);
+    IRouter router = IRouter(A.ROUTER);
+
+    address owner = makeAddr("owner");
+    address keeper = makeAddr("keeper");
+    address treasury = makeAddr("treasury");
+    address alice = makeAddr("alice");
+    address bob = makeAddr("bob");
+
+    /// @dev Sized to fit inside one `earn()` tranche at the pinned block (`maxDeployable()` is
+    ///      ~2 * 0.25% of the ~4.19M USDC reserve, i.e. ~21k). Chunking is covered separately.
+    uint256 constant DEPOSIT = 20_000e6;
+
+    function setUp() public {
+        // Skip rather than fail when there is no Base RPC reachable, so that `forge test` in an
+        // offline environment still runs the unit suite to completion.
+        try vm.createSelectFork(vm.envOr("BASE_RPC_URL", string("https://mainnet.base.org")), A.FORK_BLOCK) {}
+        catch {
+            vm.skip(true);
+            return;
+        }
+
+        vault = new YieldVault(A.USDC, owner, keeper, 0);
+        strategy = new AerodromeUsdcWethStrategy(
+            AerodromeUsdcWethStrategy.Config({
+                vault: address(vault),
+                usdc: A.USDC,
+                weth: A.WETH,
+                aero: A.AERO,
+                router: A.ROUTER,
+                gauge: A.GAUGE_WETH_USDC,
+                owner: owner,
+                keeper: keeper,
+                treasury: treasury
+            })
+        );
+
+        vm.prank(owner);
+        vault.setStrategy(address(strategy));
+
+        deal(A.USDC, alice, 1_000_000e6);
+        deal(A.USDC, bob, 1_000_000e6);
+    }
+
+    /* ---------------------------------------------------------------- */
+    /*                     LIVE INTEGRATION INVARIANTS                  */
+    /* ---------------------------------------------------------------- */
+
+    /// @notice Re-checks at fork time everything the constructor and the README claim about the
+    ///         external contracts. If Aerodrome migrates the gauge or kills it, this fails loudly.
+    function test_LiveIntegrationAssumptions() public view {
+        // Pool identity and ordering
+        assertEq(pool.token0(), A.WETH, "token0 should be WETH");
+        assertEq(pool.token1(), A.USDC, "token1 should be USDC");
+        assertFalse(pool.stable(), "pool must be volatile (vAMM)");
+        assertFalse(strategy.usdcIsToken0(), "strategy must have detected USDC as token1");
+
+        // Router wiring
+        assertEq(router.defaultFactory(), A.POOL_FACTORY, "router default factory");
+        assertEq(IPoolFactory(A.POOL_FACTORY).getPool(A.USDC, A.WETH, false), A.POOL_WETH_USDC, "factory pool lookup");
+
+        // Gauge is the canonical, live gauge for this pool and pays AERO
+        assertEq(IVoter(A.VOTER).gauges(A.POOL_WETH_USDC), A.GAUGE_WETH_USDC, "voter gauge lookup");
+        assertTrue(IVoter(A.VOTER).isAlive(A.GAUGE_WETH_USDC), "gauge must be alive");
+        assertEq(gauge.stakingToken(), A.POOL_WETH_USDC, "gauge staking token");
+        assertEq(gauge.rewardToken(), A.AERO, "gauge reward token must be AERO");
+
+        // Pool has a usable TWAP history
+        assertGt(pool.observationLength(), strategy.twapGranularity() + 1, "insufficient TWAP observations");
+
+        // The pool has real depth; a vault of our size should not be a majority of it
+        (uint256 r0, uint256 r1,) = pool.getReserves();
+        assertGt(r0, 100e18, "WETH reserve too thin");
+        assertGt(r1, 1_000_000e6, "USDC reserve too thin");
+
+        console2.log("WETH reserve", r0);
+        console2.log("USDC reserve", r1);
+        console2.log("TWAP  WETH/USDC", strategy.twapWethPrice());
+        console2.log("spot  WETH/USDC", strategy.spotWethPrice());
+    }
+
+    /// @notice The gauge is actively emitting at the pinned block, so harvest has something to do.
+    function test_GaugeIsEmitting() public view {
+        (bool ok, bytes memory data) = A.GAUGE_WETH_USDC.staticcall(abi.encodeWithSignature("rewardRate()"));
+        assertTrue(ok, "rewardRate() call failed");
+        uint256 rate = abi.decode(data, (uint256));
+        assertGt(rate, 0, "gauge is not emitting");
+        console2.log("weekly AERO to gauge", (rate * 7 days) / 1e18);
+    }
+
+    /* ---------------------------------------------------------------- */
+    /*                        DEPOSIT / DEPLOY                          */
+    /* ---------------------------------------------------------------- */
+
+    function _deposit(address who, uint256 amount) internal {
+        vm.startPrank(who);
+        usdc.approve(address(vault), amount);
+        vault.deposit(amount, who);
+        vm.stopPrank();
+    }
+
+    /// @dev Drains idle in tranches. On a static fork nothing arbitrages the pool back between
+    ///      calls, so later tranches legitimately trip `maxSwapImpactBps`; in production the pool
+    ///      re-anchors between blocks. Stopping early is the correct behaviour, not a failure.
+    function _drainIdle() internal returns (uint256 calls) {
+        for (uint256 i = 0; i < 16; i++) {
+            if (strategy.idleUsdc() == 0) break;
+            vm.prank(keeper);
+            try strategy.earn() {
+                calls++;
+            } catch {
+                break;
+            }
+        }
+    }
+
+    function _depositAndDeploy(address who, uint256 amount) internal {
+        _deposit(who, amount);
+        vm.startPrank(keeper);
+        vault.pushToStrategy();
+        strategy.earn();
+        vm.stopPrank();
+    }
+
+    function test_DepositIsIdleUntilKeeperDeploys() public {
+        _deposit(alice, DEPOSIT);
+
+        assertEq(vault.idleAssets(), DEPOSIT, "deposit should sit idle in the vault");
+        assertEq(strategy.lpBalance(), 0, "nothing deployed yet");
+        assertEq(vault.totalAssets(), DEPOSIT, "totalAssets must count idle");
+
+        vm.startPrank(keeper);
+        vault.pushToStrategy();
+        strategy.earn();
+        vm.stopPrank();
+
+        assertEq(vault.idleAssets(), 0, "vault should be swept");
+        assertGt(strategy.lpBalance(), 0, "LP position expected");
+        assertEq(gauge.balanceOf(address(strategy)), strategy.lpBalance(), "all LP must be staked");
+    }
+
+    /// @notice Entering a 50/50 pool one-sided costs, on the swapped half: the 0.3% pool fee,
+    ///         the price impact of the tranche, and whatever gap spot currently has to the TWAP we
+    ///         value the result against. At the pinned block that last term is ~64bps of the half,
+    ///         which is measurement lag rather than realised loss. Budget 75bps in total.
+    function test_DeployPreservesValueWithinSwapCost() public {
+        _depositAndDeploy(alice, DEPOSIT);
+
+        uint256 ta = vault.totalAssets();
+        assertGt(ta, (DEPOSIT * 9_925) / 10_000, "lost more than 75bps deploying");
+        assertLt(ta, (DEPOSIT * 10_010) / 10_000, "gained value out of nowhere");
+        console2.log("totalAssets after deploy", ta);
+    }
+
+    /// @notice A deposit larger than the pool can absorb in one go is deployed in tranches
+    ///         instead of being forced through at a bad price. The undeployed remainder stays
+    ///         idle and keeps counting toward totalAssets, so nothing is lost by waiting.
+    function test_LargeDepositIsDeployedInTranches() public {
+        uint256 big = 200_000e6;
+        _deposit(alice, big);
+
+        uint256 cap = strategy.maxDeployable();
+        assertLt(cap, big, "test setup: deposit should exceed one tranche");
+        console2.log("maxDeployable per call", cap);
+
+        vm.startPrank(keeper);
+        vault.pushToStrategy();
+        strategy.earn();
+        vm.stopPrank();
+
+        assertApproxEqRel(strategy.idleUsdc(), big - cap, 0.01e18, "should have deployed exactly one tranche");
+        assertGt(strategy.lpBalance(), 0, "first tranche not deployed");
+        // Value is preserved across the partial deploy: idle USDC still counts.
+        assertApproxEqRel(vault.totalAssets(), big, 0.005e18, "value lost while partially deployed");
+
+        // Draining the rest takes several more calls; value stays intact throughout.
+        uint256 calls = _drainIdle();
+        assertGt(calls, 0, "no further tranches deployed");
+        assertApproxEqRel(vault.totalAssets(), big, 0.02e18, "excessive loss deploying in tranches");
+    }
+
+    /// @notice The size cap is what keeps the strategy from tripping its own dislocation guard:
+    ///         one full tranche must leave spot comfortably inside `maxDeviationBps` of the TWAP.
+    function test_TrancheSizeKeepsPoolInsideItsOwnBand() public {
+        _depositAndDeploy(alice, DEPOSIT);
+        uint256 dev = _absDiffBps(strategy.twapWethPrice(), strategy.spotWethPrice());
+        console2.log("spot-vs-TWAP deviation after a tranche (bps)", dev);
+        assertLt(dev, strategy.maxDeviationBps(), "one tranche dislocated the pool past our own bound");
+    }
+
+    /* ---------------------------------------------------------------- */
+    /*                             HARVEST                              */
+    /* ---------------------------------------------------------------- */
+
+    function test_HarvestClaimsAeroAndCompounds() public {
+        _depositAndDeploy(alice, DEPOSIT);
+
+        uint256 lpBefore = strategy.lpBalance();
+        uint256 taBefore = vault.totalAssets();
+        uint256 sharePriceBefore = vault.convertToAssets(1e12);
+
+        vm.warp(block.timestamp + 2 days);
+
+        uint256 pending = strategy.pendingRewards();
+        assertGt(pending, 1e18, "expected meaningful AERO to accrue over 2 days");
+        console2.log("pending AERO", pending);
+
+        vm.prank(keeper);
+        (uint256 claimed, uint256 compounded,) = strategy.harvest(0);
+
+        assertGt(claimed, 0, "no AERO claimed");
+        assertEq(aero.balanceOf(address(strategy)), 0, "AERO should be fully swapped");
+        assertGt(strategy.lpBalance(), lpBefore, "LP position must grow");
+        assertGt(vault.totalAssets(), taBefore, "totalAssets must grow");
+        assertGt(vault.convertToAssets(1e12), sharePriceBefore, "share price must rise");
+        assertGt(usdc.balanceOf(treasury), 0, "performance fee not paid");
+
+        console2.log("AERO claimed", claimed);
+        console2.log("USDC compounded", compounded);
+        console2.log("perf fee to treasury", usdc.balanceOf(treasury));
+    }
+
+    /// @notice Performance fee is exactly `performanceFeeBps` of the USDC realised from AERO.
+    function test_HarvestPerformanceFeeIsExact() public {
+        _depositAndDeploy(alice, DEPOSIT);
+        vm.warp(block.timestamp + 2 days);
+
+        vm.prank(keeper);
+        (, uint256 compounded,) = strategy.harvest(0);
+
+        uint256 fee = usdc.balanceOf(treasury);
+        uint256 gross = compounded + fee;
+        assertApproxEqAbs(fee, (gross * strategy.performanceFeeBps()) / 10_000, 1, "fee math");
+    }
+
+    function test_HarvestRevertsBelowDustThreshold() public {
+        _depositAndDeploy(alice, DEPOSIT);
+        vm.warp(block.timestamp + 60);
+        vm.prank(keeper);
+        vm.expectRevert(AerodromeUsdcWethStrategy.NothingToHarvest.selector);
+        strategy.harvest(0);
+    }
+
+    function test_HarvestRespectsKeeperMinOut() public {
+        _depositAndDeploy(alice, DEPOSIT);
+        vm.warp(block.timestamp + 2 days);
+
+        vm.prank(keeper);
+        vm.expectRevert(); // router reverts: INSUFFICIENT_OUTPUT_AMOUNT
+        strategy.harvest(type(uint128).max);
+    }
+
+    function test_HarvestOnlyKeeper() public {
+        _depositAndDeploy(alice, DEPOSIT);
+        vm.warp(block.timestamp + 2 days);
+        vm.prank(alice);
+        vm.expectRevert(AerodromeUsdcWethStrategy.NotKeeper.selector);
+        strategy.harvest(0);
+    }
+
+    /* ---------------------------------------------------------------- */
+    /*                            WITHDRAW                              */
+    /* ---------------------------------------------------------------- */
+
+    function test_FullRoundTrip() public {
+        _depositAndDeploy(alice, DEPOSIT);
+
+        uint256 shares = vault.balanceOf(alice);
+        vm.prank(alice);
+        uint256 got = vault.redeem(shares, alice, alice);
+
+        // Deploy cost + unwind cost + the vault's 30bps entry and exit fees.
+        assertGt(got, (DEPOSIT * 9_800) / 10_000, "round trip lost more than 2%");
+        assertLe(got, DEPOSIT, "cannot profit from a round trip with no yield");
+        assertEq(vault.balanceOf(alice), 0, "shares must burn");
+        console2.log("round-trip USDC", got);
+    }
+
+    function test_PartialWithdrawLeavesPositionIntact() public {
+        _depositAndDeploy(alice, DEPOSIT);
+
+        uint256 lpBefore = strategy.lpBalance();
+        uint256 balBefore = usdc.balanceOf(alice);
+        vm.prank(alice);
+        vault.withdraw(DEPOSIT / 4, alice, alice);
+
+        assertEq(usdc.balanceOf(alice) - balBefore, DEPOSIT / 4, "exact asset amount owed");
+        assertLt(strategy.lpBalance(), lpBefore, "LP must be partially burned");
+        assertGt(strategy.lpBalance(), (lpBefore * 70) / 100, "burned far too much LP");
+    }
+
+    function test_WithdrawServedFromIdleWithoutTouchingLp() public {
+        _depositAndDeploy(alice, DEPOSIT);
+
+        // A fresh deposit that has not been pushed yet is pure idle.
+        _deposit(bob, DEPOSIT);
+
+        uint256 lpBefore = strategy.lpBalance();
+        vm.prank(bob);
+        vault.withdraw(1_000e6, bob, bob);
+        assertEq(strategy.lpBalance(), lpBefore, "idle should have covered it");
+    }
+
+    /// @notice A user exit is never blocked by its own size: the withdrawer bears the price
+    ///         impact rather than being locked in. Keeper operations, which can be split, do get
+    ///         blocked by `maxSwapImpactBps` - that asymmetry is deliberate.
+    function test_LargeWithdrawIsNotBlockedByItsOwnImpact() public {
+        uint256 big = 200_000e6;
+        _deposit(alice, big);
+        vm.prank(keeper);
+        vault.pushToStrategy();
+        _drainIdle();
+
+        uint256 shares = vault.balanceOf(alice);
+        vm.prank(alice);
+        uint256 got = vault.redeem(shares, alice, alice);
+
+        assertGt(got, (big * 9_500) / 10_000, "exit cost more than 5%");
+        console2.log("large exit received", got);
+    }
+
+    /* ---------------------------------------------------------------- */
+    /*                      SHARE-PRICE FAIRNESS                        */
+    /* ---------------------------------------------------------------- */
+
+    /// @notice A depositor arriving after a harvest must not capture yield generated before them,
+    ///         and must not dilute the incumbent.
+    function test_LateDepositorDoesNotStealYield() public {
+        _depositAndDeploy(alice, DEPOSIT);
+        uint256 aliceAfterDeploy = vault.convertToAssets(vault.balanceOf(alice));
+
+        vm.warp(block.timestamp + 2 days);
+        vm.prank(keeper);
+        strategy.harvest(0);
+
+        uint256 alicePreview = vault.convertToAssets(vault.balanceOf(alice));
+        assertGt(alicePreview, aliceAfterDeploy, "harvest yield should accrue to the incumbent");
+
+        _depositAndDeploy(bob, DEPOSIT);
+
+        uint256 bobPreview = vault.convertToAssets(vault.balanceOf(bob));
+        assertLt(bobPreview, alicePreview, "bob must not own as much as the earlier depositor");
+        assertApproxEqRel(bobPreview, aliceAfterDeploy, 0.01e18, "bob should own ~what he put in");
+
+        // Bob's arrival must not meaningfully dilute Alice. It is not exactly zero: deploying
+        // Bob's USDC swaps half of it, and the freshly bought WETH is then marked at the TWAP,
+        // which still lags the price we just paid. The entry fee covers the persistent part of
+        // that cost (pool fee + impact); the residual is a mark-to-TWAP artifact that unwinds as
+        // the TWAP re-anchors. Bound it tightly rather than pretending it is zero.
+        uint256 aliceAfterBob = vault.convertToAssets(vault.balanceOf(alice));
+        assertGt(aliceAfterBob, (alicePreview * 9_975) / 10_000, "alice diluted by more than 25bps");
+        console2.log("alice before bob", alicePreview);
+        console2.log("alice after  bob", aliceAfterBob);
+    }
+
+    /* ---------------------------------------------------------------- */
+    /*                    MANIPULATION / FAILURE MODES                  */
+    /* ---------------------------------------------------------------- */
+
+    /// @dev USDC the last `_skewPool` extracted, so it can be swapped straight back.
+    uint256 skewUsdcOut;
+
+    /// @dev Swap a large amount of WETH into the pool to skew the reserve split hard.
+    function _skewPool(uint256 wethIn) internal {
+        address attacker = makeAddr("attacker");
+        deal(A.WETH, attacker, wethIn);
+        IRouter.Route[] memory r = new IRouter.Route[](1);
+        r[0] = IRouter.Route({from: A.WETH, to: A.USDC, stable: false, factory: A.POOL_FACTORY});
+        vm.startPrank(attacker);
+        weth.approve(address(router), wethIn);
+        uint256[] memory amounts = router.swapExactTokensForTokens(wethIn, 0, r, attacker, block.timestamp);
+        vm.stopPrank();
+        skewUsdcOut = amounts[amounts.length - 1];
+    }
+
+    /// @notice The whole point of fair-LP pricing: skewing the reserve split must not move the
+    ///         reported value of the position, because the invariant k is unchanged.
+    function test_FairPricingIgnoresReserveSkew() public {
+        _depositAndDeploy(alice, DEPOSIT);
+        uint256 taBefore = vault.totalAssets();
+
+        _skewPool(200e18);
+
+        // Naive pricing (reserveUSDC * lp / supply * 2) would have moved a lot here.
+        uint256 taAfter = vault.totalAssets();
+        assertApproxEqRel(taAfter, taBefore, 0.003e18, "fair pricing moved with the reserve skew");
+        console2.log("totalAssets before skew", taBefore);
+        console2.log("totalAssets after  skew", taAfter);
+    }
+
+    /// @notice With spot dislocated from TWAP, the strategy refuses to transact rather than
+    ///         trading into the manipulated price. Fail closed, not open.
+    function test_PriceBandBlocksDepositAndWithdrawWhileDislocated() public {
+        _depositAndDeploy(alice, DEPOSIT);
+
+        _skewPool(400e18);
+
+        assertGt(
+            _absDiffBps(strategy.twapWethPrice(), strategy.spotWethPrice()),
+            strategy.maxDeviationBps(),
+            "test setup: pool not dislocated enough"
+        );
+
+        vm.prank(alice);
+        vm.expectRevert(
+            abi.encodeWithSelector(
+                AerodromeUsdcWethStrategy.PriceOutOfBand.selector, strategy.twapWethPrice(), strategy.spotWethPrice()
+            )
+        );
+        vault.withdraw(10_000e6, alice, alice);
+
+        // Minting shares against a dislocated oracle is blocked at the vault boundary.
+        vm.startPrank(bob);
+        usdc.approve(address(vault), DEPOSIT);
+        vm.expectRevert();
+        vault.deposit(DEPOSIT, bob);
+        vm.stopPrank();
+    }
+
+    /// @dev Push the pool back toward its TWAP, standing in for arbitrage. Swaps back exactly
+    ///      what the skew extracted, which lands the reserves within fees of where they started.
+    function _unskewPool() internal {
+        address arb = makeAddr("arb");
+        uint256 usdcIn = skewUsdcOut;
+        deal(A.USDC, arb, usdcIn);
+        IRouter.Route[] memory r = new IRouter.Route[](1);
+        r[0] = IRouter.Route({from: A.USDC, to: A.WETH, stable: false, factory: A.POOL_FACTORY});
+        vm.startPrank(arb);
+        usdc.approve(address(router), usdcIn);
+        router.swapExactTokensForTokens(usdcIn, 0, r, arb, block.timestamp);
+        vm.stopPrank();
+    }
+
+    function _absDiffBps(uint256 a, uint256 b) internal pure returns (uint256) {
+        uint256 d = a > b ? a - b : b - a;
+        return (d * 10_000) / a;
+    }
+
+    /* ---------------------------------------------------------------- */
+    /*                             EMERGENCY                            */
+    /* ---------------------------------------------------------------- */
+
+    function test_EmergencyExitUnwindsAndBlocksRedeploy() public {
+        _depositAndDeploy(alice, DEPOSIT);
+
+        vm.prank(owner);
+        strategy.emergencyExit();
+
+        assertEq(strategy.lpBalance(), 0, "position must be fully unwound");
+        assertGt(strategy.idleUsdc(), (DEPOSIT * 9_850) / 10_000, "recovered too little");
+
+        vm.prank(keeper);
+        vm.expectRevert(AerodromeUsdcWethStrategy.IsEmergencyExited.selector);
+        strategy.earn();
+
+        // Users can still get out.
+        uint256 aliceShares = vault.balanceOf(alice);
+        vm.prank(alice);
+        uint256 got = vault.redeem(aliceShares, alice, alice);
+        assertGt(got, (DEPOSIT * 9_800) / 10_000, "user could not exit");
+        assertEq(vault.balanceOf(alice), 0, "shares must burn");
+    }
+
+    /// @notice The emergency path must work *during* an emergency. Unstaking and removing
+    ///         liquidity are proportional, so they run unconditionally; only the price-sensitive
+    ///         WETH leg is deferred rather than dumped into a dislocated pool.
+    function test_EmergencyExitWorksWhilePoolIsDislocated() public {
+        _depositAndDeploy(alice, DEPOSIT);
+        uint256 taBefore = vault.totalAssets();
+
+        _skewPool(400e18);
+        assertGt(
+            _absDiffBps(strategy.twapWethPrice(), strategy.spotWethPrice()),
+            strategy.maxDeviationBps(),
+            "test setup: pool not dislocated"
+        );
+
+        vm.prank(owner);
+        strategy.emergencyExit();
+
+        assertEq(strategy.lpBalance(), 0, "must still get out of the gauge and the pool");
+        assertGt(weth.balanceOf(address(strategy)), 0, "WETH leg should be deferred, not dumped");
+        // Value is not lost, just held in two legs instead of one.
+        assertApproxEqRel(vault.totalAssets(), taBefore, 0.02e18, "value lost during emergency exit");
+    }
+
+    /// @notice Once the pool re-anchors, the deferred leg can be finished.
+    function test_ConvertStrandedWethFinishesTheExit() public {
+        _depositAndDeploy(alice, DEPOSIT);
+        _skewPool(400e18);
+
+        vm.prank(owner);
+        strategy.emergencyExit();
+        assertGt(weth.balanceOf(address(strategy)), 0);
+
+        // While still dislocated the conversion refuses to run.
+        vm.prank(keeper);
+        vm.expectRevert();
+        strategy.convertStrandedWeth();
+
+        // Arbitrage pushes the pool back; now it goes through.
+        _unskewPool();
+        vm.prank(keeper);
+        uint256 out = strategy.convertStrandedWeth();
+
+        assertGt(out, 0, "conversion produced nothing");
+        assertEq(weth.balanceOf(address(strategy)), 0, "WETH should be fully converted");
+    }
+
+    function test_RetireStrategyPullsEverythingBackToVault() public {
+        _depositAndDeploy(alice, DEPOSIT);
+
+        vm.prank(owner);
+        vault.retireStrategy();
+
+        assertEq(strategy.lpBalance(), 0, "strategy still holds LP");
+        assertGt(vault.idleAssets(), (DEPOSIT * 9_850) / 10_000, "vault did not receive funds");
+    }
+
+    /* ---------------------------------------------------------------- */
+    /*                              FUZZ                                */
+    /* ---------------------------------------------------------------- */
+
+    function testFuzz_RoundTripNeverMints(uint256 amount) public {
+        amount = bound(amount, 100e6, 20_000e6);
+        deal(A.USDC, alice, amount);
+
+        _depositAndDeploy(alice, amount);
+
+        uint256 shares = vault.balanceOf(alice);
+        uint256 balBefore = usdc.balanceOf(alice);
+        vm.prank(alice);
+        vault.redeem(shares, alice, alice);
+        uint256 got = usdc.balanceOf(alice) - balBefore;
+        assertLe(got, amount, "round trip created value from nothing");
+        assertGt(got, (amount * 9_750) / 10_000, "round trip lost more than 2.5%");
+    }
+}
diff --git a/test/fork/StrategyAdmin.t.sol b/test/fork/StrategyAdmin.t.sol
new file mode 100644
index 0000000..7f87437
--- /dev/null
+++ b/test/fork/StrategyAdmin.t.sol
@@ -0,0 +1,259 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.28;
+
+import {Test} from "forge-std/Test.sol";
+import {Ownable} from "@openzeppelin/contracts/access/Ownable.sol";
+
+import {YieldVault} from "../../src/YieldVault.sol";
+import {AerodromeUsdcWethStrategy} from "../../src/AerodromeUsdcWethStrategy.sol";
+import {BaseAddresses as A} from "../BaseAddresses.sol";
+import {MockERC20} from "../mocks/MockERC20.sol";
+
+/// @notice Governance surface, parameter bounds and constructor validation for the strategy.
+contract StrategyAdminTest is Test {
+    YieldVault vault;
+    AerodromeUsdcWethStrategy strategy;
+
+    address owner = makeAddr("owner");
+    address keeper = makeAddr("keeper");
+    address treasury = makeAddr("treasury");
+    address alice = makeAddr("alice");
+
+    function setUp() public {
+        try vm.createSelectFork(vm.envOr("BASE_RPC_URL", string("https://mainnet.base.org")), A.FORK_BLOCK) {}
+        catch {
+            vm.skip(true);
+            return;
+        }
+        vault = new YieldVault(A.USDC, owner, keeper, 0);
+        strategy = new AerodromeUsdcWethStrategy(_config(address(vault)));
+        vm.prank(owner);
+        vault.setStrategy(address(strategy));
+    }
+
+    function _config(address _vault) internal view returns (AerodromeUsdcWethStrategy.Config memory) {
+        return AerodromeUsdcWethStrategy.Config({
+            vault: _vault,
+            usdc: A.USDC,
+            weth: A.WETH,
+            aero: A.AERO,
+            router: A.ROUTER,
+            gauge: A.GAUGE_WETH_USDC,
+            owner: owner,
+            keeper: keeper,
+            treasury: treasury
+        });
+    }
+
+    function _params() internal pure returns (AerodromeUsdcWethStrategy.Params memory) {
+        return AerodromeUsdcWethStrategy.Params({
+            performanceFeeBps: 1_000,
+            slippageBps: 100,
+            maxSwapReserveBps: 25,
+            maxSwapImpactBps: 300,
+            maxDeviationBps: 500,
+            twapGranularity: 4,
+            withdrawBufferBps: 100,
+            minHarvestAero: 1e18
+        });
+    }
+
+    /* --------------------- constructor self-validation -------------------- */
+
+    /// @notice The strategy derives the pool from the gauge and cross-checks it against the
+    ///         router's factory, so a wrong or hostile gauge address cannot be installed.
+    function test_ConstructorRejectsWrongRewardToken() public {
+        AerodromeUsdcWethStrategy.Config memory c = _config(address(vault));
+        c.aero = A.WETH; // gauge pays AERO, not WETH
+        vm.expectRevert(bytes("gauge: reward token mismatch"));
+        new AerodromeUsdcWethStrategy(c);
+    }
+
+    function test_ConstructorRejectsWrongPoolTokens() public {
+        AerodromeUsdcWethStrategy.Config memory c = _config(address(vault));
+        c.usdc = A.AERO; // gauge's pool is WETH/USDC, not WETH/AERO
+        vm.expectRevert();
+        new AerodromeUsdcWethStrategy(c);
+    }
+
+    function test_ConstructorRejectsZeroAddresses() public {
+        AerodromeUsdcWethStrategy.Config memory c = _config(address(vault));
+        c.treasury = address(0);
+        vm.expectRevert(AerodromeUsdcWethStrategy.ZeroAddress.selector);
+        new AerodromeUsdcWethStrategy(c);
+    }
+
+    function test_ConstructorDerivesPoolAndOrdering() public view {
+        assertEq(address(strategy.pool()), A.POOL_WETH_USDC);
+        assertEq(address(strategy.aeroUsdcPool()), 0x6cDcb1C4A4D1C3C6d054b27AC5B77e89eAFb971d);
+        assertEq(strategy.poolFactory(), A.POOL_FACTORY);
+        assertFalse(strategy.usdcIsToken0(), "pool is WETH/USDC, so USDC is token1");
+    }
+
+    /* ---------------------------- access control -------------------------- */
+
+    function test_OnlyVaultCanWithdraw() public {
+        vm.prank(alice);
+        vm.expectRevert(AerodromeUsdcWethStrategy.NotVault.selector);
+        strategy.withdraw(1e6);
+
+        vm.prank(owner); // not even the owner may pull funds directly
+        vm.expectRevert(AerodromeUsdcWethStrategy.NotVault.selector);
+        strategy.withdrawAll();
+    }
+
+    function test_OnlyKeeperOrOwnerCanOperate() public {
+        vm.prank(alice);
+        vm.expectRevert(AerodromeUsdcWethStrategy.NotKeeper.selector);
+        strategy.earn();
+
+        vm.prank(alice);
+        vm.expectRevert(AerodromeUsdcWethStrategy.NotKeeper.selector);
+        strategy.harvest(0);
+    }
+
+    function test_OnlyOwnerGovernance() public {
+        vm.startPrank(alice);
+        vm.expectRevert(abi.encodeWithSelector(Ownable.OwnableUnauthorizedAccount.selector, alice));
+        strategy.setKeeper(alice);
+        vm.expectRevert(abi.encodeWithSelector(Ownable.OwnableUnauthorizedAccount.selector, alice));
+        strategy.setTreasury(alice);
+        vm.expectRevert(abi.encodeWithSelector(Ownable.OwnableUnauthorizedAccount.selector, alice));
+        strategy.setParams(_params());
+        vm.expectRevert(abi.encodeWithSelector(Ownable.OwnableUnauthorizedAccount.selector, alice));
+        strategy.emergencyExit();
+        vm.stopPrank();
+    }
+
+    /* --------------------------- parameter bounds ------------------------- */
+
+    function test_PerformanceFeeIsCapped() public {
+        AerodromeUsdcWethStrategy.Params memory p = _params();
+        p.performanceFeeBps = strategy.MAX_PERFORMANCE_FEE() + 1;
+        vm.prank(owner);
+        vm.expectRevert(AerodromeUsdcWethStrategy.ParamOutOfRange.selector);
+        strategy.setParams(p);
+    }
+
+    function test_SlippageCannotBeZeroOrUnbounded() public {
+        AerodromeUsdcWethStrategy.Params memory p = _params();
+        p.slippageBps = 0;
+        vm.prank(owner);
+        vm.expectRevert(AerodromeUsdcWethStrategy.ParamOutOfRange.selector);
+        strategy.setParams(p);
+
+        p = _params();
+        p.slippageBps = strategy.MAX_SLIPPAGE() + 1;
+        vm.prank(owner);
+        vm.expectRevert(AerodromeUsdcWethStrategy.ParamOutOfRange.selector);
+        strategy.setParams(p);
+    }
+
+    function test_DeviationBandCannotBeDisabled() public {
+        AerodromeUsdcWethStrategy.Params memory p = _params();
+        p.maxDeviationBps = 0;
+        vm.prank(owner);
+        vm.expectRevert(AerodromeUsdcWethStrategy.ParamOutOfRange.selector);
+        strategy.setParams(p);
+
+        p = _params();
+        p.maxDeviationBps = strategy.MAX_DEVIATION_CEILING() + 1;
+        vm.prank(owner);
+        vm.expectRevert(AerodromeUsdcWethStrategy.ParamOutOfRange.selector);
+        strategy.setParams(p);
+    }
+
+    function test_TwapGranularityBounded() public {
+        AerodromeUsdcWethStrategy.Params memory p = _params();
+        p.twapGranularity = strategy.MIN_TWAP_GRANULARITY() - 1;
+        vm.prank(owner);
+        vm.expectRevert(AerodromeUsdcWethStrategy.ParamOutOfRange.selector);
+        strategy.setParams(p);
+
+        p = _params();
+        p.twapGranularity = strategy.MAX_TWAP_GRANULARITY() + 1;
+        vm.prank(owner);
+        vm.expectRevert(AerodromeUsdcWethStrategy.ParamOutOfRange.selector);
+        strategy.setParams(p);
+    }
+
+    function test_SwapReserveCapBounded() public {
+        AerodromeUsdcWethStrategy.Params memory p = _params();
+        p.maxSwapReserveBps = strategy.MAX_SWAP_RESERVE_CEILING() + 1;
+        vm.prank(owner);
+        vm.expectRevert(AerodromeUsdcWethStrategy.ParamOutOfRange.selector);
+        strategy.setParams(p);
+    }
+
+    function test_ValidParamsApply() public {
+        AerodromeUsdcWethStrategy.Params memory p = _params();
+        p.performanceFeeBps = 500;
+        p.twapGranularity = 8;
+        p.maxSwapReserveBps = 50;
+        vm.prank(owner);
+        strategy.setParams(p);
+
+        assertEq(strategy.performanceFeeBps(), 500);
+        assertEq(strategy.twapGranularity(), 8);
+        assertEq(strategy.maxSwapReserveBps(), 50);
+    }
+
+    /// @notice A larger reserve cap must translate into a larger permitted tranche.
+    function test_MaxDeployableTracksTheReserveCap() public {
+        uint256 before = strategy.maxDeployable();
+        AerodromeUsdcWethStrategy.Params memory p = _params();
+        p.maxSwapReserveBps = 50;
+        vm.prank(owner);
+        strategy.setParams(p);
+        assertApproxEqRel(strategy.maxDeployable(), before * 2, 0.001e18);
+    }
+
+    /* -------------------------------- sweep ------------------------------- */
+
+    function test_SweepCannotTouchPositionAssets() public {
+        vm.startPrank(owner);
+        vm.expectRevert(AerodromeUsdcWethStrategy.ParamOutOfRange.selector);
+        strategy.sweep(A.USDC, owner);
+        vm.expectRevert(AerodromeUsdcWethStrategy.ParamOutOfRange.selector);
+        strategy.sweep(A.WETH, owner);
+        vm.expectRevert(AerodromeUsdcWethStrategy.ParamOutOfRange.selector);
+        strategy.sweep(A.POOL_WETH_USDC, owner);
+        vm.stopPrank();
+    }
+
+    function test_SweepRecoversStrandedTokens() public {
+        MockERC20 junk = new MockERC20("Junk", "JNK", 18);
+        junk.mint(address(strategy), 1e18);
+
+        vm.prank(owner);
+        strategy.sweep(address(junk), owner);
+        assertEq(junk.balanceOf(owner), 1e18);
+    }
+
+    /* ------------------------------ keeper ops ---------------------------- */
+
+    function test_KeeperRotation() public {
+        address newKeeper = makeAddr("newKeeper");
+        vm.prank(owner);
+        strategy.setKeeper(newKeeper);
+
+        vm.prank(keeper);
+        vm.expectRevert(AerodromeUsdcWethStrategy.NotKeeper.selector);
+        strategy.earn();
+
+        vm.prank(newKeeper);
+        strategy.earn(); // no idle USDC, returns 0 without reverting
+    }
+
+    function test_ResumeAfterEmergencyExit() public {
+        vm.startPrank(owner);
+        strategy.emergencyExit();
+        assertTrue(strategy.emergencyExited());
+        strategy.resume();
+        assertFalse(strategy.emergencyExited());
+        vm.stopPrank();
+
+        vm.prank(keeper);
+        strategy.earn();
+    }
+}
