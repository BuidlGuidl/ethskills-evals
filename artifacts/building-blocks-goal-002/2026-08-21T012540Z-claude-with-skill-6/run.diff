index 0000000..f5c8d40
--- /dev/null
+++ b/src/AerodromeUsdcWethStrategy.sol
@@ -0,0 +1,674 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.28;
+
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+import {Ownable2Step, Ownable} from "@openzeppelin/contracts/access/Ownable2Step.sol";
+import {ReentrancyGuard} from "@openzeppelin/contracts/utils/ReentrancyGuard.sol";
+import {Math} from "@openzeppelin/contracts/utils/math/Math.sol";
+
+import {IPool, IPoolFactory, IRouter, IGauge} from "./interfaces/IAerodrome.sol";
+import {IStrategy} from "./interfaces/IStrategy.sol";
+
+/// @title AerodromeUsdcWethStrategy
+/// @notice Deploys vault USDC into the Aerodrome vAMM-WETH/USDC pool, stakes the LP in that
+///         pool's gauge, and compounds the AERO emissions back into the same position.
+///
+/// @dev Reward accounting (verified onchain, see README). Once LP is staked in an Aerodrome
+///      gauge, the trading fees that LP generates are claimed by the gauge and forwarded to the
+///      pool's FeesVotingReward contract for veAERO voters - they are NOT claimable by the LP.
+///      A staked LP therefore earns AERO emissions only, and `harvest()` claims exactly that.
+///
+/// @dev Safety model. Three independent bounds, each covering a different failure:
+///      1. `maxDeviationBps` - spot must sit near the pool's own TWAP before we transact at all.
+///         This is the anti-manipulation gate: against a flash-manipulated pool we fail closed.
+///      2. `maxSwapImpactBps` - the router's in-block quote must not be worse than the
+///         TWAP-implied fair output by more than this. Bounds fee plus price impact, i.e. how
+///         much value a single operation may burn. Oversized deploys trip it and get split.
+///      3. `slippageBps` - execution must not land below the router's own quote by more than
+///         this, covering state drift between quoting and executing inside our own call.
+///      Plus `maxSwapReserveBps`, which caps a single swap as a fraction of the pool reserve so
+///      that the strategy can never dislocate the pool past its own bound 1.
+///      Conflating these into one number forces it wide enough to admit legitimate price impact,
+///      which defeats the manipulation check. They are kept separate on purpose.
+contract AerodromeUsdcWethStrategy is IStrategy, Ownable2Step, ReentrancyGuard {
+    using SafeERC20 for IERC20;
+
+    uint256 internal constant BPS = 10_000;
+    uint256 internal constant WAD = 1e18;
+
+    /* ------------------------------------------------------------------ */
+    /*                              IMMUTABLES                            */
+    /* ------------------------------------------------------------------ */
+
+    address public immutable override vault;
+    IERC20 public immutable usdc;
+    IERC20 public immutable weth;
+    IERC20 public immutable aero;
+    IRouter public immutable router;
+    address public immutable poolFactory;
+
+    /// @notice vAMM-WETH/USDC pool the vault is LPing into.
+    IPool public immutable pool;
+    /// @notice Gauge that stakes `pool` LP and emits AERO.
+    IGauge public immutable gauge;
+    /// @notice vAMM-USDC/AERO pool, used both to route and to price the reward swap.
+    IPool public immutable aeroUsdcPool;
+
+    /// @dev True when USDC is token0 of `pool`. Read from the pool, never assumed.
+    bool public immutable usdcIsToken0;
+
+    /* ------------------------------------------------------------------ */
+    /*                              PARAMETERS                            */
+    /* ------------------------------------------------------------------ */
+
+    /// @notice May call `harvest()` and `earn()`.
+    address public keeper;
+    /// @notice Receives the performance fee taken on harvested rewards.
+    address public treasury;
+
+    uint256 public performanceFeeBps = 1_000; // 10%
+    uint256 public constant MAX_PERFORMANCE_FEE = 2_000; // 20%
+
+    /// @notice Bound 3: execution vs the router's own in-block quote.
+    uint256 public slippageBps = 100; // 1%
+    uint256 public constant MAX_SLIPPAGE = 500;
+
+    /// @notice Bound 2: router quote vs TWAP-implied fair output (fee + price impact).
+    /// @dev Enforced on keeper operations only. A keeper that trips it splits the work and
+    ///      retries. It is deliberately NOT enforced on user withdrawals: a large exit really does
+    ///      cost its own price impact, and blocking the exit is worse for the user than charging
+    ///      them for it. Withdrawals keep bounds 1 and 3, so they are still protected from a
+    ///      manipulated pool and from being sandwiched.
+    uint256 public maxSwapImpactBps = 300; // 3%
+    uint256 public constant MAX_SWAP_IMPACT_CEILING = 1_000;
+
+    /// @notice Bound 1: spot vs TWAP. Anti-manipulation circuit breaker.
+    /// @dev Must be wide enough to absorb the strategy's own price impact plus normal TWAP lag,
+    ///      or routine operations trip it. It still closes long before any manipulation worth
+    ///      running: profitably skewing an LP valuation needs price moves an order of magnitude
+    ///      larger than this. See `maxSwapReserveBps`, which keeps our own footprint inside it.
+    uint256 public maxDeviationBps = 500; // 5%
+    uint256 public constant MAX_DEVIATION_CEILING = 1_000;
+
+    /// @notice Largest single swap the strategy will make, as bps of the input-side reserve.
+    /// @dev Caps how far one keeper operation can move the pool, which is what keeps us inside
+    ///      `maxDeviationBps`. Price-impact loss on a swap of size s against reserve R grows like
+    ///      s^2/2R, so splitting a deploy into N calls across blocks - letting arbitrage re-anchor
+    ///      the pool in between - cuts the total cost by roughly N. `earn()` chunks automatically.
+    uint256 public maxSwapReserveBps = 25; // 0.25% of the reserve per swap
+    uint256 public constant MAX_SWAP_RESERVE_CEILING = 500;
+
+    /// @notice Number of 30-minute observations averaged for the TWAP.
+    uint256 public twapGranularity = 4; // ~2 hours
+    uint256 public constant MIN_TWAP_GRANULARITY = 2;
+    uint256 public constant MAX_TWAP_GRANULARITY = 48;
+
+    /// @notice Extra LP burned on withdrawal to absorb the swap cost on the WETH leg, in bps.
+    uint256 public withdrawBufferBps = 100; // 1%
+    uint256 public constant MAX_WITHDRAW_BUFFER = 1_000;
+
+    /// @notice Minimum AERO balance that makes a harvest worth its gas.
+    uint256 public minHarvestAero = 1e18;
+
+    /// @notice When true the position is unwound to USDC and no new capital is deployed.
+    bool public emergencyExited;
+
+    /* ------------------------------------------------------------------ */
+    /*                                EVENTS                              */
+    /* ------------------------------------------------------------------ */
+
+    event Deployed(uint256 usdcIn, uint256 liquidityOut);
+    event Withdrawn(uint256 usdcRequested, uint256 liquidityBurned);
+    event Harvested(uint256 aeroClaimed, uint256 usdcCompounded, uint256 performanceFee, uint256 liquidityOut);
+    event EmergencyExit(uint256 usdcRecovered);
+    event KeeperUpdated(address keeper);
+    event TreasuryUpdated(address treasury);
+    event ParamsUpdated(
+        uint256 performanceFeeBps,
+        uint256 slippageBps,
+        uint256 maxSwapImpactBps,
+        uint256 maxDeviationBps,
+        uint256 twapGranularity,
+        uint256 withdrawBufferBps,
+        uint256 minHarvestAero
+    );
+
+    /* ------------------------------------------------------------------ */
+    /*                                ERRORS                              */
+    /* ------------------------------------------------------------------ */
+
+    error NotVault();
+    error NotKeeper();
+    error ZeroAddress();
+    error ParamOutOfRange();
+    error PriceOutOfBand(uint256 twapOut, uint256 spotOut);
+    error ExcessiveSwapImpact(uint256 quotedOut, uint256 fairOut);
+    error NothingToHarvest();
+    error InsufficientOutput(uint256 got, uint256 want);
+    error IsEmergencyExited();
+    error StaleOracle();
+
+    /* ------------------------------------------------------------------ */
+    /*                             CONSTRUCTOR                            */
+    /* ------------------------------------------------------------------ */
+
+    struct Config {
+        address vault;
+        address usdc;
+        address weth;
+        address aero;
+        address router;
+        address gauge;
+        address owner;
+        address keeper;
+        address treasury;
+    }
+
+    constructor(Config memory c) Ownable(c.owner) {
+        if (
+            c.vault == address(0) || c.usdc == address(0) || c.weth == address(0) || c.aero == address(0)
+                || c.router == address(0) || c.gauge == address(0) || c.owner == address(0) || c.keeper == address(0)
+                || c.treasury == address(0)
+        ) revert ZeroAddress();
+
+        vault = c.vault;
+        usdc = IERC20(c.usdc);
+        weth = IERC20(c.weth);
+        aero = IERC20(c.aero);
+        router = IRouter(c.router);
+        gauge = IGauge(c.gauge);
+        keeper = c.keeper;
+        treasury = c.treasury;
+
+        // Derive the pool from the gauge rather than trusting a supplied address, then check it
+        // really is the volatile WETH/USDC pool and that the gauge really pays AERO.
+        address _pool = IGauge(c.gauge).stakingToken();
+        pool = IPool(_pool);
+        require(IGauge(c.gauge).rewardToken() == c.aero, "gauge: reward token mismatch");
+        require(!IPool(_pool).stable(), "pool: expected volatile");
+
+        address t0 = IPool(_pool).token0();
+        address t1 = IPool(_pool).token1();
+        require((t0 == c.usdc && t1 == c.weth) || (t0 == c.weth && t1 == c.usdc), "pool: token mismatch");
+        usdcIsToken0 = (t0 == c.usdc);
+
+        address _factory = IRouter(c.router).defaultFactory();
+        poolFactory = _factory;
+        require(IPoolFactory(_factory).getPool(c.usdc, c.weth, false) == _pool, "router/factory: pool mismatch");
+
+        address _aeroPool = IPoolFactory(_factory).getPool(c.aero, c.usdc, false);
+        require(_aeroPool != address(0), "no AERO/USDC pool");
+        aeroUsdcPool = IPool(_aeroPool);
+    }
+
+    /* ------------------------------------------------------------------ */
+    /*                              MODIFIERS                             */
+    /* ------------------------------------------------------------------ */
+
+    modifier onlyVault() {
+        _requireVault();
+        _;
+    }
+
+    modifier onlyKeeper() {
+        _requireKeeper();
+        _;
+    }
+
+    function _requireVault() internal view {
+        if (msg.sender != vault) revert NotVault();
+    }
+
+    function _requireKeeper() internal view {
+        if (msg.sender != keeper && msg.sender != owner()) revert NotKeeper();
+    }
+
+    /* ------------------------------------------------------------------ */
+    /*                         ORACLE / PRICE GUARDS                      */
+    /* ------------------------------------------------------------------ */
+
+    /// @dev TWAP-implied output for `amountIn` of `tokenIn`, with no fee and no price impact.
+    ///      This is the "fair" value of the trade.
+    function _twapOut(IPool p, address tokenIn, uint256 amountIn) internal view returns (uint256 out) {
+        if (p.observationLength() < twapGranularity + 1) revert StaleOracle();
+        out = p.quote(tokenIn, amountIn, twapGranularity);
+        if (out == 0) revert StaleOracle();
+    }
+
+    /// @dev Spot output implied by current reserves, no fee applied.
+    function _spotOut(IPool p, address tokenIn, uint256 amountIn) internal view returns (uint256) {
+        (uint256 r0, uint256 r1,) = p.getReserves();
+        (uint256 rIn, uint256 rOut) = p.token0() == tokenIn ? (r0, r1) : (r1, r0);
+        if (rIn == 0) return 0;
+        return Math.mulDiv(amountIn, rOut, rIn);
+    }
+
+    /// @dev Bound 1. Reverts when spot has drifted from the TWAP by more than `maxDeviationBps`.
+    ///      `unit` is a reference size; the comparison is a pure price ratio so its scale cancels.
+    function _checkPriceBand(IPool p, address tokenIn, uint256 unit) internal view {
+        uint256 twapOut = _twapOut(p, tokenIn, unit);
+        uint256 spotOut = _spotOut(p, tokenIn, unit);
+        uint256 diff = twapOut > spotOut ? twapOut - spotOut : spotOut - twapOut;
+        if (Math.mulDiv(diff, BPS, twapOut) > maxDeviationBps) revert PriceOutOfBand(twapOut, spotOut);
+    }
+
+    /// @dev Non-reverting form of `_checkPriceBand`, for paths that must degrade rather than fail.
+    function _isPriceHealthy(IPool p, address tokenIn, uint256 unit) internal view returns (bool) {
+        uint256 twapOut = _twapOut(p, tokenIn, unit);
+        uint256 spotOut = _spotOut(p, tokenIn, unit);
+        uint256 diff = twapOut > spotOut ? twapOut - spotOut : spotOut - twapOut;
+        return Math.mulDiv(diff, BPS, twapOut) <= maxDeviationBps;
+    }
+
+    /// @notice Reverts when the pool has dislocated from its own TWAP.
+    /// @dev The vault calls this on every share mint and burn, so shares are never priced off a
+    ///      stale or manipulated oracle - including when the trade is served entirely from idle
+    ///      USDC and never touches the pool. Skipped when there is no LP position, since then the
+    ///      share price does not depend on the oracle at all and users must stay able to exit.
+    function checkPriceHealthy() external view override {
+        if (lpBalance() == 0) return;
+        _checkPriceBand(pool, address(weth), WAD);
+    }
+
+    /// @notice TWAP price of 1e18 WETH in USDC units.
+    function twapWethPrice() public view returns (uint256) {
+        return _twapOut(pool, address(weth), WAD);
+    }
+
+    /// @notice Spot price of 1e18 WETH in USDC units, from reserves, no fee.
+    function spotWethPrice() public view returns (uint256) {
+        return _spotOut(pool, address(weth), WAD);
+    }
+
+    /* ------------------------------------------------------------------ */
+    /*                              VALUATION                             */
+    /* ------------------------------------------------------------------ */
+
+    function asset() external view override returns (address) {
+        return address(usdc);
+    }
+
+    /// @dev Reserves normalised to (usdc, weth) regardless of pool token ordering.
+    function _reserves() internal view returns (uint256 usdcReserve, uint256 wethReserve) {
+        (uint256 r0, uint256 r1,) = pool.getReserves();
+        return usdcIsToken0 ? (r0, r1) : (r1, r0);
+    }
+
+    /// @notice USDC value of `lpAmount` pool LP tokens, priced off the TWAP.
+    /// @dev Fair-LP pricing. For a constant-product pool with invariant k = x*y, the reserves an
+    ///      arbitrageur would restore at true price p are x' = sqrt(k/p) and y' = sqrt(k*p), so the
+    ///      pool is worth 2*sqrt(k*p) in USDC terms. That depends on k and the TWAP but NOT on the
+    ///      current reserve split. A flash swap moves the split while leaving k untouched, so it
+    ///      cannot move this number - unlike naive `reserve * lp / totalSupply` pricing, which it
+    ///      moves a lot.
+    function lpToUsdc(uint256 lpAmount) public view returns (uint256) {
+        if (lpAmount == 0) return 0;
+        uint256 lpSupply = pool.totalSupply();
+        if (lpSupply == 0) return 0;
+
+        (uint256 usdcReserve, uint256 wethReserve) = _reserves();
+        uint256 p = twapWethPrice(); // USDC units per 1e18 WETH
+
+        // fairUsdcSide = sqrt(usdcReserve * wethReserve * p / 1e18); pool value = 2 * that.
+        uint256 fairUsdcSide = Math.sqrt(Math.mulDiv(usdcReserve * wethReserve, p, WAD));
+        return Math.mulDiv(2 * fairUsdcSide, lpAmount, lpSupply);
+    }
+
+    /// @notice LP the strategy controls: staked in the gauge plus anything sitting here.
+    function lpBalance() public view returns (uint256) {
+        return gauge.balanceOf(address(this)) + IERC20(address(pool)).balanceOf(address(this));
+    }
+
+    /// @notice Idle USDC held here and not yet deployed.
+    function idleUsdc() public view returns (uint256) {
+        return usdc.balanceOf(address(this));
+    }
+
+    /// @notice USDC value of any WETH sitting here - add-liquidity dust, or a leg left unconverted
+    ///         because the pool was dislocated when we unwound. Priced at the TWAP like the LP.
+    function idleWethValue() public view returns (uint256) {
+        uint256 bal = weth.balanceOf(address(this));
+        if (bal == 0) return 0;
+        return Math.mulDiv(bal, twapWethPrice(), WAD);
+    }
+
+    /// @inheritdoc IStrategy
+    /// @dev Deliberately excludes unclaimed AERO. Counting it would let a depositor mint shares
+    ///      against rewards accrued before they arrived. Rewards enter `totalAssets` only once
+    ///      `harvest()` has compounded them into LP.
+    function totalAssets() public view override returns (uint256) {
+        return idleUsdc() + idleWethValue() + lpToUsdc(lpBalance());
+    }
+
+    /// @notice Pending AERO the next harvest would claim.
+    function pendingRewards() external view returns (uint256) {
+        return gauge.earned(address(this)) + aero.balanceOf(address(this));
+    }
+
+    /* ------------------------------------------------------------------ */
+    /*                            CAPITAL FLOWS                           */
+    /* ------------------------------------------------------------------ */
+
+    /// @notice Deploy idle USDC into the pool and stake the LP. Keeper-operated so that user
+    ///         deposits are not individually exposed to AMM fees and sandwich risk.
+    /// @dev Deploys at most `maxDeployable()` per call. Anything above that stays idle and is
+    ///      still counted in `totalAssets`, so nothing is lost by deploying over several calls -
+    ///      it is strictly cheaper. Keepers call this until `idleUsdc()` reaches zero.
+    function earn() external onlyKeeper nonReentrant returns (uint256 liquidity) {
+        if (emergencyExited) revert IsEmergencyExited();
+        (, liquidity) = _deployCapped();
+    }
+
+    /// @notice Largest USDC amount a single `earn()` call will deploy, given current pool depth.
+    /// @dev Half the deploy is swapped, so the cap is twice the per-swap reserve limit.
+    function maxDeployable() public view returns (uint256) {
+        (uint256 usdcReserve,) = _reserves();
+        return Math.mulDiv(usdcReserve, maxSwapReserveBps, BPS) * 2;
+    }
+
+    function _deployCapped() internal returns (uint256 deployed, uint256 liquidity) {
+        uint256 idle = idleUsdc();
+        if (idle == 0) return (0, 0);
+
+        uint256 cap = maxDeployable();
+        deployed = idle > cap ? cap : idle;
+        if (deployed == 0) return (0, 0);
+
+        liquidity = _deployUsdc(deployed);
+        emit Deployed(deployed, liquidity);
+    }
+
+    /// @inheritdoc IStrategy
+    function withdraw(uint256 amount) external override onlyVault nonReentrant {
+        if (amount == 0) return;
+
+        uint256 idle = idleUsdc();
+        if (idle < amount) _unwindFor(amount - idle);
+
+        uint256 available = idleUsdc();
+        if (available < amount) revert InsufficientOutput(available, amount);
+        usdc.safeTransfer(vault, amount);
+    }
+
+    /// @inheritdoc IStrategy
+    function withdrawAll() external override onlyVault nonReentrant returns (uint256 out) {
+        _unstakeAndRemoveAll();
+        out = idleUsdc();
+        if (out > 0) usdc.safeTransfer(vault, out);
+        emit Withdrawn(out, 0);
+    }
+
+    /* ------------------------------------------------------------------ */
+    /*                               HARVEST                              */
+    /* ------------------------------------------------------------------ */
+
+    /// @notice Claim AERO emissions, take the performance fee, and compound the rest back into
+    ///         the WETH/USDC position.
+    /// @param minUsdcFromAero Keeper-supplied floor on the AERO -> USDC swap, from an offchain
+    ///        price source. Applied on top of the onchain bounds; whichever is stricter wins.
+    ///        Pass 0 to rely on the onchain bounds alone.
+    function harvest(uint256 minUsdcFromAero)
+        external
+        onlyKeeper
+        nonReentrant
+        returns (uint256 aeroClaimed, uint256 usdcCompounded, uint256 liquidity)
+    {
+        if (emergencyExited) revert IsEmergencyExited();
+
+        gauge.getReward(address(this));
+        aeroClaimed = aero.balanceOf(address(this));
+        if (aeroClaimed < minHarvestAero) revert NothingToHarvest();
+
+        _checkPriceBand(aeroUsdcPool, address(aero), 1e18);
+        uint256 usdcOut = _swapGuarded(aeroUsdcPool, address(aero), address(usdc), aeroClaimed, minUsdcFromAero, true);
+
+        uint256 fee = Math.mulDiv(usdcOut, performanceFeeBps, BPS);
+        if (fee > 0) usdc.safeTransfer(treasury, fee);
+        usdcCompounded = usdcOut - fee;
+
+        // Compound, folding in dust left by earlier operations. Subject to the same size cap;
+        // any excess stays idle for the next call.
+        (, liquidity) = _deployCapped();
+
+        emit Harvested(aeroClaimed, usdcCompounded, fee, liquidity);
+    }
+
+    /* ------------------------------------------------------------------ */
+    /*                          INTERNAL MECHANICS                        */
+    /* ------------------------------------------------------------------ */
+
+    /// @dev Turn `usdcAmount` into a balanced LP position and stake it.
+    function _deployUsdc(uint256 usdcAmount) internal returns (uint256 liquidity) {
+        _checkPriceBand(pool, address(weth), WAD);
+
+        // Swap half to WETH. For a 50/50 constant-product pool this is within a few bps of the
+        // optimal one-sided split at these sizes; the remainder stays idle and is folded into the
+        // next deploy rather than being force-added at a bad ratio.
+        uint256 usdcToSwap = usdcAmount / 2;
+        if (usdcToSwap > 0) _swapGuarded(pool, address(usdc), address(weth), usdcToSwap, 0, true);
+
+        // Only commit the tranche we were asked to deploy; the rest of the idle balance is left
+        // for the next call rather than being dragged in past the size cap.
+        uint256 usdcBal = usdcAmount - usdcToSwap;
+        uint256 wethBal = weth.balanceOf(address(this));
+        if (usdcBal == 0 || wethBal == 0) return 0;
+
+        // Mins are derived from what the router says it will actually consume at the current
+        // ratio, not from what we happen to hold. Using the held balances would make the check
+        // trip whenever our two legs are not already in exact pool proportion - which is always.
+        (uint256 useUsdc, uint256 useWeth,) =
+            router.quoteAddLiquidity(address(usdc), address(weth), false, poolFactory, usdcBal, wethBal);
+
+        usdc.forceApprove(address(router), usdcBal);
+        weth.forceApprove(address(router), wethBal);
+
+        (,, liquidity) = router.addLiquidity(
+            address(usdc),
+            address(weth),
+            false,
+            usdcBal,
+            wethBal,
+            Math.mulDiv(useUsdc, BPS - slippageBps, BPS),
+            Math.mulDiv(useWeth, BPS - slippageBps, BPS),
+            address(this),
+            block.timestamp
+        );
+
+        usdc.forceApprove(address(router), 0);
+        weth.forceApprove(address(router), 0);
+
+        _stakeAll();
+    }
+
+    /// @dev Burn enough LP to raise ~`usdcNeeded`, then convert the WETH leg to USDC.
+    function _unwindFor(uint256 usdcNeeded) internal {
+        _checkPriceBand(pool, address(weth), WAD);
+
+        uint256 held = lpBalance();
+        if (held == 0) return;
+
+        uint256 positionValue = lpToUsdc(held);
+        if (positionValue == 0) return;
+
+        uint256 lpToBurn = Math.mulDiv(usdcNeeded, held, positionValue, Math.Rounding.Ceil);
+        // Buffer absorbs the swap cost on the WETH leg so realised USDC still clears `usdcNeeded`.
+        lpToBurn = Math.mulDiv(lpToBurn, BPS + withdrawBufferBps, BPS);
+        if (lpToBurn > held) lpToBurn = held;
+
+        _unstake(lpToBurn);
+        _removeLiquidity(lpToBurn);
+
+        uint256 wethBal = weth.balanceOf(address(this));
+        if (wethBal > 0) _swapGuarded(pool, address(weth), address(usdc), wethBal, 0, false);
+
+        emit Withdrawn(usdcNeeded, lpToBurn);
+    }
+
+    /// @dev Unstaking and removing liquidity are proportional operations - they return the
+    ///      position's share of the reserves whatever the current split is, so they are safe to do
+    ///      unconditionally. Only the WETH -> USDC leg is price-sensitive, so that one is skipped
+    ///      while the pool is dislocated rather than dumping into a manipulated book. Anything left
+    ///      in WETH still counts in `totalAssets()` and can be finished with `convertStrandedWeth()`.
+    ///      The priority in an emergency is getting out of the gauge and the pool, which this
+    ///      always does.
+    function _unstakeAndRemoveAll() internal {
+        uint256 staked = gauge.balanceOf(address(this));
+        if (staked > 0) _unstake(staked);
+
+        uint256 lp = IERC20(address(pool)).balanceOf(address(this));
+        if (lp > 0) _removeLiquidity(lp);
+
+        uint256 wethBal = weth.balanceOf(address(this));
+        if (wethBal > 0 && _isPriceHealthy(pool, address(weth), WAD)) {
+            _swapGuarded(pool, address(weth), address(usdc), wethBal, 0, false);
+        }
+    }
+
+    /// @notice Convert WETH stranded by an unwind that happened while the pool was dislocated.
+    function convertStrandedWeth() external onlyKeeper nonReentrant returns (uint256 usdcOut) {
+        uint256 wethBal = weth.balanceOf(address(this));
+        if (wethBal == 0) return 0;
+        _checkPriceBand(pool, address(weth), WAD);
+        usdcOut = _swapGuarded(pool, address(weth), address(usdc), wethBal, 0, false);
+    }
+
+    /// @dev Caller must have checked the price band. Mins come from current reserves, so they
+    ///      guard against the reserves shifting under us rather than against a bad ratio.
+    function _removeLiquidity(uint256 lpAmount) internal {
+        uint256 lpSupply = pool.totalSupply();
+        (uint256 usdcReserve, uint256 wethReserve) = _reserves();
+
+        uint256 minUsdc = Math.mulDiv(Math.mulDiv(usdcReserve, lpAmount, lpSupply), BPS - slippageBps, BPS);
+        uint256 minWeth = Math.mulDiv(Math.mulDiv(wethReserve, lpAmount, lpSupply), BPS - slippageBps, BPS);
+
+        IERC20(address(pool)).forceApprove(address(router), lpAmount);
+        router.removeLiquidity(
+            address(usdc), address(weth), false, lpAmount, minUsdc, minWeth, address(this), block.timestamp
+        );
+        IERC20(address(pool)).forceApprove(address(router), 0);
+    }
+
+    function _stakeAll() internal {
+        uint256 lp = IERC20(address(pool)).balanceOf(address(this));
+        if (lp == 0) return;
+        IERC20(address(pool)).forceApprove(address(gauge), lp);
+        gauge.deposit(lp);
+    }
+
+    function _unstake(uint256 lpAmount) internal {
+        uint256 staked = gauge.balanceOf(address(this));
+        uint256 toPull = lpAmount > staked ? staked : lpAmount;
+        if (toPull > 0) gauge.withdraw(toPull);
+    }
+
+    /// @dev Single-hop swap through `p`, subject to bounds 2 and 3. Bound 1 is the caller's job.
+    /// @param enforceImpactBound Keeper operations pass true: they can be split and retried, so a
+    ///        swap that would burn too much value should fail. User withdrawals pass false, so an
+    ///        exit is never blocked by its own size - the withdrawer simply bears the impact.
+    function _swapGuarded(
+        IPool p,
+        address tokenIn,
+        address tokenOut,
+        uint256 amountIn,
+        uint256 externalMinOut,
+        bool enforceImpactBound
+    ) internal returns (uint256) {
+        IRouter.Route[] memory routes = new IRouter.Route[](1);
+        routes[0] = IRouter.Route({from: tokenIn, to: tokenOut, stable: false, factory: poolFactory});
+
+        uint256 quotedOut = router.getAmountsOut(amountIn, routes)[1];
+
+        if (enforceImpactBound) {
+            // Bound 2: how far the executable quote sits below fair value (fee + price impact).
+            uint256 fairOut = _twapOut(p, tokenIn, amountIn);
+            if (quotedOut < Math.mulDiv(fairOut, BPS - maxSwapImpactBps, BPS)) {
+                revert ExcessiveSwapImpact(quotedOut, fairOut);
+            }
+        }
+
+        // Bound 3: how far execution may land below that quote.
+        uint256 minOut = Math.mulDiv(quotedOut, BPS - slippageBps, BPS);
+        if (externalMinOut > minOut) minOut = externalMinOut;
+
+        IERC20(tokenIn).forceApprove(address(router), amountIn);
+        uint256[] memory amounts =
+            router.swapExactTokensForTokens(amountIn, minOut, routes, address(this), block.timestamp);
+        IERC20(tokenIn).forceApprove(address(router), 0);
+        return amounts[amounts.length - 1];
+    }
+
+    /* ------------------------------------------------------------------ */
+    /*                             GOVERNANCE                             */
+    /* ------------------------------------------------------------------ */
+
+    /// @notice Unwind everything to USDC and stop deploying. USDC stays here for the vault to pull.
+    function emergencyExit() external onlyOwner nonReentrant {
+        emergencyExited = true;
+        _unstakeAndRemoveAll();
+        emit EmergencyExit(idleUsdc());
+    }
+
+    /// @notice Re-enable deployment after an emergency exit.
+    function resume() external onlyOwner {
+        emergencyExited = false;
+    }
+
+    function setKeeper(address _keeper) external onlyOwner {
+        if (_keeper == address(0)) revert ZeroAddress();
+        keeper = _keeper;
+        emit KeeperUpdated(_keeper);
+    }
+
+    function setTreasury(address _treasury) external onlyOwner {
+        if (_treasury == address(0)) revert ZeroAddress();
+        treasury = _treasury;
+        emit TreasuryUpdated(_treasury);
+    }
+
+    struct Params {
+        uint256 performanceFeeBps;
+        uint256 slippageBps;
+        uint256 maxSwapReserveBps;
+        uint256 maxSwapImpactBps;
+        uint256 maxDeviationBps;
+        uint256 twapGranularity;
+        uint256 withdrawBufferBps;
+        uint256 minHarvestAero;
+    }
+
+    function setParams(Params calldata p) external onlyOwner {
+        if (
+            p.performanceFeeBps > MAX_PERFORMANCE_FEE || p.slippageBps == 0 || p.slippageBps > MAX_SLIPPAGE
+                || p.maxSwapReserveBps == 0 || p.maxSwapReserveBps > MAX_SWAP_RESERVE_CEILING || p.maxSwapImpactBps == 0
+                || p.maxSwapImpactBps > MAX_SWAP_IMPACT_CEILING || p.maxDeviationBps == 0
+                || p.maxDeviationBps > MAX_DEVIATION_CEILING || p.twapGranularity < MIN_TWAP_GRANULARITY
+                || p.twapGranularity > MAX_TWAP_GRANULARITY || p.withdrawBufferBps > MAX_WITHDRAW_BUFFER
+        ) revert ParamOutOfRange();
+
+        performanceFeeBps = p.performanceFeeBps;
+        slippageBps = p.slippageBps;
+        maxSwapReserveBps = p.maxSwapReserveBps;
+        maxSwapImpactBps = p.maxSwapImpactBps;
+        maxDeviationBps = p.maxDeviationBps;
+        twapGranularity = p.twapGranularity;
+        withdrawBufferBps = p.withdrawBufferBps;
+        minHarvestAero = p.minHarvestAero;
+
+        emit ParamsUpdated(
+            p.performanceFeeBps,
+            p.slippageBps,
+            p.maxSwapImpactBps,
+            p.maxDeviationBps,
+            p.twapGranularity,
+            p.withdrawBufferBps,
+            p.minHarvestAero
+        );
+    }
+
+    /// @notice Recover a token that is not part of the strategy's accounting.
+    function sweep(address token, address to) external onlyOwner {
+        if (token == address(usdc) || token == address(pool) || token == address(weth)) revert ParamOutOfRange();
+        IERC20(token).safeTransfer(to, IERC20(token).balanceOf(address(this)));
+    }
+}
diff --git a/src/YieldVault.sol b/src/YieldVault.sol
new file mode 100644
index 0000000..b1733aa
--- /dev/null
+++ b/src/YieldVault.sol
@@ -0,0 +1,244 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.28;
+
+import {ERC20} from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+import {ERC4626} from "@openzeppelin/contracts/token/ERC20/extensions/ERC4626.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+import {Ownable2Step, Ownable} from "@openzeppelin/contracts/access/Ownable2Step.sol";
+import {ReentrancyGuard} from "@openzeppelin/contracts/utils/ReentrancyGuard.sol";
+import {Pausable} from "@openzeppelin/contracts/utils/Pausable.sol";
+import {Math} from "@openzeppelin/contracts/utils/math/Math.sol";
+
+import {IStrategy} from "./interfaces/IStrategy.sol";
+
+/// @title YieldVault
+/// @notice ERC4626 vault denominated in USDC. Capital is held either idle in the vault or in a
+///         single strategy contract that runs the Aerodrome WETH/USDC position.
+/// @dev Deposits land idle and are pushed into the strategy by the keeper (`Strategy.earn()`),
+///      so an individual depositor never pays AMM swap fees or eats sandwich risk on their own
+///      transaction. Withdrawals are served from idle first and pull from the strategy on demand.
+contract YieldVault is ERC4626, Ownable2Step, ReentrancyGuard, Pausable {
+    using SafeERC20 for IERC20;
+
+    /// @notice The active strategy. Zero address means all capital sits idle.
+    IStrategy public strategy;
+
+    /// @notice Address allowed to move idle capital into the strategy.
+    address public keeper;
+
+    /// @notice Hard cap on total assets, in USDC units. Zero disables the cap.
+    uint256 public depositCap;
+
+    /// @notice Entry / exit fees in bps, RETAINED BY THE VAULT (not paid out to anyone).
+    /// @dev These exist to stop cost socialisation, not to make money. Moving USDC into the
+    ///      WETH/USDC position means swapping half of it, which costs the pool's 0.3% fee plus
+    ///      price impact - roughly 20bps of the notional at current depth. That cost lands on
+    ///      whoever holds shares when the keeper deploys, so without a fee an arriving depositor
+    ///      imposes their entry cost on everyone already in, and a leaver does the same on the
+    ///      way out. Charging it to the actor and retaining it for the remaining holders keeps
+    ///      the share price honest. Sized to approximate the real round-trip cost; see README.
+    uint256 public entryFeeBps = 30;
+    uint256 public exitFeeBps = 30;
+    uint256 public constant MAX_ENTRY_EXIT_FEE = 100; // 1%
+
+    event StrategyUpdated(address indexed oldStrategy, address indexed newStrategy);
+    event KeeperUpdated(address keeper);
+    event DepositCapUpdated(uint256 cap);
+    event FeesUpdated(uint256 entryFeeBps, uint256 exitFeeBps);
+    event PushedToStrategy(uint256 amount);
+
+    error ZeroAddress();
+    error NotKeeper();
+    error StrategyAssetMismatch();
+    error StrategyVaultMismatch();
+    error DepositCapExceeded();
+    error StrategyStillFunded();
+    error FeeTooHigh();
+
+    constructor(address _usdc, address _owner, address _keeper, uint256 _depositCap)
+        ERC20("Base USDC Yield Vault", "bvUSDC")
+        ERC4626(IERC20(_usdc))
+        Ownable(_owner)
+    {
+        if (_usdc == address(0) || _owner == address(0) || _keeper == address(0)) revert ZeroAddress();
+        keeper = _keeper;
+        depositCap = _depositCap;
+    }
+
+    /// @dev Virtual shares offset. With a 6-decimal asset this makes the first-depositor share
+    ///      inflation attack cost ~1e6x any profit, on top of OZ's built-in virtual assets.
+    function _decimalsOffset() internal pure override returns (uint8) {
+        return 6;
+    }
+
+    modifier onlyKeeper() {
+        if (msg.sender != keeper && msg.sender != owner()) revert NotKeeper();
+        _;
+    }
+
+    /* ------------------------------------------------------------------ */
+    /*                             ACCOUNTING                             */
+    /* ------------------------------------------------------------------ */
+
+    /// @notice Idle USDC sitting in the vault, not yet pushed to the strategy.
+    function idleAssets() public view returns (uint256) {
+        return IERC20(asset()).balanceOf(address(this));
+    }
+
+    /// @inheritdoc ERC4626
+    function totalAssets() public view override returns (uint256) {
+        uint256 idle = idleAssets();
+        if (address(strategy) == address(0)) return idle;
+        return idle + strategy.totalAssets();
+    }
+
+    function maxDeposit(address) public view override returns (uint256) {
+        if (paused()) return 0;
+        if (depositCap == 0) return type(uint256).max;
+        uint256 assets = totalAssets();
+        return assets >= depositCap ? 0 : depositCap - assets;
+    }
+
+    function maxMint(address receiver) public view override returns (uint256) {
+        uint256 maxAssets = maxDeposit(receiver);
+        return maxAssets == type(uint256).max ? type(uint256).max : previewDeposit(maxAssets);
+    }
+
+    /* ------------------------------------------------------------------ */
+    /*                         ENTRY / EXIT FEES                          */
+    /* ------------------------------------------------------------------ */
+
+    /// @dev Fee already included in `assets`.
+    function _feeOnTotal(uint256 assets, uint256 feeBps) private pure returns (uint256) {
+        return Math.mulDiv(assets, feeBps, feeBps + 10_000, Math.Rounding.Ceil);
+    }
+
+    /// @dev Fee to add on top of `assets`.
+    function _feeOnRaw(uint256 assets, uint256 feeBps) private pure returns (uint256) {
+        return Math.mulDiv(assets, feeBps, 10_000, Math.Rounding.Ceil);
+    }
+
+    function previewDeposit(uint256 assets) public view override returns (uint256) {
+        return super.previewDeposit(assets - _feeOnTotal(assets, entryFeeBps));
+    }
+
+    function previewMint(uint256 shares) public view override returns (uint256) {
+        uint256 assets = super.previewMint(shares);
+        return assets + _feeOnRaw(assets, entryFeeBps);
+    }
+
+    function previewWithdraw(uint256 assets) public view override returns (uint256) {
+        return super.previewWithdraw(assets + _feeOnRaw(assets, exitFeeBps));
+    }
+
+    function previewRedeem(uint256 shares) public view override returns (uint256) {
+        uint256 assets = super.previewRedeem(shares);
+        return assets - _feeOnTotal(assets, exitFeeBps);
+    }
+
+    /// @dev OZ's default prices this straight off the share balance, which ignores the exit fee
+    ///      and would advertise more than a holder can actually take out. Route it through
+    ///      `previewRedeem` so `maxWithdraw` and `withdraw` agree.
+    function maxWithdraw(address owner_) public view override returns (uint256) {
+        return previewRedeem(balanceOf(owner_));
+    }
+
+    /* ------------------------------------------------------------------ */
+    /*                          DEPOSIT / WITHDRAW                        */
+    /* ------------------------------------------------------------------ */
+
+    function _deposit(address caller, address receiver, uint256 assets, uint256 shares)
+        internal
+        override
+        nonReentrant
+        whenNotPaused
+    {
+        if (depositCap != 0 && totalAssets() + assets > depositCap) revert DepositCapExceeded();
+        if (address(strategy) != address(0)) strategy.checkPriceHealthy();
+        super._deposit(caller, receiver, assets, shares);
+    }
+
+    function _withdraw(address caller, address receiver, address owner_, uint256 assets, uint256 shares)
+        internal
+        override
+        nonReentrant
+    {
+        uint256 idle = idleAssets();
+        if (address(strategy) != address(0)) {
+            // Checked even when idle covers the withdrawal: the share price still depends on the
+            // strategy's oracle-priced LP position.
+            strategy.checkPriceHealthy();
+            if (idle < assets) strategy.withdraw(assets - idle);
+        }
+        super._withdraw(caller, receiver, owner_, assets, shares);
+    }
+
+    /* ------------------------------------------------------------------ */
+    /*                              KEEPER OPS                            */
+    /* ------------------------------------------------------------------ */
+
+    /// @notice Push all idle USDC into the strategy and deploy it.
+    /// @dev Two steps on purpose: the vault only ever transfers to the strategy, and the strategy
+    ///      decides how to deploy. Callable by keeper or owner.
+    function pushToStrategy() external onlyKeeper returns (uint256 pushed) {
+        if (address(strategy) == address(0)) revert ZeroAddress();
+        pushed = idleAssets();
+        if (pushed == 0) return 0;
+        IERC20(asset()).safeTransfer(address(strategy), pushed);
+        emit PushedToStrategy(pushed);
+    }
+
+    /* ------------------------------------------------------------------ */
+    /*                             GOVERNANCE                             */
+    /* ------------------------------------------------------------------ */
+
+    /// @notice Install a strategy. Any incumbent must be fully unwound first.
+    function setStrategy(address _strategy) external onlyOwner {
+        if (_strategy == address(0)) revert ZeroAddress();
+        if (IStrategy(_strategy).asset() != asset()) revert StrategyAssetMismatch();
+        if (IStrategy(_strategy).vault() != address(this)) revert StrategyVaultMismatch();
+
+        address old = address(strategy);
+        if (old != address(0)) {
+            IStrategy(old).withdrawAll();
+            if (IStrategy(old).totalAssets() != 0) revert StrategyStillFunded();
+        }
+
+        strategy = IStrategy(_strategy);
+        emit StrategyUpdated(old, _strategy);
+    }
+
+    /// @notice Pull the entire strategy position back into the vault as idle USDC.
+    function retireStrategy() external onlyOwner returns (uint256 recovered) {
+        if (address(strategy) == address(0)) revert ZeroAddress();
+        recovered = strategy.withdrawAll();
+    }
+
+    function setKeeper(address _keeper) external onlyOwner {
+        if (_keeper == address(0)) revert ZeroAddress();
+        keeper = _keeper;
+        emit KeeperUpdated(_keeper);
+    }
+
+    function setFees(uint256 _entryFeeBps, uint256 _exitFeeBps) external onlyOwner {
+        if (_entryFeeBps > MAX_ENTRY_EXIT_FEE || _exitFeeBps > MAX_ENTRY_EXIT_FEE) revert FeeTooHigh();
+        entryFeeBps = _entryFeeBps;
+        exitFeeBps = _exitFeeBps;
+        emit FeesUpdated(_entryFeeBps, _exitFeeBps);
+    }
+
+    function setDepositCap(uint256 _cap) external onlyOwner {
+        depositCap = _cap;
+        emit DepositCapUpdated(_cap);
+    }
+
+    /// @notice Pause new deposits. Withdrawals stay open by design.
+    function pause() external onlyOwner {
+        _pause();
+    }
+
+    function unpause() external onlyOwner {
+        _unpause();
+    }
+}
diff --git a/src/interfaces/IAerodrome.sol b/src/interfaces/IAerodrome.sol
new file mode 100644
