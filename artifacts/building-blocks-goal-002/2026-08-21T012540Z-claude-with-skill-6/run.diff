new file mode 100644
index 0000000..faff436
--- /dev/null
+++ b/test/mocks/MockStrategy.sol
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.28;
+
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {IStrategy} from "../../src/interfaces/IStrategy.sol";
+
+/// @notice Stand-in for the Aerodrome strategy so vault mechanics can be tested offline.
+/// @dev Holds plain `asset` and exposes hooks to simulate profit, loss, an unhealthy oracle and
+///      an illiquid position. The real strategy is exercised against live Base state in the fork
+///      suite; this one is only here to isolate the vault.
+contract MockStrategy is IStrategy {
+    address public immutable override asset;
+    address public immutable override vault;
+
+    bool public oracleUnhealthy;
+    /// @dev Fraction of a withdrawal request the strategy can actually honour, in bps.
+    uint256 public liquidityBps = 10_000;
+
+    error OracleUnhealthy();
+
+    constructor(address _asset, address _vault) {
+        asset = _asset;
+        vault = _vault;
+    }
+
+    function totalAssets() external view override returns (uint256) {
+        return IERC20(asset).balanceOf(address(this));
+    }
+
+    function checkPriceHealthy() external view override {
+        if (oracleUnhealthy) revert OracleUnhealthy();
+    }
+
+    function withdraw(uint256 amount) external override {
+        require(msg.sender == vault, "not vault");
+        uint256 payable_ = (amount * liquidityBps) / 10_000;
+        require(IERC20(asset).transfer(vault, payable_), "transfer failed");
+    }
+
+    function withdrawAll() external override returns (uint256 out) {
+        require(msg.sender == vault, "not vault");
+        out = IERC20(asset).balanceOf(address(this));
+        require(IERC20(asset).transfer(vault, out), "transfer failed");
+    }
+
+    /* ----------------------------- test hooks ----------------------------- */
+
+    function setOracleUnhealthy(bool v) external {
+        oracleUnhealthy = v;
+    }
+
+    function setLiquidityBps(uint256 v) external {
+        liquidityBps = v;
+    }
+}
diff --git a/test/unit/YieldVault.t.sol b/test/unit/YieldVault.t.sol
new file mode 100644
index 0000000..248129a
--- /dev/null
+++ b/test/unit/YieldVault.t.sol
@@ -0,0 +1,369 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.28;
+
+import {Test} from "forge-std/Test.sol";
+import {Ownable} from "@openzeppelin/contracts/access/Ownable.sol";
+
+import {YieldVault} from "../../src/YieldVault.sol";
+import {MockERC20} from "../mocks/MockERC20.sol";
+import {MockStrategy} from "../mocks/MockStrategy.sol";
+
+/// @notice Vault mechanics in isolation, no network required.
+contract YieldVaultTest is Test {
+    YieldVault vault;
+    MockERC20 usdc;
+    MockStrategy strat;
+
+    address owner = makeAddr("owner");
+    address keeper = makeAddr("keeper");
+    address alice = makeAddr("alice");
+    address bob = makeAddr("bob");
+
+    uint256 constant AMT = 10_000e6;
+
+    function setUp() public {
+        usdc = new MockERC20("USD Coin", "USDC", 6);
+        vault = new YieldVault(address(usdc), owner, keeper, 0);
+        strat = new MockStrategy(address(usdc), address(vault));
+
+        vm.prank(owner);
+        vault.setStrategy(address(strat));
+
+        usdc.mint(alice, 1_000_000e6);
+        usdc.mint(bob, 1_000_000e6);
+
+        vm.prank(alice);
+        usdc.approve(address(vault), type(uint256).max);
+        vm.prank(bob);
+        usdc.approve(address(vault), type(uint256).max);
+
+        // Zero fees by default so the base accounting assertions are exact; fees get their own tests.
+        vm.prank(owner);
+        vault.setFees(0, 0);
+    }
+
+    /* ---------------------------- basic wiring ---------------------------- */
+
+    function test_Metadata() public view {
+        assertEq(vault.asset(), address(usdc));
+        assertEq(vault.decimals(), 12, "6 asset decimals + 6 offset");
+        assertEq(vault.symbol(), "bvUSDC");
+    }
+
+    function test_DepositMintsProportionalShares() public {
+        vm.prank(alice);
+        uint256 shares = vault.deposit(AMT, alice);
+
+        assertEq(vault.totalAssets(), AMT);
+        assertEq(vault.balanceOf(alice), shares);
+        assertEq(vault.convertToAssets(shares), AMT);
+    }
+
+    function test_TotalAssetsSpansIdleAndStrategy() public {
+        vm.prank(alice);
+        vault.deposit(AMT, alice);
+
+        vm.prank(keeper);
+        vault.pushToStrategy();
+
+        assertEq(vault.idleAssets(), 0);
+        assertEq(usdc.balanceOf(address(strat)), AMT);
+        assertEq(vault.totalAssets(), AMT, "strategy holdings must still count");
+
+        // A second deposit is idle again; both legs are counted.
+        vm.prank(bob);
+        vault.deposit(AMT, bob);
+        assertEq(vault.totalAssets(), 2 * AMT);
+    }
+
+    function test_WithdrawPullsFromStrategyWhenIdleIsShort() public {
+        vm.prank(alice);
+        vault.deposit(AMT, alice);
+        vm.prank(keeper);
+        vault.pushToStrategy();
+
+        vm.prank(alice);
+        vault.withdraw(AMT / 2, alice, alice);
+
+        assertEq(usdc.balanceOf(alice), 1_000_000e6 - AMT + AMT / 2);
+        assertEq(vault.totalAssets(), AMT / 2);
+    }
+
+    function test_ProfitAccruesToShareholdersProRata() public {
+        vm.prank(alice);
+        vault.deposit(AMT, alice);
+        vm.prank(bob);
+        vault.deposit(AMT, bob);
+
+        usdc.mint(address(vault), 2_000e6); // simulate a harvest
+
+        assertApproxEqAbs(vault.convertToAssets(vault.balanceOf(alice)), AMT + 1_000e6, 1);
+        assertApproxEqAbs(vault.convertToAssets(vault.balanceOf(bob)), AMT + 1_000e6, 1);
+    }
+
+    /* ------------------------------- fees --------------------------------- */
+
+    function test_EntryFeeIsRetainedForExistingHolders() public {
+        vm.prank(owner);
+        vault.setFees(30, 0);
+
+        vm.prank(alice);
+        vault.deposit(AMT, alice);
+
+        vm.prank(bob);
+        vault.deposit(AMT, bob);
+
+        uint256 bobValue = vault.convertToAssets(vault.balanceOf(bob));
+        uint256 aliceValue = vault.convertToAssets(vault.balanceOf(alice));
+
+        assertLt(bobValue, AMT, "bob must pay the entry fee");
+        assertGt(aliceValue, AMT, "the incumbent must receive it");
+        assertEq(vault.totalAssets(), 2 * AMT, "the fee stays in the vault, it is not paid out");
+        // Conservation: what bob gave up is exactly what alice gained.
+        assertApproxEqAbs(AMT - bobValue, aliceValue - AMT, 2, "fee is neither created nor destroyed");
+        // The fee is retained pro rata, so the payer claws back their own share of it. Holding
+        // ~half the vault after depositing, bob bears ~half of the 30bps he was charged.
+        uint256 charged = (AMT * 30) / 10_030;
+        assertApproxEqRel(AMT - bobValue, charged / 2, 0.01e18, "bob should bear about half the charge");
+    }
+
+    function test_ExitFeeIsRetainedForRemainingHolders() public {
+        vm.prank(owner);
+        vault.setFees(0, 30);
+
+        vm.prank(alice);
+        vault.deposit(AMT, alice);
+        vm.prank(bob);
+        vault.deposit(AMT, bob);
+
+        uint256 bobShares = vault.balanceOf(bob);
+        vm.prank(bob);
+        uint256 got = vault.redeem(bobShares, bob, bob);
+
+        assertLt(got, AMT, "bob should pay the exit fee");
+        assertApproxEqAbs(got, AMT - (AMT * 30) / 10_030, 2, "exit fee size");
+        assertGt(vault.convertToAssets(vault.balanceOf(alice)), AMT, "fee retained for alice");
+    }
+
+    function test_PreviewsMatchActualsWithFees() public {
+        vm.prank(owner);
+        vault.setFees(30, 30);
+
+        uint256 predictedShares = vault.previewDeposit(AMT);
+        vm.prank(alice);
+        uint256 actualShares = vault.deposit(AMT, alice);
+        assertEq(actualShares, predictedShares, "previewDeposit");
+
+        uint256 predictedAssets = vault.previewRedeem(actualShares);
+        vm.prank(alice);
+        uint256 actualAssets = vault.redeem(actualShares, alice, alice);
+        assertEq(actualAssets, predictedAssets, "previewRedeem");
+    }
+
+    /// @notice `maxWithdraw` must not advertise more than `withdraw` will actually honour.
+    function test_MaxWithdrawAccountsForTheExitFee() public {
+        vm.prank(owner);
+        vault.setFees(0, 50);
+
+        vm.prank(alice);
+        vault.deposit(AMT, alice);
+
+        uint256 max = vault.maxWithdraw(alice);
+        assertLt(max, AMT, "exit fee must be reflected");
+        assertEq(max, vault.previewRedeem(vault.balanceOf(alice)), "must agree with previewRedeem");
+
+        // The advertised maximum is actually withdrawable.
+        vm.prank(alice);
+        vault.withdraw(max, alice, alice);
+        assertLe(vault.maxWithdraw(alice), 1, "should be drained");
+    }
+
+    function test_FeeCannotExceedCap() public {
+        vm.prank(owner);
+        vm.expectRevert(YieldVault.FeeTooHigh.selector);
+        vault.setFees(101, 0);
+    }
+
+    /* ------------------------- caps, pause, oracle ------------------------ */
+
+    function test_DepositCapEnforced() public {
+        vm.prank(owner);
+        vault.setDepositCap(AMT);
+
+        vm.prank(alice);
+        vault.deposit(AMT, alice);
+
+        assertEq(vault.maxDeposit(alice), 0);
+        vm.prank(bob);
+        vm.expectRevert();
+        vault.deposit(1, bob);
+    }
+
+    function test_PauseBlocksDepositsButNotWithdrawals() public {
+        vm.prank(alice);
+        vault.deposit(AMT, alice);
+
+        vm.prank(owner);
+        vault.pause();
+
+        assertEq(vault.maxDeposit(alice), 0);
+        vm.prank(bob);
+        vm.expectRevert();
+        vault.deposit(AMT, bob);
+
+        // Exits stay open by design.
+        vm.prank(alice);
+        vault.withdraw(AMT, alice, alice);
+        assertEq(vault.totalAssets(), 0);
+    }
+
+    /// @notice A dislocated oracle must block both minting and burning of shares, including the
+    ///         case where idle USDC alone could have served the withdrawal.
+    function test_UnhealthyOracleBlocksMintAndBurn() public {
+        vm.prank(alice);
+        vault.deposit(AMT, alice);
+
+        strat.setOracleUnhealthy(true);
+
+        vm.prank(bob);
+        vm.expectRevert(MockStrategy.OracleUnhealthy.selector);
+        vault.deposit(AMT, bob);
+
+        vm.prank(alice);
+        vm.expectRevert(MockStrategy.OracleUnhealthy.selector);
+        vault.withdraw(1e6, alice, alice);
+    }
+
+    /// @notice If the strategy cannot return what the vault asked for, the withdrawal must revert
+    ///         rather than silently short-paying the user or minting a loss onto everyone else.
+    function test_WithdrawRevertsIfStrategyShortPays() public {
+        vm.prank(alice);
+        vault.deposit(AMT, alice);
+        vm.prank(keeper);
+        vault.pushToStrategy();
+
+        strat.setLiquidityBps(9_000);
+
+        vm.prank(alice);
+        vm.expectRevert();
+        vault.withdraw(AMT, alice, alice);
+    }
+
+    /* --------------------------- access control --------------------------- */
+
+    function test_OnlyKeeperCanPush() public {
+        vm.prank(alice);
+        vm.expectRevert(YieldVault.NotKeeper.selector);
+        vault.pushToStrategy();
+
+        vm.prank(keeper);
+        vault.pushToStrategy();
+
+        vm.prank(owner); // owner is also allowed
+        vault.pushToStrategy();
+    }
+
+    function test_OnlyOwnerGovernance() public {
+        vm.startPrank(alice);
+        vm.expectRevert(abi.encodeWithSelector(Ownable.OwnableUnauthorizedAccount.selector, alice));
+        vault.setKeeper(alice);
+        vm.expectRevert(abi.encodeWithSelector(Ownable.OwnableUnauthorizedAccount.selector, alice));
+        vault.setDepositCap(1);
+        vm.expectRevert(abi.encodeWithSelector(Ownable.OwnableUnauthorizedAccount.selector, alice));
+        vault.pause();
+        vm.expectRevert(abi.encodeWithSelector(Ownable.OwnableUnauthorizedAccount.selector, alice));
+        vault.setStrategy(address(strat));
+        vm.stopPrank();
+    }
+
+    function test_OwnershipTransferIsTwoStep() public {
+        vm.prank(owner);
+        vault.transferOwnership(alice);
+        assertEq(vault.owner(), owner, "must not transfer until accepted");
+
+        vm.prank(alice);
+        vault.acceptOwnership();
+        assertEq(vault.owner(), alice);
+    }
+
+    /* ------------------------- strategy management ------------------------ */
+
+    function test_SetStrategyRejectsMismatches() public {
+        MockERC20 other = new MockERC20("Other", "OTH", 18);
+        MockStrategy wrongAsset = new MockStrategy(address(other), address(vault));
+        MockStrategy wrongVault = new MockStrategy(address(usdc), address(0xdead));
+
+        vm.startPrank(owner);
+        vm.expectRevert(YieldVault.StrategyAssetMismatch.selector);
+        vault.setStrategy(address(wrongAsset));
+        vm.expectRevert(YieldVault.StrategyVaultMismatch.selector);
+        vault.setStrategy(address(wrongVault));
+        vm.stopPrank();
+    }
+
+    function test_SetStrategyUnwindsTheIncumbent() public {
+        vm.prank(alice);
+        vault.deposit(AMT, alice);
+        vm.prank(keeper);
+        vault.pushToStrategy();
+        assertEq(usdc.balanceOf(address(strat)), AMT);
+
+        MockStrategy next = new MockStrategy(address(usdc), address(vault));
+        vm.prank(owner);
+        vault.setStrategy(address(next));
+
+        assertEq(usdc.balanceOf(address(strat)), 0, "old strategy must be drained");
+        assertEq(vault.idleAssets(), AMT, "funds must land back in the vault");
+        assertEq(vault.totalAssets(), AMT, "no value lost in the migration");
+    }
+
+    /* ------------------------- inflation resistance ----------------------- */
+
+    /// @notice Classic first-depositor share-inflation attack. With a 6-decimal offset the
+    ///         attacker's donation cannot round the victim's shares down to zero.
+    function test_ResistsFirstDepositorInflationAttack() public {
+        vm.prank(alice); // attacker
+        vault.deposit(1, alice);
+
+        usdc.mint(address(vault), 100_000e6); // donate to inflate the share price
+
+        vm.prank(bob); // victim
+        uint256 bobShares = vault.deposit(10_000e6, bob);
+        assertGt(bobShares, 0, "victim minted zero shares");
+
+        vm.prank(bob);
+        uint256 bobOut = vault.redeem(bobShares, bob, bob);
+        assertGt(bobOut, 9_900e6, "victim lost more than 1% to the attack");
+    }
+
+    /* -------------------------------- fuzz -------------------------------- */
+
+    function testFuzz_DepositRedeemRoundTrip(uint256 amount) public {
+        amount = bound(amount, 1e6, 500_000e6);
+
+        vm.prank(alice);
+        uint256 shares = vault.deposit(amount, alice);
+        vm.prank(keeper);
+        vault.pushToStrategy();
+
+        vm.prank(alice);
+        uint256 out = vault.redeem(shares, alice, alice);
+
+        assertLe(out, amount, "round trip must never mint value");
+        assertApproxEqAbs(out, amount, 1, "round trip should be lossless with zero fees");
+    }
+
+    function testFuzz_SharePriceNeverFallsFromDeposits(uint256 a, uint256 b) public {
+        a = bound(a, 1e6, 100_000e6);
+        b = bound(b, 1e6, 100_000e6);
+
+        vm.prank(alice);
+        vault.deposit(a, alice);
+        uint256 priceBefore = vault.convertToAssets(1e12);
+
+        vm.prank(bob);
+        vault.deposit(b, bob);
+
+        assertGe(vault.convertToAssets(1e12), priceBefore, "a deposit diluted the share price");
+    }
