+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.28;
+
+import {Script, console2} from "forge-std/Script.sol";
+
+import {YieldVault} from "../src/YieldVault.sol";
+import {AerodromeUsdcWethStrategy} from "../src/AerodromeUsdcWethStrategy.sol";
+import {IVoter, IGauge, IPool} from "../src/interfaces/IAerodrome.sol";
+import {BaseAddresses as A} from "../test/BaseAddresses.sol";
+
+/// @notice Deploys the vault and its Aerodrome strategy to Base.
+/// @dev Run with:
+///      forge script script/Deploy.s.sol:Deploy --rpc-url $BASE_RPC_URL --broadcast --verify
+contract Deploy is Script {
+    function run() external {
+        address owner = vm.envAddress("VAULT_OWNER");
+        address keeper = vm.envAddress("VAULT_KEEPER");
+        address treasury = vm.envAddress("VAULT_TREASURY");
+        // Start capped. Aerodrome's vAMM WETH/USDC pool is the constraint, not the vault; see
+        // README "Capacity". Set to 0 only once the position is comfortably small vs pool depth.
+        uint256 depositCap = vm.envOr("VAULT_DEPOSIT_CAP", uint256(250_000e6));
+
+        require(block.chainid == 8453, "Deploy: Base only");
+        _preflight();
+
+        vm.startBroadcast();
+
+        YieldVault vault = new YieldVault(A.USDC, owner, keeper, depositCap);
+
+        AerodromeUsdcWethStrategy strategy = new AerodromeUsdcWethStrategy(
+            AerodromeUsdcWethStrategy.Config({
+                vault: address(vault),
+                usdc: A.USDC,
+                weth: A.WETH,
+                aero: A.AERO,
+                router: A.ROUTER,
+                gauge: A.GAUGE_WETH_USDC,
+                owner: owner,
+                keeper: keeper,
+                treasury: treasury
+            })
+        );
+
+        // setStrategy is onlyOwner, so the broadcaster must be `owner` for this to land. If
+        // governance is a multisig, drop this line and have the multisig call it afterwards.
+        vault.setStrategy(address(strategy));
+
+        vm.stopBroadcast();
+
+        console2.log("YieldVault  ", address(vault));
+        console2.log("Strategy    ", address(strategy));
+        console2.log("Pool        ", address(strategy.pool()));
+        console2.log("Gauge       ", address(strategy.gauge()));
+        console2.log("maxDeployable per earn()", strategy.maxDeployable());
+    }
+
+    /// @dev Refuse to deploy against a dead gauge or a mismatched pool. These are the assumptions
+    ///      the strategy is built on; checking them at deploy time is cheaper than finding out
+    ///      after users have funded the vault.
+    function _preflight() internal view {
+        address pool = IGauge(A.GAUGE_WETH_USDC).stakingToken();
+        require(pool == A.POOL_WETH_USDC, "preflight: gauge/pool mismatch");
+        require(IVoter(A.VOTER).gauges(pool) == A.GAUGE_WETH_USDC, "preflight: not the canonical gauge");
+        require(IVoter(A.VOTER).isAlive(A.GAUGE_WETH_USDC), "preflight: gauge is not alive");
+        require(IGauge(A.GAUGE_WETH_USDC).rewardToken() == A.AERO, "preflight: reward token changed");
+        require(IPool(pool).observationLength() > 48, "preflight: pool TWAP history too short");
+    }
+}
