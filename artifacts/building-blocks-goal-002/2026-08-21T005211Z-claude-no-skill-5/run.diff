--- /dev/null
+++ b/src/interfaces/IStrategy.sol
@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+/// @notice Interface the vault relies on. A strategy is always owned by exactly one vault.
+interface IStrategy {
+    /// @notice The ERC-20 the strategy accounts in (must equal the vault's asset).
+    function asset() external view returns (address);
+
+    /// @notice The vault authorised to move funds in and out.
+    function vault() external view returns (address);
+
+    /// @notice True when the strategy will not accept new capital, so the vault should stop
+    ///         routing deposits to it. Set by an emergency exit.
+    function halted() external view returns (bool);
+
+    /// @notice Assets under management, denominated in `asset`, at oracle-fair prices.
+    function totalAssets() external view returns (uint256);
+
+    /// @notice Deploy any `asset` sitting idle in the strategy.
+    function invest() external;
+
+    /// @notice Unwind at least `amount` of `asset` and send everything freed to the vault.
+    /// @return freed The amount of `asset` actually transferred to the vault.
+    function withdraw(uint256 amount) external returns (uint256 freed);
+
+    /// @notice Claim rewards, convert them to `asset`, and re-deploy.
+    /// @param minAssetsFromRewards Keeper-supplied floor on reward sale proceeds.
+    /// @return rewards Gross reward proceeds denominated in `asset`.
+    function harvest(uint256 minAssetsFromRewards) external returns (uint256 rewards);
+
+    /// @notice Unwind the whole position back to `asset` and return it to the vault.
+    function emergencyExit() external returns (uint256 freed);
+}
diff --git a/src/libraries/VolatileLpMath.sol b/src/libraries/VolatileLpMath.sol
new file mode 100644
index 0000000..cd9451d
--- /dev/null
+++ b/src/libraries/VolatileLpMath.sol
@@ -0,0 +1,72 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+import {Math} from "@openzeppelin/contracts/utils/math/Math.sol";
+
+/// @title VolatileLpMath
+/// @notice Fair-value pricing for constant-product (`xy = k`) LP tokens.
+///
+/// @dev Naively pricing an LP token from *spot* reserves lets anyone move the share price of a
+///      vault with a flash loan: push the pool far off market, mint/redeem at the distorted
+///      valuation, then arb the pool back. Instead we take only the invariant `k` from the pool
+///      (which a swap cannot decrease) and reconstruct the reserves the pool *would* hold if it
+///      were priced at an external oracle price:
+///
+///          r0' = sqrt(k * P)      r1' = sqrt(k / P)      value = 2 * sqrt(k * P)
+///
+///      where `P` is the price of token1 denominated in token0. `k` only grows (swap fees), so a
+///      manipulator can raise the reported value only by donating fees to the pool. This is the
+///      "fair LP pricing" construction popularised by Alpha Finance.
+library VolatileLpMath {
+    /// @notice Price scale used for `priceE18`: token0 units per 1e18 units of token1.
+    uint256 internal constant PRICE_SCALE = 1e18;
+
+    /// @notice Reserves the pool would hold at `priceE18`, preserving the invariant `k`.
+    /// @param reserve0 Current reserve of token0 (native decimals).
+    /// @param reserve1 Current reserve of token1 (native decimals).
+    /// @param priceE18 token0 units per `1e18` units of token1.
+    /// @return fair0 Fair reserve of token0. @return fair1 Fair reserve of token1.
+    function fairReserves(uint256 reserve0, uint256 reserve1, uint256 priceE18)
+        internal
+        pure
+        returns (uint256 fair0, uint256 fair1)
+    {
+        if (reserve0 == 0 || reserve1 == 0 || priceE18 == 0) return (0, 0);
+        uint256 k = reserve0 * reserve1;
+        // fair0 = sqrt(k * P) where P = priceE18 / 1e18
+        fair0 = Math.sqrt(Math.mulDiv(k, priceE18, PRICE_SCALE));
+        // fair1 = sqrt(k / P)
+        fair1 = Math.sqrt(Math.mulDiv(k, PRICE_SCALE, priceE18));
+    }
+
+    /// @notice Value of `lpAmount` LP tokens, denominated in token0.
+    /// @param lpAmount LP tokens to price.
+    /// @param totalSupply LP token total supply.
+    function lpValueInToken0(
+        uint256 lpAmount,
+        uint256 totalSupply,
+        uint256 reserve0,
+        uint256 reserve1,
+        uint256 priceE18
+    ) internal pure returns (uint256) {
+        if (lpAmount == 0 || totalSupply == 0) return 0;
+        (uint256 fair0,) = fairReserves(reserve0, reserve1, priceE18);
+        // A balanced constant-product pool holds equal value on both sides, so the whole pool is
+        // worth 2 * fair0 denominated in token0.
+        return Math.mulDiv(lpAmount, 2 * fair0, totalSupply);
+    }
+
+    /// @notice Token amounts a proportional burn of `lpAmount` should return at fair prices.
+    function fairExitAmounts(
+        uint256 lpAmount,
+        uint256 totalSupply,
+        uint256 reserve0,
+        uint256 reserve1,
+        uint256 priceE18
+    ) internal pure returns (uint256 amount0, uint256 amount1) {
+        if (lpAmount == 0 || totalSupply == 0) return (0, 0);
+        (uint256 fair0, uint256 fair1) = fairReserves(reserve0, reserve1, priceE18);
+        amount0 = Math.mulDiv(lpAmount, fair0, totalSupply);
+        amount1 = Math.mulDiv(lpAmount, fair1, totalSupply);
+    }
+}
diff --git a/test/BaseTest.sol b/test/BaseTest.sol
new file mode 100644
index 0000000..9c18b86
--- /dev/null
+++ b/test/BaseTest.sol
@@ -0,0 +1,189 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+import {Test} from "forge-std/Test.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {Math} from "@openzeppelin/contracts/utils/math/Math.sol";
+
+import {YieldVault} from "../src/YieldVault.sol";
+import {AerodromeLpStrategy} from "../src/AerodromeLpStrategy.sol";
+import {IAerodromeRouter} from "../src/interfaces/IAerodromeRouter.sol";
+
+import {MockERC20} from "./mocks/MockERC20.sol";
+import {MockAerodromePool} from "./mocks/MockAerodromePool.sol";
+import {MockAerodromeRouter} from "./mocks/MockAerodromeRouter.sol";
+import {MockAerodromeGauge} from "./mocks/MockAerodromeGauge.sol";
+import {MockV3Aggregator} from "./mocks/MockV3Aggregator.sol";
+
+/// @dev Shared fixture: a USDC/WETH volatile pool seeded at the oracle price with $60m of
+///      liquidity, an AERO/WETH pool for the reward sale, a gauge emitting AERO, and the
+///      vault + strategy wired together the way the deploy script wires them.
+abstract contract BaseTest is Test {
+    // Aerodrome volatile pools charge a fee on input. The deep WETH/USDC pool on Base runs a
+    // low fee; thinner pairs like AERO/WETH sit at the default end of the range.
+    uint256 internal constant POOL_FEE_BPS = 5;
+    uint256 internal constant AERO_POOL_FEE_BPS = 30;
+
+    uint256 internal constant INITIAL_ETH_PRICE = 3000e8; // Chainlink ETH/USD, 8 decimals
+    uint256 internal constant INITIAL_USDC_PRICE = 1e8; // Chainlink USDC/USD, 8 decimals
+
+    uint256 internal constant POOL_WETH = 10_000e18;
+    uint256 internal constant POOL_USDC = 30_000_000e6;
+
+    uint256 internal constant AERO_POOL_AERO = 1_000_000e18;
+    uint256 internal constant AERO_POOL_WETH = 333e18; // ~ $1 per AERO at $3000 ETH
+
+    MockERC20 internal usdc;
+    MockERC20 internal weth;
+    MockERC20 internal aero;
+
+    MockAerodromePool internal pool; // USDC/WETH
+    MockAerodromePool internal aeroPool; // AERO/WETH
+    MockAerodromeRouter internal router;
+    MockAerodromeGauge internal gauge;
+    MockV3Aggregator internal ethFeed;
+    MockV3Aggregator internal usdcFeed;
+
+    YieldVault internal vault;
+    AerodromeLpStrategy internal strategy;
+
+    address internal owner = makeAddr("owner");
+    address internal keeper = makeAddr("keeper");
+    address internal treasury = makeAddr("treasury");
+    address internal alice = makeAddr("alice");
+    address internal bob = makeAddr("bob");
+    address internal attacker = makeAddr("attacker");
+    address internal factory = makeAddr("poolFactory");
+
+    function setUp() public virtual {
+        vm.warp(1_700_000_000);
+
+        usdc = new MockERC20("USD Coin", "USDC", 6);
+        weth = new MockERC20("Wrapped Ether", "WETH", 18);
+        aero = new MockERC20("Aerodrome", "AERO", 18);
+
+        pool = new MockAerodromePool(address(usdc), address(weth), false, POOL_FEE_BPS);
+        aeroPool = new MockAerodromePool(address(aero), address(weth), false, AERO_POOL_FEE_BPS);
+
+        router = new MockAerodromeRouter(factory);
+        router.registerPool(address(pool));
+        router.registerPool(address(aeroPool));
+
+        _seed(pool, address(usdc), POOL_USDC, address(weth), POOL_WETH);
+        _seed(aeroPool, address(aero), AERO_POOL_AERO, address(weth), AERO_POOL_WETH);
+
+        gauge = new MockAerodromeGauge(address(pool), address(aero));
+        ethFeed = new MockV3Aggregator(8, int256(INITIAL_ETH_PRICE), "ETH / USD");
+        usdcFeed = new MockV3Aggregator(8, int256(INITIAL_USDC_PRICE), "USDC / USD");
+
+        vault = new YieldVault(IERC20(address(usdc)), "Base USDC Yield Vault", "byUSDC", owner, treasury);
+
+        strategy = new AerodromeLpStrategy(
+            AerodromeLpStrategy.Config({
+                vault: address(vault),
+                usdc: address(usdc),
+                weth: address(weth),
+                router: address(router),
+                pool: address(pool),
+                gauge: address(gauge),
+                ethUsdFeed: address(ethFeed),
+                usdcUsdFeed: address(usdcFeed),
+                owner: owner
+            })
+        );
+
+        vm.startPrank(owner);
+        vault.setStrategy(strategy);
+        vault.setKeeper(keeper, true);
+        strategy.setMinAeroPriceE6(0.5e6); // AERO must fetch at least $0.50
+        vm.stopPrank();
+
+        // 1 AERO per second per 1e18 staked LP.
+        gauge.setRewardRate(1e18);
+    }
+
+    function _seed(MockAerodromePool p, address a, uint256 amtA, address b, uint256 amtB) internal {
+        MockERC20(a).mint(address(p), amtA);
+        MockERC20(b).mint(address(p), amtB);
+        p.mint(address(this));
+    }
+
+    /// @dev Push a fresh timestamp into both feeds so warping does not trip the staleness guard.
+    function _refreshOracles() internal {
+        ethFeed.setAnswer(ethFeed.answer());
+        usdcFeed.setAnswer(usdcFeed.answer());
+    }
+
+    function _deposit(address user, uint256 amount) internal returns (uint256 shares) {
+        usdc.mint(user, amount);
+        vm.startPrank(user);
+        usdc.approve(address(vault), amount);
+        shares = vault.deposit(amount, user);
+        vm.stopPrank();
+    }
+
+    function _allocate() internal {
+        vm.prank(keeper);
+        vault.allocate();
+    }
+
+    /// @dev Mirrors what an off-chain keeper does: quote the AERO sale, then apply a tolerance.
+    function _quoteRewardMinOut(uint256 toleranceBps) internal view returns (uint256) {
+        uint256 pending = strategy.pendingRewards();
+        if (pending == 0) return 0;
+        uint256[] memory amounts = router.getAmountsOut(pending, strategy.aeroSaleRoute());
+        uint256 expected = amounts[amounts.length - 1];
+        return expected * (10_000 - toleranceBps) / 10_000;
+    }
+
+    function _harvest() internal returns (uint256) {
+        uint256 minOut = _quoteRewardMinOut(100);
+        vm.prank(keeper);
+        return vault.harvest(minOut);
+    }
+
+    /// @dev Value of one share, scaled to 1e18, for share-price assertions.
+    function _pricePerShare() internal view returns (uint256) {
+        return vault.convertToAssets(1e18);
+    }
+
+    /// @dev Stand-in for the arbitrage that keeps a live pool pinned to the market price. The
+    ///      strategy deliberately declines to add liquidity while the pool is dislocated, so
+    ///      tests that deploy capital across several calls have to model this.
+    function _arbPoolToOracle() internal {
+        (uint256 r0, uint256 r1,) = pool.getReserves();
+        (uint256 rUsdc, uint256 rWeth) =
+            pool.token0() == address(usdc) ? (r0, r1) : (r1, r0);
+        uint256 price = uint256(ethFeed.answer()) * 1e6 / uint256(usdcFeed.answer());
+        uint256 k = rUsdc * rWeth;
+        uint256 fairUsdc = Math.sqrt(Math.mulDiv(k, price, 1e18));
+
+        address arb = makeAddr("arbitrageur");
+        vm.startPrank(arb);
+        if (fairUsdc > rUsdc) {
+            uint256 amtIn = fairUsdc - rUsdc;
+            usdc.mint(arb, amtIn);
+            usdc.approve(address(router), amtIn);
+            router.swapExactTokensForTokens(amtIn, 0, _oneHop(address(usdc), address(weth)), arb, block.timestamp);
+        } else {
+            uint256 fairWeth = Math.sqrt(Math.mulDiv(k, 1e18, price));
+            if (fairWeth > rWeth) {
+                uint256 amtIn = fairWeth - rWeth;
+                weth.mint(arb, amtIn);
+                weth.approve(address(router), amtIn);
+                router.swapExactTokensForTokens(amtIn, 0, _oneHop(address(weth), address(usdc)), arb, block.timestamp);
+            }
+        }
+        vm.stopPrank();
+    }
+
+    function _oneHop(address from, address to) internal view returns (IAerodromeRouter.Route[] memory r) {
+        r = new IAerodromeRouter.Route[](1);
+        r[0] = IAerodromeRouter.Route({from: from, to: to, stable: false, factory: factory});
+    }
+
+    function _skipAndRefresh(uint256 secs) internal {
+        vm.warp(block.timestamp + secs);
+        _refreshOracles();
+    }
+}
diff --git a/test/Emergency.t.sol b/test/Emergency.t.sol
new file mode 100644
index 0000000..2a43c6f
--- /dev/null
+++ b/test/Emergency.t.sol
@@ -0,0 +1,124 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+import {BaseTest} from "./BaseTest.sol";
+import {AerodromeLpStrategy} from "../src/AerodromeLpStrategy.sol";
+import {Ownable} from "@openzeppelin/contracts/access/Ownable.sol";
+
+contract EmergencyTest is BaseTest {
+    function _setUpPosition() internal {
+        _deposit(alice, 100_000e6);
+        _allocate();
+        _arbPoolToOracle();
+    }
+
+    function test_EmergencyExitLatchesTheStrategyOff() public {
+        _setUpPosition();
+
+        vm.prank(owner);
+        strategy.emergencyExit();
+        assertTrue(strategy.emergencyMode());
+
+        // A routine keeper allocation must neither re-enter the pool nor push capital into a
+        // strategy that has been switched off.
+        _allocate();
+        assertEq(strategy.lpBalance(), 0, "stayed out");
+        assertEq(strategy.totalAssets(), 0, "no capital parked in the halted strategy");
+        assertApproxEqRel(vault.idleAssets(), 100_000e6, 0.01e18);
+    }
+
+    function test_HarvestInEmergencyModeReturnsProceedsToVault() public {
+        _setUpPosition();
+        _skipAndRefresh(2 days);
+
+        uint256 pending = strategy.pendingRewards();
+        assertGt(pending, 0);
+
+        vm.prank(owner);
+        strategy.emergencyExit();
+
+        uint256 idleBefore = vault.idleAssets();
+        _harvest();
+
+        assertGt(vault.idleAssets(), idleBefore, "reward proceeds reached the vault");
+        assertEq(strategy.lpBalance(), 0, "nothing was re-deployed");
+    }
+
+    function test_StrategyCanBeReArmedAfterAnEmergency() public {
+        _setUpPosition();
+
+        vm.startPrank(owner);
+        strategy.emergencyExit();
+        strategy.setEmergencyMode(false);
+        vm.stopPrank();
+
+        vm.prank(owner);
+        vault.setDepositsPaused(false);
+
+        _allocate();
+        assertGt(strategy.lpBalance(), 0, "back in the pool");
+    }
+
+    /// @dev The scenario that would otherwise trap funds: Chainlink stops updating, so every
+    ///      oracle-priced path (including the normal emergency exit) reverts.
+    function test_ManualExitWorksWithADeadOracle() public {
+        _setUpPosition();
+        uint256 lpHeld = strategy.lpBalance();
+
+        // Feeds go dark.
+        vm.warp(block.timestamp + 7 days);
+
+        vm.expectRevert();
+        vault.totalAssets();
+        vm.prank(owner);
+        vm.expectRevert();
+        strategy.emergencyExit();
+
+        // Governance supplies the bounds by hand instead of reading a price.
+        (uint256 rUsdc, uint256 rWeth) = _reservesUsdcWeth();
+        uint256 supply = pool.totalSupply();
+        uint256 expUsdc = rUsdc * lpHeld / supply;
+        uint256 expWeth = rWeth * lpHeld / supply;
+
+        vm.prank(owner);
+        strategy.emergencyExitManual(expUsdc * 97 / 100, expWeth * 97 / 100, 1);
+
+        assertEq(strategy.lpBalance(), 0);
+        assertEq(weth.balanceOf(address(strategy)), 0, "fully back in USDC");
+
+        // With no LP and no WETH left, valuation no longer touches the oracle at all.
+        assertApproxEqRel(vault.totalAssets(), 100_000e6, 0.01e18);
+
+        uint256 shares = vault.balanceOf(alice);
+        vm.prank(alice);
+        vault.redeem(shares, alice, alice, 100);
+        assertApproxEqRel(usdc.balanceOf(alice), 100_000e6, 0.01e18, "user got out");
+    }
+
+    function test_ManualExitRespectsTheSuppliedBounds() public {
+        _setUpPosition();
+        vm.warp(block.timestamp + 7 days);
+
+        vm.prank(owner);
+        vm.expectRevert(); // router: INSUFFICIENT_A_AMOUNT
+        strategy.emergencyExitManual(type(uint128).max, 0, 0);
+    }
+
+    function test_ManualExitIsOwnerOnly() public {
+        _setUpPosition();
+        vm.prank(keeper);
+        vm.expectRevert(abi.encodeWithSelector(Ownable.OwnableUnauthorizedAccount.selector, keeper));
+        strategy.emergencyExitManual(0, 0, 0);
+    }
+
+    function test_SetEmergencyModeIsOwnerOnly() public {
+        vm.prank(keeper);
+        vm.expectRevert(abi.encodeWithSelector(Ownable.OwnableUnauthorizedAccount.selector, keeper));
+        strategy.setEmergencyMode(true);
+    }
+
+    function _reservesUsdcWeth() internal view returns (uint256 rUsdc, uint256 rWeth) {
+        (uint256 r0, uint256 r1,) = pool.getReserves();
+        (rUsdc, rWeth) = pool.token0() == address(usdc) ? (r0, r1) : (r1, r0);
+    }
+}
diff --git a/test/Harvest.t.sol b/test/Harvest.t.sol
new file mode 100644
index 0000000..b1c06d7
--- /dev/null
+++ b/test/Harvest.t.sol
@@ -0,0 +1,294 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+import {BaseTest} from "./BaseTest.sol";
+import {YieldVault} from "../src/YieldVault.sol";
+import {AerodromeLpStrategy} from "../src/AerodromeLpStrategy.sol";
+import {IAerodromeRouter} from "../src/interfaces/IAerodromeRouter.sol";
+import {MockAerodromePool} from "./mocks/MockAerodromePool.sol";
+
+contract HarvestTest is BaseTest {
+    function _setUpPosition() internal {
+        _deposit(alice, 100_000e6);
+        _allocate();
+        _arbPoolToOracle();
+    }
+
+    // -----------------------------------------------------------------
+    // Compounding
+    // -----------------------------------------------------------------
+
+    function test_HarvestClaimsAndCompoundsRewards() public {
+        _setUpPosition();
+        uint256 lpBefore = strategy.lpBalance();
+
+        _skipAndRefresh(1 days);
+        assertGt(strategy.pendingRewards(), 0, "gauge accrued AERO");
+
+        uint256 gross = _harvest();
+
+        assertGt(gross, 0, "harvest realised USDC");
+        assertEq(aero.balanceOf(address(strategy)), 0, "all AERO sold");
+        assertGt(strategy.lpBalance(), lpBefore, "proceeds went back into the LP position");
+        assertEq(strategy.pendingRewards(), 0, "gauge claim is settled");
+    }
+
+    function test_HarvestIsANoOpWithoutRewards() public {
+        _setUpPosition();
+        uint256 assetsBefore = vault.totalAssets();
+
+        vm.prank(keeper);
+        uint256 gross = vault.harvest(0);
+
+        assertEq(gross, 0, "nothing to compound");
+        // The trailing re-allocation may still nudge a few cents of buffer into the pool.
+        assertApproxEqRel(vault.totalAssets(), assetsBefore, 0.0001e18);
+    }
+
+    function test_CompoundingRaisesSharePriceOverTime() public {
+        _setUpPosition();
+        uint256 ppsStart = _pricePerShare();
+
+        for (uint256 i = 0; i < 7; ++i) {
+            _skipAndRefresh(1 days);
+            _arbPoolToOracle();
+            _harvest();
+        }
+        // Let the last harvest's profit finish unlocking.
+        _skipAndRefresh(vault.profitUnlockPeriod());
+
+        assertGt(_pricePerShare(), ppsStart, "a week of emissions lifts the share price");
+    }
+
+    function test_HarvestedValueSurvivesARoundTrip() public {
+        _setUpPosition();
+
+        for (uint256 i = 0; i < 5; ++i) {
+            _skipAndRefresh(1 days);
+            _arbPoolToOracle();
+            _harvest();
+        }
+        _skipAndRefresh(vault.profitUnlockPeriod());
+        _arbPoolToOracle();
+
+        uint256 shares = vault.balanceOf(alice);
+        vm.prank(alice);
+        uint256 out = vault.redeem(shares, alice, alice, 100);
+
+        assertGt(out, 100_000e6, "depositor is up after fees and DEX costs");
+    }
+
+    // -----------------------------------------------------------------
+    // Performance fee
+    // -----------------------------------------------------------------
+
+    function test_PerformanceFeeIsMintedToTreasuryAsShares() public {
+        _setUpPosition();
+        _skipAndRefresh(1 days);
+
+        assertEq(vault.balanceOf(treasury), 0);
+        uint256 gross = _harvest();
+
+        uint256 feeShares = vault.balanceOf(treasury);
+        assertGt(feeShares, 0, "treasury was paid");
+
+        // 10% of gross proceeds, allowing for the rounding that favours depositors.
+        uint256 feeValue = vault.convertToAssets(feeShares);
+        assertApproxEqRel(feeValue, gross / 10, 0.02e18);
+    }
+
+    function test_NoFeeWhenPerformanceFeeIsZero() public {
+        vm.prank(owner);
+        vault.setPerformanceFee(0, treasury);
+
+        _setUpPosition();
+        _skipAndRefresh(1 days);
+        _harvest();
+
+        assertEq(vault.balanceOf(treasury), 0);
+    }
+
+    function test_FeeIsChargedOnRewardsNotOnPriceMoves() public {
+        _setUpPosition();
+
+        // ETH doubles. The LP position revalues, but that is not "profit" to be taxed.
+        ethFeed.setAnswer(6000e8);
+        _arbPoolToOracle();
+
+        vm.prank(keeper);
+        vault.harvest(0);
+
+        assertEq(vault.balanceOf(treasury), 0, "no reward proceeds means no fee");
+    }
+
+    // -----------------------------------------------------------------
+    // Profit locking / harvest front-running
+    // -----------------------------------------------------------------
+
+    function test_ProfitUnlocksLinearly() public {
+        _setUpPosition();
+        _skipAndRefresh(2 days);
+
+        uint256 ppsBefore = _pricePerShare();
+        _harvest();
+
+        uint256 ppsImmediatelyAfter = _pricePerShare();
+        assertApproxEqRel(ppsImmediatelyAfter, ppsBefore, 0.0005e18, "no instant jump");
+        assertGt(vault.lockedProfit(), 0);
+
+        _skipAndRefresh(vault.profitUnlockPeriod() / 2);
+        uint256 ppsHalfway = _pricePerShare();
+        assertGt(ppsHalfway, ppsImmediatelyAfter);
+
+        _skipAndRefresh(vault.profitUnlockPeriod() / 2 + 1);
+        assertEq(vault.lockedProfit(), 0, "fully unlocked");
+        assertGt(_pricePerShare(), ppsHalfway);
+    }
+
+    /// @dev The attack profit locking exists to stop: deposit in the block before a harvest,
+    ///      redeem in the block after, and skim the step-up without carrying any risk.
+    function test_SandwichingAHarvestIsNotProfitable() public {
+        _setUpPosition();
+        _skipAndRefresh(7 days);
+        _arbPoolToOracle();
+
+        uint256 stake = 500_000e6;
+        usdc.mint(attacker, stake);
+        vm.startPrank(attacker);
+        usdc.approve(address(vault), stake);
+        vault.deposit(stake, attacker);
+        vm.stopPrank();
+
+        _harvest();
+
+        uint256 shares = vault.balanceOf(attacker);
+        vm.prank(attacker);
+        uint256 out = vault.redeem(shares, attacker, attacker, 100);
+
+        assertLt(out, stake, "sandwiching the harvest loses money");
+    }
+
+    function test_LongTermHolderKeepsTheProfitTheSandwicherMissed() public {
+        _setUpPosition();
+        _skipAndRefresh(7 days);
+        _arbPoolToOracle();
+        _harvest();
+
+        uint256 ppsRightAfterHarvest = _pricePerShare();
+        _skipAndRefresh(vault.profitUnlockPeriod());
+
+        assertGt(_pricePerShare(), ppsRightAfterHarvest, "the held-back profit accrues to holders");
+    }
+
+    function test_BackToBackHarvestsDoNotFlushLockedProfitEarly() public {
+        _setUpPosition();
+        _skipAndRefresh(2 days);
+        _harvest();
+
+        uint256 lockedAfterFirst = vault.lockedProfit();
+        assertGt(lockedAfterFirst, 0);
+
+        // A second harvest moments later must carry the unreleased remainder forward rather than
+        // resetting the schedule and dumping it into the share price.
+        _skipAndRefresh(1);
+        _harvest();
+        assertApproxEqRel(vault.lockedProfit(), lockedAfterFirst, 0.001e18, "remainder carried over");
+    }
+
+    function test_SetProfitUnlockPeriodSettlesTheOldSchedule() public {
+        _setUpPosition();
+        _skipAndRefresh(2 days);
+        _harvest();
+
+        uint256 lockedBefore = vault.lockedProfit();
+        vm.prank(owner);
+        vault.setProfitUnlockPeriod(1 hours);
+        assertApproxEqAbs(vault.lockedProfit(), lockedBefore, 1, "no jump when the schedule changes");
+    }
+
+    // -----------------------------------------------------------------
+    // Keeper guardrails
+    // -----------------------------------------------------------------
+
+    function test_HarvestRespectsKeeperMinOut() public {
+        _setUpPosition();
+        _skipAndRefresh(1 days);
+
+        uint256 fair = _quoteRewardMinOut(0);
+        vm.prank(keeper);
+        vm.expectRevert(); // router: INSUFFICIENT_OUTPUT_AMOUNT
+        vault.harvest(fair * 2);
+    }
+
+    /// @dev A keeper key is a hot key. Even if it is stolen, it must not be able to hand the
+    ///      harvest to a sandwicher by passing minOut = 0.
+    function test_KeeperCannotDumpRewardsBelowTheGovernanceFloor() public {
+        _setUpPosition();
+        _skipAndRefresh(3 days);
+
+        uint256 pending = strategy.pendingRewards();
+        uint256 floor = pending * 0.5e6 / 1e18; // minAeroPriceE6 = $0.50
+
+        vm.prank(keeper);
+        vm.expectRevert(
+            abi.encodeWithSelector(AerodromeLpStrategy.RewardPriceFloorNotMet.selector, 0, floor)
+        );
+        vault.harvest(0);
+
+        // A sane minOut clears the floor.
+        vm.prank(keeper);
+        vault.harvest(floor + 1);
+    }
+
+    function test_KeeperCannotChooseTheRewardSaleRoute() public {
+        IAerodromeRouter.Route[] memory evil = new IAerodromeRouter.Route[](1);
+        evil[0] =
+            IAerodromeRouter.Route({from: address(aero), to: address(usdc), stable: false, factory: factory});
+
+        vm.prank(keeper);
+        vm.expectRevert();
+        strategy.setAeroSaleRoute(evil);
+    }
+
+    function test_OwnerCanRepointTheRewardSaleRoute() public {
+        // Give AERO a direct USDC pair and route through it instead.
+        MockAerodromePool aeroUsdc = _newAeroUsdcPool();
+        _seed(aeroUsdc, address(aero), 1_000_000e18, address(usdc), 1_000_000e6);
+
+        IAerodromeRouter.Route[] memory direct = new IAerodromeRouter.Route[](1);
+        direct[0] =
+            IAerodromeRouter.Route({from: address(aero), to: address(usdc), stable: false, factory: factory});
+
+        vm.prank(owner);
+        strategy.setAeroSaleRoute(direct);
+        assertEq(strategy.aeroSaleRoute().length, 1);
+
+        _setUpPosition();
+        _skipAndRefresh(1 days);
+        assertGt(_harvest(), 0, "harvest works over the new route");
+    }
+
+    function test_RewardRouteMustStartAtAeroAndEndAtUsdc() public {
+        IAerodromeRouter.Route[] memory bad = new IAerodromeRouter.Route[](1);
+        bad[0] = IAerodromeRouter.Route({from: address(weth), to: address(usdc), stable: false, factory: factory});
+
+        vm.prank(owner);
+        vm.expectRevert(AerodromeLpStrategy.InvalidRoute.selector);
+        strategy.setAeroSaleRoute(bad);
+
+        IAerodromeRouter.Route[] memory disjoint = new IAerodromeRouter.Route[](2);
+        disjoint[0] =
+            IAerodromeRouter.Route({from: address(aero), to: address(weth), stable: false, factory: factory});
+        disjoint[1] =
+            IAerodromeRouter.Route({from: address(aero), to: address(usdc), stable: false, factory: factory});
+
+        vm.prank(owner);
+        vm.expectRevert(AerodromeLpStrategy.InvalidRoute.selector);
+        strategy.setAeroSaleRoute(disjoint);
+    }
+
+    function _newAeroUsdcPool() internal returns (MockAerodromePool p) {
+        p = new MockAerodromePool(address(aero), address(usdc), false, AERO_POOL_FEE_BPS);
+        router.registerPool(address(p));
+    }
+}
diff --git a/test/StrategySecurity.t.sol b/test/StrategySecurity.t.sol
new file mode 100644
index 0000000..482112c
--- /dev/null
+++ b/test/StrategySecurity.t.sol
@@ -0,0 +1,316 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+import {BaseTest} from "./BaseTest.sol";
+import {AerodromeLpStrategy} from "../src/AerodromeLpStrategy.sol";
+import {VolatileLpMath} from "../src/libraries/VolatileLpMath.sol";
+import {Math} from "@openzeppelin/contracts/utils/math/Math.sol";
+
+contract StrategySecurityTest is BaseTest {
+    function _setUpPosition() internal {
+        _deposit(alice, 100_000e6);
+        _allocate();
+        _arbPoolToOracle();
+    }
+
+    // -----------------------------------------------------------------
+    // Oracle handling
+    // -----------------------------------------------------------------
+
+    function test_EthPriceIsDenominatedInUsdcNotUsd() public {
+        assertEq(strategy.ethPriceInUsdc(), 3000e6);
+
+        // A USDC depeg must move the ETH/USDC rate, not be silently assumed away.
+        usdcFeed.setAnswer(0.98e8);
+        assertApproxEqRel(strategy.ethPriceInUsdc(), uint256(3000e6) * 100 / 98, 0.0001e18);
+    }
+
+    function test_StaleEthFeedBlocksValuation() public {
+        _setUpPosition();
+        vm.warp(block.timestamp + 4 hours); // past maxOracleStaleness, feeds not refreshed
+
+        vm.expectRevert();
+        strategy.totalAssets();
+        vm.expectRevert();
+        vault.totalAssets();
+    }
+
+    function test_StaleUsdcFeedBlocksValuation() public {
+        _setUpPosition();
+        ethFeed.setUpdatedAt(block.timestamp);
+        usdcFeed.setUpdatedAt(block.timestamp - 4 hours);
+
+        vm.expectRevert(abi.encodeWithSelector(AerodromeLpStrategy.StaleOracle.selector, block.timestamp - 4 hours));
+        strategy.totalAssets();
+    }
+
+    function test_NonPositiveOracleAnswerReverts() public {
+        ethFeed.setAnswer(0);
+        vm.expectRevert(abi.encodeWithSelector(AerodromeLpStrategy.InvalidOracleAnswer.selector, int256(0)));
+        strategy.ethPriceInUsdc();
+
+        ethFeed.setAnswer(-1);
+        vm.expectRevert(abi.encodeWithSelector(AerodromeLpStrategy.InvalidOracleAnswer.selector, int256(-1)));
+        strategy.ethPriceInUsdc();
+    }
+
+    function test_StalenessWindowIsBounded() public {
+        vm.startPrank(owner);
+        vm.expectRevert(AerodromeLpStrategy.InvalidParameter.selector);
+        strategy.setMaxOracleStaleness(0);
+        vm.expectRevert(AerodromeLpStrategy.InvalidParameter.selector);
+        strategy.setMaxOracleStaleness(2 days);
+        strategy.setMaxOracleStaleness(30 minutes);
+        vm.stopPrank();
+        assertEq(strategy.maxOracleStaleness(), 30 minutes);
+    }
+
+    // -----------------------------------------------------------------
+    // Price-manipulation resistance
+    // -----------------------------------------------------------------
+
+    /// @dev The core reason valuation uses `k` plus an oracle instead of spot reserves. A whale
+    ///      swap moves the pool hard; the vault's share price must barely notice.
+    function test_ShareValuationIgnoresPoolManipulation() public {
+        _setUpPosition();
+        uint256 assetsBefore = vault.totalAssets();
+        uint256 ppsBefore = _pricePerShare();
+
+        // Shove 10m USDC through the pool: spot ETH price jumps by a third.
+        usdc.mint(attacker, 10_000_000e6);
+        vm.startPrank(attacker);
+        usdc.approve(address(router), type(uint256).max);
+        router.swapExactTokensForTokens(
+            10_000_000e6, 0, _oneHop(address(usdc), address(weth)), attacker, block.timestamp
+        );
+        vm.stopPrank();
+
+        assertGt(strategy.poolDeviationBps(), 2_000, "pool really is dislocated");
+        // Valuation moves only by the fees the manipulator paid into `k`.
+        assertApproxEqRel(vault.totalAssets(), assetsBefore, 0.002e18, "AUM is not moved by spot");
+        assertApproxEqRel(_pricePerShare(), ppsBefore, 0.002e18, "share price is not moved by spot");
+    }
+
+    function test_ManipulatedPoolCannotBeUsedToMintCheapShares() public {
+        _setUpPosition();
+
+        uint256 spent = 10_100_000e6; // manipulation capital + the deposit
+        usdc.mint(attacker, spent);
+
+        vm.startPrank(attacker);
+        usdc.approve(address(router), type(uint256).max);
+        usdc.approve(address(vault), type(uint256).max);
+
+        // Distort the pool, deposit at the distorted moment, then unwind the distortion.
+        router.swapExactTokensForTokens(
+            10_000_000e6, 0, _oneHop(address(usdc), address(weth)), attacker, block.timestamp
+        );
+        vault.deposit(100_000e6, attacker);
+        uint256 shares = vault.balanceOf(attacker);
+
+        weth.approve(address(router), type(uint256).max);
+        router.swapExactTokensForTokens(
+            weth.balanceOf(attacker), 0, _oneHop(address(weth), address(usdc)), attacker, block.timestamp
+        );
+        vm.stopPrank();
+
+        vm.prank(attacker);
+        uint256 out = vault.redeem(shares, attacker, attacker, 300);
+
+        // The shares themselves were priced fairly: the deposit comes back essentially at par,
+        // give or take the pool fees the attacker's own swaps paid to every LP.
+        assertApproxEqRel(out, 100_000e6, 0.0005e18, "shares were not mispriced");
+
+        // And the round trip is a large net loss once the manipulation cost is counted.
+        assertLt(usdc.balanceOf(attacker), spent, "manipulation costs far more than it yields");
+        assertGt(spent - usdc.balanceOf(attacker), 5_000e6, "attacker burned real money on fees");
+    }
+
+    function test_InvestDeclinesWhileThePoolIsDislocated() public {
+        _deposit(alice, 100_000e6);
+
+        usdc.mint(attacker, 5_000_000e6);
+        vm.startPrank(attacker);
+        usdc.approve(address(router), type(uint256).max);
+        router.swapExactTokensForTokens(
+            5_000_000e6, 0, _oneHop(address(usdc), address(weth)), attacker, block.timestamp
+        );
+        vm.stopPrank();
+
+        assertGt(strategy.poolDeviationBps(), strategy.maxPoolDeviationBps());
+
+        // Allocation is a no-op rather than a revert: capital waits, nothing is lost.
+        _allocate();
+        assertEq(strategy.lpBalance(), 0, "declined to LP into a dislocated pool");
+        assertApproxEqRel(vault.totalAssets(), 100_000e6, 0.0001e18, "funds fully accounted for");
+
+        // Once arbitrage restores the pool, the same call deploys normally.
+        _arbPoolToOracle();
+        _allocate();
+        assertGt(strategy.lpBalance(), 0);
+    }
+
+    function test_HarvestStillClaimsWhileThePoolIsDislocated() public {
+        _setUpPosition();
+        _skipAndRefresh(2 days);
+
+        usdc.mint(attacker, 5_000_000e6);
+        vm.startPrank(attacker);
+        usdc.approve(address(router), type(uint256).max);
+        router.swapExactTokensForTokens(
+            5_000_000e6, 0, _oneHop(address(usdc), address(weth)), attacker, block.timestamp
+        );
+        vm.stopPrank();
+
+        // Rewards are still claimed and sold; the proceeds simply wait as idle USDC.
+        uint256 gross = _harvest();
+        assertGt(gross, 0, "rewards were still realised");
+        assertGt(usdc.balanceOf(address(strategy)), 0, "proceeds held until the pool is healthy");
+    }
+
+    // -----------------------------------------------------------------
+    // Fair LP math
+    // -----------------------------------------------------------------
+
+    function test_FairLpValueMatchesABalancedPool() public view {
+        // Pool is seeded at exactly the oracle price, so fair value equals the naive value.
+        uint256 supply = pool.totalSupply();
+        uint256 whole = strategy.lpValueInUsdc(supply);
+        assertApproxEqRel(whole, POOL_USDC * 2, 0.0001e18, "whole pool is worth 2x the USDC leg");
+    }
+
+    function testFuzz_FairLpValueIsMonotonicInPrice(uint256 priceE18) public view {
+        priceE18 = bound(priceE18, 100e6, 100_000e6);
+        uint256 lower = VolatileLpMath.lpValueInToken0(1e18, 1e18, POOL_USDC, POOL_WETH, priceE18);
+        uint256 higher = VolatileLpMath.lpValueInToken0(1e18, 1e18, POOL_USDC, POOL_WETH, priceE18 + 1e6);
+        assertGe(higher, lower, "LP value rises with the price of the second asset");
+    }
+
+    function testFuzz_FairValueIsUnchangedByPureReserveSkew(uint256 skewBps) public view {
+        skewBps = bound(skewBps, 1, 5_000);
+        uint256 price = 3000e6;
+
+        uint256 base = VolatileLpMath.lpValueInToken0(1e18, 1e18, POOL_USDC, POOL_WETH, price);
+        // Move reserves along the constant-product curve: k is preserved, spot price is not.
+        uint256 r0 = POOL_USDC * (10_000 + skewBps) / 10_000;
+        uint256 r1 = Math.mulDiv(POOL_USDC, POOL_WETH, r0);
+        uint256 skewed = VolatileLpMath.lpValueInToken0(1e18, 1e18, r0, r1, price);
+
+        assertApproxEqRel(skewed, base, 0.0001e18, "value depends on k and the oracle, not on spot");
+    }
+
+    // -----------------------------------------------------------------
+    // Impermanent loss: the risk depositors actually carry
+    // -----------------------------------------------------------------
+
+    /// @dev A USDC depositor in a USDC/WETH LP is not principal-protected. This test pins the
+    ///      behaviour down rather than pretending otherwise: a 50% ETH drawdown must show up as a
+    ///      real loss in the share price, and roughly match the closed-form IL for a 50/50 pool.
+    function test_EthDrawdownProducesImpermanentLoss() public {
+        _setUpPosition();
+        uint256 ppsBefore = _pricePerShare();
+
+        ethFeed.setAnswer(1500e8); // ETH halves
+        _arbPoolToOracle();
+
+        uint256 ppsAfter = _pricePerShare();
+        assertLt(ppsAfter, ppsBefore, "half the book was ETH");
+
+        // Half the vault is LP'd against ETH. Closed-form IL at a 2x price ratio is 5.72%, applied
+        // to the ~95% of assets that are deployed, on top of the 25% direct ETH drawdown.
+        uint256 lossBps = (ppsBefore - ppsAfter) * 10_000 / ppsBefore;
+        assertGt(lossBps, 2_500, "at least the direct ETH exposure");
+        assertLt(lossBps, 3_200, "and no worse than direct exposure plus IL");
+    }
+
+    function test_EthRallyLagsHoldingEth() public {
+        _setUpPosition();
+        uint256 ppsBefore = _pricePerShare();
+
+        ethFeed.setAnswer(6000e8); // ETH doubles
+        _arbPoolToOracle();
+
+        uint256 gainBps = (_pricePerShare() - ppsBefore) * 10_000 / ppsBefore;
+        // Half the book doubling would be +50% before IL; IL drags it below that.
+        assertGt(gainBps, 3_500);
+        assertLt(gainBps, 5_000, "LPing underperforms simply holding the pair");
+    }
+
+    // -----------------------------------------------------------------
+    // Configuration guardrails
+    // -----------------------------------------------------------------
+
+    function test_SlippageKnobsAreCapped() public {
+        vm.startPrank(owner);
+        vm.expectRevert(AerodromeLpStrategy.InvalidParameter.selector);
+        strategy.setMaxSwapSlippageBps(1_001);
+        vm.expectRevert(AerodromeLpStrategy.InvalidParameter.selector);
+        strategy.setMaxLpImbalanceBps(1_001);
+        vm.expectRevert(AerodromeLpStrategy.InvalidParameter.selector);
+        strategy.setMaxPoolDeviationBps(1_001);
+        vm.expectRevert(AerodromeLpStrategy.InvalidParameter.selector);
+        strategy.setExitBufferBps(1_001);
+        vm.expectRevert(AerodromeLpStrategy.InvalidParameter.selector);
+        strategy.setMaxSwapPoolShareBps(1_001);
+        vm.stopPrank();
+    }
+
+    function test_SweepCannotTouchCoreAssets() public {
+        vm.startPrank(owner);
+        vm.expectRevert(AerodromeLpStrategy.InvalidParameter.selector);
+        strategy.sweep(address(usdc), owner);
+        vm.expectRevert(AerodromeLpStrategy.InvalidParameter.selector);
+        strategy.sweep(address(weth), owner);
+        vm.expectRevert(AerodromeLpStrategy.InvalidParameter.selector);
+        strategy.sweep(address(aero), owner);
+        vm.expectRevert(AerodromeLpStrategy.InvalidParameter.selector);
+        strategy.sweep(address(pool), owner);
+        vm.stopPrank();
+    }
+
+    function test_SweepRecoversAStrandedToken() public {
+        MockStray stray = new MockStray();
+        stray.mint(address(strategy), 500e18);
+
+        vm.prank(owner);
+        strategy.sweep(address(stray), owner);
+        assertEq(stray.balanceOf(owner), 500e18);
+    }
+
+    function test_ConstructorRejectsAGaugeForADifferentPool() public {
+        MockAerodromePoolLike other = new MockAerodromePoolLike();
+        vm.expectRevert(AerodromeLpStrategy.InvalidParameter.selector);
+        new AerodromeLpStrategy(
+            AerodromeLpStrategy.Config({
+                vault: address(vault),
+                usdc: address(usdc),
+                weth: address(weth),
+                router: address(router),
+                pool: address(other), // gauge stakes a different token
+                gauge: address(gauge),
+                ethUsdFeed: address(ethFeed),
+                usdcUsdFeed: address(usdcFeed),
+                owner: owner
+            })
+        );
+    }
+}
+
+import {MockERC20} from "./mocks/MockERC20.sol";
+import {MockAerodromePool} from "./mocks/MockAerodromePool.sol";
+
+contract MockStray is MockERC20 {
+    constructor() MockERC20("Stray", "STRAY", 18) {}
+}
+
+contract MockAerodromePoolLike {
+    function token0() external pure returns (address) {
+        return address(0x1);
+    }
+    function token1() external pure returns (address) {
+        return address(0x2);
+    }
+    function stable() external pure returns (bool) {
+        return false;
+    }
+}
diff --git a/test/YieldVault.t.sol b/test/YieldVault.t.sol
new file mode 100644
index 0000000..dffd436
--- /dev/null
+++ b/test/YieldVault.t.sol
@@ -0,0 +1,444 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+import {BaseTest} from "./BaseTest.sol";
+import {YieldVault} from "../src/YieldVault.sol";
+import {AerodromeLpStrategy} from "../src/AerodromeLpStrategy.sol";
+import {IStrategy} from "../src/interfaces/IStrategy.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {Ownable} from "@openzeppelin/contracts/access/Ownable.sol";
+
+contract YieldVaultTest is BaseTest {
+    // -----------------------------------------------------------------
+    // Deposits and accounting
+    // -----------------------------------------------------------------
+
+    function test_InitialState() public view {
+        assertEq(vault.asset(), address(usdc));
+        assertEq(vault.decimals(), 18, "shares carry 18 decimals over a 6-decimal asset");
+        assertEq(address(vault.strategy()), address(strategy));
+        assertEq(vault.totalAssets(), 0);
+    }
+
+    function test_DepositMintsSharesAtParity() public {
+        uint256 shares = _deposit(alice, 100_000e6);
+        // 6-decimal asset, 18-decimal shares => 1 USDC = 1e18 shares at a 1.0 share price.
+        assertEq(shares, 100_000e18);
+        assertEq(vault.totalAssets(), 100_000e6);
+        assertEq(vault.idleAssets(), 100_000e6, "deposits stay idle until a keeper allocates");
+    }
+
+    function test_DepositDoesNotAutoAllocate() public {
+        _deposit(alice, 100_000e6);
+        assertEq(strategy.totalAssets(), 0);
+        assertEq(gauge.balanceOf(address(strategy)), 0);
+    }
+
+    function test_AllocateLeavesIdleBufferAndStakesRest() public {
+        _deposit(alice, 100_000e6);
+        _allocate();
+
+        // 5% target buffer stays in the vault.
+        assertApproxEqAbs(vault.idleAssets(), 5_000e6, 1, "idle buffer");
+        assertGt(gauge.balanceOf(address(strategy)), 0, "LP is staked in the gauge");
+        assertEq(pool.balanceOf(address(strategy)), 0, "no LP left unstaked");
+
+        // Entry cost is one swap of half the allocation; everything else is preserved.
+        assertApproxEqRel(vault.totalAssets(), 100_000e6, 0.006e18, "entry cost under 0.6%");
+        assertLt(vault.totalAssets(), 100_000e6, "entry swap is not free");
+    }
+
+    /// @dev Each allocate costs a swap, so repeated calls must converge rather than grind the
+    ///      vault down. `minAllocation` is the knob that stops the tail.
+    function test_RepeatedAllocateConverges() public {
+        _deposit(alice, 100_000e6);
+        _allocate();
+        uint256 assetsAfterFirst = vault.totalAssets();
+
+        _allocate();
+        _allocate();
+        uint256 stakedAfterThird = gauge.balanceOf(address(strategy));
+
+        _allocate();
+        assertEq(gauge.balanceOf(address(strategy)), stakedAfterThird, "allocation has converged");
+        assertApproxEqRel(vault.totalAssets(), assetsAfterFirst, 0.0005e18, "tail churn is negligible");
+    }
+
+    /// @dev A deposit large enough to move the pool past the slippage guard must not brick the
+    ///      vault. It deploys in slices across repeated keeper calls, and nothing is lost while
+    ///      the remainder waits.
+    function test_OversizedDepositDeploysInSlices() public {
+        _deposit(alice, 5_000_000e6);
+
+        _allocate();
+        uint256 afterFirst = strategy.lpValueInUsdc(strategy.lpBalance());
+        assertGt(afterFirst, 0, "first slice deployed");
+        assertLt(afterFirst, 4_750_000e6, "but not all of it");
+
+        // Undeployed capital is still fully accounted for - it is idle, not lost.
+        assertApproxEqRel(vault.totalAssets(), 5_000_000e6, 0.005e18);
+
+        for (uint256 i = 0; i < 12; ++i) {
+            _arbPoolToOracle(); // arbitrage closes the gap our own slice opened
+            _allocate();
+        }
+        assertGt(strategy.lpValueInUsdc(strategy.lpBalance()), afterFirst, "more deployed over time");
+        assertApproxEqRel(vault.totalAssets(), 5_000_000e6, 0.02e18, "slicing is not expensive");
+    }
+
+    function test_TotalAssetsIsIdlePlusStrategy() public {
+        _deposit(alice, 100_000e6);
+        _allocate();
+        assertEq(vault.totalAssets(), vault.idleAssets() + strategy.totalAssets());
+    }
+
+    function test_MultipleDepositorsShareProRata() public {
+        _deposit(alice, 100_000e6);
+        _allocate();
+        _deposit(bob, 100_000e6);
+
+        // Bob buys in at the post-allocation share price, so he gets slightly more shares
+        // per USDC than Alice did (the share price dipped by Alice's entry cost).
+        assertGt(vault.balanceOf(bob), vault.balanceOf(alice));
+        assertApproxEqRel(vault.balanceOf(bob), vault.balanceOf(alice), 0.01e18);
+
+        // Neither depositor can extract value from the other.
+        assertApproxEqRel(vault.convertToAssets(vault.balanceOf(bob)), 100_000e6, 0.001e18);
+    }
+
+    // -----------------------------------------------------------------
+    // Withdrawals
+    // -----------------------------------------------------------------
+
+    function test_WithdrawFromIdleBufferDoesNotTouchStrategy() public {
+        _deposit(alice, 100_000e6);
+        _allocate();
+        uint256 stakedBefore = gauge.balanceOf(address(strategy));
+
+        vm.prank(alice);
+        vault.withdraw(1_000e6, alice, alice);
+
+        assertEq(usdc.balanceOf(alice), 1_000e6);
+        assertEq(gauge.balanceOf(address(strategy)), stakedBefore, "small exits are served from idle");
+    }
+
+    function test_WithdrawUnwindsStrategyWhenBufferIsShort() public {
+        _deposit(alice, 100_000e6);
+        _allocate();
+        uint256 stakedBefore = gauge.balanceOf(address(strategy));
+
+        vm.prank(alice);
+        vault.withdraw(50_000e6, alice, alice);
+
+        assertEq(usdc.balanceOf(alice), 50_000e6, "exact amount requested");
+        assertLt(gauge.balanceOf(address(strategy)), stakedBefore, "LP was unwound");
+    }
+
+    function test_FullRedeemReturnsNearlyEverything() public {
+        _deposit(alice, 100_000e6);
+        _allocate();
+
+        uint256 aliceShares = vault.balanceOf(alice);
+        vm.prank(alice);
+        vault.redeem(aliceShares, alice, alice);
+
+        // Entry swap + exit swap on the WETH leg, at 30 bps a side.
+        assertApproxEqRel(usdc.balanceOf(alice), 100_000e6, 0.01e18);
+        assertLt(usdc.balanceOf(alice), 100_000e6);
+        assertEq(vault.balanceOf(alice), 0);
+    }
+
+    function test_RedeemRevertsWhenLossExceedsTolerance() public {
+        _deposit(alice, 100_000e6);
+        _allocate();
+        // Let arbitrage undo the price impact of our own entry, so the only thing left between
+        // fair value and realised value is the unavoidable exit cost.
+        _arbPoolToOracle();
+
+        uint256 shares = vault.balanceOf(alice);
+        vm.prank(alice);
+        vm.expectRevert(); // ExcessiveWithdrawLoss: unwinding an LP position is never free
+        vault.redeem(shares, alice, alice, 0);
+
+        // The same redemption clears once a realistic tolerance is allowed.
+        vm.prank(alice);
+        uint256 assets = vault.redeem(shares, alice, alice, 50);
+        assertGt(assets, 0);
+    }
+
+    function test_RedeemWithExplicitToleranceSucceeds() public {
+        _deposit(alice, 100_000e6);
+        _allocate();
+
+        uint256 shares = vault.balanceOf(alice);
+        vm.prank(alice);
+        uint256 assets = vault.redeem(shares, alice, alice, 100); // accept up to 1%
+        assertGt(assets, 0);
+        assertEq(usdc.balanceOf(alice), assets);
+    }
+
+    function test_ExitCostIsChargedToTheExitingUserOnly() public {
+        _deposit(alice, 100_000e6);
+        _deposit(bob, 100_000e6);
+        _allocate();
+
+        uint256 ppsBefore = _pricePerShare();
+
+        uint256 aliceShares = vault.balanceOf(alice);
+        vm.prank(alice);
+        vault.redeem(aliceShares, alice, alice);
+
+        // Bob's share price is not dented by Alice paying her own unwind cost.
+        assertGe(_pricePerShare(), ppsBefore - 1, "remaining holders unaffected");
+    }
+
+    function test_WithdrawRevertsIfStrategyCannotFillExactly() public {
+        _deposit(alice, 100_000e6);
+        _allocate();
+        // Ask for more than the vault owns.
+        vm.prank(alice);
+        vm.expectRevert();
+        vault.withdraw(200_000e6, alice, alice);
+    }
+
+    function test_ThirdPartyRedeemRequiresAllowance() public {
+        _deposit(alice, 10_000e6);
+        uint256 shares = vault.balanceOf(alice);
+
+        vm.prank(bob);
+        vm.expectRevert();
+        vault.redeem(shares, bob, alice);
+
+        vm.prank(alice);
+        vault.approve(bob, shares);
+        vm.prank(bob);
+        vault.redeem(shares, bob, alice);
+        assertGt(usdc.balanceOf(bob), 0);
+    }
+
+    // -----------------------------------------------------------------
+    // Caps, pause, access control
+    // -----------------------------------------------------------------
+
+    function test_DepositCapIsEnforced() public {
+        vm.prank(owner);
+        vault.setDepositCap(50_000e6);
+
+        _deposit(alice, 50_000e6);
+        assertEq(vault.maxDeposit(bob), 0);
+
+        usdc.mint(bob, 1e6);
+        vm.startPrank(bob);
+        usdc.approve(address(vault), 1e6);
+        vm.expectRevert();
+        vault.deposit(1e6, bob);
+        vm.stopPrank();
+    }
+
+    function test_PauseBlocksDepositsButNotWithdrawals() public {
+        _deposit(alice, 10_000e6);
+        vm.prank(owner);
+        vault.setDepositsPaused(true);
+
+        assertEq(vault.maxDeposit(alice), 0);
+
+        uint256 aliceShares = vault.balanceOf(alice);
+        vm.prank(alice);
+        vault.redeem(aliceShares, alice, alice);
+        assertApproxEqAbs(usdc.balanceOf(alice), 10_000e6, 1);
+    }
+
+    function test_OnlyKeeperCanHarvestOrAllocate() public {
+        _deposit(alice, 10_000e6);
+
+        vm.prank(alice);
+        vm.expectRevert(YieldVault.NotKeeper.selector);
+        vault.allocate();
+
+        vm.prank(alice);
+        vm.expectRevert(YieldVault.NotKeeper.selector);
+        vault.harvest(0);
+
+        // The owner is implicitly a keeper.
+        vm.prank(owner);
+        vault.allocate();
+    }
+
+    function test_OnlyVaultCanDriveStrategy() public {
+        vm.prank(attacker);
+        vm.expectRevert(AerodromeLpStrategy.NotVault.selector);
+        strategy.invest();
+
+        vm.prank(attacker);
+        vm.expectRevert(AerodromeLpStrategy.NotVault.selector);
+        strategy.withdraw(1);
+
+        vm.prank(attacker);
+        vm.expectRevert(AerodromeLpStrategy.NotVault.selector);
+        strategy.harvest(0);
+
+        vm.prank(attacker);
+        vm.expectRevert(AerodromeLpStrategy.NotVault.selector);
+        strategy.emergencyExit();
+    }
+
+    function test_OnlyOwnerCanSetStrategy() public {
+        vm.prank(attacker);
+        vm.expectRevert(abi.encodeWithSelector(Ownable.OwnableUnauthorizedAccount.selector, attacker));
+        vault.setStrategy(IStrategy(address(0)));
+    }
+
+    function test_SetStrategyRejectsMismatchedWiring() public {
+        AerodromeLpStrategy foreign = new AerodromeLpStrategy(
+            AerodromeLpStrategy.Config({
+                vault: address(0xBEEF), // points at a different vault
+                usdc: address(usdc),
+                weth: address(weth),
+                router: address(router),
+                pool: address(pool),
+                gauge: address(gauge),
+                ethUsdFeed: address(ethFeed),
+                usdcUsdFeed: address(usdcFeed),
+                owner: owner
+            })
+        );
+
+        vm.startPrank(owner);
+        vault.setStrategy(IStrategy(address(0))); // detach the current one first
+        vm.expectRevert(YieldVault.StrategyMismatch.selector);
+        vault.setStrategy(foreign);
+        vm.stopPrank();
+    }
+
+    function test_SetStrategyRejectsWhileFundsAreDeployed() public {
+        _deposit(alice, 100_000e6);
+        _allocate();
+
+        vm.prank(owner);
+        vm.expectRevert(YieldVault.StrategyNotEmpty.selector);
+        vault.setStrategy(IStrategy(address(0)));
+    }
+
+    function test_PerformanceFeeCannotExceedCeiling() public {
+        vm.prank(owner);
+        vm.expectRevert(YieldVault.InvalidParameter.selector);
+        vault.setPerformanceFee(2_001, treasury);
+    }
+
+    // -----------------------------------------------------------------
+    // Emergency
+    // -----------------------------------------------------------------
+
+    function test_EmergencyExitReturnsFundsAndPauses() public {
+        _deposit(alice, 100_000e6);
+        _allocate();
+
+        vm.prank(owner);
+        vault.emergencyExit();
+
+        assertEq(strategy.totalAssets(), 0, "strategy fully unwound");
+        assertEq(gauge.balanceOf(address(strategy)), 0);
+        assertTrue(vault.depositsPaused());
+        assertApproxEqRel(vault.idleAssets(), 100_000e6, 0.01e18);
+
+        // Users can still get out.
+        uint256 aliceShares = vault.balanceOf(alice);
+        vm.prank(alice);
+        vault.redeem(aliceShares, alice, alice);
+        assertApproxEqRel(usdc.balanceOf(alice), 100_000e6, 0.01e18);
+    }
+
+    function test_StrategyOwnerCanAlsoTriggerEmergencyExit() public {
+        _deposit(alice, 100_000e6);
+        _allocate();
+
+        vm.prank(owner);
+        strategy.emergencyExit();
+        assertEq(strategy.totalAssets(), 0);
+        assertApproxEqRel(vault.idleAssets(), 100_000e6, 0.01e18);
+    }
+
+    // -----------------------------------------------------------------
+    // Inflation / donation
+    // -----------------------------------------------------------------
+
+    function test_DonationAttackOnFirstDepositorIsNotProfitable() public {
+        // Attacker mints 1 wei of shares, then donates a large amount to skew the exchange rate.
+        usdc.mint(attacker, 20_000e6);
+        vm.startPrank(attacker);
+        usdc.approve(address(vault), type(uint256).max);
+        vault.deposit(1, attacker);
+        usdc.transfer(address(vault), 10_000e6); // donation
+        vm.stopPrank();
+
+        // Victim deposits after the donation.
+        _deposit(alice, 10_000e6);
+        assertGt(vault.balanceOf(alice), 0, "victim still receives shares");
+
+        uint256 attackerShares = vault.balanceOf(attacker);
+        vm.prank(attacker);
+        vault.redeem(attackerShares, attacker, attacker);
+
+        // The attacker ends up poorer than they started: the virtual-share offset strands most
+        // of the donation in the vault instead of routing it through the victim's shares.
+        assertLt(usdc.balanceOf(attacker), 20_000e6, "attack is a net loss for the attacker");
+        // And the victim's position is untouched - this is the property that actually matters.
+        assertApproxEqRel(vault.convertToAssets(vault.balanceOf(alice)), 10_000e6, 0.001e18);
+    }
+
+    /// @dev If the vault ever prices at zero with shares outstanding, minting against it would
+    ///      hand the depositor the entire vault. Deposits must close instead.
+    function test_DepositsCloseIfTheVaultEverPricesAtZero() public {
+        _deposit(alice, 10_000e6);
+        assertGt(vault.maxDeposit(bob), 0);
+
+        // Force the degenerate state: shares outstanding, no assets.
+        uint256 vaultBal = usdc.balanceOf(address(vault));
+        vm.prank(address(vault));
+        usdc.transfer(address(0xdead), vaultBal);
+
+        assertEq(vault.totalAssets(), 0);
+        assertGt(vault.totalSupply(), 0);
+        assertEq(vault.maxDeposit(bob), 0, "deposits are closed");
+
+        usdc.mint(bob, 1_000e6);
+        vm.startPrank(bob);
+        usdc.approve(address(vault), 1_000e6);
+        vm.expectRevert();
+        vault.deposit(1_000e6, bob);
+        vm.stopPrank();
+    }
+
+    // -----------------------------------------------------------------
+    // Fuzz
+    // -----------------------------------------------------------------
+
+    function testFuzz_DepositRedeemRoundTrip(uint256 amount) public {
+        amount = bound(amount, 1e6, 200_000e6);
+        _deposit(alice, amount);
+        _allocate();
+
+        uint256 aliceShares = vault.balanceOf(alice);
+        vm.prank(alice);
+        uint256 out = vault.redeem(aliceShares, alice, alice, 200);
+
+        assertLe(out, amount, "cannot round-trip out more than in");
+        assertApproxEqRel(out, amount, 0.02e18, "round trip stays within DEX costs");
+    }
+
+    function testFuzz_SharePriceNeverDropsFromAnotherUsersActivity(uint256 depositAmount) public {
+        depositAmount = bound(depositAmount, 100e6, 200_000e6);
+        _deposit(alice, 200_000e6);
+        _allocate();
+        uint256 ppsBefore = _pricePerShare();
+
+        _deposit(bob, depositAmount);
+        _allocate();
+        uint256 bobShares = vault.balanceOf(bob);
+        vm.prank(bob);
+        vault.redeem(bobShares, bob, bob, 300);
+
+        // Bob's entry and exit costs land on Bob.
+        assertGe(_pricePerShare(), ppsBefore - (ppsBefore / 1000), "alice's share price is protected");
+    }
+}
