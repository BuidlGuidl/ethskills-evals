@@ -0,0 +1,79 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+import {Script, console2} from "forge-std/Script.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+
+import {YieldVault} from "../src/YieldVault.sol";
+import {AerodromeLpStrategy} from "../src/AerodromeLpStrategy.sol";
+import {BaseAddresses} from "./BaseAddresses.sol";
+
+/// @notice Deploys the vault + strategy to Base and applies the launch configuration.
+///
+/// Required env:
+///   PRIVATE_KEY   deployer key
+///   VAULT_OWNER   multisig that ends up owning both contracts
+///   TREASURY      performance-fee recipient
+///   KEEPER        address allowed to call harvest()/allocate()
+/// Optional env:
+///   DEPOSIT_CAP        launch cap in USDC base units (default 1,000,000 USDC)
+///   MIN_AERO_PRICE_E6  reward-sale floor price, USDC 6dp per AERO (default 0.20)
+contract Deploy is Script {
+    function run() external returns (YieldVault vault, AerodromeLpStrategy strategy) {
+        uint256 pk = vm.envUint("PRIVATE_KEY");
+        address vaultOwner = vm.envAddress("VAULT_OWNER");
+        address treasury = vm.envAddress("TREASURY");
+        address keeper = vm.envAddress("KEEPER");
+        uint256 depositCap = vm.envOr("DEPOSIT_CAP", uint256(1_000_000e6));
+        uint256 minAeroPriceE6 = vm.envOr("MIN_AERO_PRICE_E6", uint256(0.20e6));
+
+        require(block.chainid == BaseAddresses.CHAIN_ID, "Deploy: not Base mainnet");
+
+        vm.startBroadcast(pk);
+
+        // The deployer keeps ownership just long enough to configure, then hands over.
+        vault = new YieldVault(
+            IERC20(BaseAddresses.USDC), "Base USDC Yield Vault", "byUSDC", vm.addr(pk), treasury
+        );
+
+        // The constructor verifies the gauge stakes this pool, that the pool really is the
+        // USDC/WETH volatile pair, and reads AERO off the gauge instead of trusting a constant.
+        strategy = new AerodromeLpStrategy(
+            AerodromeLpStrategy.Config({
+                vault: address(vault),
+                usdc: BaseAddresses.USDC,
+                weth: BaseAddresses.WETH,
+                router: BaseAddresses.AERODROME_ROUTER,
+                pool: BaseAddresses.WETH_USDC_VOLATILE_POOL,
+                gauge: BaseAddresses.WETH_USDC_VOLATILE_GAUGE,
+                ethUsdFeed: BaseAddresses.ETH_USD_FEED,
+                usdcUsdFeed: BaseAddresses.USDC_USD_FEED,
+                owner: vm.addr(pk)
+            })
+        );
+
+        vault.setStrategy(strategy);
+        vault.setKeeper(keeper, true);
+        vault.setDepositCap(depositCap);
+
+        // Floor price for the AERO sale. Without this a compromised keeper could pass minOut = 0
+        // and gift the harvest to a sandwicher.
+        strategy.setMinAeroPriceE6(minAeroPriceE6);
+        // Don't pay a swap fee to deploy trivial amounts of buffer.
+        vault.setMinAllocation(1_000e6);
+
+        // Hand both contracts to the multisig. Ownable2Step: the multisig must accept.
+        strategy.transferOwnership(vaultOwner);
+        vault.transferOwnership(vaultOwner);
+
+        vm.stopBroadcast();
+
+        console2.log("YieldVault:         ", address(vault));
+        console2.log("AerodromeLpStrategy:", address(strategy));
+        console2.log("AERO (from gauge):  ", address(strategy.aero()));
+        console2.log("usdcIsToken0:       ", strategy.usdcIsToken0());
+        console2.log("ETH price (USDC 6dp):", strategy.ethPriceInUsdc());
+        console2.log("");
+        console2.log("Pending: %s must call acceptOwnership() on both contracts.", vaultOwner);
+    }
+}
