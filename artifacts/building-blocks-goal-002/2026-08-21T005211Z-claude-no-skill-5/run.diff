@@ -0,0 +1,69 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+import {Math} from "@openzeppelin/contracts/utils/math/Math.sol";
+
+import {IAerodromeGauge} from "../../src/interfaces/IAerodromeGauge.sol";
+import {MockERC20} from "./MockERC20.sol";
+
+/// @notice Gauge that accrues a reward token linearly in time, per staked LP token.
+contract MockAerodromeGauge is IAerodromeGauge {
+    using SafeERC20 for IERC20;
+
+    address public immutable stakingToken;
+    address public immutable rewardToken;
+
+    /// @notice Reward tokens emitted per second per 1e18 staked LP.
+    uint256 public rewardRatePerSecond;
+
+    mapping(address => uint256) public balanceOf;
+    mapping(address => uint256) public lastUpdate;
+    mapping(address => uint256) public accrued;
+    uint256 public totalSupply;
+
+    constructor(address stakingToken_, address rewardToken_) {
+        stakingToken = stakingToken_;
+        rewardToken = rewardToken_;
+    }
+
+    function setRewardRate(uint256 rate) external {
+        rewardRatePerSecond = rate;
+    }
+
+    function _accrue(address account) internal {
+        accrued[account] = earned(account);
+        lastUpdate[account] = block.timestamp;
+    }
+
+    function earned(address account) public view returns (uint256) {
+        uint256 last = lastUpdate[account];
+        if (last == 0) return accrued[account];
+        uint256 elapsed = block.timestamp - last;
+        return accrued[account] + Math.mulDiv(balanceOf[account] * elapsed, rewardRatePerSecond, 1e18);
+    }
+
+    function deposit(uint256 amount) external {
+        _accrue(msg.sender);
+        IERC20(stakingToken).safeTransferFrom(msg.sender, address(this), amount);
+        balanceOf[msg.sender] += amount;
+        totalSupply += amount;
+    }
+
+    function withdraw(uint256 amount) external {
+        _accrue(msg.sender);
+        balanceOf[msg.sender] -= amount;
+        totalSupply -= amount;
+        IERC20(stakingToken).safeTransfer(msg.sender, amount);
+    }
+
+    function getReward(address account) external {
+        _accrue(account);
+        uint256 amount = accrued[account];
+        if (amount > 0) {
+            accrued[account] = 0;
+            MockERC20(rewardToken).mint(account, amount);
+        }
+    }
+}
diff --git a/test/mocks/MockAerodromePool.sol b/test/mocks/MockAerodromePool.sol
new file mode 100644
index 0000000..9850f0b
--- /dev/null
+++ b/test/mocks/MockAerodromePool.sol
@@ -0,0 +1,103 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+import {ERC20} from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+import {Math} from "@openzeppelin/contracts/utils/math/Math.sol";
+
+/// @notice Faithful constant-product pool with a fee on input, matching the Uniswap-V2 style
+///         accounting that Aerodrome's volatile (`vAMM`) pools use. Tests trade against this so
+///         slippage, price impact and fee drag are real rather than stubbed.
+contract MockAerodromePool is ERC20 {
+    using SafeERC20 for IERC20;
+
+    uint256 public constant MINIMUM_LIQUIDITY = 1000;
+
+    address public immutable token0;
+    address public immutable token1;
+    bool public immutable stable;
+    /// @notice Fee on input, in basis points (Aerodrome volatile pools are typically 5-30 bps).
+    uint256 public immutable feeBps;
+
+    uint256 public reserve0;
+    uint256 public reserve1;
+
+    constructor(address a, address b, bool _stable, uint256 _feeBps) ERC20("vAMM-LP", "vAMM") {
+        (token0, token1) = a < b ? (a, b) : (b, a);
+        stable = _stable;
+        feeBps = _feeBps;
+    }
+
+    function getReserves() external view returns (uint256, uint256, uint256) {
+        return (reserve0, reserve1, block.timestamp);
+    }
+
+    function _sync() internal {
+        reserve0 = IERC20(token0).balanceOf(address(this));
+        reserve1 = IERC20(token1).balanceOf(address(this));
+    }
+
+    function mint(address to) external returns (uint256 liquidity) {
+        uint256 b0 = IERC20(token0).balanceOf(address(this));
+        uint256 b1 = IERC20(token1).balanceOf(address(this));
+        uint256 a0 = b0 - reserve0;
+        uint256 a1 = b1 - reserve1;
+        uint256 supply = totalSupply();
+        if (supply == 0) {
+            liquidity = Math.sqrt(a0 * a1) - MINIMUM_LIQUIDITY;
+            _mint(address(0xdead), MINIMUM_LIQUIDITY);
+        } else {
+            liquidity = Math.min(Math.mulDiv(a0, supply, reserve0), Math.mulDiv(a1, supply, reserve1));
+        }
+        require(liquidity > 0, "INSUFFICIENT_LIQUIDITY_MINTED");
+        _mint(to, liquidity);
+        _sync();
+    }
+
+    function burn(address to) external returns (uint256 a0, uint256 a1) {
+        uint256 liquidity = balanceOf(address(this));
+        uint256 supply = totalSupply();
+        uint256 b0 = IERC20(token0).balanceOf(address(this));
+        uint256 b1 = IERC20(token1).balanceOf(address(this));
+        a0 = Math.mulDiv(liquidity, b0, supply);
+        a1 = Math.mulDiv(liquidity, b1, supply);
+        require(a0 > 0 && a1 > 0, "INSUFFICIENT_LIQUIDITY_BURNED");
+        _burn(address(this), liquidity);
+        IERC20(token0).safeTransfer(to, a0);
+        IERC20(token1).safeTransfer(to, a1);
+        _sync();
+    }
+
+    function getAmountOut(uint256 amountIn, address tokenIn) public view returns (uint256) {
+        (uint256 rIn, uint256 rOut) = tokenIn == token0 ? (reserve0, reserve1) : (reserve1, reserve0);
+        if (amountIn == 0 || rIn == 0 || rOut == 0) return 0;
+        // Round the fee up. Rounding it down would make the quote fractionally more generous
+        // than the invariant check below tolerates, and `swap` would revert with "K".
+        uint256 amountInAfterFee = amountIn - Math.mulDiv(amountIn, feeBps, 10_000, Math.Rounding.Ceil);
+        return Math.mulDiv(amountInAfterFee, rOut, rIn + amountInAfterFee);
+    }
+
+    function swap(uint256 amount0Out, uint256 amount1Out, address to, bytes calldata) external {
+        require(amount0Out > 0 || amount1Out > 0, "INSUFFICIENT_OUTPUT");
+        require(amount0Out < reserve0 && amount1Out < reserve1, "INSUFFICIENT_LIQUIDITY");
+        uint256 r0Before = reserve0;
+        uint256 r1Before = reserve1;
+
+        if (amount0Out > 0) IERC20(token0).safeTransfer(to, amount0Out);
+        if (amount1Out > 0) IERC20(token1).safeTransfer(to, amount1Out);
+
+        uint256 b0 = IERC20(token0).balanceOf(address(this));
+        uint256 b1 = IERC20(token1).balanceOf(address(this));
+        uint256 in0 = b0 > r0Before - amount0Out ? b0 - (r0Before - amount0Out) : 0;
+        uint256 in1 = b1 > r1Before - amount1Out ? b1 - (r1Before - amount1Out) : 0;
+        require(in0 > 0 || in1 > 0, "INSUFFICIENT_INPUT");
+
+        // k must not decrease once the input fee is withheld.
+        uint256 adj0 = b0 * 10_000 - in0 * feeBps;
+        uint256 adj1 = b1 * 10_000 - in1 * feeBps;
+        require(adj0 * adj1 >= r0Before * r1Before * 10_000 * 10_000, "K");
+
+        _sync();
+    }
+}
diff --git a/test/mocks/MockAerodromeRouter.sol b/test/mocks/MockAerodromeRouter.sol
new file mode 100644
index 0000000..9fdb4e7
--- /dev/null
+++ b/test/mocks/MockAerodromeRouter.sol
@@ -0,0 +1,152 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+import {Math} from "@openzeppelin/contracts/utils/math/Math.sol";
+
+import {IAerodromeRouter} from "../../src/interfaces/IAerodromeRouter.sol";
+import {MockAerodromePool} from "./MockAerodromePool.sol";
+
+/// @notice Router mirroring the Aerodrome router's behaviour against `MockAerodromePool`s.
+contract MockAerodromeRouter is IAerodromeRouter {
+    using SafeERC20 for IERC20;
+
+    address public immutable factory;
+    mapping(bytes32 => address) public pools;
+
+    constructor(address factory_) {
+        factory = factory_;
+    }
+
+    function defaultFactory() external view returns (address) {
+        return factory;
+    }
+
+    function _key(address a, address b, bool stable) internal pure returns (bytes32) {
+        (address t0, address t1) = a < b ? (a, b) : (b, a);
+        return keccak256(abi.encode(t0, t1, stable));
+    }
+
+    function registerPool(address pool) external {
+        MockAerodromePool p = MockAerodromePool(pool);
+        pools[_key(p.token0(), p.token1(), p.stable())] = pool;
+    }
+
+    function poolFor(address a, address b, bool stable) public view returns (MockAerodromePool) {
+        address p = pools[_key(a, b, stable)];
+        require(p != address(0), "NO_POOL");
+        return MockAerodromePool(p);
+    }
+
+    function _quote(uint256 amountA, uint256 reserveA, uint256 reserveB) internal pure returns (uint256) {
+        return Math.mulDiv(amountA, reserveB, reserveA);
+    }
+
+    struct AddParams {
+        address tokenA;
+        address tokenB;
+        bool stable;
+        uint256 amountADesired;
+        uint256 amountBDesired;
+        uint256 amountAMin;
+        uint256 amountBMin;
+        address to;
+    }
+
+    /// @dev The real router takes nine arguments; forwarding them through a struct keeps this
+    ///      mock under the stack limit without turning on via-IR for the whole project.
+    function addLiquidity(
+        address tokenA,
+        address tokenB,
+        bool stable,
+        uint256 amountADesired,
+        uint256 amountBDesired,
+        uint256 amountAMin,
+        uint256 amountBMin,
+        address to,
+        uint256 deadline
+    ) external returns (uint256, uint256, uint256) {
+        require(deadline >= block.timestamp, "EXPIRED");
+        return _addLiquidity(
+            AddParams(tokenA, tokenB, stable, amountADesired, amountBDesired, amountAMin, amountBMin, to)
+        );
+    }
+
+    function _addLiquidity(AddParams memory p) internal returns (uint256 amountA, uint256 amountB, uint256 liquidity) {
+        MockAerodromePool pool = poolFor(p.tokenA, p.tokenB, p.stable);
+        (uint256 r0, uint256 r1,) = pool.getReserves();
+        (uint256 rA, uint256 rB) = p.tokenA == pool.token0() ? (r0, r1) : (r1, r0);
+
+        if (rA == 0 || rB == 0) {
+            (amountA, amountB) = (p.amountADesired, p.amountBDesired);
+        } else {
+            uint256 bOptimal = _quote(p.amountADesired, rA, rB);
+            if (bOptimal <= p.amountBDesired) {
+                (amountA, amountB) = (p.amountADesired, bOptimal);
+            } else {
+                (amountA, amountB) = (_quote(p.amountBDesired, rB, rA), p.amountBDesired);
+            }
+        }
+        require(amountA >= p.amountAMin, "INSUFFICIENT_A_AMOUNT");
+        require(amountB >= p.amountBMin, "INSUFFICIENT_B_AMOUNT");
+
+        IERC20(p.tokenA).safeTransferFrom(msg.sender, address(pool), amountA);
+        IERC20(p.tokenB).safeTransferFrom(msg.sender, address(pool), amountB);
+        liquidity = pool.mint(p.to);
+    }
+
+    function removeLiquidity(
+        address tokenA,
+        address tokenB,
+        bool stable,
+        uint256 liquidity,
+        uint256 amountAMin,
+        uint256 amountBMin,
+        address to,
+        uint256 deadline
+    ) external returns (uint256 amountA, uint256 amountB) {
+        require(deadline >= block.timestamp, "EXPIRED");
+        MockAerodromePool pool = poolFor(tokenA, tokenB, stable);
+        IERC20(address(pool)).safeTransferFrom(msg.sender, address(pool), liquidity);
+        (uint256 a0, uint256 a1) = pool.burn(to);
+        (amountA, amountB) = tokenA == pool.token0() ? (a0, a1) : (a1, a0);
+        require(amountA >= amountAMin, "INSUFFICIENT_A_AMOUNT");
+        require(amountB >= amountBMin, "INSUFFICIENT_B_AMOUNT");
+    }
+
+    function getAmountsOut(uint256 amountIn, Route[] memory routes) public view returns (uint256[] memory amounts) {
+        amounts = new uint256[](routes.length + 1);
+        amounts[0] = amountIn;
+        for (uint256 i = 0; i < routes.length; ++i) {
+            MockAerodromePool pool = poolFor(routes[i].from, routes[i].to, routes[i].stable);
+            amounts[i + 1] = pool.getAmountOut(amounts[i], routes[i].from);
+        }
+    }
+
+    function swapExactTokensForTokens(
+        uint256 amountIn,
+        uint256 amountOutMin,
+        Route[] calldata routes,
+        address to,
+        uint256 deadline
+    ) external returns (uint256[] memory amounts) {
+        require(deadline >= block.timestamp, "EXPIRED");
+        amounts = getAmountsOut(amountIn, routes);
+        require(amounts[amounts.length - 1] >= amountOutMin, "INSUFFICIENT_OUTPUT_AMOUNT");
+
+        IERC20(routes[0].from).safeTransferFrom(
+            msg.sender, address(poolFor(routes[0].from, routes[0].to, routes[0].stable)), amountIn
+        );
+
+        for (uint256 i = 0; i < routes.length; ++i) {
+            MockAerodromePool pool = poolFor(routes[i].from, routes[i].to, routes[i].stable);
+            uint256 out = amounts[i + 1];
+            (uint256 out0, uint256 out1) = routes[i].to == pool.token0() ? (out, uint256(0)) : (uint256(0), out);
+            address recipient = i + 1 < routes.length
+                ? address(poolFor(routes[i + 1].from, routes[i + 1].to, routes[i + 1].stable))
+                : to;
+            pool.swap(out0, out1, recipient, "");
+        }
+    }
+}
