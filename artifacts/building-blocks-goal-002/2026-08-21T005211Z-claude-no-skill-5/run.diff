new file mode 100644
index 0000000..9db83da
--- /dev/null
+++ b/src/AerodromeLpStrategy.sol
@@ -0,0 +1,575 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {IERC20Metadata} from "@openzeppelin/contracts/token/ERC20/extensions/IERC20Metadata.sol";
+import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+import {Ownable, Ownable2Step} from "@openzeppelin/contracts/access/Ownable2Step.sol";
+import {Math} from "@openzeppelin/contracts/utils/math/Math.sol";
+
+import {IStrategy} from "./interfaces/IStrategy.sol";
+import {IAerodromeRouter} from "./interfaces/IAerodromeRouter.sol";
+import {IAerodromePool} from "./interfaces/IAerodromePool.sol";
+import {IAerodromeGauge} from "./interfaces/IAerodromeGauge.sol";
+import {IAggregatorV3} from "./interfaces/IAggregatorV3.sol";
+import {VolatileLpMath} from "./libraries/VolatileLpMath.sol";
+
+/// @title AerodromeLpStrategy
+/// @notice Deploys USDC into the Aerodrome USDC/WETH volatile pool and stakes the LP in the
+///         pool's gauge to earn AERO. `harvest()` sells AERO for USDC and compounds it back in.
+///
+/// @dev Risk posture, stated plainly because it drives every design choice below:
+///
+///      * Half of every deposit is swapped into WETH. Depositors are therefore **not** holding a
+///        USDC-denominated principal — they hold a 50/50 USDC/WETH LP position and carry
+///        impermanent loss against ETH. A large ETH move can leave the USDC-denominated share
+///        price below the deposit price even with every reward compounded. See README.
+///
+///      * Every price used for a swap bound or for valuation comes from Chainlink, never from the
+///        pool's own spot reserves, so neither the share price nor the strategy's slippage limits
+///        can be moved with a flash loan.
+///
+///      * Staking in an Aerodrome gauge forfeits the pool's trading fees (they go to voters) in
+///        exchange for AERO emissions. AERO emissions are the entire yield source here.
+contract AerodromeLpStrategy is IStrategy, Ownable2Step {
+    using SafeERC20 for IERC20;
+    using Math for uint256;
+
+    uint256 public constant MAX_BPS = 10_000;
+    /// @notice Ceiling on every configurable slippage knob, so governance cannot widen them to
+    ///         the point where a compromised keeper could drain the position through swaps.
+    uint256 public constant MAX_CONFIGURABLE_SLIPPAGE_BPS = 1_000; // 10%
+
+    // --- immutable wiring ---
+    address public immutable override vault;
+    IERC20 public immutable usdc;
+    IERC20 public immutable weth;
+    IERC20 public immutable aero;
+    IAerodromeRouter public immutable router;
+    IAerodromePool public immutable pool;
+    IAerodromeGauge public immutable gauge;
+    address public immutable poolFactory;
+    /// @dev Aerodrome sorts pool tokens; the USDC/WETH pool on Base has WETH as token0.
+    bool public immutable usdcIsToken0;
+
+    IAggregatorV3 public immutable ethUsdFeed;
+    IAggregatorV3 public immutable usdcUsdFeed;
+    uint256 private immutable ethFeedScale;
+    uint256 private immutable usdcFeedScale;
+    uint256 private immutable usdcScale; // 1e6
+
+    // --- configuration ---
+    /// @notice Max shortfall versus the oracle price tolerated on a USDC<>WETH swap. This has to
+    ///         cover three things at once: how far the pool is allowed to sit from the oracle
+    ///         (`maxPoolDeviationBps`), the pool's own fee, and the price impact of our trade
+    ///         (bounded by `maxSwapPoolShareBps`). Keep it above their sum or invests will revert.
+    uint256 public maxSwapSlippageBps = 150; // 1.5%
+    /// @notice How far the pool's spot price may sit from the oracle before the strategy declines
+    ///         to add liquidity at all. Adding to a dislocated pool is how an LP gets picked off;
+    ///         waiting for arbitrage to close the gap costs nothing but time.
+    uint256 public maxPoolDeviationBps = 100; // 1%
+    /// @notice Max share of each side that `addLiquidity` may leave unused, and the tolerance on
+    ///         `removeLiquidity` versus oracle-fair exit amounts.
+    uint256 public maxLpImbalanceBps = 300; // 3%
+    /// @notice Extra LP burned on withdrawal to cover the exit swap cost, so the vault receives
+    ///         at least the amount it asked for.
+    uint256 public exitBufferBps = 50; // 0.5%
+    /// @notice Chainlink answers older than this are rejected.
+    uint256 public maxOracleStaleness = 3 hours;
+    /// @notice Floor price (USDC 6dp per 1e18 AERO) used to sanity-check the keeper's `minOut`.
+    ///         Prevents a compromised keeper from passing minOut = 1 and donating the harvest to
+    ///         a sandwicher. There is no Chainlink AERO feed on Base, hence a governance floor.
+    uint256 public minAeroPriceE6;
+    /// @notice Skip invest/harvest churn below this much USDC.
+    uint256 public minInvestAmount = 1e6; // 1 USDC
+    /// @notice Largest single rebalance swap, as a share of the pool's reserve of the input token.
+    ///         Price impact on a constant-product pool is roughly this share, so it must leave
+    ///         room under `maxSwapSlippageBps` once the pool fee is paid. Deposits larger than
+    ///         this deploy over several `allocate()` calls instead of reverting.
+    uint256 public maxSwapPoolShareBps = 25; // 0.25% of the reserve
+    /// @notice Route used to sell AERO. Set by governance, not by the keeper.
+    IAerodromeRouter.Route[] private _aeroSaleRoute;
+    /// @notice While set, the strategy refuses to deploy capital and pushes anything it realises
+    ///         back to the vault. Set by either emergency exit so that a routine `allocate()`
+    ///         cannot quietly re-enter the position after governance pulled out.
+    bool public emergencyMode;
+
+    event Invested(uint256 usdcIn, uint256 lpMinted);
+    event Withdrawn(uint256 requested, uint256 freed, uint256 lpBurned);
+    event Harvested(uint256 aeroClaimed, uint256 usdcReceived);
+    event EmergencyExited(uint256 freed, bool oracleless);
+    event EmergencyModeUpdated(bool enabled);
+    event AeroSaleRouteUpdated(uint256 hops);
+    event ConfigUpdated(string key, uint256 value);
+
+    error NotVault();
+    error InvalidParameter();
+    error StaleOracle(uint256 updatedAt);
+    error InvalidOracleAnswer(int256 answer);
+    error RewardPriceFloorNotMet(uint256 minOut, uint256 floor);
+    error InvalidRoute();
+
+    modifier onlyVault() {
+        if (msg.sender != vault) revert NotVault();
+        _;
+    }
+
+    struct Config {
+        address vault;
+        address usdc;
+        address weth;
+        address router;
+        address pool;
+        address gauge;
+        address ethUsdFeed;
+        address usdcUsdFeed;
+        address owner;
+    }
+
+    constructor(Config memory c) Ownable(c.owner) {
+        if (
+            c.vault == address(0) || c.usdc == address(0) || c.weth == address(0) || c.router == address(0)
+                || c.pool == address(0) || c.gauge == address(0) || c.ethUsdFeed == address(0)
+                || c.usdcUsdFeed == address(0)
+        ) revert InvalidParameter();
+
+        vault = c.vault;
+        usdc = IERC20(c.usdc);
+        weth = IERC20(c.weth);
+        router = IAerodromeRouter(c.router);
+        pool = IAerodromePool(c.pool);
+        gauge = IAerodromeGauge(c.gauge);
+
+        // Wiring is verified on-chain rather than trusted from the deploy script.
+        if (gauge.stakingToken() != c.pool) revert InvalidParameter();
+        aero = IERC20(gauge.rewardToken());
+
+        address t0 = IAerodromePool(c.pool).token0();
+        address t1 = IAerodromePool(c.pool).token1();
+        if (!((t0 == c.usdc && t1 == c.weth) || (t0 == c.weth && t1 == c.usdc))) revert InvalidParameter();
+        if (IAerodromePool(c.pool).stable()) revert InvalidParameter();
+        usdcIsToken0 = (t0 == c.usdc);
+        poolFactory = IAerodromeRouter(c.router).defaultFactory();
+
+        ethUsdFeed = IAggregatorV3(c.ethUsdFeed);
+        usdcUsdFeed = IAggregatorV3(c.usdcUsdFeed);
+        ethFeedScale = 10 ** IAggregatorV3(c.ethUsdFeed).decimals();
+        usdcFeedScale = 10 ** IAggregatorV3(c.usdcUsdFeed).decimals();
+        usdcScale = 10 ** IERC20Metadata(c.usdc).decimals();
+
+        // Unlimited approvals to the router and gauge only. Both are immutable here.
+        IERC20(c.usdc).forceApprove(c.router, type(uint256).max);
+        IERC20(c.weth).forceApprove(c.router, type(uint256).max);
+        IERC20(address(aero)).forceApprove(c.router, type(uint256).max);
+        IERC20(c.pool).forceApprove(c.router, type(uint256).max);
+        IERC20(c.pool).forceApprove(c.gauge, type(uint256).max);
+
+        // Default AERO -> WETH -> USDC. WETH is the deepest hop for AERO on Aerodrome.
+        _aeroSaleRoute.push(
+            IAerodromeRouter.Route({from: address(aero), to: c.weth, stable: false, factory: poolFactory})
+        );
+        _aeroSaleRoute.push(IAerodromeRouter.Route({from: c.weth, to: c.usdc, stable: false, factory: poolFactory}));
+    }
+
+    function asset() external view override returns (address) {
+        return address(usdc);
+    }
+
+    function halted() external view override returns (bool) {
+        return emergencyMode;
+    }
+
+    // ---------------------------------------------------------------------
+    // Oracle
+    // ---------------------------------------------------------------------
+
+    /// @notice ETH price denominated in USDC, scaled so it is USDC-6dp per 1e18 wei.
+    /// @dev Both legs are read so that a USDC depeg is reflected rather than assumed away.
+    function ethPriceInUsdc() public view returns (uint256) {
+        uint256 ethUsd = _readFeed(ethUsdFeed);
+        uint256 usdcUsd = _readFeed(usdcUsdFeed);
+        // price = (ethUsd / ethScale) / (usdcUsd / usdcScale) * usdcScale(1e6)
+        return Math.mulDiv(ethUsd * usdcScale, usdcFeedScale, usdcUsd * ethFeedScale);
+    }
+
+    function _readFeed(IAggregatorV3 feed) internal view returns (uint256) {
+        (, int256 answer,, uint256 updatedAt,) = feed.latestRoundData();
+        if (answer <= 0) revert InvalidOracleAnswer(answer);
+        if (updatedAt == 0 || block.timestamp - updatedAt > maxOracleStaleness) revert StaleOracle(updatedAt);
+        // Safe: the check above rejects every non-positive answer.
+        // forge-lint: disable-next-line(unsafe-typecast)
+        return uint256(answer);
+    }
+
+    // ---------------------------------------------------------------------
+    // Valuation
+    // ---------------------------------------------------------------------
+
+    /// @notice LP tokens held, staked plus any transiently unstaked.
+    function lpBalance() public view returns (uint256) {
+        return pool.balanceOf(address(this)) + gauge.balanceOf(address(this));
+    }
+
+    /// @notice Pool reserves, normalised to (USDC, WETH) order.
+    function _reserves() internal view returns (uint256 rUsdc, uint256 rWeth) {
+        (uint256 r0, uint256 r1,) = pool.getReserves();
+        (rUsdc, rWeth) = usdcIsToken0 ? (r0, r1) : (r1, r0);
+    }
+
+    /// @notice Oracle-fair USDC value of `lpAmount` LP tokens.
+    function lpValueInUsdc(uint256 lpAmount) public view returns (uint256) {
+        if (lpAmount == 0) return 0;
+        (uint256 rUsdc, uint256 rWeth) = _reserves();
+        return VolatileLpMath.lpValueInToken0(lpAmount, pool.totalSupply(), rUsdc, rWeth, ethPriceInUsdc());
+    }
+
+    /// @notice AUM in USDC: staked LP at fair value, plus loose USDC and WETH.
+    /// @dev Unclaimed AERO is deliberately excluded — pricing it would need an AERO oracle that
+    ///      does not exist on Base. Excluding it understates AUM slightly between harvests, which
+    ///      is the safe direction: it can never inflate the share price.
+    function totalAssets() public view override returns (uint256) {
+        uint256 total = usdc.balanceOf(address(this));
+        total += lpValueInUsdc(lpBalance());
+        uint256 wethBal = weth.balanceOf(address(this));
+        if (wethBal > 0) total += Math.mulDiv(wethBal, ethPriceInUsdc(), 1e18);
+        return total;
+    }
+
+    /// @notice How far the pool's spot price sits from the oracle, in bps. Keepers can read this
+    ///         to see why an `allocate()` is currently a no-op.
+    function poolDeviationBps() public view returns (uint256) {
+        (uint256 rUsdc, uint256 rWeth) = _reserves();
+        return _deviationBps(rUsdc, rWeth, ethPriceInUsdc());
+    }
+
+    function _deviationBps(uint256 rUsdc, uint256 rWeth, uint256 price) internal pure returns (uint256) {
+        if (rUsdc == 0 || rWeth == 0 || price == 0) return type(uint256).max;
+        uint256 spot = Math.mulDiv(rUsdc, 1e18, rWeth);
+        uint256 diff = spot > price ? spot - price : price - spot;
+        return Math.mulDiv(diff, MAX_BPS, price);
+    }
+
+    /// @notice AERO claimable from the gauge, for keepers sizing `minAssetsFromRewards`.
+    function pendingRewards() external view returns (uint256) {
+        return gauge.earned(address(this));
+    }
+
+    function aeroSaleRoute() external view returns (IAerodromeRouter.Route[] memory) {
+        return _aeroSaleRoute;
+    }
+
+    // ---------------------------------------------------------------------
+    // Vault-facing operations
+    // ---------------------------------------------------------------------
+
+    function invest() external override onlyVault {
+        _investIdle();
+    }
+
+    function withdraw(uint256 amount) external override onlyVault returns (uint256 freed) {
+        uint256 idle = usdc.balanceOf(address(this));
+        uint256 lpBurned;
+
+        if (idle < amount) {
+            uint256 need = amount - idle;
+            uint256 totalLp = lpBalance();
+            uint256 totalLpValue = lpValueInUsdc(totalLp);
+
+            if (totalLpValue > 0) {
+                uint256 lpToBurn = totalLp.mulDiv(need, totalLpValue);
+                // Burn a touch extra so the exit swap's cost does not leave us short of `amount`.
+                lpToBurn += lpToBurn.mulDiv(exitBufferBps, MAX_BPS);
+                if (lpToBurn > totalLp) lpToBurn = totalLp;
+                if (lpToBurn > 0) {
+                    _unwindLp(lpToBurn);
+                    lpBurned = lpToBurn;
+                }
+            }
+        }
+
+        // Hand the vault everything realised; surplus becomes part of its idle buffer rather than
+        // sitting here undeployed.
+        freed = usdc.balanceOf(address(this));
+        if (freed > 0) usdc.safeTransfer(vault, freed);
+        emit Withdrawn(amount, freed, lpBurned);
+    }
+
+    function harvest(uint256 minAssetsFromRewards) external override onlyVault returns (uint256 rewards) {
+        gauge.getReward(address(this));
+
+        uint256 aeroBal = aero.balanceOf(address(this));
+        if (aeroBal > 0) {
+            uint256 floor = aeroBal.mulDiv(minAeroPriceE6, 1e18);
+            if (minAssetsFromRewards < floor) revert RewardPriceFloorNotMet(minAssetsFromRewards, floor);
+
+            uint256 before = usdc.balanceOf(address(this));
+            router.swapExactTokensForTokens(
+                aeroBal, minAssetsFromRewards, _aeroSaleRoute, address(this), block.timestamp
+            );
+            rewards = usdc.balanceOf(address(this)) - before;
+        }
+        emit Harvested(aeroBal, rewards);
+
+        if (emergencyMode) {
+            // Nothing goes back into the pool; hand the proceeds straight to the vault.
+            uint256 bal = usdc.balanceOf(address(this));
+            if (bal > 0) usdc.safeTransfer(vault, bal);
+        } else {
+            _investIdle();
+        }
+    }
+
+    function emergencyExit() external override returns (uint256 freed) {
+        if (msg.sender != vault && msg.sender != owner()) revert NotVault();
+        _setEmergencyMode(true);
+
+        uint256 totalLp = lpBalance();
+        if (totalLp > 0) _unwindLp(totalLp);
+
+        // Any residual WETH (dust from a partial add) is converted too.
+        uint256 wethBal = weth.balanceOf(address(this));
+        if (wethBal > 0) _swapWethForUsdc(wethBal);
+
+        freed = usdc.balanceOf(address(this));
+        if (freed > 0) usdc.safeTransfer(vault, freed);
+        emit EmergencyExited(freed, false);
+    }
+
+    /// @notice Break-glass unwind that never reads the oracle.
+    /// @dev Every other path prices its slippage bounds off Chainlink, which means a feed that
+    ///      stops updating would otherwise freeze the position - including the normal emergency
+    ///      exit. Here governance supplies the bounds by hand instead. Once the position is fully
+    ///      in USDC, `totalAssets()` stops touching the oracle too, so users can withdraw again.
+    /// @param minUsdcFromLp Minimum USDC out of `removeLiquidity`.
+    /// @param minWethFromLp Minimum WETH out of `removeLiquidity`.
+    /// @param minUsdcFromSwap Minimum USDC out of the WETH sale.
+    function emergencyExitManual(uint256 minUsdcFromLp, uint256 minWethFromLp, uint256 minUsdcFromSwap)
+        external
+        onlyOwner
+        returns (uint256 freed)
+    {
+        _setEmergencyMode(true);
+
+        uint256 staked = gauge.balanceOf(address(this));
+        if (staked > 0) gauge.withdraw(staked);
+
+        uint256 totalLp = pool.balanceOf(address(this));
+        if (totalLp > 0) {
+            router.removeLiquidity(
+                address(usdc),
+                address(weth),
+                false,
+                totalLp,
+                minUsdcFromLp,
+                minWethFromLp,
+                address(this),
+                block.timestamp
+            );
+        }
+
+        uint256 wethBal = weth.balanceOf(address(this));
+        if (wethBal > 0) {
+            router.swapExactTokensForTokens(
+                wethBal, minUsdcFromSwap, _route(address(weth), address(usdc)), address(this), block.timestamp
+            );
+        }
+
+        freed = usdc.balanceOf(address(this));
+        if (freed > 0) usdc.safeTransfer(vault, freed);
+        emit EmergencyExited(freed, true);
+    }
+
+    function _setEmergencyMode(bool enabled) internal {
+        emergencyMode = enabled;
+        emit EmergencyModeUpdated(enabled);
+    }
+
+    /// @notice Re-arm the strategy after an emergency exit, or halt it without unwinding.
+    function setEmergencyMode(bool enabled) external onlyOwner {
+        _setEmergencyMode(enabled);
+    }
+
+    // ---------------------------------------------------------------------
+    // Internals
+    // ---------------------------------------------------------------------
+
+    /// @dev Rebalances loose USDC/WETH to equal value at the oracle price, adds liquidity, stakes.
+    ///      Both the rebalance swap and the liquidity pair are sized from the oracle price rather
+    ///      than from the balances on hand, so an oversized deposit deploys in slices instead of
+    ///      blowing through the slippage guard.
+    function _investIdle() internal {
+        if (emergencyMode) return;
+        uint256 price = ethPriceInUsdc();
+        uint256 usdcBal = usdc.balanceOf(address(this));
+        uint256 wethBal = weth.balanceOf(address(this));
+        uint256 wethValue = Math.mulDiv(wethBal, price, 1e18);
+
+        if (usdcBal + wethValue < minInvestAmount) return;
+
+        (uint256 rUsdc, uint256 rWeth) = _reserves();
+        // Skip rather than revert: rewards already claimed in this harvest stay as idle assets and
+        // get deployed once arbitrage brings the pool back to the oracle price.
+        if (_deviationBps(rUsdc, rWeth, price) > maxPoolDeviationBps) return;
+
+        uint256 perSide = (usdcBal + wethValue) / 2;
+
+        if (usdcBal > perSide) {
+            uint256 amountIn = usdcBal - perSide;
+            uint256 cap = rUsdc.mulDiv(maxSwapPoolShareBps, MAX_BPS);
+            _swapUsdcForWeth(amountIn > cap ? cap : amountIn, price);
+        } else if (wethValue > perSide) {
+            uint256 amountIn = Math.mulDiv(wethValue - perSide, 1e18, price);
+            uint256 cap = rWeth.mulDiv(maxSwapPoolShareBps, MAX_BPS);
+            _swapWethForUsdc(amountIn > cap ? cap : amountIn);
+        }
+
+        // Offer a pair that is balanced at the oracle price. Whatever the router cannot use stays
+        // here as idle assets and is deployed by the next invest/harvest.
+        usdcBal = usdc.balanceOf(address(this));
+        wethBal = weth.balanceOf(address(this));
+        uint256 pairUsdc = Math.min(usdcBal, Math.mulDiv(wethBal, price, 1e18));
+        if (pairUsdc == 0) return;
+        uint256 pairWeth = Math.min(Math.mulDiv(pairUsdc, 1e18, price), wethBal);
+        if (pairWeth == 0) return;
+
+        uint256 slack = MAX_BPS - maxLpImbalanceBps;
+        (,, uint256 liquidity) = router.addLiquidity(
+            address(usdc),
+            address(weth),
+            false,
+            pairUsdc,
+            pairWeth,
+            pairUsdc.mulDiv(slack, MAX_BPS),
+            pairWeth.mulDiv(slack, MAX_BPS),
+            address(this),
+            block.timestamp
+        );
+
+        if (liquidity > 0) gauge.deposit(liquidity);
+        emit Invested(pairUsdc, liquidity);
+    }
+
+    /// @dev Unstakes `lpAmount`, removes liquidity with oracle-derived minimums, sells the WETH leg.
+    function _unwindLp(uint256 lpAmount) internal {
+        uint256 staked = gauge.balanceOf(address(this));
+        uint256 toUnstake = lpAmount > staked ? staked : lpAmount;
+        if (toUnstake > 0) gauge.withdraw(toUnstake);
+
+        uint256 price = ethPriceInUsdc();
+        (uint256 rUsdc, uint256 rWeth) = _reserves();
+        (uint256 fairUsdc, uint256 fairWeth) =
+            VolatileLpMath.fairExitAmounts(lpAmount, pool.totalSupply(), rUsdc, rWeth, price);
+
+        // If the pool has been pushed away from the oracle price, the realised split will miss
+        // these bounds and the call reverts rather than exiting into a manipulated pool.
+        uint256 slack = MAX_BPS - maxLpImbalanceBps;
+        router.removeLiquidity(
+            address(usdc),
+            address(weth),
+            false,
+            lpAmount,
+            fairUsdc.mulDiv(slack, MAX_BPS),
+            fairWeth.mulDiv(slack, MAX_BPS),
+            address(this),
+            block.timestamp
+        );
+
+        uint256 wethBal = weth.balanceOf(address(this));
+        if (wethBal > 0) _swapWethForUsdc(wethBal);
+    }
+
+    function _swapUsdcForWeth(uint256 amountIn, uint256 price) internal {
+        if (amountIn == 0) return;
+        uint256 expected = Math.mulDiv(amountIn, 1e18, price);
+        uint256 minOut = expected.mulDiv(MAX_BPS - maxSwapSlippageBps, MAX_BPS);
+        router.swapExactTokensForTokens(amountIn, minOut, _route(address(usdc), address(weth)), address(this), block.timestamp);
+    }
+
+    function _swapWethForUsdc(uint256 amountIn) internal {
+        if (amountIn == 0) return;
+        uint256 expected = Math.mulDiv(amountIn, ethPriceInUsdc(), 1e18);
+        uint256 minOut = expected.mulDiv(MAX_BPS - maxSwapSlippageBps, MAX_BPS);
+        router.swapExactTokensForTokens(amountIn, minOut, _route(address(weth), address(usdc)), address(this), block.timestamp);
+    }
+
+    function _route(address from, address to) internal view returns (IAerodromeRouter.Route[] memory routes) {
+        routes = new IAerodromeRouter.Route[](1);
+        routes[0] = IAerodromeRouter.Route({from: from, to: to, stable: false, factory: poolFactory});
+    }
+
+    // ---------------------------------------------------------------------
+    // Governance
+    // ---------------------------------------------------------------------
+
+    function setMaxSwapSlippageBps(uint256 bps) external onlyOwner {
+        if (bps > MAX_CONFIGURABLE_SLIPPAGE_BPS) revert InvalidParameter();
+        maxSwapSlippageBps = bps;
+        emit ConfigUpdated("maxSwapSlippageBps", bps);
+    }
+
+    function setMaxPoolDeviationBps(uint256 bps) external onlyOwner {
+        if (bps == 0 || bps > MAX_CONFIGURABLE_SLIPPAGE_BPS) revert InvalidParameter();
+        maxPoolDeviationBps = bps;
+        emit ConfigUpdated("maxPoolDeviationBps", bps);
+    }
+
+    function setMaxLpImbalanceBps(uint256 bps) external onlyOwner {
+        if (bps > MAX_CONFIGURABLE_SLIPPAGE_BPS) revert InvalidParameter();
+        maxLpImbalanceBps = bps;
+        emit ConfigUpdated("maxLpImbalanceBps", bps);
+    }
+
+    function setExitBufferBps(uint256 bps) external onlyOwner {
+        if (bps > MAX_CONFIGURABLE_SLIPPAGE_BPS) revert InvalidParameter();
+        exitBufferBps = bps;
+        emit ConfigUpdated("exitBufferBps", bps);
+    }
+
+    function setMaxOracleStaleness(uint256 seconds_) external onlyOwner {
+        if (seconds_ == 0 || seconds_ > 1 days) revert InvalidParameter();
+        maxOracleStaleness = seconds_;
+        emit ConfigUpdated("maxOracleStaleness", seconds_);
+    }
+
+    function setMinAeroPriceE6(uint256 priceE6) external onlyOwner {
+        minAeroPriceE6 = priceE6;
+        emit ConfigUpdated("minAeroPriceE6", priceE6);
+    }
+
+    function setMaxSwapPoolShareBps(uint256 bps) external onlyOwner {
+        if (bps == 0 || bps > MAX_CONFIGURABLE_SLIPPAGE_BPS) revert InvalidParameter();
+        maxSwapPoolShareBps = bps;
+        emit ConfigUpdated("maxSwapPoolShareBps", bps);
+    }
+
+    function setMinInvestAmount(uint256 amount) external onlyOwner {
+        minInvestAmount = amount;
+        emit ConfigUpdated("minInvestAmount", amount);
+    }
+
+    /// @notice Replace the AERO sale route. Governance-only: the keeper must not choose its own
+    ///         path, or it could route through a pool it controls.
+    function setAeroSaleRoute(IAerodromeRouter.Route[] calldata newRoute) external onlyOwner {
+        uint256 len = newRoute.length;
+        if (len == 0 || newRoute[0].from != address(aero) || newRoute[len - 1].to != address(usdc)) {
+            revert InvalidRoute();
+        }
+        for (uint256 i = 1; i < len; ++i) {
+            if (newRoute[i].from != newRoute[i - 1].to) revert InvalidRoute();
+        }
+        delete _aeroSaleRoute;
+        for (uint256 i = 0; i < len; ++i) {
+            _aeroSaleRoute.push(newRoute[i]);
+        }
+        emit AeroSaleRouteUpdated(len);
+    }
+
+    /// @notice Recover a token that is not part of the strategy's accounting.
+    function sweep(address token, address to) external onlyOwner {
+        if (
+            token == address(usdc) || token == address(weth) || token == address(aero) || token == address(pool)
+                || to == address(0)
+        ) revert InvalidParameter();
+        IERC20(token).safeTransfer(to, IERC20(token).balanceOf(address(this)));
+    }
+}
diff --git a/src/YieldVault.sol b/src/YieldVault.sol
new file mode 100644
index 0000000..1758e5a
--- /dev/null
+++ b/src/YieldVault.sol
@@ -0,0 +1,397 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+import {ERC4626} from "@openzeppelin/contracts/token/ERC20/extensions/ERC4626.sol";
+import {ERC20} from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {IERC20Metadata} from "@openzeppelin/contracts/token/ERC20/extensions/IERC20Metadata.sol";
+import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+import {Ownable, Ownable2Step} from "@openzeppelin/contracts/access/Ownable2Step.sol";
+import {ReentrancyGuard} from "@openzeppelin/contracts/utils/ReentrancyGuard.sol";
+import {Math} from "@openzeppelin/contracts/utils/math/Math.sol";
+
+import {IStrategy} from "./interfaces/IStrategy.sol";
+
+/// @title YieldVault
+/// @notice ERC-4626 vault over a single asset (USDC on Base) that routes capital to one strategy.
+///
+/// @dev Design notes that matter for reviewers:
+///
+///      * **Keeper-driven allocation.** Deposits land idle. A keeper calls `allocate()` (or
+///        `harvest()`, which allocates as its last step) to push the excess over the idle buffer
+///        into the strategy. Swapping + LPing on every user deposit would be expensive and would
+///        hand every depositor's entry to searchers.
+///
+///      * **Profit is released linearly.** `harvest()` is the moment reward value is realised. If
+///        it landed instantly, anyone could deposit in the block before a harvest and redeem in the
+///        block after for a risk-free cut. Harvested profit is instead added to `lockedProfit` and
+///        released over `profitUnlockPeriod`, so the share price ramps rather than jumps.
+///
+///      * **Exit losses are borne by the exiting user.** Unwinding an LP position costs swap fees
+///        and price impact that `totalAssets()` cannot know in advance. `redeem()` therefore
+///        tolerates a bounded shortfall (`defaultMaxLossBps`) rather than reverting, and the
+///        shortfall is charged to the redeemer, not socialised. `withdraw()` — where the caller
+///        names an exact asset amount — reverts instead if it cannot be filled exactly.
+contract YieldVault is ERC4626, Ownable2Step, ReentrancyGuard {
+    using SafeERC20 for IERC20;
+    using Math for uint256;
+
+    uint256 public constant MAX_BPS = 10_000;
+    /// @notice Hard ceiling on the performance fee, enforced in the setter.
+    uint256 public constant MAX_PERFORMANCE_FEE_BPS = 2_000; // 20%
+    /// @notice Hard ceiling on how long harvested profit may be withheld.
+    uint256 public constant MAX_PROFIT_UNLOCK_PERIOD = 7 days;
+
+    /// @notice Strategy currently deployed to. May be unset (address(0)) while migrating.
+    IStrategy public strategy;
+
+    /// @notice Addresses allowed to call `harvest()` and `allocate()`.
+    mapping(address => bool) public isKeeper;
+
+    /// @notice Share of `totalAssets()` kept liquid in the vault for cheap withdrawals.
+    uint256 public targetIdleBps = 500; // 5%
+    /// @notice Don't bother pushing dust into the strategy.
+    uint256 public minAllocation;
+
+    /// @notice Cut of gross harvest proceeds minted to `treasury` as shares.
+    uint256 public performanceFeeBps = 1_000; // 10%
+    address public treasury;
+
+    /// @notice Deposit ceiling on `totalAssets()`. type(uint256).max disables it.
+    uint256 public depositCap = type(uint256).max;
+    /// @notice When true, deposits/mints are rejected; withdrawals stay open.
+    bool public depositsPaused;
+
+    /// @notice Shortfall tolerated by the plain ERC-4626 `redeem()`, in bps of the previewed amount.
+    uint256 public defaultMaxLossBps = 50; // 0.5%
+
+    /// @notice Profit still withheld from `totalAssets()` at `lastHarvest`.
+    uint256 public lockedProfitAtLastHarvest;
+    uint256 public lastHarvest;
+    /// @notice Window over which `lockedProfitAtLastHarvest` decays to zero.
+    uint256 public profitUnlockPeriod = 6 hours;
+
+    event StrategyUpdated(address indexed previous, address indexed current);
+    event KeeperUpdated(address indexed keeper, bool allowed);
+    event Allocated(uint256 assets);
+    event Harvested(uint256 grossRewards, uint256 performanceFee, uint256 lockedProfit);
+    event EmergencyExit(uint256 freed);
+    event DepositCapUpdated(uint256 cap);
+    event DepositsPausedUpdated(bool paused);
+    event TargetIdleUpdated(uint256 bps);
+    event PerformanceFeeUpdated(uint256 bps, address treasury);
+    event ProfitUnlockPeriodUpdated(uint256 period);
+    event DefaultMaxLossUpdated(uint256 bps);
+
+    error NotKeeper();
+    error NoStrategy();
+    error StrategyMismatch();
+    error StrategyNotEmpty();
+    error InvalidParameter();
+    error ExcessiveWithdrawLoss(uint256 received, uint256 minimum);
+    error InsufficientLiquidity(uint256 available, uint256 required);
+
+    modifier onlyKeeper() {
+        if (!isKeeper[msg.sender] && msg.sender != owner()) revert NotKeeper();
+        _;
+    }
+
+    constructor(IERC20 asset_, string memory name_, string memory symbol_, address owner_, address treasury_)
+        ERC20(name_, symbol_)
+        ERC4626(asset_)
+        Ownable(owner_)
+    {
+        if (treasury_ == address(0)) revert InvalidParameter();
+        treasury = treasury_;
+        lastHarvest = block.timestamp;
+        // 1e6-USDC deposits are dust-sized in share terms, so a donation attack against the first
+        // depositor is priced out by the virtual-share offset rather than by a dead-shares seed.
+        minAllocation = 10 ** IERC20Metadata(address(asset_)).decimals(); // 1 whole asset unit
+    }
+
+    /// @dev Shares carry 18 decimals over a 6-decimal asset. The 1e12 virtual-share offset makes
+    ///      the classic first-depositor donation attack cost ~1e12x the attacker's gain.
+    function _decimalsOffset() internal pure override returns (uint8) {
+        return 12;
+    }
+
+    // ---------------------------------------------------------------------
+    // Accounting
+    // ---------------------------------------------------------------------
+
+    /// @notice Idle assets + strategy AUM, less profit not yet unlocked.
+    function totalAssets() public view override returns (uint256) {
+        uint256 total = IERC20(asset()).balanceOf(address(this));
+        if (address(strategy) != address(0)) total += strategy.totalAssets();
+        uint256 locked = lockedProfit();
+        return total > locked ? total - locked : 0;
+    }
+
+    /// @notice Harvested profit still withheld from the share price, decaying linearly.
+    function lockedProfit() public view returns (uint256) {
+        uint256 period = profitUnlockPeriod;
+        if (period == 0) return 0;
+        uint256 elapsed = block.timestamp - lastHarvest;
+        if (elapsed >= period) return 0;
+        return lockedProfitAtLastHarvest.mulDiv(period - elapsed, period);
+    }
+
+    /// @notice Assets held by the vault itself and immediately withdrawable without touching the DEX.
+    function idleAssets() public view returns (uint256) {
+        return IERC20(asset()).balanceOf(address(this));
+    }
+
+    function maxDeposit(address) public view override returns (uint256) {
+        if (depositsPaused) return 0;
+        uint256 total = totalAssets();
+        // Degenerate state: shares exist but the vault prices at zero, so any deposit would mint
+        // a near-infinite share count. Only reachable after a catastrophic loss; refuse new money
+        // rather than let the next depositor be handed the whole vault.
+        if (total == 0 && totalSupply() > 0) return 0;
+
+        uint256 cap = depositCap;
+        if (cap == type(uint256).max) return type(uint256).max;
+        return total >= cap ? 0 : cap - total;
+    }
+
+    function maxMint(address receiver) public view override returns (uint256) {
+        uint256 assets = maxDeposit(receiver);
+        return assets == type(uint256).max ? type(uint256).max : _convertToShares(assets, Math.Rounding.Floor);
+    }
+
+    // ---------------------------------------------------------------------
+    // Deposits
+    // ---------------------------------------------------------------------
+
+    function deposit(uint256 assets, address receiver) public override nonReentrant returns (uint256) {
+        return super.deposit(assets, receiver);
+    }
+
+    function mint(uint256 shares, address receiver) public override nonReentrant returns (uint256) {
+        return super.mint(shares, receiver);
+    }
+
+    // ---------------------------------------------------------------------
+    // Withdrawals
+    // ---------------------------------------------------------------------
+
+    /// @notice Withdraw an exact asset amount. Reverts if the strategy cannot free it in full.
+    function withdraw(uint256 assets, address receiver, address owner_)
+        public
+        override
+        nonReentrant
+        returns (uint256 shares)
+    {
+        uint256 maxAssets = maxWithdraw(owner_);
+        if (assets > maxAssets) revert ERC4626ExceededMaxWithdraw(owner_, assets, maxAssets);
+
+        shares = previewWithdraw(assets);
+        if (msg.sender != owner_) _spendAllowance(owner_, msg.sender, shares);
+        _burn(owner_, shares);
+
+        uint256 available = _freeAssets(assets);
+        if (available < assets) revert InsufficientLiquidity(available, assets);
+
+        IERC20(asset()).safeTransfer(receiver, assets);
+        emit Withdraw(msg.sender, receiver, owner_, assets, shares);
+    }
+
+    /// @notice Redeem shares, tolerating up to `defaultMaxLossBps` of unwind cost.
+    function redeem(uint256 shares, address receiver, address owner_)
+        public
+        override
+        nonReentrant
+        returns (uint256)
+    {
+        return _redeem(shares, receiver, owner_, defaultMaxLossBps);
+    }
+
+    /// @notice Redeem with an explicit slippage tolerance on the strategy unwind.
+    /// @param maxLossBps Maximum shortfall versus `previewRedeem(shares)` the caller accepts.
+    function redeem(uint256 shares, address receiver, address owner_, uint256 maxLossBps)
+        public
+        nonReentrant
+        returns (uint256)
+    {
+        if (maxLossBps > MAX_BPS) revert InvalidParameter();
+        return _redeem(shares, receiver, owner_, maxLossBps);
+    }
+
+    function _redeem(uint256 shares, address receiver, address owner_, uint256 maxLossBps)
+        internal
+        returns (uint256 assets)
+    {
+        uint256 maxShares = maxRedeem(owner_);
+        if (shares > maxShares) revert ERC4626ExceededMaxRedeem(owner_, shares, maxShares);
+
+        uint256 expected = previewRedeem(shares);
+        if (msg.sender != owner_) _spendAllowance(owner_, msg.sender, shares);
+        _burn(owner_, shares);
+
+        uint256 available = _freeAssets(expected);
+        // Never hand out more than the shares were worth; any surplus freed stays with the vault.
+        assets = available < expected ? available : expected;
+
+        uint256 minOut = expected - expected.mulDiv(maxLossBps, MAX_BPS);
+        if (assets < minOut) revert ExcessiveWithdrawLoss(assets, minOut);
+
+        IERC20(asset()).safeTransfer(receiver, assets);
+        emit Withdraw(msg.sender, receiver, owner_, assets, shares);
+    }
+
+    /// @dev Tops the vault's idle balance up to `needed` by unwinding the strategy.
+    /// @return The vault's idle balance afterwards.
+    function _freeAssets(uint256 needed) internal returns (uint256) {
+        uint256 idle = IERC20(asset()).balanceOf(address(this));
+        if (idle >= needed) return idle;
+        if (address(strategy) != address(0)) {
+            strategy.withdraw(needed - idle);
+            idle = IERC20(asset()).balanceOf(address(this));
+        }
+        return idle;
+    }
+
+    // ---------------------------------------------------------------------
+    // Keeper operations
+    // ---------------------------------------------------------------------
+
+    /// @notice Push idle assets above the target buffer into the strategy and deploy them.
+    /// @dev Also re-runs the strategy's own deployment step, which matters when a previous call
+    ///      could only deploy part of the balance because of the per-swap size cap.
+    function allocate() external onlyKeeper nonReentrant {
+        _allocate();
+    }
+
+    /// @notice Claim rewards, compound them, take the performance fee, and re-allocate.
+    /// @param minAssetsFromRewards Floor on reward-sale proceeds, computed off-chain by the keeper.
+    /// @return grossRewards Reward proceeds in asset terms, before the performance fee.
+    function harvest(uint256 minAssetsFromRewards) external onlyKeeper nonReentrant returns (uint256 grossRewards) {
+        if (address(strategy) == address(0)) revert NoStrategy();
+
+        grossRewards = strategy.harvest(minAssetsFromRewards);
+
+        uint256 fee;
+        if (grossRewards > 0) {
+            uint256 feeBps = performanceFeeBps;
+            address treasury_ = treasury;
+            if (feeBps > 0 && treasury_ != address(0)) {
+                fee = grossRewards.mulDiv(feeBps, MAX_BPS);
+            }
+            // Carry over whatever of the previous harvest is still locked so a fast follow-up
+            // harvest cannot be used to flush the remainder into the share price early.
+            uint256 newLocked = lockedProfit() + (grossRewards - fee);
+            lockedProfitAtLastHarvest = newLocked;
+            lastHarvest = block.timestamp;
+
+            if (fee > 0) {
+                // Minted after `lockedProfitAtLastHarvest` is updated, so the fee is priced against
+                // a `totalAssets()` that has risen by exactly `fee`.
+                uint256 feeShares = _convertToShares(fee, Math.Rounding.Floor);
+                if (feeShares > 0) _mint(treasury_, feeShares);
+            }
+            emit Harvested(grossRewards, fee, newLocked);
+        } else {
+            emit Harvested(0, 0, lockedProfitAtLastHarvest);
+        }
+
+        _allocate();
+    }
+
+    function _allocate() internal {
+        IStrategy strategy_ = strategy;
+        // A halted strategy must not be topped up: the capital would just sit there undeployed,
+        // one hop further from depositors than if it had stayed in the vault.
+        if (address(strategy_) == address(0) || depositsPaused || strategy_.halted()) return;
+
+        uint256 idle = IERC20(asset()).balanceOf(address(this));
+        uint256 target = totalAssets().mulDiv(targetIdleBps, MAX_BPS);
+
+        if (idle > target) {
+            uint256 toInvest = idle - target;
+            // `minAllocation` stops the buffer from being nibbled at by repeated calls, each of
+            // which would pay a swap fee for a negligible amount of deployed capital.
+            if (toInvest >= minAllocation) {
+                IERC20(asset()).safeTransfer(address(strategy_), toInvest);
+                emit Allocated(toInvest);
+            }
+        }
+
+        // Unconditional: the strategy may still be holding assets it could not deploy last time.
+        strategy_.invest();
+    }
+
+    // ---------------------------------------------------------------------
+    // Governance
+    // ---------------------------------------------------------------------
+
+    /// @notice Point the vault at a strategy. The previous strategy must already be empty.
+    function setStrategy(IStrategy newStrategy) external onlyOwner {
+        IStrategy old = strategy;
+        if (address(old) != address(0) && old.totalAssets() != 0) revert StrategyNotEmpty();
+        if (address(newStrategy) != address(0)) {
+            if (newStrategy.asset() != asset() || newStrategy.vault() != address(this)) revert StrategyMismatch();
+        }
+        strategy = newStrategy;
+        emit StrategyUpdated(address(old), address(newStrategy));
+    }
+
+    /// @notice Unwind the entire strategy back into the vault and pause deposits.
+    function emergencyExit() external onlyOwner nonReentrant {
+        if (address(strategy) == address(0)) revert NoStrategy();
+        uint256 freed = strategy.emergencyExit();
+        depositsPaused = true;
+        // Stop withholding profit: with nothing deployed there is no harvest to front-run, and
+        // leaving it locked would understate the share price of an idle vault.
+        lockedProfitAtLastHarvest = 0;
+        emit DepositsPausedUpdated(true);
+        emit EmergencyExit(freed);
+    }
+
+    function setKeeper(address keeper, bool allowed) external onlyOwner {
+        isKeeper[keeper] = allowed;
+        emit KeeperUpdated(keeper, allowed);
+    }
+
+    function setTargetIdleBps(uint256 bps) external onlyOwner {
+        if (bps > MAX_BPS) revert InvalidParameter();
+        targetIdleBps = bps;
+        emit TargetIdleUpdated(bps);
+    }
+
+    function setMinAllocation(uint256 amount) external onlyOwner {
+        minAllocation = amount;
+    }
+
+    function setPerformanceFee(uint256 bps, address treasury_) external onlyOwner {
+        if (bps > MAX_PERFORMANCE_FEE_BPS) revert InvalidParameter();
+        if (bps > 0 && treasury_ == address(0)) revert InvalidParameter();
+        performanceFeeBps = bps;
+        treasury = treasury_;
+        emit PerformanceFeeUpdated(bps, treasury_);
+    }
+
+    function setDepositCap(uint256 cap) external onlyOwner {
+        depositCap = cap;
+        emit DepositCapUpdated(cap);
+    }
+
+    function setDepositsPaused(bool paused) external onlyOwner {
+        depositsPaused = paused;
+        emit DepositsPausedUpdated(paused);
+    }
+
+    function setProfitUnlockPeriod(uint256 period) external onlyOwner {
+        if (period > MAX_PROFIT_UNLOCK_PERIOD) revert InvalidParameter();
+        // Settle whatever is currently locked against the old schedule first.
+        lockedProfitAtLastHarvest = lockedProfit();
+        lastHarvest = block.timestamp;
+        profitUnlockPeriod = period;
+        emit ProfitUnlockPeriodUpdated(period);
+    }
+
+    function setDefaultMaxLossBps(uint256 bps) external onlyOwner {
+        if (bps > MAX_BPS) revert InvalidParameter();
+        defaultMaxLossBps = bps;
+        emit DefaultMaxLossUpdated(bps);
+    }
+}
