+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+/// @title BaseAddresses
+/// @notice Base mainnet (chainId 8453) addresses used by this deployment.
+/// @dev Every value below was read back from Base mainnet rather than copied from documentation:
+///      token `symbol()`/`decimals()`, `Router.defaultFactory()`, `PoolFactory.getPool()`,
+///      `Voter.gauges(pool)`, `Gauge.stakingToken()`/`rewardToken()`, and `feed.description()`.
+///      `AerodromeLpStrategy`'s constructor re-checks the pool/gauge/token wiring on-chain, so a
+///      stale constant here fails at deploy time rather than silently mis-routing funds.
+library BaseAddresses {
+    uint256 internal constant CHAIN_ID = 8453;
+
+    // --- tokens ---
+    address internal constant USDC = 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913; // symbol USDC, 6 dp
+    address internal constant WETH = 0x4200000000000000000000000000000000000006; // symbol WETH, 18 dp
+    address internal constant AERO = 0x940181a94A35A4569E4529A3CDfB74e38FD98631; // symbol AERO, 18 dp
+
+    // --- Aerodrome ---
+    address internal constant AERODROME_ROUTER = 0xcF77a3Ba9A5CA399B7c97c74d54e5b1Beb874E43;
+    address internal constant AERODROME_POOL_FACTORY = 0x420DD381b31aEf6683db6B902084cB0FFECe40Da;
+    address internal constant AERODROME_VOTER = 0x16613524e02ad97eDfeF371bC883F2F5d6C480A5;
+
+    /// @notice `vAMM-WETH/USDC`. Note token0 is WETH and token1 is USDC - Aerodrome sorts by
+    ///         address, so nothing may assume USDC is token0.
+    address internal constant WETH_USDC_VOLATILE_POOL = 0xcDAC0d6c6C59727a65F871236188350531885C43;
+    /// @notice Gauge for the pool above; `rewardToken()` is AERO.
+    address internal constant WETH_USDC_VOLATILE_GAUGE = 0x519BBD1Dd8C6A94C46080E24f316c14Ee758C025;
+
+    // --- Chainlink (8 decimals each) ---
+    address internal constant ETH_USD_FEED = 0x71041dddad3595F9CEd3DcCFBe3D1F4b0a16Bb70;
+    address internal constant USDC_USD_FEED = 0x7e860098F58bBFC8648a4311b374B1D669a2bc6B;
+}
