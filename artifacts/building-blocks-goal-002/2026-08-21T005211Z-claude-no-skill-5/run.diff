+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+
+/// @notice Subset of an Aerodrome Pool (LP token). The USDC/WETH volatile pool on Base is
+///         0xcDAC0d6c6C59727a65F871236188350531885C43 (`vAMM-WETH/USDC`).
+interface IAerodromePool is IERC20 {
+    function token0() external view returns (address);
+    function token1() external view returns (address);
+    function stable() external view returns (bool);
+    /// @return _reserve0 reserve of token0, _reserve1 reserve of token1, _blockTimestampLast last update
+    function getReserves() external view returns (uint256 _reserve0, uint256 _reserve1, uint256 _blockTimestampLast);
+}
diff --git a/src/interfaces/IAerodromeRouter.sol b/src/interfaces/IAerodromeRouter.sol
