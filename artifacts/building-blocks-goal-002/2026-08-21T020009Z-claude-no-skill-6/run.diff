diff --git a/test/mocks/MockAerodromePool.sol b/test/mocks/MockAerodromePool.sol
new file mode 100644
index 0000000..8c9fc37
--- /dev/null
+++ b/test/mocks/MockAerodromePool.sol
@@ -0,0 +1,104 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.28;
+
+import {ERC20} from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+import {Math} from "@openzeppelin/contracts/utils/math/Math.sol";
+
+/// @notice Constant-product (vAMM) pool modelled on Velodrome v2 / Aerodrome `Pool.sol`.
+/// @dev Real reserve math, real LP mint/burn, real fee-bearing swaps. Tests that rely on this
+///      exercise the same rounding and price-impact behaviour the live pool would produce.
+contract MockAerodromePool is ERC20 {
+    using SafeERC20 for IERC20;
+
+    uint256 public constant MINIMUM_LIQUIDITY = 1000;
+
+    address public immutable token0;
+    address public immutable token1;
+    bool public immutable stable;
+    uint256 public feeBps; // swap fee in basis points
+
+    uint256 public reserve0;
+    uint256 public reserve1;
+    uint256 public blockTimestampLast;
+
+    constructor(address t0, address t1, bool stable_, uint256 feeBps_) ERC20("vAMM LP", "vAMM") {
+        (token0, token1) = t0 < t1 ? (t0, t1) : (t1, t0);
+        stable = stable_;
+        feeBps = feeBps_;
+    }
+
+    function setFeeBps(uint256 f) external {
+        feeBps = f;
+    }
+
+    function getReserves() external view returns (uint256, uint256, uint256) {
+        return (reserve0, reserve1, blockTimestampLast);
+    }
+
+    function _sync() internal {
+        reserve0 = IERC20(token0).balanceOf(address(this));
+        reserve1 = IERC20(token1).balanceOf(address(this));
+        blockTimestampLast = block.timestamp;
+    }
+
+    /// @dev Tokens must already have been transferred in (Uniswap-style).
+    function mint(address to) external returns (uint256 liquidity) {
+        uint256 bal0 = IERC20(token0).balanceOf(address(this));
+        uint256 bal1 = IERC20(token1).balanceOf(address(this));
+        uint256 amount0 = bal0 - reserve0;
+        uint256 amount1 = bal1 - reserve1;
+
+        uint256 supply = totalSupply();
+        if (supply == 0) {
+            liquidity = Math.sqrt(amount0 * amount1) - MINIMUM_LIQUIDITY;
+            _mint(address(1), MINIMUM_LIQUIDITY);
+        } else {
+            liquidity = Math.min(Math.mulDiv(amount0, supply, reserve0), Math.mulDiv(amount1, supply, reserve1));
+        }
+        require(liquidity > 0, "ILM");
+        _mint(to, liquidity);
+        _sync();
+    }
+
+    /// @dev LP tokens must already have been transferred in.
+    function burn(address to) external returns (uint256 amount0, uint256 amount1) {
+        uint256 liquidity = balanceOf(address(this));
+        uint256 supply = totalSupply();
+        amount0 = Math.mulDiv(liquidity, IERC20(token0).balanceOf(address(this)), supply);
+        amount1 = Math.mulDiv(liquidity, IERC20(token1).balanceOf(address(this)), supply);
+        require(amount0 > 0 && amount1 > 0, "ILB");
+        _burn(address(this), liquidity);
+        IERC20(token0).safeTransfer(to, amount0);
+        IERC20(token1).safeTransfer(to, amount1);
+        _sync();
+    }
+
+    /// @notice Force reserves to match balances, as the real pool's `sync()` does.
+    function sync() external {
+        _sync();
+    }
+
+    function getAmountOut(uint256 amountIn, address tokenIn) public view returns (uint256) {
+        (uint256 rIn, uint256 rOut) = tokenIn == token0 ? (reserve0, reserve1) : (reserve1, reserve0);
+        uint256 amountInAfterFee = amountIn - (amountIn * feeBps) / 10_000;
+        return (amountInAfterFee * rOut) / (rIn + amountInAfterFee);
+    }
+
+    /// @dev Input must already have been transferred in.
+    function swap(uint256 amount0Out, uint256 amount1Out, address to, bytes calldata) external {
+        require(amount0Out > 0 || amount1Out > 0, "IOA");
+        if (amount0Out > 0) IERC20(token0).safeTransfer(to, amount0Out);
+        if (amount1Out > 0) IERC20(token1).safeTransfer(to, amount1Out);
+        _sync();
+    }
+
+    /// @notice Test helper: skew reserves to simulate a flash-loan sandwich around our tx.
+    function simulateSwapIn(address tokenIn, uint256 amountIn, address to) external returns (uint256 out) {
+        out = getAmountOut(amountIn, tokenIn);
+        IERC20(tokenIn).safeTransferFrom(msg.sender, address(this), amountIn);
+        IERC20(tokenIn == token0 ? token1 : token0).safeTransfer(to, out);
+        _sync();
+    }
+}
diff --git a/test/mocks/MockAerodromeRouter.sol b/test/mocks/MockAerodromeRouter.sol
new file mode 100644
index 0000000..77eef4c
--- /dev/null
+++ b/test/mocks/MockAerodromeRouter.sol
@@ -0,0 +1,152 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.28;
+
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+import {Math} from "@openzeppelin/contracts/utils/math/Math.sol";
+
+import {IAerodromeRouter} from "../../src/interfaces/IAerodromeRouter.sol";
+import {MockAerodromePool} from "./MockAerodromePool.sol";
+import {MockAerodromeFactory} from "./MockAerodromeFactory.sol";
+
+/// @notice Router stub mirroring Aerodrome's optimal-ratio add, pro-rata remove and hop swaps.
+contract MockAerodromeRouter is IAerodromeRouter {
+    using SafeERC20 for IERC20;
+
+    MockAerodromeFactory public immutable factory;
+
+    error Expired();
+    error InsufficientAmount();
+    error InsufficientOutput(uint256 got, uint256 min);
+    error PoolNotFound();
+
+    constructor(MockAerodromeFactory f) {
+        factory = f;
+    }
+
+    modifier ensure(uint256 deadline) {
+        if (deadline < block.timestamp) revert Expired();
+        _;
+    }
+
+    function defaultFactory() external view returns (address) {
+        return address(factory);
+    }
+
+    function poolFor(address tokenA, address tokenB, bool stable, address) public view returns (address) {
+        return factory.getPool(tokenA, tokenB, stable);
+    }
+
+    function _quoteAdd(MockAerodromePool pool, address tokenA, uint256 aDesired, uint256 bDesired)
+        internal
+        view
+        returns (uint256 amountA, uint256 amountB)
+    {
+        (uint256 r0, uint256 r1,) = pool.getReserves();
+        if (r0 == 0 && r1 == 0) return (aDesired, bDesired);
+
+        (uint256 rA, uint256 rB) = tokenA == pool.token0() ? (r0, r1) : (r1, r0);
+
+        uint256 bOptimal = Math.mulDiv(aDesired, rB, rA);
+        if (bOptimal <= bDesired) return (aDesired, bOptimal);
+
+        uint256 aOptimal = Math.mulDiv(bDesired, rA, rB);
+        return (aOptimal, bDesired);
+    }
+
+    struct AddParams {
+        address tokenA;
+        address tokenB;
+        bool stable;
+        uint256 aDesired;
+        uint256 bDesired;
+        uint256 aMin;
+        uint256 bMin;
+        address to;
+    }
+
+    /// @dev Body lives behind a struct purely to keep the 9-argument external signature from
+    ///      blowing the stack under the legacy codegen used for tests.
+    function addLiquidity(
+        address tokenA,
+        address tokenB,
+        bool stable,
+        uint256 amountADesired,
+        uint256 amountBDesired,
+        uint256 amountAMin,
+        uint256 amountBMin,
+        address to,
+        uint256 deadline
+    ) external ensure(deadline) returns (uint256, uint256, uint256) {
+        return _addLiquidity(
+            AddParams(tokenA, tokenB, stable, amountADesired, amountBDesired, amountAMin, amountBMin, to)
+        );
+    }
+
+    function _addLiquidity(AddParams memory p) internal returns (uint256 amountA, uint256 amountB, uint256 liquidity) {
+        address pool = poolFor(p.tokenA, p.tokenB, p.stable, address(0));
+        if (pool == address(0)) revert PoolNotFound();
+
+        (amountA, amountB) = _quoteAdd(MockAerodromePool(pool), p.tokenA, p.aDesired, p.bDesired);
+        if (amountA < p.aMin || amountB < p.bMin) revert InsufficientAmount();
+
+        IERC20(p.tokenA).safeTransferFrom(msg.sender, pool, amountA);
+        IERC20(p.tokenB).safeTransferFrom(msg.sender, pool, amountB);
+        liquidity = MockAerodromePool(pool).mint(p.to);
+    }
+
+    function removeLiquidity(
+        address tokenA,
+        address tokenB,
+        bool stable,
+        uint256 liquidity,
+        uint256 amountAMin,
+        uint256 amountBMin,
+        address to,
+        uint256 deadline
+    ) external ensure(deadline) returns (uint256 amountA, uint256 amountB) {
+        MockAerodromePool pool = MockAerodromePool(poolFor(tokenA, tokenB, stable, address(0)));
+        if (address(pool) == address(0)) revert PoolNotFound();
+
+        IERC20(address(pool)).safeTransferFrom(msg.sender, address(pool), liquidity);
+        (uint256 amount0, uint256 amount1) = pool.burn(to);
+        (amountA, amountB) = tokenA == pool.token0() ? (amount0, amount1) : (amount1, amount0);
+        if (amountA < amountAMin || amountB < amountBMin) revert InsufficientAmount();
+    }
+
+    function getAmountsOut(uint256 amountIn, Route[] memory routes) public view returns (uint256[] memory amounts) {
+        amounts = new uint256[](routes.length + 1);
+        amounts[0] = amountIn;
+        for (uint256 i; i < routes.length; ++i) {
+            MockAerodromePool pool =
+                MockAerodromePool(poolFor(routes[i].from, routes[i].to, routes[i].stable, address(0)));
+            if (address(pool) == address(0)) revert PoolNotFound();
+            amounts[i + 1] = pool.getAmountOut(amounts[i], routes[i].from);
+        }
+    }
+
+    function swapExactTokensForTokens(
+        uint256 amountIn,
+        uint256 amountOutMin,
+        Route[] calldata routes,
+        address to,
+        uint256 deadline
+    ) external ensure(deadline) returns (uint256[] memory amounts) {
+        amounts = getAmountsOut(amountIn, routes);
+        uint256 out = amounts[amounts.length - 1];
+        if (out < amountOutMin) revert InsufficientOutput(out, amountOutMin);
+
+        IERC20(routes[0].from)
+            .safeTransferFrom(msg.sender, poolFor(routes[0].from, routes[0].to, routes[0].stable, address(0)), amountIn);
+
+        for (uint256 i; i < routes.length; ++i) {
+            MockAerodromePool pool =
+                MockAerodromePool(poolFor(routes[i].from, routes[i].to, routes[i].stable, address(0)));
+            address recipient = i + 1 < routes.length
+                ? poolFor(routes[i + 1].from, routes[i + 1].to, routes[i + 1].stable, address(0))
+                : to;
+            bool zeroForOne = routes[i].from == pool.token0();
+            pool.swap(zeroForOne ? 0 : amounts[i + 1], zeroForOne ? amounts[i + 1] : 0, recipient, "");
+        }
+    }
+}
