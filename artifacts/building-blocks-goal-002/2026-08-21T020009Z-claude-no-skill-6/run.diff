+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.28;
+
+/// @notice Minimal interface the vault relies on. Lets the vault be pointed at a
+///         different venue later without redeploying user-facing accounting.
+interface IStrategy {
+    /// @return The strategy's underlying asset (must equal the vault's asset).
+    function asset() external view returns (address);
+
+    /// @return The vault this strategy reports to.
+    function vault() external view returns (address);
+
+    /// @return Value of everything the strategy controls, denominated in `asset()`.
+    function totalAssets() external view returns (uint256);
+
+    /// @notice Pull `amount` of `asset()` already transferred in and put it to work.
+    function deposit(uint256 amount) external;
+
+    /// @notice Unwind enough of the position to send exactly `amount` of `asset()` to the vault.
+    /// @return sent Amount of `asset()` transferred to the vault.
+    function withdraw(uint256 amount) external returns (uint256 sent);
+
+    /// @notice Unwind the entire position back to `asset()` and return it to the vault.
+    function withdrawAll() external returns (uint256 sent);
+}
diff --git a/src/libraries/FairLpMath.sol b/src/libraries/FairLpMath.sol
new file mode 100644
index 0000000..67ac5b5
--- /dev/null
+++ b/src/libraries/FairLpMath.sol
@@ -0,0 +1,53 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.28;
+
+import {Math} from "@openzeppelin/contracts/utils/math/Math.sol";
+
+/// @title FairLpMath
+/// @notice Flash-loan-resistant valuation of a constant-product (volatile) AMM LP token.
+/// @dev Valuing an LP position as `reserve0 * p0 + reserve1 * p1` reads the *current* reserves,
+///      which an attacker can skew inside a single transaction with a large swap, inflating or
+///      deflating the vault's reported totalAssets and therefore its share price.
+///
+///      For an x*y=k pool the quantity `k = r0 * r1` is invariant under swaps (up to fees), so the
+///      fair value of the whole pool is derived from k and the external prices instead:
+///
+///          poolValue = 2 * sqrt(k * p0 * p1)
+///
+///      which is exactly the pool's value at the reserve split implied by the oracle prices. This
+///      is the Alpha Finance "fair LP pricing" formula. A swap that moves reserves leaves k (and
+///      therefore this valuation) essentially unchanged, so share price cannot be manipulated by
+///      trading against the pool.
+library FairLpMath {
+    /// @notice Fair USD value of `lpAmount` LP tokens, in 8-decimal USD.
+    /// @param reserve0 Reserve of token0, in token0 units.
+    /// @param reserve1 Reserve of token1, in token1 units.
+    /// @param decimals0 Decimals of token0.
+    /// @param decimals1 Decimals of token1.
+    /// @param price0E8 USD price of one whole token0, 8 decimals.
+    /// @param price1E8 USD price of one whole token1, 8 decimals.
+    /// @param lpAmount LP tokens held.
+    /// @param lpTotalSupply Total LP supply.
+    /// @return valueE8 Value of `lpAmount` in USD with 8 decimals.
+    function lpValueE8(
+        uint256 reserve0,
+        uint256 reserve1,
+        uint8 decimals0,
+        uint8 decimals1,
+        uint256 price0E8,
+        uint256 price1E8,
+        uint256 lpAmount,
+        uint256 lpTotalSupply
+    ) internal pure returns (uint256 valueE8) {
+        if (lpAmount == 0 || lpTotalSupply == 0 || reserve0 == 0 || reserve1 == 0) return 0;
+
+        // Side values in 8-decimal USD, at the *current* reserve split.
+        uint256 side0 = Math.mulDiv(reserve0, price0E8, 10 ** decimals0);
+        uint256 side1 = Math.mulDiv(reserve1, price1E8, 10 ** decimals1);
+
+        // 2 * sqrt(side0 * side1) is invariant to swaps because side0 * side1 scales with k.
+        uint256 poolValueE8 = 2 * Math.sqrt(side0 * side1);
+
+        valueE8 = Math.mulDiv(poolValueE8, lpAmount, lpTotalSupply);
+    }
+}
diff --git a/src/libraries/OracleLib.sol b/src/libraries/OracleLib.sol
new file mode 100644
index 0000000..d1851e0
--- /dev/null
+++ b/src/libraries/OracleLib.sol
@@ -0,0 +1,38 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.28;
+
+import {IAggregatorV3} from "../interfaces/IAggregatorV3.sol";
+
+/// @title OracleLib
+/// @notice Safe reads of Chainlink feeds: rejects non-positive answers and stale rounds.
+/// @dev Every price this system uses flows through here. A silently stale feed would let the
+///      strategy accept an arbitrarily bad swap, so staleness is a hard revert, never a fallback.
+library OracleLib {
+    error StalePrice(address feed, uint256 updatedAt, uint256 maxAge);
+    error InvalidPrice(address feed, int256 answer);
+    error IncompleteRound(address feed);
+
+    /// @notice Read a feed and normalise the answer to 8 decimals.
+    /// @param feed Chainlink aggregator.
+    /// @param maxAge Maximum age in seconds; should exceed the feed's heartbeat.
+    /// @return price Price with 8 decimals.
+    function priceE8(IAggregatorV3 feed, uint256 maxAge) internal view returns (uint256 price) {
+        (uint80 roundId, int256 answer,, uint256 updatedAt, uint80 answeredInRound) = feed.latestRoundData();
+
+        if (answer <= 0) revert InvalidPrice(address(feed), answer);
+        if (updatedAt == 0 || answeredInRound < roundId) revert IncompleteRound(address(feed));
+        if (block.timestamp > updatedAt && block.timestamp - updatedAt > maxAge) {
+            revert StalePrice(address(feed), updatedAt, maxAge);
+        }
+
+        uint256 dec = feed.decimals();
+        price = uint256(answer); // safe: `answer > 0` was enforced above
+
+        if (dec < 8) {
+            price = price * (10 ** (8 - dec));
+        } else if (dec > 8) {
+            price = price / (10 ** (dec - 8));
+        }
+        if (price == 0) revert InvalidPrice(address(feed), answer);
+    }
+}
diff --git a/src/strategies/AerodromeUsdcWethStrategy.sol b/src/strategies/AerodromeUsdcWethStrategy.sol
new file mode 100644
index 0000000..047a739
--- /dev/null
+++ b/src/strategies/AerodromeUsdcWethStrategy.sol
@@ -0,0 +1,566 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.28;
+
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {IERC20Metadata} from "@openzeppelin/contracts/token/ERC20/extensions/IERC20Metadata.sol";
+import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+import {Ownable2Step, Ownable} from "@openzeppelin/contracts/access/Ownable2Step.sol";
+import {ReentrancyGuard} from "@openzeppelin/contracts/utils/ReentrancyGuard.sol";
+import {Math} from "@openzeppelin/contracts/utils/math/Math.sol";
+
+import {IStrategy} from "../interfaces/IStrategy.sol";
+import {IAerodromeRouter} from "../interfaces/IAerodromeRouter.sol";
+import {IAerodromePool} from "../interfaces/IAerodromePool.sol";
+import {IAerodromeGauge} from "../interfaces/IAerodromeGauge.sol";
+import {IAggregatorV3} from "../interfaces/IAggregatorV3.sol";
+import {OracleLib} from "../libraries/OracleLib.sol";
+import {FairLpMath} from "../libraries/FairLpMath.sol";
+
+/// @title AerodromeUsdcWethStrategy
+/// @notice Turns vault USDC into an Aerodrome vAMM-WETH/USDC LP position staked in the pool's
+///         gauge, and compounds the AERO emissions the gauge streams back.
+///
+/// @dev Yield source. Aerodrome runs the ve(3,3) model: once an LP token is staked in its gauge,
+///      the pool's trading fees are routed to the gauge and forwarded to `feesVotingReward` for
+///      the veAERO voters, *not* to the staker. What a staked LP earns is the AERO emission
+///      stream. `harvest()` therefore claims AERO, sells it for USDC, and folds the proceeds back
+///      into the LP position.
+///
+/// @dev Manipulation resistance. Two independent guards are applied to everything that touches
+///      the pool:
+///        1. every swap gets a `minOut` derived from Chainlink prices, not from pool reserves;
+///        2. every position change is bracketed by an end-to-end fair-value check — the USDC-
+///           denominated value coming out must be within `maxSlippageBps` of the value going in,
+///           where LP value uses the flash-loan-invariant formula in {FairLpMath}.
+///      Guard (2) is the load-bearing one: it holds even if an attacker skews the reserves inside
+///      the same transaction, because it never trusts the reserve split.
+contract AerodromeUsdcWethStrategy is IStrategy, Ownable2Step, ReentrancyGuard {
+    using SafeERC20 for IERC20;
+
+    uint256 internal constant MAX_BPS = 10_000;
+    /// @dev Ceiling on governance-settable slippage, so a compromised owner cannot open the door
+    ///      to arbitrary value extraction on the next keeper call.
+    uint256 internal constant MAX_SLIPPAGE_BPS = 500; // 5%
+    uint256 internal constant MAX_SWAP_SLIPPAGE_BPS = 1_000; // 10%
+    uint256 internal constant MAX_PERFORMANCE_FEE_BPS = 2_000; // 20%
+
+    // --- immutable wiring -------------------------------------------------
+
+    address public immutable override vault;
+    address public immutable override asset; // USDC
+    address public immutable weth;
+    address public immutable aero;
+
+    IAerodromeRouter public immutable router;
+    IAerodromePool public immutable pool;
+    IAerodromeGauge public immutable gauge;
+    address public immutable poolFactory;
+
+    /// @dev vAMM (volatile, x*y=k) pool. {FairLpMath} is only valid for constant-product pools,
+    ///      so this is asserted at construction rather than left configurable.
+    bool internal constant STABLE = false;
+
+    IAggregatorV3 public immutable usdcUsdFeed;
+    IAggregatorV3 public immutable ethUsdFeed;
+    IAggregatorV3 public immutable aeroUsdFeed;
+
+    uint8 internal immutable assetDecimals;
+    uint8 internal immutable wethDecimals;
+    uint8 internal immutable aeroDecimals;
+    uint8 internal immutable token0Decimals;
+    uint8 internal immutable token1Decimals;
+    bool internal immutable wethIsToken0;
+
+    // --- governance parameters -------------------------------------------
+
+    mapping(address => bool) public isKeeper;
+
+    /// @notice End-to-end tolerance: how much USDC-denominated value a position change may lose.
+    /// @dev This is the guard that actually protects depositors, and it is deliberately tight.
+    uint256 public maxSlippageBps = 100; // 1%
+
+    /// @notice Per-swap tolerance against the Chainlink mid price.
+    /// @dev Necessarily wider than {maxSlippageBps}: a swap's execution price legitimately differs
+    ///      from the oracle mid by the AMM's price impact, which grows with trade size. This bound
+    ///      exists to catch gross manipulation or oracle divergence, not to price a trade — the
+    ///      end-to-end fair-value check is what bounds real loss.
+    uint256 public maxSwapSlippageBps = 300; // 3%
+
+    uint256 public performanceFeeBps = 1_000; // 10%
+    address public treasury;
+
+    /// @notice Feed staleness ceilings, in seconds. Must exceed each feed's heartbeat.
+    uint256 public usdcFeedMaxAge = 90_000; // Base USDC/USD heartbeat is 24h
+    uint256 public ethFeedMaxAge = 3_600; // Base ETH/USD heartbeat is 20m
+    uint256 public aeroFeedMaxAge = 90_000; // Base AERO/USD heartbeat is 24h
+
+    /// @notice Below this, idle USDC is left uninvested — a swap would cost more than it earns.
+    uint256 public minInvestAmount = 10e6; // 10 USDC
+    /// @notice Below this, claimed AERO is left to accumulate for the next harvest.
+    uint256 public minHarvestAero = 1e18; // 1 AERO
+
+    /// @notice When true the strategy stops redeploying capital and only unwinds.
+    bool public emergencyExit;
+
+    // --- events -----------------------------------------------------------
+
+    event Deposited(uint256 assets);
+    event Withdrawn(uint256 requested, uint256 sent);
+    event Harvested(uint256 aeroSold, uint256 usdcReceived, uint256 performanceFee);
+    event Invested(uint256 usdcIn, uint256 wethIn, uint256 liquidity);
+    event Unwound(uint256 liquidity, uint256 usdcOut);
+    event KeeperUpdated(address indexed keeper, bool allowed);
+    event SlippageUpdated(uint256 maxSlippageBps, uint256 maxSwapSlippageBps);
+    event PerformanceFeeUpdated(uint256 feeBps, address treasury);
+    event FeedMaxAgeUpdated(uint256 usdcMaxAge, uint256 ethMaxAge, uint256 aeroMaxAge);
+    event ThresholdsUpdated(uint256 minInvestAmount, uint256 minHarvestAero);
+    event EmergencyExitSet(bool active);
+
+    // --- errors -----------------------------------------------------------
+
+    error NotVault(address caller);
+    error NotKeeper(address caller);
+    error ZeroAddress();
+    error InvalidBps(uint256 value);
+    error InvalidPool();
+    error InvalidGauge();
+    error InvalidFeed(address feed);
+    error SlippageExceeded(uint256 valueIn, uint256 valueOut, uint256 minOut);
+    error NothingToWithdraw();
+    error InsufficientUnwind(uint256 requested, uint256 obtained);
+    error EmergencyExitActive();
+    error CannotRescue(address token);
+
+    struct Config {
+        address vault;
+        address asset;
+        address weth;
+        address router;
+        address gauge;
+        address usdcUsdFeed;
+        address ethUsdFeed;
+        address aeroUsdFeed;
+        address owner;
+        address treasury;
+    }
+
+    constructor(Config memory c) Ownable(c.owner) {
+        if (
+            c.vault == address(0) || c.asset == address(0) || c.weth == address(0) || c.router == address(0)
+                || c.gauge == address(0) || c.owner == address(0) || c.treasury == address(0)
+        ) revert ZeroAddress();
+
+        vault = c.vault;
+        asset = c.asset;
+        weth = c.weth;
+        treasury = c.treasury;
+
+        router = IAerodromeRouter(c.router);
+        gauge = IAerodromeGauge(c.gauge);
+
+        // Derive the pool from the gauge rather than accepting it as a parameter: this makes a
+        // gauge/pool mismatch unrepresentable.
+        IAerodromePool p = IAerodromePool(gauge.stakingToken());
+        pool = p;
+        aero = gauge.rewardToken();
+        if (aero == address(0)) revert InvalidGauge();
+
+        address t0 = p.token0();
+        address t1 = p.token1();
+        if (p.stable() != STABLE) revert InvalidPool();
+        if (!((t0 == c.weth && t1 == c.asset) || (t0 == c.asset && t1 == c.weth))) revert InvalidPool();
+        wethIsToken0 = (t0 == c.weth);
+
+        poolFactory = router.defaultFactory();
+        if (router.poolFor(c.weth, c.asset, STABLE, poolFactory) != address(p)) revert InvalidPool();
+
+        token0Decimals = IERC20Metadata(t0).decimals();
+        token1Decimals = IERC20Metadata(t1).decimals();
+        assetDecimals = IERC20Metadata(c.asset).decimals();
+        wethDecimals = IERC20Metadata(c.weth).decimals();
+        aeroDecimals = IERC20Metadata(aero).decimals();
+
+        usdcUsdFeed = _checkFeed(c.usdcUsdFeed);
+        ethUsdFeed = _checkFeed(c.ethUsdFeed);
+        aeroUsdFeed = _checkFeed(c.aeroUsdFeed);
+    }
+
+    function _checkFeed(address feed) private view returns (IAggregatorV3) {
+        if (feed == address(0)) revert ZeroAddress();
+        // Probe once at construction so a mis-wired feed fails at deploy time, not at harvest time.
+        (, int256 answer,,,) = IAggregatorV3(feed).latestRoundData();
+        if (answer <= 0) revert InvalidFeed(feed);
+        return IAggregatorV3(feed);
+    }
+
+    modifier onlyVault() {
+        if (msg.sender != vault) revert NotVault(msg.sender);
+        _;
+    }
+
+    modifier onlyKeeper() {
+        if (!isKeeper[msg.sender] && msg.sender != owner()) revert NotKeeper(msg.sender);
+        _;
+    }
+
+    // ---------------------------------------------------------------------
+    // Valuation
+    // ---------------------------------------------------------------------
+
+    /// @notice Total LP tokens controlled: staked in the gauge plus any sitting loose.
+    function lpBalance() public view returns (uint256) {
+        return gauge.balanceOf(address(this)) + IERC20(address(pool)).balanceOf(address(this));
+    }
+
+    /// @notice AERO claimable from the gauge plus any already claimed but not yet sold.
+    function pendingRewards() public view returns (uint256) {
+        return gauge.earned(address(this)) + IERC20(aero).balanceOf(address(this));
+    }
+
+    /// @inheritdoc IStrategy
+    /// @dev Prices come from Chainlink and LP value from the invariant-based formula, so this is
+    ///      not movable by trading against the pool. Unharvested AERO is included so that the
+    ///      share price does not step up at harvest — otherwise a bot could deposit in the block
+    ///      before `harvest()` and capture yield it did not earn.
+    function totalAssets() public view override returns (uint256) {
+        uint256 usdcPrice = OracleLib.priceE8(usdcUsdFeed, usdcFeedMaxAge);
+
+        uint256 valueE8 = _lpValueE8(lpBalance(), usdcPrice);
+        valueE8 += _tokenValueE8(
+            IERC20(weth).balanceOf(address(this)), wethDecimals, OracleLib.priceE8(ethUsdFeed, ethFeedMaxAge)
+        );
+        valueE8 += _tokenValueE8(pendingRewards(), aeroDecimals, OracleLib.priceE8(aeroUsdFeed, aeroFeedMaxAge));
+
+        return IERC20(asset).balanceOf(address(this)) + _usdToAsset(valueE8, usdcPrice);
+    }
+
+    function _tokenValueE8(uint256 amount, uint8 dec, uint256 priceE8) internal pure returns (uint256) {
+        if (amount == 0) return 0;
+        return Math.mulDiv(amount, priceE8, 10 ** dec);
+    }
+
+    function _lpValueE8(uint256 lpAmount, uint256 usdcPrice) internal view returns (uint256) {
+        if (lpAmount == 0) return 0;
+        (uint256 r0, uint256 r1,) = pool.getReserves();
+        uint256 ethPrice = OracleLib.priceE8(ethUsdFeed, ethFeedMaxAge);
+        (uint256 p0, uint256 p1) = wethIsToken0 ? (ethPrice, usdcPrice) : (usdcPrice, ethPrice);
+        return FairLpMath.lpValueE8(r0, r1, token0Decimals, token1Decimals, p0, p1, lpAmount, pool.totalSupply());
+    }
+
+    /// @dev Convert an 8-decimal USD amount into USDC units at the USDC/USD oracle price.
+    function _usdToAsset(uint256 valueE8, uint256 usdcPrice) internal view returns (uint256) {
+        if (valueE8 == 0) return 0;
+        return Math.mulDiv(valueE8, 10 ** assetDecimals, usdcPrice);
+    }
+
+    /// @notice USDC value a harvest would realise right now, or 0 if below the sell threshold.
+    /// @dev Keeper bots poll this to decide whether a harvest clears their gas cost.
+    function harvestableInAsset() external view returns (uint256) {
+        uint256 pending = pendingRewards();
+        if (pending < minHarvestAero) return 0;
+        uint256 usdcPrice = OracleLib.priceE8(usdcUsdFeed, usdcFeedMaxAge);
+        uint256 aeroPrice = OracleLib.priceE8(aeroUsdFeed, aeroFeedMaxAge);
+        return _usdToAsset(_tokenValueE8(pending, aeroDecimals, aeroPrice), usdcPrice);
+    }
+
+    /// @notice USDC-denominated fair value of an LP amount. Exposed for keepers and monitoring.
+    function lpValueInAsset(uint256 lpAmount) public view returns (uint256) {
+        uint256 usdcPrice = OracleLib.priceE8(usdcUsdFeed, usdcFeedMaxAge);
+        return _usdToAsset(_lpValueE8(lpAmount, usdcPrice), usdcPrice);
+    }
+
+    // ---------------------------------------------------------------------
+    // Vault-facing entry points
+    // ---------------------------------------------------------------------
+
+    /// @inheritdoc IStrategy
+    /// @dev The vault transfers the USDC in first, then calls this.
+    function deposit(uint256 amount) external override onlyVault nonReentrant {
+        if (emergencyExit) revert EmergencyExitActive();
+        emit Deposited(amount);
+        _invest();
+    }
+
+    /// @inheritdoc IStrategy
+    function withdraw(uint256 amount) external override onlyVault nonReentrant returns (uint256 sent) {
+        sent = _divest(amount);
+        IERC20(asset).safeTransfer(vault, sent);
+        emit Withdrawn(amount, sent);
+    }
+
+    /// @inheritdoc IStrategy
+    function withdrawAll() external override onlyVault nonReentrant returns (uint256 sent) {
+        _unwind(lpBalance());
+        _sellRewards();
+        sent = IERC20(asset).balanceOf(address(this));
+        if (sent > 0) IERC20(asset).safeTransfer(vault, sent);
+        emit Withdrawn(type(uint256).max, sent);
+    }
+
+    // ---------------------------------------------------------------------
+    // Keeper entry points
+    // ---------------------------------------------------------------------
+
+    /// @notice Claim AERO emissions, sell them for USDC, take the performance fee, and fold the
+    ///         rest back into the LP position.
+    /// @dev Keeper-gated. The oracle bounds already make a sandwich unprofitable, but restricting
+    ///      the caller also stops an adversary from choosing *when* harvest runs (e.g. forcing it
+    ///      during a Chainlink deviation window) and keeps reward sizing under operator control.
+    function harvest() external onlyKeeper nonReentrant returns (uint256 usdcReceived, uint256 fee) {
+        gauge.getReward(address(this));
+
+        // Includes anything claimed on an earlier sub-threshold harvest and carried forward.
+        uint256 aeroHeld = IERC20(aero).balanceOf(address(this));
+        usdcReceived = _sellRewards();
+
+        fee = Math.mulDiv(usdcReceived, performanceFeeBps, MAX_BPS);
+        if (fee > 0) IERC20(asset).safeTransfer(treasury, fee);
+
+        if (!emergencyExit) _invest();
+
+        emit Harvested(usdcReceived == 0 ? 0 : aeroHeld, usdcReceived, fee);
+    }
+
+    /// @notice Deploy any idle USDC sitting in the strategy without waiting for a new deposit.
+    function invest() external onlyKeeper nonReentrant {
+        if (emergencyExit) revert EmergencyExitActive();
+        _invest();
+    }
+
+    // ---------------------------------------------------------------------
+    // Internals: investing
+    // ---------------------------------------------------------------------
+
+    /// @dev Balance idle USDC and WETH toward the pool's 50/50 value split, add liquidity, stake
+    ///      the LP. Bracketed by a fair-value check so the whole sequence cannot lose more than
+    ///      `maxSlippageBps`.
+    function _invest() internal {
+        uint256 usdcBal = IERC20(asset).balanceOf(address(this));
+        if (usdcBal < minInvestAmount) return;
+
+        uint256 usdcPrice = OracleLib.priceE8(usdcUsdFeed, usdcFeedMaxAge);
+        uint256 ethPrice = OracleLib.priceE8(ethUsdFeed, ethFeedMaxAge);
+
+        uint256 valueInE8 = _tokenValueE8(usdcBal, assetDecimals, usdcPrice)
+            + _tokenValueE8(IERC20(weth).balanceOf(address(this)), wethDecimals, ethPrice);
+
+        // Bring the WETH leg up to half of the total value. A vAMM is 50/50 by value, so this is
+        // the split that leaves the least stranded. Any residual stays idle for the next round
+        // rather than being force-swapped.
+        uint256 wethValueE8 = _tokenValueE8(IERC20(weth).balanceOf(address(this)), wethDecimals, ethPrice);
+        uint256 halfE8 = valueInE8 / 2;
+        if (wethValueE8 < halfE8) {
+            uint256 swapUsdc = _usdToAsset(halfE8 - wethValueE8, usdcPrice);
+            if (swapUsdc > usdcBal) swapUsdc = usdcBal;
+            if (swapUsdc > 0) _swap(asset, weth, swapUsdc, assetDecimals, wethDecimals, usdcPrice, ethPrice);
+        }
+
+        uint256 wethAmt = IERC20(weth).balanceOf(address(this));
+        uint256 usdcAmt = IERC20(asset).balanceOf(address(this));
+        if (wethAmt == 0 || usdcAmt == 0) return;
+
+        IERC20(weth).forceApprove(address(router), wethAmt);
+        IERC20(asset).forceApprove(address(router), usdcAmt);
+
+        (,, uint256 liquidity) = router.addLiquidity(
+            weth,
+            asset,
+            STABLE,
+            wethAmt,
+            usdcAmt,
+            0, // per-token minimums are meaningless here; the fair-value check below is authoritative
+            0,
+            address(this),
+            block.timestamp
+        );
+
+        IERC20(weth).forceApprove(address(router), 0);
+        IERC20(asset).forceApprove(address(router), 0);
+
+        // End-to-end check: what we now hold must be worth at least what we put in, minus tolerance.
+        uint256 valueOutE8 = _lpValueE8(liquidity, usdcPrice)
+            + _tokenValueE8(IERC20(asset).balanceOf(address(this)), assetDecimals, usdcPrice)
+            + _tokenValueE8(IERC20(weth).balanceOf(address(this)), wethDecimals, ethPrice);
+
+        uint256 minValueE8 = Math.mulDiv(valueInE8, MAX_BPS - maxSlippageBps, MAX_BPS);
+        if (valueOutE8 < minValueE8) revert SlippageExceeded(valueInE8, valueOutE8, minValueE8);
+
+        if (liquidity > 0) {
+            IERC20(address(pool)).forceApprove(address(gauge), liquidity);
+            gauge.deposit(liquidity);
+        }
+
+        emit Invested(usdcAmt, wethAmt, liquidity);
+    }
+
+    // ---------------------------------------------------------------------
+    // Internals: divesting
+    // ---------------------------------------------------------------------
+
+    /// @dev Free exactly `amount` USDC, unwinding as little of the LP position as possible.
+    function _divest(uint256 amount) internal returns (uint256) {
+        uint256 idle = IERC20(asset).balanceOf(address(this));
+        if (idle >= amount) return amount;
+
+        uint256 need = amount - idle;
+        uint256 lpTotal = lpBalance();
+        if (lpTotal == 0) revert NothingToWithdraw();
+
+        uint256 lpValue = lpValueInAsset(lpTotal);
+        if (lpValue == 0) revert NothingToWithdraw();
+
+        // Over-unwind by the slippage tolerance so the swap leg still clears `need`. Surplus is
+        // returned to the vault's idle buffer, so over-shooting costs nothing but a little gas.
+        uint256 grossNeed = Math.mulDiv(need, MAX_BPS + maxSlippageBps, MAX_BPS, Math.Rounding.Ceil);
+        uint256 lpToPull = Math.mulDiv(lpTotal, grossNeed, lpValue, Math.Rounding.Ceil);
+        if (lpToPull > lpTotal) lpToPull = lpTotal;
+
+        _unwind(lpToPull);
+
+        uint256 available = IERC20(asset).balanceOf(address(this));
+        if (available < amount) {
+            // The position genuinely cannot cover the request (deep drawdown, or the whole
+            // position was already unwound). Send what exists rather than bricking withdrawals.
+            if (lpToPull == lpTotal) return available;
+            revert InsufficientUnwind(amount, available);
+        }
+        return amount;
+    }
+
+    /// @dev Unstake, burn `lpAmount` of LP, and convert the WETH leg to USDC.
+    function _unwind(uint256 lpAmount) internal {
+        if (lpAmount == 0) return;
+
+        uint256 usdcPrice = OracleLib.priceE8(usdcUsdFeed, usdcFeedMaxAge);
+        uint256 ethPrice = OracleLib.priceE8(ethUsdFeed, ethFeedMaxAge);
+        uint256 valueInE8 = _lpValueE8(lpAmount, usdcPrice);
+
+        uint256 loose = IERC20(address(pool)).balanceOf(address(this));
+        if (lpAmount > loose) gauge.withdraw(lpAmount - loose);
+
+        uint256 usdcBefore = IERC20(asset).balanceOf(address(this));
+
+        IERC20(address(pool)).forceApprove(address(router), lpAmount);
+        (uint256 wethOut,) = router.removeLiquidity(weth, asset, STABLE, lpAmount, 0, 0, address(this), block.timestamp);
+
+        if (wethOut > 0) _swap(weth, asset, wethOut, wethDecimals, assetDecimals, ethPrice, usdcPrice);
+
+        uint256 usdcOut = IERC20(asset).balanceOf(address(this)) - usdcBefore;
+
+        // The realised USDC must be worth close to the LP we burned, valued at oracle prices.
+        // This is what makes reserve manipulation unprofitable: skewing the pool changes the
+        // split we receive, but not the fair value we require back.
+        uint256 valueOutE8 = _tokenValueE8(usdcOut, assetDecimals, usdcPrice);
+        uint256 minValueE8 = Math.mulDiv(valueInE8, MAX_BPS - maxSlippageBps, MAX_BPS);
+        if (valueOutE8 < minValueE8) revert SlippageExceeded(valueInE8, valueOutE8, minValueE8);
+
+        emit Unwound(lpAmount, usdcOut);
+    }
+
+    /// @dev Sell held AERO for USDC. No-op below `minHarvestAero`.
+    function _sellRewards() internal returns (uint256 usdcReceived) {
+        uint256 aeroBal = IERC20(aero).balanceOf(address(this));
+        if (aeroBal < minHarvestAero) return 0;
+
+        uint256 usdcPrice = OracleLib.priceE8(usdcUsdFeed, usdcFeedMaxAge);
+        uint256 aeroPrice = OracleLib.priceE8(aeroUsdFeed, aeroFeedMaxAge);
+
+        uint256 before = IERC20(asset).balanceOf(address(this));
+        _swap(aero, asset, aeroBal, aeroDecimals, assetDecimals, aeroPrice, usdcPrice);
+        usdcReceived = IERC20(asset).balanceOf(address(this)) - before;
+    }
+
+    // ---------------------------------------------------------------------
+    // Internals: swapping
+    // ---------------------------------------------------------------------
+
+    /// @dev Single-hop vAMM swap with an oracle-derived `minOut`. The AERO/USDC and WETH/USDC
+    ///      vAMM pools are the deepest venues for these legs on Aerodrome, so one hop is enough
+    ///      and avoids the extra fee and extra manipulation surface of a routed path.
+    function _swap(
+        address tokenIn,
+        address tokenOut,
+        uint256 amountIn,
+        uint8 decIn,
+        uint8 decOut,
+        uint256 priceInE8,
+        uint256 priceOutE8
+    ) internal {
+        uint256 expectedOut = Math.mulDiv(Math.mulDiv(amountIn, priceInE8, 10 ** decIn), 10 ** decOut, priceOutE8);
+        uint256 minOut = Math.mulDiv(expectedOut, MAX_BPS - maxSwapSlippageBps, MAX_BPS);
+
+        IAerodromeRouter.Route[] memory routes = new IAerodromeRouter.Route[](1);
+        routes[0] = IAerodromeRouter.Route({from: tokenIn, to: tokenOut, stable: false, factory: poolFactory});
+
+        IERC20(tokenIn).forceApprove(address(router), amountIn);
+        router.swapExactTokensForTokens(amountIn, minOut, routes, address(this), block.timestamp);
+        IERC20(tokenIn).forceApprove(address(router), 0);
+    }
+
+    // ---------------------------------------------------------------------
+    // Governance
+    // ---------------------------------------------------------------------
+
+    function setKeeper(address keeper, bool allowed) external onlyOwner {
+        if (keeper == address(0)) revert ZeroAddress();
+        isKeeper[keeper] = allowed;
+        emit KeeperUpdated(keeper, allowed);
+    }
+
+    /// @param newSlippageBps End-to-end position-value tolerance.
+    /// @param newSwapSlippageBps Per-swap tolerance against the oracle mid; must be >= the former.
+    function setSlippage(uint256 newSlippageBps, uint256 newSwapSlippageBps) external onlyOwner {
+        if (newSlippageBps == 0 || newSlippageBps > MAX_SLIPPAGE_BPS) revert InvalidBps(newSlippageBps);
+        if (newSwapSlippageBps < newSlippageBps || newSwapSlippageBps > MAX_SWAP_SLIPPAGE_BPS) {
+            revert InvalidBps(newSwapSlippageBps);
+        }
+        maxSlippageBps = newSlippageBps;
+        maxSwapSlippageBps = newSwapSlippageBps;
+        emit SlippageUpdated(newSlippageBps, newSwapSlippageBps);
+    }
+
+    function setPerformanceFee(uint256 newFeeBps, address newTreasury) external onlyOwner {
+        if (newFeeBps > MAX_PERFORMANCE_FEE_BPS) revert InvalidBps(newFeeBps);
+        if (newTreasury == address(0)) revert ZeroAddress();
+        performanceFeeBps = newFeeBps;
+        treasury = newTreasury;
+        emit PerformanceFeeUpdated(newFeeBps, newTreasury);
+    }
+
+    function setFeedMaxAges(uint256 usdcMaxAge, uint256 ethMaxAge, uint256 aeroMaxAge) external onlyOwner {
+        if (usdcMaxAge == 0 || ethMaxAge == 0 || aeroMaxAge == 0) revert InvalidBps(0);
+        usdcFeedMaxAge = usdcMaxAge;
+        ethFeedMaxAge = ethMaxAge;
+        aeroFeedMaxAge = aeroMaxAge;
+        emit FeedMaxAgeUpdated(usdcMaxAge, ethMaxAge, aeroMaxAge);
+    }
+
+    function setThresholds(uint256 newMinInvest, uint256 newMinHarvestAero) external onlyOwner {
+        minInvestAmount = newMinInvest;
+        minHarvestAero = newMinHarvestAero;
+        emit ThresholdsUpdated(newMinInvest, newMinHarvestAero);
+    }
+
+    /// @notice Stop redeploying capital. Existing position is unwound on the next vault withdrawal
+    ///         or immediately via {panic}.
+    function setEmergencyExit(bool active) external onlyOwner {
+        emergencyExit = active;
+        emit EmergencyExitSet(active);
+    }
+
+    /// @notice Unwind the entire LP position to USDC in place, without moving funds to the vault.
+    /// @dev Separate from {withdrawAll} so it can be used while the vault is mid-migration.
+    function panic() external onlyOwner nonReentrant {
+        emergencyExit = true;
+        _unwind(lpBalance());
+        _sellRewards();
+        emit EmergencyExitSet(true);
+    }
+
+    /// @notice Recover tokens accidentally sent here. Cannot touch anything the strategy manages.
+    function rescue(address token, address to) external onlyOwner {
+        if (token == asset || token == weth || token == aero || token == address(pool)) revert CannotRescue(token);
+        if (to == address(0)) revert ZeroAddress();
+        IERC20(token).safeTransfer(to, IERC20(token).balanceOf(address(this)));
+    }
+}
diff --git a/test/fork/BaseFork.t.sol b/test/fork/BaseFork.t.sol
new file mode 100644
index 0000000..137c35e
--- /dev/null
+++ b/test/fork/BaseFork.t.sol
@@ -0,0 +1,156 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.28;
+
+import {Test, console2} from "forge-std/Test.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+
+import {YieldVault} from "../../src/YieldVault.sol";
+import {AerodromeUsdcWethStrategy} from "../../src/strategies/AerodromeUsdcWethStrategy.sol";
+import {IStrategy} from "../../src/interfaces/IStrategy.sol";
+import {IAerodromeGauge} from "../../src/interfaces/IAerodromeGauge.sol";
+import {IAerodromePool} from "../../src/interfaces/IAerodromePool.sol";
+import {IAggregatorV3} from "../../src/interfaces/IAggregatorV3.sol";
+import {BaseAddresses} from "../../src/BaseAddresses.sol";
+
+/// @notice Integration tests against real Aerodrome and Chainlink contracts on a Base fork.
+/// @dev Skipped unless BASE_RPC_URL is set, so `forge test` stays green offline:
+///        export BASE_RPC_URL=https://mainnet.base.org && forge test --match-path 'test/fork/*'
+contract BaseForkTest is Test {
+    address internal owner = makeAddr("owner");
+    address internal keeper = makeAddr("keeper");
+    address internal treasury = makeAddr("treasury");
+    address internal alice = makeAddr("alice");
+
+    YieldVault internal vault;
+    AerodromeUsdcWethStrategy internal strategy;
+
+    IERC20 internal usdc = IERC20(BaseAddresses.USDC);
+    IAerodromeGauge internal gauge = IAerodromeGauge(BaseAddresses.VAMM_WETH_USDC_GAUGE);
+
+    bool internal active;
+
+    function setUp() public {
+        string memory rpc = vm.envOr("BASE_RPC_URL", string(""));
+        if (bytes(rpc).length == 0) return;
+
+        vm.createSelectFork(rpc);
+        active = true;
+
+        vault = new YieldVault(usdc, "Aerodrome USDC Yield Vault", "yvUSDC-AERO", owner, type(uint256).max);
+
+        strategy = new AerodromeUsdcWethStrategy(
+            AerodromeUsdcWethStrategy.Config({
+                vault: address(vault),
+                asset: BaseAddresses.USDC,
+                weth: BaseAddresses.WETH,
+                router: BaseAddresses.AERODROME_ROUTER,
+                gauge: BaseAddresses.VAMM_WETH_USDC_GAUGE,
+                usdcUsdFeed: BaseAddresses.USDC_USD_FEED,
+                ethUsdFeed: BaseAddresses.ETH_USD_FEED,
+                aeroUsdFeed: BaseAddresses.AERO_USD_FEED,
+                owner: owner,
+                treasury: treasury
+            })
+        );
+
+        vm.startPrank(owner);
+        vault.setStrategy(IStrategy(address(strategy)));
+        vault.setKeeper(keeper, true);
+        strategy.setKeeper(keeper, true);
+        vm.stopPrank();
+
+        deal(BaseAddresses.USDC, alice, 500_000e6);
+        vm.prank(alice);
+        usdc.approve(address(vault), type(uint256).max);
+    }
+
+    modifier onFork() {
+        if (!active) {
+            console2.log("BASE_RPC_URL unset - skipping fork tests");
+            return;
+        }
+        _;
+    }
+
+    /// @dev Confirms the addresses in {BaseAddresses} really are what the code assumes.
+    function test_wiringMatchesLiveContracts() public onFork {
+        assertEq(gauge.stakingToken(), BaseAddresses.VAMM_WETH_USDC_POOL, "gauge stakes the expected pool");
+        assertEq(gauge.rewardToken(), BaseAddresses.AERO, "gauge pays AERO");
+        assertEq(address(strategy.pool()), BaseAddresses.VAMM_WETH_USDC_POOL);
+        assertFalse(IAerodromePool(BaseAddresses.VAMM_WETH_USDC_POOL).stable(), "must be a vAMM pool");
+
+        assertEq(IAggregatorV3(BaseAddresses.ETH_USD_FEED).description(), "ETH / USD");
+        assertEq(IAggregatorV3(BaseAddresses.USDC_USD_FEED).description(), "USDC / USD");
+        assertEq(IAggregatorV3(BaseAddresses.AERO_USD_FEED).description(), "AERO / USD");
+    }
+
+    function test_depositAllocateHarvestWithdraw() public onFork {
+        vm.prank(alice);
+        uint256 shares = vault.deposit(100_000e6, alice);
+
+        vm.prank(keeper);
+        uint256 deployed = vault.allocate();
+        assertGt(deployed, 0);
+        assertGt(gauge.balanceOf(address(strategy)), 0, "LP staked in the live gauge");
+
+        // Value must survive the round into the live pool.
+        assertApproxEqRel(vault.totalAssets(), 100_000e6, 0.01e18);
+
+        // Let emissions accrue. Feeds go stale under a long warp, so widen the ceilings first;
+        // on mainnet they keep publishing.
+        vm.prank(owner);
+        strategy.setFeedMaxAges(400 days, 400 days, 400 days);
+        vm.warp(block.timestamp + 14 days);
+
+        uint256 earned = gauge.earned(address(strategy));
+        console2.log("AERO earned over 14d:", earned);
+        assertGt(earned, 0, "live gauge streams AERO to the staked position");
+
+        uint256 lpBefore = strategy.lpBalance();
+        vm.prank(keeper);
+        (uint256 harvested,) = strategy.harvest();
+        console2.log("USDC harvested:", harvested);
+        assertGt(harvested, 0);
+        assertGt(strategy.lpBalance(), lpBefore, "proceeds compounded");
+
+        vm.prank(alice);
+        uint256 out = vault.redeem(shares, alice, alice);
+        console2.log("USDC returned:", out);
+        assertGt(out, 98_000e6, "full exit returns principal net of AMM fees");
+    }
+
+    function test_liveFairLpValuationMatchesReserveValuation() public onFork {
+        vm.prank(alice);
+        vault.deposit(50_000e6, alice);
+        vm.prank(keeper);
+        vault.allocate();
+
+        // With the live pool trading near the oracle price, the invariant-based valuation should
+        // agree closely with a straightforward pro-rata reserve valuation.
+        uint256 lp = strategy.lpBalance();
+        uint256 fair = strategy.lpValueInAsset(lp);
+
+        IAerodromePool pool = IAerodromePool(BaseAddresses.VAMM_WETH_USDC_POOL);
+        (uint256 r0, uint256 r1,) = pool.getReserves();
+        (, int256 ethAnswer,,,) = IAggregatorV3(BaseAddresses.ETH_USD_FEED).latestRoundData();
+        bool wethIs0 = pool.token0() == BaseAddresses.WETH;
+        (uint256 rWeth, uint256 rUsdc) = wethIs0 ? (r0, r1) : (r1, r0);
+        uint256 supply = pool.totalSupply();
+        uint256 naive = (rUsdc * lp) / supply + ((rWeth * lp) / supply) * uint256(ethAnswer) / 1e8 / 1e12;
+
+        assertApproxEqRel(fair, naive, 0.01e18, "fair and naive valuations agree at an unmanipulated price");
+    }
+
+    function test_emergencyPanicOnLivePool() public onFork {
+        vm.prank(alice);
+        vault.deposit(50_000e6, alice);
+        vm.prank(keeper);
+        vault.allocate();
+
+        vm.prank(owner);
+        strategy.panic();
+
+        assertEq(strategy.lpBalance(), 0, "position fully closed on the live pool");
+        assertGt(usdc.balanceOf(address(strategy)), 0);
+    }
+}
