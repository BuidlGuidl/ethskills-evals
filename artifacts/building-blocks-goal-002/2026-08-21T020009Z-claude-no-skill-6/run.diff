+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.28;
+
+import {BaseTest} from "./Base.t.sol";
+import {YieldVault} from "../../src/YieldVault.sol";
+import {IStrategy} from "../../src/interfaces/IStrategy.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {Ownable} from "@openzeppelin/contracts/access/Ownable.sol";
+import {MockStrategy} from "../mocks/MockStrategy.sol";
+
+contract YieldVaultTest is BaseTest {
+    // ---------------------------------------------------------------- basics
+
+    function test_metadata() public view {
+        assertEq(vault.asset(), address(usdc));
+        assertEq(vault.decimals(), 9, "6 asset decimals + 3 offset");
+        assertEq(vault.symbol(), "yUSDC");
+        assertEq(address(vault.strategy()), address(strategy));
+    }
+
+    function test_deposit_mintsSharesAndHoldsIdle() public {
+        uint256 shares = _deposit(alice, 10_000e6);
+
+        assertGt(shares, 0);
+        assertEq(vault.balanceOf(alice), shares);
+        assertEq(vault.idleAssets(), 11_000e6, "seed + alice, nothing deployed yet");
+        assertApproxEqAbs(vault.totalAssets(), 11_000e6, 1);
+        assertApproxEqAbs(vault.convertToAssets(shares), 10_000e6, 1);
+    }
+
+    function test_redeem_roundTripReturnsPrincipal() public {
+        uint256 shares = _deposit(alice, 10_000e6);
+
+        vm.prank(alice);
+        uint256 assets = vault.redeem(shares, alice, alice);
+
+        assertApproxEqAbs(assets, 10_000e6, 1);
+        assertEq(usdc.balanceOf(alice), assets);
+        assertEq(vault.balanceOf(alice), 0);
+    }
+
+    function test_withdraw_servedFromBufferWithoutTouchingStrategy() public {
+        _deposit(alice, 10_000e6);
+        _allocate();
+
+        uint256 lpBefore = strategy.lpBalance();
+        uint256 buffer = vault.idleAssets();
+        assertGt(buffer, 0, "buffer retained");
+
+        vm.prank(alice);
+        vault.withdraw(buffer / 2, alice, alice);
+
+        assertEq(strategy.lpBalance(), lpBefore, "strategy untouched for small withdrawals");
+    }
+
+    function test_withdraw_pullsFromStrategyWhenBufferInsufficient() public {
+        _deposit(alice, 10_000e6);
+        _allocate();
+
+        uint256 lpBefore = strategy.lpBalance();
+        assertGt(lpBefore, 0);
+
+        vm.prank(alice);
+        vault.withdraw(8_000e6, alice, alice);
+
+        assertEq(usdc.balanceOf(alice), 8_000e6, "receives exactly what was requested");
+        assertLt(strategy.lpBalance(), lpBefore, "position partially unwound");
+    }
+
+    function test_fullExit_afterAllocationReturnsNearPrincipal() public {
+        uint256 shares = _deposit(alice, 10_000e6);
+        _allocate();
+
+        vm.prank(alice);
+        uint256 assets = vault.redeem(shares, alice, alice);
+
+        // Round-tripping through an AMM costs the swap fee on the half that gets swapped, twice.
+        assertLt(assets, 10_000e6, "round trip is not free");
+        assertGt(assets, 9_900e6, "but stays within 1%");
+    }
+
+    // ---------------------------------------------------------- allocation
+
+    function test_allocate_respectsBuffer() public {
+        _deposit(alice, 100_000e6);
+
+        uint256 total = vault.totalAssets();
+        uint256 deployed = _allocate();
+
+        uint256 expectedBuffer = (total * vault.bufferBps()) / 10_000;
+        assertApproxEqAbs(vault.idleAssets(), expectedBuffer, 1, "5% stays liquid");
+        assertApproxEqAbs(deployed, total - expectedBuffer, 1);
+    }
+
+    function test_allocate_isNearNoOpOnSecondCall() public {
+        _deposit(alice, 100_000e6);
+        uint256 first = _allocate();
+
+        // Investing costs a little to swap fees, which shrinks totalAssets and therefore the
+        // buffer target, freeing a sliver to redeploy. It must be dust, not a second round trip.
+        uint256 second = _allocate();
+        assertLt(second, first / 1000, "second call deploys only residual dust");
+    }
+
+    function test_allocate_onlyKeeper() public {
+        _deposit(alice, 10_000e6);
+        vm.expectRevert(abi.encodeWithSelector(YieldVault.NotKeeper.selector, alice));
+        vm.prank(alice);
+        vault.allocate();
+    }
+
+    function test_deallocate_returnsFundsToBuffer() public {
+        _deposit(alice, 100_000e6);
+        _allocate();
+
+        uint256 idleBefore = vault.idleAssets();
+        vm.prank(keeper);
+        vault.deallocate(20_000e6);
+
+        assertGe(vault.idleAssets(), idleBefore + 20_000e6);
+    }
+
+    // ------------------------------------------------------ share pricing
+
+    function test_sharePriceUnchangedByDepositsAndWithdrawals() public {
+        _deposit(alice, 50_000e6);
+        _allocate();
+
+        uint256 psBefore = vault.convertToAssets(1e9);
+
+        _deposit(bob, 25_000e6);
+        assertApproxEqRel(vault.convertToAssets(1e9), psBefore, 1e12, "deposit must not move share price");
+
+        vm.prank(bob);
+        vault.withdraw(10_000e6, bob, bob);
+        assertApproxEqRel(vault.convertToAssets(1e9), psBefore, 1e15, "withdrawal must not move share price");
+    }
+
+    /// @dev The classic ERC-4626 first-depositor attack: mint 1 wei of shares, donate a large
+    ///      amount to inflate the share price, then let the victim's deposit round to zero shares.
+    function test_inflationAttack_isUneconomic() public {
+        // Fresh vault with no seed, to test the worst case.
+        YieldVault fresh = new YieldVault(IERC20(address(usdc)), "Fresh", "f", owner, type(uint256).max);
+
+        usdc.mint(attacker, 100_000e6);
+        vm.startPrank(attacker);
+        usdc.approve(address(fresh), type(uint256).max);
+        fresh.deposit(1, attacker);
+        usdc.transfer(address(fresh), 10_000e6); // donation
+        vm.stopPrank();
+
+        usdc.mint(alice, 20_000e6);
+        vm.startPrank(alice);
+        usdc.approve(address(fresh), type(uint256).max);
+        uint256 aliceShares = fresh.deposit(20_000e6, alice);
+        vm.stopPrank();
+
+        assertGt(aliceShares, 0, "victim must not be rounded to zero shares");
+
+        uint256 attackerShares = fresh.balanceOf(attacker);
+        vm.prank(attacker);
+        uint256 attackerOut = fresh.redeem(attackerShares, attacker, attacker);
+
+        // The attacker spent 10_000e6 + 1 to run the attack.
+        uint256 attackerLoss = 10_000e6 + 1 - attackerOut;
+        assertGt(attackerLoss, 3_000e6, "attack is heavily loss-making for the attacker");
+
+        uint256 aliceShareBal = fresh.balanceOf(alice);
+        vm.prank(alice);
+        uint256 aliceOut = fresh.redeem(aliceShareBal, alice, alice);
+
+        // The victim is left essentially whole: the donation is socialised across shares, so the
+        // residue the attacker's 1000 virtual-offset shares can still claim is negligible.
+        uint256 aliceLoss = 20_000e6 - aliceOut;
+        assertLt(aliceLoss, 20e6 / 10, "victim loses < 0.01% of principal");
+        assertGt(attackerLoss, aliceLoss * 1000, "attacker loses orders of magnitude more than the victim");
+    }
+
+    // ---------------------------------------------------------- guardrails
+
+    function test_depositCap_enforced() public {
+        vm.prank(owner);
+        vault.setDepositCap(5_000e6);
+
+        assertEq(vault.maxDeposit(alice), 4_000e6, "cap minus the 1000 seed");
+
+        _fund(alice, 10_000e6);
+        vm.expectRevert();
+        vm.prank(alice);
+        vault.deposit(4_001e6, alice);
+
+        vm.prank(alice);
+        vault.deposit(4_000e6, alice);
+        assertEq(vault.maxDeposit(alice), 0);
+    }
+
+    function test_pause_blocksDepositsButNotWithdrawals() public {
+        uint256 shares = _deposit(alice, 10_000e6);
+
+        vm.prank(owner);
+        vault.pause();
+
+        assertEq(vault.maxDeposit(alice), 0);
+        vm.expectRevert();
+        vm.prank(alice);
+        vault.deposit(1e6, alice);
+
+        vm.prank(alice);
+        uint256 out = vault.redeem(shares, alice, alice);
+        assertGt(out, 0, "exits stay open while paused");
+    }
+
+    function test_setBufferBps_rejectsOutOfRange() public {
+        vm.prank(owner);
+        vm.expectRevert(abi.encodeWithSelector(YieldVault.InvalidBps.selector, 10_001));
+        vault.setBufferBps(10_001);
+    }
+
+    function test_onlyOwnerGovernance() public {
+        vm.startPrank(alice);
+        vm.expectRevert(abi.encodeWithSelector(Ownable.OwnableUnauthorizedAccount.selector, alice));
+        vault.setBufferBps(100);
+        vm.expectRevert(abi.encodeWithSelector(Ownable.OwnableUnauthorizedAccount.selector, alice));
+        vault.setStrategy(IStrategy(address(0)));
+        vm.expectRevert(abi.encodeWithSelector(Ownable.OwnableUnauthorizedAccount.selector, alice));
+        vault.pause();
+        vm.stopPrank();
+    }
+
+    // ---------------------------------------------------------- migration
+
+    function test_setStrategy_unwindsPreviousStrategy() public {
+        _deposit(alice, 50_000e6);
+        _allocate();
+        assertGt(strategy.lpBalance(), 0);
+
+        uint256 totalBefore = vault.totalAssets();
+
+        vm.prank(owner);
+        vault.setStrategy(IStrategy(address(0)));
+
+        assertEq(strategy.lpBalance(), 0, "old position fully unwound");
+        assertEq(address(vault.strategy()), address(0));
+        assertEq(vault.totalAssets(), vault.idleAssets(), "everything back in the vault");
+        assertApproxEqRel(vault.totalAssets(), totalBefore, 0.01e18);
+    }
+
+    function test_setStrategy_rejectsMismatchedStrategy() public {
+        YieldVault other = new YieldVault(IERC20(address(usdc)), "Other", "o", owner, type(uint256).max);
+        vm.prank(owner);
+        vm.expectRevert(
+            abi.encodeWithSelector(YieldVault.StrategyVaultMismatch.selector, address(other), address(vault))
+        );
+        other.setStrategy(IStrategy(address(strategy)));
+    }
+
+    /// @dev A strategy that returns less than the vault asked for must not silently short the
+    ///      withdrawer; the vault reverts rather than paying out an amount it cannot cover.
+    function test_withdraw_revertsWhenStrategyUnderDelivers() public {
+        YieldVault v = new YieldVault(IERC20(address(usdc)), "V", "v", owner, type(uint256).max);
+        MockStrategy bad = new MockStrategy(address(usdc), address(v));
+        vm.prank(owner);
+        v.setStrategy(IStrategy(address(bad)));
+        vm.prank(owner);
+        v.setKeeper(keeper, true);
+
+        usdc.mint(alice, 10_000e6);
+        vm.startPrank(alice);
+        usdc.approve(address(v), type(uint256).max);
+        v.deposit(10_000e6, alice);
+        vm.stopPrank();
+
+        vm.prank(keeper);
+        v.allocate();
+
+        bad.setDeliveryBps(9_000); // strategy returns only 90% of what was requested
+
+        vm.prank(alice);
+        // 500 idle buffer + 90% of the 4_500 shortfall the strategy was asked for.
+        vm.expectRevert(abi.encodeWithSelector(YieldVault.InsufficientLiquidity.selector, 5_000e6, 4_550e6));
+        v.withdraw(5_000e6, alice, alice);
+    }
+}

