@@ -0,0 +1,235 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.28;
+
+import {ERC4626} from "@openzeppelin/contracts/token/ERC20/extensions/ERC4626.sol";
+import {ERC20} from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+import {Ownable2Step, Ownable} from "@openzeppelin/contracts/access/Ownable2Step.sol";
+import {ReentrancyGuard} from "@openzeppelin/contracts/utils/ReentrancyGuard.sol";
+import {Pausable} from "@openzeppelin/contracts/utils/Pausable.sol";
+import {Math} from "@openzeppelin/contracts/utils/math/Math.sol";
+
+import {IStrategy} from "./interfaces/IStrategy.sol";
+
+/// @title YieldVault
+/// @notice ERC-4626 vault denominated in USDC. Deposits land in an idle buffer; a keeper
+///         pushes the excess into a single strategy that puts the USDC to work.
+/// @dev Deliberately thin: all venue-specific logic lives behind {IStrategy} so the venue can be
+///      swapped without redeploying the token users hold.
+///
+///      Deposits are *not* auto-deployed. Routing every deposit straight into an AMM position
+///      would make each user pay for their own swap and expose them individually to sandwiching.
+///      Batching deployment into a keeper call amortises the cost and lets the strategy enforce
+///      oracle-derived slippage bounds once per batch instead of once per depositor.
+contract YieldVault is ERC4626, Ownable2Step, ReentrancyGuard, Pausable {
+    using SafeERC20 for IERC20;
+
+    uint256 internal constant MAX_BPS = 10_000;
+
+    /// @notice Active strategy. May be address(0) (funds simply sit idle).
+    IStrategy public strategy;
+
+    /// @notice Addresses allowed to run keeper operations. The owner always qualifies.
+    mapping(address => bool) public isKeeper;
+
+    /// @notice Share of totalAssets kept as idle USDC so ordinary withdrawals cost no swap.
+    uint256 public bufferBps = 500; // 5%
+
+    /// @notice Hard cap on totalAssets. A v1 guardrail; set to type(uint256).max to disable.
+    uint256 public depositCap;
+
+    event StrategyUpdated(address indexed previous, address indexed current);
+    event KeeperUpdated(address indexed keeper, bool allowed);
+    event BufferUpdated(uint256 bufferBps);
+    event DepositCapUpdated(uint256 depositCap);
+    event Allocated(uint256 amount);
+    event Deallocated(uint256 amount);
+
+    error NotKeeper(address caller);
+    error NoStrategy();
+    error StrategyAssetMismatch(address expected, address actual);
+    error StrategyVaultMismatch(address expected, address actual);
+    error InsufficientLiquidity(uint256 requested, uint256 available);
+    error InvalidBps(uint256 value);
+    error ZeroAddress();
+
+    modifier onlyKeeper() {
+        if (!isKeeper[msg.sender] && msg.sender != owner()) revert NotKeeper(msg.sender);
+        _;
+    }
+
+    constructor(IERC20 asset_, string memory name_, string memory symbol_, address owner_, uint256 depositCap_)
+        ERC20(name_, symbol_)
+        ERC4626(asset_)
+        Ownable(owner_)
+    {
+        if (owner_ == address(0)) revert ZeroAddress();
+        depositCap = depositCap_;
+        emit DepositCapUpdated(depositCap_);
+    }
+
+    // ---------------------------------------------------------------------
+    // Accounting
+    // ---------------------------------------------------------------------
+
+    /// @notice Idle USDC held directly by the vault.
+    function idleAssets() public view returns (uint256) {
+        return IERC20(asset()).balanceOf(address(this));
+    }
+
+    /// @inheritdoc ERC4626
+    /// @dev Idle balance plus the strategy's oracle-derived valuation of its position.
+    function totalAssets() public view override returns (uint256) {
+        uint256 total = idleAssets();
+        IStrategy s = strategy;
+        if (address(s) != address(0)) total += s.totalAssets();
+        return total;
+    }
+
+    /// @dev Virtual shares/assets offset. Makes the classic ERC-4626 first-depositor inflation
+    ///      attack uneconomic by keeping the attacker's donation from rounding a victim's shares
+    ///      to zero. Combined with the seed deposit performed at deployment.
+    function _decimalsOffset() internal pure override returns (uint8) {
+        return 3;
+    }
+
+    // ---------------------------------------------------------------------
+    // ERC-4626 limits
+    // ---------------------------------------------------------------------
+
+    function maxDeposit(address) public view override returns (uint256) {
+        if (paused()) return 0;
+        uint256 total = totalAssets();
+        if (total >= depositCap) return 0;
+        return depositCap - total;
+    }
+
+    function maxMint(address receiver) public view override returns (uint256) {
+        uint256 assets = maxDeposit(receiver);
+        return assets == type(uint256).max ? type(uint256).max : _convertToShares(assets, Math.Rounding.Floor);
+    }
+
+    // ---------------------------------------------------------------------
+    // Deposit / withdraw plumbing
+    // ---------------------------------------------------------------------
+
+    function _deposit(address caller, address receiver, uint256 assets, uint256 shares)
+        internal
+        override
+        nonReentrant
+        whenNotPaused
+    {
+        super._deposit(caller, receiver, assets, shares);
+    }
+
+    /// @dev Serve from the idle buffer first; only touch the strategy for the shortfall.
+    function _withdraw(address caller, address receiver, address owner_, uint256 assets, uint256 shares)
+        internal
+        override
+        nonReentrant
+    {
+        uint256 idle = idleAssets();
+        if (assets > idle) {
+            IStrategy s = strategy;
+            if (address(s) == address(0)) revert InsufficientLiquidity(assets, idle);
+
+            s.withdraw(assets - idle);
+
+            // The strategy may return slightly more than asked (it over-unwinds to absorb swap
+            // slippage). Any surplus stays idle and accrues to remaining shareholders.
+            uint256 available = idleAssets();
+            if (available < assets) revert InsufficientLiquidity(assets, available);
+        }
+        super._withdraw(caller, receiver, owner_, assets, shares);
+    }
+
+    // ---------------------------------------------------------------------
+    // Keeper operations
+    // ---------------------------------------------------------------------
+
+    /// @notice Push all idle USDC above the buffer into the strategy.
+    /// @return deployed Amount handed to the strategy.
+    function allocate() external onlyKeeper nonReentrant whenNotPaused returns (uint256 deployed) {
+        uint256 idle = idleAssets();
+        uint256 target = Math.mulDiv(totalAssets(), bufferBps, MAX_BPS);
+        if (idle <= target) return 0;
+        deployed = _allocate(idle - target);
+    }
+
+    /// @notice Push exactly `amount` of idle USDC into the strategy.
+    /// @dev Lets a keeper split a large deployment across several transactions. The strategy
+    ///      enforces a fair-value bound on each one, so a single oversized deployment into a
+    ///      shallow pool reverts rather than silently eating the price impact; splitting is the
+    ///      intended response.
+    function allocateAmount(uint256 amount) external onlyKeeper nonReentrant whenNotPaused returns (uint256) {
+        uint256 idle = idleAssets();
+        if (amount > idle) revert InsufficientLiquidity(amount, idle);
+        return _allocate(amount);
+    }
+
+    function _allocate(uint256 amount) internal returns (uint256) {
+        IStrategy s = strategy;
+        if (address(s) == address(0)) revert NoStrategy();
+        if (amount == 0) return 0;
+
+        IERC20(asset()).safeTransfer(address(s), amount);
+        s.deposit(amount);
+        emit Allocated(amount);
+        return amount;
+    }
+
+    /// @notice Pull `amount` of USDC back from the strategy into the idle buffer.
+    /// @dev Used to pre-fund a large expected withdrawal, or to de-risk ahead of a migration.
+    function deallocate(uint256 amount) external onlyKeeper nonReentrant returns (uint256 recovered) {
+        IStrategy s = strategy;
+        if (address(s) == address(0)) revert NoStrategy();
+        recovered = s.withdraw(amount);
+        emit Deallocated(recovered);
+    }
+
+    // ---------------------------------------------------------------------
+    // Governance
+    // ---------------------------------------------------------------------
+
+    /// @notice Point the vault at a new strategy, fully unwinding the previous one first.
+    /// @dev Passing address(0) parks the vault entirely in idle USDC.
+    function setStrategy(IStrategy newStrategy) external onlyOwner nonReentrant {
+        IStrategy old = strategy;
+        if (address(old) != address(0)) old.withdrawAll();
+
+        if (address(newStrategy) != address(0)) {
+            if (newStrategy.asset() != asset()) revert StrategyAssetMismatch(asset(), newStrategy.asset());
+            if (newStrategy.vault() != address(this)) revert StrategyVaultMismatch(address(this), newStrategy.vault());
+        }
+
+        strategy = newStrategy;
+        emit StrategyUpdated(address(old), address(newStrategy));
+    }
+
+    function setKeeper(address keeper, bool allowed) external onlyOwner {
+        if (keeper == address(0)) revert ZeroAddress();
+        isKeeper[keeper] = allowed;
+        emit KeeperUpdated(keeper, allowed);
+    }
+
+    function setBufferBps(uint256 newBufferBps) external onlyOwner {
+        if (newBufferBps > MAX_BPS) revert InvalidBps(newBufferBps);
+        bufferBps = newBufferBps;
+        emit BufferUpdated(newBufferBps);
+    }
+
+    function setDepositCap(uint256 newCap) external onlyOwner {
+        depositCap = newCap;
+        emit DepositCapUpdated(newCap);
+    }
+
+    /// @notice Block new deposits. Withdrawals stay open by design.
+    function pause() external onlyOwner {
+        _pause();
+    }
+
+    function unpause() external onlyOwner {
+        _unpause();
+    }
+}
