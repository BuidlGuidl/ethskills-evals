--- /dev/null
+++ b/test/mocks/MockGauge.sol
@@ -0,0 +1,83 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.28;
+
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+import {Math} from "@openzeppelin/contracts/utils/math/Math.sol";
+
+import {IAerodromeGauge} from "../../src/interfaces/IAerodromeGauge.sol";
+import {MockERC20} from "./MockERC20.sol";
+
+/// @notice Synthetix-style staking gauge streaming a reward token at a fixed rate per second.
+/// @dev Mirrors Aerodrome's gauge surface: staked LPs earn emissions; trading fees are not
+///      credited to stakers (they go to voters on the real system), so none are simulated here.
+contract MockGauge is IAerodromeGauge {
+    using SafeERC20 for IERC20;
+
+    address public immutable override stakingToken;
+    address public immutable override rewardToken;
+
+    uint256 public rewardRate; // reward token wei per second, across all stakers
+    uint256 public totalSupply;
+    uint256 public rewardPerTokenStored;
+    uint256 public lastUpdate;
+
+    mapping(address => uint256) public override balanceOf;
+    mapping(address => uint256) public userRewardPerTokenPaid;
+    mapping(address => uint256) public rewards;
+
+    constructor(address stakingToken_, address rewardToken_, uint256 rewardRate_) {
+        stakingToken = stakingToken_;
+        rewardToken = rewardToken_;
+        rewardRate = rewardRate_;
+        lastUpdate = block.timestamp;
+    }
+
+    function setRewardRate(uint256 r) external {
+        _update(address(0));
+        rewardRate = r;
+    }
+
+    function rewardPerToken() public view returns (uint256) {
+        if (totalSupply == 0) return rewardPerTokenStored;
+        return rewardPerTokenStored + Math.mulDiv(block.timestamp - lastUpdate, rewardRate * 1e18, totalSupply);
+    }
+
+    function earned(address account) public view override returns (uint256) {
+        return
+            rewards[account] + Math.mulDiv(balanceOf[account], rewardPerToken() - userRewardPerTokenPaid[account], 1e18);
+    }
+
+    function _update(address account) internal {
+        rewardPerTokenStored = rewardPerToken();
+        lastUpdate = block.timestamp;
+        if (account != address(0)) {
+            rewards[account] = earned(account);
+            userRewardPerTokenPaid[account] = rewardPerTokenStored;
+        }
+    }
+
+    function deposit(uint256 amount) external override {
+        _update(msg.sender);
+        IERC20(stakingToken).safeTransferFrom(msg.sender, address(this), amount);
+        balanceOf[msg.sender] += amount;
+        totalSupply += amount;
+    }
+
+    function withdraw(uint256 amount) external override {
+        _update(msg.sender);
+        balanceOf[msg.sender] -= amount;
+        totalSupply -= amount;
+        IERC20(stakingToken).safeTransfer(msg.sender, amount);
+    }
+
+    function getReward(address account) external override {
+        _update(account);
+        uint256 amount = rewards[account];
+        if (amount > 0) {
+            rewards[account] = 0;
+            // The live gauge is pre-funded by the Minter; minting here keeps the stub self-contained.
+            MockERC20(rewardToken).mint(account, amount);
+        }
+    }
+}
diff --git a/test/mocks/MockStrategy.sol b/test/mocks/MockStrategy.sol
new file mode 100644
index 0000000..a258d84
--- /dev/null
+++ b/test/mocks/MockStrategy.sol
@@ -0,0 +1,44 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.28;
+
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+import {IStrategy} from "../../src/interfaces/IStrategy.sol";
+
+/// @notice Pass-through strategy used to exercise the vault's handling of a misbehaving strategy.
+contract MockStrategy is IStrategy {
+    using SafeERC20 for IERC20;
+
+    address public immutable override asset;
+    address public immutable override vault;
+
+    /// @notice Fraction (bps) of a withdrawal request the strategy actually delivers.
+    uint256 public deliveryBps = 10_000;
+
+    constructor(address asset_, address vault_) {
+        asset = asset_;
+        vault = vault_;
+    }
+
+    function setDeliveryBps(uint256 bps) external {
+        deliveryBps = bps;
+    }
+
+    function totalAssets() external view override returns (uint256) {
+        return IERC20(asset).balanceOf(address(this));
+    }
+
+    function deposit(uint256) external override {}
+
+    function withdraw(uint256 amount) external override returns (uint256 sent) {
+        sent = (amount * deliveryBps) / 10_000;
+        uint256 bal = IERC20(asset).balanceOf(address(this));
+        if (sent > bal) sent = bal;
+        IERC20(asset).safeTransfer(vault, sent);
+    }
+
+    function withdrawAll() external override returns (uint256 sent) {
+        sent = IERC20(asset).balanceOf(address(this));
+        if (sent > 0) IERC20(asset).safeTransfer(vault, sent);
+    }
+}
diff --git a/test/unit/Base.t.sol b/test/unit/Base.t.sol
new file mode 100644
index 0000000..3deca68
--- /dev/null
+++ b/test/unit/Base.t.sol
@@ -0,0 +1,207 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.28;
+
+import {Test} from "forge-std/Test.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {Math} from "@openzeppelin/contracts/utils/math/Math.sol";
+
+import {YieldVault} from "../../src/YieldVault.sol";
+import {AerodromeUsdcWethStrategy} from "../../src/strategies/AerodromeUsdcWethStrategy.sol";
+import {IStrategy} from "../../src/interfaces/IStrategy.sol";
+
+import {MockERC20} from "../mocks/MockERC20.sol";
+import {MockAggregatorV3} from "../mocks/MockAggregatorV3.sol";
+import {MockAerodromePool} from "../mocks/MockAerodromePool.sol";
+import {MockAerodromeFactory} from "../mocks/MockAerodromeFactory.sol";
+import {MockAerodromeRouter} from "../mocks/MockAerodromeRouter.sol";
+import {MockGauge} from "../mocks/MockGauge.sol";
+
+/// @notice Shared fixture. Pool depths and oracle prices are taken from Base mainnet readings so
+///         price impact and fee drag in these tests are in the same ballpark as production.
+abstract contract BaseTest is Test {
+    // --- actors ---
+    address internal owner = makeAddr("owner");
+    address internal keeper = makeAddr("keeper");
+    address internal treasury = makeAddr("treasury");
+    address internal alice = makeAddr("alice");
+    address internal bob = makeAddr("bob");
+    address internal attacker = makeAddr("attacker");
+
+    // --- tokens ---
+    MockERC20 internal usdc;
+    MockERC20 internal weth;
+    MockERC20 internal aero;
+
+    // --- venue ---
+    MockAerodromeFactory internal factory;
+    MockAerodromeRouter internal router;
+    MockAerodromePool internal wethUsdcPool;
+    MockAerodromePool internal aeroUsdcPool;
+    MockGauge internal gauge;
+
+    // --- feeds (8 decimals, mirroring Base mainnet values) ---
+    MockAggregatorV3 internal ethFeed;
+    MockAggregatorV3 internal usdcFeed;
+    MockAggregatorV3 internal aeroFeed;
+
+    // --- system ---
+    YieldVault internal vault;
+    AerodromeUsdcWethStrategy internal strategy;
+
+    uint256 internal constant ETH_PRICE_E8 = 2355_69000000;
+    uint256 internal constant USDC_PRICE_E8 = 99_993391;
+    uint256 internal constant AERO_PRICE_E8 = 48_670098;
+
+    // Live Base reserves for vAMM-WETH/USDC and vAMM-AERO/USDC at time of writing.
+    uint256 internal constant POOL_WETH = 1782e18;
+    uint256 internal constant POOL_USDC = 4_194_604e6;
+    uint256 internal constant POOL_AERO = 29_289_640e18;
+    uint256 internal constant POOL_AERO_USDC = 14_242_806e6;
+
+    uint256 internal constant AERO_PER_DAY = 100e18;
+
+    function setUp() public virtual {
+        vm.warp(1_700_000_000);
+
+        usdc = new MockERC20("USD Coin", "USDC", 6);
+        weth = new MockERC20("Wrapped Ether", "WETH", 18);
+        aero = new MockERC20("Aerodrome", "AERO", 18);
+
+        ethFeed = new MockAggregatorV3("ETH / USD", 8, int256(ETH_PRICE_E8));
+        usdcFeed = new MockAggregatorV3("USDC / USD", 8, int256(USDC_PRICE_E8));
+        aeroFeed = new MockAggregatorV3("AERO / USD", 8, int256(AERO_PRICE_E8));
+
+        factory = new MockAerodromeFactory();
+        router = new MockAerodromeRouter(factory);
+
+        wethUsdcPool = new MockAerodromePool(address(weth), address(usdc), false, 30);
+        aeroUsdcPool = new MockAerodromePool(address(aero), address(usdc), false, 30);
+        factory.register(address(weth), address(usdc), false, address(wethUsdcPool));
+        factory.register(address(aero), address(usdc), false, address(aeroUsdcPool));
+
+        _seedPool(wethUsdcPool, address(weth), POOL_WETH, address(usdc), POOL_USDC);
+        _seedPool(aeroUsdcPool, address(aero), POOL_AERO, address(usdc), POOL_AERO_USDC);
+
+        gauge = new MockGauge(address(wethUsdcPool), address(aero), AERO_PER_DAY / 1 days);
+
+        vault = new YieldVault(IERC20(address(usdc)), "Yield USDC", "yUSDC", owner, type(uint256).max);
+
+        strategy = new AerodromeUsdcWethStrategy(
+            AerodromeUsdcWethStrategy.Config({
+                vault: address(vault),
+                asset: address(usdc),
+                weth: address(weth),
+                router: address(router),
+                gauge: address(gauge),
+                usdcUsdFeed: address(usdcFeed),
+                ethUsdFeed: address(ethFeed),
+                aeroUsdFeed: address(aeroFeed),
+                owner: owner,
+                treasury: treasury
+            })
+        );
+
+        vm.startPrank(owner);
+        vault.setStrategy(IStrategy(address(strategy)));
+        vault.setKeeper(keeper, true);
+        strategy.setKeeper(keeper, true);
+        vm.stopPrank();
+
+        // Seed the vault so the first real depositor never faces an empty-vault share price.
+        _seedVault(1000e6);
+    }
+
+    function _seedPool(MockAerodromePool pool, address a, uint256 amtA, address b, uint256 amtB) internal {
+        MockERC20(a).mint(address(pool), amtA);
+        MockERC20(b).mint(address(pool), amtB);
+        pool.mint(address(0xdead));
+    }
+
+    /// @dev Dead-share seed: burns the initial shares so they can never be redeemed.
+    function _seedVault(uint256 amount) internal {
+        usdc.mint(address(this), amount);
+        usdc.approve(address(vault), amount);
+        vault.deposit(amount, address(0xdead));
+    }
+
+    /// @dev Advance time and re-stamp the Chainlink stubs. Live feeds keep publishing, so a test
+    ///      that warps without refreshing them would only be testing the staleness guard.
+    function _skip(uint256 duration) internal {
+        skip(duration);
+        ethFeed.setUpdatedAt(block.timestamp);
+        usdcFeed.setUpdatedAt(block.timestamp);
+        aeroFeed.setUpdatedAt(block.timestamp);
+    }
+
+    function _fund(address who, uint256 amount) internal {
+        usdc.mint(who, amount);
+        vm.prank(who);
+        usdc.approve(address(vault), type(uint256).max);
+    }
+
+    function _deposit(address who, uint256 amount) internal returns (uint256 shares) {
+        _fund(who, amount);
+        vm.prank(who);
+        shares = vault.deposit(amount, who);
+    }
+
+    function _allocate() internal returns (uint256) {
+        vm.prank(keeper);
+        return vault.allocate();
+    }
+
+    /// @dev Naive (manipulable) LP valuation, used only to prove the fair-value tests are meaningful.
+    function _naiveLpValueUsdc(uint256 lpAmount) internal view returns (uint256) {
+        (uint256 r0, uint256 r1,) = wethUsdcPool.getReserves();
+        (uint256 rWeth, uint256 rUsdc) = wethUsdcPool.token0() == address(weth) ? (r0, r1) : (r1, r0);
+        uint256 supply = wethUsdcPool.totalSupply();
+        uint256 wethShare = (rWeth * lpAmount) / supply;
+        uint256 usdcShare = (rUsdc * lpAmount) / supply;
+        return usdcShare + (wethShare * ETH_PRICE_E8) / 1e8 / 1e12;
+    }
+
+    /// @dev Push the WETH/USDC pool back to the oracle price, holding k constant.
+    ///      On a live pool arbitrageurs do this within seconds of any sizeable trade. Tests that
+    ///      allocate more than once must model it, otherwise each allocation buys WETH at the
+    ///      price the previous one moved it to and reports a loss that would not occur onchain.
+    function _arbPoolToOracle() internal {
+        (uint256 r0, uint256 r1,) = wethUsdcPool.getReserves();
+        bool wethIs0 = wethUsdcPool.token0() == address(weth);
+        (uint256 rWeth, uint256 rUsdc) = wethIs0 ? (r0, r1) : (r1, r0);
+
+        uint256 k = rWeth * rUsdc;
+        // Raw reserve ratio implied by the oracles: rUsdc/rWeth = (ethPrice/usdcPrice) * 1e6/1e18.
+        uint256 pNum = ETH_PRICE_E8 * 1e6;
+        uint256 pDen = USDC_PRICE_E8 * 1e18;
+
+        uint256 targetWeth = Math.sqrt(Math.mulDiv(k, pDen, pNum));
+        uint256 targetUsdc = Math.sqrt(Math.mulDiv(k, pNum, pDen));
+
+        _setPoolBalance(weth, targetWeth);
+        _setPoolBalance(usdc, targetUsdc);
+        wethUsdcPool.sync();
+    }
+
+    function _setPoolBalance(MockERC20 token, uint256 target) private {
+        uint256 current = token.balanceOf(address(wethUsdcPool));
+        if (target > current) token.mint(address(wethUsdcPool), target - current);
+        else if (current > target) token.burn(address(wethUsdcPool), current - target);
+    }
+
+    /// @dev Move the WETH/USDC pool price by trading `usdcIn` into it.
+    function _skewPoolWithUsdc(uint256 usdcIn) internal {
+        usdc.mint(attacker, usdcIn);
+        vm.startPrank(attacker);
+        usdc.approve(address(wethUsdcPool), usdcIn);
+        wethUsdcPool.simulateSwapIn(address(usdc), usdcIn, attacker);
+        vm.stopPrank();
+    }
+
+    function _skewPoolWithWeth(uint256 wethIn) internal {
+        weth.mint(attacker, wethIn);
+        vm.startPrank(attacker);
+        weth.approve(address(wethUsdcPool), wethIn);
+        wethUsdcPool.simulateSwapIn(address(weth), wethIn, attacker);
+        vm.stopPrank();
+    }
+}
diff --git a/test/unit/Fuzz.t.sol b/test/unit/Fuzz.t.sol
new file mode 100644
index 0000000..220ff45
--- /dev/null
+++ b/test/unit/Fuzz.t.sol
@@ -0,0 +1,99 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.28;
+
+import {BaseTest} from "./Base.t.sol";
+
+/// @notice Economic invariants: no path should let a user extract more value than they brought.
+contract FuzzTest is BaseTest {
+    function testFuzz_roundTripNeverProfits(uint256 amount) public {
+        amount = bound(amount, 100e6, 100_000e6);
+
+        uint256 shares = _deposit(alice, amount);
+        _allocate();
+
+        vm.prank(alice);
+        uint256 out = vault.redeem(shares, alice, alice);
+
+        assertLe(out, amount, "a deposit/withdraw round trip must never mint value");
+        assertGe(out, (amount * 97) / 100, "and must not cost more than AMM fees plus rounding");
+    }
+
+    function testFuzz_secondDepositorCannotDiluteFirst(uint256 a, uint256 b) public {
+        a = bound(a, 1_000e6, 60_000e6);
+        b = bound(b, 1_000e6, 60_000e6);
+
+        uint256 aliceShares = _deposit(alice, a);
+        _allocate();
+        _arbPoolToOracle();
+
+        uint256 aliceValueBefore = vault.convertToAssets(aliceShares);
+
+        _deposit(bob, b);
+        _allocate();
+
+        uint256 aliceValueAfter = vault.convertToAssets(aliceShares);
+        assertApproxEqRel(aliceValueAfter, aliceValueBefore, 0.01e18, "existing holders are not diluted");
+    }
+
+    function testFuzz_withdrawalDeliversExactlyWhatWasRequested(uint256 deposited, uint256 pct) public {
+        deposited = bound(deposited, 1_000e6, 100_000e6);
+        pct = bound(pct, 1, 90);
+
+        _deposit(alice, deposited);
+        _allocate();
+
+        uint256 want = (deposited * pct) / 100;
+        vm.prank(alice);
+        vault.withdraw(want, alice, alice);
+
+        assertEq(usdc.balanceOf(alice), want, "ERC-4626 withdraw must deliver the exact amount");
+    }
+
+    /// @dev The attack the fair-LP pricing exists to stop: skew the pool so the vault misprices
+    ///      its own position, deposit at the wrong share price, restore the pool, then exit.
+    function testFuzz_manipulateDepositRestore_neverProfits(uint256 skewAmount) public {
+        skewAmount = bound(skewAmount, 200_000e6, 1_500_000e6);
+
+        _deposit(alice, 100_000e6);
+        _allocate();
+
+        uint256 stake = 100_000e6;
+        usdc.mint(attacker, stake + skewAmount);
+        uint256 startBalance = usdc.balanceOf(attacker);
+
+        // 1. Skew the WETH/USDC pool.
+        vm.startPrank(attacker);
+        usdc.approve(address(wethUsdcPool), type(uint256).max);
+        uint256 wethOut = wethUsdcPool.simulateSwapIn(address(usdc), skewAmount, attacker);
+
+        // 2. Deposit while the vault's position is (supposedly) mispriced.
+        usdc.approve(address(vault), type(uint256).max);
+        uint256 shares = vault.deposit(stake, attacker);
+
+        // 3. Restore the pool by trading back.
+        weth.approve(address(wethUsdcPool), type(uint256).max);
+        wethUsdcPool.simulateSwapIn(address(weth), wethOut, attacker);
+
+        // 4. Exit.
+        vault.redeem(shares, attacker, attacker);
+        vm.stopPrank();
+
+        uint256 endBalance = usdc.balanceOf(attacker);
+        assertLe(endBalance, startBalance, "manipulation round trip must not be profitable");
+    }
+
+    function testFuzz_harvestNeverReducesShareValue(uint256 elapsed) public {
+        elapsed = bound(elapsed, 1 days, 120 days);
+
+        uint256 shares = _deposit(alice, 50_000e6);
+        _allocate();
+
+        uint256 before = vault.convertToAssets(shares);
+        _skip(elapsed);
+
+        vm.prank(keeper);
+        strategy.harvest();
+
+        assertGe(vault.convertToAssets(shares), before, "compounding must not lose value");
+    }
+}
diff --git a/test/unit/Strategy.t.sol b/test/unit/Strategy.t.sol
new file mode 100644
index 0000000..77ec5c2
--- /dev/null
+++ b/test/unit/Strategy.t.sol
@@ -0,0 +1,400 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.28;
+
+import {BaseTest} from "./Base.t.sol";
+import {AerodromeUsdcWethStrategy} from "../../src/strategies/AerodromeUsdcWethStrategy.sol";
+import {OracleLib} from "../../src/libraries/OracleLib.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {Ownable} from "@openzeppelin/contracts/access/Ownable.sol";
+
+contract StrategyTest is BaseTest {
+    // ------------------------------------------------------------ investing
+
+    function test_deposit_stakesLpInGauge() public {
+        _deposit(alice, 50_000e6);
+        _allocate();
+
+        assertGt(gauge.balanceOf(address(strategy)), 0, "LP is staked, not left loose");
+        assertEq(wethUsdcPool.balanceOf(address(strategy)), 0, "no unstaked LP left behind");
+        assertEq(usdc.allowance(address(strategy), address(router)), 0, "approvals are reset");
+        assertEq(weth.allowance(address(strategy), address(router)), 0);
+    }
+
+    function test_totalAssets_tracksDeployedValue() public {
+        _deposit(alice, 50_000e6);
+        uint256 before = vault.totalAssets();
+        _allocate();
+
+        // Deploying costs the AMM fee on the half that is swapped; nothing else should be lost.
+        assertApproxEqRel(vault.totalAssets(), before, 0.005e18, "value preserved to within 0.5%");
+    }
+
+    function test_dustDepositsAreNotInvested() public {
+        // Threshold must clear the 1_000e6 seed already in the vault plus alice's deposit.
+        vm.prank(owner);
+        strategy.setThresholds(5_000e6, 1e18);
+
+        _deposit(alice, 500e6);
+        _allocate();
+
+        assertEq(strategy.lpBalance(), 0, "below minInvestAmount, capital stays idle");
+        assertGt(usdc.balanceOf(address(strategy)), 0);
+    }
+
+    /// @dev An allocation large enough to move the pool meaningfully is rejected rather than
+    ///      silently absorbed. Splitting it across calls (with arbitrage restoring the price in
+    ///      between, as happens onchain) succeeds. This is the keeper's sizing constraint.
+    function test_oversizedAllocationRevertsAndSplittingSucceeds() public {
+        _deposit(alice, 400_000e6);
+
+        vm.prank(keeper);
+        vm.expectRevert(); // SlippageExceeded: one shot would eat >1% of value
+        vault.allocate();
+
+        for (uint256 i; i < 5; ++i) {
+            vm.prank(keeper);
+            vault.allocateAmount(76_000e6);
+            _arbPoolToOracle();
+        }
+
+        assertGt(strategy.lpBalance(), 0);
+        assertApproxEqRel(vault.totalAssets(), 401_000e6, 0.01e18, "split deployment stays within 1%");
+    }
+
+    function test_allocateAmount_cannotExceedIdle() public {
+        _deposit(alice, 10_000e6);
+        vm.prank(keeper);
+        vm.expectRevert();
+        vault.allocateAmount(50_000e6);
+    }
+
+    // ------------------------------------------------------------ harvesting
+
+    function test_harvest_claimsSellsAndCompounds() public {
+        _deposit(alice, 50_000e6);
+        _allocate();
+
+        uint256 lpBefore = strategy.lpBalance();
+        _skip(7 days);
+
+        assertGt(gauge.earned(address(strategy)), 0, "emissions accrued");
+
+        vm.prank(keeper);
+        (uint256 usdcReceived, uint256 fee) = strategy.harvest();
+
+        assertGt(usdcReceived, 0, "AERO sold for USDC");
+        assertEq(fee, (usdcReceived * strategy.performanceFeeBps()) / 10_000);
+        assertEq(usdc.balanceOf(treasury), fee, "fee paid to treasury");
+        assertGt(strategy.lpBalance(), lpBefore, "net proceeds compounded back into the LP");
+        assertEq(gauge.earned(address(strategy)), 0, "rewards fully claimed");
+    }
+
+    function test_harvest_increasesSharePrice() public {
+        _deposit(alice, 50_000e6);
+        _allocate();
+
+        _skip(30 days);
+        uint256 psBefore = vault.convertToAssets(1e9);
+
+        vm.prank(keeper);
+        strategy.harvest();
+
+        // Pending rewards are already priced into totalAssets, so harvest only adds the
+        // difference between oracle value and realised sale proceeds, minus the fee.
+        assertApproxEqRel(vault.convertToAssets(1e9), psBefore, 0.02e18);
+        assertGt(vault.convertToAssets(1e9), 1e6, "yield accrued to shareholders over the period");
+    }
+
+    /// @dev Unharvested emissions must already be reflected in totalAssets, otherwise a bot could
+    ///      deposit in the block before harvest() and capture yield it never earned.
+    function test_pendingRewardsArePricedIn_soHarvestIsNotFrontRunnable() public {
+        _deposit(alice, 50_000e6);
+        _allocate();
+        _skip(30 days);
+
+        uint256 psBeforeDeposit = vault.convertToAssets(1e9);
+        uint256 bobShares = _deposit(bob, 50_000e6);
+
+        vm.prank(keeper);
+        strategy.harvest();
+
+        uint256 bobValue = vault.convertToAssets(bobShares);
+        assertLe(bobValue, 50_000e6 + 10e6, "late depositor captures no meaningful accrued yield");
+        assertGt(psBeforeDeposit, 1e6);
+    }
+
+    function test_harvestableInAsset_reportsPendingValue() public {
+        _deposit(alice, 50_000e6);
+        _allocate();
+        assertEq(strategy.harvestableInAsset(), 0, "nothing pending yet");
+
+        _skip(30 days);
+        uint256 quoted = strategy.harvestableInAsset();
+        assertGt(quoted, 0);
+
+        vm.prank(keeper);
+        (uint256 received,) = strategy.harvest();
+        assertApproxEqRel(received, quoted, 0.02e18, "quote tracks what a harvest actually realises");
+    }
+
+    function test_harvest_onlyKeeper() public {
+        _deposit(alice, 50_000e6);
+        _allocate();
+        _skip(7 days);
+
+        vm.expectRevert(abi.encodeWithSelector(AerodromeUsdcWethStrategy.NotKeeper.selector, alice));
+        vm.prank(alice);
+        strategy.harvest();
+    }
+
+    function test_harvest_belowThresholdIsNoOp() public {
+        vm.prank(owner);
+        strategy.setThresholds(10e6, 100e18); // require 100 AERO before selling
+
+        _deposit(alice, 50_000e6);
+        _allocate();
+        _skip(1 hours); // ~4 AERO accrued, well under the threshold
+
+        vm.prank(keeper);
+        (uint256 usdcReceived,) = strategy.harvest();
+        assertEq(usdcReceived, 0, "sub-threshold rewards are left to accumulate");
+        assertGt(IERC20(address(aero)).balanceOf(address(strategy)), 0, "claimed AERO is retained");
+    }
+
+    // -------------------------------------------------- manipulation resistance
+
+    /// @dev The core safety property. An attacker skews the pool's reserve ratio hard; because LP
+    ///      value is derived from the swap-invariant k rather than the reserve split, the vault's
+    ///      reported totalAssets barely moves. The naive valuation is shown moving a lot, so this
+    ///      test would fail against a reserve-ratio implementation.
+    function test_totalAssets_isResistantToReserveManipulation() public {
+        _deposit(alice, 50_000e6);
+        _allocate();
+
+        uint256 lp = strategy.lpBalance();
+        uint256 fairBefore = vault.totalAssets();
+        uint256 naiveBefore = _naiveLpValueUsdc(lp);
+
+        _skewPoolWithUsdc(1_500_000e6); // ~36% of the pool's USDC reserve
+
+        uint256 fairAfter = vault.totalAssets();
+        uint256 naiveAfter = _naiveLpValueUsdc(lp);
+
+        assertApproxEqRel(fairAfter, fairBefore, 0.005e18, "fair valuation is unmoved by the skew");
+
+        uint256 naiveDrift = naiveAfter > naiveBefore
+            ? ((naiveAfter - naiveBefore) * 10_000) / naiveBefore
+            : ((naiveBefore - naiveAfter) * 10_000) / naiveBefore;
+        assertGt(naiveDrift, 300, "sanity: a naive reserve-ratio valuation would have moved >3%");
+    }
+
+    function test_totalAssets_resistantToReserveManipulationInBothDirections() public {
+        _deposit(alice, 50_000e6);
+        _allocate();
+
+        uint256 fairBefore = vault.totalAssets();
+        _skewPoolWithWeth(600e18); // ~34% of the WETH reserve, the other direction
+        assertApproxEqRel(vault.totalAssets(), fairBefore, 0.005e18);
+    }
+
+    /// @dev A sandwich around a keeper harvest must not be able to drain value: the oracle-derived
+    ///      minOut makes the swap revert rather than execute at the manipulated price.
+    function test_sandwichedHarvestReverts() public {
+        _deposit(alice, 50_000e6);
+        _allocate();
+        _skip(60 days);
+
+        // Attacker front-runs by dumping AERO to crater the AERO/USDC pool price.
+        aero.mint(attacker, 8_000_000e18);
+        vm.startPrank(attacker);
+        aero.approve(address(aeroUsdcPool), type(uint256).max);
+        aeroUsdcPool.simulateSwapIn(address(aero), 8_000_000e18, attacker);
+        vm.stopPrank();
+
+        vm.prank(keeper);
+        vm.expectRevert(); // router InsufficientOutput against the oracle-derived minOut
+        strategy.harvest();
+    }
+
+    // ------------------------------------------------------------ oracle safety
+
+    function test_staleEthFeedBlocksValuation() public {
+        _deposit(alice, 50_000e6);
+        _allocate();
+
+        ethFeed.setUpdatedAt(block.timestamp - (strategy.ethFeedMaxAge() + 1));
+
+        vm.expectRevert(
+            abi.encodeWithSelector(
+                OracleLib.StalePrice.selector,
+                address(ethFeed),
+                block.timestamp - (strategy.ethFeedMaxAge() + 1),
+                strategy.ethFeedMaxAge()
+            )
+        );
+        vault.totalAssets();
+    }
+
+    function test_negativeOraclePriceBlocksValuation() public {
+        _deposit(alice, 50_000e6);
+        _allocate();
+
+        ethFeed.setAnswer(-1);
+        vm.expectRevert(abi.encodeWithSelector(OracleLib.InvalidPrice.selector, address(ethFeed), int256(-1)));
+        vault.totalAssets();
+    }
+
+    function test_incompleteRoundBlocksValuation() public {
+        _deposit(alice, 50_000e6);
+        _allocate();
+
+        ethFeed.setAnsweredInRound(0);
+        vm.expectRevert(abi.encodeWithSelector(OracleLib.IncompleteRound.selector, address(ethFeed)));
+        vault.totalAssets();
+    }
+
+    function test_staleFeedBlocksDepositsAndWithdrawals() public {
+        _deposit(alice, 50_000e6);
+        _allocate();
+
+        usdcFeed.setUpdatedAt(block.timestamp - 200_000);
+
+        _fund(bob, 1_000e6);
+        vm.expectRevert();
+        vm.prank(bob);
+        vault.deposit(1_000e6, bob);
+
+        vm.expectRevert();
+        vm.prank(alice);
+        vault.withdraw(10_000e6, alice, alice);
+    }
+
+    // ------------------------------------------------------------ withdrawals
+
+    function test_partialWithdrawDeliversExactAmount() public {
+        _deposit(alice, 50_000e6);
+        _allocate();
+
+        vm.prank(alice);
+        vault.withdraw(20_000e6, alice, alice);
+        assertEq(usdc.balanceOf(alice), 20_000e6);
+    }
+
+    function test_repeatedWithdrawalsDrainCleanly() public {
+        _deposit(alice, 50_000e6);
+        _allocate();
+
+        for (uint256 i; i < 5; ++i) {
+            vm.prank(alice);
+            vault.withdraw(8_000e6, alice, alice);
+        }
+        assertEq(usdc.balanceOf(alice), 40_000e6);
+        assertGt(vault.balanceOf(alice), 0);
+    }
+
+    function test_withdrawAll_onlyVault() public {
+        vm.expectRevert(abi.encodeWithSelector(AerodromeUsdcWethStrategy.NotVault.selector, alice));
+        vm.prank(alice);
+        strategy.withdrawAll();
+    }
+
+    function test_deposit_onlyVault() public {
+        vm.expectRevert(abi.encodeWithSelector(AerodromeUsdcWethStrategy.NotVault.selector, alice));
+        vm.prank(alice);
+        strategy.deposit(1e6);
+    }
+
+    // ------------------------------------------------------------ emergency
+
+    function test_panic_unwindsEverythingToUsdc() public {
+        _deposit(alice, 50_000e6);
+        _allocate();
+        _skip(7 days);
+
+        vm.prank(owner);
+        strategy.panic();
+
+        assertEq(strategy.lpBalance(), 0, "position closed");
+        assertTrue(strategy.emergencyExit());
+        assertGt(usdc.balanceOf(address(strategy)), 0, "held as USDC");
+
+        // Users can still exit after a panic.
+        uint256 aliceShares = vault.balanceOf(alice);
+        vm.prank(alice);
+        uint256 out = vault.redeem(aliceShares, alice, alice);
+        assertGt(out, 49_000e6);
+    }
+
+    function test_emergencyExitBlocksRedeployment() public {
+        _deposit(alice, 50_000e6);
+        vm.prank(owner);
+        strategy.setEmergencyExit(true);
+
+        vm.expectRevert(AerodromeUsdcWethStrategy.EmergencyExitActive.selector);
+        _allocate();
+    }
+
+    function test_rescue_cannotTakeManagedTokens() public {
+        vm.startPrank(owner);
+        vm.expectRevert(abi.encodeWithSelector(AerodromeUsdcWethStrategy.CannotRescue.selector, address(usdc)));
+        strategy.rescue(address(usdc), owner);
+        vm.expectRevert(abi.encodeWithSelector(AerodromeUsdcWethStrategy.CannotRescue.selector, address(weth)));
+        strategy.rescue(address(weth), owner);
+        vm.expectRevert(abi.encodeWithSelector(AerodromeUsdcWethStrategy.CannotRescue.selector, address(aero)));
+        strategy.rescue(address(aero), owner);
+        vm.expectRevert(abi.encodeWithSelector(AerodromeUsdcWethStrategy.CannotRescue.selector, address(wethUsdcPool)));
+        strategy.rescue(address(wethUsdcPool), owner);
+        vm.stopPrank();
+    }
+
+    function test_rescue_recoversStrandedToken() public {
+        MockStrandedToken stray = new MockStrandedToken();
+        stray.mint(address(strategy), 5e18);
+
+        vm.prank(owner);
+        strategy.rescue(address(stray), owner);
+        assertEq(stray.balanceOf(owner), 5e18);
+    }
+
+    // ------------------------------------------------------------ governance
+
+    function test_setSlippage_bounds() public {
+        vm.startPrank(owner);
+        vm.expectRevert(abi.encodeWithSelector(AerodromeUsdcWethStrategy.InvalidBps.selector, 501));
+        strategy.setSlippage(501, 600);
+
+        vm.expectRevert(abi.encodeWithSelector(AerodromeUsdcWethStrategy.InvalidBps.selector, 50));
+        strategy.setSlippage(100, 50); // swap bound below the end-to-end bound
+
+        strategy.setSlippage(200, 400);
+        vm.stopPrank();
+
+        assertEq(strategy.maxSlippageBps(), 200);
+        assertEq(strategy.maxSwapSlippageBps(), 400);
+    }
+
+    function test_setPerformanceFee_capped() public {
+        vm.prank(owner);
+        vm.expectRevert(abi.encodeWithSelector(AerodromeUsdcWethStrategy.InvalidBps.selector, 2001));
+        strategy.setPerformanceFee(2001, treasury);
+    }
+
+    function test_governanceIsOwnerOnly() public {
+        vm.startPrank(alice);
+        vm.expectRevert(abi.encodeWithSelector(Ownable.OwnableUnauthorizedAccount.selector, alice));
+        strategy.setSlippage(200, 400);
+        vm.expectRevert(abi.encodeWithSelector(Ownable.OwnableUnauthorizedAccount.selector, alice));
+        strategy.panic();
+        vm.stopPrank();
+    }
+}
+
+import {ERC20} from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+
+contract MockStrandedToken is ERC20 {
+    constructor() ERC20("Stray", "STRAY") {}
+
+    function mint(address to, uint256 amount) external {
+        _mint(to, amount);
+    }
+}
