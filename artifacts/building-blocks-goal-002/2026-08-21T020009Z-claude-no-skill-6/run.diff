+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.28;
+
+import {Script, console2} from "forge-std/Script.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+
+import {YieldVault} from "../src/YieldVault.sol";
+import {AerodromeUsdcWethStrategy} from "../src/strategies/AerodromeUsdcWethStrategy.sol";
+import {IStrategy} from "../src/interfaces/IStrategy.sol";
+import {BaseAddresses} from "../src/BaseAddresses.sol";
+
+/// @notice Deploys the vault + strategy to Base and wires them together.
+/// @dev Run with:
+///      forge script script/Deploy.s.sol:Deploy --rpc-url base --broadcast --verify
+contract Deploy is Script {
+    /// @dev Seed deposit burned to address(0xdead) so the vault is never empty. Belt-and-braces
+    ///      alongside the virtual-share offset against first-depositor share-price games.
+    uint256 internal constant SEED_AMOUNT = 10e6; // 10 USDC
+
+    function run() external {
+        address owner = vm.envAddress("VAULT_OWNER");
+        address keeper = vm.envAddress("VAULT_KEEPER");
+        address treasury = vm.envAddress("VAULT_TREASURY");
+        uint256 depositCap = vm.envOr("VAULT_DEPOSIT_CAP", uint256(250_000e6));
+
+        require(block.chainid == BaseAddresses.CHAIN_ID, "Deploy: not Base");
+
+        uint256 pk = vm.envUint("PRIVATE_KEY");
+        address deployer = vm.addr(pk);
+
+        vm.startBroadcast(pk);
+
+        // Deploy with the deployer as owner so it can wire everything up, then hand over.
+        YieldVault vault = new YieldVault(
+            IERC20(BaseAddresses.USDC), "Aerodrome USDC Yield Vault", "yvUSDC-AERO", deployer, depositCap
+        );
+
+        AerodromeUsdcWethStrategy strategy = new AerodromeUsdcWethStrategy(
+            AerodromeUsdcWethStrategy.Config({
+                vault: address(vault),
+                asset: BaseAddresses.USDC,
+                weth: BaseAddresses.WETH,
+                router: BaseAddresses.AERODROME_ROUTER,
+                gauge: BaseAddresses.VAMM_WETH_USDC_GAUGE,
+                usdcUsdFeed: BaseAddresses.USDC_USD_FEED,
+                ethUsdFeed: BaseAddresses.ETH_USD_FEED,
+                aeroUsdFeed: BaseAddresses.AERO_USD_FEED,
+                owner: deployer,
+                treasury: treasury
+            })
+        );
+
+        vault.setStrategy(IStrategy(address(strategy)));
+        vault.setKeeper(keeper, true);
+        strategy.setKeeper(keeper, true);
+
+        // Seed, then burn the shares.
+        IERC20(BaseAddresses.USDC).approve(address(vault), SEED_AMOUNT);
+        vault.deposit(SEED_AMOUNT, address(0xdead));
+
+        // Hand ownership to the multisig. Ownable2Step: the new owner must call acceptOwnership().
+        vault.transferOwnership(owner);
+        strategy.transferOwnership(owner);
+
+        vm.stopBroadcast();
+
+        console2.log("YieldVault:", address(vault));
+        console2.log("Strategy:  ", address(strategy));
+        console2.log("Pool:      ", address(strategy.pool()));
+        console2.log("Gauge:     ", address(strategy.gauge()));
+        console2.log("");
+        console2.log("ACTION REQUIRED: %s must call acceptOwnership() on both contracts.", owner);
+    }
+}
