+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.28;
+
+/// @notice Interface the vault relies on. Any future strategy must implement it.
+interface IStrategy {
+    /// @notice Underlying asset accounted by the strategy (USDC).
+    function asset() external view returns (address);
+
+    /// @notice Vault allowed to deposit into / withdraw from this strategy.
+    function vault() external view returns (address);
+
+    /// @notice Manipulation resistant value of everything the strategy holds, denominated in `asset`.
+    function totalAssets() external view returns (uint256);
+
+    /// @notice Pull `amount` of `asset` back to the vault.
+    /// @return sent Amount actually transferred to the vault (can be less than `amount` on a shortfall).
+    function withdraw(uint256 amount) external returns (uint256 sent);
+}
