@@ -0,0 +1,563 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.28;
+
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+import {Ownable, Ownable2Step} from "@openzeppelin/contracts/access/Ownable2Step.sol";
+import {Pausable} from "@openzeppelin/contracts/utils/Pausable.sol";
+import {Math} from "@openzeppelin/contracts/utils/math/Math.sol";
+
+import {IAerodromeRouter} from "./interfaces/IAerodromeRouter.sol";
+import {IAerodromePool} from "./interfaces/IAerodromePool.sol";
+import {IAerodromeGauge} from "./interfaces/IAerodromeGauge.sol";
+import {IPoolFactory} from "./interfaces/IPoolFactory.sol";
+import {IVoter} from "./interfaces/IVoter.sol";
+import {ICLSwapRouter, ICLFactory} from "./interfaces/ISlipstream.sol";
+import {IAggregatorV3} from "./interfaces/IAggregatorV3.sol";
+import {IStrategy} from "./interfaces/IStrategy.sol";
+import {IVault} from "./interfaces/IVault.sol";
+
+/// @title AerodromeUsdcWethStrategy
+/// @notice Turns the vault's USDC into a staked Aerodrome USDC/WETH LP position and compounds the
+///         AERO emissions back into it.
+///
+/// @dev Three external venues, each picked for one job (see README for the measurements):
+///      1. Aerodrome v2 volatile USDC/WETH pool + its gauge - the yield venue. The LP is a plain
+///         ERC20 and the position is full range, so there is nothing to rebalance and no NFT.
+///      2. Aerodrome Slipstream CL pool (tick spacing 100) - the swap venue. Zapping USDC into a
+///         50/50 position needs a swap, and executing it against concentrated liquidity is roughly
+///         an order of magnitude cheaper than against the v2 curve.
+///      3. Chainlink ETH/USD, USDC/USD and AERO/USD - the price source. Every value the vault
+///         reports and every swap floor comes from these feeds, never from the pool being traded.
+///
+///      Accounting rules the rest of the system relies on:
+///      - `totalAssets()` prices the LP with the fair reserves formula `2 * sqrt(k * p)`, where `p`
+///        comes from Chainlink. That number barely moves when the pool's spot price is pushed
+///        around, so a flash loan cannot move the vault's share price.
+///      - Unclaimed AERO is not counted. Profit is booked at harvest, so nobody can deposit right
+///        before a harvest to capture rewards earned by others.
+contract AerodromeUsdcWethStrategy is IStrategy, Ownable2Step, Pausable {
+    using SafeERC20 for IERC20;
+
+    uint256 public constant MAX_BPS = 10_000;
+    uint256 public constant MAX_PERFORMANCE_FEE_BPS = 2_000; // 20%
+    uint256 public constant MAX_SLIPPAGE_BPS = 500; // 5%
+    uint256 public constant MAX_VALUE_LOSS_BPS = 200; // 2%
+    uint8 internal constant FEED_DECIMALS = 8;
+
+    /// @param vault       Vault that owns the funds.
+    /// @param router      Aerodrome v2 Router (LP add/remove and the AERO sale).
+    /// @param voter       Aerodrome Voter, read once to prove the gauge is canonical and alive.
+    /// @param swapRouter  Slipstream SwapRouter used for the USDC <-> WETH legs.
+    /// @param clFactory   Slipstream CLFactory, used to resolve the CL pool.
+    /// @param tickSpacing Tick spacing of the CL pool to route through (100 for USDC/WETH on Base).
+    struct Config {
+        address vault;
+        address usdc;
+        address weth;
+        address aero;
+        address router;
+        address voter;
+        address swapRouter;
+        address clFactory;
+        int24 tickSpacing;
+        address ethUsdFeed;
+        address usdcUsdFeed;
+        address aeroUsdFeed;
+        address owner;
+        address keeper;
+        address treasury;
+    }
+
+    /* -------------------------------------------------------------------------- */
+    /*                                 immutables                                  */
+    /* -------------------------------------------------------------------------- */
+
+    address public immutable override vault;
+    IERC20 public immutable usdc; // vault asset
+    IERC20 public immutable weth;
+    IERC20 public immutable aero; // gauge reward token
+    IAerodromeRouter public immutable router;
+    IPoolFactory public immutable poolFactory;
+    IAerodromePool public immutable pool; // USDC/WETH volatile pool == LP token
+    IAerodromeGauge public immutable gauge;
+    ICLSwapRouter public immutable swapRouter;
+    address public immutable clPool; // Slipstream USDC/WETH pool the swaps are routed through
+    int24 public immutable tickSpacing;
+    IAggregatorV3 public immutable ethUsdFeed;
+    IAggregatorV3 public immutable usdcUsdFeed;
+    IAggregatorV3 public immutable aeroUsdFeed;
+    bool public immutable wethIsToken0;
+
+    /* -------------------------------------------------------------------------- */
+    /*                                  storage                                    */
+    /* -------------------------------------------------------------------------- */
+
+    address public keeper;
+    address public treasury;
+    /// @notice Cut of every harvest sent to `treasury`, in bps.
+    uint256 public performanceFeeBps = 1_000; // 10%
+    /// @notice How far below the oracle price a single swap may print, in bps.
+    uint256 public slippageBps = 100; // 1%
+    /// @notice How much value a deploy or an unwind may destroy end to end, in bps.
+    uint256 public maxValueLossBps = 50; // 0.50%
+    /// @notice Max gap tolerated between the LP pool's spot price and the oracle before depositing
+    ///         into it, in bps. Adding liquidity to a skewed pool donates value to arbitrageurs.
+    uint256 public maxPoolDeviationBps = 100; // 1%
+    /// @notice Idle USDC below this is left uninvested (a zap costs more than the dust earns).
+    uint256 public minDeploy = 10e6; // 10 USDC
+    /// @notice AERO balances below this are not sold.
+    uint256 public minRewardToSell = 1e18; // 1 AERO
+    /// @notice Max age accepted for each feed, in seconds. Defaults are set in the constructor.
+    uint256 public ethFeedMaxAge;
+    uint256 public usdcFeedMaxAge;
+    uint256 public aeroFeedMaxAge;
+
+    /* -------------------------------------------------------------------------- */
+    /*                                   events                                    */
+    /* -------------------------------------------------------------------------- */
+
+    event Deployed(uint256 usdcIn, uint256 lpMinted);
+    event Withdrawn(uint256 requested, uint256 sent, uint256 lpBurned);
+    event Harvested(uint256 aeroClaimed, uint256 usdcFromRewards, uint256 performanceFee);
+    event EmergencyExited(uint256 lpUnwound, uint256 usdcHeld);
+    event KeeperUpdated(address keeper);
+    event TreasuryUpdated(address treasury);
+    event PerformanceFeeUpdated(uint256 bps);
+    event RiskParamsUpdated(uint256 slippageBps, uint256 maxValueLossBps, uint256 maxPoolDeviationBps);
+    event ThresholdsUpdated(uint256 minDeploy, uint256 minRewardToSell);
+    event FeedMaxAgesUpdated(uint256 ethAge, uint256 usdcAge, uint256 aeroAge);
+
+    /* -------------------------------------------------------------------------- */
+    /*                                   errors                                    */
+    /* -------------------------------------------------------------------------- */
+
+    error NotVault();
+    error NotKeeper();
+    error ZeroAddress();
+    error InvalidParam();
+    error PoolNotFound();
+    error GaugeMismatch();
+    error GaugeNotAlive();
+    error BadFeed();
+    error StalePrice(address feed, uint256 updatedAt);
+    error ValueLoss(uint256 valueBefore, uint256 valueAfter);
+    error PoolPriceOffOracle(uint256 spot, uint256 oracle);
+    error ProtectedToken();
+
+    modifier onlyVault() {
+        if (msg.sender != vault) revert NotVault();
+        _;
+    }
+
+    modifier onlyKeeper() {
+        if (msg.sender != keeper && msg.sender != owner()) revert NotKeeper();
+        _;
+    }
+
+    constructor(Config memory c) Ownable(c.owner) {
+        if (
+            c.vault == address(0) || c.usdc == address(0) || c.weth == address(0) || c.aero == address(0)
+                || c.router == address(0) || c.voter == address(0) || c.swapRouter == address(0)
+                || c.clFactory == address(0) || c.keeper == address(0) || c.treasury == address(0)
+        ) revert ZeroAddress();
+
+        vault = c.vault;
+        usdc = IERC20(c.usdc);
+        weth = IERC20(c.weth);
+        aero = IERC20(c.aero);
+        router = IAerodromeRouter(c.router);
+        swapRouter = ICLSwapRouter(c.swapRouter);
+        tickSpacing = c.tickSpacing;
+        keeper = c.keeper;
+        treasury = c.treasury;
+
+        // --- yield venue: v2 volatile pool + its gauge -------------------------------------
+        IPoolFactory factory = IPoolFactory(IAerodromeRouter(c.router).defaultFactory());
+        poolFactory = factory;
+        address _pool = factory.getPool(c.usdc, c.weth, false);
+        if (_pool == address(0)) revert PoolNotFound();
+        pool = IAerodromePool(_pool);
+        wethIsToken0 = IAerodromePool(_pool).token0() == c.weth;
+
+        address _gauge = IVoter(c.voter).gauges(_pool);
+        if (_gauge == address(0) || !IVoter(c.voter).isGauge(_gauge)) revert GaugeMismatch();
+        if (IAerodromeGauge(_gauge).stakingToken() != _pool || IAerodromeGauge(_gauge).rewardToken() != c.aero) {
+            revert GaugeMismatch();
+        }
+        // A killed gauge keeps accepting deposits but stops paying emissions.
+        if (!IVoter(c.voter).isAlive(_gauge)) revert GaugeNotAlive();
+        gauge = IAerodromeGauge(_gauge);
+
+        // --- swap venue: Slipstream CL pool -------------------------------------------------
+        address _clPool = ICLFactory(c.clFactory).getPool(c.usdc, c.weth, c.tickSpacing);
+        if (_clPool == address(0)) revert PoolNotFound();
+        clPool = _clPool;
+
+        // --- price source: Chainlink --------------------------------------------------------
+        ethUsdFeed = IAggregatorV3(c.ethUsdFeed);
+        usdcUsdFeed = IAggregatorV3(c.usdcUsdFeed);
+        aeroUsdFeed = IAggregatorV3(c.aeroUsdFeed);
+        if (
+            IAggregatorV3(c.ethUsdFeed).decimals() != FEED_DECIMALS
+                || IAggregatorV3(c.usdcUsdFeed).decimals() != FEED_DECIMALS
+                || IAggregatorV3(c.aeroUsdFeed).decimals() != FEED_DECIMALS
+        ) revert BadFeed();
+        // ETH/USD on Base updates every few minutes; USDC/USD and AERO/USD are much lazier.
+        ethFeedMaxAge = 1 hours;
+        usdcFeedMaxAge = 26 hours;
+        aeroFeedMaxAge = 26 hours;
+    }
+
+    /* -------------------------------------------------------------------------- */
+    /*                                   pricing                                   */
+    /* -------------------------------------------------------------------------- */
+
+    /// @notice Oracle price of 1 WETH, expressed in USDC (6 decimals).
+    function usdcPerWeth() public view returns (uint256) {
+        uint256 ethUsd = _feedPrice(ethUsdFeed, ethFeedMaxAge);
+        uint256 usdcUsd = _feedPrice(usdcUsdFeed, usdcFeedMaxAge);
+        return Math.mulDiv(ethUsd, 1e6, usdcUsd);
+    }
+
+    /// @notice Oracle price of 1 AERO, expressed in USDC (6 decimals).
+    function usdcPerAero() public view returns (uint256) {
+        uint256 aeroUsd = _feedPrice(aeroUsdFeed, aeroFeedMaxAge);
+        uint256 usdcUsd = _feedPrice(usdcUsdFeed, usdcFeedMaxAge);
+        return Math.mulDiv(aeroUsd, 1e6, usdcUsd);
+    }
+
+    function _feedPrice(IAggregatorV3 feed, uint256 maxAge) internal view returns (uint256) {
+        (, int256 answer,, uint256 updatedAt,) = feed.latestRoundData();
+        if (answer <= 0) revert BadFeed();
+        // A future-dated round is as untrustworthy as a stale one; reject both explicitly.
+        if (updatedAt == 0 || updatedAt > block.timestamp || block.timestamp - updatedAt > maxAge) {
+            revert StalePrice(address(feed), updatedAt);
+        }
+        return uint256(answer);
+    }
+
+    /* -------------------------------------------------------------------------- */
+    /*                                 accounting                                  */
+    /* -------------------------------------------------------------------------- */
+
+    function asset() external view override returns (address) {
+        return address(usdc);
+    }
+
+    /// @inheritdoc IStrategy
+    function totalAssets() public view override returns (uint256) {
+        uint256 value = usdc.balanceOf(address(this));
+
+        uint256 wethBal = weth.balanceOf(address(this));
+        if (wethBal != 0) value += Math.mulDiv(wethBal, usdcPerWeth(), 1e18);
+
+        uint256 lp = lpBalance();
+        if (lp != 0) value += lpValue(lp);
+
+        return value;
+    }
+
+    /// @notice LP tokens held by the strategy, staked or not.
+    function lpBalance() public view returns (uint256) {
+        return gauge.balanceOf(address(this)) + pool.balanceOf(address(this));
+    }
+
+    /// @notice AERO claimable from the gauge plus anything already claimed but not yet sold.
+    /// @dev Deliberately excluded from `totalAssets()`; it is booked as profit at harvest.
+    function pendingRewards() external view returns (uint256) {
+        return gauge.earned(address(this)) + aero.balanceOf(address(this));
+    }
+
+    /// @notice USDC value of `lpAmount` LP tokens at the oracle price.
+    /// @dev Fair reserves: on `x * y = k`, the reserves an arbitrageur leaves behind at an external
+    ///      price `p` are `sqrt(k/p)` and `sqrt(k*p)`, so the pool as a whole is worth `2*sqrt(k*p)`
+    ///      in USDC. A swap cannot meaningfully change `k` (only accrued fees do), which is what
+    ///      makes this valuation flash-loan resistant - unlike `share of reserves * spot price`.
+    function lpValue(uint256 lpAmount) public view returns (uint256) {
+        uint256 supply = pool.totalSupply();
+        if (supply == 0 || lpAmount == 0) return 0;
+
+        (uint256 reserveWeth, uint256 reserveUsdc) = _reserves();
+        uint256 wethLegInUsdc = Math.mulDiv(reserveWeth, usdcPerWeth(), 1e18);
+        uint256 fairPoolValue = 2 * Math.sqrt(reserveUsdc * wethLegInUsdc);
+
+        return Math.mulDiv(fairPoolValue, lpAmount, supply);
+    }
+
+    function _reserves() internal view returns (uint256 reserveWeth, uint256 reserveUsdc) {
+        (uint256 r0, uint256 r1,) = pool.getReserves();
+        return wethIsToken0 ? (r0, r1) : (r1, r0);
+    }
+
+    /* -------------------------------------------------------------------------- */
+    /*                              vault entry points                             */
+    /* -------------------------------------------------------------------------- */
+
+    /// @notice Sweep the vault's idle USDC and zap everything into the staked LP position.
+    /// @dev Keeper driven, so a user deposit stays a plain ERC20 transfer and never pays for a zap.
+    function deployIdle() external onlyKeeper whenNotPaused {
+        IVault(vault).pushIdleToStrategy();
+        _deployIdle();
+    }
+
+    /// @inheritdoc IStrategy
+    /// @dev `amount == type(uint256).max` unwinds the whole position.
+    function withdraw(uint256 amount) external override onlyVault returns (uint256 sent) {
+        uint256 valueBefore = totalAssets();
+        uint256 lpBurned;
+
+        uint256 idle = usdc.balanceOf(address(this));
+        if (idle < amount) {
+            uint256 lp = lpBalance();
+            if (lp != 0) {
+                uint256 toBurn = lp;
+                if (amount != type(uint256).max) {
+                    uint256 value = lpValue(lp);
+                    if (value != 0) {
+                        // Burn a little more than the pro-rata share so swap costs do not leave the
+                        // withdrawal short; the excess simply stays as idle USDC in the strategy.
+                        toBurn = Math.mulDiv(amount - idle, lp, value);
+                        toBurn = Math.mulDiv(toBurn, MAX_BPS + slippageBps, MAX_BPS);
+                        if (toBurn > lp) toBurn = lp;
+                    }
+                }
+                _unwind(toBurn);
+                lpBurned = toBurn;
+            }
+            idle = usdc.balanceOf(address(this));
+        }
+
+        sent = amount > idle ? idle : amount;
+        if (sent != 0) usdc.safeTransfer(vault, sent);
+
+        _requireNoValueLoss(valueBefore, totalAssets() + sent);
+        emit Withdrawn(amount, sent, lpBurned);
+    }
+
+    /* -------------------------------------------------------------------------- */
+    /*                                   keeper                                    */
+    /* -------------------------------------------------------------------------- */
+
+    /// @notice Claim AERO emissions, sell them for USDC, take the performance fee, then compound the
+    ///         rest - together with any idle USDC in the vault - back into the position.
+    /// @param minUsdcOut Keeper supplied floor for the AERO sale. The contract enforces its own
+    ///        oracle floor on top, so a compromised keeper cannot pass 0 and sandwich the sale.
+    function harvest(uint256 minUsdcOut) external onlyKeeper whenNotPaused returns (uint256 usdcFromRewards) {
+        uint256 aeroBefore = aero.balanceOf(address(this));
+        gauge.getReward(address(this));
+        uint256 aeroBal = aero.balanceOf(address(this));
+        uint256 claimed = aeroBal - aeroBefore;
+
+        if (aeroBal >= minRewardToSell) {
+            uint256 usdcBefore = usdc.balanceOf(address(this));
+            uint256 floor = _applySlippage(Math.mulDiv(aeroBal, usdcPerAero(), 1e18));
+            _swapV2(address(aero), address(usdc), aeroBal, Math.max(minUsdcOut, floor));
+            usdcFromRewards = usdc.balanceOf(address(this)) - usdcBefore;
+        }
+
+        uint256 fee = Math.mulDiv(usdcFromRewards, performanceFeeBps, MAX_BPS);
+        if (fee != 0) usdc.safeTransfer(treasury, fee);
+
+        IVault(vault).pushIdleToStrategy();
+        _deployIdle();
+
+        emit Harvested(claimed, usdcFromRewards, fee);
+    }
+
+    /* -------------------------------------------------------------------------- */
+    /*                                  internals                                  */
+    /* -------------------------------------------------------------------------- */
+
+    function _deployIdle() internal {
+        uint256 idle = usdc.balanceOf(address(this));
+        if (idle < minDeploy) return;
+
+        _requirePoolNearOracle();
+
+        uint256 valueBefore = totalAssets();
+        uint256 lpBefore = lpBalance();
+
+        // Split the balance so that both legs match the pool's reserve ratio by value.
+        (uint256 reserveWeth, uint256 reserveUsdc) = _reserves();
+        uint256 price = usdcPerWeth();
+        uint256 wethLegInUsdc = Math.mulDiv(reserveWeth, price, 1e18);
+        uint256 held = idle + Math.mulDiv(weth.balanceOf(address(this)), price, 1e18);
+        uint256 targetUsdc = Math.mulDiv(held, reserveUsdc, reserveUsdc + wethLegInUsdc);
+
+        if (idle > targetUsdc) {
+            uint256 swapIn = idle - targetUsdc;
+            uint256 floor = _applySlippage(Math.mulDiv(swapIn, 1e18, price));
+            _swapCL(address(usdc), address(weth), swapIn, floor);
+        }
+
+        uint256 usdcBal = usdc.balanceOf(address(this));
+        uint256 wethBal = weth.balanceOf(address(this));
+        if (usdcBal != 0 && wethBal != 0) {
+            usdc.forceApprove(address(router), usdcBal);
+            weth.forceApprove(address(router), wethBal);
+            // Mins are 1 wei on purpose: the router pulls only the balanced amounts, the ratio is
+            // already checked against the oracle above, and the binding constraint is the
+            // end-to-end value check below.
+            router.addLiquidity(
+                address(usdc), address(weth), false, usdcBal, wethBal, 1, 1, address(this), block.timestamp
+            );
+            usdc.forceApprove(address(router), 0);
+            weth.forceApprove(address(router), 0);
+        }
+
+        uint256 lpBal = pool.balanceOf(address(this));
+        if (lpBal != 0) {
+            IERC20(address(pool)).forceApprove(address(gauge), lpBal);
+            gauge.deposit(lpBal);
+        }
+
+        _requireNoValueLoss(valueBefore, totalAssets());
+        emit Deployed(idle, lpBalance() - lpBefore);
+    }
+
+    /// @notice Unstake `lpAmount`, pull both tokens out of the pool and turn the WETH leg into USDC.
+    function _unwind(uint256 lpAmount) internal {
+        uint256 staked = gauge.balanceOf(address(this));
+        uint256 fromGauge = lpAmount > staked ? staked : lpAmount;
+        if (fromGauge != 0) gauge.withdraw(fromGauge);
+
+        uint256 lpBal = pool.balanceOf(address(this));
+        if (lpBal > lpAmount) lpBal = lpAmount;
+        if (lpBal == 0) return;
+
+        IERC20(address(pool)).forceApprove(address(router), lpBal);
+        // Removing liquidity is pro rata, so a skewed pool can only hand out *more* value than the
+        // fair mark; no oracle check is needed here, and the WETH leg is sold under one below.
+        router.removeLiquidity(address(usdc), address(weth), false, lpBal, 1, 1, address(this), block.timestamp);
+
+        uint256 wethBal = weth.balanceOf(address(this));
+        if (wethBal != 0) {
+            uint256 floor = _applySlippage(Math.mulDiv(wethBal, usdcPerWeth(), 1e18));
+            _swapCL(address(weth), address(usdc), wethBal, floor);
+        }
+    }
+
+    /// @notice Swap through the Slipstream concentrated liquidity pool.
+    function _swapCL(address tokenIn, address tokenOut, uint256 amountIn, uint256 minOut) internal {
+        IERC20(tokenIn).forceApprove(address(swapRouter), amountIn);
+        swapRouter.exactInputSingle(
+            ICLSwapRouter.ExactInputSingleParams({
+                tokenIn: tokenIn,
+                tokenOut: tokenOut,
+                tickSpacing: tickSpacing,
+                recipient: address(this),
+                deadline: block.timestamp,
+                amountIn: amountIn,
+                amountOutMinimum: minOut,
+                sqrtPriceLimitX96: 0
+            })
+        );
+        IERC20(tokenIn).forceApprove(address(swapRouter), 0);
+    }
+
+    /// @notice Swap through a single Aerodrome v2 volatile pool (used for the AERO sale).
+    function _swapV2(address tokenIn, address tokenOut, uint256 amountIn, uint256 minOut) internal {
+        IAerodromeRouter.Route[] memory routes = new IAerodromeRouter.Route[](1);
+        routes[0] = IAerodromeRouter.Route({from: tokenIn, to: tokenOut, stable: false, factory: address(poolFactory)});
+        IERC20(tokenIn).forceApprove(address(router), amountIn);
+        router.swapExactTokensForTokens(amountIn, minOut, routes, address(this), block.timestamp);
+        IERC20(tokenIn).forceApprove(address(router), 0);
+    }
+
+    function _applySlippage(uint256 amount) internal view returns (uint256) {
+        return Math.mulDiv(amount, MAX_BPS - slippageBps, MAX_BPS);
+    }
+
+    function _requireNoValueLoss(uint256 valueBefore, uint256 valueAfter) internal view {
+        uint256 floor = Math.mulDiv(valueBefore, MAX_BPS - maxValueLossBps, MAX_BPS);
+        if (valueAfter < floor) revert ValueLoss(valueBefore, valueAfter);
+    }
+
+    /// @notice Refuse to add liquidity while the LP pool's spot price is far from the oracle.
+    function _requirePoolNearOracle() internal view {
+        (uint256 reserveWeth, uint256 reserveUsdc) = _reserves();
+        if (reserveWeth == 0 || reserveUsdc == 0) revert PoolNotFound();
+        uint256 spot = Math.mulDiv(reserveUsdc, 1e18, reserveWeth);
+        uint256 oracle = usdcPerWeth();
+        uint256 diff = spot > oracle ? spot - oracle : oracle - spot;
+        if (Math.mulDiv(diff, MAX_BPS, oracle) > maxPoolDeviationBps) {
+            revert PoolPriceOffOracle(spot, oracle);
+        }
+    }
+
+    /* -------------------------------------------------------------------------- */
+    /*                                    admin                                    */
+    /* -------------------------------------------------------------------------- */
+
+    /// @notice Unwind everything into USDC and stop new deployments.
+    /// @dev The USDC stays in the strategy; the vault pulls it with `withdraw()` as users exit.
+    function emergencyExit() external onlyOwner {
+        uint256 lp = lpBalance();
+        if (lp != 0) _unwind(lp);
+        _pause();
+        emit EmergencyExited(lp, usdc.balanceOf(address(this)));
+    }
+
+    function pause() external onlyKeeper {
+        _pause();
+    }
+
+    function unpause() external onlyOwner {
+        _unpause();
+    }
+
+    function setKeeper(address _keeper) external onlyOwner {
+        if (_keeper == address(0)) revert ZeroAddress();
+        keeper = _keeper;
+        emit KeeperUpdated(_keeper);
+    }
+
+    function setTreasury(address _treasury) external onlyOwner {
+        if (_treasury == address(0)) revert ZeroAddress();
+        treasury = _treasury;
+        emit TreasuryUpdated(_treasury);
+    }
+
+    function setPerformanceFee(uint256 bps) external onlyOwner {
+        if (bps > MAX_PERFORMANCE_FEE_BPS) revert InvalidParam();
+        performanceFeeBps = bps;
+        emit PerformanceFeeUpdated(bps);
+    }
+
+    function setRiskParams(uint256 _slippageBps, uint256 _maxValueLossBps, uint256 _maxPoolDeviationBps)
+        external
+        onlyOwner
+    {
+        if (_slippageBps == 0 || _slippageBps > MAX_SLIPPAGE_BPS) revert InvalidParam();
+        if (_maxValueLossBps == 0 || _maxValueLossBps > MAX_VALUE_LOSS_BPS) revert InvalidParam();
+        if (_maxPoolDeviationBps == 0 || _maxPoolDeviationBps > MAX_SLIPPAGE_BPS) revert InvalidParam();
+        slippageBps = _slippageBps;
+        maxValueLossBps = _maxValueLossBps;
+        maxPoolDeviationBps = _maxPoolDeviationBps;
+        emit RiskParamsUpdated(_slippageBps, _maxValueLossBps, _maxPoolDeviationBps);
+    }
+
+    function setThresholds(uint256 _minDeploy, uint256 _minRewardToSell) external onlyOwner {
+        minDeploy = _minDeploy;
+        minRewardToSell = _minRewardToSell;
+        emit ThresholdsUpdated(_minDeploy, _minRewardToSell);
+    }
+
+    function setFeedMaxAges(uint256 ethAge, uint256 usdcAge, uint256 aeroAge) external onlyOwner {
+        if (ethAge == 0 || usdcAge == 0 || aeroAge == 0) revert InvalidParam();
+        ethFeedMaxAge = ethAge;
+        usdcFeedMaxAge = usdcAge;
+        aeroFeedMaxAge = aeroAge;
+        emit FeedMaxAgesUpdated(ethAge, usdcAge, aeroAge);
+    }
+
+    /// @notice Rescue tokens that are not part of the position (an airdrop, a stray transfer).
+    function sweep(address token, address to) external onlyOwner {
+        if (token == address(usdc) || token == address(weth) || token == address(pool) || token == address(aero)) {
+            revert ProtectedToken();
+        }
+        if (to == address(0)) revert ZeroAddress();
+        IERC20(token).safeTransfer(to, IERC20(token).balanceOf(address(this)));
+    }
+}
diff --git a/src/UsdcYieldVault.sol b/src/UsdcYieldVault.sol
new file mode 100644
index 0000000..0890a66
--- /dev/null
+++ b/src/UsdcYieldVault.sol
@@ -0,0 +1,236 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.28;
+
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+import {ERC20} from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+import {ERC4626} from "@openzeppelin/contracts/token/ERC20/extensions/ERC4626.sol";
+import {Ownable, Ownable2Step} from "@openzeppelin/contracts/access/Ownable2Step.sol";
+import {Pausable} from "@openzeppelin/contracts/utils/Pausable.sol";
+import {ReentrancyGuard} from "@openzeppelin/contracts/utils/ReentrancyGuard.sol";
+import {Math} from "@openzeppelin/contracts/utils/math/Math.sol";
+
+import {IStrategy} from "./interfaces/IStrategy.sol";
+import {IVault} from "./interfaces/IVault.sol";
+
+/// @title UsdcYieldVault
+/// @notice ERC-4626 vault denominated in USDC. Deposits sit idle until the keeper pushes them into
+///         the strategy; withdrawals are served from idle USDC first and unwind the strategy for the
+///         remainder.
+contract UsdcYieldVault is IVault, ERC4626, Ownable2Step, Pausable, ReentrancyGuard {
+    using SafeERC20 for IERC20;
+
+    /// @notice Residual value tolerated in an old strategy when migrating (1 USDC).
+    uint256 public constant MIGRATION_DUST = 1e6;
+
+    address public strategy;
+    address public keeper;
+    /// @notice Hard cap on `totalAssets()`; deposits above it revert. `type(uint256).max` disables it.
+    uint256 public depositCap = type(uint256).max;
+    /// @notice Fee charged on the way out, in bps, kept in the vault for the remaining shareholders.
+    /// @dev Unwinding the LP position costs a swap; without this fee the exiting user would push that
+    ///      cost onto everybody who stays. It is reflected in `previewWithdraw`/`previewRedeem`, as
+    ///      ERC-4626 requires.
+    uint256 public exitFeeBps = 10; // 0.10%
+    uint256 public constant MAX_EXIT_FEE_BPS = 100; // 1%
+    uint256 private constant _BPS = 10_000;
+
+    event StrategyUpdated(address indexed oldStrategy, address indexed newStrategy);
+    event KeeperUpdated(address keeper);
+    event DepositCapUpdated(uint256 cap);
+    event ExitFeeUpdated(uint256 bps);
+    event IdlePushed(uint256 amount);
+
+    error NotKeeper();
+    error ZeroAddress();
+    error StrategyMismatch();
+    error StrategyNotEmpty();
+    error CapExceeded();
+    error InvalidParam();
+    error InsufficientLiquidity(uint256 requested, uint256 available);
+    error ProtectedToken();
+
+    modifier onlyKeeper() {
+        if (msg.sender != keeper && msg.sender != owner()) revert NotKeeper();
+        _;
+    }
+
+    constructor(IERC20 _usdc, address _owner, address _keeper)
+        ERC20("Base USDC Yield Vault", "byvUSDC")
+        ERC4626(_usdc)
+        Ownable(_owner)
+    {
+        if (_keeper == address(0)) revert ZeroAddress();
+        keeper = _keeper;
+    }
+
+    /// @dev Virtual shares/assets offset. Makes the classic "donate to inflate the first share"
+    ///      attack cost more than it can steal.
+    function _decimalsOffset() internal pure override returns (uint8) {
+        return 6;
+    }
+
+    /* -------------------------------------------------------------------------- */
+    /*                                 accounting                                  */
+    /* -------------------------------------------------------------------------- */
+
+    /// @inheritdoc ERC4626
+    function totalAssets() public view override returns (uint256) {
+        uint256 idle = IERC20(asset()).balanceOf(address(this));
+        return strategy == address(0) ? idle : idle + IStrategy(strategy).totalAssets();
+    }
+
+    /// @notice USDC held by the vault itself, i.e. withdrawable without touching the strategy.
+    function idleAssets() public view returns (uint256) {
+        return IERC20(asset()).balanceOf(address(this));
+    }
+
+    function maxDeposit(address) public view override returns (uint256) {
+        if (paused()) return 0;
+        uint256 total = totalAssets();
+        return total >= depositCap ? 0 : depositCap - total;
+    }
+
+    function maxMint(address receiver) public view override returns (uint256) {
+        uint256 assets = maxDeposit(receiver);
+        return assets == type(uint256).max ? type(uint256).max : _convertToShares(assets, Math.Rounding.Floor);
+    }
+
+    /// @dev Caller must burn shares worth `assets + exitFee`.
+    function previewWithdraw(uint256 assets) public view override returns (uint256) {
+        return super.previewWithdraw(assets + _feeOnRaw(assets));
+    }
+
+    /// @dev Redeemer receives the value of the shares minus the exit fee.
+    function previewRedeem(uint256 shares) public view override returns (uint256) {
+        uint256 assets = super.previewRedeem(shares);
+        return assets - _feeOnTotal(assets);
+    }
+
+    function maxWithdraw(address owner_) public view override returns (uint256) {
+        return previewRedeem(balanceOf(owner_));
+    }
+
+    function _feeOnRaw(uint256 assets) internal view returns (uint256) {
+        return Math.mulDiv(assets, exitFeeBps, _BPS, Math.Rounding.Ceil);
+    }
+
+    function _feeOnTotal(uint256 assets) internal view returns (uint256) {
+        return Math.mulDiv(assets, exitFeeBps, exitFeeBps + _BPS, Math.Rounding.Ceil);
+    }
+
+    /* -------------------------------------------------------------------------- */
+    /*                              deposit / withdraw                             */
+    /* -------------------------------------------------------------------------- */
+
+    function deposit(uint256 assets, address receiver) public override nonReentrant whenNotPaused returns (uint256) {
+        if (assets > maxDeposit(receiver)) revert CapExceeded();
+        return super.deposit(assets, receiver);
+    }
+
+    function mint(uint256 shares, address receiver) public override nonReentrant whenNotPaused returns (uint256) {
+        uint256 assets = previewMint(shares);
+        if (assets > maxDeposit(receiver)) revert CapExceeded();
+        return super.mint(shares, receiver);
+    }
+
+    function withdraw(uint256 assets, address receiver, address owner_) public override nonReentrant returns (uint256) {
+        return super.withdraw(assets, receiver, owner_);
+    }
+
+    function redeem(uint256 shares, address receiver, address owner_) public override nonReentrant returns (uint256) {
+        return super.redeem(shares, receiver, owner_);
+    }
+
+    /// @dev Pulls the shortfall out of the strategy before the ERC4626 transfer happens. If the
+    ///      strategy cannot return enough (large exit against a thin pool), the call reverts instead
+    ///      of silently shortchanging the caller: withdraw in smaller pieces, or have the keeper
+    ///      unwind first.
+    function _withdraw(address caller, address receiver, address owner_, uint256 assets, uint256 shares)
+        internal
+        override
+    {
+        uint256 idle = idleAssets();
+        if (idle < assets && strategy != address(0)) {
+            IStrategy(strategy).withdraw(assets - idle);
+            idle = idleAssets();
+        }
+        if (idle < assets) revert InsufficientLiquidity(assets, idle);
+
+        super._withdraw(caller, receiver, owner_, assets, shares);
+    }
+
+    /* -------------------------------------------------------------------------- */
+    /*                                   keeper                                    */
+    /* -------------------------------------------------------------------------- */
+
+    /// @inheritdoc IVault
+    /// @dev Callable by the keeper and by the strategy itself (harvest sweeps idle in one tx).
+    function pushIdleToStrategy() external override returns (uint256 moved) {
+        if (msg.sender != strategy && msg.sender != keeper && msg.sender != owner()) {
+            revert NotKeeper();
+        }
+        address _strategy = strategy;
+        if (_strategy == address(0)) revert ZeroAddress();
+
+        moved = idleAssets();
+        if (moved != 0) {
+            IERC20(asset()).safeTransfer(_strategy, moved);
+            emit IdlePushed(moved);
+        }
+    }
+
+    /* -------------------------------------------------------------------------- */
+    /*                                    admin                                    */
+    /* -------------------------------------------------------------------------- */
+
+    /// @notice Point the vault at a (new) strategy. Any existing strategy is fully unwound first.
+    function setStrategy(address newStrategy) external onlyOwner {
+        if (newStrategy == address(0)) revert ZeroAddress();
+        if (IStrategy(newStrategy).vault() != address(this) || IStrategy(newStrategy).asset() != asset()) {
+            revert StrategyMismatch();
+        }
+
+        address old = strategy;
+        if (old != address(0)) {
+            IStrategy(old).withdraw(type(uint256).max);
+            if (IStrategy(old).totalAssets() > MIGRATION_DUST) revert StrategyNotEmpty();
+        }
+
+        strategy = newStrategy;
+        emit StrategyUpdated(old, newStrategy);
+    }
+
+    function setKeeper(address _keeper) external onlyOwner {
+        if (_keeper == address(0)) revert ZeroAddress();
+        keeper = _keeper;
+        emit KeeperUpdated(_keeper);
+    }
+
+    function setExitFee(uint256 bps) external onlyOwner {
+        if (bps > MAX_EXIT_FEE_BPS) revert InvalidParam();
+        exitFeeBps = bps;
+        emit ExitFeeUpdated(bps);
+    }
+
+    function setDepositCap(uint256 cap) external onlyOwner {
+        depositCap = cap;
+        emit DepositCapUpdated(cap);
+    }
+
+    /// @notice Stop new deposits. Withdrawals stay open by design.
+    function pause() external onlyKeeper {
+        _pause();
+    }
+
+    function unpause() external onlyOwner {
+        _unpause();
+    }
+
+    /// @notice Rescue tokens accidentally sent to the vault. The vault asset is not rescuable.
+    function sweep(address token, address to) external onlyOwner {
+        if (token == asset()) revert ProtectedToken();
+        if (to == address(0)) revert ZeroAddress();
+        IERC20(token).safeTransfer(to, IERC20(token).balanceOf(address(this)));
+    }
+}
