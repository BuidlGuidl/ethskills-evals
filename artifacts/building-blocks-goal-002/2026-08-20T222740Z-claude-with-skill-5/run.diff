+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.28;
+
+import {Script, console2} from "forge-std/Script.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+
+import {UsdcYieldVault} from "../src/UsdcYieldVault.sol";
+import {AerodromeUsdcWethStrategy} from "../src/AerodromeUsdcWethStrategy.sol";
+import {BaseAddresses} from "./BaseAddresses.sol";
+
+/// @notice Deploys the vault + strategy on Base and hands both over to the owner multisig.
+/// @dev Required env: OWNER, KEEPER, TREASURY. Optional: DEPOSIT_CAP (USDC, 6dp; default unlimited).
+///
+///      forge script script/Deploy.s.sol:Deploy \
+///        --rpc-url $BASE_RPC_URL --account deployer --broadcast --verify
+contract Deploy is Script {
+    function run() external returns (UsdcYieldVault vault, AerodromeUsdcWethStrategy strategy) {
+        require(block.chainid == BaseAddresses.CHAIN_ID, "deploy: wrong chain");
+
+        address owner = vm.envAddress("OWNER");
+        address keeper = vm.envAddress("KEEPER");
+        address treasury = vm.envAddress("TREASURY");
+        uint256 cap = vm.envOr("DEPOSIT_CAP", type(uint256).max);
+
+        vm.startBroadcast();
+        address deployer = msg.sender;
+
+        // Own both contracts during wiring, then hand over.
+        vault = new UsdcYieldVault(IERC20(BaseAddresses.USDC), deployer, keeper);
+        strategy = new AerodromeUsdcWethStrategy(
+            AerodromeUsdcWethStrategy.Config({
+                vault: address(vault),
+                usdc: BaseAddresses.USDC,
+                weth: BaseAddresses.WETH,
+                aero: BaseAddresses.AERO,
+                router: BaseAddresses.AERODROME_ROUTER,
+                voter: BaseAddresses.AERODROME_VOTER,
+                swapRouter: BaseAddresses.CL_SWAP_ROUTER,
+                clFactory: BaseAddresses.CL_FACTORY,
+                tickSpacing: BaseAddresses.CL_TICK_SPACING,
+                ethUsdFeed: BaseAddresses.ETH_USD_FEED,
+                usdcUsdFeed: BaseAddresses.USDC_USD_FEED,
+                aeroUsdFeed: BaseAddresses.AERO_USD_FEED,
+                owner: deployer,
+                keeper: keeper,
+                treasury: treasury
+            })
+        );
+
+        vault.setStrategy(address(strategy));
+        if (cap != type(uint256).max) vault.setDepositCap(cap);
+
+        // Ownable2Step: `owner` must call acceptOwnership() on both contracts to finish the handover.
+        vault.transferOwnership(owner);
+        strategy.transferOwnership(owner);
+
+        vm.stopBroadcast();
+
+        // Sanity: the strategy resolved the venue we expect.
+        require(address(strategy.pool()) == BaseAddresses.USDC_WETH_POOL, "unexpected pool");
+        require(address(strategy.gauge()) == BaseAddresses.USDC_WETH_GAUGE, "unexpected gauge");
+
+        console2.log("vault      ", address(vault));
+        console2.log("strategy   ", address(strategy));
+        console2.log("pool       ", address(strategy.pool()));
+        console2.log("gauge      ", address(strategy.gauge()));
+        console2.log("cl pool    ", strategy.clPool());
+        console2.log("pending owner (must call acceptOwnership on both):", owner);
+    }
+}
