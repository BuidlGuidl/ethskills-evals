@@ -0,0 +1,41 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.28;
+
+import {Script, console2} from "forge-std/Script.sol";
+import {AerodromeUsdcWethStrategy} from "../src/AerodromeUsdcWethStrategy.sol";
+import {UsdcYieldVault} from "../src/UsdcYieldVault.sol";
+
+/// @notice The keeper's whole job: one call, on a schedule.
+/// @dev `harvest()` claims AERO, sells it under the contract's own oracle floor, pays the
+///      performance fee, sweeps whatever users deposited since last time, and re-stakes everything.
+///
+///      MIN_USDC_OUT is an extra, tighter floor the operator may pass on top of the onchain one;
+///      0 means "rely on the oracle floor".
+///
+///      forge script script/Keeper.s.sol:Harvest --rpc-url $BASE_RPC_URL --account keeper --broadcast
+contract Harvest is Script {
+    function run() external {
+        AerodromeUsdcWethStrategy strategy = AerodromeUsdcWethStrategy(vm.envAddress("STRATEGY"));
+        uint256 minUsdcOut = vm.envOr("MIN_USDC_OUT", uint256(0));
+
+        UsdcYieldVault vault = UsdcYieldVault(strategy.vault());
+        console2.log("pending AERO   ", strategy.pendingRewards());
+        console2.log("idle in vault  ", vault.idleAssets());
+        console2.log("total assets   ", vault.totalAssets());
+
+        vm.broadcast();
+        uint256 sold = strategy.harvest(minUsdcOut);
+
+        console2.log("USDC from rewards", sold);
+        console2.log("total assets now ", vault.totalAssets());
+    }
+}
+
+/// @notice Deploy freshly deposited USDC without waiting for the next harvest.
+contract DeployIdle is Script {
+    function run() external {
+        AerodromeUsdcWethStrategy strategy = AerodromeUsdcWethStrategy(vm.envAddress("STRATEGY"));
+        vm.broadcast();
+        strategy.deployIdle();
+    }
+}
