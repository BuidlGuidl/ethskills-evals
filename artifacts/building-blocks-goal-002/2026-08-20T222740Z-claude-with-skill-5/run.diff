diff --git a/test/BaseFork.t.sol b/test/BaseFork.t.sol
new file mode 100644
index 0000000..26e2c1c
--- /dev/null
+++ b/test/BaseFork.t.sol
@@ -0,0 +1,142 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.28;
+
+import {Test} from "forge-std/Test.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+
+import {UsdcYieldVault} from "../src/UsdcYieldVault.sol";
+import {AerodromeUsdcWethStrategy} from "../src/AerodromeUsdcWethStrategy.sol";
+import {IAerodromeRouter} from "../src/interfaces/IAerodromeRouter.sol";
+import {IAerodromePool} from "../src/interfaces/IAerodromePool.sol";
+import {IAerodromeGauge} from "../src/interfaces/IAerodromeGauge.sol";
+import {IAggregatorV3} from "../src/interfaces/IAggregatorV3.sol";
+
+/// @notice Shared Base-mainnet fork fixture.
+/// @dev Every address below was read from Base mainnet (chain 8453) on 2026-08-20; see README.
+///      If no RPC is reachable the fork tests skip instead of failing, so `forge test` still works
+///      offline. Point BASE_RPC_URL at your own node to run them.
+abstract contract BaseForkTest is Test {
+    uint256 internal constant FORK_BLOCK = 50_237_000;
+
+    address internal constant USDC = 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913;
+    address internal constant WETH = 0x4200000000000000000000000000000000000006;
+    address internal constant AERO = 0x940181a94A35A4569E4529A3CDfB74e38FD98631;
+    address internal constant ROUTER = 0xcF77a3Ba9A5CA399B7c97c74d54e5b1Beb874E43;
+    address internal constant POOL_FACTORY = 0x420DD381b31aEf6683db6B902084cB0FFECe40Da;
+    address internal constant VOTER = 0x16613524e02ad97eDfeF371bC883F2F5d6C480A5;
+    /// @dev USDC/WETH volatile pool and its gauge, resolved from the factory/voter at deploy time.
+    address internal constant POOL = 0xcDAC0d6c6C59727a65F871236188350531885C43;
+    address internal constant GAUGE = 0x519BBD1Dd8C6A94C46080E24f316c14Ee758C025;
+    /// @dev Slipstream (concentrated liquidity) deployment, used only as the swap venue.
+    address internal constant CL_FACTORY = 0x5e7BB104d84c7CB9B682AaC2F3d509f5F406809A;
+    address internal constant CL_SWAP_ROUTER = 0xBE6D8f0d05cC4be24d5167a3eF062215bE6D18a5;
+    address internal constant CL_QUOTER = 0x254cF9E1E6e233aa1AC962CB9B05b2cfeAaE15b0;
+    address internal constant CL_POOL_100 = 0xb2cc224c1c9feE385f8ad6a55b4d94E92359DC59;
+    int24 internal constant TICK_SPACING = 100;
+    /// @dev Chainlink feeds on Base.
+    address internal constant ETH_USD_FEED = 0x71041dddad3595F9CEd3DcCFBe3D1F4b0a16Bb70;
+    address internal constant USDC_USD_FEED = 0x7e860098F58bBFC8648a4311b374B1D669a2bc6B;
+    address internal constant AERO_USD_FEED = 0x4EC5970fC728C5f65ba413992CD5fF6FD70fcfF0;
+
+    address internal owner = makeAddr("owner");
+    address internal keeper = makeAddr("keeper");
+    address internal treasury = makeAddr("treasury");
+    address internal alice = makeAddr("alice");
+    address internal bob = makeAddr("bob");
+    address internal attacker = makeAddr("attacker");
+
+    UsdcYieldVault internal vault;
+    AerodromeUsdcWethStrategy internal strategy;
+    bool internal forked;
+
+    modifier onFork() {
+        if (!forked) {
+            vm.skip(true);
+        }
+        _;
+    }
+
+    function setUp() public virtual {
+        string memory rpc = vm.envOr("BASE_RPC_URL", string("https://mainnet.base.org"));
+        try vm.createSelectFork(rpc, FORK_BLOCK) returns (uint256) {
+            forked = true;
+        } catch {
+            forked = false;
+            return;
+        }
+
+        vault = new UsdcYieldVault(IERC20(USDC), owner, keeper);
+        strategy = new AerodromeUsdcWethStrategy(_config(address(vault)));
+        vm.prank(owner);
+        vault.setStrategy(address(strategy));
+    }
+
+    /* ------------------------------ helpers ------------------------------ */
+
+    function _config(address _vault) internal view returns (AerodromeUsdcWethStrategy.Config memory) {
+        return AerodromeUsdcWethStrategy.Config({
+            vault: _vault,
+            usdc: USDC,
+            weth: WETH,
+            aero: AERO,
+            router: ROUTER,
+            voter: VOTER,
+            swapRouter: CL_SWAP_ROUTER,
+            clFactory: CL_FACTORY,
+            tickSpacing: TICK_SPACING,
+            ethUsdFeed: ETH_USD_FEED,
+            usdcUsdFeed: USDC_USD_FEED,
+            aeroUsdFeed: AERO_USD_FEED,
+            owner: owner,
+            keeper: keeper,
+            treasury: treasury
+        });
+    }
+
+    function _fundUsdc(address to, uint256 amount) internal {
+        deal(USDC, to, amount);
+        assertEq(IERC20(USDC).balanceOf(to), amount, "usdc funding failed");
+    }
+
+    function _deposit(address user, uint256 amount) internal returns (uint256 shares) {
+        _fundUsdc(user, amount);
+        vm.startPrank(user);
+        IERC20(USDC).approve(address(vault), amount);
+        shares = vault.deposit(amount, user);
+        vm.stopPrank();
+    }
+
+    /// @notice Swap `amountIn` of `tokenIn` through the USDC/WETH volatile pool, moving its spot price.
+    function _movePrice(address tokenIn, address tokenOut, uint256 amountIn) internal {
+        deal(tokenIn, attacker, amountIn);
+        IAerodromeRouter.Route[] memory routes = new IAerodromeRouter.Route[](1);
+        routes[0] = IAerodromeRouter.Route(tokenIn, tokenOut, false, POOL_FACTORY);
+        vm.startPrank(attacker);
+        IERC20(tokenIn).approve(ROUTER, amountIn);
+        IAerodromeRouter(ROUTER).swapExactTokensForTokens(amountIn, 0, routes, attacker, block.timestamp);
+        vm.stopPrank();
+    }
+
+    /// @notice Move time forward and re-stamp the Chainlink feeds as if they had kept updating.
+    /// @dev Time travel on a fork freezes the oracles, which the strategy (correctly) treats as
+    ///      stale. Keep the prices, refresh the timestamps.
+    function _warp(uint256 dt) internal {
+        vm.warp(block.timestamp + dt);
+        _refreshFeed(ETH_USD_FEED);
+        _refreshFeed(USDC_USD_FEED);
+        _refreshFeed(AERO_USD_FEED);
+    }
+
+    function _refreshFeed(address feed) internal {
+        (uint80 roundId, int256 answer,,,) = IAggregatorV3(feed).latestRoundData();
+        vm.mockCall(
+            feed,
+            abi.encodeWithSelector(IAggregatorV3.latestRoundData.selector),
+            abi.encode(roundId, answer, block.timestamp, block.timestamp, roundId)
+        );
+    }
+
+    function _pricePerShare() internal view returns (uint256) {
+        return vault.convertToAssets(10 ** vault.decimals());
+    }
+}
diff --git a/test/Economics.fork.t.sol b/test/Economics.fork.t.sol
new file mode 100644
index 0000000..c6085fc
--- /dev/null
+++ b/test/Economics.fork.t.sol
@@ -0,0 +1,105 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.28;
+
+import {BaseForkTest} from "./BaseFork.t.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {IAerodromeGauge} from "../src/interfaces/IAerodromeGauge.sol";
+import {IAerodromePool} from "../src/interfaces/IAerodromePool.sol";
+import {IAerodromeRouter} from "../src/interfaces/IAerodromeRouter.sol";
+
+/// @notice Measures what the venue choices actually cost. These numbers are what the README quotes;
+///         the assertions are the regression guard on them.
+contract EconomicsForkTest is BaseForkTest {
+    /// @notice Cost of turning USDC into a staked LP position, at three sizes.
+    function test_ZapCostByDepositSize() public onFork {
+        uint256[3] memory sizes = [uint256(10_000e6), 100_000e6, 500_000e6];
+
+        for (uint256 i; i < sizes.length; ++i) {
+            uint256 snap = vm.snapshotState();
+
+            _deposit(alice, sizes[i]);
+            vm.prank(keeper);
+            strategy.deployIdle();
+
+            uint256 kept = vault.totalAssets();
+            int256 costBps = (int256(sizes[i]) - int256(kept)) * 10_000 / int256(sizes[i]);
+            emit log_named_uint("deposit (USDC)", sizes[i] / 1e6);
+            emit log_named_int("  zap cost (bps, negative = gain)", costBps);
+            // Slipstream keeps even a 500k zap inside the 50 bps end-to-end guard.
+            assertLt(costBps, 50, "zap cost above the strategy's own guard");
+
+            vm.revertToState(snap);
+        }
+    }
+
+    /// @notice Same swap on the v2 curve vs the concentrated liquidity pool.
+    /// @dev This is the measurement behind routing swaps through Slipstream instead of the LP pool.
+    function test_SwapVenueComparison() public onFork {
+        uint256[3] memory sizes = [uint256(10_000e6), 50_000e6, 250_000e6];
+        for (uint256 i; i < sizes.length; ++i) {
+            IAerodromeRouter.Route[] memory routes = new IAerodromeRouter.Route[](1);
+            routes[0] = IAerodromeRouter.Route(USDC, WETH, false, POOL_FACTORY);
+            uint256 v2Out = IAerodromeRouter(ROUTER).getAmountsOut(sizes[i], routes)[1];
+
+            uint256 snap = vm.snapshotState();
+            deal(USDC, address(this), sizes[i]);
+            IERC20(USDC).approve(CL_SWAP_ROUTER, sizes[i]);
+            uint256 clOut = _swapOnCL(sizes[i]);
+            vm.revertToState(snap);
+
+            emit log_named_uint("swap size (USDC)", sizes[i] / 1e6);
+            emit log_named_uint("  v2 out (wei WETH)", v2Out);
+            emit log_named_uint("  CL out (wei WETH)", clOut);
+            emit log_named_uint("  CL advantage (bps)", (clOut - v2Out) * 10_000 / v2Out);
+            assertGt(clOut, v2Out, "CL should execute better than the v2 curve");
+        }
+    }
+
+    function _swapOnCL(uint256 amountIn) internal returns (uint256) {
+        (bool ok, bytes memory ret) = CL_SWAP_ROUTER.call(
+            abi.encodeWithSignature(
+                "exactInputSingle((address,address,int24,address,uint256,uint256,uint256,uint160))",
+                USDC,
+                WETH,
+                TICK_SPACING,
+                address(this),
+                block.timestamp,
+                amountIn,
+                uint256(0),
+                uint160(0)
+            )
+        );
+        require(ok, "cl swap failed");
+        return abi.decode(ret, (uint256));
+    }
+
+    /// @notice Rough gross emissions APR of the position, from the gauge's own reward rate.
+    function test_GaugeEmissionsApr() public onFork {
+        _deposit(alice, 100_000e6);
+        vm.prank(keeper);
+        strategy.deployIdle();
+
+        uint256 staked = IAerodromeGauge(GAUGE).balanceOf(address(strategy));
+        uint256 gaugeTotal = IERC20(POOL).balanceOf(GAUGE);
+        uint256 aeroPerYear = IAerodromeGauge(GAUGE).rewardRate() * 365 days * staked / gaugeTotal;
+        uint256 usdcPerYear = aeroPerYear * strategy.usdcPerAero() / 1e18;
+
+        emit log_named_uint("position value (USDC)", vault.totalAssets() / 1e6);
+        emit log_named_uint("gross AERO/yr", aeroPerYear / 1e18);
+        emit log_named_uint("gross emissions APR (bps)", usdcPerYear * 10_000 / vault.totalAssets());
+        assertGt(usdcPerYear, 0, "gauge pays nothing");
+    }
+
+    /// @notice Full deposit -> deploy -> harvest -> exit cycle, reported as a single number.
+    function test_RoundTripCost() public onFork {
+        uint256 amount = 100_000e6;
+        uint256 shares = _deposit(alice, amount);
+        vm.prank(keeper);
+        strategy.deployIdle();
+
+        vm.prank(alice);
+        uint256 out = vault.redeem(shares, alice, alice);
+        emit log_named_uint("round trip cost (bps)", (amount - out) * 10_000 / amount);
+        assertLt((amount - out) * 10_000 / amount, 60, "round trip above 60 bps");
+    }
+}
diff --git a/test/StrategyIntegration.fork.t.sol b/test/StrategyIntegration.fork.t.sol
new file mode 100644
index 0000000..9b1fefc
--- /dev/null
+++ b/test/StrategyIntegration.fork.t.sol
@@ -0,0 +1,255 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.28;
+
+import {BaseForkTest} from "./BaseFork.t.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {IAerodromeGauge} from "../src/interfaces/IAerodromeGauge.sol";
+import {IAerodromePool} from "../src/interfaces/IAerodromePool.sol";
+import {AerodromeUsdcWethStrategy} from "../src/AerodromeUsdcWethStrategy.sol";
+import {UsdcYieldVault} from "../src/UsdcYieldVault.sol";
+
+/// @notice End-to-end tests against the live Aerodrome USDC/WETH pool and gauge on Base.
+contract StrategyIntegrationForkTest is BaseForkTest {
+    uint256 constant DEPOSIT = 100_000e6;
+
+    /* ---------------------------- wiring / venue ---------------------------- */
+
+    function test_ResolvesLivePoolAndGauge() public onFork {
+        assertEq(address(strategy.pool()), POOL, "pool");
+        assertEq(address(strategy.gauge()), GAUGE, "gauge");
+        assertEq(IAerodromeGauge(GAUGE).stakingToken(), POOL, "staking token");
+        assertEq(IAerodromeGauge(GAUGE).rewardToken(), AERO, "reward token");
+        // Gauge must still be inside its emission period, otherwise the strategy earns nothing.
+        assertGt(IAerodromeGauge(GAUGE).rewardRate(), 0, "reward rate");
+        assertGt(IAerodromeGauge(GAUGE).periodFinish(), block.timestamp, "emissions ended");
+        // Swap venue and price source must be live too.
+        assertEq(strategy.clPool(), CL_POOL_100, "cl pool");
+        assertApproxEqRel(strategy.usdcPerWeth(), 2_312e6, 0.05e18, "eth oracle");
+        assertApproxEqRel(strategy.usdcPerAero(), 0.475e6, 0.1e18, "aero oracle");
+    }
+
+    /* ------------------------------ happy path ------------------------------ */
+
+    function test_DepositStaysIdleUntilKeeperDeploys() public onFork {
+        _deposit(alice, DEPOSIT);
+
+        assertEq(vault.idleAssets(), DEPOSIT, "idle");
+        assertEq(vault.totalAssets(), DEPOSIT, "total");
+        assertEq(IAerodromeGauge(GAUGE).balanceOf(address(strategy)), 0, "not staked yet");
+
+        vm.prank(keeper);
+        strategy.deployIdle();
+
+        assertEq(vault.idleAssets(), 0, "swept");
+        assertGt(IAerodromeGauge(GAUGE).balanceOf(address(strategy)), 0, "staked");
+        assertEq(IERC20(POOL).balanceOf(address(strategy)), 0, "all lp staked");
+    }
+
+    function test_DeployKeepsValueWithinSwapCosts() public onFork {
+        _deposit(alice, DEPOSIT);
+        vm.prank(keeper);
+        strategy.deployIdle();
+
+        // One 0.30% swap over roughly half the deposit, plus price impact: well under 50 bps.
+        assertGe(vault.totalAssets(), DEPOSIT * 9_950 / 10_000, "value lost in zap");
+        assertLe(vault.totalAssets(), DEPOSIT * 10_010 / 10_000, "value invented");
+
+        // The optimal-swap split should leave almost nothing unpaired.
+        assertLt(IERC20(USDC).balanceOf(address(strategy)), DEPOSIT / 1_000, "usdc dust");
+        uint256 wethDust = IERC20(WETH).balanceOf(address(strategy));
+        assertLt(wethDust, 0.05e18, "weth dust");
+    }
+
+    function test_HarvestClaimsSellsAndCompounds() public onFork {
+        _deposit(alice, DEPOSIT);
+        vm.prank(keeper);
+        strategy.deployIdle();
+
+        uint256 lpBefore = strategy.lpBalance();
+        uint256 totalBefore = vault.totalAssets();
+        uint256 ppsBefore = _pricePerShare();
+
+        _warp(3 days);
+        assertGt(strategy.pendingRewards(), 0, "no emissions accrued");
+
+        vm.prank(keeper);
+        uint256 usdcFromRewards = strategy.harvest(0);
+
+        assertGt(usdcFromRewards, 0, "rewards not sold");
+        assertEq(IERC20(AERO).balanceOf(address(strategy)), 0, "aero left behind");
+        assertEq(
+            IERC20(USDC).balanceOf(treasury), usdcFromRewards * strategy.performanceFeeBps() / 10_000, "performance fee"
+        );
+        assertGt(strategy.lpBalance(), lpBefore, "not compounded into lp");
+        assertGt(vault.totalAssets(), totalBefore, "no profit booked");
+        assertGt(_pricePerShare(), ppsBefore, "share price did not rise");
+    }
+
+    function test_FullWithdrawRoundTrip() public onFork {
+        uint256 shares = _deposit(alice, DEPOSIT);
+        vm.prank(keeper);
+        strategy.deployIdle();
+
+        vm.prank(alice);
+        uint256 out = vault.redeem(shares, alice, alice);
+
+        // entry zap (~16 bps) + exit swap (~16 bps) + exit fee (10 bps) => keep >= 99%.
+        assertGe(out, DEPOSIT * 99 / 100, "round trip loss too high");
+        assertLe(out, DEPOSIT, "profit from nowhere");
+        assertEq(IERC20(USDC).balanceOf(alice), out, "received");
+        assertEq(vault.balanceOf(alice), 0, "shares burned");
+        assertLt(strategy.totalAssets(), DEPOSIT / 1_000, "position not unwound");
+    }
+
+    function test_PartialWithdrawUnwindsOnlyWhatIsNeeded() public onFork {
+        _deposit(alice, DEPOSIT);
+        vm.prank(keeper);
+        strategy.deployIdle();
+
+        uint256 lpBefore = strategy.lpBalance();
+
+        vm.prank(alice);
+        vault.withdraw(30_000e6, alice, alice);
+
+        assertEq(IERC20(USDC).balanceOf(alice), 30_000e6, "exact assets out");
+        uint256 lpAfter = strategy.lpBalance();
+        assertGt(lpAfter, lpBefore * 60 / 100, "unwound too much");
+        assertLt(lpAfter, lpBefore * 75 / 100, "unwound too little");
+        assertGt(vault.balanceOf(alice), 0, "shares remain");
+    }
+
+    function testFuzz_RoundTripLossBounded(uint256 amount) public onFork {
+        amount = bound(amount, 100e6, 250_000e6);
+        uint256 shares = _deposit(alice, amount);
+        vm.prank(keeper);
+        strategy.deployIdle();
+
+        vm.prank(alice);
+        uint256 out = vault.redeem(shares, alice, alice);
+
+        assertGe(out, amount * 985 / 1_000, "round trip loss > 1.5%");
+        assertLe(out, amount, "gained value out of thin air");
+    }
+
+    /* --------------------------- manipulation -------------------------------- */
+
+    function test_ShareValueSurvivesSpotManipulation() public onFork {
+        _deposit(alice, DEPOSIT);
+        vm.prank(keeper);
+        strategy.deployIdle();
+
+        uint256 ppsBefore = _pricePerShare();
+        uint256 totalBefore = vault.totalAssets();
+
+        // ~25% of the USDC reserve swapped in one go: a flash loan sized push on the spot price.
+        _movePrice(USDC, WETH, 1_000_000e6);
+
+        assertApproxEqRel(vault.totalAssets(), totalBefore, 0.005e18, "totalAssets moved");
+        assertApproxEqRel(_pricePerShare(), ppsBefore, 0.005e18, "share price moved");
+
+        // ... and a depositor cannot mint cheap shares while the pool is skewed.
+        uint256 sharesAtSkew = vault.previewDeposit(DEPOSIT);
+        assertApproxEqRel(sharesAtSkew, vault.balanceOf(alice), 0.005e18, "free shares");
+    }
+
+    function test_DeployRevertsWhenPoolPriceIsSkewedAgainstUs() public onFork {
+        // WETH pushed expensive relative to the TWAP: the zap's USDC->WETH leg would execute badly.
+        _movePrice(USDC, WETH, 1_500_000e6);
+
+        _deposit(alice, DEPOSIT);
+        vm.prank(keeper);
+        vm.expectRevert();
+        strategy.deployIdle();
+
+        // Funds are untouched and still fully withdrawable.
+        assertEq(vault.totalAssets(), DEPOSIT, "deposit at risk");
+    }
+
+    function test_HarvestRevertsWhenRewardPoolIsSkewed() public onFork {
+        _deposit(alice, DEPOSIT);
+        vm.prank(keeper);
+        strategy.deployIdle();
+        _warp(3 days);
+
+        // Dump AERO into the AERO/USDC pool so the reward sale would print far below TWAP.
+        _movePrice(AERO, USDC, 8_000_000e18);
+
+        vm.prank(keeper);
+        vm.expectRevert(); // router's own "insufficient output" check against our TWAP floor
+        strategy.harvest(0);
+    }
+
+    /* ------------------------------ operations ------------------------------- */
+
+    function test_EmergencyExitUnwindsAndKeepsUsersWhole() public onFork {
+        uint256 shares = _deposit(alice, DEPOSIT);
+        vm.prank(keeper);
+        strategy.deployIdle();
+
+        vm.prank(owner);
+        strategy.emergencyExit();
+
+        assertEq(strategy.lpBalance(), 0, "still in lp");
+        assertTrue(strategy.paused(), "not paused");
+        assertGe(IERC20(USDC).balanceOf(address(strategy)), DEPOSIT * 99 / 100, "usdc not recovered");
+
+        vm.prank(alice);
+        uint256 out = vault.redeem(shares, alice, alice);
+        assertGe(out, DEPOSIT * 99 / 100, "user not made whole");
+    }
+
+    function test_StrategyMigrationMovesEverything() public onFork {
+        _deposit(alice, DEPOSIT);
+        vm.prank(keeper);
+        strategy.deployIdle();
+
+        AerodromeUsdcWethStrategy next = new AerodromeUsdcWethStrategy(_config(address(vault)));
+
+        uint256 totalBefore = vault.totalAssets();
+        vm.prank(owner);
+        vault.setStrategy(address(next));
+
+        assertEq(strategy.totalAssets(), 0, "old strategy not drained");
+        assertGe(vault.totalAssets(), totalBefore * 995 / 1_000, "value lost in migration");
+        assertGe(vault.idleAssets(), totalBefore * 995 / 1_000, "not returned as idle usdc");
+
+        vm.prank(keeper);
+        next.deployIdle();
+        assertGt(next.lpBalance(), 0, "new strategy not deployed");
+    }
+
+    function test_ExitFeeAccruesToRemainingHolders() public onFork {
+        uint256 aliceShares = _deposit(alice, DEPOSIT);
+        _deposit(bob, DEPOSIT);
+        vm.prank(keeper);
+        strategy.deployIdle();
+
+        uint256 aliceValueBefore = vault.previewRedeem(aliceShares);
+
+        uint256 bobShares = vault.balanceOf(bob);
+        vm.prank(bob);
+        vault.redeem(bobShares, bob, bob);
+
+        assertGt(vault.previewRedeem(aliceShares), aliceValueBefore, "exit fee not retained");
+    }
+
+    /* ---------------------------- access control ---------------------------- */
+
+    function test_AccessControl() public onFork {
+        vm.expectRevert(AerodromeUsdcWethStrategy.NotKeeper.selector);
+        strategy.harvest(0);
+
+        vm.expectRevert(AerodromeUsdcWethStrategy.NotKeeper.selector);
+        strategy.deployIdle();
+
+        vm.expectRevert(AerodromeUsdcWethStrategy.NotVault.selector);
+        strategy.withdraw(1);
+
+        vm.expectRevert(UsdcYieldVault.NotKeeper.selector);
+        vault.pushIdleToStrategy();
+
+        vm.prank(alice);
+        vm.expectRevert();
+        strategy.emergencyExit();
+    }
+}
diff --git a/test/StrategyRisk.fork.t.sol b/test/StrategyRisk.fork.t.sol
new file mode 100644
index 0000000..6c2a6cc
--- /dev/null
+++ b/test/StrategyRisk.fork.t.sol
@@ -0,0 +1,194 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.28;
+
+import {BaseForkTest} from "./BaseFork.t.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {Ownable} from "@openzeppelin/contracts/access/Ownable.sol";
+import {Pausable} from "@openzeppelin/contracts/utils/Pausable.sol";
+import {IAggregatorV3} from "../src/interfaces/IAggregatorV3.sol";
+import {IVoter} from "../src/interfaces/IVoter.sol";
+import {AerodromeUsdcWethStrategy} from "../src/AerodromeUsdcWethStrategy.sol";
+
+/// @notice Failure modes: bad oracles, skewed pools, killed gauges, wrong callers.
+contract StrategyRiskForkTest is BaseForkTest {
+    uint256 constant DEPOSIT = 50_000e6;
+
+    function _mockFeed(address feed, int256 answer, uint256 updatedAt) internal {
+        (uint80 roundId,,,,) = IAggregatorV3(feed).latestRoundData();
+        vm.mockCall(
+            feed,
+            abi.encodeWithSelector(IAggregatorV3.latestRoundData.selector),
+            abi.encode(roundId, answer, updatedAt, updatedAt, roundId)
+        );
+    }
+
+    /* -------------------------------- oracles -------------------------------- */
+
+    function test_StaleEthFeedFreezesTheVault() public onFork {
+        _deposit(alice, DEPOSIT);
+        vm.prank(keeper);
+        strategy.deployIdle();
+
+        (, int256 answer,,,) = IAggregatorV3(ETH_USD_FEED).latestRoundData();
+        _mockFeed(ETH_USD_FEED, answer, block.timestamp - 2 hours);
+
+        // Fail closed: no valuation means no deposits, no withdrawals, no compounding.
+        vm.expectRevert(
+            abi.encodeWithSelector(
+                AerodromeUsdcWethStrategy.StalePrice.selector, ETH_USD_FEED, block.timestamp - 2 hours
+            )
+        );
+        vault.totalAssets();
+
+        vm.prank(alice);
+        vm.expectRevert();
+        vault.withdraw(1_000e6, alice, alice);
+
+        // ... and it recovers as soon as the feed does.
+        vm.clearMockedCalls();
+        assertGt(vault.totalAssets(), 0);
+        vm.prank(alice);
+        vault.withdraw(1_000e6, alice, alice);
+        assertEq(IERC20(USDC).balanceOf(alice), 1_000e6);
+    }
+
+    function test_NonPositiveOraclePriceReverts() public onFork {
+        _mockFeed(ETH_USD_FEED, 0, block.timestamp);
+        vm.expectRevert(AerodromeUsdcWethStrategy.BadFeed.selector);
+        strategy.usdcPerWeth();
+
+        _mockFeed(ETH_USD_FEED, -1, block.timestamp);
+        vm.expectRevert(AerodromeUsdcWethStrategy.BadFeed.selector);
+        strategy.usdcPerWeth();
+    }
+
+    function test_UsdcDepegRepricesThePosition() public onFork {
+        _deposit(alice, DEPOSIT);
+        vm.prank(keeper);
+        strategy.deployIdle();
+
+        uint256 priceBefore = strategy.usdcPerWeth();
+        uint256 totalBefore = vault.totalAssets();
+
+        // USDC at $0.95: one WETH is now worth ~5% more USDC, and so is the WETH leg of the LP.
+        _mockFeed(USDC_USD_FEED, 0.95e8, block.timestamp);
+
+        assertApproxEqRel(strategy.usdcPerWeth(), priceBefore * 100 / 95, 0.01e18, "reprice");
+        assertGt(vault.totalAssets(), totalBefore, "depeg not reflected");
+    }
+
+    function test_HarvestFloorComesFromTheOracleNotTheKeeper() public onFork {
+        _deposit(alice, DEPOSIT);
+        vm.prank(keeper);
+        strategy.deployIdle();
+        _warp(3 days);
+
+        // Oracle says AERO is worth 3x what the pool will pay. The keeper asking for 0 does not help:
+        // the contract's own floor is what the router enforces.
+        (, int256 aeroAnswer,,,) = IAggregatorV3(AERO_USD_FEED).latestRoundData();
+        _mockFeed(AERO_USD_FEED, aeroAnswer * 3, block.timestamp);
+
+        vm.prank(keeper);
+        vm.expectRevert();
+        strategy.harvest(0);
+    }
+
+    /* --------------------------------- venue --------------------------------- */
+
+    function test_DeployRefusesASkewedPool() public onFork {
+        _deposit(alice, DEPOSIT);
+        _movePrice(USDC, WETH, 300_000e6); // ~1.5% above the oracle
+
+        vm.prank(keeper);
+        vm.expectPartialRevert(AerodromeUsdcWethStrategy.PoolPriceOffOracle.selector);
+        strategy.deployIdle();
+
+        // The deposit is untouched and still fully withdrawable.
+        assertEq(vault.totalAssets(), DEPOSIT, "deposit at risk");
+    }
+
+    function test_ConstructorRejectsAKilledGauge() public onFork {
+        vm.mockCall(VOTER, abi.encodeWithSelector(IVoter.isAlive.selector, GAUGE), abi.encode(false));
+        vm.expectRevert(AerodromeUsdcWethStrategy.GaugeNotAlive.selector);
+        new AerodromeUsdcWethStrategy(_config(address(vault)));
+    }
+
+    function test_ConstructorRejectsAForeignGauge() public onFork {
+        vm.mockCall(VOTER, abi.encodeWithSelector(IVoter.isGauge.selector, GAUGE), abi.encode(false));
+        vm.expectRevert(AerodromeUsdcWethStrategy.GaugeMismatch.selector);
+        new AerodromeUsdcWethStrategy(_config(address(vault)));
+    }
+
+    /* ------------------------------ admin surface ---------------------------- */
+
+    function test_RiskParamsAreBounded() public onFork {
+        vm.startPrank(owner);
+        vm.expectRevert(AerodromeUsdcWethStrategy.InvalidParam.selector);
+        strategy.setRiskParams(501, 50, 100);
+        vm.expectRevert(AerodromeUsdcWethStrategy.InvalidParam.selector);
+        strategy.setRiskParams(100, 201, 100);
+        vm.expectRevert(AerodromeUsdcWethStrategy.InvalidParam.selector);
+        strategy.setRiskParams(100, 50, 0);
+        vm.expectRevert(AerodromeUsdcWethStrategy.InvalidParam.selector);
+        strategy.setPerformanceFee(2_001);
+
+        strategy.setRiskParams(200, 100, 150);
+        strategy.setPerformanceFee(1_500);
+        vm.stopPrank();
+
+        assertEq(strategy.slippageBps(), 200);
+        assertEq(strategy.maxValueLossBps(), 100);
+        assertEq(strategy.maxPoolDeviationBps(), 150);
+        assertEq(strategy.performanceFeeBps(), 1_500);
+    }
+
+    function test_PauseStopsKeeperActions() public onFork {
+        _deposit(alice, DEPOSIT);
+        vm.prank(keeper);
+        strategy.pause();
+
+        vm.prank(keeper);
+        vm.expectRevert(Pausable.EnforcedPause.selector);
+        strategy.deployIdle();
+
+        vm.prank(keeper);
+        vm.expectRevert(Pausable.EnforcedPause.selector);
+        strategy.harvest(0);
+
+        // Only the owner can turn it back on.
+        vm.prank(keeper);
+        vm.expectRevert(abi.encodeWithSelector(Ownable.OwnableUnauthorizedAccount.selector, keeper));
+        strategy.unpause();
+
+        vm.prank(owner);
+        strategy.unpause();
+        vm.prank(keeper);
+        strategy.deployIdle();
+        assertGt(strategy.lpBalance(), 0);
+    }
+
+    function test_SweepCannotTouchPositionTokens() public onFork {
+        vm.startPrank(owner);
+        vm.expectRevert(AerodromeUsdcWethStrategy.ProtectedToken.selector);
+        strategy.sweep(USDC, owner);
+        vm.expectRevert(AerodromeUsdcWethStrategy.ProtectedToken.selector);
+        strategy.sweep(WETH, owner);
+        vm.expectRevert(AerodromeUsdcWethStrategy.ProtectedToken.selector);
+        strategy.sweep(POOL, owner);
+        vm.expectRevert(AerodromeUsdcWethStrategy.ProtectedToken.selector);
+        strategy.sweep(AERO, owner);
+        vm.stopPrank();
+    }
+
+    function test_PendingRewardsAreNotCountedUntilHarvest() public onFork {
+        _deposit(alice, DEPOSIT);
+        vm.prank(keeper);
+        strategy.deployIdle();
+
+        uint256 totalBefore = vault.totalAssets();
+        _warp(3 days);
+
+        assertGt(strategy.pendingRewards(), 0, "no rewards accrued");
+        assertEq(vault.totalAssets(), totalBefore, "unclaimed rewards leaked into the share price");
+    }
+}
diff --git a/test/UsdcYieldVault.t.sol b/test/UsdcYieldVault.t.sol
new file mode 100644
index 0000000..890025e
--- /dev/null
+++ b/test/UsdcYieldVault.t.sol
@@ -0,0 +1,295 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.28;
+
+import {Test} from "forge-std/Test.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {Ownable} from "@openzeppelin/contracts/access/Ownable.sol";
+import {Pausable} from "@openzeppelin/contracts/utils/Pausable.sol";
+
+import {UsdcYieldVault} from "../src/UsdcYieldVault.sol";
+import {MockERC20} from "./mocks/MockERC20.sol";
+import {MockStrategy} from "./mocks/MockStrategy.sol";
+
+/// @notice Vault accounting, fees and permissions. No fork needed: the strategy is a stub.
+contract UsdcYieldVaultTest is Test {
+    MockERC20 usdc;
+    UsdcYieldVault vault;
+    MockStrategy strat;
+
+    address owner = makeAddr("owner");
+    address keeper = makeAddr("keeper");
+    address alice = makeAddr("alice");
+    address bob = makeAddr("bob");
+
+    function setUp() public {
+        usdc = new MockERC20("USD Coin", "USDC", 6);
+        vault = new UsdcYieldVault(IERC20(address(usdc)), owner, keeper);
+        strat = new MockStrategy(address(usdc), address(vault));
+        vm.prank(owner);
+        vault.setStrategy(address(strat));
+    }
+
+    function _deposit(address who, uint256 amount) internal returns (uint256) {
+        usdc.mint(who, amount);
+        vm.startPrank(who);
+        usdc.approve(address(vault), amount);
+        uint256 shares = vault.deposit(amount, who);
+        vm.stopPrank();
+        return shares;
+    }
+
+    /* ------------------------------ accounting ------------------------------ */
+
+    function test_MetadataAndOffset() public view {
+        assertEq(vault.asset(), address(usdc));
+        assertEq(vault.decimals(), 12, "6 asset decimals + 6 offset");
+        assertEq(vault.symbol(), "byvUSDC");
+    }
+
+    function test_DepositMintsProportionalShares() public {
+        uint256 shares = _deposit(alice, 1_000e6);
+        assertEq(vault.totalAssets(), 1_000e6);
+        assertEq(vault.balanceOf(alice), shares);
+        assertEq(vault.convertToAssets(shares), 1_000e6);
+    }
+
+    function test_TotalAssetsIncludesStrategy() public {
+        _deposit(alice, 1_000e6);
+        vm.prank(keeper);
+        vault.pushIdleToStrategy();
+
+        assertEq(vault.idleAssets(), 0);
+        assertEq(vault.totalAssets(), 1_000e6);
+        assertEq(usdc.balanceOf(address(strat)), 1_000e6);
+    }
+
+    function test_ProfitRaisesSharePriceForEveryone() public {
+        uint256 aliceShares = _deposit(alice, 1_000e6);
+        vm.prank(keeper);
+        vault.pushIdleToStrategy();
+
+        strat.simulateProfit(100e6);
+
+        assertEq(vault.totalAssets(), 1_100e6);
+        assertApproxEqAbs(vault.convertToAssets(aliceShares), 1_100e6, 1, "rounding dust only");
+    }
+
+    function test_LossLowersSharePrice() public {
+        uint256 aliceShares = _deposit(alice, 1_000e6);
+        vm.prank(keeper);
+        vault.pushIdleToStrategy();
+
+        strat.simulateLoss(100e6);
+        assertApproxEqAbs(vault.convertToAssets(aliceShares), 900e6, 1, "rounding dust only");
+    }
+
+    function test_WithdrawPullsFromStrategy() public {
+        _deposit(alice, 1_000e6);
+        vm.prank(keeper);
+        vault.pushIdleToStrategy();
+
+        vm.prank(alice);
+        vault.withdraw(400e6, alice, alice);
+
+        assertEq(usdc.balanceOf(alice), 400e6);
+        assertEq(usdc.balanceOf(address(strat)), 600e6);
+    }
+
+    function test_WithdrawRevertsWhenStrategyIsIlliquid() public {
+        _deposit(alice, 1_000e6);
+        vm.prank(keeper);
+        vault.pushIdleToStrategy();
+        strat.setLiquidity(5_000); // strategy can only return half of what is asked
+
+        vm.prank(alice);
+        vm.expectRevert(abi.encodeWithSelector(UsdcYieldVault.InsufficientLiquidity.selector, 400e6, 200e6));
+        vault.withdraw(400e6, alice, alice);
+    }
+
+    function testFuzz_DepositRedeemRoundTrip(uint256 amount) public {
+        amount = bound(amount, 1e6, 1e15);
+        uint256 shares = _deposit(alice, amount);
+        vm.prank(alice);
+        uint256 out = vault.redeem(shares, alice, alice);
+
+        // Only the exit fee is lost, and never more than it.
+        assertLe(out, amount);
+        assertGe(out, amount - (amount * vault.exitFeeBps() / 10_000) - 1);
+    }
+
+    /* -------------------------------- fees ---------------------------------- */
+
+    function test_ExitFeeIsQuotedInPreviews() public {
+        _deposit(alice, 1_000e6);
+
+        // 10 bps: withdrawing 1000 costs 1000 * 1.001 worth of shares.
+        assertEq(vault.previewWithdraw(1_000e6), vault.convertToShares(1_001e6));
+        assertEq(vault.maxWithdraw(alice), vault.previewRedeem(vault.balanceOf(alice)));
+        assertApproxEqAbs(vault.previewRedeem(vault.balanceOf(alice)), 999e6, 1e6);
+    }
+
+    function test_ExitFeeStaysWithRemainingHolders() public {
+        uint256 aliceShares = _deposit(alice, 1_000e6);
+        _deposit(bob, 1_000e6);
+
+        uint256 aliceBefore = vault.previewRedeem(aliceShares);
+        uint256 bobShares = vault.balanceOf(bob);
+        vm.prank(bob);
+        vault.redeem(bobShares, bob, bob);
+
+        assertGt(vault.previewRedeem(aliceShares), aliceBefore, "fee not retained");
+    }
+
+    function test_MaxWithdrawIsHonoured() public {
+        _deposit(alice, 1_000e6);
+        uint256 max = vault.maxWithdraw(alice);
+        vm.prank(alice);
+        vault.withdraw(max, alice, alice);
+        assertEq(usdc.balanceOf(alice), max);
+    }
+
+    function test_SetExitFeeIsCapped() public {
+        vm.prank(owner);
+        vm.expectRevert(UsdcYieldVault.InvalidParam.selector);
+        vault.setExitFee(101);
+
+        vm.prank(owner);
+        vault.setExitFee(0);
+        assertEq(vault.exitFeeBps(), 0);
+        assertEq(vault.previewWithdraw(100e6), vault.convertToShares(100e6));
+    }
+
+    /* ------------------------------ inflation ------------------------------- */
+
+    function test_FirstDepositorCannotInflateSharePrice() public {
+        address attacker = makeAddr("attacker");
+
+        // 1 wei of USDC in, then a 100k donation straight to the vault.
+        _deposit(attacker, 1);
+        usdc.mint(attacker, 100_000e6);
+        vm.prank(attacker);
+        usdc.transfer(address(vault), 100_000e6);
+
+        uint256 victimShares = _deposit(alice, 10_000e6);
+        assertGt(victimShares, 0, "victim got no shares");
+
+        vm.prank(alice);
+        uint256 out = vault.redeem(victimShares, alice, alice);
+        // The virtual-share offset caps the loss at the exit fee plus rounding dust (~0.4 USDC on a
+        // 100k donation) rather than the whole deposit.
+        assertGe(out, 10_000e6 * 9_980 / 10_000, "victim was drained");
+    }
+
+    /* ------------------------------ permissions ----------------------------- */
+
+    function test_OnlyOwnerAdmin() public {
+        vm.expectRevert(abi.encodeWithSelector(Ownable.OwnableUnauthorizedAccount.selector, address(this)));
+        vault.setKeeper(alice);
+
+        vm.expectRevert(abi.encodeWithSelector(Ownable.OwnableUnauthorizedAccount.selector, address(this)));
+        vault.setDepositCap(1);
+
+        vm.expectRevert(abi.encodeWithSelector(Ownable.OwnableUnauthorizedAccount.selector, address(this)));
+        vault.setStrategy(address(strat));
+    }
+
+    function test_OnlyKeeperCanPushIdle() public {
+        _deposit(alice, 1_000e6);
+
+        vm.prank(alice);
+        vm.expectRevert(UsdcYieldVault.NotKeeper.selector);
+        vault.pushIdleToStrategy();
+
+        vm.prank(keeper);
+        assertEq(vault.pushIdleToStrategy(), 1_000e6);
+    }
+
+    function test_PauseStopsDepositsNotWithdrawals() public {
+        _deposit(alice, 1_000e6);
+
+        vm.prank(keeper);
+        vault.pause();
+
+        assertEq(vault.maxDeposit(alice), 0);
+        usdc.mint(alice, 100e6);
+        vm.startPrank(alice);
+        usdc.approve(address(vault), 100e6);
+        vm.expectRevert(Pausable.EnforcedPause.selector);
+        vault.deposit(100e6, alice);
+        vm.stopPrank();
+
+        vm.prank(alice);
+        vault.withdraw(500e6, alice, alice);
+        assertEq(usdc.balanceOf(alice), 600e6);
+    }
+
+    function test_DepositCap() public {
+        vm.prank(owner);
+        vault.setDepositCap(1_500e6);
+
+        _deposit(alice, 1_000e6);
+        assertEq(vault.maxDeposit(alice), 500e6);
+
+        usdc.mint(bob, 1_000e6);
+        vm.startPrank(bob);
+        usdc.approve(address(vault), 1_000e6);
+        vm.expectRevert(UsdcYieldVault.CapExceeded.selector);
+        vault.deposit(1_000e6, bob);
+        vault.deposit(500e6, bob);
+        vm.stopPrank();
+    }
+
+    /* ------------------------------- strategy ------------------------------- */
+
+    function test_SetStrategyValidatesWiring() public {
+        MockStrategy foreign = new MockStrategy(address(usdc), address(0xdead));
+        vm.prank(owner);
+        vm.expectRevert(UsdcYieldVault.StrategyMismatch.selector);
+        vault.setStrategy(address(foreign));
+
+        MockERC20 other = new MockERC20("Other", "OTH", 18);
+        MockStrategy wrongAsset = new MockStrategy(address(other), address(vault));
+        vm.prank(owner);
+        vm.expectRevert(UsdcYieldVault.StrategyMismatch.selector);
+        vault.setStrategy(address(wrongAsset));
+    }
+
+    function test_MigrationDrainsOldStrategy() public {
+        _deposit(alice, 1_000e6);
+        vm.prank(keeper);
+        vault.pushIdleToStrategy();
+
+        MockStrategy next = new MockStrategy(address(usdc), address(vault));
+        vm.prank(owner);
+        vault.setStrategy(address(next));
+
+        assertEq(vault.strategy(), address(next));
+        assertEq(usdc.balanceOf(address(strat)), 0);
+        assertEq(vault.idleAssets(), 1_000e6);
+        assertEq(vault.totalAssets(), 1_000e6);
+    }
+
+    function test_MigrationRevertsIfOldStrategyKeepsFunds() public {
+        _deposit(alice, 1_000e6);
+        vm.prank(keeper);
+        vault.pushIdleToStrategy();
+        strat.setLiquidity(5_000); // refuses to return everything
+
+        MockStrategy next = new MockStrategy(address(usdc), address(vault));
+        vm.prank(owner);
+        vm.expectRevert(UsdcYieldVault.StrategyNotEmpty.selector);
+        vault.setStrategy(address(next));
+    }
+
+    function test_SweepProtectsTheAsset() public {
+        vm.prank(owner);
+        vm.expectRevert(UsdcYieldVault.ProtectedToken.selector);
+        vault.sweep(address(usdc), owner);
+
+        MockERC20 airdrop = new MockERC20("Air", "AIR", 18);
+        airdrop.mint(address(vault), 5e18);
+        vm.prank(owner);
+        vault.sweep(address(airdrop), owner);
+        assertEq(airdrop.balanceOf(owner), 5e18);
+    }
+}
