+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+import {Script} from "forge-std/Script.sol";
+import {console2} from "forge-std/console2.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+
+import {YieldVault} from "../src/YieldVault.sol";
+import {AerodromeUsdcWethStrategy} from "../src/strategies/AerodromeUsdcWethStrategy.sol";
+import {BaseAddresses} from "../src/BaseAddresses.sol";
+import {IAerodromeRouter, IAerodromeVoter, IAerodromeGauge} from "../src/interfaces/IAerodrome.sol";
+
+/// @notice Deploys the vault and its Aerodrome strategy to Base.
+///
+/// Required environment:
+///   PRIVATE_KEY   deployer key
+///   OWNER         multisig / timelock that will own both contracts
+///   TREASURY      recipient of performance fee shares
+///   KEEPER        address allowed to call `vault.harvest()`
+/// Optional:
+///   DEPOSIT_CAP   initial cap on totalAssets, in USDC units (default: 250,000 USDC)
+///
+/// Usage:
+///   forge script script/Deploy.s.sol:Deploy --rpc-url base --broadcast --verify
+contract Deploy is Script {
+    function run() external returns (YieldVault vault, AerodromeUsdcWethStrategy strategy) {
+        require(block.chainid == BaseAddresses.CHAIN_ID, "not Base");
+
+        address owner = vm.envAddress("OWNER");
+        address treasury = vm.envAddress("TREASURY");
+        address keeper = vm.envAddress("KEEPER");
+        uint256 depositCap = vm.envOr("DEPOSIT_CAP", uint256(250_000e6));
+
+        // Resolve the pool and its gauge on-chain instead of trusting a pasted address.
+        address pool = IAerodromeRouter(BaseAddresses.AERODROME_ROUTER)
+            .poolFor(BaseAddresses.USDC, BaseAddresses.WETH, false, BaseAddresses.AERODROME_POOL_FACTORY);
+        address gauge = IAerodromeVoter(BaseAddresses.AERODROME_VOTER).gauges(pool);
+        require(gauge != address(0), "pool has no gauge");
+        require(IAerodromeVoter(BaseAddresses.AERODROME_VOTER).isAlive(gauge), "gauge not receiving emissions");
+        require(IAerodromeGauge(gauge).stakingToken() == pool, "gauge/pool mismatch");
+
+        uint256 pk = vm.envUint("PRIVATE_KEY");
+        address deployer = vm.addr(pk);
+
+        vm.startBroadcast(pk);
+
+        // The vault is deployed owned by the deployer so it can be wired up in one run; the last
+        // step hands it to `owner` (which then has to `acceptOwnership`). Note this must be
+        // `vm.addr(pk)` and not `msg.sender`, which inside a script is the default sender rather
+        // than the broadcasting key.
+        vault = new YieldVault(IERC20(BaseAddresses.USDC), "Yield USDC", "yvUSDC", deployer, treasury);
+
+        strategy = new AerodromeUsdcWethStrategy(
+            AerodromeUsdcWethStrategy.Config({
+                vault: address(vault),
+                usdc: BaseAddresses.USDC,
+                weth: BaseAddresses.WETH,
+                aero: BaseAddresses.AERO,
+                router: BaseAddresses.AERODROME_ROUTER,
+                gauge: gauge,
+                usdcUsdFeed: BaseAddresses.USDC_USD_FEED,
+                ethUsdFeed: BaseAddresses.ETH_USD_FEED,
+                aeroUsdFeed: BaseAddresses.AERO_USD_FEED,
+                usdcFeedHeartbeat: BaseAddresses.USDC_USD_HEARTBEAT,
+                ethFeedHeartbeat: BaseAddresses.ETH_USD_HEARTBEAT,
+                aeroFeedHeartbeat: BaseAddresses.AERO_USD_HEARTBEAT
+            }),
+            owner,
+            rewardRoute()
+        );
+
+        vault.setStrategy(strategy);
+        vault.setKeeper(keeper, true);
+        vault.setDepositCap(depositCap);
+        vault.transferOwnership(owner);
+
+        vm.stopBroadcast();
+
+        console2.log("vault      ", address(vault));
+        console2.log("strategy   ", address(strategy));
+        console2.log("pool       ", pool);
+        console2.log("gauge      ", gauge);
+        console2.log("owner      ", owner, "(must call acceptOwnership on both)");
+    }
+
+    /// @notice AERO -> USDC in one hop through the volatile AERO/USDC pool.
+    function rewardRoute() public pure returns (IAerodromeRouter.Route[] memory route) {
+        route = new IAerodromeRouter.Route[](1);
+        route[0] = IAerodromeRouter.Route({
+            from: BaseAddresses.AERO,
+            to: BaseAddresses.USDC,
+            stable: false,
+            factory: BaseAddresses.AERODROME_POOL_FACTORY
+        });
+    }
+}
