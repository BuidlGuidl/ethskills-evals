+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+
+import {IAerodromeGauge} from "../../src/interfaces/IAerodrome.sol";
+
+/// @notice Gauge mock: stakes LP and pays a reward token pro-rata. Tests drive emissions with
+///         {notifyRewardAmount} instead of the real gauge's time-based `rewardRate`.
+contract MockAerodromeGauge is IAerodromeGauge {
+    using SafeERC20 for IERC20;
+
+    uint256 private constant ACC_PRECISION = 1e30;
+
+    address public immutable override stakingToken;
+    address public immutable override rewardToken;
+
+    uint256 public totalStaked;
+    uint256 public accRewardPerShare;
+
+    mapping(address => uint256) public override balanceOf;
+    mapping(address => uint256) private _rewardDebt;
+    mapping(address => uint256) private _accrued;
+
+    constructor(address stakingToken_, address rewardToken_) {
+        stakingToken = stakingToken_;
+        rewardToken = rewardToken_;
+    }
+
+    /// @notice Distributes `amount` of reward token to current stakers. Pulled from the caller.
+    function notifyRewardAmount(uint256 amount) external {
+        require(totalStaked > 0, "NO_STAKE");
+        IERC20(rewardToken).safeTransferFrom(msg.sender, address(this), amount);
+        accRewardPerShare += amount * ACC_PRECISION / totalStaked;
+    }
+
+    function deposit(uint256 amount) external override {
+        _settle(msg.sender);
+        IERC20(stakingToken).safeTransferFrom(msg.sender, address(this), amount);
+        balanceOf[msg.sender] += amount;
+        totalStaked += amount;
+        _sync(msg.sender);
+    }
+
+    function withdraw(uint256 amount) external override {
+        _settle(msg.sender);
+        balanceOf[msg.sender] -= amount;
+        totalStaked -= amount;
+        _sync(msg.sender);
+        IERC20(stakingToken).safeTransfer(msg.sender, amount);
+    }
+
+    function getReward(address account) external override {
+        _settle(account);
+        _sync(account);
+        uint256 owed = _accrued[account];
+        if (owed == 0) return;
+        _accrued[account] = 0;
+        IERC20(rewardToken).safeTransfer(account, owed);
+    }
+
+    function earned(address account) public view override returns (uint256) {
+        return _accrued[account] + (balanceOf[account] * accRewardPerShare / ACC_PRECISION) - _rewardDebt[account];
+    }
+
+    function _settle(address account) private {
+        _accrued[account] = earned(account);
+    }
+
+    function _sync(address account) private {
+        _rewardDebt[account] = balanceOf[account] * accRewardPerShare / ACC_PRECISION;
+    }
+}
diff --git a/test/mocks/MockAerodromePool.sol b/test/mocks/MockAerodromePool.sol
new file mode 100644
index 0000000..e3d25b3
--- /dev/null
+++ b/test/mocks/MockAerodromePool.sol
@@ -0,0 +1,110 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+import {ERC20} from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+import {Math} from "@openzeppelin/contracts/utils/math/Math.sol";
+
+/// @notice Constant-product pool that mirrors Aerodrome's volatile (xy=k) pool semantics closely
+///         enough to exercise the strategy: same fee model (fee skimmed off `amountIn`), same
+///         `getReserves`/`mint`/`burn`/`swap` shapes, same MINIMUM_LIQUIDITY lock.
+contract MockAerodromePool is ERC20 {
+    using SafeERC20 for IERC20;
+
+    uint256 public constant MINIMUM_LIQUIDITY = 1000;
+
+    address public immutable token0;
+    address public immutable token1;
+    bool public constant stable = false;
+
+    /// @notice Swap fee in bps taken off the input amount (Aerodrome volatile pools are ~0.30%).
+    uint256 public feeBps;
+
+    uint256 private _reserve0;
+    uint256 private _reserve1;
+    uint256 private _blockTimestampLast;
+
+    constructor(address tokenA, address tokenB, uint256 feeBps_) ERC20("Aerodrome Volatile LP", "vAMM-LP") {
+        (token0, token1) = tokenA < tokenB ? (tokenA, tokenB) : (tokenB, tokenA);
+        feeBps = feeBps_;
+    }
+
+    function setFeeBps(uint256 f) external {
+        feeBps = f;
+    }
+
+    function getReserves() external view returns (uint256, uint256, uint256) {
+        return (_reserve0, _reserve1, _blockTimestampLast);
+    }
+
+    function mint(address to) external returns (uint256 liquidity) {
+        uint256 balance0 = IERC20(token0).balanceOf(address(this));
+        uint256 balance1 = IERC20(token1).balanceOf(address(this));
+        uint256 amount0 = balance0 - _reserve0;
+        uint256 amount1 = balance1 - _reserve1;
+
+        uint256 supply = totalSupply();
+        if (supply == 0) {
+            liquidity = Math.sqrt(amount0 * amount1) - MINIMUM_LIQUIDITY;
+            _mint(address(1), MINIMUM_LIQUIDITY); // permanently locked
+        } else {
+            liquidity = Math.min(amount0 * supply / _reserve0, amount1 * supply / _reserve1);
+        }
+        require(liquidity > 0, "INSUFFICIENT_LIQUIDITY_MINTED");
+        _mint(to, liquidity);
+        _update(balance0, balance1);
+    }
+
+    function burn(address to) external returns (uint256 amount0, uint256 amount1) {
+        uint256 liquidity = balanceOf(address(this));
+        uint256 supply = totalSupply();
+        amount0 = liquidity * IERC20(token0).balanceOf(address(this)) / supply;
+        amount1 = liquidity * IERC20(token1).balanceOf(address(this)) / supply;
+        require(amount0 > 0 && amount1 > 0, "INSUFFICIENT_LIQUIDITY_BURNED");
+
+        _burn(address(this), liquidity);
+        IERC20(token0).safeTransfer(to, amount0);
+        IERC20(token1).safeTransfer(to, amount1);
+        _update(IERC20(token0).balanceOf(address(this)), IERC20(token1).balanceOf(address(this)));
+    }
+
+    function swap(uint256 amount0Out, uint256 amount1Out, address to, bytes calldata) external {
+        require(amount0Out > 0 || amount1Out > 0, "INSUFFICIENT_OUTPUT");
+        require(amount0Out < _reserve0 && amount1Out < _reserve1, "INSUFFICIENT_LIQUIDITY");
+
+        if (amount0Out > 0) IERC20(token0).safeTransfer(to, amount0Out);
+        if (amount1Out > 0) IERC20(token1).safeTransfer(to, amount1Out);
+
+        uint256 balance0 = IERC20(token0).balanceOf(address(this));
+        uint256 balance1 = IERC20(token1).balanceOf(address(this));
+        uint256 amount0In = balance0 > _reserve0 - amount0Out ? balance0 - (_reserve0 - amount0Out) : 0;
+        uint256 amount1In = balance1 > _reserve1 - amount1Out ? balance1 - (_reserve1 - amount1Out) : 0;
+        require(amount0In > 0 || amount1In > 0, "INSUFFICIENT_INPUT");
+
+        // Aerodrome takes the fee out of the input, so k must not shrink once fees are removed.
+        uint256 adjusted0 = balance0 - (amount0In * feeBps / 10_000);
+        uint256 adjusted1 = balance1 - (amount1In * feeBps / 10_000);
+        require(adjusted0 * adjusted1 >= _reserve0 * _reserve1, "K");
+
+        _update(balance0, balance1);
+    }
+
+    /// @notice Aerodrome-style quote used by the router mock.
+    function getAmountOut(uint256 amountIn, address tokenIn) public view returns (uint256) {
+        uint256 amountInAfterFee = amountIn - (amountIn * feeBps / 10_000);
+        (uint256 reserveIn, uint256 reserveOut) = tokenIn == token0 ? (_reserve0, _reserve1) : (_reserve1, _reserve0);
+        return amountInAfterFee * reserveOut / (reserveIn + amountInAfterFee);
+    }
+
+    /// @notice Simulates accrued swap fees / donations landing in the pool.
+    function sync() external {
+        _update(IERC20(token0).balanceOf(address(this)), IERC20(token1).balanceOf(address(this)));
+    }
+
+    function _update(uint256 balance0, uint256 balance1) private {
+        _reserve0 = balance0;
+        _reserve1 = balance1;
+        _blockTimestampLast = block.timestamp;
+    }
+}
diff --git a/test/mocks/MockAerodromeRouter.sol b/test/mocks/MockAerodromeRouter.sol
new file mode 100644
index 0000000..bf7e867
--- /dev/null
+++ b/test/mocks/MockAerodromeRouter.sol
@@ -0,0 +1,145 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+
+import {IAerodromeRouter} from "../../src/interfaces/IAerodrome.sol";
+import {MockAerodromePool} from "./MockAerodromePool.sol";
+
+/// @notice Router mock implementing the Aerodrome/Velodrome V2 add/remove/swap flow used by the
+///         strategy, including the optimal-ratio quoting that leaves dust on one side.
+contract MockAerodromeRouter is IAerodromeRouter {
+    using SafeERC20 for IERC20;
+
+    address public immutable override defaultFactory;
+
+    mapping(bytes32 => address) private _pools;
+
+    constructor(address factory_) {
+        defaultFactory = factory_;
+    }
+
+    function registerPool(address tokenA, address tokenB, bool stable, address pool) external {
+        _pools[_key(tokenA, tokenB, stable)] = pool;
+    }
+
+    function poolFor(address tokenA, address tokenB, bool stable, address) public view override returns (address) {
+        return _pools[_key(tokenA, tokenB, stable)];
+    }
+
+    function addLiquidity(
+        address tokenA,
+        address tokenB,
+        bool stable,
+        uint256 amountADesired,
+        uint256 amountBDesired,
+        uint256 amountAMin,
+        uint256 amountBMin,
+        address to,
+        uint256 deadline
+    ) external override returns (uint256 amountA, uint256 amountB, uint256 liquidity) {
+        require(deadline >= block.timestamp, "EXPIRED");
+        address pool = poolFor(tokenA, tokenB, stable, defaultFactory);
+        require(pool != address(0), "NO_POOL");
+
+        (amountA, amountB) = _quoteAdd(MockAerodromePool(pool), tokenA, amountADesired, amountBDesired);
+        require(amountA >= amountAMin && amountB >= amountBMin, "INSUFFICIENT_AMOUNT");
+
+        liquidity = _pullAndMint(pool, tokenA, tokenB, amountA, amountB, to);
+    }
+
+    function _pullAndMint(address pool, address tokenA, address tokenB, uint256 amountA, uint256 amountB, address to)
+        private
+        returns (uint256)
+    {
+        IERC20(tokenA).safeTransferFrom(msg.sender, pool, amountA);
+        IERC20(tokenB).safeTransferFrom(msg.sender, pool, amountB);
+        return MockAerodromePool(pool).mint(to);
+    }
+
+    function removeLiquidity(
+        address tokenA,
+        address tokenB,
+        bool stable,
+        uint256 liquidity,
+        uint256 amountAMin,
+        uint256 amountBMin,
+        address to,
+        uint256 deadline
+    ) external override returns (uint256 amountA, uint256 amountB) {
+        require(deadline >= block.timestamp, "EXPIRED");
+        MockAerodromePool pool = MockAerodromePool(poolFor(tokenA, tokenB, stable, defaultFactory));
+        require(address(pool) != address(0), "NO_POOL");
+
+        IERC20(address(pool)).safeTransferFrom(msg.sender, address(pool), liquidity);
+        (uint256 amount0, uint256 amount1) = pool.burn(to);
+        (amountA, amountB) = tokenA == pool.token0() ? (amount0, amount1) : (amount1, amount0);
+        require(amountA >= amountAMin && amountB >= amountBMin, "INSUFFICIENT_AMOUNT");
+    }
+
+    function swapExactTokensForTokens(
+        uint256 amountIn,
+        uint256 amountOutMin,
+        Route[] calldata routes,
+        address to,
+        uint256 deadline
+    ) external override returns (uint256[] memory amounts) {
+        require(deadline >= block.timestamp, "EXPIRED");
+        amounts = getAmountsOut(amountIn, routes);
+        require(amounts[amounts.length - 1] >= amountOutMin, "INSUFFICIENT_OUTPUT_AMOUNT");
+
+        IERC20(routes[0].from)
+            .safeTransferFrom(
+                msg.sender, poolFor(routes[0].from, routes[0].to, routes[0].stable, defaultFactory), amounts[0]
+            );
+
+        for (uint256 i; i < routes.length; ++i) {
+            MockAerodromePool pool =
+                MockAerodromePool(poolFor(routes[i].from, routes[i].to, routes[i].stable, defaultFactory));
+            address recipient = i < routes.length - 1
+                ? poolFor(routes[i + 1].from, routes[i + 1].to, routes[i + 1].stable, defaultFactory)
+                : to;
+            (uint256 amount0Out, uint256 amount1Out) =
+                routes[i].from == pool.token0() ? (uint256(0), amounts[i + 1]) : (amounts[i + 1], uint256(0));
+            pool.swap(amount0Out, amount1Out, recipient, "");
+        }
+    }
+
+    function getAmountsOut(uint256 amountIn, Route[] memory routes)
+        public
+        view
+        override
+        returns (uint256[] memory amounts)
+    {
+        amounts = new uint256[](routes.length + 1);
+        amounts[0] = amountIn;
+        for (uint256 i; i < routes.length; ++i) {
+            MockAerodromePool pool =
+                MockAerodromePool(poolFor(routes[i].from, routes[i].to, routes[i].stable, defaultFactory));
+            require(address(pool) != address(0), "NO_POOL");
+            amounts[i + 1] = pool.getAmountOut(amounts[i], routes[i].from);
+        }
+    }
+
+    function _quoteAdd(MockAerodromePool pool, address tokenA, uint256 amountADesired, uint256 amountBDesired)
+        private
+        view
+        returns (uint256 amountA, uint256 amountB)
+    {
+        (uint256 r0, uint256 r1,) = pool.getReserves();
+        if (r0 == 0 && r1 == 0) return (amountADesired, amountBDesired);
+
+        (uint256 reserveA, uint256 reserveB) = tokenA == pool.token0() ? (r0, r1) : (r1, r0);
+        uint256 amountBOptimal = amountADesired * reserveB / reserveA;
+        if (amountBOptimal <= amountBDesired) return (amountADesired, amountBOptimal);
+
+        uint256 amountAOptimal = amountBDesired * reserveA / reserveB;
+        return (amountAOptimal, amountBDesired);
+    }
+
+    function _key(address tokenA, address tokenB, bool stable) private pure returns (bytes32) {
+        (address t0, address t1) = tokenA < tokenB ? (tokenA, tokenB) : (tokenB, tokenA);
+        return keccak256(abi.encode(t0, t1, stable));
+    }
+}
