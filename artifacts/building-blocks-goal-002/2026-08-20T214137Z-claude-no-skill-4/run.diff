+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+import {Test} from "forge-std/Test.sol";
+
+import {ChainlinkLib} from "../../src/libraries/ChainlinkLib.sol";
+import {IAggregatorV3} from "../../src/interfaces/IAggregatorV3.sol";
+import {MockAggregator} from "../mocks/MockAggregator.sol";
+
+contract ChainlinkHarness {
+    function readPrice(IAggregatorV3 feed, uint256 maxAge) external view returns (uint256) {
+        return ChainlinkLib.readPrice(feed, maxAge);
+    }
+}
+
+contract ChainlinkLibTest is Test {
+    ChainlinkHarness harness;
+    MockAggregator feed;
+
+    function setUp() public {
+        vm.warp(1_700_000_000);
+        harness = new ChainlinkHarness();
+        feed = new MockAggregator(8, 3000e8, "ETH / USD");
+    }
+
+    function test_readsFreshPrice() public view {
+        assertEq(harness.readPrice(IAggregatorV3(address(feed)), 1 hours), 3000e8);
+    }
+
+    function test_scalesUpLowerDecimalFeeds() public {
+        MockAggregator sixDp = new MockAggregator(6, 3000e6, "ETH / USD (6dp)");
+        assertEq(harness.readPrice(IAggregatorV3(address(sixDp)), 1 hours), 3000e8);
+    }
+
+    function test_revertsOnStalePrice() public {
+        vm.warp(block.timestamp + 2 hours);
+        vm.expectRevert(
+            abi.encodeWithSelector(ChainlinkLib.StalePrice.selector, address(feed), block.timestamp - 2 hours)
+        );
+        harness.readPrice(IAggregatorV3(address(feed)), 1 hours);
+    }
+
+    function test_revertsOnIncompleteRound() public {
+        feed.setUpdatedAt(0);
+        vm.expectRevert(abi.encodeWithSelector(ChainlinkLib.StalePrice.selector, address(feed), 0));
+        harness.readPrice(IAggregatorV3(address(feed)), 1 hours);
+    }
+
+    function test_revertsOnFutureTimestamp() public {
+        uint256 future = block.timestamp + 1;
+        feed.setUpdatedAt(future);
+        vm.expectRevert(abi.encodeWithSelector(ChainlinkLib.StalePrice.selector, address(feed), future));
+        harness.readPrice(IAggregatorV3(address(feed)), 1 hours);
+    }
+
+    function test_revertsOnNonPositiveAnswer() public {
+        feed.setAnswer(0);
+        vm.expectRevert(abi.encodeWithSelector(ChainlinkLib.InvalidPrice.selector, address(feed), int256(0)));
+        harness.readPrice(IAggregatorV3(address(feed)), 1 hours);
+
+        feed.setAnswer(-1);
+        vm.expectRevert(abi.encodeWithSelector(ChainlinkLib.InvalidPrice.selector, address(feed), int256(-1)));
+        harness.readPrice(IAggregatorV3(address(feed)), 1 hours);
+    }
+
+    function test_revertsOnTooManyDecimals() public {
+        MockAggregator wide = new MockAggregator(18, 3000e18, "ETH / USD (18dp)");
+        vm.expectRevert(abi.encodeWithSelector(ChainlinkLib.UnsupportedFeedDecimals.selector, address(wide), uint8(18)));
+        harness.readPrice(IAggregatorV3(address(wide)), 1 hours);
+    }
+}
diff --git a/test/unit/FairLpMath.t.sol b/test/unit/FairLpMath.t.sol
new file mode 100644
index 0000000..3e1a6cc
--- /dev/null
+++ b/test/unit/FairLpMath.t.sol
@@ -0,0 +1,123 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+import {Test} from "forge-std/Test.sol";
+import {Math} from "@openzeppelin/contracts/utils/math/Math.sol";
+
+import {FairLpMath} from "../../src/libraries/FairLpMath.sol";
+
+/// @dev `FairLpMath` is an internal library, so reverts need an external call frame to assert on.
+contract FairLpMathHarness {
+    function lpValueUsd(FairLpMath.PoolState memory s, uint256 lpAmount) external pure returns (uint256) {
+        return FairLpMath.lpValueUsd(s, lpAmount);
+    }
+}
+
+contract FairLpMathTest is Test {
+    uint256 constant USDC_UNIT = 1e6;
+    uint256 constant WAD = 1e18;
+
+    /// @dev 3,000,000 USDC + 1,000 WETH at $1 / $3000 => a $6,000,000 pool.
+    function _balancedPool() internal pure returns (FairLpMath.PoolState memory s) {
+        s.reserve0 = 3_000_000 * USDC_UNIT;
+        s.reserve1 = 1_000 * WAD;
+        s.decimals0 = 6;
+        s.decimals1 = 18;
+        s.price0 = 1e8;
+        s.price1 = 3000e8;
+        s.totalSupply = Math.sqrt(s.reserve0 * s.reserve1);
+    }
+
+    function test_valuesBalancedPoolAtSumOfLegs() public pure {
+        FairLpMath.PoolState memory s = _balancedPool();
+        uint256 total = FairLpMath.lpValueUsd(s, s.totalSupply);
+        assertApproxEqRel(total, 6_000_000 * WAD, 1e12, "pool value");
+    }
+
+    function test_valuesProRata() public pure {
+        FairLpMath.PoolState memory s = _balancedPool();
+        uint256 half = FairLpMath.lpValueUsd(s, s.totalSupply / 2);
+        assertApproxEqRel(half, 3_000_000 * WAD, 1e12, "half the LP is half the value");
+    }
+
+    /// @notice The point of the fair-reserves formula: moving the pool's spot price without changing
+    ///         `k` must not change the valuation. A naive `reserve * price` sum would move a lot.
+    function test_valuationIsInvariantToReserveManipulation() public pure {
+        FairLpMath.PoolState memory s = _balancedPool();
+        uint256 fairBefore = FairLpMath.lpValueUsd(s, s.totalSupply);
+
+        // Simulate an attacker dumping USDC into the pool: reserve0 quadruples, reserve1 quarters,
+        // so k is untouched but the spot price has moved 16x.
+        FairLpMath.PoolState memory manipulated = s;
+        manipulated.reserve0 = s.reserve0 * 4;
+        manipulated.reserve1 = s.reserve1 / 4;
+
+        uint256 fairAfter = FairLpMath.lpValueUsd(manipulated, s.totalSupply);
+        assertApproxEqRel(fairAfter, fairBefore, 1e12, "fair value must not move");
+
+        // For contrast, the naive spot valuation would report a wildly different number.
+        uint256 naive = (manipulated.reserve0 * 1e12 * manipulated.price0 / 1e8)
+            + (manipulated.reserve1 * manipulated.price1 / 1e8);
+        assertGt(naive, fairBefore * 15 / 10, "naive spot pricing is inflated by the manipulation");
+    }
+
+    /// @notice k grows as swap fees accrue; the fair value must grow with it.
+    function test_valuationTracksFeeAccrual() public pure {
+        FairLpMath.PoolState memory s = _balancedPool();
+        uint256 before = FairLpMath.lpValueUsd(s, s.totalSupply);
+
+        FairLpMath.PoolState memory grown = s;
+        grown.reserve0 = s.reserve0 * 101 / 100;
+        grown.reserve1 = s.reserve1 * 101 / 100;
+
+        assertApproxEqRel(FairLpMath.lpValueUsd(grown, s.totalSupply), before * 101 / 100, 1e12);
+    }
+
+    function test_returnsZeroForEmptyInputs() public pure {
+        FairLpMath.PoolState memory s = _balancedPool();
+        assertEq(FairLpMath.lpValueUsd(s, 0), 0);
+
+        FairLpMath.PoolState memory empty = s;
+        empty.reserve0 = 0;
+        assertEq(FairLpMath.lpValueUsd(empty, s.totalSupply), 0);
+    }
+
+    function test_revertsOnZeroSupply() public {
+        FairLpMathHarness harness = new FairLpMathHarness();
+        FairLpMath.PoolState memory s = _balancedPool();
+        s.totalSupply = 0;
+        vm.expectRevert(FairLpMath.ZeroSupply.selector);
+        harness.lpValueUsd(s, 1);
+    }
+
+    function test_tokenValueRoundTrip() public pure {
+        uint256 usd = FairLpMath.tokenValueUsd(1_500 * USDC_UNIT, 6, 1e8);
+        assertEq(usd, 1_500 * WAD);
+        assertEq(FairLpMath.usdToToken(usd, 6, 1e8), 1_500 * USDC_UNIT);
+
+        uint256 ethUsd = FairLpMath.tokenValueUsd(2 * WAD, 18, 3000e8);
+        assertEq(ethUsd, 6_000 * WAD);
+        assertEq(FairLpMath.usdToToken(ethUsd, 18, 3000e8), 2 * WAD);
+    }
+
+    /// @notice Whatever the reserves, the fair value only depends on k and the prices.
+    function testFuzz_invariantToPriceMoveAtConstantK(uint256 reserve0, uint256 reserve1, uint256 shift) public pure {
+        reserve0 = bound(reserve0, 1_000 * USDC_UNIT, 100_000_000 * USDC_UNIT);
+        reserve1 = bound(reserve1, 1 * WAD, 100_000 * WAD);
+        shift = bound(shift, 2, 50);
+
+        FairLpMath.PoolState memory s = _balancedPool();
+        s.reserve0 = reserve0;
+        s.reserve1 = reserve1;
+        s.totalSupply = Math.sqrt(reserve0 * reserve1 * 1e12);
+
+        FairLpMath.PoolState memory moved = s;
+        moved.reserve0 = reserve0 * shift;
+        moved.reserve1 = reserve1 / shift;
+
+        uint256 a = FairLpMath.lpValueUsd(s, s.totalSupply);
+        uint256 b = FairLpMath.lpValueUsd(moved, s.totalSupply);
+        // Only integer-division truncation of `reserve1 / shift` separates the two.
+        assertApproxEqRel(b, a, 1e15, "fair value drifted");
+    }
+}
diff --git a/test/unit/Strategy.t.sol b/test/unit/Strategy.t.sol
new file mode 100644
index 0000000..254ac72
