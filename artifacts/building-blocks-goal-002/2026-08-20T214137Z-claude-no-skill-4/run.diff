+++ b/test/fork/BaseFork.t.sol
@@ -0,0 +1,288 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {IERC20Metadata} from "@openzeppelin/contracts/token/ERC20/extensions/IERC20Metadata.sol";
+
+import {YieldVault} from "../../src/YieldVault.sol";
+import {AerodromeUsdcWethStrategy} from "../../src/strategies/AerodromeUsdcWethStrategy.sol";
+import {BaseAddresses} from "../../src/BaseAddresses.sol";
+import {ChainlinkLib} from "../../src/libraries/ChainlinkLib.sol";
+import {IAggregatorV3} from "../../src/interfaces/IAggregatorV3.sol";
+import {IAerodromeRouter, IAerodromePool, IAerodromeGauge, IAerodromeVoter} from "../../src/interfaces/IAerodrome.sol";
+import {PoolArb} from "../helpers/PoolArb.sol";
+
+/// @notice Runs the real thing against live Base state. Skipped unless BASE_RPC_URL is set:
+///
+///     BASE_RPC_URL=https://mainnet.base.org forge test --match-path 'test/fork/*'
+///
+/// These are the tests that check the constants in {BaseAddresses} are still correct, that the
+/// Aerodrome interfaces in `src/interfaces` match the deployed ABIs, and that a full
+/// deposit -> harvest -> withdraw cycle works against the actual pool and gauge.
+contract BaseForkTest is PoolArb {
+    uint256 internal constant USDC_UNIT = 1e6;
+
+    address internal owner = makeAddr("owner");
+    address internal treasury = makeAddr("treasury");
+    address internal keeper = makeAddr("keeper");
+    address internal alice = makeAddr("alice");
+
+    IERC20 internal usdc = IERC20(BaseAddresses.USDC);
+    IAerodromePool internal pool;
+    IAerodromeGauge internal gauge;
+
+    YieldVault internal vault;
+    AerodromeUsdcWethStrategy internal strategy;
+
+    function setUp() public {
+        string memory rpc = vm.envOr("BASE_RPC_URL", string(""));
+        if (bytes(rpc).length == 0) {
+            vm.skip(true);
+            return;
+        }
+        vm.createSelectFork(rpc);
+
+        address poolAddr = IAerodromeRouter(BaseAddresses.AERODROME_ROUTER)
+            .poolFor(BaseAddresses.USDC, BaseAddresses.WETH, false, BaseAddresses.AERODROME_POOL_FACTORY);
+        pool = IAerodromePool(poolAddr);
+        gauge = IAerodromeGauge(IAerodromeVoter(BaseAddresses.AERODROME_VOTER).gauges(poolAddr));
+
+        vault = new YieldVault(usdc, "Yield USDC", "yvUSDC", owner, treasury);
+
+        IAerodromeRouter.Route[] memory route = new IAerodromeRouter.Route[](1);
+        route[0] = IAerodromeRouter.Route({
+            from: BaseAddresses.AERO,
+            to: BaseAddresses.USDC,
+            stable: false,
+            factory: BaseAddresses.AERODROME_POOL_FACTORY
+        });
+
+        strategy = new AerodromeUsdcWethStrategy(
+            AerodromeUsdcWethStrategy.Config({
+                vault: address(vault),
+                usdc: BaseAddresses.USDC,
+                weth: BaseAddresses.WETH,
+                aero: BaseAddresses.AERO,
+                router: BaseAddresses.AERODROME_ROUTER,
+                gauge: address(gauge),
+                usdcUsdFeed: BaseAddresses.USDC_USD_FEED,
+                ethUsdFeed: BaseAddresses.ETH_USD_FEED,
+                aeroUsdFeed: BaseAddresses.AERO_USD_FEED,
+                usdcFeedHeartbeat: BaseAddresses.USDC_USD_HEARTBEAT,
+                ethFeedHeartbeat: BaseAddresses.ETH_USD_HEARTBEAT,
+                aeroFeedHeartbeat: BaseAddresses.AERO_USD_HEARTBEAT
+            }),
+            owner,
+            route
+        );
+
+        vm.startPrank(owner);
+        vault.setStrategy(strategy);
+        vault.setKeeper(keeper, true);
+        vm.stopPrank();
+    }
+
+    function test_fork_addressConstantsResolve() public view {
+        assertEq(block.chainid, BaseAddresses.CHAIN_ID, "wrong chain");
+        assertEq(IERC20Metadata(BaseAddresses.USDC).symbol(), "USDC");
+        assertEq(IERC20Metadata(BaseAddresses.USDC).decimals(), 6);
+        assertEq(IERC20Metadata(BaseAddresses.WETH).symbol(), "WETH");
+        assertEq(IERC20Metadata(BaseAddresses.AERO).symbol(), "AERO");
+
+        assertEq(
+            IAerodromeRouter(BaseAddresses.AERODROME_ROUTER).defaultFactory(),
+            BaseAddresses.AERODROME_POOL_FACTORY,
+            "router's default factory changed"
+        );
+
+        assertTrue(address(pool) != address(0), "USDC/WETH volatile pool not found");
+        assertFalse(pool.stable());
+        assertTrue(address(gauge) != address(0), "pool is not gauged");
+        assertTrue(IAerodromeVoter(BaseAddresses.AERODROME_VOTER).isAlive(address(gauge)), "gauge is dead");
+        assertEq(gauge.stakingToken(), address(pool));
+        assertEq(gauge.rewardToken(), BaseAddresses.AERO);
+    }
+
+    function test_fork_priceFeedsAreLiveAndSane() public view {
+        assertEq(IAggregatorV3(BaseAddresses.ETH_USD_FEED).decimals(), 8);
+        assertEq(IAggregatorV3(BaseAddresses.USDC_USD_FEED).decimals(), 8);
+        assertEq(IAggregatorV3(BaseAddresses.AERO_USD_FEED).decimals(), 8);
+
+        uint256 eth = ChainlinkLib.readPrice(IAggregatorV3(BaseAddresses.ETH_USD_FEED), 1 days);
+        uint256 usd = ChainlinkLib.readPrice(IAggregatorV3(BaseAddresses.USDC_USD_FEED), 2 days);
+        uint256 aero = ChainlinkLib.readPrice(IAggregatorV3(BaseAddresses.AERO_USD_FEED), 2 days);
+
+        assertGt(eth, 100e8, "ETH under $100 - wrong feed?");
+        assertLt(eth, 1_000_000e8);
+        assertApproxEqRel(usd, 1e8, 0.05e18, "USDC is not near $1");
+        assertGt(aero, 0);
+        assertLt(aero, 1_000e8);
+    }
+
+    /// @notice The fair-reserves valuation should agree with the pool's own spot valuation while the
+    ///         pool is arbitraged, which it is on a live fork.
+    function test_fork_lpValuationMatchesSpot() public view {
+        (uint256 r0, uint256 r1,) = pool.getReserves();
+        uint256 ethPrice = ChainlinkLib.readPrice(IAggregatorV3(BaseAddresses.ETH_USD_FEED), 1 days);
+        uint256 usdcPrice = ChainlinkLib.readPrice(IAggregatorV3(BaseAddresses.USDC_USD_FEED), 2 days);
+
+        (uint256 usdcReserve, uint256 wethReserve) = pool.token0() == BaseAddresses.USDC ? (r0, r1) : (r1, r0);
+
+        uint256 spotUsd = usdcReserve * usdcPrice / 1e8 + (wethReserve * ethPrice / 1e8) / 1e12;
+        uint256 fairUsdc = _totalPoolValueAsUsdc();
+
+        assertApproxEqRel(fairUsdc, spotUsd, 0.02e18, "fair value disagrees with an arbitraged pool");
+    }
+
+    function test_fork_depositHarvestWithdrawCycle() public {
+        uint256 amount = 50_000 * USDC_UNIT;
+        deal(BaseAddresses.USDC, alice, amount);
+
+        vm.startPrank(alice);
+        usdc.approve(address(vault), amount);
+        vault.deposit(amount, alice);
+        vm.stopPrank();
+
+        assertEq(vault.totalAssets(), amount);
+
+        vm.prank(keeper);
+        vault.harvest();
+
+        assertGt(gauge.balanceOf(address(strategy)), 0, "LP is staked in the live gauge");
+        assertApproxEqRel(vault.totalAssets(), amount, 0.01e18, "entering the pool cost under 1%");
+
+        // Let real emissions accrue, then compound them. Chainlink cannot post inside a fork, so
+        // stand in for the rounds that would have landed during those three days; likewise nothing
+        // arbitrages the pool back after our own entry swap, so do that too.
+        vm.warp(block.timestamp + 3 days);
+        vm.roll(block.number + 3 days / 2);
+        _refreshFeeds();
+        _arbPoolToOracle();
+
+        uint256 pending = strategy.pendingRewards();
+        emit log_named_decimal_uint("AERO earned over 3 days", pending, 18);
+
+        vm.prank(keeper);
+        (uint256 rewards,,) = vault.harvest();
+        if (pending > 1e18) {
+            assertGt(rewards, 0, "emissions should convert to USDC");
+            assertGt(vault.balanceOf(treasury), 0, "performance fee minted");
+        }
+
+        // The live vAMM pool holds only ~$8M, so one transaction can unwind roughly
+        // `2 * maxTradeReserveBps` of it. Exit half here; the chunked path for a full exit is
+        // covered in test/integration/Lifecycle.t.sol.
+        uint256 half = vault.balanceOf(alice) / 2;
+        uint256 quoted = vault.previewRedeem(half);
+        vm.prank(alice);
+        uint256 got = vault.redeem(half, alice, alice);
+
+        assertEq(got, quoted, "redeem must match previewRedeem exactly");
+        assertApproxEqRel(got, amount / 2, 0.02e18, "round trip within 2% of principal");
+    }
+
+    /// @notice Documents the live pool's per-transaction capacity: an exit larger than the strategy
+    ///         can unwind in one call is refused with the amount that is actually available, rather
+    ///         than filled at a bad price.
+    function test_fork_oversizedExitIsRefusedNotFilledBadly() public {
+        uint256 amount = 200_000 * USDC_UNIT;
+        deal(BaseAddresses.USDC, alice, amount);
+
+        vm.startPrank(alice);
+        usdc.approve(address(vault), amount);
+        vault.deposit(amount, alice);
+        vm.stopPrank();
+
+        vm.prank(keeper);
+        vault.harvest();
+
+        // Deploy the balance over several keeper passes, as the depth cap requires.
+        for (uint256 i; i < 8; ++i) {
+            _arbPoolToOracle();
+            vm.prank(keeper);
+            vault.harvest();
+        }
+        _arbPoolToOracle();
+        assertGt(strategy.totalLpBalance(), 0);
+
+        uint256 shares = vault.balanceOf(alice);
+        vm.prank(alice);
+        vm.expectPartialRevert(YieldVault.InsufficientLiquidity.selector);
+        vault.redeem(shares, alice, alice);
+
+        // A chunk inside that capacity clears immediately, so exits are staged rather than blocked.
+        vm.prank(alice);
+        vault.withdraw(25_000 * USDC_UNIT, alice, alice);
+        assertEq(usdc.balanceOf(alice), 25_000 * USDC_UNIT);
+        assertGt(vault.balanceOf(alice), 0, "the rest stays invested for the next transaction");
+    }
+
+    /// @dev See {PoolArb}.
+    function _arbPoolToOracle() internal {
+        _arbToOracle(
+            PoolArb.Venue({
+                router: IAerodromeRouter(BaseAddresses.AERODROME_ROUTER),
+                pool: pool,
+                factory: BaseAddresses.AERODROME_POOL_FACTORY,
+                usdc: BaseAddresses.USDC,
+                weth: BaseAddresses.WETH,
+                usdcPrice: ChainlinkLib.readPrice(IAggregatorV3(BaseAddresses.USDC_USD_FEED), 2 days),
+                ethPrice: ChainlinkLib.readPrice(IAggregatorV3(BaseAddresses.ETH_USD_FEED), 1 days)
+            })
+        );
+    }
+
+    function test_fork_withdrawSkipsTheDexWhenTheBufferCovers() public {
+        uint256 amount = 100_000 * USDC_UNIT;
+        deal(BaseAddresses.USDC, alice, amount);
+
+        vm.startPrank(alice);
+        usdc.approve(address(vault), amount);
+        vault.deposit(amount, alice);
+        vm.stopPrank();
+
+        vm.prank(keeper);
+        vault.harvest();
+
+        uint256 lpBefore = strategy.totalLpBalance();
+        vm.prank(alice);
+        vault.withdraw(1_000 * USDC_UNIT, alice, alice);
+
+        assertEq(strategy.totalLpBalance(), lpBefore, "served from the idle buffer");
+        assertEq(usdc.balanceOf(alice), 1_000 * USDC_UNIT);
+    }
+
+    /// @dev Re-posts each feed's latest answer at the current timestamp.
+    function _refreshFeeds() internal {
+        address[3] memory feeds = [BaseAddresses.ETH_USD_FEED, BaseAddresses.USDC_USD_FEED, BaseAddresses.AERO_USD_FEED];
+        for (uint256 i; i < feeds.length; ++i) {
+            (uint80 roundId, int256 answer,,,) = IAggregatorV3(feeds[i]).latestRoundData();
+            vm.mockCall(
+                feeds[i],
+                abi.encodeWithSelector(IAggregatorV3.latestRoundData.selector),
+                abi.encode(roundId, answer, block.timestamp, block.timestamp, roundId)
+            );
+        }
+    }
+
+    /// @dev The whole pool valued the way the strategy values its slice of it.
+    function _totalPoolValueAsUsdc() internal view returns (uint256) {
+        (uint256 r0, uint256 r1,) = pool.getReserves();
+        uint256 ethPrice = ChainlinkLib.readPrice(IAggregatorV3(BaseAddresses.ETH_USD_FEED), 1 days);
+        uint256 usdcPrice = ChainlinkLib.readPrice(IAggregatorV3(BaseAddresses.USDC_USD_FEED), 2 days);
+
+        bool usdcIsToken0 = pool.token0() == BaseAddresses.USDC;
+        FairLpMathShim.PoolState memory s = FairLpMathShim.PoolState({
+            reserve0: r0,
+            reserve1: r1,
+            totalSupply: pool.totalSupply(),
+            price0: usdcIsToken0 ? usdcPrice : ethPrice,
+            price1: usdcIsToken0 ? ethPrice : usdcPrice,
+            decimals0: usdcIsToken0 ? 6 : 18,
+            decimals1: usdcIsToken0 ? 18 : 6
+        });
+        return FairLpMathShim.usdToToken(FairLpMathShim.lpValueUsd(s, s.totalSupply), 6, usdcPrice);
+    }
+}
+
+import {FairLpMath as FairLpMathShim} from "../../src/libraries/FairLpMath.sol";
diff --git a/test/helpers/PoolArb.sol b/test/helpers/PoolArb.sol
new file mode 100644
index 0000000..bf68307
--- /dev/null
+++ b/test/helpers/PoolArb.sol
@@ -0,0 +1,56 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+import {Test} from "forge-std/Test.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {Math} from "@openzeppelin/contracts/utils/math/Math.sol";
+
+import {IAerodromeRouter, IAerodromePool} from "../../src/interfaces/IAerodrome.sol";
+
+/// @notice Stands in for the arbitrageurs that keep a live pool pinned to the market price.
+/// @dev The strategy's own swaps leave the pool roughly `2 x tradeSize` away from the oracle. On
+///      Base that gap is closed within a block or two; in a test nothing closes it, so consecutive
+///      harvests would drift further and further out and trip the slippage guard for reasons that
+///      never occur in production. Both the local suite and the fork suite call this between
+///      keeper passes so they measure the strategy, not the absence of arbitrage.
+abstract contract PoolArb is Test {
+    struct Venue {
+        IAerodromeRouter router;
+        IAerodromePool pool;
+        address factory;
+        address usdc;
+        address weth;
+        uint256 usdcPrice; // 8 decimals
+        uint256 ethPrice; // 8 decimals
+    }
+
+    function _arbToOracle(Venue memory v) internal {
+        (uint256 r0, uint256 r1,) = v.pool.getReserves();
+        (uint256 reserveUsdc, uint256 reserveWeth) = v.pool.token0() == v.usdc ? (r0, r1) : (r1, r0);
+
+        // Constant-product reserves that would price ETH at the oracle: r0' = sqrt(k * p1/p0).
+        uint256 usdc18 = reserveUsdc * 1e12;
+        uint256 k = usdc18 * reserveWeth;
+        uint256 priceWad = Math.mulDiv(v.ethPrice, 1e18, v.usdcPrice);
+        uint256 targetUsdc18 = Math.sqrt(Math.mulDiv(k, priceWad, 1e18));
+
+        if (targetUsdc18 > usdc18) {
+            uint256 amountIn = (targetUsdc18 - usdc18) / 1e12;
+            if (amountIn < 1e4) return; // already aligned to within a cent
+            _swap(v, v.usdc, v.weth, amountIn);
+        } else {
+            uint256 targetWeth = k / targetUsdc18;
+            if (targetWeth <= reserveWeth + 1e12) return;
+            _swap(v, v.weth, v.usdc, targetWeth - reserveWeth);
+        }
+    }
+
+    function _swap(Venue memory v, address tokenIn, address tokenOut, uint256 amountIn) private {
+        deal(tokenIn, address(this), IERC20(tokenIn).balanceOf(address(this)) + amountIn);
+        IERC20(tokenIn).approve(address(v.router), amountIn);
+
+        IAerodromeRouter.Route[] memory route = new IAerodromeRouter.Route[](1);
+        route[0] = IAerodromeRouter.Route({from: tokenIn, to: tokenOut, stable: false, factory: v.factory});
+        v.router.swapExactTokensForTokens(amountIn, 0, route, address(this), block.timestamp);
+    }
+}
diff --git a/test/integration/Lifecycle.t.sol b/test/integration/Lifecycle.t.sol
new file mode 100644
index 0000000..cb5f10d
--- /dev/null
+++ b/test/integration/Lifecycle.t.sol
@@ -0,0 +1,182 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+import {BaseTest} from "../BaseTest.sol";
+
+/// @notice End-to-end behaviour across many depositors, harvests and exits.
+contract LifecycleTest is BaseTest {
+    address internal carol = makeAddr("carol");
+
+    /// @dev One keeper cycle: emissions accrue, the keeper compounds, arbitrageurs realign the pool.
+    function _cycle(uint256 aeroEmitted) internal {
+        vm.warp(block.timestamp + 12 hours);
+        _refreshFeeds();
+        if (aeroEmitted != 0 && gauge.totalStaked() > 0) _emitRewards(aeroEmitted);
+        vm.prank(keeper);
+        vault.harvest();
+        _arbPoolToOracle();
+    }
+
+    function test_sharePriceRisesOnceTheCapitalIsDeployed() public {
+        _deposit(alice, 200_000 * USDC_UNIT);
+        _cycle(0); // first pass just moves USDC into the LP
+
+        uint256 last = vault.convertToAssets(1e18);
+        assertLt(last, 1e6, "entering the LP costs the pool fee plus price impact, once");
+
+        for (uint256 i; i < 6; ++i) {
+            _cycle(2_000 * WAD);
+            uint256 current = vault.convertToAssets(1e18);
+            assertGe(current, last, "share price regressed on harvest");
+            last = current;
+        }
+
+        assertGt(last, 1e6, "emissions more than repaid the entry cost");
+    }
+
+    function test_lateDepositorDoesNotDiluteEarlierYield() public {
+        _deposit(alice, 100_000 * USDC_UNIT);
+        _cycle(0);
+        uint256 aliceValueBefore = vault.convertToAssets(vault.balanceOf(alice));
+        _cycle(5_000 * WAD);
+
+        uint256 alicePerShare = vault.convertToAssets(1e18);
+
+        // Bob arrives after the yield has already been booked.
+        uint256 bobShares = _deposit(bob, 100_000 * USDC_UNIT);
+        assertApproxEqRel(vault.convertToAssets(bobShares), 100_000 * USDC_UNIT, 1e12, "bob pays the live price");
+        assertEq(vault.convertToAssets(1e18), alicePerShare, "his deposit does not move the price");
+
+        assertGt(vault.convertToAssets(vault.balanceOf(alice)), aliceValueBefore, "alice keeps her yield");
+    }
+
+    function test_threeDepositorsExitInFull() public {
+        _deposit(alice, 150_000 * USDC_UNIT);
+        _cycle(0);
+        _cycle(3_000 * WAD);
+        _deposit(bob, 250_000 * USDC_UNIT);
+        _cycle(3_000 * WAD);
+        _deposit(carol, 100_000 * USDC_UNIT);
+        _cycle(3_000 * WAD);
+
+        address[3] memory users = [alice, bob, carol];
+        for (uint256 i; i < users.length; ++i) {
+            uint256 got = _exitInChunks(users[i], 3);
+            assertEq(usdc.balanceOf(users[i]), got);
+        }
+
+        // Everyone is out; only the treasury's fee shares remain.
+        assertEq(vault.balanceOf(alice) + vault.balanceOf(bob) + vault.balanceOf(carol), 0);
+        assertEq(vault.totalSupply(), vault.balanceOf(treasury));
+        assertGt(vault.balanceOf(treasury), 0);
+
+        // Each depositor came out ahead of principal despite the fees and two pool round trips.
+        assertGt(usdc.balanceOf(alice), 150_000 * USDC_UNIT);
+        assertGt(usdc.balanceOf(bob), 250_000 * USDC_UNIT);
+    }
+
+    function test_treasuryFeeIsRedeemable() public {
+        _deposit(alice, 200_000 * USDC_UNIT);
+        _cycle(0);
+        _cycle(10_000 * WAD);
+        _cycle(10_000 * WAD);
+
+        uint256 feeShares = vault.balanceOf(treasury);
+        assertGt(feeShares, 0);
+
+        vm.prank(treasury);
+        uint256 got = vault.redeem(feeShares, treasury, treasury);
+        assertGt(got, 1_500 * USDC_UNIT, "roughly 10% of ~20,000 USDC of emissions");
+        assertLt(got, 2_100 * USDC_UNIT);
+    }
+
+    /// @notice A flash-loan sandwich: deposit, wrench the pool, redeem in the same transaction.
+    ///         Oracle-based accounting plus the withdrawal fee must leave the attacker down.
+    function test_flashDepositManipulationIsNotProfitable() public {
+        _deposit(alice, 500_000 * USDC_UNIT);
+        _cycle(1_000 * WAD);
+
+        uint256 attackCapital = 2_000_000 * USDC_UNIT;
+        usdc.mint(bob, attackCapital);
+
+        vm.startPrank(bob);
+        usdc.approve(address(vault), type(uint256).max);
+        uint256 shares = vault.deposit(attackCapital, bob);
+        vm.stopPrank();
+
+        _pushPriceWithUsdc(12_000_000 * USDC_UNIT); // 40% of the USDC reserve
+
+        vm.prank(bob);
+        vault.redeem(shares, bob, bob);
+
+        assertLt(usdc.balanceOf(bob), attackCapital, "manipulation must not pay");
+    }
+
+    /// @notice Yield must never let a holder redeem more than their pro-rata slice.
+    function testFuzz_redemptionNeverExceedsProRataShare(uint256 aliceIn, uint256 bobIn, uint256 emissions) public {
+        aliceIn = bound(aliceIn, 100 * USDC_UNIT, 500_000 * USDC_UNIT);
+        bobIn = bound(bobIn, 100 * USDC_UNIT, 500_000 * USDC_UNIT);
+        emissions = bound(emissions, 0, 20_000 * WAD);
+
+        _deposit(alice, aliceIn);
+        _deposit(bob, bobIn);
+        _cycle(emissions);
+
+        uint256 aliceShares = vault.balanceOf(alice);
+        uint256 proRata = vault.totalAssets() * aliceShares / vault.totalSupply();
+
+        vm.prank(alice);
+        uint256 got = vault.redeem(aliceShares, alice, alice);
+        assertLe(got, proRata, "redeemed more than the share was worth");
+
+        // And whatever is left still covers Bob and the treasury.
+        assertGe(vault.totalAssets() + 1, vault.convertToAssets(vault.totalSupply()));
+    }
+
+    function test_emergencyExitThenMigrate() public {
+        _deposit(alice, 300_000 * USDC_UNIT);
+        _cycle(5_000 * WAD);
+        _cycle(5_000 * WAD);
+
+        uint256 assetsBefore = vault.totalAssets();
+
+        // Stop compounding, unwind in stages, then retire the strategy entirely.
+        vm.prank(owner);
+        strategy.setEmergencyExit(true);
+        _drainStrategy();
+        vm.prank(owner);
+        vault.setStrategy(IStrategyNone(address(0)));
+
+        assertEq(strategy.totalLpBalance(), 0);
+        assertApproxEqRel(vault.idleAssets(), assetsBefore, 0.01e18, "value came back as USDC");
+
+        // Users can still exit normally against the idle balance.
+        uint256 shares = vault.balanceOf(alice);
+        vm.prank(alice);
+        uint256 got = vault.redeem(shares, alice, alice);
+        assertGt(got, 300_000 * USDC_UNIT);
+    }
+
+    /// @notice A single redemption can only unwind so much of the pool. Oversized exits revert with
+    ///         the amount that is actually available, and clear in chunks.
+    function test_oversizedExitRevertsThenClearsInChunks() public {
+        _deposit(alice, 1_000_000 * USDC_UNIT);
+        _cycle(0);
+        _cycle(0);
+        _cycle(0);
+
+        uint256 shares = vault.balanceOf(alice);
+        uint256 wanted = vault.previewRedeem(shares);
+
+        vm.prank(alice);
+        vm.expectPartialRevert(YieldVaultErrors.InsufficientLiquidity.selector);
+        vault.redeem(shares, alice, alice);
+
+        uint256 got = _exitInChunks(alice, 10);
+        assertEq(vault.balanceOf(alice), 0);
+        assertApproxEqRel(got, wanted, 0.01e18, "chunked exit returns essentially the same value");
+    }
+}
+
+import {IStrategy as IStrategyNone} from "../../src/interfaces/IStrategy.sol";
+import {YieldVault as YieldVaultErrors} from "../../src/YieldVault.sol";
