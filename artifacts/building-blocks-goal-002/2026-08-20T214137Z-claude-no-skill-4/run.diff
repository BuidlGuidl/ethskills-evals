+++ b/test/unit/Strategy.t.sol
@@ -0,0 +1,392 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+import {Ownable} from "@openzeppelin/contracts/access/Ownable.sol";
+
+import {BaseTest} from "../BaseTest.sol";
+import {AerodromeUsdcWethStrategy} from "../../src/strategies/AerodromeUsdcWethStrategy.sol";
+import {IAerodromeRouter} from "../../src/interfaces/IAerodrome.sol";
+import {ChainlinkLib} from "../../src/libraries/ChainlinkLib.sol";
+import {MockAerodromeGauge} from "../mocks/MockAerodromeGauge.sol";
+import {MockAerodromePool} from "../mocks/MockAerodromePool.sol";
+
+contract StrategyTest is BaseTest {
+    /// @dev Deposits and runs one keeper pass so the strategy holds a live LP position.
+    function _seedPosition(uint256 amount) internal {
+        _deposit(alice, amount);
+        vm.prank(keeper);
+        vault.harvest();
+    }
+
+    // ---------------------------------------------------------------- wiring
+
+    function test_constructorWiring() public view {
+        assertEq(strategy.vault(), address(vault));
+        assertEq(strategy.asset(), address(usdc));
+        assertEq(address(strategy.pool()), address(pool));
+        assertEq(address(strategy.gauge()), address(gauge));
+        assertEq(strategy.poolFactory(), factory);
+
+        IAerodromeRouter.Route[] memory route = strategy.rewardRoute();
+        assertEq(route.length, 1);
+        assertEq(route[0].from, address(aero));
+        assertEq(route[0].to, address(usdc));
+        assertFalse(route[0].stable);
+    }
+
+    function test_constructorRejectsGaugeForAnotherPool() public {
+        MockAerodromePool wrongPool = new MockAerodromePool(address(aero), address(weth), POOL_FEE_BPS);
+        MockAerodromeGauge wrongGauge = new MockAerodromeGauge(address(wrongPool), address(aero));
+
+        vm.expectRevert(AerodromeUsdcWethStrategy.BadPool.selector);
+        new AerodromeUsdcWethStrategy(_config(address(wrongGauge)), owner, _route());
+    }
+
+    function test_setRewardRouteRejectsNonExistentPool() public {
+        IAerodromeRouter.Route[] memory ghost = new IAerodromeRouter.Route[](1);
+        // Well-formed AERO -> USDC, but through a factory that has no such pool deployed.
+        ghost[0] = IAerodromeRouter.Route({
+            from: address(aero), to: address(usdc), stable: true, factory: makeAddr("otherFactory")
+        });
+
+        vm.prank(owner);
+        vm.expectRevert(AerodromeUsdcWethStrategy.BadRewardRoute.selector);
+        strategy.setRewardRoute(ghost);
+    }
+
+    function test_constructorRejectsBadRewardRoute() public {
+        IAerodromeRouter.Route[] memory bad = new IAerodromeRouter.Route[](1);
+        // Ends in WETH rather than the vault asset.
+        bad[0] = IAerodromeRouter.Route({from: address(aero), to: address(weth), stable: false, factory: factory});
+
+        vm.expectRevert(AerodromeUsdcWethStrategy.BadRewardRoute.selector);
+        new AerodromeUsdcWethStrategy(_config(address(gauge)), owner, bad);
+    }
+
+    // ---------------------------------------------------------------- invest
+
+    function test_investStakesLpAndPreservesValue() public {
+        _seedPosition(100_000 * USDC_UNIT);
+
+        assertGt(strategy.totalLpBalance(), 0, "LP minted");
+        assertEq(gauge.balanceOf(address(strategy)), strategy.totalLpBalance(), "all LP is staked");
+        assertEq(pool.balanceOf(address(strategy)), 0, "nothing left unstaked");
+
+        // 95,000 deployed; a 47,500 USDC swap into a 30M USDC reserve plus the 0.3% pool fee.
+        assertApproxEqRel(vault.totalAssets(), 100_000 * USDC_UNIT, 0.003e18, "round-trip cost stays small");
+    }
+
+    function test_investIsCappedByPoolDepth() public {
+        // 0.25% of the 30M USDC reserve = 75,000 USDC per swap, so ~150,000 USDC deploys per call.
+        _deposit(alice, 5_000_000 * USDC_UNIT);
+        vm.prank(keeper);
+        vault.harvest();
+
+        // Undeployed USDC waits in the strategy: still counted, still withdrawable without slippage.
+        uint256 waiting = usdc.balanceOf(address(strategy));
+        uint256 deployed = strategy.estimatedTotalAssets() - waiting;
+        assertApproxEqRel(deployed, 150_000 * USDC_UNIT, 0.02e18, "~2 x 0.25% of the USDC reserve");
+        assertGt(waiting, 4_000_000 * USDC_UNIT, "the rest queues for the next pass");
+
+        uint256 lpAfterFirst = strategy.totalLpBalance();
+        _arbPoolToOracle();
+
+        vm.prank(keeper);
+        vault.harvest();
+        assertGt(strategy.totalLpBalance(), lpAfterFirst, "the next pass deploys more");
+        assertLt(usdc.balanceOf(address(strategy)), waiting);
+    }
+
+    function test_investIsNoOpBelowThreshold() public {
+        _deposit(alice, 100 * USDC_UNIT);
+        vm.prank(owner);
+        strategy.setThresholds(1_000 * USDC_UNIT, 1e18);
+
+        vm.prank(keeper);
+        vault.harvest();
+        assertEq(strategy.totalLpBalance(), 0, "dust is not worth the gas");
+    }
+
+    function test_investIsVaultOnly() public {
+        vm.prank(alice);
+        vm.expectRevert(abi.encodeWithSelector(AerodromeUsdcWethStrategy.NotVault.selector, alice));
+        strategy.invest();
+    }
+
+    // ---------------------------------------------------------------- harvest
+
+    function test_harvestCompoundsRewardsAndPaysFee() public {
+        _seedPosition(100_000 * USDC_UNIT);
+
+        uint256 assetsBefore = vault.totalAssets();
+        uint256 lpBefore = strategy.totalLpBalance();
+
+        _emitRewards(5_000 * WAD); // 5,000 AERO at $1
+        assertApproxEqAbs(strategy.pendingRewards(), 5_000 * WAD, 1e12);
+
+        vm.prank(keeper);
+        (uint256 rewards, uint256 feeShares,) = vault.harvest();
+
+        // ~5,000 USDC of rewards, less the AERO/USDC pool's own fee and impact.
+        assertApproxEqRel(rewards, 5_000 * USDC_UNIT, 0.02e18, "rewards realised in USDC");
+        assertGt(feeShares, 0, "treasury paid");
+        assertEq(vault.balanceOf(treasury), feeShares);
+
+        assertGt(strategy.totalLpBalance(), lpBefore, "rewards were compounded back into the LP");
+        assertGt(vault.totalAssets(), assetsBefore + 4_000 * USDC_UNIT, "share price rose");
+
+        // The 10% performance fee is worth ~10% of the harvest.
+        assertApproxEqRel(vault.previewRedeem(feeShares), rewards / 10, 0.01e18);
+    }
+
+    function test_harvestSkipsDustRewards() public {
+        _seedPosition(100_000 * USDC_UNIT);
+        _emitRewards(0.5e18); // below minHarvestAero
+
+        vm.prank(keeper);
+        (uint256 rewards, uint256 feeShares,) = vault.harvest();
+        assertEq(rewards, 0);
+        assertEq(feeShares, 0);
+    }
+
+    function test_harvestPicksUpPoolTradingFees() public {
+        _seedPosition(100_000 * USDC_UNIT);
+        uint256 before = vault.totalAssets();
+
+        // Swap fees accrue inside the pool: k grows, so every LP token is worth more.
+        _accrueTradingFees(300_000 * USDC_UNIT, 100 * WAD);
+
+        assertGt(vault.totalAssets(), before, "LP appreciation shows up without a harvest");
+    }
+
+    function test_harvestWithZeroFee() public {
+        vm.prank(owner);
+        vault.setPerformanceFee(0);
+        _seedPosition(100_000 * USDC_UNIT);
+        _emitRewards(1_000 * WAD);
+
+        vm.prank(keeper);
+        (, uint256 feeShares,) = vault.harvest();
+        assertEq(feeShares, 0);
+        assertEq(vault.balanceOf(treasury), 0);
+    }
+
+    function test_harvestIsVaultOnly() public {
+        vm.prank(keeper);
+        vm.expectRevert(abi.encodeWithSelector(AerodromeUsdcWethStrategy.NotVault.selector, keeper));
+        strategy.harvest();
+    }
+
+    function test_emergencyExitStopsReinvesting() public {
+        _seedPosition(100_000 * USDC_UNIT);
+        uint256 lpBefore = strategy.totalLpBalance();
+
+        vm.prank(owner);
+        strategy.setEmergencyExit(true);
+        _emitRewards(1_000 * WAD);
+
+        vm.prank(keeper);
+        (uint256 rewards,,) = vault.harvest();
+
+        assertGt(rewards, 0, "rewards are still claimed and converted");
+        assertEq(strategy.totalLpBalance(), lpBefore, "but nothing new is added to the LP");
+    }
+
+    // ---------------------------------------------------------------- withdraw
+
+    function test_withdrawUnwindsJustEnough() public {
+        _seedPosition(100_000 * USDC_UNIT);
+        uint256 lpBefore = strategy.totalLpBalance();
+
+        uint256 shares = vault.previewWithdraw(50_000 * USDC_UNIT);
+        vm.prank(alice);
+        vault.withdraw(50_000 * USDC_UNIT, alice, alice);
+
+        assertEq(usdc.balanceOf(alice), 50_000 * USDC_UNIT);
+        assertGt(strategy.totalLpBalance(), 0, "the rest of the position is untouched");
+        assertLt(strategy.totalLpBalance(), lpBefore);
+        assertEq(vault.balanceOf(alice), 100_000 * WAD - shares);
+    }
+
+    function test_smallWithdrawalIsServedFromTheBuffer() public {
+        _seedPosition(100_000 * USDC_UNIT);
+        uint256 lpBefore = strategy.totalLpBalance();
+
+        vm.prank(alice);
+        vault.withdraw(1_000 * USDC_UNIT, alice, alice);
+
+        assertEq(strategy.totalLpBalance(), lpBefore, "the 5% idle buffer covered it, no DEX round trip");
+    }
+
+    function test_fullExitReturnsPrincipalLessCosts() public {
+        _seedPosition(100_000 * USDC_UNIT);
+
+        uint256 shares = vault.balanceOf(alice);
+        vm.prank(alice);
+        uint256 out = vault.redeem(shares, alice, alice);
+
+        assertEq(vault.totalSupply(), 0);
+        // Principal back minus the 0.50% withdrawal fee and two pool round trips.
+        assertApproxEqRel(out, 100_000 * USDC_UNIT, 0.01e18);
+        assertLt(out, 100_000 * USDC_UNIT, "the round trip is not free");
+    }
+
+    function test_liquidateAllIsVaultOnly() public {
+        vm.prank(owner);
+        vm.expectRevert(abi.encodeWithSelector(AerodromeUsdcWethStrategy.NotVault.selector, owner));
+        strategy.liquidateAll();
+    }
+
+    function test_ownerCanUnwindInStages() public {
+        _seedPosition(600_000 * USDC_UNIT);
+        uint256 lp = strategy.totalLpBalance();
+        assertGt(lp, 0);
+
+        vm.prank(owner);
+        strategy.unwind(lp / 2);
+
+        assertApproxEqRel(strategy.totalLpBalance(), lp / 2, 0.001e18);
+        assertGt(usdc.balanceOf(address(strategy)), 0, "unwound value is held as idle USDC");
+    }
+
+    // ---------------------------------------------------------------- oracle guards
+
+    function test_stalePriceBlocksHarvest() public {
+        _seedPosition(100_000 * USDC_UNIT);
+        _emitRewards(1_000 * WAD);
+
+        uint256 postedAt = block.timestamp;
+        vm.warp(block.timestamp + 2 days);
+        // Only the AERO feed goes stale; the pair feeds are still being posted.
+        usdcFeed.setAnswer(USDC_PRICE);
+        ethFeed.setAnswer(ETH_PRICE);
+
+        vm.prank(keeper);
+        vm.expectRevert(abi.encodeWithSelector(ChainlinkLib.StalePrice.selector, address(aeroFeed), postedAt));
+        vault.harvest();
+    }
+
+    function test_stalePriceBlocksValuation() public {
+        _seedPosition(100_000 * USDC_UNIT);
+        vm.warp(block.timestamp + 1 hours); // ETH feed heartbeat is 20 minutes
+
+        vm.expectRevert(
+            abi.encodeWithSelector(ChainlinkLib.StalePrice.selector, address(ethFeed), block.timestamp - 1 hours)
+        );
+        vault.totalAssets();
+    }
+
+    /// @notice A flash-loan style price push must not change what the vault thinks it is worth.
+    function test_valuationSurvivesPoolManipulation() public {
+        _seedPosition(1_000_000 * USDC_UNIT);
+        uint256 before = strategy.estimatedTotalAssets();
+
+        _pushPriceWithUsdc(10_000_000 * USDC_UNIT); // ~33% of the USDC reserve, ETH spot moves ~78%
+
+        // Fees earned on that swap raise k slightly, so the position is worth a touch *more*.
+        assertGe(strategy.estimatedTotalAssets(), before);
+        assertApproxEqRel(strategy.estimatedTotalAssets(), before, 0.005e18, "no manipulation repricing");
+    }
+
+    /// @notice An oracle that disagrees with the pool must stop the strategy trading, not let it
+    ///         swap at the pool's price.
+    function test_swapRevertsWhenOracleDisagreesWithPool() public {
+        _deposit(alice, 100_000 * USDC_UNIT);
+        ethFeed.setAnswer(6000e8); // pool still prices ETH at 3000
+
+        // The swap itself looks cheap against the stale-high oracle, but pairing the WETH into the
+        // pool at the real price does not, so the add-liquidity value check is what stops it.
+        vm.prank(keeper);
+        vm.expectPartialRevert(AerodromeUsdcWethStrategy.SlippageExceeded.selector);
+        vault.harvest();
+    }
+
+    // ---------------------------------------------------------------- admin
+
+    function test_slippageAndTradeSizeBounds() public {
+        vm.startPrank(owner);
+
+        vm.expectRevert(abi.encodeWithSelector(AerodromeUsdcWethStrategy.SlippageTooHigh.selector, 501));
+        strategy.setMaxSlippage(501);
+        strategy.setMaxSlippage(500);
+        assertEq(strategy.maxSlippageBps(), 500);
+
+        vm.expectRevert(abi.encodeWithSelector(AerodromeUsdcWethStrategy.SlippageTooHigh.selector, 501));
+        strategy.setUnwindBuffer(501);
+
+        vm.expectRevert(abi.encodeWithSelector(AerodromeUsdcWethStrategy.TradeSizeTooHigh.selector, 0));
+        strategy.setMaxTradeReserve(0);
+        vm.expectRevert(abi.encodeWithSelector(AerodromeUsdcWethStrategy.TradeSizeTooHigh.selector, 1_001));
+        strategy.setMaxTradeReserve(1_001);
+        strategy.setMaxTradeReserve(200);
+        assertEq(strategy.maxTradeReserveBps(), 200);
+
+        vm.stopPrank();
+    }
+
+    function test_sweepProtectsPositionTokens() public {
+        vm.startPrank(owner);
+        vm.expectRevert(abi.encodeWithSelector(AerodromeUsdcWethStrategy.ProtectedToken.selector, address(usdc)));
+        strategy.sweep(address(usdc), owner);
+        vm.expectRevert(abi.encodeWithSelector(AerodromeUsdcWethStrategy.ProtectedToken.selector, address(weth)));
+        strategy.sweep(address(weth), owner);
+        vm.expectRevert(abi.encodeWithSelector(AerodromeUsdcWethStrategy.ProtectedToken.selector, address(aero)));
+        strategy.sweep(address(aero), owner);
+        vm.expectRevert(abi.encodeWithSelector(AerodromeUsdcWethStrategy.ProtectedToken.selector, address(pool)));
+        strategy.sweep(address(pool), owner);
+        vm.stopPrank();
+    }
+
+    function test_sweepRecoversStrayTokens() public {
+        MockERC20Stray stray = new MockERC20Stray();
+        stray.mint(address(strategy), 1e18);
+
+        vm.prank(owner);
+        strategy.sweep(address(stray), owner);
+        assertEq(stray.balanceOf(owner), 1e18);
+    }
+
+    function test_strategyAdminIsOwnerOnly() public {
+        bytes memory err = abi.encodeWithSelector(Ownable.OwnableUnauthorizedAccount.selector, alice);
+        vm.startPrank(alice);
+        vm.expectRevert(err);
+        strategy.setMaxSlippage(10);
+        vm.expectRevert(err);
+        strategy.setEmergencyExit(true);
+        vm.expectRevert(err);
+        strategy.setRewardRoute(_route());
+        vm.expectRevert(err);
+        strategy.unwind(1);
+        vm.stopPrank();
+    }
+
+    // ---------------------------------------------------------------- helpers
+
+    function _config(address gauge_) internal view returns (AerodromeUsdcWethStrategy.Config memory) {
+        return AerodromeUsdcWethStrategy.Config({
+            vault: address(vault),
+            usdc: address(usdc),
+            weth: address(weth),
+            aero: address(aero),
+            router: address(router),
+            gauge: gauge_,
+            usdcUsdFeed: address(usdcFeed),
+            ethUsdFeed: address(ethFeed),
+            aeroUsdFeed: address(aeroFeed),
+            usdcFeedHeartbeat: 1 days,
+            ethFeedHeartbeat: 20 minutes,
+            aeroFeedHeartbeat: 1 days
+        });
+    }
+
+    function _route() internal view returns (IAerodromeRouter.Route[] memory r) {
+        r = new IAerodromeRouter.Route[](1);
+        r[0] = IAerodromeRouter.Route({from: address(aero), to: address(usdc), stable: false, factory: factory});
+    }
+}
+
+import {MockERC20} from "../mocks/MockERC20.sol";
+
+contract MockERC20Stray is MockERC20 {
+    constructor() MockERC20("Airdrop", "AIR", 18) {}
+}
