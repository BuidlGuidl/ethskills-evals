+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+/// @title BaseAddresses
+/// @notice Canonical Base mainnet (chain id 8453) addresses used by the deployment.
+/// @dev Only the entry points are listed. The USDC/WETH pool and its gauge are *derived* at deploy
+///      time - the pool from `Router.poolFor` and the gauge from `Voter.gauges` - so a stale or
+///      mistyped pool address cannot end up in the strategy. `test/fork/BaseFork.t.sol` checks every
+///      constant below against a live fork.
+library BaseAddresses {
+    uint256 internal constant CHAIN_ID = 8453;
+
+    // --- tokens ---
+    address internal constant USDC = 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913;
+    address internal constant WETH = 0x4200000000000000000000000000000000000006;
+    address internal constant AERO = 0x940181a94A35A4569E4529A3CDfB74e38FD98631;
+
+    // --- Aerodrome ---
+    address internal constant AERODROME_ROUTER = 0xcF77a3Ba9A5CA399B7c97c74d54e5b1Beb874E43;
+    address internal constant AERODROME_POOL_FACTORY = 0x420DD381b31aEf6683db6B902084cB0FFECe40Da;
+    address internal constant AERODROME_VOTER = 0x16613524e02ad97eDfeF371bC883F2F5d6C480A5;
+
+    // --- Chainlink feeds (all 8 decimals) ---
+    address internal constant USDC_USD_FEED = 0x7e860098F58bBFC8648a4311b374B1D669a2bc6B;
+    address internal constant ETH_USD_FEED = 0x71041dddad3595F9CEd3DcCFBe3D1F4b0a16Bb70;
+    address internal constant AERO_USD_FEED = 0x4EC5970fC728C5f65ba413992CD5fF6FD70fcfF0;
+
+    // --- feed heartbeats, with headroom over the published deviation/heartbeat thresholds ---
+    uint256 internal constant USDC_USD_HEARTBEAT = 26 hours;
+    uint256 internal constant ETH_USD_HEARTBEAT = 30 minutes;
+    uint256 internal constant AERO_USD_HEARTBEAT = 26 hours;
+}
diff --git a/src/YieldVault.sol b/src/YieldVault.sol
new file mode 100644
index 0000000..2743e82
--- /dev/null
+++ b/src/YieldVault.sol
@@ -0,0 +1,315 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+import {ERC20} from "@openzeppelin/contracts/token/ERC20/ERC20.sol";
+import {ERC4626} from "@openzeppelin/contracts/token/ERC20/extensions/ERC4626.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {IERC20Metadata} from "@openzeppelin/contracts/token/ERC20/extensions/IERC20Metadata.sol";
+import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+import {Ownable, Ownable2Step} from "@openzeppelin/contracts/access/Ownable2Step.sol";
+import {Pausable} from "@openzeppelin/contracts/utils/Pausable.sol";
+import {ReentrancyGuard} from "@openzeppelin/contracts/utils/ReentrancyGuard.sol";
+import {Math} from "@openzeppelin/contracts/utils/math/Math.sol";
+
+import {IStrategy} from "./interfaces/IStrategy.sol";
+
+/// @title YieldVault
+/// @notice ERC-4626 vault denominated in USDC. Deposits sit idle until a keeper calls {harvest},
+///         which pushes everything above a liquidity buffer into the active strategy, compounds the
+///         strategy's rewards, and mints the performance fee to the treasury.
+///
+/// @dev Accounting notes:
+///  - `totalAssets()` prices the strategy position off Chainlink, not off DEX spot reserves, so a
+///    flash-loan sandwich of `deposit`/`redeem` cannot mint or burn shares at a distorted price.
+///    See {FairLpMath}.
+///  - Unwinding an LP position costs slippage. Rather than silently returning fewer assets than
+///    `previewRedeem` promised (which would break ERC-4626), the vault charges an explicit
+///    `withdrawalFeeBps` that is included in the preview functions. The fee is not transferred
+///    anywhere: it stays in the vault and covers the unwind cost, so remaining holders are not
+///    diluted by exiting holders. Only half of what the strategy unwinds has to be swapped, so
+///    `withdrawalFeeBps >= strategy.maxSlippageBps() / 2` is what makes an exit self-funding -
+///    including the last exit, where there is no position left to over-unwind against.
+contract YieldVault is ERC4626, Ownable2Step, Pausable, ReentrancyGuard {
+    using SafeERC20 for IERC20;
+    using Math for uint256;
+
+    uint256 public constant MAX_BPS = 10_000;
+    uint256 public constant MAX_PERFORMANCE_FEE_BPS = 2_000; // 20%
+    uint256 public constant MAX_WITHDRAWAL_FEE_BPS = 100; // 1%
+
+    /// @notice The strategy currently deploying vault assets. May be address(0) (all idle).
+    IStrategy public strategy;
+
+    /// @notice Addresses allowed to call {harvest}.
+    mapping(address => bool) public isKeeper;
+
+    /// @notice Recipient of performance fee shares.
+    address public treasury;
+
+    /// @notice Share of each harvest's realised rewards minted to the treasury, in bps.
+    uint256 public performanceFeeBps = 1_000; // 10%
+
+    /// @notice Charged on exit to cover strategy unwind slippage. Stays in the vault.
+    uint256 public withdrawalFeeBps = 50; // 0.50%, half of the strategy's 1% slippage ceiling
+
+    /// @notice Fraction of `totalAssets()` kept as idle USDC so small exits skip the DEX entirely.
+    uint256 public bufferBps = 500; // 5%
+
+    /// @notice Hard cap on `totalAssets()`. Deposits that would exceed it revert.
+    uint256 public depositCap = type(uint256).max;
+
+    event StrategyUpdated(address indexed oldStrategy, address indexed newStrategy, uint256 recovered);
+    event KeeperUpdated(address indexed keeper, bool allowed);
+    event TreasuryUpdated(address indexed treasury);
+    event PerformanceFeeUpdated(uint256 bps);
+    event WithdrawalFeeUpdated(uint256 bps);
+    event BufferUpdated(uint256 bps);
+    event DepositCapUpdated(uint256 cap);
+    event Harvested(address indexed keeper, uint256 rewardsUsdc, uint256 feeShares, uint256 deployed);
+
+    error ZeroAddress();
+    error FeeTooHigh(uint256 bps, uint256 max);
+    error BpsTooHigh(uint256 bps);
+    error NotKeeper(address caller);
+    error StrategyMismatch();
+    error StrategyStillFunded(uint256 remaining);
+    error InsufficientLiquidity(uint256 requested, uint256 available);
+    error DepositCapExceeded(uint256 totalAfter, uint256 cap);
+
+    modifier onlyKeeper() {
+        _requireKeeper();
+        _;
+    }
+
+    function _requireKeeper() internal view {
+        if (!isKeeper[msg.sender] && msg.sender != owner()) revert NotKeeper(msg.sender);
+    }
+
+    constructor(IERC20 asset_, string memory name_, string memory symbol_, address owner_, address treasury_)
+        ERC20(name_, symbol_)
+        ERC4626(asset_)
+        Ownable(owner_)
+    {
+        if (owner_ == address(0) || treasury_ == address(0)) revert ZeroAddress();
+        treasury = treasury_;
+        emit TreasuryUpdated(treasury_);
+    }
+
+    // ---------------------------------------------------------------------
+    // ERC-4626 accounting
+    // ---------------------------------------------------------------------
+
+    /// @dev 18-decimal shares over a 6-decimal asset. The 1e12 virtual-share offset also makes the
+    ///      classic ERC-4626 first-depositor inflation attack economically pointless.
+    function _decimalsOffset() internal pure override returns (uint8) {
+        return 12;
+    }
+
+    /// @inheritdoc ERC4626
+    function totalAssets() public view override returns (uint256) {
+        uint256 idle = IERC20(asset()).balanceOf(address(this));
+        IStrategy s = strategy;
+        return address(s) == address(0) ? idle : idle + s.estimatedTotalAssets();
+    }
+
+    /// @notice USDC held by the vault itself and immediately payable without touching the strategy.
+    function idleAssets() public view returns (uint256) {
+        return IERC20(asset()).balanceOf(address(this));
+    }
+
+    /// @inheritdoc ERC4626
+    /// @dev Net of `withdrawalFeeBps`.
+    function previewRedeem(uint256 shares) public view override returns (uint256) {
+        uint256 gross = _convertToAssets(shares, Math.Rounding.Floor);
+        return gross - gross.mulDiv(withdrawalFeeBps, MAX_BPS, Math.Rounding.Ceil);
+    }
+
+    /// @inheritdoc ERC4626
+    /// @dev Grossed up for `withdrawalFeeBps`, so `assets` is what the receiver actually gets.
+    function previewWithdraw(uint256 assets) public view override returns (uint256) {
+        uint256 gross = assets.mulDiv(MAX_BPS, MAX_BPS - withdrawalFeeBps, Math.Rounding.Ceil);
+        return _convertToShares(gross, Math.Rounding.Ceil);
+    }
+
+    /// @inheritdoc ERC4626
+    function maxWithdraw(address owner_) public view override returns (uint256) {
+        return previewRedeem(balanceOf(owner_));
+    }
+
+    /// @inheritdoc ERC4626
+    function maxDeposit(address) public view override returns (uint256) {
+        if (paused()) return 0;
+        uint256 total = totalAssets();
+        return total >= depositCap ? 0 : depositCap - total;
+    }
+
+    /// @inheritdoc ERC4626
+    function maxMint(address receiver) public view override returns (uint256) {
+        uint256 assets = maxDeposit(receiver);
+        return assets == type(uint256).max ? type(uint256).max : _convertToShares(assets, Math.Rounding.Floor);
+    }
+
+    // ---------------------------------------------------------------------
+    // Deposit / withdraw plumbing
+    // ---------------------------------------------------------------------
+
+    function _deposit(address caller, address receiver, uint256 assets, uint256 shares)
+        internal
+        override
+        whenNotPaused
+        nonReentrant
+    {
+        uint256 totalAfter = totalAssets() + assets;
+        if (totalAfter > depositCap) revert DepositCapExceeded(totalAfter, depositCap);
+        super._deposit(caller, receiver, assets, shares);
+    }
+
+    /// @dev Tops the vault up from the strategy when idle USDC is short of the requested amount.
+    function _withdraw(address caller, address receiver, address owner_, uint256 assets, uint256 shares)
+        internal
+        override
+        nonReentrant
+    {
+        uint256 idle = idleAssets();
+        if (idle < assets) {
+            IStrategy s = strategy;
+            if (address(s) != address(0)) {
+                s.withdraw(assets - idle);
+                idle = idleAssets();
+            }
+            if (idle < assets) revert InsufficientLiquidity(assets, idle);
+        }
+        super._withdraw(caller, receiver, owner_, assets, shares);
+    }
+
+    // ---------------------------------------------------------------------
+    // Keeper
+    // ---------------------------------------------------------------------
+
+    /// @notice Keeper entrypoint: claim and compound strategy rewards, then top the strategy up with
+    ///         idle deposits above the liquidity buffer.
+    /// @dev Rewards are compounded inside the strategy; the performance fee is taken as freshly
+    ///      minted shares, which dilutes holders by exactly the fee's asset value.
+    /// @return rewardsUsdc USDC-denominated value of the rewards realised by this harvest.
+    /// @return feeShares Shares minted to the treasury.
+    /// @return deployed Idle USDC pushed into the strategy.
+    function harvest()
+        external
+        onlyKeeper
+        nonReentrant
+        returns (uint256 rewardsUsdc, uint256 feeShares, uint256 deployed)
+    {
+        IStrategy s = strategy;
+        if (address(s) == address(0)) revert ZeroAddress();
+
+        // Push idle deposits first so the strategy deploys them and the compounded rewards in a
+        // single pass, rather than making two separate (and separately price-impacting) swaps.
+        deployed = _pushIdle(s);
+
+        rewardsUsdc = s.harvest();
+
+        if (rewardsUsdc != 0 && performanceFeeBps != 0) {
+            uint256 feeAssets = rewardsUsdc.mulDiv(performanceFeeBps, MAX_BPS, Math.Rounding.Floor);
+            // Converted after the harvest, so `feeShares` is worth `feeAssets` at the post-harvest
+            // share price and existing holders keep the remaining profit.
+            feeShares = _convertToShares(feeAssets, Math.Rounding.Floor);
+            if (feeShares != 0) _mint(treasury, feeShares);
+        }
+
+        emit Harvested(msg.sender, rewardsUsdc, feeShares, deployed);
+    }
+
+    /// @notice Pushes idle USDC above the buffer into the strategy without harvesting rewards.
+    function deployIdle() external onlyKeeper nonReentrant returns (uint256 deployed) {
+        IStrategy s = strategy;
+        if (address(s) == address(0)) revert ZeroAddress();
+        deployed = _pushIdle(s);
+        s.invest();
+    }
+
+    /// @dev Moves everything above the liquidity buffer to the strategy. Deploying it is the
+    ///      caller's job, so a harvest can batch the transfer and the investment into one pass.
+    function _pushIdle(IStrategy s) internal returns (uint256 deployed) {
+        if (paused()) return 0;
+        uint256 idle = idleAssets();
+        uint256 target = totalAssets().mulDiv(bufferBps, MAX_BPS, Math.Rounding.Ceil);
+        if (idle <= target) return 0;
+
+        deployed = idle - target;
+        IERC20(asset()).safeTransfer(address(s), deployed);
+    }
+
+    // ---------------------------------------------------------------------
+    // Admin
+    // ---------------------------------------------------------------------
+
+    /// @notice Retires the current strategy (pulling everything back to the vault) and installs a new one.
+    /// @param newStrategy The replacement, or address(0) to park the vault fully in idle USDC.
+    function setStrategy(IStrategy newStrategy) external onlyOwner nonReentrant {
+        IStrategy old = strategy;
+        uint256 recovered;
+
+        if (address(old) != address(0)) {
+            recovered = old.liquidateAll();
+            uint256 remaining = old.estimatedTotalAssets();
+            // A little dust is expected (LP rounding); anything material means the unwind failed.
+            if (remaining > _dustThreshold()) revert StrategyStillFunded(remaining);
+        }
+
+        if (address(newStrategy) != address(0)) {
+            if (newStrategy.vault() != address(this) || newStrategy.asset() != asset()) revert StrategyMismatch();
+        }
+
+        strategy = newStrategy;
+        emit StrategyUpdated(address(old), address(newStrategy), recovered);
+    }
+
+    function setKeeper(address keeper, bool allowed) external onlyOwner {
+        if (keeper == address(0)) revert ZeroAddress();
+        isKeeper[keeper] = allowed;
+        emit KeeperUpdated(keeper, allowed);
+    }
+
+    function setTreasury(address newTreasury) external onlyOwner {
+        if (newTreasury == address(0)) revert ZeroAddress();
+        treasury = newTreasury;
+        emit TreasuryUpdated(newTreasury);
+    }
+
+    function setPerformanceFee(uint256 bps) external onlyOwner {
+        if (bps > MAX_PERFORMANCE_FEE_BPS) revert FeeTooHigh(bps, MAX_PERFORMANCE_FEE_BPS);
+        performanceFeeBps = bps;
+        emit PerformanceFeeUpdated(bps);
+    }
+
+    function setWithdrawalFee(uint256 bps) external onlyOwner {
+        if (bps > MAX_WITHDRAWAL_FEE_BPS) revert FeeTooHigh(bps, MAX_WITHDRAWAL_FEE_BPS);
+        withdrawalFeeBps = bps;
+        emit WithdrawalFeeUpdated(bps);
+    }
+
+    function setBuffer(uint256 bps) external onlyOwner {
+        if (bps > MAX_BPS) revert BpsTooHigh(bps);
+        bufferBps = bps;
+        emit BufferUpdated(bps);
+    }
+
+    function setDepositCap(uint256 cap) external onlyOwner {
+        depositCap = cap;
+        emit DepositCapUpdated(cap);
+    }
+
+    /// @notice Blocks new deposits. Withdrawals stay open.
+    function pause() external onlyOwner {
+        _pause();
+    }
+
+    function unpause() external onlyOwner {
+        _unpause();
+    }
+
+    /// @dev One USDC unit of tolerated dust when retiring a strategy.
+    function _dustThreshold() internal view returns (uint256) {
+        return 10 ** IERC20Metadata(asset()).decimals();
+    }
+}
diff --git a/src/interfaces/IAerodrome.sol b/src/interfaces/IAerodrome.sol
new file mode 100644
index 0000000..77c9d44
--- /dev/null
+++ b/src/interfaces/IAerodrome.sol
@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+/// @notice Minimal subset of the Aerodrome (Velodrome V2 fork) Router used by the strategy.
+/// @dev Deployed on Base at 0xcF77a3Ba9A5CA399B7c97c74d54e5b1Beb874E43.
+interface IAerodromeRouter {
+    /// @param from     input token of the hop
+    /// @param to       output token of the hop
+    /// @param stable   whether the hop uses the stable (x3y+y3x) or volatile (xy=k) curve
+    /// @param factory  pool factory that deployed the pool for this hop
+    struct Route {
+        address from;
+        address to;
+        bool stable;
+        address factory;
+    }
+
+    function defaultFactory() external view returns (address);
+
+    function poolFor(address tokenA, address tokenB, bool stable, address _factory) external view returns (address);
+
+    function addLiquidity(
+        address tokenA,
+        address tokenB,
+        bool stable,
+        uint256 amountADesired,
+        uint256 amountBDesired,
+        uint256 amountAMin,
+        uint256 amountBMin,
+        address to,
+        uint256 deadline
+    ) external returns (uint256 amountA, uint256 amountB, uint256 liquidity);
+
+    function removeLiquidity(
+        address tokenA,
+        address tokenB,
+        bool stable,
+        uint256 liquidity,
+        uint256 amountAMin,
+        uint256 amountBMin,
+        address to,
+        uint256 deadline
+    ) external returns (uint256 amountA, uint256 amountB);
+
+    function swapExactTokensForTokens(
+        uint256 amountIn,
+        uint256 amountOutMin,
+        Route[] calldata routes,
+        address to,
+        uint256 deadline
+    ) external returns (uint256[] memory amounts);
+
+    function getAmountsOut(uint256 amountIn, Route[] memory routes) external view returns (uint256[] memory amounts);
+}
+
+/// @notice Minimal subset of an Aerodrome constant-product (volatile) Pool.
+interface IAerodromePool {
+    function getReserves() external view returns (uint256 reserve0, uint256 reserve1, uint256 blockTimestampLast);
+    function token0() external view returns (address);
+    function token1() external view returns (address);
+    function stable() external view returns (bool);
+    function totalSupply() external view returns (uint256);
+    function balanceOf(address) external view returns (uint256);
+}
+
+/// @notice Minimal subset of an Aerodrome Gauge (the AERO emissions contract for a pool).
+interface IAerodromeGauge {
+    /// @notice Stakes `amount` of the gauge's LP token, pulled from msg.sender.
+    function deposit(uint256 amount) external;
+    /// @notice Unstakes `amount` of LP back to msg.sender.
+    function withdraw(uint256 amount) external;
+    /// @notice Claims accrued AERO for `account`, sending it to `account`.
+    function getReward(address account) external;
+    /// @notice Staked LP balance of `account`.
+    function balanceOf(address account) external view returns (uint256);
+    /// @notice Claimable AERO for `account`.
+    function earned(address account) external view returns (uint256);
+    /// @notice The LP token this gauge stakes.
+    function stakingToken() external view returns (address);
+    /// @notice The reward token (AERO).
+    function rewardToken() external view returns (address);
+}
+
+/// @notice Minimal subset of the Aerodrome Voter, the registry mapping pools to their gauges.
+/// @dev Deployed on Base at 0x16613524e02ad97eDfeF371bC883F2F5d6C480A5.
+interface IAerodromeVoter {
+    /// @return The gauge for `pool`, or address(0) if the pool has never been gauged.
+    function gauges(address pool) external view returns (address);
+    /// @return True if `gauge` is currently receiving emissions.
+    function isAlive(address gauge) external view returns (bool);
+}
