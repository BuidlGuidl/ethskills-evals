diff --git a/src/interfaces/IStrategy.sol b/src/interfaces/IStrategy.sol
new file mode 100644
index 0000000..7012084
--- /dev/null
+++ b/src/interfaces/IStrategy.sol
@@ -0,0 +1,34 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+/// @notice The interface `YieldVault` requires of any strategy it allocates to.
+interface IStrategy {
+    /// @return The vault this strategy reports to.
+    function vault() external view returns (address);
+
+    /// @return The ERC20 the vault accounts in (USDC).
+    function asset() external view returns (address);
+
+    /// @notice Oracle-priced value of everything the strategy controls, denominated in `asset`.
+    function estimatedTotalAssets() external view returns (uint256);
+
+    /// @notice Deploys any `asset` sitting idle in the strategy into the productive position.
+    /// @dev Vault-only. The vault transfers `asset` in first, then calls this.
+    function invest() external;
+
+    /// @notice Liquidates up to `amount` of `asset` and sends it to the vault.
+    /// @dev Vault-only. May return less than `amount` if the position cannot be unwound for that much.
+    /// @return freed The amount of `asset` actually transferred to the vault.
+    function withdraw(uint256 amount) external returns (uint256 freed);
+
+    /// @notice Claims accrued rewards, converts them to `asset` and compounds them back into the
+    ///         position.
+    /// @dev Vault-only; the vault gates this behind its keeper role and takes its fee on the result.
+    /// @return rewardsAsset The `asset`-denominated value of the rewards realised by this call.
+    function harvest() external returns (uint256 rewardsAsset);
+
+    /// @notice Unwinds the entire position back into `asset` and returns it to the vault.
+    /// @dev Vault-only. Used when retiring or migrating a strategy.
+    /// @return freed The amount of `asset` transferred to the vault.
+    function liquidateAll() external returns (uint256 freed);
+}
diff --git a/src/libraries/ChainlinkLib.sol b/src/libraries/ChainlinkLib.sol
new file mode 100644
index 0000000..c891b28
--- /dev/null
+++ b/src/libraries/ChainlinkLib.sol
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+import {IAggregatorV3} from "../interfaces/IAggregatorV3.sol";
+
+/// @title ChainlinkLib
+/// @notice Safe reads of Chainlink aggregators, normalised to 8 decimals.
+library ChainlinkLib {
+    error StalePrice(address feed, uint256 updatedAt);
+    error InvalidPrice(address feed, int256 answer);
+    error UnsupportedFeedDecimals(address feed, uint8 decimals);
+
+    uint8 internal constant PRICE_DECIMALS = 8;
+
+    /// @notice Reads `feed` and reverts unless the answer is positive and fresher than `maxAge`.
+    /// @param feed The Chainlink aggregator (or a proxy in front of one).
+    /// @param maxAge Maximum tolerated age in seconds; should be the feed heartbeat plus a margin.
+    /// @return price The answer scaled to 8 decimals.
+    function readPrice(IAggregatorV3 feed, uint256 maxAge) internal view returns (uint256 price) {
+        (, int256 answer,, uint256 updatedAt,) = feed.latestRoundData();
+
+        if (answer <= 0) revert InvalidPrice(address(feed), answer);
+        // `updatedAt == 0` means the round is incomplete; the subtraction below also guards a
+        // future-dated timestamp, which would otherwise underflow.
+        if (updatedAt == 0 || updatedAt > block.timestamp || block.timestamp - updatedAt > maxAge) {
+            revert StalePrice(address(feed), updatedAt);
+        }
+
+        uint8 dec = feed.decimals();
+        if (dec > PRICE_DECIMALS) revert UnsupportedFeedDecimals(address(feed), dec);
+
+        // casting to `uint256` is safe because `answer <= 0` reverted above
+        // forge-lint: disable-next-line(unsafe-typecast)
+        price = uint256(answer) * (10 ** (PRICE_DECIMALS - dec));
+    }
+}
diff --git a/src/libraries/FairLpMath.sol b/src/libraries/FairLpMath.sol
new file mode 100644
index 0000000..a5f29f2
--- /dev/null
+++ b/src/libraries/FairLpMath.sol
@@ -0,0 +1,80 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+import {Math} from "@openzeppelin/contracts/utils/math/Math.sol";
+
+/// @title FairLpMath
+/// @notice Manipulation-resistant valuation of constant-product (xy=k) LP tokens.
+///
+/// @dev Reading `getReserves()` and pricing each leg at the pool's own spot rate is unsafe: an
+/// attacker can push the pool far from market inside one transaction, mint or burn vault shares at
+/// the distorted valuation, and restore the pool afterwards (a flash-loan sandwich of
+/// deposit/withdraw). Instead we use the *fair reserves* method: `k = r0 * r1` is invariant under
+/// swaps, so we recompute the reserves the pool *would* hold if it were balanced at the oracle
+/// prices, and value those.
+///
+///   Balanced at oracle prices:  r0' * p0 == r1' * p1  and  r0' * r1' == k
+///     =>  r0' = sqrt(k * p1 / p0),  r1' = sqrt(k * p0 / p1)
+///     =>  poolValue = r0' * p0 + r1' * p1 = 2 * sqrt(k) * sqrt(p0 * p1)
+///
+/// The result depends only on `k` and the oracle prices, so trading against the pool cannot move
+/// it. Attribution: this is the LP pricing used by Alpha Homora V2 / "fair uniswap LP" pricing.
+library FairLpMath {
+    error ZeroSupply();
+
+    uint256 internal constant WAD = 1e18;
+    uint256 internal constant PRICE_UNIT = 1e8;
+
+    /// @notice Snapshot of a constant-product pool plus the oracle prices of its two tokens.
+    struct PoolState {
+        uint256 reserve0; // raw reserve of token0
+        uint256 reserve1; // raw reserve of token1
+        uint256 totalSupply; // total LP supply
+        uint256 price0; // USD price of one whole token0, 8 decimals
+        uint256 price1; // USD price of one whole token1, 8 decimals
+        uint8 decimals0;
+        uint8 decimals1;
+    }
+
+    /// @notice Oracle-fair USD value of `lpAmount` LP tokens of a constant-product pool.
+    /// @param s Pool reserves, supply, decimals and oracle prices.
+    /// @param lpAmount LP tokens to value (18 decimals, as minted by the pool).
+    /// @return valueUsd USD value with 18 decimals.
+    function lpValueUsd(PoolState memory s, uint256 lpAmount) internal pure returns (uint256 valueUsd) {
+        if (s.totalSupply == 0) revert ZeroSupply();
+        if (lpAmount == 0 || s.reserve0 == 0 || s.reserve1 == 0) return 0;
+
+        // Normalise both reserves to 18 decimals so `sqrt(r0 * r1)` is also 18-decimal.
+        uint256 sqrtK = Math.sqrt(_toWad(s.reserve0, s.decimals0) * _toWad(s.reserve1, s.decimals1)); // 18dp
+        uint256 sqrtP = Math.sqrt(s.price0 * s.price1); // 8dp
+
+        // poolValueUsd(18dp) = 2 * sqrtK * sqrtP / 1e8
+        uint256 poolValueUsd = 2 * Math.mulDiv(sqrtK, sqrtP, PRICE_UNIT);
+
+        valueUsd = Math.mulDiv(poolValueUsd, lpAmount, s.totalSupply);
+    }
+
+    /// @notice USD value (18 decimals) of `amount` of a token worth `price` (8 decimals) per unit.
+    function tokenValueUsd(uint256 amount, uint8 decimals, uint256 price) internal pure returns (uint256) {
+        return Math.mulDiv(_toWad(amount, decimals), price, PRICE_UNIT);
+    }
+
+    /// @notice Inverse of {tokenValueUsd}: how much of a token `valueUsd` buys, in token decimals.
+    function usdToToken(uint256 valueUsd, uint8 decimals, uint256 price) internal pure returns (uint256) {
+        if (price == 0) return 0;
+        uint256 wadAmount = Math.mulDiv(valueUsd, PRICE_UNIT, price);
+        return _fromWad(wadAmount, decimals);
+    }
+
+    function _toWad(uint256 amount, uint8 decimals) private pure returns (uint256) {
+        if (decimals == 18) return amount;
+        if (decimals < 18) return amount * (10 ** (18 - decimals));
+        return amount / (10 ** (decimals - 18));
+    }
+
+    function _fromWad(uint256 amount, uint8 decimals) private pure returns (uint256) {
+        if (decimals == 18) return amount;
+        if (decimals < 18) return amount / (10 ** (18 - decimals));
+        return amount * (10 ** (decimals - 18));
+    }
+}
diff --git a/src/strategies/AerodromeUsdcWethStrategy.sol b/src/strategies/AerodromeUsdcWethStrategy.sol
new file mode 100644
index 0000000..3c2716f
--- /dev/null
+++ b/src/strategies/AerodromeUsdcWethStrategy.sol
@@ -0,0 +1,578 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {IERC20Metadata} from "@openzeppelin/contracts/token/ERC20/extensions/IERC20Metadata.sol";
+import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+import {Ownable, Ownable2Step} from "@openzeppelin/contracts/access/Ownable2Step.sol";
+import {Math} from "@openzeppelin/contracts/utils/math/Math.sol";
+
+import {IStrategy} from "../interfaces/IStrategy.sol";
+import {IAerodromeRouter, IAerodromePool, IAerodromeGauge} from "../interfaces/IAerodrome.sol";
+import {IAggregatorV3} from "../interfaces/IAggregatorV3.sol";
+import {ChainlinkLib} from "../libraries/ChainlinkLib.sol";
+import {FairLpMath} from "../libraries/FairLpMath.sol";
+
+/// @title AerodromeUsdcWethStrategy
+/// @notice Pairs vault USDC with WETH in the Aerodrome volatile USDC/WETH pool, stakes the LP in the
+///         pool's gauge, and compounds the AERO emissions plus accrued swap fees back into the LP.
+///
+/// @dev Every interaction with the DEX is bounded by Chainlink prices:
+///  - swaps use an oracle-derived `amountOutMin`;
+///  - `addLiquidity` asserts the LP received is worth at least the tokens spent, minus slippage;
+///  - `removeLiquidity` asserts the tokens received are worth at least the LP burned, minus slippage;
+///  - {estimatedTotalAssets} values the LP with the fair-reserves formula (see {FairLpMath}).
+///  This is what keeps the position safe to hold, and the vault's share price safe to quote, in a
+///  pool whose spot reserves anyone can move with a flash loan.
+contract AerodromeUsdcWethStrategy is IStrategy, Ownable2Step {
+    using SafeERC20 for IERC20;
+    using ChainlinkLib for IAggregatorV3;
+    using Math for uint256;
+
+    uint256 public constant MAX_BPS = 10_000;
+    uint256 public constant MAX_SLIPPAGE_BPS = 500; // 5% ceiling on the owner-settable slippage
+
+    /// @notice Config bundle for the constructor, to keep the argument list readable.
+    struct Config {
+        address vault;
+        address usdc;
+        address weth;
+        address aero;
+        address router;
+        address gauge;
+        address usdcUsdFeed;
+        address ethUsdFeed;
+        address aeroUsdFeed;
+        uint256 usdcFeedHeartbeat;
+        uint256 ethFeedHeartbeat;
+        uint256 aeroFeedHeartbeat;
+    }
+
+    // --- immutable wiring ---
+    address public immutable override vault;
+    address public immutable override asset; // USDC
+    address public immutable weth;
+    address public immutable aero;
+
+    IAerodromeRouter public immutable router;
+    IAerodromePool public immutable pool;
+    IAerodromeGauge public immutable gauge;
+    address public immutable poolFactory;
+
+    IAggregatorV3 public immutable usdcUsdFeed;
+    IAggregatorV3 public immutable ethUsdFeed;
+    IAggregatorV3 public immutable aeroUsdFeed;
+
+    uint256 public immutable usdcFeedHeartbeat;
+    uint256 public immutable ethFeedHeartbeat;
+    uint256 public immutable aeroFeedHeartbeat;
+
+    uint8 private immutable _usdcDecimals;
+    uint8 private immutable _wethDecimals;
+    uint8 private immutable _aeroDecimals;
+    bool private immutable _usdcIsToken0;
+
+    // --- tunables ---
+
+    /// @notice Maximum value loss tolerated on any single DEX interaction, in bps.
+    uint256 public maxSlippageBps = 100; // 1%
+
+    /// @notice Extra LP unwound on withdrawals so slippage cannot leave the vault short.
+    /// @dev Half of what is unwound has to be swapped back to USDC, so this must exceed the cost of
+    ///      that swap - keep it at or above `maxSlippageBps`. Over-unwinding is free: the surplus
+    ///      stays as idle USDC in the strategy and is redeployed by the next harvest.
+    uint256 public unwindBufferBps = 100; // 1%
+
+    /// @notice Ceiling on a single USDC->WETH invest swap, as a fraction of the pool's USDC reserve.
+    /// @dev On a constant-product pool, swapping a fraction `f` of the input reserve costs roughly
+    ///      `f + poolFee` against the mid price, so this is what actually keeps {invest} inside
+    ///      `maxSlippageBps`. Keep `maxTradeReserveBps + poolFeeBps` comfortably under
+    ///      `maxSlippageBps`; the default pairs 0.25% with Aerodrome's 0.30% volatile fee against a
+    ///      1% tolerance. Whatever the cap holds back stays idle and is deployed by the next harvest.
+    uint256 public maxTradeReserveBps = 25; // 0.25% of the USDC reserve
+
+    /// @notice Below this much idle USDC, {invest} is a no-op (the gas is not worth the dust).
+    uint256 public minInvestUsdc = 10e6; // 10 USDC
+
+    /// @notice Below this much claimed AERO, {harvest} skips the reward swap.
+    uint256 public minHarvestAero = 1e18; // 1 AERO
+
+    /// @notice When set, {harvest} stops re-investing; the position is only ever unwound.
+    bool public emergencyExit;
+
+    /// @notice Swap path used to turn claimed AERO into USDC.
+    IAerodromeRouter.Route[] private _rewardRoute;
+
+    event Invested(uint256 usdcIn, uint256 liquidity);
+    event Withdrawn(uint256 requested, uint256 freed);
+    event Harvest(uint256 aeroClaimed, uint256 usdcRealised, uint256 liquidityAdded);
+    event LiquidatedAll(uint256 freed);
+    event MaxSlippageUpdated(uint256 bps);
+    event UnwindBufferUpdated(uint256 bps);
+    event ThresholdsUpdated(uint256 minInvestUsdc, uint256 minHarvestAero);
+    event MaxTradeReserveUpdated(uint256 bps);
+    event RewardRouteUpdated(uint256 hops);
+    event EmergencyExitSet(bool enabled);
+
+    error NotVault(address caller);
+    error ZeroAddress();
+    error BadPool();
+    error SlippageTooHigh(uint256 bps);
+    error TradeSizeTooHigh(uint256 bps);
+    error BadRewardRoute();
+    error SlippageExceeded(uint256 valueOut, uint256 minValueOut);
+    error ProtectedToken(address token);
+
+    modifier onlyVault() {
+        _requireVault();
+        _;
+    }
+
+    function _requireVault() internal view {
+        if (msg.sender != vault) revert NotVault(msg.sender);
+    }
+
+    constructor(Config memory c, address owner_, IAerodromeRouter.Route[] memory rewardRoute_) Ownable(owner_) {
+        if (
+            c.vault == address(0) || c.usdc == address(0) || c.weth == address(0) || c.aero == address(0)
+                || c.router == address(0) || c.gauge == address(0)
+        ) revert ZeroAddress();
+
+        vault = c.vault;
+        asset = c.usdc;
+        weth = c.weth;
+        aero = c.aero;
+        router = IAerodromeRouter(c.router);
+        gauge = IAerodromeGauge(c.gauge);
+
+        // Trust the gauge for the pool address rather than a constructor argument: it guarantees the
+        // LP we stake is the LP the gauge actually pays emissions on.
+        IAerodromePool p = IAerodromePool(IAerodromeGauge(c.gauge).stakingToken());
+        pool = p;
+        if (IAerodromeGauge(c.gauge).rewardToken() != c.aero) revert BadPool();
+        if (p.stable()) revert BadPool(); // fair-reserves pricing below assumes xy=k
+
+        address t0 = p.token0();
+        address t1 = p.token1();
+        if (!((t0 == c.usdc && t1 == c.weth) || (t0 == c.weth && t1 == c.usdc))) revert BadPool();
+        _usdcIsToken0 = t0 == c.usdc;
+
+        poolFactory = IAerodromeRouter(c.router).defaultFactory();
+        if (IAerodromeRouter(c.router).poolFor(c.usdc, c.weth, false, poolFactory) != address(p)) revert BadPool();
+
+        usdcUsdFeed = IAggregatorV3(c.usdcUsdFeed);
+        ethUsdFeed = IAggregatorV3(c.ethUsdFeed);
+        aeroUsdFeed = IAggregatorV3(c.aeroUsdFeed);
+        usdcFeedHeartbeat = c.usdcFeedHeartbeat;
+        ethFeedHeartbeat = c.ethFeedHeartbeat;
+        aeroFeedHeartbeat = c.aeroFeedHeartbeat;
+
+        _usdcDecimals = IERC20Metadata(c.usdc).decimals();
+        _wethDecimals = IERC20Metadata(c.weth).decimals();
+        _aeroDecimals = IERC20Metadata(c.aero).decimals();
+
+        _setRewardRoute(rewardRoute_);
+    }
+
+    // ---------------------------------------------------------------------
+    // Views
+    // ---------------------------------------------------------------------
+
+    /// @inheritdoc IStrategy
+    /// @dev Idle USDC + idle WETH + LP (staked and unstaked), all priced off Chainlink.
+    function estimatedTotalAssets() public view override returns (uint256) {
+        (uint256 usdcPrice, uint256 ethPrice) = _pairPrices();
+
+        uint256 valueUsd = FairLpMath.tokenValueUsd(IERC20(weth).balanceOf(address(this)), _wethDecimals, ethPrice)
+            + _lpValueUsd(totalLpBalance(), usdcPrice, ethPrice);
+
+        return IERC20(asset).balanceOf(address(this)) + FairLpMath.usdToToken(valueUsd, _usdcDecimals, usdcPrice);
+    }
+
+    /// @notice LP tokens held by the strategy, staked in the gauge or loose after a partial unwind.
+    function totalLpBalance() public view returns (uint256) {
+        return gauge.balanceOf(address(this)) + IERC20(address(pool)).balanceOf(address(this));
+    }
+
+    /// @notice AERO claimable from the gauge right now.
+    function pendingRewards() external view returns (uint256) {
+        return gauge.earned(address(this));
+    }
+
+    /// @notice The configured AERO -> USDC swap path.
+    function rewardRoute() external view returns (IAerodromeRouter.Route[] memory) {
+        return _rewardRoute;
+    }
+
+    // ---------------------------------------------------------------------
+    // Vault-facing
+    // ---------------------------------------------------------------------
+
+    /// @inheritdoc IStrategy
+    function invest() external override onlyVault {
+        if (emergencyExit) return;
+        _investIdle();
+    }
+
+    /// @inheritdoc IStrategy
+    function withdraw(uint256 amount) external override onlyVault returns (uint256 freed) {
+        uint256 idle = IERC20(asset).balanceOf(address(this));
+
+        if (idle < amount) {
+            uint256 shortfall = amount - idle;
+            // Unwind a touch more than needed so swap slippage cannot leave us a few units short.
+            uint256 target = shortfall.mulDiv(MAX_BPS + unwindBufferBps, MAX_BPS, Math.Rounding.Ceil);
+
+            // WETH stranded by a previously capped unwind is sold first, before touching the LP.
+            uint256 stranded = _idleWethAsUsdc();
+            _unwind(target > stranded ? _lpForUsdc(target - stranded) : 0);
+            idle = IERC20(asset).balanceOf(address(this));
+        }
+
+        freed = idle < amount ? idle : amount;
+        if (freed != 0) IERC20(asset).safeTransfer(vault, freed);
+        emit Withdrawn(amount, freed);
+    }
+
+    /// @inheritdoc IStrategy
+    function harvest() external override onlyVault returns (uint256 rewardsAsset) {
+        uint256 before = IERC20(asset).balanceOf(address(this));
+
+        gauge.getReward(address(this));
+
+        // Includes AERO left over from a previous capped harvest.
+        uint256 toSell = IERC20(aero).balanceOf(address(this));
+        uint256 claimed = toSell;
+        uint256 cap = _maxAeroTrade();
+        if (toSell > cap) toSell = cap;
+
+        if (toSell >= minHarvestAero) {
+            _swapRewardToUsdc(toSell);
+            rewardsAsset = IERC20(asset).balanceOf(address(this)) - before;
+        }
+
+        uint256 liquidity;
+        if (!emergencyExit) liquidity = _investIdle();
+
+        emit Harvest(claimed, rewardsAsset, liquidity);
+    }
+
+    /// @inheritdoc IStrategy
+    function liquidateAll() external override onlyVault returns (uint256 freed) {
+        gauge.getReward(address(this));
+        uint256 toSell = IERC20(aero).balanceOf(address(this));
+        uint256 cap = _maxAeroTrade();
+        if (toSell > cap) toSell = cap;
+        // Anything above the cap stays as AERO rather than being force-sold at a bad price, which
+        // could revert the whole migration. Run a final {harvest} before retiring the strategy so
+        // there is nothing left to strand.
+        if (toSell >= minHarvestAero) _swapRewardToUsdc(toSell);
+
+        _unwind(totalLpBalance());
+
+        freed = IERC20(asset).balanceOf(address(this));
+        if (freed != 0) IERC20(asset).safeTransfer(vault, freed);
+        emit LiquidatedAll(freed);
+    }
+
+    // ---------------------------------------------------------------------
+    // Internals: position management
+    // ---------------------------------------------------------------------
+
+    /// @dev Converts idle USDC into a balanced LP position and stakes it.
+    function _investIdle() internal returns (uint256 liquidity) {
+        uint256 usdcBal = IERC20(asset).balanceOf(address(this));
+        if (usdcBal < minInvestUsdc) return 0;
+
+        // Half the USDC buys WETH; `addLiquidity` then consumes both sides at the pool ratio and
+        // leaves whatever does not fit as idle dust for the next invest.
+        uint256 swapAmount = usdcBal / 2;
+        uint256 cap = _maxUsdcTrade();
+        if (swapAmount > cap) swapAmount = cap;
+        if (swapAmount == 0) return 0;
+
+        _swapUsdcToWeth(swapAmount);
+
+        liquidity = _addLiquidityAndStake();
+        emit Invested(usdcBal, liquidity);
+    }
+
+    /// @dev Largest USDC swap that keeps price impact comfortably inside `maxSlippageBps`.
+    function _maxUsdcTrade() internal view returns (uint256) {
+        (uint256 r0, uint256 r1,) = pool.getReserves();
+        uint256 usdcReserve = _usdcIsToken0 ? r0 : r1;
+        return usdcReserve.mulDiv(maxTradeReserveBps, MAX_BPS);
+    }
+
+    /// @dev The WETH-side equivalent of {_maxUsdcTrade}, used when unwinding.
+    function _maxWethTrade() internal view returns (uint256) {
+        (uint256 r0, uint256 r1,) = pool.getReserves();
+        uint256 wethReserve = _usdcIsToken0 ? r1 : r0;
+        return wethReserve.mulDiv(maxTradeReserveBps, MAX_BPS);
+    }
+
+    /// @dev Same cap applied to the reward sale, measured against the first hop of the reward route.
+    ///      A harvest that is large relative to that pool sells what it can and carries the rest
+    ///      forward, rather than reverting and leaving the emissions unclaimable.
+    function _maxAeroTrade() internal view returns (uint256) {
+        IAerodromeRouter.Route memory hop = _rewardRoute[0];
+        IAerodromePool p = IAerodromePool(router.poolFor(hop.from, hop.to, hop.stable, hop.factory));
+        (uint256 r0, uint256 r1,) = p.getReserves();
+        uint256 aeroReserve = p.token0() == aero ? r0 : r1;
+        return aeroReserve.mulDiv(maxTradeReserveBps, MAX_BPS);
+    }
+
+    /// @dev Adds all idle USDC/WETH as liquidity and stakes the resulting LP in the gauge.
+    function _addLiquidityAndStake() internal returns (uint256 liquidity) {
+        uint256 usdcBal = IERC20(asset).balanceOf(address(this));
+        uint256 wethBal = IERC20(weth).balanceOf(address(this));
+        if (usdcBal == 0 || wethBal == 0) return 0;
+
+        (uint256 usdcPrice, uint256 ethPrice) = _pairPrices();
+
+        IERC20(asset).forceApprove(address(router), usdcBal);
+        IERC20(weth).forceApprove(address(router), wethBal);
+
+        uint256 usdcUsed;
+        uint256 wethUsed;
+        (usdcUsed, wethUsed, liquidity) =
+            router.addLiquidity(asset, weth, false, usdcBal, wethBal, 0, 0, address(this), block.timestamp);
+
+        IERC20(asset).forceApprove(address(router), 0);
+        IERC20(weth).forceApprove(address(router), 0);
+
+        // `amountAMin`/`amountBMin` only bound the *ratio*, not the value of the LP minted. Check
+        // the thing we actually care about: LP received is worth what we put in.
+        uint256 valueIn = FairLpMath.tokenValueUsd(usdcUsed, _usdcDecimals, usdcPrice)
+            + FairLpMath.tokenValueUsd(wethUsed, _wethDecimals, ethPrice);
+        uint256 valueOut = _lpValueUsd(liquidity, usdcPrice, ethPrice);
+        uint256 minValueOut = valueIn.mulDiv(MAX_BPS - maxSlippageBps, MAX_BPS);
+        if (valueOut < minValueOut) revert SlippageExceeded(valueOut, minValueOut);
+
+        _stakeLp();
+    }
+
+    /// @dev Stakes any loose LP.
+    function _stakeLp() internal {
+        uint256 lp = IERC20(address(pool)).balanceOf(address(this));
+        if (lp == 0) return;
+        IERC20(address(pool)).forceApprove(address(gauge), lp);
+        gauge.deposit(lp);
+    }
+
+    /// @dev Burns `lpAmount` of LP and converts the WETH leg to USDC. The WETH sale is capped the
+    ///      same way {invest} is, so a single call frees at most roughly
+    ///      `2 * maxTradeReserveBps` of the pool - larger exits simply take more than one call.
+    ///      Called with `lpAmount == 0` it only drains leftover WETH, which is how a staged exit
+    ///      finishes.
+    function _unwind(uint256 lpAmount) internal {
+        uint256 total = totalLpBalance();
+        if (lpAmount > total) lpAmount = total;
+
+        if (lpAmount != 0) {
+            uint256 loose = IERC20(address(pool)).balanceOf(address(this));
+            if (loose < lpAmount) gauge.withdraw(lpAmount - loose);
+
+            (uint256 usdcPrice, uint256 ethPrice) = _pairPrices();
+            uint256 lpValueUsd = _lpValueUsd(lpAmount, usdcPrice, ethPrice);
+
+            IERC20(address(pool)).forceApprove(address(router), lpAmount);
+            (uint256 usdcOut, uint256 wethOut) =
+                router.removeLiquidity(asset, weth, false, lpAmount, 0, 0, address(this), block.timestamp);
+            IERC20(address(pool)).forceApprove(address(router), 0);
+
+            uint256 valueOut = FairLpMath.tokenValueUsd(usdcOut, _usdcDecimals, usdcPrice)
+                + FairLpMath.tokenValueUsd(wethOut, _wethDecimals, ethPrice);
+            uint256 minValueOut = lpValueUsd.mulDiv(MAX_BPS - maxSlippageBps, MAX_BPS);
+            if (valueOut < minValueOut) revert SlippageExceeded(valueOut, minValueOut);
+        }
+
+        uint256 wethBal = IERC20(weth).balanceOf(address(this));
+        if (wethBal == 0) return;
+
+        uint256 cap = _maxWethTrade();
+        _swapWethToUsdc(wethBal > cap ? cap : wethBal);
+    }
+
+    // ---------------------------------------------------------------------
+    // Internals: swaps
+    // ---------------------------------------------------------------------
+
+    function _swapUsdcToWeth(uint256 amountIn) internal returns (uint256 out) {
+        if (amountIn == 0) return 0;
+        (uint256 usdcPrice, uint256 ethPrice) = _pairPrices();
+        uint256 minOut = _minOut(amountIn, _usdcDecimals, usdcPrice, _wethDecimals, ethPrice);
+        out = _swapDirect(asset, weth, amountIn, minOut);
+    }
+
+    function _swapWethToUsdc(uint256 amountIn) internal returns (uint256 out) {
+        if (amountIn == 0) return 0;
+        (uint256 usdcPrice, uint256 ethPrice) = _pairPrices();
+        uint256 minOut = _minOut(amountIn, _wethDecimals, ethPrice, _usdcDecimals, usdcPrice);
+        out = _swapDirect(weth, asset, amountIn, minOut);
+    }
+
+    function _swapRewardToUsdc(uint256 amountIn) internal returns (uint256 out) {
+        uint256 aeroPrice = aeroUsdFeed.readPrice(aeroFeedHeartbeat);
+        uint256 usdcPrice = usdcUsdFeed.readPrice(usdcFeedHeartbeat);
+        uint256 minOut = _minOut(amountIn, _aeroDecimals, aeroPrice, _usdcDecimals, usdcPrice);
+
+        IERC20(aero).forceApprove(address(router), amountIn);
+        uint256[] memory amounts =
+            router.swapExactTokensForTokens(amountIn, minOut, _rewardRoute, address(this), block.timestamp);
+        IERC20(aero).forceApprove(address(router), 0);
+        out = amounts[amounts.length - 1];
+    }
+
+    function _swapDirect(address tokenIn, address tokenOut, uint256 amountIn, uint256 minOut)
+        internal
+        returns (uint256 out)
+    {
+        // A trade whose oracle-fair output rounds to zero is dust: skip it rather than burn gas or
+        // revert inside the pool on a zero-output swap.
+        if (amountIn == 0 || minOut == 0) return 0;
+
+        IAerodromeRouter.Route[] memory route = new IAerodromeRouter.Route[](1);
+        route[0] = IAerodromeRouter.Route({from: tokenIn, to: tokenOut, stable: false, factory: poolFactory});
+
+        IERC20(tokenIn).forceApprove(address(router), amountIn);
+        uint256[] memory amounts =
+            router.swapExactTokensForTokens(amountIn, minOut, route, address(this), block.timestamp);
+        IERC20(tokenIn).forceApprove(address(router), 0);
+        out = amounts[amounts.length - 1];
+    }
+
+    /// @dev Oracle-implied output for a swap, less `maxSlippageBps`.
+    function _minOut(uint256 amountIn, uint8 decIn, uint256 priceIn, uint8 decOut, uint256 priceOut)
+        internal
+        view
+        returns (uint256)
+    {
+        uint256 valueUsd = FairLpMath.tokenValueUsd(amountIn, decIn, priceIn);
+        uint256 fairOut = FairLpMath.usdToToken(valueUsd, decOut, priceOut);
+        return fairOut.mulDiv(MAX_BPS - maxSlippageBps, MAX_BPS);
+    }
+
+    // ---------------------------------------------------------------------
+    // Internals: pricing
+    // ---------------------------------------------------------------------
+
+    function _pairPrices() internal view returns (uint256 usdcPrice, uint256 ethPrice) {
+        usdcPrice = usdcUsdFeed.readPrice(usdcFeedHeartbeat);
+        ethPrice = ethUsdFeed.readPrice(ethFeedHeartbeat);
+    }
+
+    function _lpValueUsd(uint256 lpAmount, uint256 usdcPrice, uint256 ethPrice) internal view returns (uint256) {
+        if (lpAmount == 0) return 0;
+        return FairLpMath.lpValueUsd(_poolState(usdcPrice, ethPrice), lpAmount);
+    }
+
+    /// @dev Reserves, supply, decimals and oracle prices in the pool's own token order.
+    function _poolState(uint256 usdcPrice, uint256 ethPrice) internal view returns (FairLpMath.PoolState memory s) {
+        (s.reserve0, s.reserve1,) = pool.getReserves();
+        s.totalSupply = pool.totalSupply();
+        if (_usdcIsToken0) {
+            (s.price0, s.price1) = (usdcPrice, ethPrice);
+            (s.decimals0, s.decimals1) = (_usdcDecimals, _wethDecimals);
+        } else {
+            (s.price0, s.price1) = (ethPrice, usdcPrice);
+            (s.decimals0, s.decimals1) = (_wethDecimals, _usdcDecimals);
+        }
+    }
+
+    /// @dev USDC value of WETH the strategy is currently sitting on.
+    function _idleWethAsUsdc() internal view returns (uint256) {
+        uint256 wethBal = IERC20(weth).balanceOf(address(this));
+        if (wethBal == 0) return 0;
+        (uint256 usdcPrice, uint256 ethPrice) = _pairPrices();
+        return
+            FairLpMath.usdToToken(FairLpMath.tokenValueUsd(wethBal, _wethDecimals, ethPrice), _usdcDecimals, usdcPrice);
+    }
+
+    /// @dev How much LP is worth `usdcAmount`, rounded up.
+    function _lpForUsdc(uint256 usdcAmount) internal view returns (uint256) {
+        uint256 lpTotal = totalLpBalance();
+        if (lpTotal == 0 || usdcAmount == 0) return 0;
+
+        (uint256 usdcPrice, uint256 ethPrice) = _pairPrices();
+        uint256 positionUsd = _lpValueUsd(lpTotal, usdcPrice, ethPrice);
+        if (positionUsd == 0) return 0;
+
+        uint256 wantUsd = FairLpMath.tokenValueUsd(usdcAmount, _usdcDecimals, usdcPrice);
+        if (wantUsd >= positionUsd) return lpTotal;
+        return wantUsd.mulDiv(lpTotal, positionUsd, Math.Rounding.Ceil);
+    }
+
+    // ---------------------------------------------------------------------
+    // Admin
+    // ---------------------------------------------------------------------
+
+    function setMaxSlippage(uint256 bps) external onlyOwner {
+        if (bps > MAX_SLIPPAGE_BPS) revert SlippageTooHigh(bps);
+        maxSlippageBps = bps;
+        emit MaxSlippageUpdated(bps);
+    }
+
+    function setUnwindBuffer(uint256 bps) external onlyOwner {
+        if (bps > MAX_SLIPPAGE_BPS) revert SlippageTooHigh(bps);
+        unwindBufferBps = bps;
+        emit UnwindBufferUpdated(bps);
+    }
+
+    /// @notice Sets the per-call invest trade cap as a fraction of the pool's USDC reserve.
+    function setMaxTradeReserve(uint256 bps) external onlyOwner {
+        if (bps == 0 || bps > 1_000) revert TradeSizeTooHigh(bps);
+        maxTradeReserveBps = bps;
+        emit MaxTradeReserveUpdated(bps);
+    }
+
+    function setThresholds(uint256 minInvestUsdc_, uint256 minHarvestAero_) external onlyOwner {
+        minInvestUsdc = minInvestUsdc_;
+        minHarvestAero = minHarvestAero_;
+        emit ThresholdsUpdated(minInvestUsdc_, minHarvestAero_);
+    }
+
+    /// @notice Repoints the AERO -> USDC swap path, e.g. if a deeper route appears.
+    function setRewardRoute(IAerodromeRouter.Route[] memory route) external onlyOwner {
+        _setRewardRoute(route);
+    }
+
+    /// @notice Unwinds `lpAmount` of the position to idle USDC held by the strategy.
+    /// @dev Exists so a position that is large relative to the pool can be exited in stages, each
+    ///      one small enough to clear the `maxSlippageBps` check, before the vault retires the
+    ///      strategy. Pass `type(uint256).max` to take as much as one call allows; call it with 0
+    ///      to sell WETH that a previous capped call left behind.
+    function unwind(uint256 lpAmount) external onlyOwner {
+        _unwind(lpAmount);
+    }
+
+    /// @notice Stops the strategy re-investing; {harvest} then only claims and converts rewards.
+    function setEmergencyExit(bool enabled) external onlyOwner {
+        emergencyExit = enabled;
+        emit EmergencyExitSet(enabled);
+    }
+
+    /// @notice Recovers tokens that are not part of the position (airdrops, mistaken transfers).
+    function sweep(address token, address to) external onlyOwner {
+        if (token == asset || token == weth || token == aero || token == address(pool)) revert ProtectedToken(token);
+        if (to == address(0)) revert ZeroAddress();
+        IERC20(token).safeTransfer(to, IERC20(token).balanceOf(address(this)));
+    }
+
+    function _setRewardRoute(IAerodromeRouter.Route[] memory route) internal {
+        uint256 len = route.length;
+        if (len == 0 || route[0].from != aero || route[len - 1].to != asset) revert BadRewardRoute();
+
+        delete _rewardRoute;
+        for (uint256 i; i < len; ++i) {
+            if (i != 0 && route[i].from != route[i - 1].to) revert BadRewardRoute();
+            if (route[i].factory == address(0)) revert BadRewardRoute();
+            // `poolFor` returns a deterministic CREATE2 address whether or not the pool was ever
+            // deployed, so check there is actually code there rather than only a non-zero address.
+            address hopPool = router.poolFor(route[i].from, route[i].to, route[i].stable, route[i].factory);
+            if (hopPool.code.length == 0) revert BadRewardRoute();
+            _rewardRoute.push(route[i]);
+        }
+        emit RewardRouteUpdated(len);
+    }
+}
diff --git a/test/BaseTest.sol b/test/BaseTest.sol
new file mode 100644
index 0000000..104a94e
--- /dev/null
+++ b/test/BaseTest.sol
@@ -0,0 +1,193 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+
+import {PoolArb} from "./helpers/PoolArb.sol";
+
+import {YieldVault} from "../src/YieldVault.sol";
+import {AerodromeUsdcWethStrategy} from "../src/strategies/AerodromeUsdcWethStrategy.sol";
+import {IAerodromeRouter, IAerodromePool} from "../src/interfaces/IAerodrome.sol";
+
+import {MockERC20} from "./mocks/MockERC20.sol";
+import {MockAggregator} from "./mocks/MockAggregator.sol";
+import {MockAerodromePool} from "./mocks/MockAerodromePool.sol";
+import {MockAerodromeRouter} from "./mocks/MockAerodromeRouter.sol";
+import {MockAerodromeGauge} from "./mocks/MockAerodromeGauge.sol";
+
+/// @notice Shared fixture: a USDC/WETH volatile pool at $3000/ETH, an AERO/USDC pool at $1/AERO,
+///         a gauge over the USDC/WETH LP, Chainlink stand-ins, and a vault wired to the strategy.
+abstract contract BaseTest is PoolArb {
+    uint256 internal constant USDC_UNIT = 1e6;
+    uint256 internal constant WAD = 1e18;
+    int256 internal constant ETH_PRICE = 3000e8;
+    int256 internal constant USDC_PRICE = 1e8;
+    int256 internal constant AERO_PRICE = 1e8;
+    uint256 internal constant POOL_FEE_BPS = 30; // 0.30%
+
+    address internal owner = makeAddr("owner");
+    address internal treasury = makeAddr("treasury");
+    address internal keeper = makeAddr("keeper");
+    address internal alice = makeAddr("alice");
+    address internal bob = makeAddr("bob");
+    address internal factory = makeAddr("factory");
+
+    MockERC20 internal usdc;
+    MockERC20 internal weth;
+    MockERC20 internal aero;
+
+    MockAerodromePool internal pool; // USDC/WETH
+    MockAerodromePool internal aeroPool; // AERO/USDC
+    MockAerodromeRouter internal router;
+    MockAerodromeGauge internal gauge;
+
+    MockAggregator internal usdcFeed;
+    MockAggregator internal ethFeed;
+    MockAggregator internal aeroFeed;
+
+    YieldVault internal vault;
+    AerodromeUsdcWethStrategy internal strategy;
+
+    function setUp() public virtual {
+        vm.warp(1_700_000_000);
+
+        usdc = new MockERC20("USD Coin", "USDC", 6);
+        weth = new MockERC20("Wrapped Ether", "WETH", 18);
+        aero = new MockERC20("Aerodrome", "AERO", 18);
+
+        usdcFeed = new MockAggregator(8, USDC_PRICE, "USDC / USD");
+        ethFeed = new MockAggregator(8, ETH_PRICE, "ETH / USD");
+        aeroFeed = new MockAggregator(8, AERO_PRICE, "AERO / USD");
+
+        router = new MockAerodromeRouter(factory);
+
+        pool = new MockAerodromePool(address(usdc), address(weth), POOL_FEE_BPS);
+        aeroPool = new MockAerodromePool(address(aero), address(usdc), POOL_FEE_BPS);
+        router.registerPool(address(usdc), address(weth), false, address(pool));
+        router.registerPool(address(aero), address(usdc), false, address(aeroPool));
+
+        // Sized to be in the same ballpark as the live Aerodrome vAMM-WETH/USDC pool on Base
+        // (tens of millions), so trade sizes in these tests have realistic price impact.
+        _seedPool(pool, address(usdc), 30_000_000 * USDC_UNIT, address(weth), 10_000 * WAD);
+        _seedPool(aeroPool, address(aero), 20_000_000 * WAD, address(usdc), 20_000_000 * USDC_UNIT);
+
+        gauge = new MockAerodromeGauge(address(pool), address(aero));
+
+        vault = new YieldVault(IERC20(address(usdc)), "Yield USDC", "yvUSDC", owner, treasury);
+
+        IAerodromeRouter.Route[] memory rewardRoute = new IAerodromeRouter.Route[](1);
+        rewardRoute[0] =
+            IAerodromeRouter.Route({from: address(aero), to: address(usdc), stable: false, factory: factory});
+
+        strategy = new AerodromeUsdcWethStrategy(
+            AerodromeUsdcWethStrategy.Config({
+                vault: address(vault),
+                usdc: address(usdc),
+                weth: address(weth),
+                aero: address(aero),
+                router: address(router),
+                gauge: address(gauge),
+                usdcUsdFeed: address(usdcFeed),
+                ethUsdFeed: address(ethFeed),
+                aeroUsdFeed: address(aeroFeed),
+                usdcFeedHeartbeat: 1 days,
+                ethFeedHeartbeat: 20 minutes,
+                aeroFeedHeartbeat: 1 days
+            }),
+            owner,
+            rewardRoute
+        );
+
+        vm.startPrank(owner);
+        vault.setStrategy(strategy);
+        vault.setKeeper(keeper, true);
+        vm.stopPrank();
+    }
+
+    // --- helpers ---
+
+    function _seedPool(MockAerodromePool p, address tokenA, uint256 amountA, address tokenB, uint256 amountB) internal {
+        MockERC20(tokenA).mint(address(p), amountA);
+        MockERC20(tokenB).mint(address(p), amountB);
+        p.mint(address(this));
+    }
+
+    function _deposit(address user, uint256 assets) internal returns (uint256 shares) {
+        usdc.mint(user, assets);
+        vm.startPrank(user);
+        usdc.approve(address(vault), assets);
+        shares = vault.deposit(assets, user);
+        vm.stopPrank();
+    }
+
+    /// @dev Emits `amount` of AERO to current gauge stakers.
+    function _emitRewards(uint256 amount) internal {
+        aero.mint(address(this), amount);
+        aero.approve(address(gauge), amount);
+        gauge.notifyRewardAmount(amount);
+    }
+
+    /// @dev Simulates swap fees accruing to the USDC/WETH pool by donating to both sides.
+    function _accrueTradingFees(uint256 usdcAmount, uint256 wethAmount) internal {
+        usdc.mint(address(pool), usdcAmount);
+        weth.mint(address(pool), wethAmount);
+        pool.sync();
+    }
+
+    /// @dev Pushes the USDC/WETH pool price by swapping `usdcIn` USDC for WETH.
+    function _pushPriceWithUsdc(uint256 usdcIn) internal {
+        usdc.mint(address(this), usdcIn);
+        usdc.approve(address(router), usdcIn);
+        IAerodromeRouter.Route[] memory r = new IAerodromeRouter.Route[](1);
+        r[0] = IAerodromeRouter.Route({from: address(usdc), to: address(weth), stable: false, factory: factory});
+        router.swapExactTokensForTokens(usdcIn, 0, r, address(this), block.timestamp);
+    }
+
+    /// @dev Exits `user` completely in `chunks` redemptions. A position larger than roughly
+    ///      `2 * maxTradeReserveBps` of the pool cannot be unwound in one transaction; on a live
+    ///      chain arbitrage restores the pool price between them.
+    function _exitInChunks(address user, uint256 chunks) internal returns (uint256 received) {
+        uint256 shares = vault.balanceOf(user);
+        for (uint256 i; i < chunks; ++i) {
+            uint256 slice = i + 1 == chunks ? vault.balanceOf(user) : shares / chunks;
+            vm.prank(user);
+            received += vault.redeem(slice, user, user);
+            _arbPoolToOracle();
+        }
+    }
+
+    /// @dev Runs the staged-exit runbook until the strategy holds only USDC.
+    function _drainStrategy() internal {
+        for (uint256 i; i < 20; ++i) {
+            if (strategy.totalLpBalance() == 0 && weth.balanceOf(address(strategy)) < 1e12) return;
+            vm.prank(owner);
+            strategy.unwind(type(uint256).max);
+            _arbPoolToOracle();
+        }
+        revert("strategy did not drain");
+    }
+
+    /// @dev See {PoolArb}: models the arbitrage that realigns the pool between keeper passes.
+    function _arbPoolToOracle() internal {
+        _arbToOracle(
+            PoolArb.Venue({
+                router: IAerodromeRouter(address(router)),
+                pool: IAerodromePool(address(pool)),
+                factory: factory,
+                usdc: address(usdc),
+                weth: address(weth),
+                // forge-lint: disable-start(unsafe-typecast) - both are positive literals
+                usdcPrice: uint256(USDC_PRICE),
+                ethPrice: uint256(ETH_PRICE)
+                // forge-lint: disable-end(unsafe-typecast)
+            })
+        );
+    }
+
+    /// @dev Keeps the Chainlink stand-ins fresh across `vm.warp`.
+    function _refreshFeeds() internal {
+        usdcFeed.setAnswer(usdcFeed.answer());
+        ethFeed.setAnswer(ethFeed.answer());
+        aeroFeed.setAnswer(aeroFeed.answer());
+    }
+}
