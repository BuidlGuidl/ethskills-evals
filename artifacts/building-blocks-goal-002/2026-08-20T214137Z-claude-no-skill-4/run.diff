+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {Ownable} from "@openzeppelin/contracts/access/Ownable.sol";
+
+import {BaseTest} from "../BaseTest.sol";
+import {YieldVault} from "../../src/YieldVault.sol";
+import {IStrategy} from "../../src/interfaces/IStrategy.sol";
+import {ERC4626} from "@openzeppelin/contracts/token/ERC20/extensions/ERC4626.sol";
+import {MockIlliquidStrategy} from "../mocks/MockIlliquidStrategy.sol";
+
+contract YieldVaultTest is BaseTest {
+    // ---------------------------------------------------------------- metadata
+
+    function test_metadata() public view {
+        assertEq(vault.asset(), address(usdc));
+        assertEq(vault.name(), "Yield USDC");
+        assertEq(vault.symbol(), "yvUSDC");
+        assertEq(vault.decimals(), 18, "6dp asset + 12dp offset");
+        assertEq(vault.owner(), owner);
+        assertEq(vault.treasury(), treasury);
+        assertEq(address(vault.strategy()), address(strategy));
+    }
+
+    // ---------------------------------------------------------------- deposits
+
+    function test_depositMintsProportionalShares() public {
+        uint256 shares = _deposit(alice, 1_000 * USDC_UNIT);
+        assertEq(shares, 1_000 * WAD, "1 USDC == 1e12 shares at the initial price");
+        assertEq(vault.totalAssets(), 1_000 * USDC_UNIT);
+        assertEq(vault.idleAssets(), 1_000 * USDC_UNIT, "deposits stay idle until the keeper runs");
+    }
+
+    function test_secondDepositorGetsSamePrice() public {
+        _deposit(alice, 1_000 * USDC_UNIT);
+        uint256 bobShares = _deposit(bob, 2_500 * USDC_UNIT);
+        assertEq(bobShares, 2_500 * WAD);
+        assertEq(vault.totalAssets(), 3_500 * USDC_UNIT);
+    }
+
+    function test_mintRoundsInFavourOfTheVault() public {
+        usdc.mint(alice, 1_000 * USDC_UNIT);
+        vm.startPrank(alice);
+        usdc.approve(address(vault), type(uint256).max);
+        uint256 assetsIn = vault.mint(500 * WAD, alice);
+        vm.stopPrank();
+
+        assertEq(assetsIn, 500 * USDC_UNIT);
+        assertEq(vault.balanceOf(alice), 500 * WAD);
+    }
+
+    function test_depositRevertsAboveCap() public {
+        vm.prank(owner);
+        vault.setDepositCap(1_000 * USDC_UNIT);
+
+        assertEq(vault.maxDeposit(alice), 1_000 * USDC_UNIT);
+        _deposit(alice, 600 * USDC_UNIT);
+        assertEq(vault.maxDeposit(alice), 400 * USDC_UNIT);
+
+        usdc.mint(bob, 500 * USDC_UNIT);
+        vm.startPrank(bob);
+        usdc.approve(address(vault), type(uint256).max);
+        // `maxDeposit` already reflects the cap, so ERC-4626's own guard is what trips first.
+        vm.expectRevert(
+            abi.encodeWithSelector(ERC4626.ERC4626ExceededMaxDeposit.selector, bob, 500 * USDC_UNIT, 400 * USDC_UNIT)
+        );
+        vault.deposit(500 * USDC_UNIT, bob);
+        vm.stopPrank();
+    }
+
+    function test_pauseBlocksDepositsButNotWithdrawals() public {
+        _deposit(alice, 1_000 * USDC_UNIT);
+
+        vm.prank(owner);
+        vault.pause();
+        assertEq(vault.maxDeposit(alice), 0);
+        assertEq(vault.maxMint(alice), 0);
+
+        usdc.mint(bob, 100 * USDC_UNIT);
+        vm.startPrank(bob);
+        usdc.approve(address(vault), type(uint256).max);
+        vm.expectRevert(abi.encodeWithSelector(ERC4626.ERC4626ExceededMaxDeposit.selector, bob, 100 * USDC_UNIT, 0));
+        vault.deposit(100 * USDC_UNIT, bob);
+        vm.stopPrank();
+
+        uint256 aliceShares = vault.balanceOf(alice);
+        vm.prank(alice);
+        vault.redeem(aliceShares, alice, alice);
+        assertGt(usdc.balanceOf(alice), 0);
+    }
+
+    // ---------------------------------------------------------------- withdrawals & fees
+
+    function test_withdrawalFeeStaysInTheVault() public {
+        _deposit(alice, 1_000 * USDC_UNIT);
+        _deposit(bob, 1_000 * USDC_UNIT);
+
+        uint256 aliceShares = vault.balanceOf(alice);
+        uint256 expected = vault.previewRedeem(aliceShares);
+        // 50 bps of 1,000 USDC.
+        assertEq(expected, 995 * USDC_UNIT);
+
+        vm.prank(alice);
+        uint256 got = vault.redeem(aliceShares, alice, alice);
+
+        assertEq(got, expected);
+        assertEq(usdc.balanceOf(alice), expected);
+        // Bob is the only holder left and now owns the 5 USDC Alice left behind.
+        assertEq(vault.totalAssets(), 1_005 * USDC_UNIT);
+        assertEq(vault.maxWithdraw(bob), vault.previewRedeem(vault.balanceOf(bob)));
+    }
+
+    function test_withdrawDeliversTheExactRequestedAmount() public {
+        _deposit(alice, 1_000 * USDC_UNIT);
+
+        uint256 want = 500 * USDC_UNIT;
+        uint256 sharesQuoted = vault.previewWithdraw(want);
+
+        vm.prank(alice);
+        uint256 sharesBurned = vault.withdraw(want, alice, alice);
+
+        assertEq(sharesBurned, sharesQuoted);
+        assertEq(usdc.balanceOf(alice), want, "receiver gets exactly what it asked for");
+        assertGt(sharesBurned, 500 * WAD, "the fee is paid in extra shares");
+    }
+
+    /// @notice previewWithdraw must never quote fewer shares than a redeem round trip implies,
+    ///         otherwise withdraw/deposit cycling would mint value out of thin air.
+    function testFuzz_previewRoundTripCannotProfit(uint256 deposited, uint256 redeemed) public {
+        deposited = bound(deposited, 1 * USDC_UNIT, 10_000_000 * USDC_UNIT);
+        _deposit(alice, deposited);
+
+        uint256 shares = vault.balanceOf(alice);
+        redeemed = bound(redeemed, 1, shares);
+
+        uint256 assetsOut = vault.previewRedeem(redeemed);
+        vm.assume(assetsOut > 0);
+        assertLe(vault.previewWithdraw(assetsOut), redeemed, "round trip must not return shares");
+    }
+
+    function test_maxWithdrawIsNetOfFee() public {
+        _deposit(alice, 1_000 * USDC_UNIT);
+        assertEq(vault.maxWithdraw(alice), 995 * USDC_UNIT);
+        assertEq(vault.maxRedeem(alice), vault.balanceOf(alice));
+    }
+
+    function test_withdrawRevertsWhenStrategyCannotCover() public {
+        MockIlliquidStrategy stuck = new MockIlliquidStrategy(address(vault), address(usdc));
+        vm.prank(owner);
+        vault.setStrategy(stuck);
+
+        _deposit(alice, 1_000 * USDC_UNIT);
+
+        // The strategy claims to hold 4,000 USDC on top of the 1,000 idle, but cannot free any of it.
+        vm.prank(address(vault));
+        assertTrue(usdc.transfer(address(stuck), 1_000 * USDC_UNIT));
+        stuck.setReported(4_000 * USDC_UNIT);
+
+        vm.prank(alice);
+        vm.expectRevert(abi.encodeWithSelector(YieldVault.InsufficientLiquidity.selector, 500 * USDC_UNIT, 0));
+        vault.withdraw(500 * USDC_UNIT, alice, alice);
+    }
+
+    // ---------------------------------------------------------------- keeper
+
+    function test_deployIdleRespectsBuffer() public {
+        _deposit(alice, 100_000 * USDC_UNIT);
+
+        vm.prank(keeper);
+        uint256 deployed = vault.deployIdle();
+
+        // bufferBps is 5%, so 95,000 USDC goes to work.
+        assertEq(deployed, 95_000 * USDC_UNIT);
+        assertEq(vault.idleAssets(), 5_000 * USDC_UNIT);
+        assertApproxEqRel(
+            vault.totalAssets(), 100_000 * USDC_UNIT, 0.005e18, "value preserved through the LP round trip"
+        );
+    }
+
+    function test_onlyKeeperOrOwnerCanHarvest() public {
+        _deposit(alice, 10_000 * USDC_UNIT);
+
+        vm.prank(alice);
+        vm.expectRevert(abi.encodeWithSelector(YieldVault.NotKeeper.selector, alice));
+        vault.harvest();
+
+        vm.prank(keeper);
+        vault.harvest();
+
+        vm.prank(owner);
+        vault.harvest();
+    }
+
+    function test_harvestRevertsWithoutStrategy() public {
+        vm.prank(owner);
+        vault.setStrategy(IStrategy(address(0)));
+
+        vm.prank(keeper);
+        vm.expectRevert(YieldVault.ZeroAddress.selector);
+        vault.harvest();
+    }
+
+    // ---------------------------------------------------------------- admin
+
+    function test_setStrategyPullsFundsBack() public {
+        _deposit(alice, 100_000 * USDC_UNIT);
+        vm.prank(keeper);
+        vault.deployIdle();
+        assertGt(strategy.totalLpBalance(), 0);
+
+        vm.prank(owner);
+        vault.setStrategy(IStrategy(address(0)));
+
+        assertEq(strategy.totalLpBalance(), 0);
+        assertEq(address(vault.strategy()), address(0));
+        assertApproxEqRel(vault.idleAssets(), 100_000 * USDC_UNIT, 0.01e18);
+    }
+
+    function test_setStrategyRejectsForeignStrategy() public {
+        YieldVault other = new YieldVault(IERC20(address(usdc)), "Other", "oth", owner, treasury);
+        vm.prank(owner);
+        vm.expectRevert(YieldVault.StrategyMismatch.selector);
+        other.setStrategy(strategy); // strategy.vault() points at `vault`, not `other`
+    }
+
+    function test_feeAndBufferBounds() public {
+        vm.startPrank(owner);
+
+        vm.expectRevert(abi.encodeWithSelector(YieldVault.FeeTooHigh.selector, 2_001, 2_000));
+        vault.setPerformanceFee(2_001);
+        vault.setPerformanceFee(2_000);
+        assertEq(vault.performanceFeeBps(), 2_000);
+
+        vm.expectRevert(abi.encodeWithSelector(YieldVault.FeeTooHigh.selector, 101, 100));
+        vault.setWithdrawalFee(101);
+        vault.setWithdrawalFee(100);
+
+        vm.expectRevert(abi.encodeWithSelector(YieldVault.BpsTooHigh.selector, 10_001));
+        vault.setBuffer(10_001);
+
+        vm.stopPrank();
+    }
+
+    function test_adminFunctionsAreOwnerOnly() public {
+        bytes memory err = abi.encodeWithSelector(Ownable.OwnableUnauthorizedAccount.selector, alice);
+        vm.startPrank(alice);
+
+        vm.expectRevert(err);
+        vault.setStrategy(IStrategy(address(0)));
+        vm.expectRevert(err);
+        vault.setKeeper(alice, true);
+        vm.expectRevert(err);
+        vault.setTreasury(alice);
+        vm.expectRevert(err);
+        vault.setPerformanceFee(0);
+        vm.expectRevert(err);
+        vault.setWithdrawalFee(0);
+        vm.expectRevert(err);
+        vault.setBuffer(0);
+        vm.expectRevert(err);
+        vault.setDepositCap(0);
+        vm.expectRevert(err);
+        vault.pause();
+
+        vm.stopPrank();
+    }
+
+    function test_ownershipTransferIsTwoStep() public {
+        vm.prank(owner);
+        vault.transferOwnership(alice);
+        assertEq(vault.owner(), owner, "not transferred until accepted");
+
+        vm.prank(alice);
+        vault.acceptOwnership();
+        assertEq(vault.owner(), alice);
+    }
+
+    /// @notice The classic ERC-4626 first-depositor attack: donate to inflate the share price, then
+    ///         the victim's deposit rounds to zero shares. The 1e12 virtual offset defeats it.
+    function test_inflationAttackIsIneffective() public {
+        usdc.mint(alice, 1);
+        vm.startPrank(alice);
+        usdc.approve(address(vault), type(uint256).max);
+        vault.deposit(1, alice); // 1 wei of USDC -> 1e12 shares
+        vm.stopPrank();
+
+        usdc.mint(address(vault), 10_000 * USDC_UNIT); // donation
+
+        uint256 bobShares = _deposit(bob, 20_000 * USDC_UNIT);
+        assertGt(bobShares, 0, "victim must still receive shares");
+
+        vm.prank(bob);
+        uint256 out = vault.redeem(bobShares, bob, bob);
+        // Bob loses the 0.50% withdrawal fee and a unit of rounding, not his whole deposit.
+        assertApproxEqAbs(out, 19_900 * USDC_UNIT, 10, "attacker cannot capture the deposit");
+    }
