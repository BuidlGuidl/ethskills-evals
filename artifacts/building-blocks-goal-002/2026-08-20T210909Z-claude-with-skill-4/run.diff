+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+import {Script, console2} from "forge-std/Script.sol";
+
+import {YieldVault} from "../src/YieldVault.sol";
+import {AerodromeUsdcWethStrategy} from "../src/AerodromeUsdcWethStrategy.sol";
+
+/// @notice Deploy idle deposits into the strategy.
+/// @dev    forge script script/Keeper.s.sol:Earn --rpc-url $BASE_RPC_URL --broadcast
+///         Set EARN_CHUNK to cap how much is zapped per transaction (price impact grows with size).
+contract Earn is Script {
+    function run() external {
+        YieldVault vault = YieldVault(vm.envAddress("VAULT"));
+        uint256 idle = vault.idleAssets();
+        uint256 chunk = vm.envOr("EARN_CHUNK", type(uint256).max);
+        if (idle == 0) {
+            console2.log("nothing idle, skipping");
+            return;
+        }
+
+        vm.startBroadcast();
+        uint256 invested = chunk >= idle ? vault.earn() : vault.earn(chunk);
+        vm.stopBroadcast();
+
+        console2.log("invested:", invested);
+        console2.log("idle left:", vault.idleAssets());
+    }
+}
+
+/// @notice Claim AERO emissions and compound them.
+/// @dev    forge script script/Keeper.s.sol:Harvest --rpc-url $BASE_RPC_URL --broadcast
+///         Skips when the pending reward is not worth the gas (MIN_HARVEST_USDC, 6 decimals).
+contract Harvest is Script {
+    function run() external {
+        AerodromeUsdcWethStrategy strategy = AerodromeUsdcWethStrategy(vm.envAddress("STRATEGY"));
+        uint256 minHarvest = vm.envOr("MIN_HARVEST_USDC", uint256(25e6));
+
+        uint256 pendingAero = strategy.pendingRewards();
+        uint256 pendingValue = (pendingAero * strategy.twapUsdcPerAero()) / 1e18;
+        console2.log("pending AERO :", pendingAero);
+        console2.log("pending USDC :", pendingValue);
+
+        if (pendingValue < minHarvest) {
+            console2.log("below MIN_HARVEST_USDC, skipping");
+            return;
+        }
+
+        vm.startBroadcast();
+        (uint256 claimed, uint256 compounded) = strategy.harvest();
+        vm.stopBroadcast();
+
+        console2.log("claimed AERO :", claimed);
+        console2.log("compounded   :", compounded);
+        console2.log("total assets :", strategy.estimatedTotalAssets());
+    }
+}
