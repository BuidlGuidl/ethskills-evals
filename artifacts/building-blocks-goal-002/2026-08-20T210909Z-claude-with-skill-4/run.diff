+
+        vm.prank(alice);
+        vault.withdraw(1_000e6, alice, alice);
+        assertEq(usdc.balanceOf(alice), 91_000e6);
+    }
+
+    function test_DepositCapIsEnforced() public {
+        vm.prank(owner);
+        vault.setDepositCap(5_000e6);
+
+        assertEq(vault.maxDeposit(alice), 5_000e6);
+        vm.expectRevert(abi.encodeWithSelector(ERC4626.ERC4626ExceededMaxDeposit.selector, alice, 5_001e6, 5_000e6));
+        vm.prank(alice);
+        vault.deposit(5_001e6, alice);
+
+        _deposit(alice, 5_000e6);
+        assertEq(vault.maxDeposit(alice), 0);
+    }
+
+    function test_PauseBlocksDepositsButNotWithdrawals() public {
+        _deposit(alice, 10_000e6);
+
+        vm.prank(owner);
+        vault.pause();
+
+        assertEq(vault.maxDeposit(alice), 0);
+        vm.expectRevert(abi.encodeWithSelector(ERC4626.ERC4626ExceededMaxDeposit.selector, alice, 1e6, 0));
+        vm.prank(alice);
+        vault.deposit(1e6, alice);
+
+        vm.prank(keeper);
+        vm.expectRevert(Pausable.EnforcedPause.selector);
+        vault.earn();
+
+        vm.prank(alice);
+        vault.withdraw(10_000e6, alice, alice);
+        assertEq(usdc.balanceOf(alice), 100_000e6);
+    }
+
+    function test_InflationAttackIsNotProfitable() public {
+        // Attacker seeds 1 wei of shares then donates a large amount to move the share price.
+        address attacker = bob;
+        vm.prank(attacker);
+        vault.deposit(1, attacker);
+        vm.prank(attacker);
+        usdc.transfer(address(vault), 10_000e6);
+
+        uint256 victimShares = _deposit(alice, 5_000e6);
+        assertGt(victimShares, 0, "victim rounded down to zero shares");
+
+        vm.prank(alice);
+        uint256 out = vault.redeem(victimShares, alice, alice);
+        // Virtual shares cap the attacker's take at rounding dust.
+        assertApproxEqRel(out, 5_000e6, 1e15, "victim lost more than 0.1%");
+    }
+
+    /*//////////////////////////////////////////////////////////////
