+
+    function test_DepositMintsSharesAndKeepsFundsIdle() public {
+        uint256 shares = _deposit(alice, 10_000e6);
+
+        assertGt(shares, 0, "no shares minted");
+        assertEq(vault.totalAssets(), 10_000e6);
