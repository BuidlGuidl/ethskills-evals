+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+
+import {IStrategy} from "../../src/interfaces/IStrategy.sol";
+import {MockERC20} from "./MockERC20.sol";
+
+/// @notice Stand-in for the Aerodrome strategy used to exercise vault accounting without a fork.
+contract MockStrategy is IStrategy {
+    using SafeERC20 for IERC20;
+
+    address public immutable asset;
+    address public immutable vault;
+
+    /// @notice Portion of the balance that cannot be liquidated on demand (simulates an
+    ///         illiquid or price-blocked position).
+    uint256 public lockedAssets;
+    bool public investReverts;
+
+    constructor(address _asset, address _vault) {
+        asset = _asset;
+        vault = _vault;
+    }
+
+    function estimatedTotalAssets() external view returns (uint256) {
+        return IERC20(asset).balanceOf(address(this));
+    }
+
+    function invest() external {
+        require(!investReverts, "invest disabled");
+    }
+
+    function withdraw(uint256 amount) external returns (uint256) {
+        require(msg.sender == vault, "!vault");
+        uint256 balance = IERC20(asset).balanceOf(address(this));
+        uint256 liquid = balance > lockedAssets ? balance - lockedAssets : 0;
+        uint256 sent = amount > liquid ? liquid : amount;
+        if (sent > 0) IERC20(asset).safeTransfer(vault, sent);
+        return sent;
+    }
+
+    /// @dev Test helper: simulate harvested yield landing in the strategy.
+    function simulateProfit(uint256 amount) external {
+        MockERC20(asset).mint(address(this), amount);
+    }
+
+    /// @dev Test helper: simulate an impermanent-loss style drawdown.
+    function simulateLoss(uint256 amount) external {
+        MockERC20(asset).burn(address(this), amount);
+    }
+
+    function setLockedAssets(uint256 amount) external {
+        lockedAssets = amount;
+    }
+
+    function setInvestReverts(bool value) external {
+        investReverts = value;
+    }
+}

