+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+import {Script, console2} from "forge-std/Script.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+
+import {YieldVault} from "../src/YieldVault.sol";
+import {AerodromeUsdcWethStrategy} from "../src/AerodromeUsdcWethStrategy.sol";
+import {IGauge, IPoolFactory, IVoter} from "../src/interfaces/IAerodrome.sol";
+
+/// @notice Deploys the vault + Aerodrome strategy on Base.
+/// @dev    forge script script/Deploy.s.sol:Deploy --rpc-url $BASE_RPC_URL --broadcast --verify
+contract Deploy is Script {
+    // Base mainnet, verified onchain 2026-08-20.
+    address internal constant USDC = 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913;
+    address internal constant WETH = 0x4200000000000000000000000000000000000006;
+    address internal constant AERO = 0x940181a94A35A4569E4529A3CDfB74e38FD98631;
+    address internal constant ROUTER = 0xcF77a3Ba9A5CA399B7c97c74d54e5b1Beb874E43;
+    address internal constant POOL_FACTORY = 0x420DD381b31aEf6683db6B902084cB0FFECe40Da;
+    address internal constant VOTER = 0x16613524e02ad97eDfeF371bC883F2F5d6C480A5;
+
+    function run() external returns (YieldVault vault, AerodromeUsdcWethStrategy strategy) {
+        require(block.chainid == 8453, "Deploy: Base mainnet only");
+
+        address owner = vm.envAddress("OWNER");
+        address treasury = vm.envAddress("TREASURY");
+        address keeper = vm.envAddress("KEEPER");
+        uint256 cap = vm.envOr("DEPOSIT_CAP", uint256(250_000e6));
+
+        // Fail before spending gas if the venue is not in the state we underwrote.
+        address pool = IPoolFactory(POOL_FACTORY).getPool(WETH, USDC, false);
+        address gauge = IVoter(VOTER).gauges(pool);
+        require(pool != address(0), "Deploy: no vAMM-WETH/USDC pool");
+        require(gauge != address(0) && IVoter(VOTER).isAlive(gauge), "Deploy: gauge missing or killed");
+        require(IGauge(gauge).rewardToken() == AERO, "Deploy: unexpected reward token");
+
+        vm.startBroadcast();
+
+        // The deployer owns both contracts while wiring them up, then hands over to `owner`.
+        vault = new YieldVault(IERC20(USDC), "Base Yield USDC", "byUSDC", cap, msg.sender);
+        strategy = new AerodromeUsdcWethStrategy(
+            address(vault), USDC, WETH, AERO, ROUTER, POOL_FACTORY, VOTER, treasury, msg.sender
+        );
+
+        vault.setStrategy(address(strategy));
+        vault.setKeeper(keeper, true);
+        strategy.setKeeper(keeper, true);
+
+        vault.transferOwnership(owner);
+        strategy.transferOwnership(owner);
+
+        vm.stopBroadcast();
+
+        console2.log("vault      :", address(vault));
+        console2.log("strategy   :", address(strategy));
+        console2.log("pool       :", pool);
+        console2.log("gauge      :", gauge);
+        console2.log("keeper     :", keeper);
+        console2.log("treasury   :", treasury);
+        console2.log("deposit cap:", cap);
+        console2.log("ACTION: %s must call acceptOwnership() on both contracts.", owner);
+    }
+}
