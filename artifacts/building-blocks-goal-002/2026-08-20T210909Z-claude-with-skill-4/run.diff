+
+    function test_WithdrawPullsFromStrategy() public {
+        _deposit(alice, 10_000e6);
+        vm.prank(keeper);
+        vault.earn();
+
+        uint256 before = usdc.balanceOf(alice);
+        vm.prank(alice);
+        vault.withdraw(4_000e6, alice, alice);
+
+        assertEq(usdc.balanceOf(alice) - before, 4_000e6);
+        assertEq(vault.totalAssets(), 6_000e6);
+        assertEq(usdc.balanceOf(address(strategy)), 6_000e6);
+    }
+
+    function test_RedeemAllReturnsFullBalance() public {
+        uint256 shares = _deposit(alice, 10_000e6);
+        vm.prank(keeper);
+        vault.earn();
+
+        vm.prank(alice);
+        uint256 assets = vault.redeem(shares, alice, alice);
+
+        assertEq(assets, 10_000e6);
+        assertEq(vault.totalSupply(), 0);
+        assertEq(vault.totalAssets(), 0);
+    }
+
+    function test_HarvestYieldAccruesToExistingShareholders() public {
+        uint256 aliceShares = _deposit(alice, 10_000e6);
+        vm.prank(keeper);
+        vault.earn();
+
+        // Strategy compounds 1,000 USDC of AERO rewards.
+        strategy.simulateProfit(1_000e6);
+        assertEq(vault.totalAssets(), 11_000e6);
+        assertApproxEqAbs(vault.convertToAssets(aliceShares), 11_000e6, 1);
+
+        // A later depositor buys in at the higher share price: same money, ~10% fewer shares.
+        uint256 bobShares = _deposit(bob, 10_000e6);
+        assertLt(bobShares, aliceShares, "late depositor must not capture past yield");
+        assertApproxEqRel(bobShares, (aliceShares * 10) / 11, 1e12);
+        assertApproxEqRel(vault.convertToAssets(bobShares), 10_000e6, 1e12);
+        assertApproxEqRel(vault.convertToAssets(aliceShares), 11_000e6, 1e12);
+    }
+
+    function test_LossIsSharedProRata() public {
+        uint256 aliceShares = _deposit(alice, 10_000e6);
+        uint256 bobShares = _deposit(bob, 10_000e6);
+        vm.prank(keeper);
+        vault.earn();
+
+        strategy.simulateLoss(2_000e6); // e.g. impermanent loss on the LP leg
+
+        assertApproxEqAbs(vault.convertToAssets(aliceShares), 9_000e6, 1);
+        assertApproxEqAbs(vault.convertToAssets(bobShares), 9_000e6, 1);
+    }
+
+    /*//////////////////////////////////////////////////////////////
+                           FAILURE BEHAVIOUR
+    //////////////////////////////////////////////////////////////*/
+
+    function test_WithdrawRevertsWhenStrategyCannotLiquidate() public {
+        _deposit(alice, 10_000e6);
+        vm.prank(keeper);
+        vault.earn();
+
+        strategy.setLockedAssets(10_000e6); // position stuck (killed gauge, price guard, ...)
+
+        vm.expectRevert(abi.encodeWithSelector(YieldVault.InsufficientLiquidity.selector, 1_000e6, 0));
+        vm.prank(alice);
+        vault.withdraw(1_000e6, alice, alice);
