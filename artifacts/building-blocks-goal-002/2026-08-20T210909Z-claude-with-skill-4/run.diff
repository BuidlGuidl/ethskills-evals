--- /dev/null
+++ b/src/utils/Keepered.sol
@@ -0,0 +1,23 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+import {Ownable, Ownable2Step} from "@openzeppelin/contracts/access/Ownable2Step.sol";
+
+/// @notice Owner-managed set of keeper addresses allowed to run maintenance calls.
+abstract contract Keepered is Ownable2Step {
+    mapping(address => bool) public isKeeper;
+
+    event KeeperSet(address indexed keeper, bool allowed);
+
+    error NotKeeper(address caller);
+
+    modifier onlyKeeper() {
+        if (!isKeeper[msg.sender] && msg.sender != owner()) revert NotKeeper(msg.sender);
+        _;
+    }
+
+    function setKeeper(address keeper, bool allowed) external onlyOwner {
+        isKeeper[keeper] = allowed;
+        emit KeeperSet(keeper, allowed);
+    }
+}
diff --git a/test/AerodromeStrategyFork.t.sol b/test/AerodromeStrategyFork.t.sol
new file mode 100644
index 0000000..ec0197d
--- /dev/null
+++ b/test/AerodromeStrategyFork.t.sol
@@ -0,0 +1,311 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+import {Test, console2} from "forge-std/Test.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+
+import {YieldVault} from "../src/YieldVault.sol";
+import {AerodromeUsdcWethStrategy} from "../src/AerodromeUsdcWethStrategy.sol";
+import {Keepered} from "../src/utils/Keepered.sol";
+import {IGauge, IPool, IRouter, IVoter} from "../src/interfaces/IAerodrome.sol";
+
+/// @notice End-to-end tests against live Base state.
+/// @dev Every address below was read from Base mainnet at block 50,235,433 (2026-08-20 21:10 UTC).
+///      The suite skips itself when the RPC cannot serve the pinned block, so `forge test` still
+///      passes offline; set BASE_RPC_URL to an archive node to always run it.
+contract AerodromeStrategyForkTest is Test {
+    address internal constant USDC = 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913;
+    address internal constant WETH = 0x4200000000000000000000000000000000000006;
+    address internal constant AERO = 0x940181a94A35A4569E4529A3CDfB74e38FD98631;
+    address internal constant ROUTER = 0xcF77a3Ba9A5CA399B7c97c74d54e5b1Beb874E43;
+    address internal constant POOL_FACTORY = 0x420DD381b31aEf6683db6B902084cB0FFECe40Da;
+    address internal constant VOTER = 0x16613524e02ad97eDfeF371bC883F2F5d6C480A5;
+    address internal constant POOL = 0xcDAC0d6c6C59727a65F871236188350531885C43; // vAMM-WETH/USDC
+    address internal constant GAUGE = 0x519BBD1Dd8C6A94C46080E24f316c14Ee758C025;
+
+    uint256 internal constant FORK_BLOCK = 50_235_000;
+    uint256 internal constant DEPOSIT = 50_000e6;
+
+    YieldVault internal vault;
+    AerodromeUsdcWethStrategy internal strategy;
+
+    address internal owner = makeAddr("owner");
+    address internal keeper = makeAddr("keeper");
+    address internal treasury = makeAddr("treasury");
+    address internal alice = makeAddr("alice");
+    address internal bob = makeAddr("bob");
+
+    bool internal forked;
+
+    function setUp() public {
+        forked = _selectFork();
+        if (!forked) return;
+
+        vault = new YieldVault(IERC20(USDC), "Base Yield USDC", "byUSDC", 10_000_000e6, owner);
+        strategy = new AerodromeUsdcWethStrategy(
+            address(vault), USDC, WETH, AERO, ROUTER, POOL_FACTORY, VOTER, treasury, owner
+        );
+
+        vm.startPrank(owner);
+        vault.setStrategy(address(strategy));
+        vault.setKeeper(keeper, true);
+        strategy.setKeeper(keeper, true);
+        vm.stopPrank();
+
+        deal(USDC, alice, DEPOSIT);
+        deal(USDC, bob, DEPOSIT);
+        vm.prank(alice);
+        IERC20(USDC).approve(address(vault), type(uint256).max);
+        vm.prank(bob);
+        IERC20(USDC).approve(address(vault), type(uint256).max);
+    }
+
+    /// @dev Try the pinned block, fall back to the chain tip, and give up (skip) with no RPC.
+    function _selectFork() internal returns (bool) {
+        string memory url = vm.envOr("BASE_RPC_URL", string("https://mainnet.base.org"));
+        try vm.createSelectFork(url, FORK_BLOCK) {
+            if (_stateAvailable()) return true;
+        } catch {}
+        try vm.createSelectFork(url) {
+            if (_stateAvailable()) return true;
+        } catch {}
+        return false;
+    }
+
+    function _stateAvailable() internal view returns (bool) {
+        try IPool(POOL).getReserves() returns (uint256 r0, uint256, uint256) {
+            return r0 > 0 && IVoter(VOTER).isAlive(GAUGE);
+        } catch {
+            return false;
+        }
+    }
+
+    modifier onFork() {
+        vm.skip(!forked);
+        _;
+    }
+
+    function _depositAndEarn(address who, uint256 amount) internal {
+        vm.prank(who);
+        vault.deposit(amount, who);
+        vm.prank(keeper);
+        vault.earn();
+    }
+
+    /*//////////////////////////////////////////////////////////////
+                             WIRING / SETUP
+    //////////////////////////////////////////////////////////////*/
+
+    function test_Fork_ResolvesLivePoolAndGauge() public onFork {
+        assertEq(address(strategy.pool()), POOL, "pool");
+        assertEq(address(strategy.gauge()), GAUGE, "gauge");
+        assertEq(IGauge(GAUGE).stakingToken(), POOL, "gauge stakes the pool LP");
+        assertEq(IGauge(GAUGE).rewardToken(), AERO, "gauge pays AERO");
+        assertTrue(IVoter(VOTER).isAlive(GAUGE), "gauge alive");
+        assertGt(strategy.twapUsdcPerWeth(), 0, "WETH TWAP");
+        assertGt(strategy.twapUsdcPerAero(), 0, "AERO TWAP");
+    }
+
+    /*//////////////////////////////////////////////////////////////
+                              HAPPY PATH
+    //////////////////////////////////////////////////////////////*/
+
+    function test_Fork_DepositEarnStakesLpInGauge() public onFork {
+        _depositAndEarn(alice, DEPOSIT);
+
+        assertGt(IGauge(GAUGE).balanceOf(address(strategy)), 0, "LP not staked");
+        assertEq(IERC20(POOL).balanceOf(address(strategy)), 0, "LP left unstaked");
+        // Zap cost = 30 bps swap fee on half the deposit + price impact.
+        assertApproxEqRel(vault.totalAssets(), DEPOSIT, 0.005e18, "value lost zapping > 0.5%");
+        assertApproxEqRel(strategy.estimatedTotalAssets(), DEPOSIT, 0.005e18);
+    }
+
+    function test_Fork_HarvestClaimsFeesAndCompounds() public onFork {
+        _depositAndEarn(alice, DEPOSIT);
+
+        uint256 lpBefore = IGauge(GAUGE).balanceOf(address(strategy));
+        uint256 assetsBefore = vault.totalAssets();
+
+        vm.warp(block.timestamp + 3 days);
+        assertGt(IGauge(GAUGE).earned(address(strategy)), 0, "no emissions accrued");
+
+        vm.prank(keeper);
+        (uint256 aeroClaimed, uint256 usdcCompounded) = strategy.harvest();
+
+        assertGt(aeroClaimed, 0, "no AERO claimed");
+        assertGt(usdcCompounded, 0, "AERO not sold into USDC");
+        assertEq(IERC20(AERO).balanceOf(treasury), (aeroClaimed * strategy.performanceFeeBps()) / 10_000, "fee");
+        assertEq(IERC20(AERO).balanceOf(address(strategy)), 0, "AERO left idle");
+        assertGt(IGauge(GAUGE).balanceOf(address(strategy)), lpBefore, "position did not grow");
+        assertGt(vault.totalAssets(), assetsBefore, "share price did not increase");
+        assertEq(strategy.lastHarvest(), block.timestamp);
+
+        console2.log("AERO claimed (3d):", aeroClaimed);
+        console2.log("USDC compounded  :", usdcCompounded);
+    }
+
+    function test_Fork_HarvestIsKeeperGated() public onFork {
+        _depositAndEarn(alice, DEPOSIT);
+        vm.expectRevert(abi.encodeWithSelector(Keepered.NotKeeper.selector, alice));
+        vm.prank(alice);
+        strategy.harvest();
+    }
+
+    function test_Fork_HarvestWithoutRewardsIsHarmless() public onFork {
+        _depositAndEarn(alice, DEPOSIT);
+        vm.prank(keeper);
+        (uint256 aeroClaimed, uint256 usdcCompounded) = strategy.harvest();
+        assertEq(aeroClaimed, 0);
+        assertEq(usdcCompounded, 0);
+    }
+
+    function test_Fork_WithdrawPartialThenFull() public onFork {
+        _depositAndEarn(alice, DEPOSIT);
+
+        vm.prank(alice);
+        vault.withdraw(10_000e6, alice, alice);
+        assertEq(IERC20(USDC).balanceOf(alice), 10_000e6, "partial withdrawal short");
+
+        uint256 shares = vault.balanceOf(alice);
+        vm.prank(alice);
+        vault.redeem(shares, alice, alice);
+
+        assertEq(vault.balanceOf(alice), 0);
+        // Round trip cost: zap in + unwind out, both across a 30 bps pool.
+        assertApproxEqRel(IERC20(USDC).balanceOf(alice), DEPOSIT, 0.01e18, "round trip lost > 1%");
+        // Rounding + the withdrawal buffer leave a little USDC behind; it accrues to whoever
+        // deposits next rather than to the exiting user.
+        assertLt(vault.totalAssets(), DEPOSIT / 1_000, "dust left behind exceeds 0.1%");
+    }
+
+    function test_Fork_TwoDepositorsShareHarvestProRata() public onFork {
+        // Both deposits are batched into one `earn()`, so both pay the same entry cost.
+        vm.prank(alice);
+        vault.deposit(DEPOSIT, alice);
+        vm.prank(bob);
+        vault.deposit(DEPOSIT, bob);
+        vm.prank(keeper);
+        vault.earn();
+
+        vm.warp(block.timestamp + 3 days);
+        vm.prank(keeper);
+        strategy.harvest();
+
+        uint256 aliceValue = vault.convertToAssets(vault.balanceOf(alice));
+        uint256 bobValue = vault.convertToAssets(vault.balanceOf(bob));
+        assertApproxEqRel(aliceValue, bobValue, 0.001e18, "equal deposits must be worth the same");
+        assertGt(aliceValue + bobValue, (2 * DEPOSIT * 99) / 100, "harvest did not cover costs");
+    }
+
+    /// @notice Known trade-off of investing on `earn()` rather than on each deposit: the zap cost
+    ///         of a new deposit is paid out of pooled assets, so existing holders take a small
+    ///         dilution. Documented in the README; bounded here so a regression is visible.
+    function test_Fork_EntryCostOfLaterDepositIsSocialised() public onFork {
+        _depositAndEarn(alice, DEPOSIT);
+        uint256 aliceBefore = vault.convertToAssets(vault.balanceOf(alice));
+
+        _depositAndEarn(bob, DEPOSIT);
+        uint256 aliceAfter = vault.convertToAssets(vault.balanceOf(alice));
+
+        assertLt(aliceAfter, aliceBefore, "entry cost is expected to be shared");
+        assertGt(aliceAfter, (aliceBefore * 99) / 100, "dilution from a same-size entry > 1%");
+    }
+
+    /*//////////////////////////////////////////////////////////////
+                           FAILURE BEHAVIOUR
+    //////////////////////////////////////////////////////////////*/
+
+    function test_Fork_SpotManipulationBlocksInvest() public onFork {
+        vm.prank(alice);
+        vault.deposit(DEPOSIT, alice);
+
+        _pushSpotPrice(400 ether); // whale buys USDC with 400 WETH
+
+        vm.prank(keeper);
+        vm.expectPartialRevert(AerodromeUsdcWethStrategy.PriceOutOfRange.selector);
+        vault.earn();
+    }
+
+    function test_Fork_ShareValueSurvivesSpotManipulation() public onFork {
+        _depositAndEarn(alice, DEPOSIT);
+        uint256 before = vault.totalAssets();
+
+        _pushSpotPrice(400 ether);
+
+        // Fair-reserves pricing keys off the invariant and the TWAP: the attacker's swap adds
+        // fees to the pool but cannot move the vault's accounting in their favour.
+        assertApproxEqRel(vault.totalAssets(), before, 0.002e18, "share price moved with spot");
+    }
+
+    function test_Fork_KilledGaugeBlocksInvestAndPanicRecoversFunds() public onFork {
+        _depositAndEarn(alice, DEPOSIT);
+
+        // Governance kills the gauge: Aerodrome's Gauge.deposit() reverts once isAlive is false.
+        vm.mockCall(VOTER, abi.encodeWithSelector(IVoter.isAlive.selector, GAUGE), abi.encode(false));
+
+        deal(USDC, address(strategy), 1_000e6);
+        vm.prank(keeper);
+        vm.expectPartialRevert(AerodromeUsdcWethStrategy.GaugeNotAlive.selector);
+        strategy.invest();
+
+        // The owner unwinds to USDC; depositors keep their claim and can exit.
+        vm.prank(owner);
+        strategy.panic(0);
+        assertTrue(strategy.emergencyExited());
+        assertEq(IGauge(GAUGE).balanceOf(address(strategy)), 0, "still staked");
+        assertEq(IERC20(POOL).balanceOf(address(strategy)), 0, "LP not unwound");
+        assertGt(IERC20(USDC).balanceOf(address(strategy)), 0, "no USDC recovered");
+
+        uint256 shares = vault.balanceOf(alice);
+        vm.prank(alice);
+        vault.redeem(shares, alice, alice);
+        assertApproxEqRel(IERC20(USDC).balanceOf(alice), DEPOSIT + 1_000e6, 0.01e18);
+    }
+
+    function test_Fork_PanicStopsRedeployingCapital() public onFork {
+        _depositAndEarn(alice, DEPOSIT);
+        vm.prank(owner);
+        strategy.panic(0);
+
+        vm.prank(keeper);
+        vault.earn(); // must not revert, and must not re-enter the pool
+        assertEq(IGauge(GAUGE).balanceOf(address(strategy)), 0, "capital redeployed after panic");
+
+        vm.prank(owner);
+        strategy.resume();
+        vm.prank(keeper);
+        strategy.invest();
+        assertGt(IGauge(GAUGE).balanceOf(address(strategy)), 0, "resume did not redeploy");
+    }
+
+    function test_Fork_OnlyVaultCanWithdraw() public onFork {
+        _depositAndEarn(alice, DEPOSIT);
+        vm.expectRevert(abi.encodeWithSelector(AerodromeUsdcWethStrategy.NotVault.selector, alice));
+        vm.prank(alice);
+        strategy.withdraw(1e6);
+    }
+
+    function test_Fork_SetGaugeRejectsForeignGauge() public onFork {
+        vm.expectRevert(AerodromeUsdcWethStrategy.InvalidParam.selector);
+        vm.prank(owner);
+        strategy.setGauge(address(0xBEEF));
+    }
+
+    /*//////////////////////////////////////////////////////////////
+                                HELPERS
+    //////////////////////////////////////////////////////////////*/
+
+    /// @dev Dump `wethIn` WETH into the WETH/USDC pool to move the spot price away from the TWAP.
+    function _pushSpotPrice(uint256 wethIn) internal {
+        address whale = makeAddr("whale");
+        deal(WETH, whale, wethIn);
+
+        IRouter.Route[] memory routes = new IRouter.Route[](1);
+        routes[0] = IRouter.Route({from: WETH, to: USDC, stable: false, factory: POOL_FACTORY});
+
+        vm.startPrank(whale);
+        IERC20(WETH).approve(ROUTER, wethIn);
+        IRouter(ROUTER).swapExactTokensForTokens(wethIn, 0, routes, whale, block.timestamp);
+        vm.stopPrank();
+    }
+}
diff --git a/test/YieldVault.t.sol b/test/YieldVault.t.sol
new file mode 100644
index 0000000..6c8d5dc
--- /dev/null
+++ b/test/YieldVault.t.sol
@@ -0,0 +1,305 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+import {Test} from "forge-std/Test.sol";
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {ERC4626} from "@openzeppelin/contracts/token/ERC20/extensions/ERC4626.sol";
+import {Ownable} from "@openzeppelin/contracts/access/Ownable.sol";
+import {Pausable} from "@openzeppelin/contracts/utils/Pausable.sol";
+
+import {YieldVault} from "../src/YieldVault.sol";
+import {Keepered} from "../src/utils/Keepered.sol";
+import {MockERC20} from "./mocks/MockERC20.sol";
+import {MockStrategy} from "./mocks/MockStrategy.sol";
+
+/// @notice Vault accounting, access control and failure behaviour, exercised against a mock
+///         strategy so these run without network access.
+contract YieldVaultTest is Test {
+    MockERC20 internal usdc;
+    YieldVault internal vault;
+    MockStrategy internal strategy;
+
+    address internal owner = makeAddr("owner");
+    address internal keeper = makeAddr("keeper");
+    address internal alice = makeAddr("alice");
+    address internal bob = makeAddr("bob");
+
+    uint256 internal constant CAP = 1_000_000e6;
+
+    function setUp() public {
+        usdc = new MockERC20("USD Coin", "USDC", 6);
+        vault = new YieldVault(IERC20(address(usdc)), "Yield USDC", "yUSDC", CAP, owner);
+        strategy = new MockStrategy(address(usdc), address(vault));
+
+        vm.startPrank(owner);
+        vault.setStrategy(address(strategy));
+        vault.setKeeper(keeper, true);
+        vm.stopPrank();
+
+        usdc.mint(alice, 100_000e6);
+        usdc.mint(bob, 100_000e6);
+        vm.prank(alice);
+        usdc.approve(address(vault), type(uint256).max);
+        vm.prank(bob);
+        usdc.approve(address(vault), type(uint256).max);
+    }
+
+    function _deposit(address who, uint256 amount) internal returns (uint256 shares) {
+        vm.prank(who);
+        shares = vault.deposit(amount, who);
+    }
+
+    /*//////////////////////////////////////////////////////////////
