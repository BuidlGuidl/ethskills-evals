+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+interface IStrategy {
+    /// @notice The token the strategy accounts in and returns to the vault (USDC).
+    function asset() external view returns (address);
+
+    /// @notice The vault allowed to call `invest` / `withdraw`.
+    function vault() external view returns (address);
+
+    /// @notice Value of everything the strategy controls, denominated in `asset()`.
+    function estimatedTotalAssets() external view returns (uint256);
+
+    /// @notice Deploy the strategy's idle `asset()` balance into the position.
+    function invest() external;
+
+    /// @notice Liquidate up to `amount` of `asset()` and send it to the vault.
+    /// @return withdrawn Amount actually transferred to the vault.
+    function withdraw(uint256 amount) external returns (uint256 withdrawn);
+}
