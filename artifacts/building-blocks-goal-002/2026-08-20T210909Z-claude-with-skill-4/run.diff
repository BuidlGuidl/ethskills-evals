+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.24;
+
+import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
+import {ReentrancyGuard} from "@openzeppelin/contracts/utils/ReentrancyGuard.sol";
+import {Math} from "@openzeppelin/contracts/utils/math/Math.sol";
+import {Ownable} from "@openzeppelin/contracts/access/Ownable.sol";
+
+import {Keepered} from "./utils/Keepered.sol";
+import {IStrategy} from "./interfaces/IStrategy.sol";
+import {IGauge, IPool, IPoolFactory, IRouter, IVoter} from "./interfaces/IAerodrome.sol";
+
+/// @title AerodromeUsdcWethStrategy
+/// @notice Turns USDC into Aerodrome vAMM-WETH/USDC liquidity, stakes the LP in the pool's
+///         gauge, and compounds the AERO emissions back into the same position.
+/// @dev    Verified against Base mainnet at block 50,235,433 (2026-08-20):
+///         pool  0xcDAC0d6c6C59727a65F871236188350531885C43 (vAMM-WETH/USDC, 30 bps fee)
+///         gauge 0x519BBD1Dd8C6A94C46080E24f316c14Ee758C025 (alive, rewardToken = AERO)
+///         Fees generated by a gauged Aerodrome pool go to the pool's voters, not to LPs,
+///         so AERO emissions are the entire yield of this position.
+contract AerodromeUsdcWethStrategy is IStrategy, Keepered, ReentrancyGuard {
+    using SafeERC20 for IERC20;
+
+    uint256 public constant MAX_BPS = 10_000;
+    /// @dev Aerodrome pools record one price observation per 30 minute period;
+    ///      4 observations is a ~2 hour TWAP.
+    uint256 public constant TWAP_GRANULARITY = 4;
+    uint256 public constant WETH_UNIT = 1e18;
+    /// @dev Ignore balances below this when zapping (rounding dust).
+    uint256 public constant MIN_INVEST = 1e6; // 1 USDC
+
+    IERC20 public immutable usdc;
+    IERC20 public immutable weth;
+    IERC20 public immutable aero;
+    IPool public immutable pool; // vAMM-WETH/USDC
+    IPool public immutable aeroUsdcPool; // vAMM-USDC/AERO, TWAP source for the reward token
+    IRouter public immutable router;
+    address public immutable poolFactory;
+    IVoter public immutable voter;
+    address public immutable vault;
+    bool internal immutable wethIsToken0;
+
+    IGauge public gauge;
+    address public treasury;
+    /// @notice Cut of every AERO harvest sent to `treasury`, in bps.
+    uint256 public performanceFeeBps = 1_000; // 10%
+    /// @notice Price impact we allow our own trade to cause, on top of the deviation and fee
+    ///         allowances that make up a TWAP-anchored minimum output.
+    uint256 public slippageBps = 50; // 0.5%
+    /// @notice Max tolerated gap between a pool's spot price and its TWAP before we refuse to
+    ///         trade. A volatile pair drifts from a 2h TWAP in normal markets, so this cannot be
+    ///         set arbitrarily tight; it is the anti-manipulation guard, not a slippage knob.
+    uint256 public maxPriceDeviationBps = 200; // 2%
+    /// @notice Extra LP burned on withdrawals to absorb swap fees, in bps.
+    uint256 public withdrawBufferBps = 100; // 1%
+    /// @notice Set by `panic()`: position is fully in USDC and no new funds are deployed.
+    bool public emergencyExited;
+    uint256 public lastHarvest;
+
+    event Invested(uint256 usdcIn, uint256 lpMinted);
+    event Harvested(uint256 aeroClaimed, uint256 feeTaken, uint256 usdcCompounded, uint256 lpMinted);
+    event Withdrawn(uint256 requested, uint256 sent);
+    event Panicked(uint256 usdcRecovered);
+    event GaugeUpdated(address indexed oldGauge, address indexed newGauge);
+    event ParamsUpdated(
+        uint256 performanceFeeBps, uint256 slippageBps, uint256 maxPriceDeviationBps, uint256 withdrawBufferBps
+    );
+    event TreasuryUpdated(address indexed treasury);
+
+    error NotVault(address caller);
+    error EmergencyExited();
+    error GaugeNotAlive(address gauge);
+    error PriceOutOfRange(uint256 spot, uint256 twap);
+    error InvalidParam();
+    error ZeroAddress();
+
+    modifier onlyVault() {
+        if (msg.sender != vault) revert NotVault(msg.sender);
+        _;
+    }
+
+    constructor(
+        address _vault,
+        address _usdc,
+        address _weth,
+        address _aero,
+        address _router,
+        address _poolFactory,
+        address _voter,
+        address _treasury,
+        address _owner
+    ) Ownable(_owner) {
+        if (
+            _vault == address(0) || _usdc == address(0) || _weth == address(0) || _aero == address(0)
+                || _router == address(0) || _poolFactory == address(0) || _voter == address(0)
+                || _treasury == address(0)
+        ) revert ZeroAddress();
+
+        vault = _vault;
+        usdc = IERC20(_usdc);
+        weth = IERC20(_weth);
+        aero = IERC20(_aero);
+        router = IRouter(_router);
+        poolFactory = _poolFactory;
+        voter = IVoter(_voter);
+        treasury = _treasury;
+
+        address _pool = IPoolFactory(_poolFactory).getPool(_weth, _usdc, false);
+        if (_pool == address(0)) revert ZeroAddress();
+        pool = IPool(_pool);
+        wethIsToken0 = IPool(_pool).token0() == _weth;
+
+        address _aeroUsdcPool = IPoolFactory(_poolFactory).getPool(_aero, _usdc, false);
+        if (_aeroUsdcPool == address(0)) revert ZeroAddress();
+        aeroUsdcPool = IPool(_aeroUsdcPool);
+
+        address _gauge = IVoter(_voter).gauges(_pool);
+        if (_gauge == address(0) || !IVoter(_voter).isAlive(_gauge)) revert GaugeNotAlive(_gauge);
+        gauge = IGauge(_gauge);
+    }
+
+    /*//////////////////////////////////////////////////////////////
+                                 VIEWS
+    //////////////////////////////////////////////////////////////*/
+
+    function asset() external view returns (address) {
+        return address(usdc);
+    }
+
+    /// @notice USDC value of idle balances, the staked LP position and unclaimed AERO.
+    /// @dev Prices come from the pools' own 2h TWAP oracles, and the LP position is valued with
+    ///      the invariant + TWAP ("fair reserves") so that a spot-price push inside one block
+    ///      cannot move the vault's share price.
+    function estimatedTotalAssets() public view returns (uint256) {
+        uint256 total = usdc.balanceOf(address(this));
+        total += _wethToUsdc(weth.balanceOf(address(this)));
+        total += _lpValue(totalLp());
+        total += _pendingRewardValue();
+        return total;
+    }
+
+    /// @notice LP tokens held plus LP tokens staked in the gauge.
+    function totalLp() public view returns (uint256) {
+        return IERC20(address(pool)).balanceOf(address(this)) + gauge.balanceOf(address(this));
+    }
+
+    /// @notice AERO claimable from the gauge plus AERO sitting here, net of the performance fee.
+    function pendingRewards() public view returns (uint256) {
+        return gauge.earned(address(this)) + aero.balanceOf(address(this));
+    }
+
+    /// @notice USDC per 1 WETH from the pool's TWAP oracle (6 decimals).
+    function twapUsdcPerWeth() public view returns (uint256) {
+        return pool.quote(address(weth), WETH_UNIT, TWAP_GRANULARITY);
+    }
+
+    /// @notice USDC per 1 AERO from the AERO/USDC pool's TWAP oracle (6 decimals).
+    function twapUsdcPerAero() public view returns (uint256) {
+        return aeroUsdcPool.quote(address(aero), 1e18, TWAP_GRANULARITY);
+    }
+
+    /*//////////////////////////////////////////////////////////////
+                            VAULT / KEEPER
+    //////////////////////////////////////////////////////////////*/
+
+    /// @notice Zap the idle USDC balance into WETH/USDC liquidity and stake it.
+    /// @dev Callable by the vault (right after it forwards deposits) or by a keeper.
+    function invest() external nonReentrant {
+        if (msg.sender != vault && !isKeeper[msg.sender] && msg.sender != owner()) revert NotVault(msg.sender);
+        _invest();
+    }
+
+    /// @notice Claim AERO, take the performance fee, and compound the rest into the position.
+    function harvest() external onlyKeeper nonReentrant returns (uint256 aeroClaimed, uint256 usdcCompounded) {
+        _assertPriceSane(pool, address(weth), WETH_UNIT);
+
+        if (gauge.balanceOf(address(this)) > 0) gauge.getReward(address(this));
+
+        aeroClaimed = aero.balanceOf(address(this));
+        uint256 fee;
+        if (aeroClaimed > 0) {
+            fee = (aeroClaimed * performanceFeeBps) / MAX_BPS;
+            if (fee > 0) aero.safeTransfer(treasury, fee);
+
+            uint256 toSwap = aeroClaimed - fee;
+            if (toSwap > 0) {
+                _assertPriceSane(aeroUsdcPool, address(aero), 1e18);
+                uint256 minOut = _minOut((toSwap * twapUsdcPerAero()) / 1e18, address(aeroUsdcPool));
+                usdcCompounded = _swap(address(aero), address(usdc), toSwap, minOut);
+            }
+        }
+
+        uint256 lpMinted = _invest();
+        lastHarvest = block.timestamp;
+        emit Harvested(aeroClaimed, fee, usdcCompounded, lpMinted);
+    }
+
+    /// @notice Liquidate up to `amount` USDC and send it to the vault.
+    /// @dev Returns the amount actually delivered; the vault decides whether that is enough.
+    function withdraw(uint256 amount) external onlyVault nonReentrant returns (uint256 withdrawn) {
+        uint256 idle = usdc.balanceOf(address(this));
+
+        if (idle < amount) {
+            uint256 twap = twapUsdcPerWeth();
+            _assertPriceSane(pool, address(weth), WETH_UNIT);
+
+            uint256 missing = amount - idle;
+            uint256 lp = totalLp();
+            uint256 lpValue = _lpValue(lp);
+
+            if (lpValue > 0 && lp > 0) {
+                uint256 lpToBurn = Math.mulDiv(lp, missing, lpValue);
+                lpToBurn = (lpToBurn * (MAX_BPS + withdrawBufferBps)) / MAX_BPS;
+                // Anything close to a full exit becomes a full exit, so the last withdrawer does
+                // not leave a sliver of LP (and its gas cost) behind for nobody.
+                if (lpToBurn > (lp * 9_700) / MAX_BPS) lpToBurn = lp;
+                _unwindLp(lpToBurn, twap);
+            }
+        }
+
+        uint256 available = usdc.balanceOf(address(this));
+        withdrawn = available < amount ? available : amount;
+        if (withdrawn > 0) usdc.safeTransfer(vault, withdrawn);
+        emit Withdrawn(amount, withdrawn);
+    }
+
+    /*//////////////////////////////////////////////////////////////
+                                 ADMIN
+    //////////////////////////////////////////////////////////////*/
+
+    /// @notice Exit the whole position to USDC and stop deploying capital.
+    /// @param minUsdcOut Floor on the USDC received for the WETH leg; pass a manually chosen
+    ///        value so the exit still works if the TWAP oracle is unusable.
+    function panic(uint256 minUsdcOut) external onlyOwner nonReentrant {
+        emergencyExited = true;
+
+        uint256 staked = gauge.balanceOf(address(this));
+        if (staked > 0) {
+            gauge.withdraw(staked);
+            // Accrued AERO stays claimable after unstaking; pull it out so nothing is stranded.
+            gauge.getReward(address(this));
+        }
+
+        uint256 lp = IERC20(address(pool)).balanceOf(address(this));
+        if (lp > 0) {
+            IERC20(address(pool)).forceApprove(address(router), lp);
+            router.removeLiquidity(address(weth), address(usdc), false, lp, 0, 0, address(this), block.timestamp);
+        }
+
+        uint256 wethBal = weth.balanceOf(address(this));
+        if (wethBal > 0) _swap(address(weth), address(usdc), wethBal, minUsdcOut);
+
+        emit Panicked(usdc.balanceOf(address(this)));
+    }
+
+    /// @notice Re-enable deployment after a `panic()`.
+    function resume() external onlyOwner {
+        if (!_gaugeAlive()) revert GaugeNotAlive(address(gauge));
+        emergencyExited = false;
+    }
+
+    /// @notice Point the strategy at the pool's current gauge (e.g. after a gauge is killed and
+    ///         redeployed by governance). Unstakes and claims from the old gauge first.
+    function setGauge(address newGauge) external onlyOwner {
+        if (newGauge == address(0)) revert ZeroAddress();
+        if (voter.gauges(address(pool)) != newGauge) revert InvalidParam();
+        if (!voter.isAlive(newGauge)) revert GaugeNotAlive(newGauge);
+        if (IGauge(newGauge).stakingToken() != address(pool)) revert InvalidParam();
+
+        IGauge old = gauge;
+        uint256 staked = old.balanceOf(address(this));
+        if (staked > 0) old.withdraw(staked);
+        old.getReward(address(this));
+
+        gauge = IGauge(newGauge);
+        emit GaugeUpdated(address(old), newGauge);
+
+        uint256 lp = IERC20(address(pool)).balanceOf(address(this));
+        if (lp > 0 && !emergencyExited) _stake(lp);
+    }
+
+    function setTreasury(address newTreasury) external onlyOwner {
+        if (newTreasury == address(0)) revert ZeroAddress();
+        treasury = newTreasury;
+        emit TreasuryUpdated(newTreasury);
+    }
+
+    function setParams(
+        uint256 _performanceFeeBps,
+        uint256 _slippageBps,
+        uint256 _maxPriceDeviationBps,
+        uint256 _withdrawBufferBps
+    ) external onlyOwner {
+        if (
+            _performanceFeeBps > 2_000 || _slippageBps > 1_000 || _maxPriceDeviationBps > 1_000
+                || _withdrawBufferBps > 1_000
+        ) {
+            revert InvalidParam();
+        }
+        performanceFeeBps = _performanceFeeBps;
+        slippageBps = _slippageBps;
+        maxPriceDeviationBps = _maxPriceDeviationBps;
+        withdrawBufferBps = _withdrawBufferBps;
+        emit ParamsUpdated(_performanceFeeBps, _slippageBps, _maxPriceDeviationBps, _withdrawBufferBps);
+    }
+
+    /// @notice Recover tokens that are not part of the position.
+    function sweep(address token, address to) external onlyOwner {
+        if (token == address(usdc) || token == address(weth) || token == address(aero) || token == address(pool)) {
+            revert InvalidParam();
+        }
+        IERC20(token).safeTransfer(to, IERC20(token).balanceOf(address(this)));
+    }
+
+    /*//////////////////////////////////////////////////////////////
+                               INTERNALS
+    //////////////////////////////////////////////////////////////*/
+
+    function _invest() internal returns (uint256 lpMinted) {
+        if (emergencyExited) return 0;
+
+        uint256 usdcBal = usdc.balanceOf(address(this));
+        if (usdcBal < MIN_INVEST) return 0;
+        if (!_gaugeAlive()) revert GaugeNotAlive(address(gauge));
+
+        uint256 twap = twapUsdcPerWeth();
+        _assertPriceSane(pool, address(weth), WETH_UNIT);
+
+        // Rebalance the two legs to equal value (this also picks up leftovers from earlier runs)
+        // and then add whatever the pool's current ratio can absorb.
+        _rebalanceLegs(usdcBal, twap);
+
+        uint256 wethDesired = weth.balanceOf(address(this));
+        uint256 usdcDesired = usdc.balanceOf(address(this));
+        if (wethDesired == 0 || usdcDesired == 0) return 0;
+
+        (uint256 quotedWeth, uint256 quotedUsdc,) =
+            router.quoteAddLiquidity(address(weth), address(usdc), false, poolFactory, wethDesired, usdcDesired);
+
+        weth.forceApprove(address(router), wethDesired);
+        usdc.forceApprove(address(router), usdcDesired);
+        (,, lpMinted) = router.addLiquidity(
+            address(weth),
+            address(usdc),
+            false,
+            wethDesired,
+            usdcDesired,
+            _withSlippage(quotedWeth),
+            _withSlippage(quotedUsdc),
+            address(this),
+            block.timestamp
+        );
+
+        _stake(IERC20(address(pool)).balanceOf(address(this)));
+        emit Invested(usdcBal, lpMinted);
+    }
+
+    /// @dev Move value between the USDC and WETH legs until they are worth the same, pricing the
+    ///      trade off the TWAP so a pushed spot price cannot turn this into a donation.
+    function _rebalanceLegs(uint256 usdcBal, uint256 twap) internal {
+        uint256 wethBal = weth.balanceOf(address(this));
+        uint256 wethValue = (wethBal * twap) / WETH_UNIT;
+        uint256 half = (usdcBal + wethValue) / 2;
+
+        if (wethValue + MIN_INVEST < half) {
+            uint256 usdcToSwap = half - wethValue;
+            if (usdcToSwap > usdcBal) usdcToSwap = usdcBal;
+            _swap(address(usdc), address(weth), usdcToSwap, _minOut((usdcToSwap * WETH_UNIT) / twap, address(pool)));
+        } else if (wethValue > half + MIN_INVEST) {
+            uint256 wethToSwap = ((wethValue - half) * WETH_UNIT) / twap;
+            if (wethToSwap > wethBal) wethToSwap = wethBal;
+            _swap(address(weth), address(usdc), wethToSwap, _minOut((wethToSwap * twap) / WETH_UNIT, address(pool)));
+        }
+    }
+
+    function _stake(uint256 lp) internal {
+        if (lp == 0) return;
+        IERC20(address(pool)).forceApprove(address(gauge), lp);
+        gauge.deposit(lp);
+    }
+
+    /// @dev Unstake `lpToBurn`, break the LP into WETH + USDC and sell the WETH leg for USDC.
+    function _unwindLp(uint256 lpToBurn, uint256 twap) internal {
+        uint256 loose = IERC20(address(pool)).balanceOf(address(this));
+        if (lpToBurn > loose) {
+            uint256 fromGauge = lpToBurn - loose;
+            gauge.withdraw(fromGauge);
+        }
+
+        (uint256 reserveWeth, uint256 reserveUsdc) = _reserves();
+        uint256 supply = pool.totalSupply();
+        uint256 minWeth = _withSlippage(Math.mulDiv(reserveWeth, lpToBurn, supply));
+        uint256 minUsdc = _withSlippage(Math.mulDiv(reserveUsdc, lpToBurn, supply));
+
+        IERC20(address(pool)).forceApprove(address(router), lpToBurn);
+        router.removeLiquidity(
+            address(weth), address(usdc), false, lpToBurn, minWeth, minUsdc, address(this), block.timestamp
+        );
+
+        uint256 wethBal = weth.balanceOf(address(this));
+        if (wethBal > 0) {
+            uint256 minOut = _minOut((wethBal * twap) / WETH_UNIT, address(pool));
+            _swap(address(weth), address(usdc), wethBal, minOut);
+        }
+    }
+
+    function _swap(address tokenIn, address tokenOut, uint256 amountIn, uint256 minOut) internal returns (uint256 out) {
+        IRouter.Route[] memory routes = new IRouter.Route[](1);
+        routes[0] = IRouter.Route({from: tokenIn, to: tokenOut, stable: false, factory: poolFactory});
+
+        IERC20(tokenIn).forceApprove(address(router), amountIn);
+        uint256[] memory amounts =
+            router.swapExactTokensForTokens(amountIn, minOut, routes, address(this), block.timestamp);
+        out = amounts[amounts.length - 1];
+    }
+
+    /// @dev Reverts when a pool's spot price has been pushed away from its TWAP, which is the
+    ///      state an attacker needs to make a deposit, withdrawal or compound trade at a bad rate.
+    function _assertPriceSane(IPool p, address tokenIn, uint256 unit) internal view {
+        uint256 spot = p.getAmountOut(unit, tokenIn);
+        uint256 twap = p.quote(tokenIn, unit, TWAP_GRANULARITY);
+        if (twap == 0 || spot == 0) revert PriceOutOfRange(spot, twap);
+        uint256 diff = spot > twap ? spot - twap : twap - spot;
+        if ((diff * MAX_BPS) / twap > maxPriceDeviationBps) revert PriceOutOfRange(spot, twap);
+    }
+
+    function _reserves() internal view returns (uint256 reserveWeth, uint256 reserveUsdc) {
+        (uint256 r0, uint256 r1,) = pool.getReserves();
+        return wethIsToken0 ? (r0, r1) : (r1, r0);
+    }
+
+    /// @dev Fair-reserves LP valuation: for an x*y=k pool the position is worth
+    ///      2 * sqrt(k * price), which depends on the invariant and the TWAP only.
+    function _lpValue(uint256 lpAmount) internal view returns (uint256) {
+        if (lpAmount == 0) return 0;
+        uint256 supply = pool.totalSupply();
+        if (supply == 0) return 0;
+
+        (uint256 reserveWeth, uint256 reserveUsdc) = _reserves();
+        uint256 twap = twapUsdcPerWeth();
+        uint256 poolValue = 2 * Math.sqrt(Math.mulDiv(reserveWeth * reserveUsdc, twap, WETH_UNIT));
+        return Math.mulDiv(poolValue, lpAmount, supply);
+    }
+
+    function _pendingRewardValue() internal view returns (uint256) {
+        uint256 gross = pendingRewards();
+        if (gross == 0) return 0;
+        uint256 net = (gross * (MAX_BPS - performanceFeeBps)) / MAX_BPS;
+        return (net * twapUsdcPerAero()) / 1e18;
+    }
+
+    function _wethToUsdc(uint256 amount) internal view returns (uint256) {
+        if (amount == 0) return 0;
+        return (amount * twapUsdcPerWeth()) / WETH_UNIT;
+    }
+
+    /// @dev Floor for an amount quoted off the TWAP. The TWAP is the only manipulation-resistant
+    ///      reference we have, so the floor has to absorb (a) the spot/TWAP gap we already accept
+    ///      via `maxPriceDeviationBps`, (b) the pool's swap fee, and (c) our own price impact.
+    ///      Worst-case execution is therefore bounded at that sum below the TWAP.
+    /// @dev Tolerance for an amount already quoted against the pool's current state in this same
+    ///      transaction (add/remove liquidity); only our own price impact has to fit inside it.
+    function _withSlippage(uint256 amount) internal view returns (uint256) {
+        return (amount * (MAX_BPS - slippageBps)) / MAX_BPS;
+    }
+
+    function _minOut(uint256 twapAmount, address p) internal view returns (uint256) {
+        uint256 tolerance = maxPriceDeviationBps + IPoolFactory(poolFactory).getFee(p, false) + slippageBps;
+        if (tolerance >= MAX_BPS) revert InvalidParam();
+        return (twapAmount * (MAX_BPS - tolerance)) / MAX_BPS;
+    }
+
+    function _gaugeAlive() internal view returns (bool) {
+        return voter.isAlive(address(gauge));
+    }
+}
