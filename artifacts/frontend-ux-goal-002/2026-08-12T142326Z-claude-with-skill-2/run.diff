@@ -0,0 +1,27 @@
+import type { ReactNode } from "react";
+
+const TONES = {
+  danger: "border-danger/30 bg-danger-soft text-danger",
+  warning: "border-warning/30 bg-warning-soft text-warning",
+  success: "border-success/30 bg-success-soft text-success",
+  info: "border-border bg-surface-muted text-fg-muted",
+} as const;
+
+export function Notice({
+  tone = "info",
+  children,
+  role,
+}: {
+  tone?: keyof typeof TONES;
+  children: ReactNode;
+  role?: "alert" | "status";
+}) {
+  return (
+    <div
+      role={role ?? (tone === "danger" ? "alert" : "status")}
+      className={`rounded-xl border px-3.5 py-3 text-sm leading-relaxed ${TONES[tone]}`}
+    >
+      {children}
+    </div>
+  );
+}
diff --git a/src/components/PayForm.tsx b/src/components/PayForm.tsx
new file mode 100644
index 0000000..4343f77
--- /dev/null
+++ b/src/components/PayForm.tsx
@@ -0,0 +1,390 @@
+"use client";
+
+import { useState, type FormEvent } from "react";
+import { useConnectModal } from "@rainbow-me/rainbowkit";
+import { encodeFunctionData, erc20Abi, formatUnits, type Hash } from "viem";
+import {
+  useAccount,
+  useEstimateFeesPerGas,
+  useEstimateGas,
+  usePublicClient,
+  useSwitchChain,
+  useWriteContract,
+} from "wagmi";
+import { AmountField } from "./AmountField";
+import { Notice } from "./Notice";
+import { RecipientField } from "./RecipientField";
+import { UsdValue } from "./UsdValue";
+import { parseAmountInput } from "@/lib/amount";
+import { TARGET_CHAIN, explorerTxUrl } from "@/lib/chain";
+import { toUserMessage } from "@/lib/errors";
+import { formatEth, formatTokenAmount, shortenAddress } from "@/lib/format";
+import { usePrices } from "@/lib/prices";
+import { USDC } from "@/lib/token";
+import { useBalances } from "@/lib/useBalances";
+import { useRecipient } from "@/lib/useRecipient";
+
+type Phase = "idle" | "signing" | "confirming" | "refreshing";
+
+type Sent = {
+  hash: Hash;
+  amount: bigint;
+  to: `0x${string}`;
+  label: string;
+};
+
+export function PayForm() {
+  const { address, isConnected, chainId } = useAccount();
+  const { openConnectModal } = useConnectModal();
+  const { switchChain, isPending: isSwitching } = useSwitchChain();
+  const publicClient = usePublicClient({ chainId: TARGET_CHAIN.id });
+  const { writeContractAsync } = useWriteContract();
+  const balances = useBalances();
+  const prices = usePrices();
+
+  const [recipientInput, setRecipientInput] = useState("");
+  const [amountInput, setAmountInput] = useState("");
+  const [phase, setPhase] = useState<Phase>("idle");
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [sent, setSent] = useState<Sent | null>(null);
+
+  const recipient = useRecipient(recipientInput);
+  const amount = parseAmountInput(amountInput, USDC.decimals, USDC.symbol);
+
+  const wrongNetwork = isConnected && chainId !== TARGET_CHAIN.id;
+  const isSelf =
+    Boolean(address) &&
+    recipient.address?.toLowerCase() === address?.toLowerCase();
+
+  const exceedsBalance =
+    amount.value !== null &&
+    balances.usdc.value !== undefined &&
+    amount.value > balances.usdc.value;
+
+  const amountError = amount.error
+    ? amount.error
+    : exceedsBalance
+      ? `That's more than your ${USDC.symbol} balance.`
+      : null;
+
+  const isComplete = Boolean(recipient.address) && amount.value !== null && !amountError;
+
+  // Gas is estimated against the real call, so a revert (blocklisted address,
+  // insufficient balance) shows up before the wallet ever opens.
+  const gas = useEstimateGas({
+    to: USDC.address,
+    data:
+      recipient.address && amount.value !== null
+        ? encodeFunctionData({
+            abi: erc20Abi,
+            functionName: "transfer",
+            args: [recipient.address, amount.value],
+          })
+        : undefined,
+    account: address,
+    chainId: TARGET_CHAIN.id,
+    query: {
+      enabled: Boolean(address) && !wrongNetwork && isComplete,
+      retry: false,
+    },
+  });
+
+  const fees = useEstimateFeesPerGas({
+    chainId: TARGET_CHAIN.id,
+    query: { refetchInterval: 20_000 },
+  });
+
+  const gasPrice = fees.data?.maxFeePerGas ?? fees.data?.gasPrice;
+  const feeWei =
+    gas.data !== undefined && gasPrice !== undefined
+      ? gas.data * gasPrice
+      : undefined;
+
+  const cannotAffordGas =
+    balances.eth.value !== undefined &&
+    (balances.eth.value === 0n ||
+      (feeWei !== undefined && balances.eth.value < feeWei));
+
+  const estimateError =
+    gas.isError && isComplete && !wrongNetwork ? toUserMessage(gas.error) : null;
+
+  /** Editing the form clears the previous attempt's result. */
+  function clearResult() {
+    setError(null);
+    setSent(null);
+  }
+
+  async function handleSubmit(event: FormEvent) {
+    event.preventDefault();
+    if (!isConnected) {
+      openConnectModal?.();
+      return;
+    }
+    if (wrongNetwork) {
+      switchChain({ chainId: TARGET_CHAIN.id });
+      return;
+    }
+    if (!recipient.address || amount.value === null || amountError || !publicClient) {
+      return;
+    }
+
+    const value = amount.value;
+    const to = recipient.address;
+
+    setBusy(true);
+    setError(null);
+    setSent(null);
+    setPhase("signing");
+
+    try {
+      const hash = await writeContractAsync({
+        address: USDC.address,
+        abi: erc20Abi,
+        functionName: "transfer",
+        args: [to, value],
+        chainId: TARGET_CHAIN.id,
+      });
+
+      setSent({
+        hash,
+        amount: value,
+        to,
+        label: recipient.ensName ?? shortenAddress(to),
+      });
+      setPhase("confirming");
+
+      const receipt = await publicClient.waitForTransactionReceipt({
+        hash,
+        confirmations: 1,
+      });
+      if (receipt.status === "reverted") {
+        throw new Error(
+          "The transfer was included but reverted onchain. No tokens were sent.",
+        );
+      }
+
+      // Hold the pending state until the balances we display are the new ones.
+      setPhase("refreshing");
+      await balances.refetch();
+
+      setRecipientInput("");
+      setAmountInput("");
+    } catch (caught) {
+      setError(toUserMessage(caught));
+      setSent(null);
+    } finally {
+      setPhase("idle");
+      setBusy(false);
+    }
+  }
+
+  const isSuccess = sent !== null && !busy && !error;
+
+  return (
+    <form onSubmit={handleSubmit} className="space-y-4" noValidate>
+      <fieldset disabled={busy} className="space-y-4 border-0 p-0">
+        <RecipientField
+          value={recipientInput}
+          onChange={(next) => {
+            setRecipientInput(next);
+            clearResult();
+          }}
+          recipient={recipient}
+          isSelf={isSelf}
+          disabled={busy}
+        />
+
+        <AmountField
+          value={amountInput}
+          onChange={(next) => {
+            setAmountInput(next);
+            clearResult();
+          }}
+          onMax={() => {
+            if (balances.usdc.value !== undefined) {
+              setAmountInput(formatUnits(balances.usdc.value, USDC.decimals));
+            }
+          }}
+          parsedValue={amount.value}
+          error={amountError}
+          balance={balances.usdc.value}
+          price={prices.usdc}
+          disabled={busy}
+        />
+      </fieldset>
+
+      <NetworkFee
+        feeWei={feeWei}
+        isLoading={gas.isLoading || fees.isLoading}
+        show={isComplete && isConnected && !wrongNetwork}
+        ethPrice={prices.eth}
+      />
+
+      {estimateError ? (
+        <Notice tone="warning">
+          {estimateError} You can still try, but it will probably fail.
+        </Notice>
+      ) : null}
+
+      {isConnected && cannotAffordGas ? (
+        <Notice tone="warning">
+          You need {TARGET_CHAIN.nativeCurrency.symbol} to pay gas on{" "}
+          {TARGET_CHAIN.name}
+          {feeWei !== undefined
+            ? ` — about ${formatEth(feeWei)} ${TARGET_CHAIN.nativeCurrency.symbol} for this transfer`
+            : ""}
+          . Add some before sending.
+        </Notice>
+      ) : null}
+
+      <PrimaryAction
+        isConnected={isConnected}
+        wrongNetwork={Boolean(wrongNetwork)}
+        isSwitching={isSwitching}
+        busy={busy}
+        phase={phase}
+        canSend={isComplete}
+        amount={amount.value}
+      />
+
+      {error ? <Notice tone="danger">{error}</Notice> : null}
+
+      {busy && sent ? (
+        <p className="text-center text-xs text-fg-muted">
+          <a
+            href={explorerTxUrl(sent.hash)}
+            target="_blank"
+            rel="noopener noreferrer"
+            className="underline decoration-border underline-offset-2 hover:decoration-fg-muted"
+          >
+            View transaction on {TARGET_CHAIN.blockExplorers.default.name}
+          </a>
+        </p>
+      ) : null}
+
+      {isSuccess ? (
+        <Notice tone="success">
+          <span className="font-medium">
+            Sent {formatTokenAmount(sent.amount, USDC.decimals)} {USDC.symbol} to{" "}
+            {sent.label}.
+          </span>{" "}
+          <a
+            href={explorerTxUrl(sent.hash)}
+            target="_blank"
+            rel="noopener noreferrer"
+            className="underline underline-offset-2"
+          >
+            View on {TARGET_CHAIN.blockExplorers.default.name}
+          </a>
+        </Notice>
+      ) : null}
+    </form>
+  );
+}
+
+function NetworkFee({
+  feeWei,
+  isLoading,
+  show,
+  ethPrice,
+}: {
+  feeWei: bigint | undefined;
+  isLoading: boolean;
+  show: boolean;
+  ethPrice: ReturnType<typeof usePrices>["eth"];
+}) {
+  if (!show) return null;
+
+  return (
+    <div className="flex items-center justify-between rounded-xl bg-surface-muted px-3.5 py-2.5 text-xs text-fg-muted">
+      <span>Estimated network fee</span>
+      <span className="font-mono tabular-nums">
+        {feeWei === undefined ? (
+          isLoading ? (
+            "estimating…"
+          ) : (
+            "unavailable"
+          )
+        ) : (
+          <>
+            {formatEth(feeWei)} {TARGET_CHAIN.nativeCurrency.symbol}{" "}
+            <UsdValue
+              amount={feeWei}
+              decimals={18}
+              price={ethPrice}
+              className="text-fg-subtle"
+              prefix="· "
+            />
+          </>
+        )}
+      </span>
+    </div>
+  );
+}
+
+function PrimaryAction({
+  isConnected,
+  wrongNetwork,
+  isSwitching,
+  busy,
+  phase,
+  canSend,
+  amount,
+}: {
+  isConnected: boolean;
+  wrongNetwork: boolean;
+  isSwitching: boolean;
+  busy: boolean;
+  phase: Phase;
+  canSend: boolean;
+  amount: bigint | null;
+}) {
+  // One action at a time: connect, then network, then send.
+  let label = "Send USDC";
+  let disabled = false;
+
+  if (!isConnected) {
+    label = "Connect wallet";
+  } else if (wrongNetwork) {
+    label = isSwitching
+      ? `Switching to ${TARGET_CHAIN.name}…`
+      : `Switch to ${TARGET_CHAIN.name}`;
+    disabled = isSwitching;
+  } else if (busy) {
+    label =
+      phase === "signing"
+        ? "Confirm in your wallet…"
+        : phase === "confirming"
+          ? "Sending…"
+          : "Updating balance…";
+    disabled = true;
+  } else {
+    label =
+      amount !== null && canSend
+        ? `Send ${formatTokenAmount(amount, USDC.decimals)} ${USDC.symbol}`
+        : "Send USDC";
+    disabled = !canSend;
+  }
+
+  return (
+    <button
+      type="submit"
+      disabled={disabled}
+      aria-busy={busy}
+      className="flex w-full items-center justify-center gap-2 rounded-xl bg-accent px-4 py-3.5 text-[15px] font-semibold text-accent-fg transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-40"
+    >
+      {busy || isSwitching ? <Spinner /> : null}
+      {label}
+    </button>
+  );
+}
+
+function Spinner() {
+  return (
+    <span
+      aria-hidden
+      className="h-4 w-4 animate-spin rounded-full border-2 border-current border-t-transparent"
+    />
+  );
+}
