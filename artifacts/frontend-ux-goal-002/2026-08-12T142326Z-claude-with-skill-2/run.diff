+@import "tailwindcss";
+
+/* Semantic tokens: one set of names, two colour schemes. */
+:root {
+  --bg: #f7f8fa;
+  --surface: #ffffff;
+  --surface-muted: #f1f3f7;
+  --border: #e2e5ec;
+  --fg: #10131a;
+  --fg-muted: #5c6474;
+  --fg-subtle: #8a92a3;
+  --accent: #2563eb;
+  --accent-fg: #ffffff;
+  --accent-soft: #e8efff;
+  --danger: #c02626;
+  --danger-soft: #fdecec;
+  --success: #0f7b4f;
+  --success-soft: #e6f6ee;
+  --warning: #8a5a00;
+  --warning-soft: #fdf3e0;
+}
+
+@media (prefers-color-scheme: dark) {
+  :root {
+    --bg: #0b0d12;
+    --surface: #14171f;
+    --surface-muted: #1b1f29;
+    --border: #262c38;
+    --fg: #f2f4f8;
+    --fg-muted: #a2abbc;
+    --fg-subtle: #6f7889;
+    --accent: #6b9dff;
+    --accent-fg: #08111f;
+    --accent-soft: #17233c;
+    --danger: #ff8484;
+    --danger-soft: #2c1618;
+    --success: #55d6a0;
+    --success-soft: #10241d;
+    --warning: #e8b45c;
+    --warning-soft: #2a2113;
+  }
+}
+
+@theme inline {
+  --color-bg: var(--bg);
+  --color-surface: var(--surface);
+  --color-surface-muted: var(--surface-muted);
+  --color-border: var(--border);
+  --color-fg: var(--fg);
+  --color-fg-muted: var(--fg-muted);
+  --color-fg-subtle: var(--fg-subtle);
+  --color-accent: var(--accent);
+  --color-accent-fg: var(--accent-fg);
+  --color-accent-soft: var(--accent-soft);
+  --color-danger: var(--danger);
+  --color-danger-soft: var(--danger-soft);
+  --color-success: var(--success);
+  --color-success-soft: var(--success-soft);
+  --color-warning: var(--warning);
+  --color-warning-soft: var(--warning-soft);
+  --font-sans: var(--font-geist-sans);
+  --font-mono: var(--font-geist-mono);
+}
+
+body {
+  background: var(--bg);
+  color: var(--fg);
+}
+
+/* Number inputs: no spinners, they fight with decimal amounts. */
+input[type="number"]::-webkit-inner-spin-button,
+input[type="number"]::-webkit-outer-spin-button {
+  appearance: none;
+  margin: 0;
+}
