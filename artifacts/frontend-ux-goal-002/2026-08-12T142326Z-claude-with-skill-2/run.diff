+"use client";
+
+import { useAccount } from "wagmi";
+import { TARGET_CHAIN } from "@/lib/chain";
+import { formatEth, formatTokenAmount } from "@/lib/format";
+import { usePrices } from "@/lib/prices";
+import { USDC } from "@/lib/token";
+import { useBalances } from "@/lib/useBalances";
+import { UsdValue } from "./UsdValue";
+
+export function BalancePanel() {
+  const { isConnected } = useAccount();
+  const { usdc, eth } = useBalances();
+  const prices = usePrices();
+
+  return (
+    <section
+      aria-label="Your balances"
+      className="grid grid-cols-2 gap-3 sm:gap-4"
+    >
+      <BalanceTile
+        label={`${USDC.symbol} balance`}
+        sublabel="Available to send"
+        amount={
+          usdc.value !== undefined
+            ? formatTokenAmount(usdc.value, USDC.decimals)
+            : undefined
+        }
+        unit={USDC.symbol}
+        usd={
+          <UsdValue
+            amount={usdc.value}
+            decimals={USDC.decimals}
+            price={prices.usdc}
+          />
+        }
+        isConnected={isConnected}
+        isLoading={usdc.isLoading}
+        isError={usdc.isError}
+      />
+      <BalanceTile
+        label="ETH balance"
+        sublabel="Pays for gas"
+        amount={eth.value !== undefined ? formatEth(eth.value) : undefined}
+        unit={TARGET_CHAIN.nativeCurrency.symbol}
+        usd={<UsdValue amount={eth.value} decimals={18} price={prices.eth} />}
+        isConnected={isConnected}
+        isLoading={eth.isLoading}
+        isError={eth.isError}
+      />
+    </section>
+  );
+}
+
+function BalanceTile({
+  label,
+  sublabel,
+  amount,
+  unit,
+  usd,
+  isConnected,
+  isLoading,
+  isError,
+}: {
+  label: string;
+  sublabel: string;
+  amount: string | undefined;
+  unit: string;
+  usd: React.ReactNode;
+  isConnected: boolean;
+  isLoading: boolean;
+  isError: boolean;
+}) {
+  return (
+    <div className="rounded-2xl border border-border bg-surface p-4">
+      <div className="flex items-baseline justify-between gap-2">
+        <span className="text-xs font-medium text-fg-muted">{label}</span>
+        <span className="text-[11px] text-fg-subtle">{sublabel}</span>
+      </div>
+
+      <div className="mt-2.5 min-h-[52px]">
+        {!isConnected ? (
+          <p className="text-[15px] text-fg-subtle">Connect to view</p>
+        ) : isError ? (
+          <p className="text-[15px] text-danger">Couldn&apos;t load</p>
+        ) : isLoading || amount === undefined ? (
+          <div
+            aria-hidden
+            className="h-6 w-24 animate-pulse rounded-md bg-surface-muted"
+          />
+        ) : (
+          <>
+            <p className="font-mono text-xl font-semibold tracking-tight tabular-nums">
+              {amount}{" "}
+              <span className="text-sm font-normal text-fg-muted">{unit}</span>
+            </p>
+            <p className="mt-0.5 text-xs text-fg-muted">{usd}</p>
+          </>
+        )}
+      </div>
+    </div>
+  );
+}
