+"use client";
+
+import { formatTokenAmount } from "@/lib/format";
+import type { Price } from "@/lib/prices";
+import { USDC } from "@/lib/token";
+import { UsdValue } from "./UsdValue";
+
+export function AmountField({
+  value,
+  onChange,
+  onMax,
+  parsedValue,
+  error,
+  balance,
+  price,
+  disabled,
+}: {
+  value: string;
+  onChange: (value: string) => void;
+  onMax: () => void;
+  parsedValue: bigint | null;
+  error: string | null;
+  balance: bigint | undefined;
+  price: Price;
+  disabled?: boolean;
+}) {
+  const describedBy = "amount-status";
+
+  return (
+    <div>
+      <div className="flex items-baseline justify-between gap-2">
+        <label htmlFor="amount" className="text-sm font-medium text-fg-muted">
+          Amount
+        </label>
+        {balance !== undefined ? (
+          <button
+            type="button"
+            onClick={onMax}
+            disabled={disabled || balance === 0n}
+            className="rounded-md px-1.5 py-0.5 text-xs font-medium text-accent hover:bg-accent-soft disabled:cursor-not-allowed disabled:text-fg-subtle disabled:hover:bg-transparent"
+          >
+            Max {formatTokenAmount(balance, USDC.decimals)}
+          </button>
+        ) : null}
+      </div>
+
+      <div
+        className={`mt-1.5 flex items-center gap-2 rounded-xl border bg-surface px-3.5 py-3 transition-colors focus-within:ring-2 focus-within:ring-accent/40 ${
+          error ? "border-danger/50" : "border-border"
+        }`}
+      >
+        <input
+          id="amount"
+          name="amount"
+          value={value}
+          onChange={(event) => onChange(event.target.value)}
+          disabled={disabled}
+          inputMode="decimal"
+          autoComplete="off"
+          placeholder="0.00"
+          aria-invalid={Boolean(error)}
+          aria-describedby={describedBy}
+          className="w-full bg-transparent font-mono text-xl tabular-nums outline-none placeholder:text-fg-subtle disabled:opacity-60"
+        />
+        <span className="shrink-0 rounded-lg bg-surface-muted px-2.5 py-1 text-sm font-medium text-fg-muted">
+          {USDC.symbol}
+        </span>
+      </div>
+
+      <p id={describedBy} className="mt-1.5 min-h-[18px] text-xs">
+        {error ? (
+          <span className="text-danger">{error}</span>
+        ) : parsedValue !== null ? (
+          <UsdValue
+            amount={parsedValue}
+            decimals={USDC.decimals}
+            price={price}
+            className="text-fg-muted"
+            prefix="≈ "
+          />
+        ) : (
+          <span className="text-fg-subtle">
+            Sent as {USDC.name} on Ethereum.
+          </span>
+        )}
+      </p>
+    </div>
+  );
+}
