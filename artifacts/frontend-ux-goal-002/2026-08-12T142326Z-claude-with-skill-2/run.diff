+++ b/next.config.ts
@@ -0,0 +1,30 @@
+import path from "node:path";
+import type { NextConfig } from "next";
+
+/**
+ * RainbowKit's Base Account connector statically pulls in @coinbase/cdp-sdk,
+ * which lazily imports the optional @x402/* packages. Payline never touches
+ * that code path, so the specifiers are aliased to an empty module instead of
+ * installing four unused packages.
+ */
+const unused = "./src/lib/unused-module.ts";
+
+const x402Stubs = [
+  "@x402/core/client",
+  "@x402/evm",
+  "@x402/evm/exact/client",
+  "@x402/evm/upto/client",
+  "@x402/svm/exact/client",
+].reduce<Record<string, string>>((aliases, specifier) => {
+  aliases[specifier] = unused;
+  return aliases;
+}, {});
+
+const nextConfig: NextConfig = {
+  turbopack: {
+    root: __dirname,
+    resolveAlias: x402Stubs,
+  },
+};
+
+export default nextConfig;
