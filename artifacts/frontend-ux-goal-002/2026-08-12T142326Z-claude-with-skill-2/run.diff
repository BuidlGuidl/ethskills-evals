@@ -0,0 +1,43 @@
+"use client";
+
+import { useState, type ReactNode } from "react";
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { WagmiProvider } from "wagmi";
+import {
+  RainbowKitProvider,
+  darkTheme,
+  lightTheme,
+} from "@rainbow-me/rainbowkit";
+import "@rainbow-me/rainbowkit/styles.css";
+import { APP } from "@/lib/app";
+import { wagmiConfig } from "@/lib/wagmi";
+
+const accent = "#2563eb";
+
+export function Providers({ children }: { children: ReactNode }) {
+  const [queryClient] = useState(
+    () =>
+      new QueryClient({
+        defaultOptions: {
+          queries: { retry: 2, refetchOnWindowFocus: true },
+        },
+      }),
+  );
+
+  return (
+    <WagmiProvider config={wagmiConfig}>
+      <QueryClientProvider client={queryClient}>
+        <RainbowKitProvider
+          appInfo={{ appName: APP.name }}
+          // Follows the OS colour scheme, same as the rest of the app.
+          theme={{
+            lightMode: lightTheme({ accentColor: accent, borderRadius: "medium" }),
+            darkMode: darkTheme({ accentColor: accent, borderRadius: "medium" }),
+          }}
+        >
+          {children}
+        </RainbowKitProvider>
+      </QueryClientProvider>
+    </WagmiProvider>
+  );
+}
diff --git a/src/components/RecipientField.tsx b/src/components/RecipientField.tsx
new file mode 100644
index 0000000..bcab383
--- /dev/null
+++ b/src/components/RecipientField.tsx
@@ -0,0 +1,113 @@
+"use client";
+
+/* eslint-disable @next/next/no-img-element -- ENS avatars are arbitrary remote URLs, not app assets. */
+
+import { explorerAddressUrl } from "@/lib/chain";
+import { shortenAddress } from "@/lib/format";
+import type { Recipient } from "@/lib/useRecipient";
+
+export function RecipientField({
+  value,
+  onChange,
+  recipient,
+  disabled,
+  isSelf,
+}: {
+  value: string;
+  onChange: (value: string) => void;
+  recipient: Recipient;
+  disabled?: boolean;
+  isSelf: boolean;
+}) {
+  const hasError = Boolean(recipient.error);
+  const describedBy = "recipient-status";
+
+  return (
+    <div>
+      <label
+        htmlFor="recipient"
+        className="block text-sm font-medium text-fg-muted"
+      >
+        Recipient
+      </label>
+
+      <div
+        className={`mt-1.5 flex items-center gap-2.5 rounded-xl border bg-surface px-3.5 py-3 transition-colors focus-within:ring-2 focus-within:ring-accent/40 ${
+          hasError ? "border-danger/50" : "border-border"
+        }`}
+      >
+        {recipient.ensAvatar ? (
+          <img
+            src={recipient.ensAvatar}
+            alt=""
+            width={28}
+            height={28}
+            className="h-7 w-7 shrink-0 rounded-full object-cover"
+          />
+        ) : null}
+        <input
+          id="recipient"
+          name="recipient"
+          value={value}
+          onChange={(event) => onChange(event.target.value)}
+          disabled={disabled}
+          placeholder="vitalik.eth or 0x…"
+          autoComplete="off"
+          autoCorrect="off"
+          spellCheck={false}
+          aria-invalid={hasError}
+          aria-describedby={describedBy}
+          className="w-full bg-transparent font-mono text-[15px] outline-none placeholder:font-sans placeholder:text-fg-subtle disabled:opacity-60"
+        />
+      </div>
+
+      <p id={describedBy} className="mt-1.5 min-h-[18px] text-xs leading-snug">
+        <RecipientStatus recipient={recipient} isSelf={isSelf} />
+      </p>
+    </div>
+  );
+}
+
+function RecipientStatus({
+  recipient,
+  isSelf,
+}: {
+  recipient: Recipient;
+  isSelf: boolean;
+}) {
+  if (recipient.error) {
+    return <span className="text-danger">{recipient.error}</span>;
+  }
+
+  if (recipient.status === "resolving") {
+    return <span className="text-fg-subtle">Looking up name…</span>;
+  }
+
+  if (recipient.status === "ok" && recipient.address) {
+    return (
+      <span className="text-fg-muted">
+        {isSelf ? (
+          <span className="text-warning">This is your own wallet. </span>
+        ) : null}
+        Sending to{" "}
+        <a
+          href={explorerAddressUrl(recipient.address)}
+          target="_blank"
+          rel="noopener noreferrer"
+          className="font-mono text-fg underline decoration-border underline-offset-2 hover:decoration-fg-muted"
+          title={recipient.address}
+        >
+          {recipient.ensName
+            ? `${recipient.ensName} (${shortenAddress(recipient.address)})`
+            : recipient.address}
+        </a>
+      </span>
+    );
+  }
+
+  return (
+    <span className="text-fg-subtle">
+      ENS names are resolved on Ethereum before sending.
+    </span>
+  );
+}
diff --git a/src/components/UsdValue.tsx b/src/components/UsdValue.tsx
new file mode 100644
index 0000000..afc1720
--- /dev/null
+++ b/src/components/UsdValue.tsx
@@ -0,0 +1,57 @@
+"use client";
+
+import { formatUsd, relativeTime, toUsd } from "@/lib/format";
+import type { Price } from "@/lib/prices";
+
+/**
+ * Every amount in the app is paired with one of these. A missing or stale
+ * price is said out loud instead of quietly rendering nothing.
+ */
+export function UsdValue({
+  amount,
+  decimals,
+  price,
+  className = "",
+  prefix,
+}: {
+  amount: bigint | undefined;
+  decimals: number;
+  price: Price;
+  className?: string;
+  prefix?: string;
+}) {
+  if (amount === undefined) return null;
+
+  if (price.value === null) {
+    return (
+      <span className={`text-fg-subtle ${className}`} title="Chainlink price feed unavailable">
+        USD value unavailable
+      </span>
+    );
+  }
+
+  const usd = formatUsd(toUsd(amount, decimals, price.value));
+
+  if (price.isStale) {
+    return (
+      <span
+        className={`text-warning ${className}`}
+        title={
+          price.ageSeconds !== null
+            ? `Chainlink price last updated ${relativeTime(price.ageSeconds)}`
+            : undefined
+        }
+      >
+        {prefix}
+        {usd} · stale price
+      </span>
+    );
+  }
+
+  return (
+    <span className={className}>
+      {prefix}
+      {usd}
+    </span>
+  );
+}
