+# Dedicated Ethereum mainnet RPC (Alchemy, Infura, QuickNode, ...).
+# Required in production — without it viem falls back to a shared public node
+# that is rate limited and will drop balance/price reads under real traffic.
+NEXT_PUBLIC_RPC_URL=
+
+# WalletConnect / Reown project id: https://cloud.reown.com
+# Without it only injected browser wallets can connect (no mobile wallets).
+NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
+
+# Canonical origin, used for OG/Twitter card URLs.
+NEXT_PUBLIC_APP_URL=https://payline.cash
