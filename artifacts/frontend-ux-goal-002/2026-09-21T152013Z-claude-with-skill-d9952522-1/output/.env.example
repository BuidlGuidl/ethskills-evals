# Dedicated Ethereum mainnet RPC (Alchemy, Infura, QuickNode, ...). Required for production builds.
NEXT_PUBLIC_MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# WalletConnect / Reown project id: https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=YOUR_PROJECT_ID
# Public origin, used for OG/Twitter metadata URLs
NEXT_PUBLIC_SITE_URL=https://settle.example.com
