# Public URL the app is served from (used for absolute OG/Twitter image URLs)
NEXT_PUBLIC_SITE_URL=https://pay.example.com
# Dedicated Ethereum mainnet RPC (Alchemy, Infura, QuickNode, ...). Required for production builds.
NEXT_PUBLIC_MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-key
# WalletConnect Cloud project id: https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-project-id
