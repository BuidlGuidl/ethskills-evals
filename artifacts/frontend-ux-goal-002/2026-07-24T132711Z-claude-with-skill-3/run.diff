+import type { Metadata } from "next";
+import "./globals.css";
+import { Providers } from "./providers";
+
+const siteUrl =
+  process.env.NEXT_PUBLIC_SITE_URL ?? "https://usdc-pay.example.com";
+
+// Rule 8: real product identity + absolute, reachable social preview image.
+export const metadata: Metadata = {
+  metadataBase: new URL(siteUrl),
+  title: "USDC Pay — Send USDC on Ethereum",
+  description:
+    "Connect your wallet and send USDC to anyone on Ethereum mainnet. See your USDC and ETH balances with live USD context before you pay.",
+  applicationName: "USDC Pay",
+  icons: {
+    icon: "/favicon.svg",
+    apple: "/favicon.svg",
+  },
+  openGraph: {
+    type: "website",
+    url: siteUrl,
+    siteName: "USDC Pay",
+    title: "USDC Pay — Send USDC on Ethereum",
+    description:
+      "Connect your wallet and send USDC to anyone on Ethereum mainnet, with live balances and USD context.",
+    images: [
+      {
+        url: "/og.svg",
+        width: 1200,
+        height: 630,
+        alt: "USDC Pay — Send USDC on Ethereum",
+      },
+    ],
+  },
+  twitter: {
+    card: "summary_large_image",
+    title: "USDC Pay — Send USDC on Ethereum",
+    description:
+      "Connect your wallet and send USDC to anyone on Ethereum mainnet, with live balances and USD context.",
+    images: ["/og.svg"],
+  },
+};
+
+export default function RootLayout({
+  children,
+}: {
+  children: React.ReactNode;
+}) {
+  return (
+    <html lang="en">
+      <body>
+        <Providers>{children}</Providers>
+      </body>
+    </html>
+  );
+}
