@@ -0,0 +1,139 @@
+"use client";
+
+import { useAccount, useBalance, useReadContract } from "wagmi";
+import { formatUnits } from "viem";
+import {
+  USDC_ADDRESS,
+  USDC_DECIMALS,
+  USDC_SYMBOL,
+  USDC_CHAIN_ID,
+  usdcAbi,
+} from "@/lib/usdc";
+import { usePrices } from "@/lib/usePrices";
+import { formatTokenAmount, formatUsd, tokenUsd } from "@/lib/format";
+import styles from "@/app/pay/pay.module.css";
+
+// Below this much ETH we warn the user they may not afford gas.
+const LOW_ETH_THRESHOLD = 0.002;
+
+export function BalanceCard() {
+  const { address } = useAccount();
+  const { ethUsd, usdcUsd } = usePrices();
+
+  const { data: ethBalance } = useBalance({
+    address,
+    chainId: USDC_CHAIN_ID,
+    // Calm, steady polling keeps balances fresh without runaway QPS (Rule 5).
+    query: { enabled: Boolean(address), refetchInterval: 5_000 },
+  });
+
+  const { data: usdcBalance } = useReadContract({
+    address: USDC_ADDRESS,
+    abi: usdcAbi,
+    functionName: "balanceOf",
+    args: address ? [address] : undefined,
+    chainId: USDC_CHAIN_ID,
+    query: { enabled: Boolean(address), refetchInterval: 5_000 },
+  });
+
+  const usdcUsdValue =
+    usdcBalance !== undefined
+      ? tokenUsd(usdcBalance, USDC_DECIMALS, usdcUsd)
+      : null;
+  const ethUsdValue =
+    ethBalance !== undefined
+      ? tokenUsd(ethBalance.value, ethBalance.decimals, ethUsd)
+      : null;
+
+  const ethAmount =
+    ethBalance !== undefined
+      ? Number(formatUnits(ethBalance.value, ethBalance.decimals))
+      : undefined;
+  const lowGas = ethAmount !== undefined && ethAmount < LOW_ETH_THRESHOLD;
+
+  return (
+    <div className={styles.card}>
+      <div className={styles.balances}>
+        <div className={styles.balance}>
+          <div className={styles.balanceLabel}>
+            <UsdcIcon /> {USDC_SYMBOL}
+          </div>
+          <div className={styles.balanceValue}>
+            {usdcBalance !== undefined
+              ? formatTokenAmount(usdcBalance, USDC_DECIMALS, 2)
+              : "—"}
+          </div>
+          <div className={styles.balanceUsd}>
+            {usdcUsdValue !== null ? `~${formatUsd(usdcUsdValue)}` : " "}
+          </div>
+        </div>
+
+        <div className={styles.balance}>
+          <div className={styles.balanceLabel}>
+            <EthIcon /> ETH · gas
+          </div>
+          <div className={styles.balanceValue}>
+            {ethBalance !== undefined
+              ? formatTokenAmount(ethBalance.value, ethBalance.decimals, 4)
+              : "—"}
+          </div>
+          <div className={styles.balanceUsd}>
+            {ethUsdValue !== null ? `~${formatUsd(ethUsdValue)}` : " "}
+          </div>
+        </div>
+      </div>
+
+      {lowGas && (
+        <div className={styles.lowGasHint} role="status">
+          <WarnIcon />
+          Low ETH — you may not have enough to cover gas for this transfer.
+        </div>
+      )}
+    </div>
+  );
+}
+
+function UsdcIcon() {
+  return (
+    <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden>
+      <circle cx="12" cy="12" r="11" fill="#2775ca" />
+      <text
+        x="12"
+        y="16"
+        textAnchor="middle"
+        fontSize="11"
+        fill="#fff"
+        fontFamily="sans-serif"
+        fontWeight="700"
+      >
+        $
+      </text>
+    </svg>
+  );
+}
+
+function EthIcon() {
+  return (
+    <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden>
+      <circle cx="12" cy="12" r="11" fill="#627eea" />
+      <path d="M12 4v6l5 2.2z" fill="#fff" fillOpacity="0.7" />
+      <path d="M12 4 7 12.2 12 10z" fill="#fff" />
+      <path d="M12 15.4v4.6l5-7z" fill="#fff" fillOpacity="0.7" />
+      <path d="M12 20v-4.6L7 13z" fill="#fff" />
+    </svg>
+  );
+}
+
+function WarnIcon() {
+  return (
+    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden>
+      <path
+        d="M12 9v4m0 4h.01M10.3 3.9 2 18a2 2 0 0 0 1.7 3h16.6a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"
+        stroke="currentColor"
+        strokeWidth="2"
+        strokeLinecap="round"
+        strokeLinejoin="round"
+      />
+    </svg>
+  );
+}
diff --git a/components/PayForm.tsx b/components/PayForm.tsx
new file mode 100644
index 0000000..01d0f11
--- /dev/null
+++ b/components/PayForm.tsx
@@ -0,0 +1,401 @@
+"use client";
+
+import { useCallback, useEffect, useMemo, useState } from "react";
+import {
+  useAccount,
+  useReadContract,
+  useSwitchChain,
+  useWaitForTransactionReceipt,
+  useWriteContract,
+} from "wagmi";
+import { useConnectModal } from "@rainbow-me/rainbowkit";
+import { parseUnits, formatUnits, type Address } from "viem";
+import { mainnet } from "wagmi/chains";
+import {
+  USDC_ADDRESS,
+  USDC_DECIMALS,
+  USDC_SYMBOL,
+  USDC_CHAIN_ID,
+  usdcAbi,
+} from "@/lib/usdc";
+import { usePrices } from "@/lib/usePrices";
+import { formatTokenAmount, formatUsd, truncateAddress } from "@/lib/format";
+import { parseTxError } from "@/lib/errors";
+import { AddressInput, type ResolvedRecipient } from "./AddressInput";
+import styles from "@/app/pay/pay.module.css";
+
+const EMPTY_RECIPIENT: ResolvedRecipient = {
+  address: undefined,
+  ensName: undefined,
+  isValid: false,
+  isResolving: false,
+};
+
+// Parse a user-typed amount into base units, reporting a friendly error.
+function parseAmount(
+  input: string,
+  decimals: number,
+): { value?: bigint; error?: string } {
+  const trimmed = input.trim();
+  if (!trimmed) return {};
+  if (!/^\d*\.?\d*$/.test(trimmed)) return { error: "Enter a valid number." };
+  const [, fraction = ""] = trimmed.split(".");
+  if (fraction.length > decimals) {
+    return { error: `USDC supports at most ${decimals} decimals.` };
+  }
+  try {
+    const value = parseUnits(trimmed, decimals);
+    if (value <= 0n) return { error: "Amount must be greater than 0." };
+    return { value };
+  } catch {
+    return { error: "Enter a valid number." };
+  }
+}
+
+export function PayForm() {
+  const { address, isConnected, chainId } = useAccount();
+  const { openConnectModal } = useConnectModal();
+  const { switchChain, isPending: isSwitching } = useSwitchChain();
+  const { usdcUsd } = usePrices();
+
+  const [recipientInput, setRecipientInput] = useState("");
+  const [recipient, setRecipient] = useState<ResolvedRecipient>(EMPTY_RECIPIENT);
+  const [amountInput, setAmountInput] = useState("");
+
+  // Two-phase pending: `submitting` covers click -> wallet returns hash;
+  // useWaitForTransactionReceipt covers hash -> on-chain confirmation.
+  const [submitting, setSubmitting] = useState(false);
+  const [txError, setTxError] = useState<string | null>(null);
+  const [txHash, setTxHash] = useState<`0x${string}` | undefined>();
+
+  const onWrongNetwork = isConnected && chainId !== USDC_CHAIN_ID;
+
+  // Live USDC balance — used for MAX and the insufficient-funds check.
+  const { data: usdcBalance, refetch: refetchBalance } = useReadContract({
+    address: USDC_ADDRESS,
+    abi: usdcAbi,
+    functionName: "balanceOf",
+    args: address ? [address] : undefined,
+    chainId: USDC_CHAIN_ID,
+    // Keep the balance fresh at a calm interval so the insufficient-funds
+    // check and MAX reflect reality (Rule 5).
+    query: { enabled: Boolean(address), refetchInterval: 5_000 },
+  });
+
+  const { writeContractAsync } = useWriteContract();
+  const {
+    isLoading: isConfirming,
+    isSuccess: isConfirmed,
+  } = useWaitForTransactionReceipt({
+    hash: txHash,
+    chainId: USDC_CHAIN_ID,
+    query: { enabled: Boolean(txHash) },
+  });
+
+  // Once the transfer confirms on-chain, refresh the balance and clear the
+  // amount. Effect (not render-time) so the side effects run safely.
+  useEffect(() => {
+    if (isConfirmed && txHash) {
+      refetchBalance();
+      setAmountInput("");
+    }
+  }, [isConfirmed, txHash, refetchBalance]);
+
+  const amount = useMemo(
+    () => parseAmount(amountInput, USDC_DECIMALS),
+    [amountInput],
+  );
+
+  // Insufficient-funds check against fresh on-chain balance.
+  const insufficient =
+    amount.value !== undefined &&
+    usdcBalance !== undefined &&
+    amount.value > usdcBalance;
+
+  const isSelfSend =
+    recipient.address !== undefined &&
+    address !== undefined &&
+    recipient.address.toLowerCase() === address.toLowerCase();
+
+  const amountError = amount.error
+    ? amount.error
+    : insufficient
+      ? "Amount exceeds your USDC balance."
+      : null;
+
+  const amountUsd =
+    amount.value !== undefined && usdcUsd !== undefined
+      ? Number(formatUnits(amount.value, USDC_DECIMALS)) * usdcUsd
+      : null;
+
+  const formReady =
+    isConnected &&
+    !onWrongNetwork &&
+    recipient.isValid &&
+    recipient.address !== undefined &&
+    amount.value !== undefined &&
+    !amountError;
+
+  const busy = submitting || isConfirming;
+
+  const handleRecipientResolved = useCallback((r: ResolvedRecipient) => {
+    setRecipient(r);
+  }, []);
+
+  async function handleSend() {
+    if (!formReady || !recipient.address || amount.value === undefined) return;
+    setTxError(null);
+    setTxHash(undefined);
+    setSubmitting(true);
+    try {
+      const hash = await writeContractAsync({
+        address: USDC_ADDRESS,
+        abi: usdcAbi,
+        functionName: "transfer",
+        args: [recipient.address as Address, amount.value],
+        chainId: USDC_CHAIN_ID,
+      });
+      setTxHash(hash);
+    } catch (e) {
+      // finally still runs — button never locks permanently on rejection.
+      setTxError(parseTxError(e));
+    } finally {
+      setSubmitting(false);
+    }
+  }
+
+  const explorerTxUrl =
+    txHash && `${mainnet.blockExplorers.default.url}/tx/${txHash}`;
+
+  return (
+    <div className={styles.card}>
+      <AddressInput
+        value={recipientInput}
+        onChange={(v) => {
+          setRecipientInput(v);
+          // A new recipient invalidates any prior success/error banner.
+          setTxError(null);
+        }}
+        onResolvedChange={handleRecipientResolved}
+        disabled={busy}
+      />
+
+      {isSelfSend && (
+        <p className={styles.fieldHint}>
+          Heads up: this is your own connected address.
+        </p>
+      )}
+
+      {/* Amount */}
+      <div className={styles.field} style={{ marginTop: 16 }}>
+        <label className={styles.fieldLabel} htmlFor="amount">
+          Amount
+        </label>
+        <div className={styles.inputWrap}>
+          <input
+            id="amount"
+            className={`${styles.input} ${
+              amountError ? styles.inputInvalid : ""
+            }`}
+            inputMode="decimal"
+            placeholder="0.00"
+            autoComplete="off"
+            disabled={busy}
+            value={amountInput}
+            aria-invalid={Boolean(amountError)}
+            aria-describedby="amount-status"
+            onChange={(e) => {
+              setAmountInput(e.target.value);
+              setTxError(null);
+            }}
+          />
+          <div className={styles.inputSuffix}>
+            {usdcBalance !== undefined && usdcBalance > 0n && (
+              <button
+                type="button"
+                className={styles.maxButton}
+                disabled={busy}
+                onClick={() =>
+                  setAmountInput(formatUnits(usdcBalance, USDC_DECIMALS))
+                }
+              >
+                MAX
+              </button>
+            )}
+            <span className={styles.unit}>{USDC_SYMBOL}</span>
+          </div>
+        </div>
+        <div id="amount-status" aria-live="polite">
+          {amountError ? (
+            <p className={styles.fieldError}>{amountError}</p>
+          ) : (
+            <p className={styles.fieldHint}>
+              {amountUsd !== null ? `≈ ${formatUsd(amountUsd)}` : " "}
+              {usdcBalance !== undefined && (
+                <>
+                  {" "}
+                  · Balance:{" "}
+                  {formatTokenAmount(usdcBalance, USDC_DECIMALS, 2)}{" "}
+                  {USDC_SYMBOL}
+                </>
+              )}
+            </p>
+          )}
+        </div>
+      </div>
+
+      {/* Review line — confirmation context before sending */}
+      {formReady && recipient.address && amount.value !== undefined && (
+        <div style={{ marginTop: 4, marginBottom: 12 }}>
+          <div className={styles.reviewRow}>
+            <span className={styles.reviewLabel}>You send</span>
+            <span className={styles.reviewValue}>
+              {formatTokenAmount(amount.value, USDC_DECIMALS, 2)} {USDC_SYMBOL}
+              {amountUsd !== null ? ` (~${formatUsd(amountUsd)})` : ""}
+            </span>
+          </div>
+          <div className={styles.reviewRow}>
+            <span className={styles.reviewLabel}>To</span>
+            <span className={styles.reviewValue}>
+              {recipient.ensName
+                ? `${recipient.ensName} · ${truncateAddress(recipient.address)}`
+                : truncateAddress(recipient.address)}
+            </span>
+          </div>
+        </div>
+      )}
+
+      {/* Primary action — one action at a time (Rule 2) */}
+      <PrimaryAction
+        isConnected={isConnected}
+        onWrongNetwork={onWrongNetwork}
+        isSwitching={isSwitching}
+        formReady={Boolean(formReady)}
+        submitting={submitting}
+        isConfirming={isConfirming}
+        onConnect={() => openConnectModal?.()}
+        onSwitch={() => switchChain({ chainId: USDC_CHAIN_ID })}
+        onSend={handleSend}
+      />
+
+      {/* Status feedback (Rule 7: human-readable, inline, persistent) */}
+      {txError && (
+        <div
+          className={`${styles.banner} ${styles.bannerError}`}
+          role="alert"
+          style={{ marginTop: 14 }}
+        >
+          <span>{txError}</span>
+        </div>
+      )}
+
+      {isConfirmed && txHash && (
+        <div
+          className={`${styles.banner} ${styles.bannerSuccess}`}
+          role="status"
+          style={{ marginTop: 14 }}
+        >
+          <span>
+            Sent! Your USDC transfer confirmed on-chain.{" "}
+            {explorerTxUrl && (
+              <a
+                className={styles.bannerLink}
+                href={explorerTxUrl}
+                target="_blank"
+                rel="noopener noreferrer"
+              >
+                View on Etherscan
+              </a>
+            )}
+          </span>
+        </div>
+      )}
+
+      {isConfirming && txHash && !isConfirmed && (
+        <div
+          className={`${styles.banner} ${styles.bannerSuccess}`}
+          role="status"
+          style={{ marginTop: 14 }}
+        >
+          <span>
+            Transaction submitted — waiting for confirmation.{" "}
+            {explorerTxUrl && (
+              <a
+                className={styles.bannerLink}
+                href={explorerTxUrl}
+                target="_blank"
+                rel="noopener noreferrer"
+              >
+                Track it
+              </a>
+            )}
+          </span>
+        </div>
+      )}
+    </div>
+  );
+}
+
+interface ActionProps {
+  isConnected: boolean;
+  onWrongNetwork: boolean;
+  isSwitching: boolean;
+  formReady: boolean;
+  submitting: boolean;
+  isConfirming: boolean;
+  onConnect: () => void;
+  onSwitch: () => void;
+  onSend: () => void;
+}
+
+// Renders exactly one primary action based on the current state.
+function PrimaryAction({
+  isConnected,
+  onWrongNetwork,
+  isSwitching,
+  formReady,
+  submitting,
+  isConfirming,
+  onConnect,
+  onSwitch,
+  onSend,
+}: ActionProps) {
+  if (!isConnected) {
+    return (
+      <button className={styles.button} type="button" onClick={onConnect}>
+        Connect Wallet
+      </button>
+    );
+  }
+
+  if (onWrongNetwork) {
+    return (
+      <button
+        className={styles.button}
+        type="button"
+        onClick={onSwitch}
+        disabled={isSwitching}
+      >
+        {isSwitching && <span className={styles.spinner} aria-hidden />}
+        {isSwitching ? "Switching…" : "Switch to Ethereum"}
+      </button>
+    );
+  }
+
+  const busy = submitting || isConfirming;
+  return (
+    <button
+      className={styles.button}
+      type="button"
+      onClick={onSend}
+      disabled={!formReady || busy}
+    >
+      {busy && <span className={styles.spinner} aria-hidden />}
+      {submitting
+        ? "Confirm in wallet…"
+        : isConfirming
+          ? "Sending…"
+          : "Send USDC"}
+    </button>
+  );
+}
diff --git a/lib/errors.ts b/lib/errors.ts
new file mode 100644
index 0000000..957144c
--- /dev/null
+++ b/lib/errors.ts
@@ -0,0 +1,50 @@
+import {
+  BaseError,
+  UserRejectedRequestError,
+  InsufficientFundsError,
+  ContractFunctionRevertedError,
+} from "viem";
+
+// Translate wallet/RPC/contract errors into a single human-readable line.
+// Users must never see a raw revert selector or a stringified stack.
+export function parseTxError(error: unknown): string {
+  if (!error) return "Something went wrong. Please try again.";
+
+  if (error instanceof BaseError) {
+    // Wallet-level: user hit "reject" in their wallet.
+    const rejected = error.walk(
+      (e) => e instanceof UserRejectedRequestError,
+    );
+    if (rejected) return "Transaction rejected in wallet.";
+
+    // Not enough ETH to cover gas (+ value).
+    const insufficient = error.walk(
+      (e) => e instanceof InsufficientFundsError,
+    );
+    if (insufficient) {
+      return "Insufficient ETH to cover gas. Add ETH and try again.";
+    }
+
+    // Custom / standard contract revert — surface the reason if we have one.
+    const reverted = error.walk(
+      (e) => e instanceof ContractFunctionRevertedError,
+    );
+    if (reverted instanceof ContractFunctionRevertedError) {
+      const name = reverted.data?.errorName;
+      const reason = reverted.reason;
+      if (reason) return `Transfer failed: ${reason}`;
+      if (name) return `Transfer failed: ${name}`;
+      return "Transfer reverted on-chain.";
+    }
+
+    // Fall back to viem's short, cleaned-up message.
+    if (error.shortMessage) return error.shortMessage;
+  }
+
+  if (error instanceof Error && error.message) {
+    // Last-resort: keep it short, never dump a full stack at the user.
+    return error.message.split("\n")[0];
+  }
+
+  return "Something went wrong. Please try again.";
+}
diff --git a/lib/format.ts b/lib/format.ts
new file mode 100644
index 0000000..3b77506
--- /dev/null
+++ b/lib/format.ts
@@ -0,0 +1,41 @@
+import { formatUnits } from "viem";
+
+// Compact, locale-aware token amount (e.g. "1,234.56").
+export function formatTokenAmount(
+  raw: bigint,
+  decimals: number,
+  maxFractionDigits = 4,
+): string {
+  const value = Number(formatUnits(raw, decimals));
+  return value.toLocaleString(undefined, {
+    minimumFractionDigits: 0,
+    maximumFractionDigits: maxFractionDigits,
+  });
+}
+
+// USD string with "$" and 2 decimals (e.g. "$1,250.00").
+export function formatUsd(value: number): string {
+  return value.toLocaleString(undefined, {
+    style: "currency",
+    currency: "USD",
+    minimumFractionDigits: 2,
+    maximumFractionDigits: 2,
+  });
+}
+
+// USD context for a raw token balance given a unit price. Returns null when
+// price is unavailable so callers can hide the "~$…" hint gracefully.
+export function tokenUsd(
+  raw: bigint,
+  decimals: number,
+  unitPriceUsd: number | undefined,
+): number | null {
+  if (unitPriceUsd === undefined) return null;
+  return Number(formatUnits(raw, decimals)) * unitPriceUsd;
+}
+
+// Truncate an address as 0x1234…abcd for compact display.
+export function truncateAddress(address: string, size = 4): string {
+  if (address.length <= 2 + size * 2) return address;
+  return `${address.slice(0, 2 + size)}…${address.slice(-size)}`;
+}
