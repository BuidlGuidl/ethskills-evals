+import { fileURLToPath } from "node:url";
+
+const emptyStub = fileURLToPath(new URL("./stubs/empty.js", import.meta.url));
+
+/** @type {import('next').NextConfig} */
+const nextConfig = {
+  reactStrictMode: true,
+  webpack: (config, { webpack }) => {
+    // wagmi's connector barrel statically pulls in the Base Account connector,
+    // which references optional Coinbase x402 payment modules we don't use and
+    // that ship no installable package. Redirect the whole @x402/* scope to an
+    // empty stub so the bundle resolves; x402 payment flows are never invoked.
+    config.plugins.push(
+      new webpack.NormalModuleReplacementPlugin(/^@x402\//, emptyStub),
+    );
+    // Optional pretty-logger dep pulled by WalletConnect; not needed in-browser.
+    config.externals.push("pino-pretty", "lokijs", "encoding");
+    return config;
+  },
+};
+
+export default nextConfig;
