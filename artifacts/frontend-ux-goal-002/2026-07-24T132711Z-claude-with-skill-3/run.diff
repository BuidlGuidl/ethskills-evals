+++ b/components/AddressInput.tsx
@@ -0,0 +1,184 @@
+"use client";
+
+import { useEffect, useMemo } from "react";
+import { type Address, isAddress, getAddress } from "viem";
+import { normalize } from "viem/ens";
+import { useEnsAddress, useEnsName } from "wagmi";
+import { mainnet } from "wagmi/chains";
+import { truncateAddress } from "@/lib/format";
+import styles from "@/app/pay/pay.module.css";
+
+export interface ResolvedRecipient {
+  address: Address | undefined;
+  ensName: string | undefined;
+  isValid: boolean;
+  isResolving: boolean;
+}
+
+interface Props {
+  value: string;
+  onChange: (value: string) => void;
+  onResolvedChange: (resolved: ResolvedRecipient) => void;
+  disabled?: boolean;
+}
+
+// A value that contains a dot and no 0x prefix is treated as an ENS name.
+function looksLikeEns(value: string): boolean {
+  return value.includes(".") && !value.startsWith("0x");
+}
+
+export function AddressInput({
+  value,
+  onChange,
+  onResolvedChange,
+  disabled,
+}: Props) {
+  const trimmed = value.trim();
+  const isEns = looksLikeEns(trimmed);
+  const isHex = trimmed.startsWith("0x");
+
+  // Normalize ENS names safely; invalid names simply won't resolve.
+  const normalizedName = useMemo(() => {
+    if (!isEns) return undefined;
+    try {
+      return normalize(trimmed);
+    } catch {
+      return undefined;
+    }
+  }, [isEns, trimmed]);
+
+  // Forward-resolve an ENS name -> address.
+  const {
+    data: ensResolvedAddress,
+    isLoading: ensResolving,
+    isError: ensError,
+  } = useEnsAddress({
+    name: normalizedName,
+    chainId: mainnet.id,
+    query: { enabled: Boolean(normalizedName) },
+  });
+
+  // A directly-typed, checksum-valid hex address.
+  const hexAddress = useMemo<Address | undefined>(() => {
+    if (isHex && isAddress(trimmed)) return getAddress(trimmed);
+    return undefined;
+  }, [isHex, trimmed]);
+
+  // Reverse-resolve a pasted hex address -> ENS name (display sugar only).
+  const { data: reverseEnsName } = useEnsName({
+    address: hexAddress,
+    chainId: mainnet.id,
+    query: { enabled: Boolean(hexAddress) },
+  });
+
+  const resolvedAddress = hexAddress ?? ensResolvedAddress ?? undefined;
+  const ensName = isEns ? normalizedName : (reverseEnsName ?? undefined);
+  const isResolving = isEns && ensResolving;
+
+  // Field-level validation message.
+  let error: string | null = null;
+  if (trimmed.length > 0) {
+    if (isEns) {
+      if (!normalizedName) error = "Not a valid ENS name.";
+      else if (!isResolving && (ensError || !ensResolvedAddress))
+        error = "This ENS name doesn't resolve to an address.";
+    } else if (isHex) {
+      if (!isAddress(trimmed)) error = "Not a valid Ethereum address.";
+    } else {
+      error = "Enter a 0x address or an ENS name.";
+    }
+  }
+
+  const isValid = Boolean(resolvedAddress) && !error;
+
+  // Lift resolution state to the parent whenever it changes.
+  useEffect(() => {
+    onResolvedChange({
+      address: resolvedAddress,
+      ensName: ensName ?? undefined,
+      isValid,
+      isResolving,
+    });
+    // onResolvedChange is memoized by the parent; deps track the real inputs.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [resolvedAddress, ensName, isValid, isResolving]);
+
+  return (
+    <div className={styles.field}>
+      <label className={styles.fieldLabel} htmlFor="recipient">
+        Recipient
+      </label>
+      <div className={styles.inputWrap}>
+        <input
+          id="recipient"
+          className={`${styles.input} ${error ? styles.inputInvalid : ""}`}
+          placeholder="0x… or name.eth"
+          spellCheck={false}
+          autoComplete="off"
+          autoCapitalize="off"
+          disabled={disabled}
+          value={value}
+          aria-invalid={Boolean(error)}
+          aria-describedby="recipient-status"
+          onChange={(e) => onChange(e.target.value)}
+          onPaste={(e) => {
+            // Normalize pasted values: strip whitespace and stray prefixes.
+            e.preventDefault();
+            const pasted = e.clipboardData
+              .getData("text")
+              .trim()
+              .replace(/^ethereum:/i, "");
+            onChange(pasted);
+          }}
+        />
+      </div>
+
+      <div id="recipient-status" aria-live="polite">
+        {error ? (
+          <p className={styles.fieldError}>{error}</p>
+        ) : isResolving ? (
+          <p className={styles.fieldHint}>Resolving ENS name…</p>
+        ) : resolvedAddress ? (
+          <p className={styles.resolved}>
+            <CheckIcon />
+            {isEns ? (
+              <span>
+                Resolves to{" "}
+                <span className={styles.resolvedMono}>
+                  {truncateAddress(resolvedAddress)}
+                </span>
+              </span>
+            ) : reverseEnsName ? (
+              <span>
+                {reverseEnsName} ·{" "}
+                <span className={styles.resolvedMono}>
+                  {truncateAddress(resolvedAddress)}
+                </span>
+              </span>
+            ) : (
+              <span>Valid address</span>
+            )}
+          </p>
+        ) : (
+          <p className={styles.fieldHint}>
+            Enter the recipient&apos;s address or ENS name.
+          </p>
+        )}
+      </div>
+    </div>
+  );
+}
+
+function CheckIcon() {
+  return (
+    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden>
+      <path
+        d="M20 6 9 17l-5-5"
+        stroke="currentColor"
+        strokeWidth="2.5"
+        strokeLinecap="round"
+        strokeLinejoin="round"
+      />
+    </svg>
+  );
+}
diff --git a/components/BalanceCard.tsx b/components/BalanceCard.tsx
new file mode 100644
