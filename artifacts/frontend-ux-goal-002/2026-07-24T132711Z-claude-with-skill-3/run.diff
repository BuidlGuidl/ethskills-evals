new file mode 100644
index 0000000..6975706
--- /dev/null
+++ b/lib/usePrices.ts
@@ -0,0 +1,44 @@
+"use client";
+
+import { useQuery } from "@tanstack/react-query";
+
+interface Prices {
+  eth: number | undefined;
+  usdc: number | undefined;
+}
+
+// USD prices for ETH and USDC. USDC is a dollar stablecoin so it defaults to
+// $1, but we still fetch it so a serious de-peg is reflected rather than lied
+// about. Prices are best-effort: on failure callers hide the "~$…" hint.
+async function fetchPrices(): Promise<Prices> {
+  const res = await fetch(
+    "https://api.coingecko.com/api/v3/simple/price?ids=ethereum,usd-coin&vs_currencies=usd",
+    { headers: { accept: "application/json" } },
+  );
+  if (!res.ok) throw new Error(`Price request failed: ${res.status}`);
+  const data = (await res.json()) as {
+    ethereum?: { usd: number };
+    "usd-coin"?: { usd: number };
+  };
+  return {
+    eth: data.ethereum?.usd,
+    usdc: data["usd-coin"]?.usd,
+  };
+}
+
+export function usePrices() {
+  const { data } = useQuery({
+    queryKey: ["prices"],
+    queryFn: fetchPrices,
+    // Prices don't need to be real-time; refetch every 60s, keep last value.
+    refetchInterval: 60_000,
+    staleTime: 60_000,
+    retry: 2,
+  });
+
+  return {
+    ethUsd: data?.eth,
+    // Fall back to the $1 peg if the endpoint didn't return USDC.
+    usdcUsd: data?.usdc ?? (data ? 1 : undefined),
+  };
+}
