+import { getDefaultConfig } from "@rainbow-me/rainbowkit";
+import { mainnet } from "wagmi/chains";
+import { http, fallback } from "wagmi";
+
+// A dedicated RPC keeps production reliable. We fall back to the chain's
+// public endpoints so the app still works without configuration, but a
+// dedicated provider (Alchemy/Infura) should always be set in prod.
+const dedicatedRpc = process.env.NEXT_PUBLIC_MAINNET_RPC_URL;
+
+// WalletConnect requires a project id. In local/dev without one we still let
+// the app boot (injected wallets work); WalletConnect-based wallets need it.
+const walletConnectProjectId =
+  process.env.NEXT_PUBLIC_WC_PROJECT_ID ?? "0000000000000000000000000000000000";
+
+export const config = getDefaultConfig({
+  appName: "USDC Pay",
+  projectId: walletConnectProjectId,
+  chains: [mainnet],
+  transports: {
+    [mainnet.id]: dedicatedRpc
+      ? // Dedicated RPC first, public endpoint as an intentional backup.
+        fallback([http(dedicatedRpc), http()])
+      : http(),
+  },
+  // Poll chain state at a responsive-but-calm cadence (see providers.tsx for
+  // the query client refetch settings that pair with this).
+  pollingInterval: 4_000,
+  ssr: true,
+});
+
+declare module "wagmi" {
+  interface Register {
+    config: typeof config;
+  }
+}
