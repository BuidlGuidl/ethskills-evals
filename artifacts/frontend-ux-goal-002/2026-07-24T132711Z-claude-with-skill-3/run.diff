+export const USDC_ADDRESS = getAddress(
+  "0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48",
+);
+
+// USDC uses 6 decimals, not 18. Getting this wrong is the classic dApp bug.
+export const USDC_DECIMALS = 6;
+export const USDC_SYMBOL = "USDC";
+
+export const USDC_CHAIN_ID = mainnet.id;
+
+// Standard ERC-20 ABI from viem is sufficient for balanceOf + transfer.
+export const usdcAbi = erc20Abi;
