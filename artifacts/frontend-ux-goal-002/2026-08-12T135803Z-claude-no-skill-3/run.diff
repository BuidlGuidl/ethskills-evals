+'use client'
+
+import { formatEth, formatTokenAmount } from '@/lib/format'
+import { USDC_SYMBOL } from '@/lib/usdc'
+import { Spinner, cx } from './ui'
+
+export function Balances({
+  usdcBalance,
+  ethBalance,
+  decimals,
+  isLoading,
+  isFetching,
+  hasError,
+  onRefresh,
+}: {
+  usdcBalance?: bigint
+  ethBalance?: bigint
+  decimals?: number
+  isLoading: boolean
+  isFetching: boolean
+  hasError: boolean
+  onRefresh: () => void
+}) {
+  const usdcReady = usdcBalance !== undefined && decimals !== undefined
+  const noEth = ethBalance === 0n
+
+  return (
+    <section
+      aria-label="Your balances"
+      className="rounded-2xl border border-line bg-surface-raised p-5"
+    >
+      <div className="flex items-start justify-between gap-4">
+        <div className="min-w-0">
+          <h2 className="text-[13px] font-medium text-ink-muted">Your {USDC_SYMBOL} balance</h2>
+          <p className="mt-1 truncate font-mono text-3xl font-semibold tracking-tight tabular-nums">
+            {isLoading || !usdcReady ? (
+              <span className="text-ink-muted">—</span>
+            ) : (
+              formatTokenAmount(usdcBalance, decimals, 2)
+            )}
+            <span className="ml-2 text-base font-medium text-ink-muted">{USDC_SYMBOL}</span>
+          </p>
+        </div>
+
+        <button
+          type="button"
+          onClick={onRefresh}
+          disabled={isFetching}
+          aria-label="Refresh balances"
+          className={cx(
+            'shrink-0 rounded-lg border border-line p-2 text-ink-muted',
+            'transition-colors hover:text-ink disabled:opacity-50',
+            'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand',
+          )}
+        >
+          {isFetching ? (
+            <Spinner className="size-4" />
+          ) : (
+            <svg className="size-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
+              <path
+                d="M20 11a8 8 0 1 0-.6 4M20 5v6h-6"
+                stroke="currentColor"
+                strokeWidth="2"
+                strokeLinecap="round"
+                strokeLinejoin="round"
+              />
+            </svg>
+          )}
+        </button>
+      </div>
+
+      <div className="mt-4 flex items-center justify-between border-t border-line pt-3">
+        <span className="text-[13px] text-ink-muted">ETH balance (for gas)</span>
+        <span
+          className={cx(
+            'font-mono text-sm tabular-nums',
+            noEth ? 'text-danger' : 'text-ink',
+          )}
+        >
+          {isLoading || ethBalance === undefined ? '—' : `${formatEth(ethBalance)} ETH`}
+        </span>
+      </div>
+
+      {hasError && (
+        <p role="alert" className="mt-3 text-[13px] text-danger">
+          Could not load balances. Check your network and try refreshing.
+        </p>
+      )}
+    </section>
+  )
+}
