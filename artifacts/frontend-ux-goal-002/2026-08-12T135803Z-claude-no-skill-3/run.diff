@@ -0,0 +1,111 @@
+'use client'
+
+import type { Hash } from 'viem'
+import { PAYMENT_CHAIN } from '@/lib/usdc'
+import { truncateAddress } from '@/lib/address'
+import { Button, Spinner } from './ui'
+
+const explorerUrl = PAYMENT_CHAIN.blockExplorers.default.url
+const explorerName = PAYMENT_CHAIN.blockExplorers.default.name
+
+export type TxPhase = 'signing' | 'confirming' | 'success' | 'reverted'
+
+export function TxStatus({
+  phase,
+  hash,
+  summary,
+  onDone,
+}: {
+  phase: TxPhase
+  hash?: Hash
+  /** e.g. "25 USDC to alice.eth" */
+  summary: string
+  onDone: () => void
+}) {
+  const copy = {
+    signing: {
+      title: 'Confirm in your wallet',
+      body: 'Approve the transaction to send this payment.',
+    },
+    confirming: {
+      title: 'Payment submitted',
+      body: 'Waiting for the transaction to be included in a block.',
+    },
+    success: {
+      title: 'Payment sent',
+      body: `You sent ${summary}.`,
+    },
+    reverted: {
+      title: 'Transaction failed',
+      body: 'The transaction was mined but reverted. No USDC was transferred, but the gas was spent.',
+    },
+  }[phase]
+
+  const done = phase === 'success' || phase === 'reverted'
+
+  return (
+    <section
+      aria-live="polite"
+      className="rounded-2xl border border-line bg-surface-raised p-6 text-center"
+    >
+      <div className="mx-auto flex size-12 items-center justify-center rounded-full border border-line">
+        {phase === 'success' ? (
+          <svg className="size-6 text-success" viewBox="0 0 24 24" fill="none" aria-hidden="true">
+            <path
+              d="m5 13 4 4L19 7"
+              stroke="currentColor"
+              strokeWidth="2.5"
+              strokeLinecap="round"
+              strokeLinejoin="round"
+            />
+          </svg>
+        ) : phase === 'reverted' ? (
+          <svg className="size-6 text-danger" viewBox="0 0 24 24" fill="none" aria-hidden="true">
+            <path
+              d="M6 6l12 12M18 6 6 18"
+              stroke="currentColor"
+              strokeWidth="2.5"
+              strokeLinecap="round"
+            />
+          </svg>
+        ) : (
+          <Spinner className="size-6 text-brand" />
+        )}
+      </div>
+
+      <h2 className="mt-4 text-lg font-semibold">{copy.title}</h2>
+      <p className="mt-1 text-sm text-ink-muted">{copy.body}</p>
+
+      {phase === 'confirming' && (
+        <p className="mt-1 text-sm text-ink-muted">Sending {summary}.</p>
+      )}
+
+      {hash && (
+        <a
+          href={`${explorerUrl}/tx/${hash}`}
+          target="_blank"
+          rel="noopener noreferrer"
+          className="mt-4 inline-flex items-center gap-1.5 font-mono text-[13px] text-brand hover:underline"
+        >
+          {truncateAddress(hash, 10, 8)}
+          <span className="sr-only">— view on {explorerName}</span>
+          <svg className="size-3.5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
+            <path
+              d="M14 5h5v5M19 5l-9 9M18 14v5H5V6h5"
+              stroke="currentColor"
+              strokeWidth="2"
+              strokeLinecap="round"
+              strokeLinejoin="round"
+            />
+          </svg>
+        </a>
+      )}
+
+      {done && (
+        <Button variant="secondary" className="mt-6" onClick={onDone}>
+          {phase === 'success' ? 'Send another payment' : 'Back to form'}
+        </Button>
+      )}
+    </section>
+  )
+}
diff --git a/src/components/ui.tsx b/src/components/ui.tsx
new file mode 100644
