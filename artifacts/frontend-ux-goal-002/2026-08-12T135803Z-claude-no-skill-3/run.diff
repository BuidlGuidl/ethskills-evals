+/**
+ * Stub for the optional `@x402/*` packages.
+ *
+ * RainbowKit's barrel pulls in the Base Account connector, which reaches
+ * `@coinbase/cdp-sdk`'s x402 machine-payment helpers. Those helpers declare
+ * `@x402/*` as *optional* peer dependencies — so they are not installed — but
+ * the bundler still resolves the specifiers at build time and fails. This app
+ * never signs x402 payments, so the modules are aliased here instead of
+ * pulling in four unused dependencies (including the whole Solana stack).
+ *
+ * CommonJS + Proxy on purpose: the importers use both `import()` and static
+ * named imports, and a statically-analysable ES module would have to enumerate
+ * every export they happen to reference. Anything touched here throws loudly
+ * rather than failing silently.
+ *
+ * Wired up via `turbopack.resolveAlias` in next.config.ts.
+ */
+
+function unavailable() {
+  throw new Error('x402 payments are not supported in this app.')
+}
+
+module.exports = new Proxy(
+  {},
+  {
+    get(_target, property) {
+      // Let module-interop probes see a plain CJS object.
+      if (property === '__esModule' || typeof property === 'symbol') return undefined
+      return unavailable
+    },
+  },
+)
