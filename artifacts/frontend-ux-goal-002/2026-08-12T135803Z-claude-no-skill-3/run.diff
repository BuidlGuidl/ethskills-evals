--- /dev/null
+++ b/src/hooks/use-balances.ts
@@ -0,0 +1,61 @@
+'use client'
+
+import { useCallback } from 'react'
+import { useAccount, useBalance, useReadContract } from 'wagmi'
+import { PAYMENT_CHAIN, USDC_ADDRESS, erc20Abi } from '@/lib/usdc'
+
+/**
+ * The user's mainnet balances.
+ *
+ * `chainId` is pinned to mainnet on every read: if the wallet is pointed at
+ * some other network we still want to show the real USDC/ETH position rather
+ * than an empty one.
+ */
+export function useBalances() {
+  const { address } = useAccount()
+  const enabled = Boolean(address)
+
+  const eth = useBalance({
+    address,
+    chainId: PAYMENT_CHAIN.id,
+    query: { enabled },
+  })
+
+  const usdc = useReadContract({
+    address: USDC_ADDRESS,
+    abi: erc20Abi,
+    functionName: 'balanceOf',
+    args: address ? [address] : undefined,
+    chainId: PAYMENT_CHAIN.id,
+    query: { enabled },
+  })
+
+  const decimals = useReadContract({
+    address: USDC_ADDRESS,
+    abi: erc20Abi,
+    functionName: 'decimals',
+    chainId: PAYMENT_CHAIN.id,
+    // Immutable in practice; refetching it on every mount is pure waste.
+    query: { staleTime: Infinity, gcTime: Infinity },
+  })
+
+  // TanStack Query keeps `refetch` referentially stable, so this callback is
+  // safe to use as an effect dependency.
+  const { refetch: refetchEth } = eth
+  const { refetch: refetchUsdc } = usdc
+  const refetch = useCallback(() => {
+    void refetchEth()
+    void refetchUsdc()
+  }, [refetchEth, refetchUsdc])
+
+  return {
+    ethBalance: eth.data?.value,
+    usdcBalance: usdc.data,
+    /** `undefined` until read from chain — never guessed before parsing input. */
+    decimals: decimals.data,
+    isLoading: eth.isLoading || usdc.isLoading || decimals.isLoading,
+    isFetching: eth.isFetching || usdc.isFetching,
+    error: eth.error ?? usdc.error ?? decimals.error,
+    refetch,
+  }
+}
diff --git a/src/hooks/use-recipient.ts b/src/hooks/use-recipient.ts
new file mode 100644
index 0000000..39fb216
--- /dev/null
+++ b/src/hooks/use-recipient.ts
@@ -0,0 +1,100 @@
+'use client'
+
+import { useMemo } from 'react'
+import { normalize } from 'viem/ens'
+import type { Address } from 'viem'
+import { useBytecode, useEnsAddress, useEnsName } from 'wagmi'
+import {
+  blockedRecipientReason,
+  isAddressPrefix,
+  looksLikeEnsName,
+  parseAddress,
+} from '@/lib/address'
+import { PAYMENT_CHAIN, USDC_ADDRESS, USDC_SYMBOL } from '@/lib/usdc'
+
+const USDC_TOKEN = { address: USDC_ADDRESS, symbol: USDC_SYMBOL }
+
+export type RecipientState =
+  | { status: 'empty' }
+  /** Still being typed — not valid yet, but not worth an error either. */
+  | { status: 'incomplete' }
+  | { status: 'resolving' }
+  | { status: 'invalid'; error: string }
+  | {
+      status: 'ok'
+      address: Address
+      /** Set when the user typed a name, or when reverse resolution found one. */
+      ensName?: string
+      /** Recipient has code — could be a contract that cannot move USDC back out. */
+      isContract: boolean
+    }
+
+/**
+ * Resolves whatever the user typed — a 0x address or an ENS name — into a
+ * single address, with the checks that stop a payment from going nowhere.
+ */
+export function useRecipient(input: string): RecipientState {
+  const raw = input.trim()
+  const isEns = looksLikeEnsName(raw)
+
+  const ensName = useMemo(() => {
+    if (!isEns) return undefined
+    try {
+      return normalize(raw)
+    } catch {
+      return undefined
+    }
+  }, [isEns, raw])
+
+  const ensAddress = useEnsAddress({
+    name: ensName,
+    chainId: PAYMENT_CHAIN.id,
+    query: { enabled: Boolean(ensName) },
+  })
+
+  const parsed = isEns ? null : parseAddress(raw)
+  const directAddress = parsed?.ok ? parsed.address : undefined
+
+  const resolved = isEns ? (ensAddress.data ?? undefined) : directAddress
+
+  // Reverse lookup gives a pasted address a human-readable confirmation.
+  const reverseEns = useEnsName({
+    address: directAddress,
+    chainId: PAYMENT_CHAIN.id,
+    query: { enabled: Boolean(directAddress) },
+  })
+
+  const bytecode = useBytecode({
+    address: resolved,
+    chainId: PAYMENT_CHAIN.id,
+    query: { enabled: Boolean(resolved) },
+  })
+
+  if (raw === '') return { status: 'empty' }
+  if (!isEns && isAddressPrefix(raw)) return { status: 'incomplete' }
+
+  if (isEns) {
+    if (!ensName) return { status: 'invalid', error: 'Not a valid ENS name.' }
+    if (ensAddress.isLoading) return { status: 'resolving' }
+    if (ensAddress.isError) {
+      return { status: 'invalid', error: 'Could not reach ENS. Check your connection.' }
+    }
+    if (!ensAddress.data) {
+      return { status: 'invalid', error: `${ensName} does not resolve to an address.` }
+    }
+  } else if (!parsed?.ok) {
+    return { status: 'invalid', error: parsed?.error ?? 'Not a valid address.' }
+  }
+
+  if (!resolved) return { status: 'resolving' }
+
+  const blocked = blockedRecipientReason(resolved, USDC_TOKEN)
+  if (blocked) return { status: 'invalid', error: blocked }
+
+  return {
+    status: 'ok',
+    address: resolved,
+    ensName: isEns ? ensName : (reverseEns.data ?? undefined),
+    isContract: Boolean(bytecode.data && bytecode.data !== '0x'),
+  }
+}
diff --git a/src/hooks/use-transfer-gas.ts b/src/hooks/use-transfer-gas.ts
