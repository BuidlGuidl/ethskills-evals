@@ -0,0 +1,60 @@
+'use client'
+
+import { useMemo } from 'react'
+import { encodeFunctionData, type Address } from 'viem'
+import { useAccount, useEstimateFeesPerGas, useEstimateGas } from 'wagmi'
+import { PAYMENT_CHAIN, USDC_ADDRESS, erc20Abi } from '@/lib/usdc'
+
+/**
+ * What this transfer will cost in ETH, so the gas requirement is visible
+ * before the wallet pops up rather than after.
+ */
+export function useTransferGas({
+  to,
+  value,
+  enabled,
+}: {
+  to?: Address
+  value?: bigint
+  enabled: boolean
+}) {
+  const { address } = useAccount()
+
+  const data = useMemo(() => {
+    if (!to || value === undefined) return undefined
+    return encodeFunctionData({
+      abi: erc20Abi,
+      functionName: 'transfer',
+      args: [to, value],
+    })
+  }, [to, value])
+
+  const ready = enabled && Boolean(data && address)
+
+  const gas = useEstimateGas({
+    to: USDC_ADDRESS,
+    data,
+    account: address,
+    chainId: PAYMENT_CHAIN.id,
+    query: { enabled: ready },
+  })
+
+  const fees = useEstimateFeesPerGas({
+    chainId: PAYMENT_CHAIN.id,
+    query: { enabled: ready, staleTime: 12_000 },
+  })
+
+  const maxFeePerGas = fees.data?.maxFeePerGas
+  const feeWei =
+    gas.data !== undefined && maxFeePerGas !== undefined
+      ? gas.data * maxFeePerGas
+      : undefined
+
+  return {
+    gasLimit: gas.data,
+    maxFeePerGas,
+    /** Worst-case cost at the current suggested max fee. */
+    feeWei,
+    isLoading: gas.isLoading || fees.isLoading,
+  }
+}
