+    // Optional peer deps of @coinbase/cdp-sdk, reached via RainbowKit's barrel
+    // but never executed here. See src/stubs/x402.ts.
+    resolveAlias: {
+      '@x402/core/client': x402Stub,
+      '@x402/evm': x402Stub,
+      '@x402/evm/exact/client': x402Stub,
+      '@x402/evm/upto/client': x402Stub,
+      '@x402/svm/exact/client': x402Stub,
+    },
+  },
+}
+
