+'use client'
+
+import { useEffect, useMemo, useState } from 'react'
+import { formatUnits } from 'viem'
+import {
+  useAccount,
+  useSimulateContract,
+  useSwitchChain,
+  useWaitForTransactionReceipt,
+  useWriteContract,
+} from 'wagmi'
+import { useBalances } from '@/hooks/use-balances'
+import { useRecipient } from '@/hooks/use-recipient'
+import { useTransferGas } from '@/hooks/use-transfer-gas'
+import { truncateAddress } from '@/lib/address'
+import { isPartialAmount, parseAmount } from '@/lib/amount'
+import { toFriendlyError } from '@/lib/errors'
+import { formatEth, formatTokenAmount } from '@/lib/format'
+import { PAYMENT_CHAIN, USDC_ADDRESS, USDC_SYMBOL, erc20Abi } from '@/lib/usdc'
+import { walletConnectDisabled } from '@/lib/wagmi'
+import { Balances } from './balances'
+import { TxStatus, type TxPhase } from './tx-status'
+import { Button, Callout, FieldMessage, Label, Spinner, cx } from './ui'
+
+const inputClass = cx(
+  'h-12 w-full rounded-xl border border-line bg-surface px-3.5 text-[15px] text-ink',
+  'placeholder:text-ink-muted/60 transition-colors',
+  'focus:border-brand focus:outline-none',
+  'aria-[invalid=true]:border-danger',
+)
+
+export function PayForm() {
+  const { address, isConnected, chainId } = useAccount()
+  const { switchChain, isPending: isSwitching } = useSwitchChain()
+  const onPaymentChain = chainId === PAYMENT_CHAIN.id
+
+  const {
+    usdcBalance,
+    ethBalance,
+    decimals,
+    isLoading: balancesLoading,
+    isFetching: balancesFetching,
+    error: balancesError,
+    refetch: refetchBalances,
+  } = useBalances()
+
+  const [recipientInput, setRecipientInput] = useState('')
+  const [amountInput, setAmountInput] = useState('')
+
+  const recipient = useRecipient(recipientInput)
+  const recipientAddress = recipient.status === 'ok' ? recipient.address : undefined
+
+  const amountState = useMemo(() => {
+    if (decimals === undefined || amountInput.trim() === '') return null
+    return parseAmount(amountInput, decimals)
+  }, [amountInput, decimals])
+
+  const amountValue = amountState?.ok ? amountState.value : undefined
+  const overBalance =
+    amountValue !== undefined && usdcBalance !== undefined && amountValue > usdcBalance
+
+  // Errors are only surfaced once the input can no longer become valid, so
+  // typing "0." or a half-pasted address does not flash red.
+  const amountError =
+    amountState && !amountState.ok && amountState.code !== 'incomplete'
+      ? amountState.error
+      : overBalance && usdcBalance !== undefined && decimals !== undefined
+        ? `That is more than your balance of ${formatTokenAmount(usdcBalance, decimals)} ${USDC_SYMBOL}.`
+        : null
+
+  const recipientError = recipient.status === 'invalid' ? recipient.error : null
+  const noEth = ethBalance === 0n
+
+  const detailsComplete =
+    isConnected &&
+    onPaymentChain &&
+    recipientAddress !== undefined &&
+    amountValue !== undefined &&
+    !overBalance
+
+  const canPrepare = detailsComplete && !noEth
+
+  const gas = useTransferGas({
+    to: recipientAddress,
+    value: amountValue,
+    enabled: canPrepare,
+  })
+
+  const simulation = useSimulateContract({
+    address: USDC_ADDRESS,
+    abi: erc20Abi,
+    functionName: 'transfer',
+    args: recipientAddress && amountValue !== undefined
+      ? [recipientAddress, amountValue]
+      : undefined,
+    account: address,
+    chainId: PAYMENT_CHAIN.id,
+    query: { enabled: canPrepare },
+  })
+
+  const {
+    writeContract,
+    data: hash,
+    isPending: isSigning,
+    error: writeError,
+    reset: resetWrite,
+  } = useWriteContract()
+
+  const receipt = useWaitForTransactionReceipt({
+    hash,
+    chainId: PAYMENT_CHAIN.id,
+    confirmations: 1,
+  })
+
+  // Balances are stale the moment a transfer lands.
+  useEffect(() => {
+    if (receipt.isSuccess) refetchBalances()
+  }, [receipt.isSuccess, refetchBalances])
+
+  const phase: TxPhase | null =
+    receipt.data?.status === 'reverted'
+      ? 'reverted'
+      : receipt.data?.status === 'success'
+        ? 'success'
+        : hash
+          ? 'confirming'
+          : isSigning
+            ? 'signing'
+            : null
+
+  const lowEth =
+    !noEth &&
+    ethBalance !== undefined &&
+    gas.feeWei !== undefined &&
+    ethBalance < gas.feeWei
+
+  const isSelfSend =
+    recipientAddress !== undefined &&
+    address !== undefined &&
+    recipientAddress.toLowerCase() === address.toLowerCase()
+
+  const formattedAmount =
+    amountValue !== undefined && decimals !== undefined
+      ? formatTokenAmount(amountValue, decimals)
+      : null
+
+  const summary =
+    formattedAmount && recipient.status === 'ok'
+      ? `${formattedAmount} ${USDC_SYMBOL} to ${recipient.ensName ?? truncateAddress(recipient.address)}`
+      : ''
+
+  function handleSubmit(event: React.FormEvent) {
+    event.preventDefault()
+    if (!simulation.data) return
+    writeContract(simulation.data.request)
+  }
+
+  function handleReset() {
+    resetWrite()
+    setAmountInput('')
+    setRecipientInput('')
+  }
+
+  if (!isConnected) {
+    return (
+      <div className="rounded-2xl border border-line bg-surface-raised p-8 text-center">
+        <h2 className="text-lg font-semibold">Connect your wallet</h2>
+        <p className="mx-auto mt-2 max-w-sm text-sm text-ink-muted">
+          Connect an Ethereum wallet to see your balances and send {USDC_SYMBOL} on{' '}
+          {PAYMENT_CHAIN.name}.
+        </p>
+        {walletConnectDisabled && (
+          <Callout tone="warning" className="mt-5 text-left">
+            No WalletConnect project id is configured, so only browser-extension wallets
+            can connect. Set <code className="font-mono">NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID</code>{' '}
+            to enable mobile wallets.
+          </Callout>
+        )}
+      </div>
+    )
+  }
+
+  return (
+    <div className="flex flex-col gap-4">
+      <Balances
+        usdcBalance={usdcBalance}
+        ethBalance={ethBalance}
+        decimals={decimals}
+        isLoading={balancesLoading}
+        isFetching={balancesFetching}
+        hasError={Boolean(balancesError)}
+        onRefresh={refetchBalances}
+      />
+
+      {!onPaymentChain ? (
+        <Callout tone="warning">
+          <p className="font-medium text-ink">Wrong network</p>
+          <p className="mt-1">
+            {USDC_SYMBOL} payments happen on {PAYMENT_CHAIN.name}. Switch networks to
+            continue.
+          </p>
+          <Button
+            variant="secondary"
+            className="mt-3 h-10"
+            disabled={isSwitching}
+            onClick={() => switchChain({ chainId: PAYMENT_CHAIN.id })}
+          >
+            {isSwitching ? <Spinner className="size-4" /> : null}
+            Switch to {PAYMENT_CHAIN.name}
+          </Button>
+        </Callout>
+      ) : phase ? (
+        <TxStatus phase={phase} hash={hash} summary={summary} onDone={handleReset} />
+      ) : (
+        <form
+          onSubmit={handleSubmit}
+          className="flex flex-col gap-5 rounded-2xl border border-line bg-surface-raised p-5"
+          noValidate
+        >
+          {/* Recipient */}
+          <div className="flex flex-col gap-1.5">
+            <Label htmlFor="recipient">Recipient</Label>
+            <input
+              id="recipient"
+              name="recipient"
+              value={recipientInput}
+              onChange={(e) => setRecipientInput(e.target.value)}
+              placeholder="0x… or name.eth"
+              autoComplete="off"
+              autoCorrect="off"
+              spellCheck={false}
+              aria-invalid={Boolean(recipientError)}
+              aria-describedby="recipient-message"
+              className={cx(inputClass, 'font-mono text-sm')}
+            />
+            <div id="recipient-message" className="min-h-[18px]">
+              {recipientError ? (
+                <FieldMessage tone="error">{recipientError}</FieldMessage>
+              ) : recipient.status === 'resolving' ? (
+                <FieldMessage tone="muted">Resolving…</FieldMessage>
+              ) : recipient.status === 'ok' ? (
+                <FieldMessage tone="success">
+                  {recipient.ensName
+                    ? `${recipient.ensName} · ${truncateAddress(recipient.address)}`
+                    : truncateAddress(recipient.address, 10, 8)}
+                </FieldMessage>
+              ) : null}
+            </div>
+          </div>
+
+          {/* Amount */}
+          <div className="flex flex-col gap-1.5">
+            <div className="flex items-baseline justify-between">
+              <Label htmlFor="amount">Amount</Label>
+              <button
+                type="button"
+                disabled={!usdcBalance || decimals === undefined}
+                onClick={() => {
+                  if (usdcBalance === undefined || decimals === undefined) return
+                  setAmountInput(formatUnits(usdcBalance, decimals))
+                }}
+                className="text-[13px] font-medium text-brand hover:underline disabled:opacity-40 disabled:hover:no-underline"
+              >
+                Max
+              </button>
+            </div>
+            <div className="relative">
+              <input
+                id="amount"
+                name="amount"
+                value={amountInput}
+                onChange={(e) => {
+                  if (isPartialAmount(e.target.value)) setAmountInput(e.target.value)
+                }}
+                inputMode="decimal"
+                placeholder="0.00"
+                autoComplete="off"
+                aria-invalid={Boolean(amountError)}
+                aria-describedby="amount-message"
+                className={cx(inputClass, 'pr-20 font-mono tabular-nums')}
+              />
+              <span className="pointer-events-none absolute inset-y-0 right-3.5 flex items-center text-sm font-medium text-ink-muted">
+                {USDC_SYMBOL}
+              </span>
+            </div>
+            <div id="amount-message" className="min-h-[18px]">
+              {amountError && <FieldMessage tone="error">{amountError}</FieldMessage>}
+            </div>
+          </div>
+
+          {/* Warnings that should not block the send */}
+          {isSelfSend && (
+            <Callout tone="warning">
+              This is your own address — you would just be paying gas to move USDC to
+              yourself.
+            </Callout>
+          )}
+          {recipient.status === 'ok' && recipient.isContract && !isSelfSend && (
+            <Callout tone="warning">
+              The recipient is a smart contract. Make sure it can receive and move{' '}
+              {USDC_SYMBOL}, otherwise the payment may be stuck permanently.
+            </Callout>
+          )}
+
+          {/* Gas */}
+          {noEth ? (
+            <Callout tone="danger">
+              You have no ETH. Ethereum transactions are paid for in ETH, so you need
+              some before you can send {USDC_SYMBOL}.
+            </Callout>
+          ) : lowEth ? (
+            <Callout tone="warning">
+              Your ETH balance may not cover the network fee for this transfer.
+            </Callout>
+          ) : null}
+
+          {/* Review */}
+          {detailsComplete && (
+            <dl className="flex flex-col gap-2 border-t border-line pt-4 text-[13px]">
+              <div className="flex items-center justify-between">
+                <dt className="text-ink-muted">Est. network fee</dt>
+                <dd className="font-mono tabular-nums">
+                  {gas.feeWei !== undefined ? (
+                    `~${formatEth(gas.feeWei, 5)} ETH`
+                  ) : gas.isLoading ? (
+                    <Spinner className="size-3.5 text-ink-muted" />
+                  ) : (
+                    '—'
+                  )}
+                </dd>
+              </div>
+              <div className="flex items-center justify-between">
+                <dt className="text-ink-muted">{USDC_SYMBOL} balance after</dt>
+                <dd className="font-mono tabular-nums">
+                  {usdcBalance !== undefined && amountValue !== undefined && decimals !== undefined
+                    ? `${formatTokenAmount(usdcBalance - amountValue, decimals, 2)} ${USDC_SYMBOL}`
+                    : '—'}
+                </dd>
+              </div>
+            </dl>
+          )}
+
+          {simulation.error && canPrepare && (
+            <Callout tone="danger">
+              <p className="font-medium">This transfer would fail</p>
+              <p className="mt-1">{toFriendlyError(simulation.error)}</p>
+            </Callout>
+          )}
+
+          {writeError && <Callout tone="danger">{toFriendlyError(writeError)}</Callout>}
+
+          <Button
+            type="submit"
+            disabled={!canPrepare || !simulation.data || simulation.isLoading || isSigning}
+          >
+            {isSigning ? (
+              <>
+                <Spinner className="size-4" />
+                Confirm in wallet
+              </>
+            ) : simulation.isLoading && canPrepare ? (
+              <>
+                <Spinner className="size-4" />
+                Checking transfer
+              </>
+            ) : detailsComplete && formattedAmount ? (
+              `Send ${formattedAmount} ${USDC_SYMBOL}`
+            ) : (
+              'Enter payment details'
+            )}
+          </Button>
+        </form>
+      )}
+    </div>
+  )
+}
