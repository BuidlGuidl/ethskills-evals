@@ -0,0 +1,51 @@
+import { parseUnits } from "viem";
+
+export type AmountParseResult =
+  | { ok: true; value: bigint }
+  | { ok: false; reason: string };
+
+/**
+ * Parse a human-typed token amount into base units for the given decimals.
+ *
+ * Rejects anything `parseUnits` would silently mangle — empty strings, junk,
+ * negatives, and (critically for a 6-decimal token) more fractional digits
+ * than the token supports. We check precision explicitly rather than letting
+ * `parseUnits` round, because silently rounding a user's payment is worse than
+ * telling them to fix it.
+ */
+export function parseTokenAmount(
+  input: string,
+  decimals: number,
+): AmountParseResult {
+  const trimmed = input.trim();
+
+  if (trimmed === "") {
+    return { ok: false, reason: "Enter an amount." };
+  }
+
+  // Plain decimal number only: digits, optional single dot, digits.
+  if (!/^\d*\.?\d*$/.test(trimmed) || trimmed === ".") {
+    return { ok: false, reason: "Enter a valid number." };
+  }
+
+  const [, fraction = ""] = trimmed.split(".");
+  if (fraction.length > decimals) {
+    return {
+      ok: false,
+      reason: `USDC supports at most ${decimals} decimal places.`,
+    };
+  }
+
+  let value: bigint;
+  try {
+    value = parseUnits(trimmed, decimals);
+  } catch {
+    return { ok: false, reason: "Enter a valid number." };
+  }
+
+  if (value <= 0n) {
+    return { ok: false, reason: "Amount must be greater than zero." };
+  }
+
+  return { ok: true, value };
+}
