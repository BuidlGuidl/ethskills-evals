+import { getDefaultConfig } from "@rainbow-me/rainbowkit";
+import { http } from "wagmi";
+import { mainnet } from "wagmi/chains";
+
+/**
+ * WalletConnect requires a project id. We fall back to a throwaway value in
+ * development so the app boots, but a real id must be set for production so
+ * that WalletConnect-based wallets (mobile, etc.) work.
+ */
+const projectId =
+  process.env.NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID ?? "DEV_PLACEHOLDER";
+
+const mainnetRpcUrl = process.env.NEXT_PUBLIC_MAINNET_RPC_URL;
+
+export const wagmiConfig = getDefaultConfig({
+  appName: "USDC Pay",
+  projectId,
+  chains: [mainnet],
+  transports: {
+    // Use the dedicated RPC when provided; otherwise viem's default public RPC.
+    [mainnet.id]: http(mainnetRpcUrl),
+  },
+  ssr: true,
+});
