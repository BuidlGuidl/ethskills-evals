+"use client";
+
+import { useAccount, useBalance, useReadContract } from "wagmi";
+
+import { USDC_ADDRESS, USDC_CHAIN_ID, usdcAbi } from "@/lib/usdc";
+
+/**
+ * Reads the connected account's USDC and native ETH balances on mainnet.
+ * Both refetch automatically as new blocks arrive (`watch`) and expose the
+ * raw bigint value plus loading/refetch handles so the UI can react.
+ */
+export function useBalances() {
+  const { address } = useAccount();
+
+  const usdc = useReadContract({
+    address: USDC_ADDRESS,
+    abi: usdcAbi,
+    functionName: "balanceOf",
+    args: address ? [address] : undefined,
+    chainId: USDC_CHAIN_ID,
+    query: {
+      enabled: Boolean(address),
+    },
+  });
+
+  const eth = useBalance({
+    address,
+    chainId: USDC_CHAIN_ID,
+    query: {
+      enabled: Boolean(address),
+    },
+  });
+
+  return {
+    usdc: {
+      value: usdc.data as bigint | undefined,
+      isLoading: usdc.isLoading,
+      isError: usdc.isError,
+      refetch: usdc.refetch,
+    },
+    eth: {
+      value: eth.data?.value,
+      symbol: eth.data?.symbol ?? "ETH",
+      decimals: eth.data?.decimals ?? 18,
+      isLoading: eth.isLoading,
+      isError: eth.isError,
+      refetch: eth.refetch,
+    },
+  };
+}
