+import { erc20Abi, getAddress } from "viem";
+import { mainnet } from "wagmi/chains";
+
+/**
+ * Canonical USDC (Circle) contract on Ethereum mainnet.
+ * https://etherscan.io/token/0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
+ *
+ * `getAddress` returns the checksummed form and throws at build/import time
+ * if the literal is ever mistyped.
+ */
+export const USDC_ADDRESS = getAddress(
+  "0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48",
+);
+
+/**
+ * USDC uses 6 decimals, NOT the 18 that ETH and most ERC-20s use.
+ * Every amount conversion in the app must go through this constant.
+ */
+export const USDC_DECIMALS = 6;
+
+export const USDC_SYMBOL = "USDC";
+
+/** USDC only lives on mainnet in this app. */
+export const USDC_CHAIN_ID = mainnet.id;
+
+/**
+ * The standard ERC-20 ABI ships with viem. USDC is a fully compliant ERC-20
+ * for the read (`balanceOf`) and write (`transfer`) calls we make, so there's
+ * no need to hand-roll or paste a bespoke ABI.
+ */
+export const usdcAbi = erc20Abi;
