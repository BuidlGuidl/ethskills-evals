diff --git a/src/components/PayForm.tsx b/src/components/PayForm.tsx
new file mode 100644
index 0000000..467648a
--- /dev/null
+++ b/src/components/PayForm.tsx
@@ -0,0 +1,433 @@
+"use client";
+
+import { useEffect, useMemo, useState } from "react";
+import {
+  BaseError,
+  getAddress,
+  isAddress,
+  UserRejectedRequestError,
+  type Address,
+} from "viem";
+import {
+  useAccount,
+  useSwitchChain,
+  useWaitForTransactionReceipt,
+  useWriteContract,
+} from "wagmi";
+
+import { useBalances } from "@/hooks/useBalances";
+import { parseTokenAmount } from "@/lib/amount";
+import { formatTokenAmount, shortenAddress } from "@/lib/format";
+import {
+  USDC_ADDRESS,
+  USDC_CHAIN_ID,
+  USDC_DECIMALS,
+  USDC_SYMBOL,
+  usdcAbi,
+} from "@/lib/usdc";
+
+const ZERO_ADDRESS = "0x0000000000000000000000000000000000000000";
+
+/** Validate + normalize a recipient address string typed by the user. */
+function validateRecipient(
+  input: string,
+  self: Address | undefined,
+): {
+  address?: Address;
+  error?: string;
+  warning?: string;
+} {
+  const trimmed = input.trim();
+  if (trimmed === "") return {};
+
+  if (!isAddress(trimmed, { strict: false })) {
+    return { error: "That doesn't look like a valid Ethereum address." };
+  }
+
+  // getAddress checksums the value and throws if a mixed-case address fails
+  // its checksum — a strong signal of a typo/corrupted paste.
+  let address: Address;
+  try {
+    address = getAddress(trimmed);
+  } catch {
+    return {
+      error: "Address checksum is invalid — double-check you copied it right.",
+    };
+  }
+
+  if (address === ZERO_ADDRESS) {
+    return { error: "You can't send to the zero address." };
+  }
+  if (address.toLowerCase() === USDC_ADDRESS.toLowerCase()) {
+    return {
+      error:
+        "That's the USDC token contract. Sending USDC there would burn it — use the recipient's wallet address.",
+    };
+  }
+  if (self && address.toLowerCase() === self.toLowerCase()) {
+    return { address, warning: "This is your own connected address." };
+  }
+
+  return { address };
+}
+
+function explainError(err: unknown): string {
+  if (err instanceof BaseError) {
+    if (err.walk((e) => e instanceof UserRejectedRequestError)) {
+      return "You rejected the request in your wallet.";
+    }
+    return err.shortMessage || err.message;
+  }
+  if (err instanceof Error) return err.message;
+  return "Something went wrong. Please try again.";
+}
+
+export function PayForm() {
+  const { address, chainId } = useAccount();
+  const { switchChain, isPending: isSwitching } = useSwitchChain();
+  const { usdc, eth } = useBalances();
+
+  const [recipient, setRecipient] = useState("");
+  const [amount, setAmount] = useState("");
+
+  const {
+    data: hash,
+    writeContract,
+    isPending: isSigning,
+    error: writeError,
+    reset: resetWrite,
+  } = useWriteContract();
+
+  const {
+    isLoading: isConfirming,
+    isSuccess: isConfirmed,
+    error: receiptError,
+  } = useWaitForTransactionReceipt({ hash });
+
+  // Refresh balances once the transfer confirms.
+  useEffect(() => {
+    if (isConfirmed) {
+      usdc.refetch();
+      eth.refetch();
+    }
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [isConfirmed]);
+
+  const onWrongChain = Boolean(address) && chainId !== USDC_CHAIN_ID;
+
+  const recipientCheck = useMemo(
+    () => validateRecipient(recipient, address),
+    [recipient, address],
+  );
+
+  const amountCheck = useMemo(
+    () => parseTokenAmount(amount, USDC_DECIMALS),
+    [amount],
+  );
+
+  const overBalance =
+    amountCheck.ok &&
+    usdc.value !== undefined &&
+    amountCheck.value > usdc.value;
+
+  const noGas = eth.value === 0n;
+
+  // Only surface field errors once the user has typed something.
+  const recipientError = recipient.trim() ? recipientCheck.error : undefined;
+  const amountError = amount.trim()
+    ? !amountCheck.ok
+      ? amountCheck.reason
+      : overBalance
+        ? "Amount exceeds your USDC balance."
+        : undefined
+    : undefined;
+
+  const isBusy = isSigning || isConfirming;
+
+  const canSubmit =
+    !isBusy &&
+    !onWrongChain &&
+    Boolean(recipientCheck.address) &&
+    !recipientCheck.error &&
+    amountCheck.ok &&
+    !overBalance &&
+    !noGas;
+
+  function handleMax() {
+    if (usdc.value !== undefined) {
+      // Full-precision string so we send the exact balance, not a rounded view.
+      setAmount(formatUnitsExact(usdc.value, USDC_DECIMALS));
+    }
+  }
+
+  function handleSubmit(e: React.FormEvent) {
+    e.preventDefault();
+    if (!canSubmit || !recipientCheck.address || !amountCheck.ok) return;
+
+    writeContract({
+      address: USDC_ADDRESS,
+      abi: usdcAbi,
+      functionName: "transfer",
+      args: [recipientCheck.address, amountCheck.value],
+      chainId: USDC_CHAIN_ID,
+    });
+  }
+
+  function handleReset() {
+    setRecipient("");
+    setAmount("");
+    resetWrite();
+  }
+
+  const txError = writeError ?? receiptError;
+
+  return (
+    <div className="card">
+      <h2 className="card-title">Send USDC</h2>
+      <p className="card-subtitle">Transfer USDC to any Ethereum address.</p>
+
+      {onWrongChain ? (
+        <div className="alert alert-warn" role="alert">
+          <div className="alert-title">Wrong network</div>
+          <p style={{ margin: "0 0 12px" }}>
+            USDC lives on Ethereum mainnet. Switch your wallet to continue.
+          </p>
+          <button
+            type="button"
+            className="btn btn-primary"
+            onClick={() => switchChain({ chainId: USDC_CHAIN_ID })}
+            disabled={isSwitching}
+          >
+            {isSwitching ? (
+              <>
+                <span className="spinner" />
+                Switching…
+              </>
+            ) : (
+              "Switch to Ethereum mainnet"
+            )}
+          </button>
+        </div>
+      ) : (
+        <form onSubmit={handleSubmit} noValidate>
+          <div className="field">
+            <label className="field-label" htmlFor="recipient">
+              Recipient address
+            </label>
+            <div className="input-wrap">
+              <input
+                id="recipient"
+                className={`input ${recipientError ? "invalid" : ""}`}
+                type="text"
+                inputMode="text"
+                autoComplete="off"
+                spellCheck={false}
+                placeholder="0x…"
+                value={recipient}
+                onChange={(e) => setRecipient(e.target.value)}
+                disabled={isBusy}
+                aria-invalid={Boolean(recipientError)}
+                aria-describedby={
+                  recipientError ? "recipient-error" : undefined
+                }
+              />
+            </div>
+            {recipientError && (
+              <div className="field-error" id="recipient-error" role="alert">
+                {recipientError}
+              </div>
+            )}
+            {!recipientError && recipientCheck.warning && (
+              <div className="field-hint" style={{ marginTop: 7 }}>
+                {recipientCheck.warning}
+              </div>
+            )}
+          </div>
+
+          <div className="field">
+            <div className="field-label">
+              <label htmlFor="amount">Amount</label>
+              <span className="field-hint">
+                Balance:{" "}
+                {usdc.value !== undefined
+                  ? formatTokenAmount(usdc.value, USDC_DECIMALS, 2)
+                  : "0"}{" "}
+                {USDC_SYMBOL}
+                {usdc.value !== undefined && usdc.value > 0n && (
+                  <>
+                    {" · "}
+                    <button
+                      type="button"
+                      className="max-btn"
+                      onClick={handleMax}
+                      disabled={isBusy}
+                    >
+                      Max
+                    </button>
+                  </>
+                )}
+              </span>
+            </div>
+            <div className="input-wrap">
+              <input
+                id="amount"
+                className={`input ${amountError ? "invalid" : ""}`}
+                type="text"
+                inputMode="decimal"
+                autoComplete="off"
+                placeholder="0.00"
+                value={amount}
+                onChange={(e) => setAmount(e.target.value)}
+                disabled={isBusy}
+                aria-invalid={Boolean(amountError)}
+                aria-describedby={amountError ? "amount-error" : undefined}
+                style={{ paddingRight: 64 }}
+              />
+              <span className="input-suffix">{USDC_SYMBOL}</span>
+            </div>
+            {amountError && (
+              <div className="field-error" id="amount-error" role="alert">
+                {amountError}
+              </div>
+            )}
+          </div>
+
+          {noGas && usdc.value !== undefined && usdc.value > 0n && (
+            <div className="alert alert-warn" role="status">
+              You need some ETH to pay the gas fee before you can send.
+            </div>
+          )}
+
+          <button type="submit" className="btn btn-primary" disabled={!canSubmit}>
+            {isSigning ? (
+              <>
+                <span className="spinner" />
+                Confirm in your wallet…
+              </>
+            ) : isConfirming ? (
+              <>
+                <span className="spinner" />
+                Sending…
+              </>
+            ) : recipientCheck.address && amountCheck.ok ? (
+              `Send ${formatTokenAmount(amountCheck.value, USDC_DECIMALS, 2)} ${USDC_SYMBOL}`
+            ) : (
+              "Send USDC"
+            )}
+          </button>
+        </form>
+      )}
+
+      <TxStatus
+        hash={hash}
+        isConfirming={isConfirming}
+        isConfirmed={isConfirmed}
+        error={txError}
+        recipient={recipientCheck.address}
+        amount={amountCheck.ok ? amountCheck.value : undefined}
+        onReset={handleReset}
+        explain={explainError}
+      />
+    </div>
+  );
+}
+
+function TxStatus({
+  hash,
+  isConfirming,
+  isConfirmed,
+  error,
+  recipient,
+  amount,
+  onReset,
+  explain,
+}: {
+  hash: `0x${string}` | undefined;
+  isConfirming: boolean;
+  isConfirmed: boolean;
+  error: unknown;
+  recipient: Address | undefined;
+  amount: bigint | undefined;
+  onReset: () => void;
+  explain: (err: unknown) => string;
+}) {
+  if (error) {
+    return (
+      <div className="alert alert-danger" role="alert">
+        <div className="alert-title">Transaction failed</div>
+        {explain(error)}
+        {hash && (
+          <div style={{ marginTop: 8 }}>
+            <EtherscanLink hash={hash} />
+          </div>
+        )}
+      </div>
+    );
+  }
+
+  if (isConfirmed && hash) {
+    return (
+      <div className="alert alert-success" role="status">
+        <div className="alert-title">Payment sent ✓</div>
+        {amount !== undefined && recipient ? (
+          <>
+            Sent {formatTokenAmount(amount, USDC_DECIMALS, 2)} {USDC_SYMBOL} to{" "}
+            {shortenAddress(recipient)}.
+          </>
+        ) : (
+          "Your USDC transfer is confirmed."
+        )}
+        <div style={{ marginTop: 8, display: "flex", gap: 16 }}>
+          <EtherscanLink hash={hash} />
+          <button
+            type="button"
+            className="max-btn"
+            onClick={onReset}
+            style={{ color: "var(--success)" }}
+          >
+            Send another
+          </button>
+        </div>
+      </div>
+    );
+  }
+
+  if (isConfirming && hash) {
+    return (
+      <div className="alert alert-info" role="status">
+        <div className="alert-title">Waiting for confirmation…</div>
+        Your transaction is on-chain and being confirmed.
+        <div style={{ marginTop: 8 }}>
+          <EtherscanLink hash={hash} />
+        </div>
+      </div>
+    );
+  }
+
+  return null;
+}
+
+function EtherscanLink({ hash }: { hash: `0x${string}` }) {
+  return (
+    <a
+      href={`https://etherscan.io/tx/${hash}`}
+      target="_blank"
+      rel="noopener noreferrer"
+    >
+      View on Etherscan ↗
+    </a>
+  );
+}
+
+/**
+ * Exact, non-grouped decimal string for a bigint amount — used to prefill the
+ * amount input from "Max" so the sent value equals the balance to the wei.
+ */
+function formatUnitsExact(value: bigint, decimals: number): string {
+  const base = 10n ** BigInt(decimals);
+  const whole = value / base;
+  const fraction = value % base;
+  if (fraction === 0n) return whole.toString();
+  const fractionStr = fraction.toString().padStart(decimals, "0").replace(/0+$/, "");
+  return `${whole}.${fractionStr}`;
+}
