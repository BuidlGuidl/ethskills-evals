@@ -0,0 +1,25 @@
+/** @type {import('next').NextConfig} */
+const nextConfig = {
+  reactStrictMode: true,
+  // Silence the multi-lockfile root inference warning (this workspace lives
+  // inside a larger monorepo checkout).
+  outputFileTracingRoot: import.meta.dirname,
+  webpack: (config, { webpack }) => {
+    // Optional/lazy dependencies of wallet SDKs that are only exercised in
+    // environments we don't target (Solana x402 payments, node-only logging).
+    // Webpack resolves imports statically and fails on them, so we stub the
+    // whole `@x402/*` scope and mark the node-only extras as empty.
+    config.externals.push("pino-pretty", "lokijs", "encoding");
+    config.plugins.push(
+      new webpack.IgnorePlugin({ resourceRegExp: /^@x402\// }),
+    );
+    // React Native storage shim pulled in by the MetaMask SDK; unused on web.
+    config.resolve.alias = {
+      ...config.resolve.alias,
+      "@react-native-async-storage/async-storage": false,
+    };
+    return config;
+  },
+};
+
+export default nextConfig;
