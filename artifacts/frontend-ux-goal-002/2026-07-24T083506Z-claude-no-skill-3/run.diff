@@ -0,0 +1,130 @@
+"use client";
+
+import { formatUnits } from "viem";
+
+import { useBalances } from "@/hooks/useBalances";
+import { formatTokenAmount } from "@/lib/format";
+import { USDC_DECIMALS, USDC_SYMBOL } from "@/lib/usdc";
+
+function BalanceTile({
+  label,
+  icon,
+  value,
+  unit,
+  isLoading,
+  isError,
+}: {
+  label: string;
+  icon: React.ReactNode;
+  value: string | null;
+  unit: string;
+  isLoading: boolean;
+  isError: boolean;
+}) {
+  return (
+    <div className="balance-tile">
+      <div className="balance-label">
+        {icon}
+        {label}
+      </div>
+      <div className="balance-value">
+        {isLoading ? (
+          <span className="skeleton" aria-hidden />
+        ) : isError ? (
+          <span className="muted" style={{ fontSize: 14, fontWeight: 500 }}>
+            Unavailable
+          </span>
+        ) : (
+          <>
+            {value}
+            <span className="balance-unit">{unit}</span>
+          </>
+        )}
+      </div>
+    </div>
+  );
+}
+
+export function BalancesCard() {
+  const { usdc, eth } = useBalances();
+
+  return (
+    <div className="card">
+      <h2 className="card-title">Your balances</h2>
+      <p className="card-subtitle">On Ethereum mainnet.</p>
+      <div className="balances">
+        <BalanceTile
+          label="USDC"
+          icon={<UsdcIcon />}
+          value={
+            usdc.value !== undefined
+              ? formatTokenAmount(usdc.value, USDC_DECIMALS, 2)
+              : "0"
+          }
+          unit={USDC_SYMBOL}
+          isLoading={usdc.isLoading}
+          isError={usdc.isError}
+        />
+        <BalanceTile
+          label="ETH (for gas)"
+          icon={<EthIcon />}
+          value={
+            eth.value !== undefined
+              ? formatTokenAmount(eth.value, eth.decimals, 4)
+              : "0"
+          }
+          unit={eth.symbol}
+          isLoading={eth.isLoading}
+          isError={eth.isError}
+        />
+      </div>
+      {eth.value === 0n && (
+        <div className="alert alert-warn" role="status">
+          <div className="alert-title">No ETH for gas</div>
+          You have USDC but need a little ETH to pay the network fee for a
+          transfer.
+        </div>
+      )}
+    </div>
+  );
+}
+
+function UsdcIcon() {
+  return (
+    <span
+      style={{
+        width: 16,
+        height: 16,
+        borderRadius: "50%",
+        background: "var(--usdc)",
+        color: "#fff",
+        display: "inline-grid",
