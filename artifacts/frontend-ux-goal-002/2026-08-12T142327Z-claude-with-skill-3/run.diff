+"use client";
+
+import type { Recipient } from "@/hooks/useRecipient";
+import { addressUrl } from "@/lib/config";
+import { Spinner } from "./ui";
+
+const inputClass =
+  "w-full rounded-xl border border-border bg-bg px-3.5 py-3 font-mono text-sm text-fg placeholder:font-sans placeholder:text-fg-subtle focus:border-accent focus:outline-none focus:ring-2 focus:ring-ring/30 disabled:opacity-60";
+
+function ResolvedRow({ recipient }: { recipient: Extract<Recipient, { status: "resolved" }> }) {
+  const { address, ensName, ensAvatar, enteredAs } = recipient;
+
+  return (
+    <div className="flex items-center gap-2 text-xs">
+      {ensAvatar ? (
+        // ENS avatars are arbitrary user-supplied URLs, so they skip the image optimizer.
+        // eslint-disable-next-line @next/next/no-img-element
+        <img
+          src={ensAvatar}
+          alt=""
+          className="h-5 w-5 shrink-0 rounded-full object-cover"
+        />
+      ) : null}
+
+      <span className="text-fg-muted">
+        {enteredAs === "name" ? "Resolves to" : ensName ? "Known as" : "Sending to"}
+      </span>
+
+      {enteredAs === "address" && ensName ? (
+        <span className="font-medium text-fg">{ensName}</span>
+      ) : (
+        <a
+          href={addressUrl(address)}
+          target="_blank"
+          rel="noopener noreferrer"
+          className="truncate font-mono text-fg underline decoration-border underline-offset-2 hover:decoration-accent"
+          title={address}
+        >
+          {address}
+        </a>
+      )}
+    </div>
+  );
+}
+
+export function RecipientField({
+  value,
+  onChange,
+  recipient,
+  disabled,
+  warning,
+  blocked,
+}: {
+  value: string;
+  onChange: (value: string) => void;
+  recipient: Recipient;
+  disabled?: boolean;
+  /** Non-blocking caution, e.g. paying yourself. */
+  warning?: string;
+  /** Hard stop that overrides the resolved-address confirmation. */
+  blocked?: string;
+}) {
+  const invalid = recipient.status === "invalid";
+  const describedBy = "recipient-status";
+
+  return (
+    <div className="space-y-2">
+      <label
+        htmlFor="recipient"
+        className="block text-sm font-medium text-fg"
+      >
+        Recipient
+      </label>
+
+      <input
+        id="recipient"
+        name="recipient"
+        value={value}
+        onChange={(event) => onChange(event.target.value)}
+        disabled={disabled}
+        placeholder="0x… or name.eth"
+        autoComplete="off"
+        autoCorrect="off"
+        spellCheck={false}
+        aria-invalid={invalid || Boolean(blocked)}
+        aria-describedby={describedBy}
+        className={`${inputClass} ${
+          invalid || blocked ? "border-danger focus:border-danger focus:ring-danger/25" : ""
+        }`}
+      />
+
+      <div id={describedBy} className="min-h-[1.25rem]" aria-live="polite">
+        {blocked ? (
+          <p className="text-xs text-danger">{blocked}</p>
+        ) : recipient.status === "resolving" ? (
+          <p className="flex items-center gap-1.5 text-xs text-fg-muted">
+            <Spinner className="h-3.5 w-3.5" />
+            Resolving {recipient.name} on ENS…
+          </p>
+        ) : recipient.status === "invalid" ? (
+          <p className="text-xs text-danger">{recipient.message}</p>
+        ) : recipient.status === "resolved" ? (
+          <div className="space-y-1">
+            <ResolvedRow recipient={recipient} />
+            {warning ? <p className="text-xs text-warning">{warning}</p> : null}
+          </div>
+        ) : (
+          <p className="text-xs text-fg-subtle">
+            Paste an address or type an ENS name — we resolve it before you sign.
+          </p>
+        )}
+      </div>
+    </div>
+  );
+}
