+++ b/src/components/FiatValue.tsx
@@ -0,0 +1,62 @@
+"use client";
+
+import type { Quote } from "@/hooks/usePrices";
+import { formatUsd, usdValue } from "@/lib/format";
+import { Skeleton } from "./ui";
+
+const relative = new Intl.RelativeTimeFormat("en", { numeric: "auto" });
+
+function ago(seconds: number): string {
+  const minutes = Math.round(seconds / 60);
+  if (minutes < 60) return relative.format(-minutes, "minute");
+  const hours = Math.round(minutes / 60);
+  if (hours < 24) return relative.format(-hours, "hour");
+  return relative.format(-Math.round(hours / 24), "day");
+}
+
+/**
+ * The USD value of a token amount. A missing or stale quote is labelled rather
+ * than quietly omitted — a number with no dollar value beside it reads as
+ * "this is free", and a stale one reads as current.
+ */
+export function FiatValue({
+  amount,
+  decimals,
+  quote,
+  isLoading,
+  className = "",
+}: {
+  amount?: bigint;
+  decimals: number;
+  quote?: Quote;
+  isLoading?: boolean;
+  className?: string;
+}) {
+  if (amount === undefined || isLoading) {
+    return <Skeleton className={`h-3.5 w-16 ${className}`} />;
+  }
+
+  if (!quote) {
+    return (
+      <span className={`text-fg-subtle ${className}`}>
+        USD price unavailable
+      </span>
+    );
+  }
+
+  const value = formatUsd(usdValue(amount, decimals, quote.priceE8));
+
+  if (quote.isStale) {
+    const age = ago(quote.ageSeconds ?? 0);
+    return (
+      <span
+        className={`text-warning ${className}`}
+        title={`Chainlink last updated this feed ${age}`}
+      >
+        ≈ {value} · stale price ({age})
+      </span>
+    );
+  }
+
+  return <span className={`text-fg-muted ${className}`}>≈ {value}</span>;
+}
