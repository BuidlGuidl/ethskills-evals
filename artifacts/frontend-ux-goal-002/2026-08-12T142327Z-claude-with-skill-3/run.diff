+"use client";
+
+import type { Quote } from "@/hooks/usePrices";
+import { USDC } from "@/lib/config";
+import { formatAmount } from "@/lib/format";
+import { FiatValue } from "./FiatValue";
+
+export function AmountField({
+  value,
+  onChange,
+  onMax,
+  balance,
+  parsedValue,
+  quote,
+  quoteLoading,
+  error,
+  disabled,
+}: {
+  value: string;
+  onChange: (value: string) => void;
+  onMax: () => void;
+  balance?: bigint;
+  /** Base units, present only when the input parses cleanly. */
+  parsedValue?: bigint;
+  quote?: Quote;
+  quoteLoading?: boolean;
+  error?: string;
+  disabled?: boolean;
+}) {
+  return (
+    <div className="space-y-2">
+      <div className="flex items-baseline justify-between gap-2">
+        <label htmlFor="amount" className="block text-sm font-medium text-fg">
+          Amount
+        </label>
+
+        <div className="flex items-baseline gap-2 text-xs text-fg-muted">
+          <span>
+            Balance:{" "}
+            {balance === undefined
+              ? "—"
+              : `${formatAmount(balance, USDC.decimals, {
+                  maxFraction: 2,
+                  minFraction: 2,
+                })} ${USDC.symbol}`}
+          </span>
+          <button
+            type="button"
+            onClick={onMax}
+            disabled={disabled || balance === undefined || balance === 0n}
+            className="rounded-md bg-accent-subtle px-1.5 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-accent disabled:opacity-40"
+          >
+            Max
+          </button>
+        </div>
+      </div>
+
+      <div
+        className={`flex items-center rounded-xl border bg-bg pr-3.5 focus-within:ring-2 focus-within:ring-ring/30 ${
+          error ? "border-danger focus-within:ring-danger/25" : "border-border focus-within:border-accent"
+        }`}
+      >
+        <input
+          id="amount"
+          name="amount"
+          value={value}
+          onChange={(event) => onChange(event.target.value)}
+          disabled={disabled}
+          inputMode="decimal"
+          autoComplete="off"
+          placeholder="0.00"
+          aria-invalid={Boolean(error)}
+          aria-describedby="amount-status"
+          className="w-full bg-transparent px-3.5 py-3 font-mono text-lg tabular-nums text-fg placeholder:text-fg-subtle focus:outline-none disabled:opacity-60"
+        />
+        <span className="shrink-0 text-sm font-medium text-fg-muted">
+          {USDC.symbol}
+        </span>
+      </div>
+
+      <div id="amount-status" className="min-h-[1.25rem] text-xs" aria-live="polite">
+        {error ? (
+          <p className="text-danger">{error}</p>
+        ) : parsedValue !== undefined ? (
+          <FiatValue
+            amount={parsedValue}
+            decimals={USDC.decimals}
+            quote={quote}
+            isLoading={quoteLoading}
+          />
+        ) : (
+          <span className="text-fg-subtle">
+            {USDC.symbol} settles in {USDC.decimals} decimal places.
+          </span>
+        )}
+      </div>
+    </div>
+  );
+}
