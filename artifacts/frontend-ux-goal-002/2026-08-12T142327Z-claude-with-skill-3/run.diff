+++ b/src/hooks/useBalances.ts
@@ -0,0 +1,46 @@
+"use client";
+
+import { useCallback } from "react";
+import { erc20Abi, type Address } from "viem";
+import { useBalance, useReadContract } from "wagmi";
+import { TARGET_CHAIN, USDC } from "@/lib/config";
+
+/**
+ * USDC and ETH balances for one account, always read on the target chain so the
+ * numbers stay correct even while the wallet sits on another network.
+ */
+export function useBalances(address?: Address) {
+  const enabled = Boolean(address);
+  const pollMs = 12_000;
+
+  const eth = useBalance({
+    address,
+    chainId: TARGET_CHAIN.id,
+    query: { enabled, refetchInterval: pollMs },
+  });
+
+  const usdc = useReadContract({
+    address: USDC.address,
+    abi: erc20Abi,
+    functionName: "balanceOf",
+    args: address ? [address] : undefined,
+    chainId: TARGET_CHAIN.id,
+    query: { enabled, refetchInterval: pollMs },
+  });
+
+  const { refetch: refetchEth } = eth;
+  const { refetch: refetchUsdc } = usdc;
+
+  /** Awaited by the send flow so the button stays busy until balances are truthful. */
+  const refetch = useCallback(async () => {
+    await Promise.all([refetchEth(), refetchUsdc()]);
+  }, [refetchEth, refetchUsdc]);
+
+  return {
+    ethBalance: eth.data?.value,
+    usdcBalance: usdc.data,
+    isLoading: eth.isLoading || usdc.isLoading,
+    isError: eth.isError || usdc.isError,
+    refetch,
+  };
+}
diff --git a/src/hooks/useNow.ts b/src/hooks/useNow.ts
new file mode 100644
index 0000000..0578f28
--- /dev/null
+++ b/src/hooks/useNow.ts
@@ -0,0 +1,22 @@
+"use client";
+
+import { useEffect, useState } from "react";
+
+/**
+ * Wall-clock seconds, ticking on an interval. Reading `Date.now()` during
+ * render would differ between the server pass and hydration, and would drift
+ * silently afterwards; this stays `undefined` until mounted so callers can
+ * withhold time-dependent claims (like "stale") rather than guess.
+ */
+export function useNow(intervalMs = 60_000): number | undefined {
+  const [now, setNow] = useState<number | undefined>(undefined);
+
+  useEffect(() => {
+    const tick = () => setNow(Date.now() / 1000);
+    tick();
+    const id = setInterval(tick, intervalMs);
+    return () => clearInterval(id);
+  }, [intervalMs]);
+
+  return now;
+}
diff --git a/src/hooks/usePrices.ts b/src/hooks/usePrices.ts
new file mode 100644
index 0000000..6adbeed
--- /dev/null
+++ b/src/hooks/usePrices.ts
@@ -0,0 +1,76 @@
+"use client";
+
+import { useReadContracts } from "wagmi";
+import { chainlinkAggregatorAbi } from "@/lib/abi";
+import { PRICE_FEEDS, TARGET_CHAIN } from "@/lib/config";
+import { useNow } from "./useNow";
+
+export type Quote = {
+  /** USD price with 8 decimals, as Chainlink reports it. */
+  priceE8: bigint;
+  updatedAt: number;
+  /** Seconds since the feed last updated; undefined before the clock mounts. */
+  ageSeconds?: number;
+  /** True when the feed has not updated within 2x its published heartbeat. */
+  isStale: boolean;
+};
+
+export type Prices = {
+  eth?: Quote;
+  usdc?: Quote;
+  isLoading: boolean;
+  isUnavailable: boolean;
+};
+
+const feeds = [PRICE_FEEDS.eth, PRICE_FEEDS.usdc] as const;
+
+/**
+ * USD quotes read straight from Chainlink on mainnet. No API key, no separate
+ * uptime story than the RPC the rest of the app already depends on.
+ */
+export function usePrices(): Prices {
+  const now = useNow();
+
+  const { data, isLoading, isError } = useReadContracts({
+    allowFailure: true,
+    contracts: feeds.map((feed) => ({
+      address: feed.address,
+      abi: chainlinkAggregatorAbi,
+      functionName: "latestRoundData" as const,
+      chainId: TARGET_CHAIN.id,
+    })),
+    query: {
+      // Prices move slower than blocks; a minute is plenty and keeps RPC load down.
+      refetchInterval: 60_000,
+      staleTime: 30_000,
+    },
+  });
+
+  const toQuote = (index: 0 | 1): Quote | undefined => {
+    const result = data?.[index];
+    if (!result || result.status !== "success") return undefined;
+    const [, answer, , updatedAt] = result.result;
+    if (answer <= 0n) return undefined;
+
+    const updated = Number(updatedAt);
+    const ageSeconds = now === undefined ? undefined : now - updated;
+    return {
+      priceE8: answer,
+      updatedAt: updated,
+      ageSeconds,
+      isStale:
+        ageSeconds !== undefined &&
+        ageSeconds > feeds[index].heartbeatSeconds * 2,
+    };
+  };
+
+  const eth = toQuote(0);
+  const usdc = toQuote(1);
+
+  return {
+    eth,
+    usdc,
+    isLoading,
+    isUnavailable: (isError || (!!data && !eth && !usdc)) && !isLoading,
+  };
+}
diff --git a/src/hooks/useRecipient.ts b/src/hooks/useRecipient.ts
new file mode 100644
index 0000000..4a7a75a
--- /dev/null
+++ b/src/hooks/useRecipient.ts
@@ -0,0 +1,136 @@
+"use client";
+
+import { useMemo } from "react";
+import { getAddress, isAddress, type Address } from "viem";
+import { normalize } from "viem/ens";
+import { useEnsAddress, useEnsAvatar, useEnsName } from "wagmi";
+import { TARGET_CHAIN } from "@/lib/config";
+
+export type Recipient =
+  | { status: "empty" }
+  | { status: "resolving"; name: string }
+  | { status: "invalid"; message: string }
+  | {
+      status: "resolved";
+      address: Address;
+      /** Set when the user typed a name, or when a typed address reverse-resolves. */
+      ensName?: string;
+      ensAvatar?: string;
+      /** What the user actually typed, so the UI can show "name → address". */
+      enteredAs: "address" | "name";
+    };
+
+const HEX_ADDRESS = /^0x[0-9a-fA-F]{40}$/;
+
+type Parsed =
+  | { kind: "empty" }
+  | { kind: "address"; address: Address }
+  | { kind: "name"; name: string }
+  | { kind: "invalid"; message: string };
+
+function parse(input: string): Parsed {
+  const value = input.trim();
+  if (!value) return { kind: "empty" };
+
+  if (value.startsWith("0x") || HEX_ADDRESS.test(value)) {
+    if (!HEX_ADDRESS.test(value)) {
+      return {
+        kind: "invalid",
+        message: "An Ethereum address is 0x followed by 40 hex characters.",
+      };
+    }
+    if (!isAddress(value)) {
+      return {
+        kind: "invalid",
+        message:
+          "That address fails its checksum — a character is likely mistyped. Copy it again from the source.",
+      };
+    }
+    return { kind: "address", address: getAddress(value) };
+  }
+
+  if (!value.includes(".")) {
+    return {
+      kind: "invalid",
+      message: "Enter an Ethereum address (0x…) or an ENS name (name.eth).",
+    };
+  }
+
+  try {
+    return { kind: "name", name: normalize(value) };
+  } catch {
+    return { kind: "invalid", message: `"${value}" isn't a usable ENS name.` };
+  }
+}
+
+/**
+ * Turns whatever the user typed into an address to submit. ENS names resolve on
+ * mainnet — the same chain the payment settles on — and every rejection returns
+ * a sentence explaining itself.
+ */
+export function useRecipient(input: string): Recipient {
+  const parsed = useMemo(() => parse(input), [input]);
+
+  const isName = parsed.kind === "name";
+  const isHex = parsed.kind === "address";
+
+  const forward = useEnsAddress({
+    name: isName ? parsed.name : undefined,
+    chainId: TARGET_CHAIN.id,
+    query: { enabled: isName },
+  });
+
+  // A pasted address is friendlier to confirm when we can name it back.
+  const reverse = useEnsName({
+    address: isHex ? parsed.address : undefined,
+    chainId: TARGET_CHAIN.id,
+    query: { enabled: isHex },
+  });
+
+  const displayName = isName ? parsed.name : reverse.data ?? undefined;
+
+  const avatar = useEnsAvatar({
+    name: displayName,
+    chainId: TARGET_CHAIN.id,
+    query: { enabled: Boolean(displayName) },
+  });
+
+  if (parsed.kind === "empty") return { status: "empty" };
+  if (parsed.kind === "invalid") {
+    return { status: "invalid", message: parsed.message };
+  }
+
+  if (parsed.kind === "address") {
+    return {
+      status: "resolved",
+      address: parsed.address,
+      ensName: reverse.data ?? undefined,
+      ensAvatar: avatar.data ?? undefined,
+      enteredAs: "address",
+    };
+  }
+
+  if (forward.isLoading) return { status: "resolving", name: parsed.name };
+
+  if (forward.isError) {
+    return {
+      status: "invalid",
+      message: "Couldn't reach ENS to resolve that name. Check your connection and retry.",
+    };
+  }
+
+  if (!forward.data) {
+    return {
+      status: "invalid",
+      message: `${parsed.name} doesn't have an Ethereum address set in ENS.`,
+    };
+  }
+
+  return {
+    status: "resolved",
+    address: forward.data,
+    ensName: parsed.name,
+    ensAvatar: avatar.data ?? undefined,
+    enteredAs: "name",
+  };
+}
