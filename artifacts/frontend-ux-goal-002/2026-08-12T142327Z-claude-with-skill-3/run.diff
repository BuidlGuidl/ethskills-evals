@@ -0,0 +1,72 @@
+"use client";
+
+import { useAccount } from "wagmi";
+import { useBalances } from "@/hooks/useBalances";
+import { usePrices } from "@/hooks/usePrices";
+import { RPC_URL, TARGET_CHAIN, USDC } from "@/lib/config";
+import { BalancePanel } from "./BalancePanel";
+import { PayForm } from "./PayForm";
+import { Card, Notice } from "./ui";
+
+export function PayView() {
+  const { address, isConnected, chainId } = useAccount();
+  const prices = usePrices();
+  const { usdcBalance, ethBalance, isError, refetch } = useBalances(address);
+
+  const wrongNetwork = isConnected && chainId !== TARGET_CHAIN.id;
+
+  return (
+    <div className="mx-auto w-full max-w-xl space-y-4 px-4 py-8 sm:py-12">
+      <div className="space-y-1.5">
+        <h1 className="text-2xl font-semibold tracking-tight">
+          Send {USDC.symbol}
+        </h1>
+        <p className="text-sm text-fg-muted">
+          Transfer {USDC.name} to any address or ENS name on{" "}
+          {TARGET_CHAIN.name}. Payflow never holds your funds — the transfer goes
+          straight from your wallet to theirs.
+        </p>
+      </div>
+
+      {wrongNetwork && (
+        <Notice tone="warning">
+          Your wallet is connected to a different network. Balances below are read
+          from {TARGET_CHAIN.name}; switch networks to send.
+        </Notice>
+      )}
+
+      {isConnected ? (
+        <BalancePanel
+          usdcBalance={usdcBalance}
+          ethBalance={ethBalance}
+          prices={prices}
+          isError={isError}
+        />
+      ) : (
+        <Card className="px-4 py-3.5 text-sm text-fg-muted">
+          Connect a wallet to see your {USDC.symbol} and {TARGET_CHAIN.nativeCurrency.symbol}{" "}
+          balances.
+        </Card>
+      )}
+
+      <PayForm
+        address={address}
+        isConnected={isConnected}
+        usdcBalance={usdcBalance}
+        ethBalance={ethBalance}
+        prices={prices}
+        refetchBalances={refetch}
+      />
+
+      {/* A deploy check for whoever is running the app, not a message for payers. */}
+      {!RPC_URL && process.env.NODE_ENV !== "production" && (
+        <Notice tone="warning">
+          No dedicated RPC is configured, so this build falls back to a public
+          endpoint that rate limits under load. Set{" "}
+          <code className="font-mono">NEXT_PUBLIC_MAINNET_RPC_URL</code> before
+          shipping.
+        </Notice>
+      )}
+    </div>
+  );
+}
diff --git a/src/components/Providers.tsx b/src/components/Providers.tsx
new file mode 100644
index 0000000..34fe2fa
--- /dev/null
+++ b/src/components/Providers.tsx
@@ -0,0 +1,68 @@
+"use client";
+
+import "@rainbow-me/rainbowkit/styles.css";
+
+import {
+  RainbowKitProvider,
+  darkTheme,
+  lightTheme,
+} from "@rainbow-me/rainbowkit";
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { useState, type ReactNode } from "react";
+import { WagmiProvider, cookieToInitialState } from "wagmi";
+import { APP_NAME, APP_URL } from "@/lib/config";
+import { config } from "@/lib/wagmi";
+
+const themeOverrides = {
+  fontStack: "system",
+  borderRadius: "medium",
+} as const;
+
+export function Providers({
+  children,
+  cookie,
+}: {
+  children: ReactNode;
+  /**
+   * The request's raw Cookie header. The wagmi config pulls in RainbowKit's
+   * client-only connector helpers, so it can't be imported from a server
+   * component — the cookie crosses the boundary as a string instead and the
+   * connection state is restored here, in the client graph, for both the SSR
+   * pass and hydration.
+   */
+  cookie?: string | null;
+}) {
+  const [initialState] = useState(() =>
+    cookieToInitialState(config, cookie ?? undefined),
+  );
+
+  const [queryClient] = useState(
+    () =>
+      new QueryClient({
+        defaultOptions: {
+          queries: {
+            retry: 2,
+            refetchOnWindowFocus: true,
+          },
+        },
+      }),
+  );
+
+  return (
+    <WagmiProvider config={config} initialState={initialState}>
+      <QueryClientProvider client={queryClient}>
+        <RainbowKitProvider
+          appInfo={{ appName: APP_NAME, learnMoreUrl: APP_URL }}
+          modalSize="compact"
+          // Follows the OS setting, matching the semantic tokens in globals.css.
+          theme={{
+            lightMode: lightTheme({ accentColor: "#1f6feb", ...themeOverrides }),
+            darkMode: darkTheme({ accentColor: "#4b8ffb", ...themeOverrides }),
+          }}
+        >
+          {children}
+        </RainbowKitProvider>
+      </QueryClientProvider>
+    </WagmiProvider>
+  );
+}
