diff --git a/src/components/PayForm.tsx b/src/components/PayForm.tsx
new file mode 100644
index 0000000..527b260
--- /dev/null
+++ b/src/components/PayForm.tsx
@@ -0,0 +1,416 @@
+"use client";
+
+import { useConnectModal } from "@rainbow-me/rainbowkit";
+import { useMemo, useState } from "react";
+import { encodeFunctionData, erc20Abi, zeroAddress, type Address } from "viem";
+import {
+  useChainId,
+  useEstimateFeesPerGas,
+  useEstimateGas,
+  usePublicClient,
+  useSwitchChain,
+  useWriteContract,
+} from "wagmi";
+import type { Prices } from "@/hooks/usePrices";
+import { useRecipient } from "@/hooks/useRecipient";
+import { parseAmount } from "@/lib/amount";
+import { NATIVE, TARGET_CHAIN, USDC, txUrl } from "@/lib/config";
+import { toUserMessage } from "@/lib/errors";
+import { formatAmount, formatUsd, usdValue } from "@/lib/format";
+import { AmountField } from "./AmountField";
+import { FiatValue } from "./FiatValue";
+import { RecipientField } from "./RecipientField";
+import { Card, Notice, Spinner } from "./ui";
+
+type Stage = "signing" | "broadcast" | "refreshing";
+
+type Sent = {
+  hash: `0x${string}`;
+  amount: bigint;
+  to: Address;
+  label: string;
+};
+
+const stageLabel: Record<Stage, string> = {
+  signing: "Confirm in your wallet…",
+  broadcast: "Sending…",
+  refreshing: "Updating balances…",
+};
+
+export function PayForm({
+  address,
+  isConnected,
+  usdcBalance,
+  ethBalance,
+  prices,
+  refetchBalances,
+}: {
+  address?: Address;
+  isConnected: boolean;
+  usdcBalance?: bigint;
+  ethBalance?: bigint;
+  prices: Prices;
+  refetchBalances: () => Promise<unknown>;
+}) {
+  const [recipientInput, setRecipientInput] = useState("");
+  const [amountInput, setAmountInput] = useState("");
+  const [stage, setStage] = useState<Stage | null>(null);
+  const [pendingHash, setPendingHash] = useState<`0x${string}` | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [sent, setSent] = useState<Sent | null>(null);
+
+  const chainId = useChainId();
+  const publicClient = usePublicClient({ chainId: TARGET_CHAIN.id });
+  const { writeContractAsync } = useWriteContract();
+  const { switchChainAsync, isPending: isSwitching } = useSwitchChain();
+  const { openConnectModal } = useConnectModal();
+
+  const busy = stage !== null;
+  const wrongNetwork = isConnected && chainId !== TARGET_CHAIN.id;
+
+  const recipient = useRecipient(recipientInput);
+  const to = recipient.status === "resolved" ? recipient.address : undefined;
+
+  // Two irrecoverable destinations worth refusing outright.
+  const recipientBlocked = useMemo(() => {
+    if (!to) return undefined;
+    if (to === zeroAddress) {
+      return "That's the zero address — anything sent there is burned.";
+    }
+    if (to.toLowerCase() === USDC.address.toLowerCase()) {
+      return `That's the ${USDC.symbol} token contract itself. Tokens sent there cannot be recovered.`;
+    }
+    return undefined;
+  }, [to]);
+
+  const recipientWarning =
+    to && address && to.toLowerCase() === address.toLowerCase()
+      ? "This is your own connected address — you'd be paying yourself and burning gas."
+      : undefined;
+
+  const parsed = useMemo(
+    () => parseAmount(amountInput, USDC.decimals, USDC.symbol),
+    [amountInput],
+  );
+  const amountValue = parsed.ok ? parsed.value : undefined;
+
+  const amountError = useMemo(() => {
+    if (!amountInput.trim()) return undefined;
+    if (!parsed.ok) return parsed.reason;
+    if (usdcBalance !== undefined && parsed.value > usdcBalance) {
+      return `That's more than your balance of ${formatAmount(usdcBalance, USDC.decimals, {
+        maxFraction: 2,
+        minFraction: 2,
+      })} ${USDC.symbol}.`;
+    }
+    return undefined;
+  }, [amountInput, parsed, usdcBalance]);
+
+  const amountReady = amountValue !== undefined && !amountError;
+  const canEstimate = Boolean(
+    isConnected && address && to && !recipientBlocked && amountReady,
+  );
+
+  const transferData = useMemo(
+    () =>
+      to && amountValue !== undefined
+        ? encodeFunctionData({
+            abi: erc20Abi,
+            functionName: "transfer",
+            args: [to, amountValue],
+          })
+        : undefined,
+    [to, amountValue],
+  );
+
+  const { data: gasLimit, error: gasError } = useEstimateGas({
+    chainId: TARGET_CHAIN.id,
+    account: address,
+    to: USDC.address,
+    data: transferData,
+    query: { enabled: canEstimate },
+  });
+
+  const { data: feeData } = useEstimateFeesPerGas({
+    chainId: TARGET_CHAIN.id,
+    query: { enabled: canEstimate, refetchInterval: 15_000 },
+  });
+
+  const networkFee =
+    gasLimit !== undefined && feeData?.maxFeePerGas !== undefined
+      ? gasLimit * feeData.maxFeePerGas
+      : undefined;
+
+  const cannotCoverGas =
+    ethBalance !== undefined &&
+    networkFee !== undefined &&
+    ethBalance < networkFee;
+
+  const noEth = isConnected && ethBalance === 0n;
+
+  const disabledReason = useMemo(() => {
+    if (recipient.status === "empty") return "Enter a recipient to continue.";
+    if (recipient.status === "resolving") return "Waiting for ENS to resolve the recipient.";
+    if (recipient.status === "invalid") return "Fix the recipient above to continue.";
+    // The detail is already spelled out under the field; don't repeat it here.
+    if (recipientBlocked) return "Choose a different recipient to continue.";
+    if (!amountInput.trim()) return "Enter an amount to continue.";
+    if (amountError) return "Fix the amount above to continue.";
+    if (noEth) {
+      return `This account holds no ${NATIVE.symbol}, so it can't pay the gas for an Ethereum transaction. Add ${NATIVE.symbol} and try again.`;
+    }
+    if (cannotCoverGas && networkFee !== undefined) {
+      return `The network fee is about ${formatAmount(networkFee, NATIVE.decimals, {
+        maxFraction: 7,
+      })} ${NATIVE.symbol}, more than this account holds.`;
+    }
+    return undefined;
+  }, [
+    recipient.status,
+    recipientBlocked,
+    amountInput,
+    amountError,
+    noEth,
+    cannotCoverGas,
+    networkFee,
+  ]);
+
+  async function handleSwitch() {
+    setError(null);
+    // Any error from here belongs to the switch, not to an earlier transfer.
+    setPendingHash(null);
+    try {
+      await switchChainAsync({ chainId: TARGET_CHAIN.id });
+    } catch (cause) {
+      setError(toUserMessage(cause));
+    }
+  }
+
+  async function handleSubmit(event: React.FormEvent) {
+    event.preventDefault();
+    if (!to || amountValue === undefined || !publicClient || busy) return;
+
+    setError(null);
+    setSent(null);
+    setPendingHash(null);
+    setStage("signing");
+
+    try {
+      const hash = await writeContractAsync({
+        address: USDC.address,
+        abi: erc20Abi,
+        functionName: "transfer",
+        args: [to, amountValue],
+        chainId: TARGET_CHAIN.id,
+      });
+
+      // isPending on the write hook clears here — but the money isn't moved yet,
+      // so the button stays busy through the receipt and the balance refetch.
+      setPendingHash(hash);
+      setStage("broadcast");
+
+      const receipt = await publicClient.waitForTransactionReceipt({ hash });
+      if (receipt.status === "reverted") {
+        setError(
+          "The transaction was mined but reverted, so no USDC moved. The gas was still spent.",
+        );
+        return;
+      }
+
+      setStage("refreshing");
+      await refetchBalances();
+
+      setSent({
+        hash,
+        amount: amountValue,
+        to,
+        label: recipient.status === "resolved" && recipient.ensName
+          ? recipient.ensName
+          : to,
+      });
+      setRecipientInput("");
+      setAmountInput("");
+    } catch (cause) {
+      setError(toUserMessage(cause));
+    } finally {
+      // Released here so a wallet rejection can never leave the button stuck.
+      // pendingHash is deliberately kept — a reverted transfer still has a
+      // receipt worth linking to. The next submit clears it.
+      setStage(null);
+    }
+  }
+
+  const primary = !isConnected
+    ? {
+        label: "Connect wallet",
+        onClick: openConnectModal,
+        type: "button" as const,
+        disabled: !openConnectModal,
+        pending: false,
+      }
+    : wrongNetwork
+      ? {
+          label: `Switch to ${TARGET_CHAIN.name}`,
+          onClick: handleSwitch,
+          type: "button" as const,
+          disabled: isSwitching,
+          pending: isSwitching,
+        }
+      : {
+          label: `Send ${USDC.symbol}`,
+          onClick: undefined,
+          type: "submit" as const,
+          disabled: busy || Boolean(disabledReason),
+          pending: busy,
+        };
+
+  const fieldsDisabled = busy;
+
+  return (
+    <Card className="p-4 sm:p-5">
+      <form onSubmit={handleSubmit} className="space-y-5" noValidate>
+        <RecipientField
+          value={recipientInput}
+          onChange={setRecipientInput}
+          recipient={recipient}
+          disabled={fieldsDisabled}
+          warning={recipientWarning}
+          blocked={recipientBlocked}
+        />
+
+        <AmountField
+          value={amountInput}
+          onChange={setAmountInput}
+          onMax={() =>
+            usdcBalance !== undefined &&
+            setAmountInput(
+              formatAmount(usdcBalance, USDC.decimals, {
+                maxFraction: USDC.decimals,
+              }).replace(/,/g, ""),
+            )
+          }
+          balance={usdcBalance}
+          parsedValue={amountReady ? amountValue : undefined}
+          quote={prices.usdc}
+          quoteLoading={prices.isLoading}
+          error={amountError}
+          disabled={fieldsDisabled}
+        />
+
+        {isConnected && (
+          <div className="flex items-center justify-between gap-3 rounded-xl bg-surface-muted px-3.5 py-2.5 text-xs">
+            <span className="text-fg-muted">Estimated network fee</span>
+            {networkFee !== undefined ? (
+              <span className="text-right">
+                <span className="font-mono tabular-nums text-fg">
+                  {/* Fees run several orders of magnitude below a balance, so
+                      they get more digits than the balance cards do. */}
+                  {formatAmount(networkFee, NATIVE.decimals, { maxFraction: 7 })}{" "}
+                  {NATIVE.symbol}
+                </span>
+                <FiatValue
+                  amount={networkFee}
+                  decimals={NATIVE.decimals}
+                  quote={prices.eth}
+                  isLoading={prices.isLoading}
+                  className="ml-1.5"
+                />
+              </span>
+            ) : gasError && canEstimate ? (
+              // Don't block on this — the wallet will give the real verdict at
+              // signing time — but don't leave the row silently blank either.
+              <span className="text-right text-warning">
+                Couldn&apos;t estimate: {toUserMessage(gasError)}
+              </span>
+            ) : (
+              <span className="text-fg-subtle">
+                {canEstimate ? "Estimating…" : "Fill in the form to estimate"}
+              </span>
+            )}
+          </div>
+        )}
+
+        <div className="space-y-2">
+          <button
+            type={primary.type}
+            onClick={primary.onClick}
+            disabled={primary.disabled}
+            className="flex w-full items-center justify-center gap-2 rounded-xl bg-accent px-4 py-3 text-sm font-semibold text-accent-fg transition-colors hover:bg-accent-hover focus:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-surface disabled:cursor-not-allowed disabled:opacity-50"
+          >
+            {primary.pending && <Spinner />}
+            {busy && stage ? stageLabel[stage] : primary.label}
+          </button>
+
+          {/* A disabled button always explains itself. */}
+          {isConnected && !wrongNetwork && !busy && disabledReason && (
+            <p className="text-center text-xs text-fg-subtle">{disabledReason}</p>
+          )}
+
+          {wrongNetwork && (
+            <p className="text-center text-xs text-fg-subtle">
+              {USDC.symbol} on {TARGET_CHAIN.name} is the only asset this app moves.
+            </p>
+          )}
+        </div>
+
+        {stage === "broadcast" && pendingHash && (
+          <Notice tone="info" role="status">
+            Waiting for confirmation on {TARGET_CHAIN.name}.{" "}
+            <a
+              href={txUrl(pendingHash)}
+              target="_blank"
+              rel="noopener noreferrer"
+              className="font-medium underline underline-offset-2"
+            >
+              View on Etherscan
+            </a>
+          </Notice>
+        )}
+
+        {error && (
+          <Notice tone="danger">
+            {error}
+            {pendingHash && (
+              <>
+                {" "}
+                <a
+                  href={txUrl(pendingHash)}
+                  target="_blank"
+                  rel="noopener noreferrer"
+                  className="font-medium underline underline-offset-2"
+                >
+                  View on Etherscan
+                </a>
+              </>
+            )}
+          </Notice>
+        )}
+
+        {sent && (
+          <Notice tone="success" role="status">
+            Sent{" "}
+            <strong>
+              {formatAmount(sent.amount, USDC.decimals, {
+                maxFraction: 2,
+                minFraction: 2,
+              })}{" "}
+              {USDC.symbol}
+            </strong>
+            {prices.usdc && !prices.usdc.isStale
+              ? ` (${formatUsd(usdValue(sent.amount, USDC.decimals, prices.usdc.priceE8))})`
+              : ""}{" "}
+            to <span className="font-mono">{sent.label}</span>.{" "}
+            <a
+              href={txUrl(sent.hash)}
+              target="_blank"
+              rel="noopener noreferrer"
+              className="font-medium underline underline-offset-2"
+            >
+              View on Etherscan
+            </a>
+          </Notice>
+        )}
+      </form>
+    </Card>
+  );
+}
diff --git a/src/components/PayView.tsx b/src/components/PayView.tsx
