# Dedicated Ethereum mainnet RPC (Alchemy, Infura, QuickNode, ...). Required.
NEXT_PUBLIC_MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# WalletConnect / Reown project id (https://cloud.reown.com). Required.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=YOUR_PROJECT_ID
# Public URL the app is served from; used for OG/Twitter image URLs.
NEXT_PUBLIC_SITE_URL=https://pay.example.com
