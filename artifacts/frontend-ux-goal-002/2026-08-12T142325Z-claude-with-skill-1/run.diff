+@import "tailwindcss";
+
+/*
+ * Semantic tokens. Components reference roles (surface, fg-muted, danger) and
+ * never raw colors, so light and dark stay in sync from one place.
+ * The theme follows the OS — there is no in-app toggle to keep consistent.
+ */
+:root {
+  --canvas: oklch(98.5% 0.004 260);
+  --surface: oklch(100% 0 0);
+  --surface-muted: oklch(96.8% 0.005 260);
+  --border: oklch(91% 0.008 260);
+  --border-strong: oklch(84% 0.012 260);
+
+  --fg: oklch(21% 0.02 260);
+  --fg-muted: oklch(50% 0.017 260);
+  --fg-subtle: oklch(63% 0.014 260);
+
+  --accent: oklch(54% 0.19 258);
+  --accent-hover: oklch(48% 0.19 258);
+  --accent-fg: oklch(99% 0 0);
+  --accent-soft: oklch(95% 0.03 258);
+
+  --danger: oklch(52% 0.2 25);
+  --danger-soft: oklch(96% 0.03 25);
+  --warning: oklch(52% 0.13 75);
+  --warning-soft: oklch(96% 0.05 85);
+  --success: oklch(48% 0.13 155);
+  --success-soft: oklch(95% 0.05 155);
+
+  --ring: oklch(54% 0.19 258 / 45%);
+}
+
+@media (prefers-color-scheme: dark) {
+  :root {
+    --canvas: oklch(17% 0.012 264);
+    --surface: oklch(21% 0.014 264);
+    --surface-muted: oklch(25% 0.015 264);
+    --border: oklch(30% 0.016 264);
+    --border-strong: oklch(38% 0.018 264);
+
+    --fg: oklch(96% 0.005 264);
+    --fg-muted: oklch(74% 0.014 264);
+    --fg-subtle: oklch(60% 0.014 264);
+
+    --accent: oklch(65% 0.16 258);
+    --accent-hover: oklch(71% 0.16 258);
+    --accent-fg: oklch(16% 0.02 264);
+    --accent-soft: oklch(28% 0.06 258);
+
+    --danger: oklch(70% 0.16 25);
+    --danger-soft: oklch(28% 0.07 25);
+    --warning: oklch(78% 0.13 80);
+    --warning-soft: oklch(29% 0.06 80);
+    --success: oklch(72% 0.15 155);
+    --success-soft: oklch(27% 0.06 155);
+
+    --ring: oklch(65% 0.16 258 / 50%);
+  }
+}
+
+@theme inline {
+  --color-canvas: var(--canvas);
+  --color-surface: var(--surface);
+  --color-surface-muted: var(--surface-muted);
+  --color-border-subtle: var(--border);
+  --color-border-strong: var(--border-strong);
+
+  --color-fg: var(--fg);
+  --color-fg-muted: var(--fg-muted);
+  --color-fg-subtle: var(--fg-subtle);
+
+  --color-accent: var(--accent);
+  --color-accent-hover: var(--accent-hover);
+  --color-accent-fg: var(--accent-fg);
+  --color-accent-soft: var(--accent-soft);
+
+  --color-danger: var(--danger);
+  --color-danger-soft: var(--danger-soft);
+  --color-warning: var(--warning);
+  --color-warning-soft: var(--warning-soft);
+  --color-success: var(--success);
+  --color-success-soft: var(--success-soft);
+
+  --font-sans: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto,
+    "Helvetica Neue", Arial, sans-serif;
+  --font-mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas,
+    monospace;
+}
+
+* {
+  border-color: var(--border);
+}
+
+body {
+  background-color: var(--canvas);
+  color: var(--fg);
+  -webkit-font-smoothing: antialiased;
+}
+
+:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 2px;
+}
+
+/* Numeric columns line up while balances refresh. */
+.tabular {
+  font-variant-numeric: tabular-nums;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    animation-duration: 0.01ms !important;
+    transition-duration: 0.01ms !important;
+  }
+}
