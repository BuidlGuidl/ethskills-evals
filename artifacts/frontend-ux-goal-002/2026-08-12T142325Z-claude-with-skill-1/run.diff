diff --git a/src/components/PayForm.tsx b/src/components/PayForm.tsx
new file mode 100644
index 0000000..8819ccc
--- /dev/null
+++ b/src/components/PayForm.tsx
@@ -0,0 +1,405 @@
+"use client";
+
+import { useMemo, useState } from "react";
+import { useConnectModal } from "@rainbow-me/rainbowkit";
+import { isAddressEqual, zeroAddress, type Address, type Hash } from "viem";
+import { useAccount, useBytecode, useConfig, useSwitchChain } from "wagmi";
+import {
+  simulateContract,
+  waitForTransactionReceipt,
+  writeContract,
+} from "wagmi/actions";
+import { erc20Abi } from "@/lib/abis";
+import { parseAmount, sanitizeAmountInput } from "@/lib/amount";
+import { TARGET_CHAIN, USDC, explorerTxUrl } from "@/lib/constants";
+import { humanizeError } from "@/lib/errors";
+import { formatTokenAmount, formatTokenExact, shortenAddress } from "@/lib/format";
+import type { useBalances } from "@/hooks/useBalances";
+import type { usePrices } from "@/hooks/usePrices";
+import { useResolvedRecipient } from "@/hooks/useResolvedRecipient";
+import { useTransferFeeEstimate } from "@/hooks/useTransferFeeEstimate";
+import { AmountField } from "./AmountField";
+import { RecipientField } from "./RecipientField";
+import { Button, Callout, Card } from "./ui";
+import { UsdValue } from "./UsdValue";
+
+type Balances = ReturnType<typeof useBalances>;
+type Prices = ReturnType<typeof usePrices>;
+
+type Sent = {
+  hash: Hash;
+  amount: bigint;
+  to: Address;
+  label: string;
+};
+
+export function PayForm({
+  balances,
+  prices,
+}: {
+  balances: Balances;
+  prices: Prices;
+}) {
+  const config = useConfig();
+  const { address, isConnected, chainId } = useAccount();
+  const { openConnectModal } = useConnectModal();
+  const { switchChain, isPending: isSwitching } = useSwitchChain();
+
+  const [recipientInput, setRecipientInput] = useState("");
+  const [amountInput, setAmountInput] = useState("");
+  const [submitAttempted, setSubmitAttempted] = useState(false);
+  // One pending flag for the whole send: click → signature → receipt → refetch.
+  const [isSending, setIsSending] = useState(false);
+  const [stage, setStage] = useState<"idle" | "signing" | "confirming">("idle");
+  const [error, setError] = useState<string | null>(null);
+  const [sent, setSent] = useState<Sent | null>(null);
+
+  const { usdcBalance, usdcDecimals, ethBalance } = balances;
+
+  const recipient = useResolvedRecipient(recipientInput);
+  const recipientAddress =
+    recipient.status === "ok" ? recipient.address : undefined;
+
+  const parsedAmount = useMemo(
+    () => parseAmount(amountInput, usdcDecimals, usdcBalance, USDC.symbol),
+    [amountInput, usdcDecimals, usdcBalance],
+  );
+  const amountValue =
+    parsedAmount.status === "ok" ? parsedAmount.value : undefined;
+
+  const { data: recipientCode } = useBytecode({
+    address: recipientAddress,
+    chainId: TARGET_CHAIN.id,
+    query: { enabled: Boolean(recipientAddress) },
+  });
+
+  const isWrongNetwork = isConnected && chainId !== TARGET_CHAIN.id;
+  const isOnTargetChain = isConnected && !isWrongNetwork;
+
+  const { feeWei, isLoading: isEstimatingFee } = useTransferFeeEstimate({
+    account: address,
+    to: recipientAddress,
+    amount: amountValue,
+    enabled: isOnTargetChain && !isSending,
+  });
+
+  // Blocking recipient problems that address validity alone doesn't catch.
+  const recipientBlocker = useMemo(() => {
+    if (!recipientAddress) return null;
+    if (isAddressEqual(recipientAddress, zeroAddress)) {
+      return "That's the zero address — USDC sent there is destroyed. Use a real recipient.";
+    }
+    if (isAddressEqual(recipientAddress, USDC.address)) {
+      return "That's the USDC contract itself. Tokens sent there can't be recovered.";
+    }
+    return null;
+  }, [recipientAddress]);
+
+  const isSendingToSelf =
+    address && recipientAddress && isAddressEqual(address, recipientAddress);
+  const isRecipientContract = Boolean(recipientCode && recipientCode !== "0x");
+  const hasNoEth = ethBalance !== undefined && ethBalance === 0n;
+
+  const canSubmit =
+    isOnTargetChain &&
+    recipient.status === "ok" &&
+    !recipientBlocker &&
+    parsedAmount.status === "ok" &&
+    !hasNoEth &&
+    !isSending;
+
+  function reset() {
+    setRecipientInput("");
+    setAmountInput("");
+    setSubmitAttempted(false);
+    setError(null);
+  }
+
+  async function handleSubmit(event: React.FormEvent) {
+    event.preventDefault();
+    setSubmitAttempted(true);
+
+    if (!canSubmit || !recipientAddress || amountValue === undefined || !address) {
+      return;
+    }
+
+    setError(null);
+    setSent(null);
+    setIsSending(true);
+    setStage("signing");
+
+    try {
+      // Simulate first so a revert becomes a readable message instead of a
+      // failed transaction the user already paid for.
+      const { request } = await simulateContract(config, {
+        account: address,
+        address: USDC.address,
+        abi: erc20Abi,
+        functionName: "transfer",
+        args: [recipientAddress, amountValue],
+        chainId: TARGET_CHAIN.id,
+      });
+
+      const hash = await writeContract(config, request);
+
+      setStage("confirming");
+      const receipt = await waitForTransactionReceipt(config, {
+        hash,
+        chainId: TARGET_CHAIN.id,
+      });
+
+      if (receipt.status === "reverted") {
+        setError(
+          "The transaction was mined but reverted — no USDC was sent. You were still charged gas.",
+        );
+        return;
+      }
+
+      // Only settle once the authoritative balances have come back.
+      await balances.refetchAll();
+
+      setSent({
+        hash,
+        amount: amountValue,
+        to: recipientAddress,
+        label:
+          recipient.status === "ok" && recipient.ensName
+            ? recipient.ensName
+            : shortenAddress(recipientAddress, 6),
+      });
+      reset();
+    } catch (caught) {
+      setError(humanizeError(caught));
+    } finally {
+      setIsSending(false);
+      setStage("idle");
+    }
+  }
+
+  if (sent) {
+    return (
+      <SentReceipt
+        sent={sent}
+        decimals={usdcDecimals}
+        prices={prices}
+        onDismiss={() => setSent(null)}
+      />
+    );
+  }
+
+  return (
+    <Card className="p-5">
+      <form onSubmit={handleSubmit} noValidate className="flex flex-col gap-5">
+        <RecipientField
+          value={recipientInput}
+          onChange={(next) => {
+            setRecipientInput(next);
+            setError(null);
+          }}
+          state={recipient}
+          disabled={isSending}
+        />
+
+        <AmountField
+          value={amountInput}
+          onChange={(next) => {
+            setAmountInput(sanitizeAmountInput(next));
+            setError(null);
+          }}
+          parsed={parsedAmount}
+          showError={submitAttempted || amountInput.length > 0}
+          balance={usdcBalance}
+          decimals={usdcDecimals}
+          price={prices.usdc}
+          onMax={() => {
+            if (usdcBalance !== undefined) {
+              setAmountInput(formatTokenExact(usdcBalance, usdcDecimals));
+            }
+          }}
+          disabled={isSending}
+        />
+
+        {recipientBlocker && <Callout tone="danger">{recipientBlocker}</Callout>}
+
+        {!recipientBlocker && isSendingToSelf && (
+          <Callout tone="warning">
+            This is your own address. The transfer will work, but it only costs
+            you gas.
+          </Callout>
+        )}
+
+        {!recipientBlocker && !isSendingToSelf && isRecipientContract && (
+          <Callout tone="warning">
+            This address is a smart contract. Make sure it can receive USDC —
+            plain contracts have no way to move tokens back out.
+          </Callout>
+        )}
+
+        {isOnTargetChain && hasNoEth && (
+          <Callout tone="warning" title="No ETH for gas">
+            This wallet holds no ETH, so it can&apos;t pay for the transaction.
+            Add a small amount of ETH and try again.
+          </Callout>
+        )}
+
+        {(feeWei !== undefined || isEstimatingFee) && (
+          <div className="flex items-baseline justify-between rounded-xl bg-surface-muted px-4 py-3 text-sm">
+            <span className="text-fg-muted">Estimated network fee</span>
+            {feeWei === undefined ? (
+              <span className="text-fg-subtle">Estimating…</span>
+            ) : (
+              <span className="tabular text-fg">
+                {formatTokenAmount(feeWei, 18, 5)} ETH{" "}
+                <span className="text-fg-muted">
+                  (
+                  <UsdValue
+                    amount={feeWei}
+                    decimals={18}
+                    price={prices.eth}
+                    className="text-fg-muted"
+                  />
+                  )
+                </span>
+              </span>
+            )}
+          </div>
+        )}
+
+        {error && <Callout tone="danger">{error}</Callout>}
+
+        <PrimaryAction
+          isConnected={isConnected}
+          isWrongNetwork={Boolean(isWrongNetwork)}
+          isSwitching={isSwitching}
+          isSending={isSending}
+          stage={stage}
+          canSubmit={canSubmit}
+          onConnect={() => openConnectModal?.()}
+          onSwitch={() => switchChain({ chainId: TARGET_CHAIN.id })}
+        />
+
+        <p className="text-center text-xs text-fg-subtle">
+          Transfers are final. Double-check the address before you send.
+        </p>
+      </form>
+    </Card>
+  );
+}
+
+/** Exactly one primary action is offered at a time: connect → switch → send. */
+function PrimaryAction({
+  isConnected,
+  isWrongNetwork,
+  isSwitching,
+  isSending,
+  stage,
+  canSubmit,
+  onConnect,
+  onSwitch,
+}: {
+  isConnected: boolean;
+  isWrongNetwork: boolean;
+  isSwitching: boolean;
+  isSending: boolean;
+  stage: "idle" | "signing" | "confirming";
+  canSubmit: boolean;
+  onConnect: () => void;
+  onSwitch: () => void;
+}) {
+  if (!isConnected) {
+    return (
+      <Button type="button" onClick={onConnect} className="w-full py-3.5">
+        Connect wallet
+      </Button>
+    );
+  }
+
+  if (isWrongNetwork) {
+    return (
+      <div className="flex flex-col gap-2">
+        <Callout tone="warning">
+          Your wallet is on another network. {USDC.symbol} lives on{" "}
+          {TARGET_CHAIN.name}.
+        </Callout>
+        <Button
+          type="button"
+          onClick={onSwitch}
+          isPending={isSwitching}
+          pendingLabel="Check your wallet…"
+          className="w-full py-3.5"
+        >
+          Switch to {TARGET_CHAIN.name}
+        </Button>
+      </div>
+    );
+  }
+
+  return (
+    <Button
+      type="submit"
+      disabled={!canSubmit}
+      isPending={isSending}
+      pendingLabel={
+        stage === "confirming" ? "Confirming onchain…" : "Confirm in wallet…"
+      }
+      className="w-full py-3.5"
+    >
+      Send {USDC.symbol}
+    </Button>
+  );
+}
+
+function SentReceipt({
+  sent,
+  decimals,
+  prices,
+  onDismiss,
+}: {
+  sent: Sent;
+  decimals: number;
+  prices: Prices;
+  onDismiss: () => void;
+}) {
+  return (
+    <Card className="p-6 text-center">
+      <div className="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-success-soft text-2xl text-success">
+        ✓
+      </div>
+
+      <h2 className="mt-4 text-lg font-semibold">Sent</h2>
+
+      <p className="mt-1 text-2xl font-semibold tabular">
+        {formatTokenAmount(sent.amount, decimals, 2)} {USDC.symbol}
+      </p>
+
+      <p className="mt-1 text-sm text-fg-muted">
+        <UsdValue
+          amount={sent.amount}
+          decimals={decimals}
+          price={prices.usdc}
+          className="text-fg-muted"
+        />{" "}
+        to <span className="font-medium text-fg">{sent.label}</span>
+      </p>
+
+      <div className="mt-6 flex flex-col gap-2 sm:flex-row">
+        <a
+          href={explorerTxUrl(sent.hash)}
+          target="_blank"
+          rel="noreferrer"
+          className="flex-1 rounded-xl border border-border-strong bg-surface-muted px-4 py-3 text-sm font-semibold text-fg transition-colors hover:border-fg-subtle"
+        >
+          View on {TARGET_CHAIN.blockExplorers.default.name}
+        </a>
+        <Button
+          type="button"
+          onClick={onDismiss}
+          className="flex-1"
+          variant="primary"
+        >
+          Send another
+        </Button>
+      </div>
+    </Card>
+  );
+}
diff --git a/src/components/PayScreen.tsx b/src/components/PayScreen.tsx
new file mode 100644
index 0000000..ca43892
--- /dev/null
+++ b/src/components/PayScreen.tsx
@@ -0,0 +1,52 @@
+"use client";
+
+import { useAccount } from "wagmi";
+import { useBalances } from "@/hooks/useBalances";
+import { usePrices } from "@/hooks/usePrices";
+import { TARGET_CHAIN } from "@/lib/constants";
+import { isUsingPublicRpc } from "@/lib/wagmi";
+import { BalancesCard } from "./BalancesCard";
+import { PayForm } from "./PayForm";
+import { Callout } from "./ui";
+
+export function PayScreen() {
+  const { address, isConnected } = useAccount();
+  const balances = useBalances(address);
+  const prices = usePrices();
+
+  return (
+    <div className="mx-auto w-full max-w-xl px-5 py-10">
+      <div className="mb-6">
+        <h1 className="text-2xl font-semibold tracking-tight">Send USDC</h1>
+        <p className="mt-1 text-sm text-fg-muted">
+          Pay anyone on {TARGET_CHAIN.name} with an ENS name or address.
+        </p>
+      </div>
+
+      <div className="flex flex-col gap-5">
+        {isUsingPublicRpc && process.env.NODE_ENV === "development" && (
+          <Callout tone="warning" title="No dedicated RPC configured">
+            Falling back to {TARGET_CHAIN.name}&apos;s public endpoint. Set
+            NEXT_PUBLIC_MAINNET_RPC_URL before deploying — the public one is
+            rate-limited and will drop reads.
+          </Callout>
+        )}
+
+        <BalancesCard
+          balances={balances}
+          prices={prices}
+          isConnected={isConnected}
+        />
+
+        {prices.isError && (
+          <Callout tone="warning">
+            Couldn&apos;t load prices right now, so dollar values are hidden.
+            Token amounts are still accurate.
+          </Callout>
+        )}
+
+        <PayForm balances={balances} prices={prices} />
+      </div>
+    </div>
+  );
+}
