--- /dev/null
+++ b/src/components/UsdValue.tsx
@@ -0,0 +1,64 @@
+"use client";
+
+import type { Price } from "@/hooks/usePrices";
+import { formatUsd, toUsd } from "@/lib/format";
+import { cx } from "./ui";
+
+/**
+ * Dollar value for a token amount. A missing or stale price is labelled rather
+ * than silently omitted — a number with no caveat reads as current.
+ */
+export function UsdValue({
+  amount,
+  decimals,
+  price,
+  isLoading = false,
+  className,
+  prefix,
+}: {
+  amount: bigint | undefined;
+  decimals: number;
+  price: Price;
+  isLoading?: boolean;
+  className?: string;
+  prefix?: string;
+}) {
+  if (isLoading) {
+    return <span className={cx("text-fg-subtle", className)}>—</span>;
+  }
+
+  if (amount === undefined) return null;
+
+  if (price.usd === null) {
+    return (
+      <span className={cx("text-fg-subtle", className)}>
+        Price unavailable
+      </span>
+    );
+  }
+
+  const usd = formatUsd(toUsd(amount, decimals, price.usd));
+
+  if (price.isStale) {
+    return (
+      <span
+        className={cx("text-warning", className)}
+        title={
+          price.updatedAt
+            ? `Chainlink last updated ${price.updatedAt.toLocaleString()}`
+            : undefined
+        }
+      >
+        {prefix}
+        {usd} · stale price
+      </span>
+    );
+  }
+
+  return (
+    <span className={cx("tabular", className)}>
+      {prefix}
+      {usd}
+    </span>
+  );
+}
