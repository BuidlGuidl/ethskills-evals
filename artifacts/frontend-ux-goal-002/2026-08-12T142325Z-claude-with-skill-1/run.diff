@@ -0,0 +1,59 @@
+"use client";
+
+import { encodeFunctionData, type Address } from "viem";
+import { useEstimateFeesPerGas, useEstimateGas } from "wagmi";
+import { erc20Abi } from "@/lib/abis";
+import { TARGET_CHAIN, USDC } from "@/lib/constants";
+
+/**
+ * What this transfer will cost in gas, in wei.
+ *
+ * Best-effort: if the node can't estimate (usually because the transfer would
+ * revert, which the form already reports separately) we return undefined and
+ * the fee line is simply not shown.
+ */
+export function useTransferFeeEstimate({
+  account,
+  to,
+  amount,
+  enabled,
+}: {
+  account: Address | undefined;
+  to: Address | undefined;
+  amount: bigint | undefined;
+  enabled: boolean;
+}) {
+  const isReady = Boolean(enabled && account && to && amount !== undefined);
+
+  const data =
+    to && amount !== undefined
+      ? encodeFunctionData({
+          abi: erc20Abi,
+          functionName: "transfer",
+          args: [to, amount],
+        })
+      : undefined;
+
+  const gas = useEstimateGas({
+    account,
+    to: USDC.address,
+    data,
+    chainId: TARGET_CHAIN.id,
+    query: { enabled: isReady, retry: false, staleTime: 15_000 },
+  });
+
+  const fees = useEstimateFeesPerGas({
+    chainId: TARGET_CHAIN.id,
+    query: { enabled: isReady, refetchInterval: 20_000 },
+  });
+
+  const maxFeePerGas = fees.data?.maxFeePerGas ?? fees.data?.gasPrice;
+
+  return {
+    feeWei:
+      gas.data !== undefined && maxFeePerGas !== undefined
+        ? gas.data * maxFeePerGas
+        : undefined,
+    isLoading: isReady && (gas.isLoading || fees.isLoading),
+  };
+}
