@@ -0,0 +1,96 @@
+"use client";
+
+import type { Price } from "@/hooks/usePrices";
+import type { ParsedAmount } from "@/lib/amount";
+import { formatTokenAmount } from "@/lib/format";
+import { USDC } from "@/lib/constants";
+import { Label } from "./ui";
+import { UsdValue } from "./UsdValue";
+
+export function AmountField({
+  value,
+  onChange,
+  parsed,
+  showError,
+  balance,
+  decimals,
+  price,
+  onMax,
+  disabled,
+}: {
+  value: string;
+  onChange: (value: string) => void;
+  parsed: ParsedAmount;
+  showError: boolean;
+  balance: bigint | undefined;
+  decimals: number;
+  price: Price;
+  onMax: () => void;
+  disabled?: boolean;
+}) {
+  const hasError = showError && parsed.status === "invalid";
+
+  return (
+    <div>
+      <Label
+        htmlFor="amount"
+        hint={
+          balance !== undefined ? (
+            <>Balance {formatTokenAmount(balance, decimals, 2)} USDC</>
+          ) : undefined
+        }
+      >
+        Amount
+      </Label>
+
+      <div
+        className={`flex items-center gap-2 rounded-xl border bg-surface pr-3 ${
+          hasError ? "border-danger" : "border-border-strong"
+        }`}
+      >
+        <input
+          id="amount"
+          name="amount"
+          value={value}
+          onChange={(event) => onChange(event.target.value)}
+          disabled={disabled}
+          inputMode="decimal"
+          placeholder="0.00"
+          autoComplete="off"
+          aria-invalid={hasError || undefined}
+          aria-describedby="amount-status"
+          className="tabular w-full bg-transparent px-4 py-3 text-base text-fg outline-none placeholder:text-fg-subtle disabled:opacity-60"
+        />
+
+        <span className="text-sm font-medium text-fg-muted">
+          {USDC.symbol}
+        </span>
+
+        <button
+          type="button"
+          onClick={onMax}
+          disabled={disabled || balance === undefined || balance === 0n}
+          className="rounded-lg border border-border-strong px-2 py-1 text-xs font-semibold text-fg-muted transition-colors hover:text-fg disabled:cursor-not-allowed disabled:opacity-50"
+        >
+          Max
+        </button>
+      </div>
+
+      <div id="amount-status" className="mt-2 min-h-5 text-sm">
+        {hasError ? (
+          <span className="text-danger">
+            {parsed.status === "invalid" ? parsed.message : null}
+          </span>
+        ) : parsed.status === "ok" ? (
+          <UsdValue
+            amount={parsed.value}
+            decimals={decimals}
+            price={price}
+            className="text-fg-muted"
+            prefix="≈ "
+          />
+        ) : null}
+      </div>
+    </div>
+  );
+}
diff --git a/src/components/BalancesCard.tsx b/src/components/BalancesCard.tsx
new file mode 100644
index 0000000..2e282df
--- /dev/null
+++ b/src/components/BalancesCard.tsx
@@ -0,0 +1,166 @@
+"use client";
+
+import type { useBalances } from "@/hooks/useBalances";
+import type { usePrices } from "@/hooks/usePrices";
+import { LOW_ETH_THRESHOLD_WEI, TARGET_CHAIN } from "@/lib/constants";
+import { formatTokenAmount, formatTokenExact } from "@/lib/format";
+import { Card } from "./ui";
+import { UsdValue } from "./UsdValue";
+
+type Balances = ReturnType<typeof useBalances>;
+type Prices = ReturnType<typeof usePrices>;
+
+export function BalancesCard({
+  balances,
+  prices,
+  isConnected,
+}: {
+  balances: Balances;
+  prices: Prices;
+  isConnected: boolean;
+}) {
+  const {
+    usdcBalance,
+    usdcDecimals,
+    isLoadingUsdc,
+    isUsdcError,
+    ethBalance,
+    isLoadingEth,
+    isEthError,
+  } = balances;
+
+  const isLowOnGas =
+    ethBalance !== undefined && ethBalance < LOW_ETH_THRESHOLD_WEI;
+
+  return (
+    <Card className="p-5">
+      <div className="grid gap-5 sm:grid-cols-2">
+        <Stat
+          label="Your USDC"
+          amount={
+            isUsdcError
+              ? "Couldn't load"
+              : usdcBalance === undefined
+                ? null
+                : `${formatTokenAmount(usdcBalance, usdcDecimals, 2)}`
+          }
+          suffix="USDC"
+          exact={
+            usdcBalance !== undefined
+              ? `${formatTokenExact(usdcBalance, usdcDecimals)} USDC`
+              : undefined
+          }
+          isLoading={isConnected && isLoadingUsdc}
+          isConnected={isConnected}
+          sub={
+            <UsdValue
+              amount={usdcBalance}
+              decimals={usdcDecimals}
+              price={prices.usdc}
+              isLoading={isConnected && isLoadingUsdc}
+            />
+          }
+        />
+
+        <Stat
+          label="Your ETH"
+          amount={
+            isEthError
+              ? "Couldn't load"
+              : ethBalance === undefined
+                ? null
+                : formatTokenAmount(ethBalance, 18, 4)
+          }
+          suffix="ETH"
+          exact={
+            ethBalance !== undefined
+              ? `${formatTokenExact(ethBalance, 18)} ETH`
+              : undefined
+          }
+          isLoading={isConnected && isLoadingEth}
+          isConnected={isConnected}
+          sub={
+            <UsdValue
+              amount={ethBalance}
+              decimals={18}
+              price={prices.eth}
+              isLoading={isConnected && isLoadingEth}
+            />
+          }
+          note={
+            isLowOnGas
+              ? "Low — you may not have enough for gas."
+              : "Used for gas."
+          }
+          noteTone={isLowOnGas ? "warning" : "muted"}
+        />
+      </div>
+
+      <p className="mt-5 border-t border-border-subtle pt-3 text-xs text-fg-subtle">
+        Balances read from {TARGET_CHAIN.name}, refreshed every 15 seconds.
+      </p>
+    </Card>
+  );
+}
+
+function Stat({
+  label,
+  amount,
+  suffix,
+  exact,
+  sub,
+  isLoading,
+  isConnected,
+  note,
+  noteTone = "muted",
+}: {
+  label: string;
+  amount: string | null;
+  suffix: string;
+  exact?: string;
+  sub: React.ReactNode;
+  isLoading: boolean;
+  isConnected: boolean;
+  note?: string;
+  noteTone?: "muted" | "warning";
+}) {
+  return (
+    <div>
+      <p className="text-xs font-medium uppercase tracking-wide text-fg-subtle">
+        {label}
+      </p>
+
+      {!isConnected ? (
+        <p className="mt-1 text-2xl font-semibold text-fg-subtle">
+          — <span className="text-base font-medium">{suffix}</span>
+        </p>
+      ) : isLoading || amount === null ? (
+        <div
+          className="mt-2 h-8 w-32 animate-pulse rounded-md bg-surface-muted"
+          aria-label={`Loading ${label}`}
+        />
+      ) : (
+        <p className="mt-1 text-2xl font-semibold tabular" title={exact}>
+          {amount}{" "}
+          <span className="text-base font-medium text-fg-muted">{suffix}</span>
+        </p>
+      )}
+
+      <div className="mt-1 text-sm text-fg-muted">
+        {isConnected ? sub : "Connect to see your balance"}
+      </div>
+
+      {note && isConnected && (
+        <p
+          className={
+            noteTone === "warning"
+              ? "mt-1 text-xs font-medium text-warning"
+              : "mt-1 text-xs text-fg-subtle"
+          }
+        >
+          {note}
+        </p>
+      )}
+    </div>
+  );
+}
