+++ b/src/hooks/useBalances.ts
@@ -0,0 +1,59 @@
+"use client";
+
+import { useCallback } from "react";
+import type { Address } from "viem";
+import { useBalance, useReadContract } from "wagmi";
+import { erc20Abi } from "@/lib/abis";
+import { TARGET_CHAIN, USDC } from "@/lib/constants";
+
+/**
+ * The connected wallet's USDC and ETH balances on the target chain.
+ *
+ * Both are read from the target chain explicitly, so the numbers stay correct
+ * (and visible) even while the wallet is pointed at the wrong network.
+ */
+export function useBalances(address: Address | undefined) {
+  const enabled = Boolean(address);
+
+  const usdc = useReadContract({
+    address: USDC.address,
+    abi: erc20Abi,
+    functionName: "balanceOf",
+    args: address ? [address] : undefined,
+    chainId: TARGET_CHAIN.id,
+    query: { enabled, refetchInterval: 15_000 },
+  });
+
+  const decimals = useReadContract({
+    address: USDC.address,
+    abi: erc20Abi,
+    functionName: "decimals",
+    chainId: TARGET_CHAIN.id,
+    // The token's decimals can't change; read once and keep it.
+    query: { staleTime: Infinity, gcTime: Infinity },
+  });
+
+  const eth = useBalance({
+    address,
+    chainId: TARGET_CHAIN.id,
+    query: { enabled, refetchInterval: 15_000 },
+  });
+
+  const refetchAll = useCallback(async () => {
+    await Promise.all([usdc.refetch(), eth.refetch()]);
+  }, [usdc, eth]);
+
+  return {
+    usdcBalance: usdc.data,
+    // Fall back to the known constant if the decimals read hasn't landed yet.
+    usdcDecimals: decimals.data ?? USDC.decimals,
+    isLoadingUsdc: usdc.isLoading,
+    isUsdcError: usdc.isError,
+
+    ethBalance: eth.data?.value,
+    isLoadingEth: eth.isLoading,
+    isEthError: eth.isError,
+
+    refetchAll,
+  };
+}
diff --git a/src/hooks/useDebounced.ts b/src/hooks/useDebounced.ts
new file mode 100644
index 0000000..bda77ba
--- /dev/null
+++ b/src/hooks/useDebounced.ts
@@ -0,0 +1,14 @@
+"use client";
+
+import { useEffect, useState } from "react";
+
+export function useDebounced<T>(value: T, delayMs = 300): T {
+  const [debounced, setDebounced] = useState(value);
+
+  useEffect(() => {
+    const id = setTimeout(() => setDebounced(value), delayMs);
+    return () => clearTimeout(id);
+  }, [value, delayMs]);
+
+  return debounced;
+}
diff --git a/src/hooks/usePrices.ts b/src/hooks/usePrices.ts
new file mode 100644
index 0000000..e2ccdbd
--- /dev/null
+++ b/src/hooks/usePrices.ts
@@ -0,0 +1,110 @@
+"use client";
+
+import { useEffect, useState } from "react";
+import { useReadContracts } from "wagmi";
+import { aggregatorV3Abi } from "@/lib/abis";
+import {
+  PRICE_FEEDS,
+  PRICE_STALE_AFTER_SECONDS,
+  TARGET_CHAIN,
+} from "@/lib/constants";
+
+export type Price = {
+  /** USD per unit of the asset, or null when unavailable. */
+  usd: number | null;
+  /** True when the feed answered but hasn't updated within its heartbeat. */
+  isStale: boolean;
+  updatedAt: Date | null;
+};
+
+const UNAVAILABLE: Price = { usd: null, isStale: false, updatedAt: null };
+
+type LatestRoundData = readonly [bigint, bigint, bigint, bigint, bigint];
+
+function toPrice(
+  round: LatestRoundData | undefined,
+  decimals: number | undefined,
+  staleAfterSeconds: number,
+  now: number,
+): Price {
+  if (!round || decimals === undefined) return UNAVAILABLE;
+  const [, answer, , updatedAt] = round;
+  // A non-positive answer means the feed is not reporting a usable price.
+  if (answer <= 0n || updatedAt === 0n) return UNAVAILABLE;
+  const updatedAtMs = Number(updatedAt) * 1000;
+  return {
+    usd: Number(answer) / 10 ** decimals,
+    // `now === 0` means the clock hasn't been read on the client yet.
+    isStale: now !== 0 && now - updatedAtMs > staleAfterSeconds * 1000,
+    updatedAt: new Date(updatedAtMs),
+  };
+}
+
+/**
+ * ETH and USDC prices from Chainlink on mainnet.
+ *
+ * USDC is read rather than assumed to be $1 — a depeg is exactly the moment a
+ * user most needs the number in front of them to be true.
+ */
+export function usePrices() {
+  const [now, setNow] = useState(() => 0);
+
+  // Staleness is time-dependent, so it can't be computed during SSR. Start at 0
+  // (nothing stale) and re-evaluate on the client once a minute.
+  useEffect(() => {
+    setNow(Date.now());
+    const id = setInterval(() => setNow(Date.now()), 60_000);
+    return () => clearInterval(id);
+  }, []);
+
+  const contracts = [
+    {
+      address: PRICE_FEEDS.ethUsd,
+      abi: aggregatorV3Abi,
+      functionName: "latestRoundData",
+      chainId: TARGET_CHAIN.id,
+    },
+    {
+      address: PRICE_FEEDS.ethUsd,
+      abi: aggregatorV3Abi,
+      functionName: "decimals",
+      chainId: TARGET_CHAIN.id,
+    },
+    {
+      address: PRICE_FEEDS.usdcUsd,
+      abi: aggregatorV3Abi,
+      functionName: "latestRoundData",
+      chainId: TARGET_CHAIN.id,
+    },
+    {
+      address: PRICE_FEEDS.usdcUsd,
+      abi: aggregatorV3Abi,
+      functionName: "decimals",
+      chainId: TARGET_CHAIN.id,
+    },
+  ] as const;
+
+  const { data, isLoading, isError, refetch } = useReadContracts({
+    contracts,
+    query: {
+      // Prices move; balances don't need this cadence but a stale price is a lie.
+      refetchInterval: 60_000,
+      staleTime: 30_000,
+    },
+  });
+
+  const eth = toPrice(
+    data?.[0]?.result as LatestRoundData | undefined,
+    data?.[1]?.result as number | undefined,
+    PRICE_STALE_AFTER_SECONDS.ethUsd,
+    now,
+  );
+  const usdc = toPrice(
+    data?.[2]?.result as LatestRoundData | undefined,
+    data?.[3]?.result as number | undefined,
+    PRICE_STALE_AFTER_SECONDS.usdcUsd,
+    now,
+  );
+
+  return { eth, usdc, isLoading, isError, refetch };
+}
diff --git a/src/hooks/useResolvedRecipient.ts b/src/hooks/useResolvedRecipient.ts
new file mode 100644
index 0000000..fbd82c8
--- /dev/null
+++ b/src/hooks/useResolvedRecipient.ts
@@ -0,0 +1,159 @@
+"use client";
+
+import { useMemo } from "react";
+import { getAddress, isAddress, type Address } from "viem";
+import { normalize } from "viem/ens";
+import { useEnsAddress, useEnsAvatar, useEnsName } from "wagmi";
+import { TARGET_CHAIN } from "@/lib/constants";
+import { useDebounced } from "./useDebounced";
+
+export type RecipientState =
+  | { status: "empty" }
+  | { status: "resolving"; label: string }
+  | {
+      status: "ok";
+      address: Address;
+      ensName: string | null;
+      ensAvatar: string | null;
+      /** True when the user typed a name and we resolved it to this address. */
+      resolvedFromName: boolean;
+    }
+  | { status: "error"; message: string };
+
+/** Anything with a dot that isn't hex — treat as a name to resolve. */
+function looksLikeEnsName(input: string) {
+  return input.includes(".") && !input.startsWith("0x");
+}
+
+/** True when the hex body mixes cases, i.e. it encodes an EIP-55 checksum. */
+function hasChecksumCasing(input: string) {
+  const body = input.slice(2);
+  return /[a-f]/.test(body) && /[A-F]/.test(body);
+}
+
+/**
+ * Turns whatever the user typed into an address to send to.
+ *
+ * Accepts a checksummed or lowercase 0x address, or any ENS name, and always
+ * reports *why* an input was rejected instead of just disabling the button.
+ */
+export function useResolvedRecipient(rawInput: string): RecipientState {
+  const input = rawInput.trim();
+  const debouncedInput = useDebounced(input, 350);
+  // While the debounce is settling, keep showing "resolving" rather than an
+  // error for a half-typed name.
+  const isSettling = input !== debouncedInput;
+
+  const normalizedName = useMemo(() => {
+    if (!looksLikeEnsName(debouncedInput)) return null;
+    try {
+      return normalize(debouncedInput);
+    } catch {
+      return null;
+    }
+  }, [debouncedInput]);
+
+  const {
+    data: ensAddress,
+    isLoading: isResolvingName,
+    isError: nameLookupFailed,
+  } = useEnsAddress({
+    name: normalizedName ?? undefined,
+    chainId: TARGET_CHAIN.id,
+    query: { enabled: Boolean(normalizedName) },
+  });
+
+  const typedAddress = useMemo(() => {
+    if (!debouncedInput.startsWith("0x")) return null;
+    // Mixed-case input carries EIP-55 casing, so the checksum is meaningful and
+    // worth enforcing. All-lower or all-upper input has no checksum to check.
+    const strict = hasChecksumCasing(debouncedInput);
+    return isAddress(debouncedInput, { strict })
+      ? getAddress(debouncedInput)
+      : null;
+  }, [debouncedInput]);
+
+  // Reverse lookup so a pasted address still shows a human name when it has one.
+  const { data: reverseName } = useEnsName({
+    address: typedAddress ?? undefined,
+    chainId: TARGET_CHAIN.id,
+    query: { enabled: Boolean(typedAddress) },
+  });
+
+  const displayName = normalizedName ?? reverseName ?? null;
+  const { data: ensAvatar } = useEnsAvatar({
+    name: displayName ?? undefined,
+    chainId: TARGET_CHAIN.id,
+    query: { enabled: Boolean(displayName) },
+  });
+
+  if (!input) return { status: "empty" };
+  if (isSettling) return { status: "resolving", label: input };
+
+  if (normalizedName) {
+    if (isResolvingName) return { status: "resolving", label: normalizedName };
+    if (nameLookupFailed) {
+      return {
+        status: "error",
+        message: `Couldn't reach ENS to look up ${normalizedName}. Check your connection, or paste the address instead.`,
+      };
+    }
+    if (!ensAddress) {
+      return {
+        status: "error",
+        message: `${normalizedName} doesn't have an Ethereum address set. Ask the recipient for their address.`,
+      };
+    }
+    return {
+      status: "ok",
+      address: ensAddress,
+      ensName: normalizedName,
+      ensAvatar: ensAvatar ?? null,
+      resolvedFromName: true,
+    };
+  }
+
+  if (typedAddress) {
+    return {
+      status: "ok",
+      address: typedAddress,
+      ensName: reverseName ?? null,
+      ensAvatar: ensAvatar ?? null,
+      resolvedFromName: false,
+    };
+  }
+
+  if (debouncedInput.startsWith("0x")) {
+    if (debouncedInput.length !== 42) {
+      return {
+        status: "error",
+        message: `An address is 42 characters; this one is ${debouncedInput.length}.`,
+      };
+    }
+    // Well-formed hex that only failed the strict check means the checksum
+    // didn't match — worth saying out loud, since funds would be unrecoverable.
+    if (isAddress(debouncedInput, { strict: false })) {
+      return {
+        status: "error",
+        message:
+          "That address fails its checksum — a character is likely mistyped. Copy it again from the source.",
+      };
+    }
+    return {
+      status: "error",
+      message: "That's not a valid Ethereum address.",
+    };
+  }
+
+  if (debouncedInput.includes(".")) {
+    return {
+      status: "error",
+      message: "That name isn't a valid ENS name.",
+    };
+  }
+
+  return {
+    status: "error",
+    message: "Enter an ENS name (like alice.eth) or a 0x address.",
+  };
+}
