@@ -0,0 +1,35 @@
+import type { NextConfig } from "next";
+
+/**
+ * RainbowKit imports wagmi's connector barrel, which reaches Base Account's
+ * x402 payment code. Its `@x402/*` peers are declared optional and we never
+ * touch that path, so resolve them to nothing rather than shipping four
+ * packages of dead weight.
+ */
+const unusedOptionalPeers = [
+  "@x402/core",
+  "@x402/evm",
+  "@x402/svm",
+  "@x402/extensions",
+  // WalletConnect's logger optionally pretty-prints; not wanted in a browser bundle.
+  "pino-pretty",
+];
+
+const nextConfig: NextConfig = {
+  reactStrictMode: true,
+  webpack: (config) => {
+    config.resolve.alias = {
+      ...config.resolve.alias,
+      ...Object.fromEntries(unusedOptionalPeers.map((name) => [name, false])),
+    };
+    return config;
+  },
+  // Turbopack (`next dev`) has no `false` alias, so point them at an empty module.
+  turbopack: {
+    resolveAlias: Object.fromEntries(
+      unusedOptionalPeers.map((name) => [name, "./empty-module.js"]),
+    ),
+  },
+};
+
+export default nextConfig;
