+"use client";
+
+import type { RecipientState } from "@/hooks/useResolvedRecipient";
+import { explorerAddressUrl } from "@/lib/constants";
+import { shortenAddress } from "@/lib/format";
+import { Label, Spinner } from "./ui";
+
+export function RecipientField({
+  value,
+  onChange,
+  state,
+  disabled,
+}: {
+  value: string;
+  onChange: (value: string) => void;
+  state: RecipientState;
+  disabled?: boolean;
+}) {
+  const hasError = state.status === "error";
+  const describedBy = "recipient-status";
+
+  return (
+    <div>
+      <Label htmlFor="recipient" hint="ENS name or 0x address">
+        Send to
+      </Label>
+
+      <input
+        id="recipient"
+        name="recipient"
+        value={value}
+        onChange={(event) => onChange(event.target.value)}
+        disabled={disabled}
+        placeholder="alice.eth or 0x…"
+        autoComplete="off"
+        autoCorrect="off"
+        spellCheck={false}
+        aria-invalid={hasError || undefined}
+        aria-describedby={describedBy}
+        className={`w-full rounded-xl border bg-surface px-4 py-3 text-base text-fg placeholder:text-fg-subtle disabled:opacity-60 ${
+          hasError ? "border-danger" : "border-border-strong"
+        }`}
+      />
+
+      <div id={describedBy} className="mt-2 min-h-5 text-sm">
+        {state.status === "resolving" && (
+          <span className="flex items-center gap-2 text-fg-muted">
+            <Spinner className="h-3.5 w-3.5" />
+            Resolving {state.label}…
+          </span>
+        )}
+
+        {state.status === "error" && (
+          <span className="text-danger">{state.message}</span>
+        )}
+
+        {state.status === "ok" && (
+          <span className="flex flex-wrap items-center gap-2 text-fg-muted">
+            {state.ensAvatar ? (
+              // eslint-disable-next-line @next/next/no-img-element
+              <img
+                src={state.ensAvatar}
+                alt=""
+                className="h-5 w-5 rounded-full object-cover"
+              />
+            ) : (
+              <span aria-hidden="true" className="text-success">
+                ✓
+              </span>
+            )}
+
+            {state.resolvedFromName ? (
+              <>
+                <span className="font-medium text-fg">{state.ensName}</span>
+                <span aria-hidden="true">→</span>
+              </>
+            ) : state.ensName ? (
+              <>
+                <span className="font-medium text-fg">{state.ensName}</span>
+                <span aria-hidden="true">·</span>
+              </>
+            ) : null}
+
+            <a
+              href={explorerAddressUrl(state.address)}
+              target="_blank"
+              rel="noreferrer"
+              className="font-mono text-xs underline underline-offset-2 hover:text-fg"
+              title={state.address}
+            >
+              {shortenAddress(state.address, 6)}
+            </a>
+          </span>
+        )}
+      </div>
+    </div>
+  );
+}
