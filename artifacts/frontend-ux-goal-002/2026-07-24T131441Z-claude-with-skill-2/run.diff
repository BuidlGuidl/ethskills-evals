+++ b/hooks/useEthUsdPrice.ts
@@ -0,0 +1,44 @@
+"use client";
+
+import { useReadContracts } from "wagmi";
+import { CHAINLINK_ETH_USD_FEED, POLLING_INTERVAL_MS } from "@/lib/constants";
+import { chainlinkAggregatorAbi } from "@/lib/abi";
+
+/**
+ * Reads the ETH/USD price from the Chainlink mainnet feed for USD context
+ * (Rule 4). Returns `undefined` while loading or on error so callers can
+ * gracefully omit USD context instead of showing a wrong number.
+ */
+export function useEthUsdPrice(): { priceUsd: number | undefined; isLoading: boolean } {
+  const { data, isLoading } = useReadContracts({
+    contracts: [
+      {
+        address: CHAINLINK_ETH_USD_FEED,
+        abi: chainlinkAggregatorAbi,
+        functionName: "latestRoundData",
+      },
+      {
+        address: CHAINLINK_ETH_USD_FEED,
+        abi: chainlinkAggregatorAbi,
+        functionName: "decimals",
+      },
+    ],
+    query: {
+      refetchInterval: POLLING_INTERVAL_MS,
+      staleTime: POLLING_INTERVAL_MS,
+    },
+  });
+
+  const roundData = data?.[0].result;
+  const feedDecimals = data?.[1].result;
+
+  if (!roundData || feedDecimals === undefined) {
+    return { priceUsd: undefined, isLoading };
+  }
+
+  const answer = roundData[1]; // int256, ETH price scaled by feedDecimals
+  if (answer <= 0n) return { priceUsd: undefined, isLoading };
+
+  const priceUsd = Number(answer) / 10 ** Number(feedDecimals);
+  return { priceUsd, isLoading };
+}
