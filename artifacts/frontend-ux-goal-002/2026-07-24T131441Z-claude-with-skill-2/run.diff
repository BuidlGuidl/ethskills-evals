+"use client";
+
+import { useAccount, useBalance, useReadContract } from "wagmi";
+import { formatEther, type Address } from "viem";
+import { erc20Abi } from "@/lib/abi";
+import { USDC_ADDRESS, USDC_DECIMALS, POLLING_INTERVAL_MS } from "@/lib/constants";
+import { formatTokenAmount, formatUsd, usdContext } from "@/lib/format";
+import { useEthUsdPrice } from "@/hooks/useEthUsdPrice";
+import styles from "./pay.module.css";
+
+/**
+ * The user's USDC balance (for sending) and ETH balance (for gas), each with
+ * USD context (Rule 4). Polls on a steady interval (Rule 5).
+ */
+export function Balances() {
+  const { address } = useAccount();
+  const { priceUsd: ethPriceUsd } = useEthUsdPrice();
+
+  const { data: usdcBalance } = useReadContract({
+    address: USDC_ADDRESS,
+    abi: erc20Abi,
+    functionName: "balanceOf",
+    args: address ? [address] : undefined,
+    query: {
+      enabled: Boolean(address),
+      refetchInterval: POLLING_INTERVAL_MS,
+    },
+  });
+
+  const { data: ethBalance } = useBalance({
+    address,
+    query: {
+      enabled: Boolean(address),
+      refetchInterval: POLLING_INTERVAL_MS,
+    },
+  });
+
+  return (
+    <div className={styles.balancesGrid}>
+      <BalanceTile
+        dotClass={styles.usdcDot}
+        label="USDC"
+        value={
+          usdcBalance !== undefined
+            ? formatTokenAmount(usdcBalance, USDC_DECIMALS, 2)
+            : "—"
+        }
+        // USDC is a USD stablecoin — 1 USDC ≈ $1.
+        usd={
+          usdcBalance !== undefined
+            ? usdContext(usdcBalance, USDC_DECIMALS, 1)
+            : ""
+        }
+      />
+      <BalanceTile
+        dotClass={styles.ethDot}
+        label="ETH (gas)"
+        value={
+          ethBalance !== undefined
+            ? formatTokenAmount(ethBalance.value, 18, 4)
+            : "—"
+        }
+        usd={
+          ethBalance !== undefined && ethPriceUsd !== undefined
+            ? `~${formatUsd(Number(formatEther(ethBalance.value)) * ethPriceUsd)}`
+            : ""
+        }
+      />
+    </div>
+  );
+}
+
+function BalanceTile({
+  dotClass,
+  label,
+  value,
+  usd,
+}: {
+  dotClass: string;
+  label: string;
+  value: string;
+  usd: string;
+}) {
+  return (
+    <div className={styles.balanceTile}>
+      <span className={styles.balanceLabel}>
+        <span className={`${styles.tokenDot} ${dotClass}`} aria-hidden="true" />
+        {label}
+      </span>
+      <span className={styles.balanceValue}>{value}</span>
+      <span className={styles.balanceUsd}>{usd || " "}</span>
+    </div>
+  );
+}
+
+export type { Address };
