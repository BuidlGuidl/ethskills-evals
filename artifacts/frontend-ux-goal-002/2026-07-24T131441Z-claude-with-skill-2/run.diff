+import type { Address } from "viem";
+
+/**
+ * The real Circle USDC token on Ethereum mainnet.
+ * 6 decimals — NOT 18. Every amount conversion must use USDC_DECIMALS.
+ */
+export const USDC_ADDRESS: Address = "0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48";
+export const USDC_DECIMALS = 6;
+export const USDC_SYMBOL = "USDC";
+
+/**
+ * Chainlink ETH/USD price feed on mainnet — used for USD context on the
+ * ETH gas balance (Rule 4). Onchain read avoids a third-party price API/CORS.
+ * https://data.chain.link/feeds/ethereum/mainnet/eth-usd
+ */
+export const CHAINLINK_ETH_USD_FEED: Address = "0x5f4eC3Df9cbd43714FE2740f5E3616155c5b8419";
+
+/** Interactive polling cadence (Rule 5: ~2–5s). */
+export const POLLING_INTERVAL_MS = 4_000;
diff --git a/lib/errors.ts b/lib/errors.ts
new file mode 100644
index 0000000..3ba6b69
--- /dev/null
+++ b/lib/errors.ts
@@ -0,0 +1,54 @@
+import {
+  BaseError,
+  ContractFunctionRevertedError,
+  UserRejectedRequestError,
+} from "viem";
+
+/**
+ * Rule 7: translate wallet + contract errors into a short human message.
+ * Never surface a raw revert selector or an unhandled exception to the user.
+ */
+export function parseTxError(error: unknown): string {
+  if (!error) return "Something went wrong. Please try again.";
+
+  if (error instanceof BaseError) {
+    // User dismissed the wallet prompt — most common, not a real failure.
+    const rejected = error.walk((e) => e instanceof UserRejectedRequestError);
+    if (rejected) return "You rejected the request in your wallet.";
+
+    // Custom/known contract revert.
+    const reverted = error.walk(
+      (e) => e instanceof ContractFunctionRevertedError,
+    );
+    if (reverted instanceof ContractFunctionRevertedError) {
+      const name = reverted.data?.errorName ?? reverted.reason;
+      if (name) return mapKnownRevert(name);
+      return "The transaction was reverted by the contract.";
+    }
+
+    // Gas / funds shortfalls surface in the short message.
+    const short = error.shortMessage || error.message;
+    if (/insufficient funds/i.test(short)) {
+      return "Insufficient ETH to cover gas for this transaction.";
+    }
+    if (/gas/i.test(short) && /estimat/i.test(short)) {
+      return "Could not estimate gas — the transfer would likely fail.";
+    }
+    return short;
+  }
+
+  if (error instanceof Error) return error.message;
+  return "Something went wrong. Please try again.";
+}
+
+/** Map known ERC-20 revert reasons to friendly copy. */
+function mapKnownRevert(name: string): string {
+  const key = name.toLowerCase();
+  if (key.includes("insufficient") && key.includes("balance")) {
+    return "Transfer failed: not enough USDC in your wallet.";
+  }
+  if (key.includes("allowance")) {
+    return "Transfer failed: insufficient allowance.";
+  }
+  return `Transfer reverted: ${name}`;
+}
