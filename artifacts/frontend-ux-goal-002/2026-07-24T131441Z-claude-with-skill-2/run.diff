+import type { Metadata } from "next";
+import { Providers } from "./providers";
+import "./globals.css";
+
+const appUrl = process.env.NEXT_PUBLIC_APP_URL || "https://usdc-pay.example.com";
+
+// Rule 8: real product identity, absolute OG/Twitter image, no template branding.
+export const metadata: Metadata = {
+  metadataBase: new URL(appUrl),
+  title: {
+    default: "USDC Pay — Send USDC on Ethereum",
+    template: "%s · USDC Pay",
+  },
+  description:
+    "Connect your wallet and send USDC to anyone on Ethereum mainnet. See your USDC and ETH balances at a glance.",
+  applicationName: "USDC Pay",
+  icons: {
+    icon: [{ url: "/favicon.svg", type: "image/svg+xml" }],
+  },
+  openGraph: {
+    type: "website",
+    url: appUrl,
+    siteName: "USDC Pay",
+    title: "USDC Pay — Send USDC on Ethereum",
+    description:
+      "Connect your wallet and send USDC to anyone on Ethereum mainnet.",
+    images: [
+      {
+        url: "/og.svg",
+        width: 1200,
+        height: 630,
+        alt: "USDC Pay — Send USDC on Ethereum",
+      },
+    ],
+  },
+  twitter: {
+    card: "summary_large_image",
+    title: "USDC Pay — Send USDC on Ethereum",
+    description:
+      "Connect your wallet and send USDC to anyone on Ethereum mainnet.",
+    images: ["/og.svg"],
+  },
+};
+
+export default function RootLayout({
+  children,
+}: {
+  children: React.ReactNode;
+}) {
+  return (
+    <html lang="en" suppressHydrationWarning>
+      <body>
+        <Providers>{children}</Providers>
+      </body>
+    </html>
+  );
+}
