diff --git a/app/pay/AddressField.tsx b/app/pay/AddressField.tsx
new file mode 100644
index 0000000..82d8851
--- /dev/null
+++ b/app/pay/AddressField.tsx
@@ -0,0 +1,171 @@
+"use client";
+
+import { useEffect, useMemo } from "react";
+import { getAddress, isAddress, type Address } from "viem";
+import { normalize } from "viem/ens";
+import { useEnsAddress, useEnsName } from "wagmi";
+import { mainnet } from "wagmi/chains";
+import { truncateAddress } from "@/lib/format";
+import { CheckIcon } from "./icons";
+import styles from "./pay.module.css";
+
+export type RecipientResolution = {
+  /** Checksummed address to send to, or null when input is empty/invalid/unresolved. */
+  address: Address | null;
+  /** True while an ENS name is resolving. */
+  isResolving: boolean;
+};
+
+type Props = {
+  value: string;
+  onChange: (value: string) => void;
+  onResolvedChange: (r: RecipientResolution) => void;
+  disabled?: boolean;
+};
+
+const looksLikeEns = (v: string) => v.includes(".") && !v.startsWith("0x");
+
+/**
+ * Recipient input with validation, paste normalization, and ENS resolution
+ * (Rule 3). Accepts a 0x address or an ENS name; reports a checksummed
+ * address up to the parent, or null when the entry can't be trusted.
+ */
+export function AddressField({ value, onChange, onResolvedChange, disabled }: Props) {
+  const trimmed = value.trim();
+
+  const isHexAddress = isAddress(trimmed);
+  const ensQuery = looksLikeEns(trimmed) ? safeNormalize(trimmed) : undefined;
+
+  const {
+    data: ensResolvedAddress,
+    isLoading: ensResolving,
+    isError: ensError,
+  } = useEnsAddress({
+    name: ensQuery,
+    chainId: mainnet.id,
+    query: { enabled: Boolean(ensQuery) },
+  });
+
+  // Reverse lookup: show an ENS name for a pasted 0x address when one exists.
+  const { data: reverseName } = useEnsName({
+    address: isHexAddress ? (getAddress(trimmed) as Address) : undefined,
+    chainId: mainnet.id,
+    query: { enabled: isHexAddress },
+  });
+
+  const resolvedAddress: Address | null = useMemo(() => {
+    if (isHexAddress) return getAddress(trimmed);
+    if (ensResolvedAddress) return getAddress(ensResolvedAddress);
+    return null;
+  }, [isHexAddress, ensResolvedAddress, trimmed]);
+
+  const isResolving = Boolean(ensQuery) && ensResolving;
+
+  // Report resolution up to the parent whenever it changes.
+  useEffect(() => {
+    onResolvedChange({ address: resolvedAddress, isResolving });
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [resolvedAddress, isResolving]);
+
+  // Paste normalization: strip whitespace and stray "ethereum:" URI prefixes.
+  function handlePaste(e: React.ClipboardEvent<HTMLInputElement>) {
+    const pasted = e.clipboardData.getData("text");
+    const cleaned = pasted.trim().replace(/^ethereum:/i, "").replace(/\s+/g, "");
+    if (cleaned !== pasted) {
+      e.preventDefault();
+      onChange(cleaned);
+    }
+  }
+
+  const status = getStatus({
+    trimmed,
+    isHexAddress,
+    ensQuery,
+    isResolving,
+    ensResolvedAddress: ensResolvedAddress ?? null,
+    ensError,
+  });
+
+  return (
+    <div className={styles.field}>
+      <label className={styles.label} htmlFor="recipient">
+        Recipient
+      </label>
+      <div className={styles.inputWrap}>
+        <input
+          id="recipient"
+          className={`${styles.input} ${status.kind === "error" ? styles.inputInvalid : ""}`}
+          placeholder="0x… or name.eth"
+          value={value}
+          disabled={disabled}
+          spellCheck={false}
+          autoComplete="off"
+          autoCorrect="off"
+          inputMode="text"
+          aria-invalid={status.kind === "error"}
+          aria-describedby="recipient-hint"
+          onChange={(e) => onChange(e.target.value)}
+          onPaste={handlePaste}
+        />
+      </div>
+      <div id="recipient-hint" className={hintClass(status.kind)} aria-live="polite">
+        {status.kind === "ok" ? (
+          <span className={styles.hintOk}>
+            <CheckIcon size={13} />
+            {status.text}
+          </span>
+        ) : (
+          status.text
+        )}
+      </div>
+    </div>
+  );
+
+  function hintClass(kind: Status["kind"]) {
+    if (kind === "error") return `${styles.hint} ${styles.hintError}`;
+    return styles.hint;
+  }
+
+  function getStatus(args: {
+    trimmed: string;
+    isHexAddress: boolean;
+    ensQuery: string | undefined;
+    isResolving: boolean;
+    ensResolvedAddress: string | null;
+    ensError: boolean;
+  }): Status {
+    const { trimmed, isHexAddress, ensQuery, isResolving, ensResolvedAddress, ensError } = args;
+    if (!trimmed) return { kind: "idle", text: "Enter an address or ENS name." };
+
+    if (isHexAddress) {
+      const checksummed = getAddress(trimmed);
+      const suffix = reverseName ? ` · ${reverseName}` : "";
+      return { kind: "ok", text: `${truncateAddress(checksummed)}${suffix}` };
+    }
+
+    if (ensQuery) {
+      if (isResolving) return { kind: "idle", text: `Resolving ${trimmed}…` };
+      if (ensResolvedAddress) {
+        return { kind: "ok", text: `${trimmed} → ${truncateAddress(ensResolvedAddress)}` };
+      }
+      if (ensError) return { kind: "error", text: "Couldn’t resolve that ENS name." };
+      return { kind: "error", text: `No address found for ${trimmed}.` };
+    }
+
+    // Partial 0x input vs. outright garbage.
+    if (trimmed.startsWith("0x")) {
+      return { kind: "error", text: "That doesn’t look like a complete address." };
+    }
+    return { kind: "error", text: "Enter a valid 0x address or ENS name." };
+  }
+}
+
+type Status = { kind: "idle" | "ok" | "error"; text: string };
+
+function safeNormalize(name: string): string | undefined {
+  try {
+    return normalize(name);
+  } catch {
+    return undefined;
+  }
+}
