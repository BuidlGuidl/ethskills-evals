+/** @type {import('next').NextConfig} */
+const nextConfig = {
+  reactStrictMode: true,
+  webpack: (config, { webpack }) => {
+    // The Base Account connector (pulled in transitively by RainbowKit/wagmi)
+    // lazily references optional `@x402/*` payment packages we don't use and
+    // don't install. Ignore them so the build doesn't fail on missing modules.
+    config.plugins.push(
+      new webpack.IgnorePlugin({ resourceRegExp: /^@x402\// }),
+    );
+    config.resolve.alias = {
+      ...config.resolve.alias,
+      // Optional pretty-logger for WalletConnect — not needed in the browser.
+      "pino-pretty": false,
+      // React Native storage referenced by the MetaMask SDK — irrelevant on web.
+      "@react-native-async-storage/async-storage": false,
+    };
+    return config;
+  },
+};
+
+export default nextConfig;
