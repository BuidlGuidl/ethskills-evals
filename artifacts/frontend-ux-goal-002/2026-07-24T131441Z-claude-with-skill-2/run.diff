+/*
+ * Rule 6: semantic theme tokens, not a hardcoded dark wrapper.
+ * Light is the default; dark is opt-in via prefers-color-scheme so page
+ * background, surfaces, text, and borders stay coherent in both.
+ */
+:root {
+  --bg: #f6f7f9;
+  --surface: #ffffff;
+  --surface-muted: #f0f2f5;
+  --border: #e2e5ea;
+  --text: #0d1117;
+  --text-muted: #5b6472;
+  --primary: #2775ca; /* USDC blue */
+  --primary-text: #ffffff;
+  --primary-hover: #1f5fa8;
+  --success: #1a7f43;
+  --success-bg: #e7f6ec;
+  --danger: #c0362c;
+  --danger-bg: #fbeae8;
+  --warning: #8a5a00;
+  --warning-bg: #fdf3e0;
+  --focus: #2775ca;
+  --radius: 14px;
+  --shadow: 0 1px 2px rgba(13, 17, 23, 0.06), 0 8px 24px rgba(13, 17, 23, 0.06);
+}
+
+@media (prefers-color-scheme: dark) {
+  :root {
+    --bg: #0b0e13;
+    --surface: #151a21;
+    --surface-muted: #1c222b;
+    --border: #262d38;
+    --text: #e8ecf1;
+    --text-muted: #9aa4b2;
+    --primary: #4c95e8;
+    --primary-text: #06121f;
+    --primary-hover: #6aa9ef;
+    --success: #4ac47f;
+    --success-bg: #102a1b;
+    --danger: #f0776c;
+    --danger-bg: #2c1512;
+    --warning: #e0b25a;
+    --warning-bg: #2a2210;
+    --focus: #4c95e8;
+    --shadow: 0 1px 2px rgba(0, 0, 0, 0.4), 0 8px 24px rgba(0, 0, 0, 0.4);
+  }
+}
+
+* {
+  box-sizing: border-box;
+}
+
+html,
+body {
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  background: var(--bg);
+  color: var(--text);
+  font-family:
+    ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Helvetica,
+    Arial, sans-serif;
+  -webkit-font-smoothing: antialiased;
+  line-height: 1.5;
