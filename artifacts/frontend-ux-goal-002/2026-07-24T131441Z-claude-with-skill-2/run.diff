+"use client";
+
+import { useEffect, useMemo, useRef, useState } from "react";
+import {
+  formatUnits,
+  parseUnits,
+  type Address,
+  type Hash,
+} from "viem";
+import { mainnet } from "wagmi/chains";
+import {
+  useAccount,
+  useBalance,
+  useReadContract,
+  useSwitchChain,
+  useWaitForTransactionReceipt,
+  useWriteContract,
+} from "wagmi";
+import { useConnectModal } from "@rainbow-me/rainbowkit";
+import { useQueryClient } from "@tanstack/react-query";
+
+import { erc20Abi } from "@/lib/abi";
+import {
+  POLLING_INTERVAL_MS,
+  USDC_ADDRESS,
+  USDC_DECIMALS,
+  USDC_SYMBOL,
+} from "@/lib/constants";
+import { hasDedicatedRpc } from "@/lib/wagmi";
+import { parseTxError } from "@/lib/errors";
+import { formatTokenAmount, formatUsd, truncateAddress } from "@/lib/format";
+import { AddressField, type RecipientResolution } from "./AddressField";
+import { CopyButton } from "./CopyButton";
+import { AlertIcon, CheckIcon, ExternalIcon } from "./icons";
+import styles from "./pay.module.css";
+
+type SentInfo = { hash: Hash; to: Address; amount: string };
+
+export function PayForm() {
+  const { address, isConnected, chain } = useAccount();
+  const { openConnectModal } = useConnectModal();
+  const { switchChain, isPending: isSwitching } = useSwitchChain();
+  const queryClient = useQueryClient();
+
+  const [recipientInput, setRecipientInput] = useState("");
+  const [resolution, setResolution] = useState<RecipientResolution>({
+    address: null,
+    isResolving: false,
+  });
+  const [amount, setAmount] = useState("");
+
+  // Rule 1: transaction lifecycle states.
+  const [isSubmitting, setIsSubmitting] = useState(false); // click -> wallet returns hash
+  const [txHash, setTxHash] = useState<Hash | undefined>();
+  const [txError, setTxError] = useState<string | null>(null);
+  const [sent, setSent] = useState<SentInfo | null>(null);
+
+  const { writeContractAsync } = useWriteContract();
+  const {
+    isLoading: isConfirming,
+    isSuccess: isConfirmed,
+    isError: isReceiptError,
+  } = useWaitForTransactionReceipt({ hash: txHash });
+
+  const wrongNetwork = isConnected && chain?.id !== mainnet.id;
+
+  // Balances used for validation / MAX / gas warning.
+  const { data: usdcBalance } = useReadContract({
+    address: USDC_ADDRESS,
+    abi: erc20Abi,
+    functionName: "balanceOf",
+    args: address ? [address] : undefined,
+    query: {
+      enabled: Boolean(address),
+      refetchInterval: POLLING_INTERVAL_MS,
+    },
+  });
+
+  const { data: ethBalance } = useBalance({
+    address,
+    query: { enabled: Boolean(address), refetchInterval: POLLING_INTERVAL_MS },
+  });
+
+  // Parse the amount into base units, tracking validation reasons.
+  const parsedAmount = useMemo(() => parseAmount(amount), [amount]);
+  const amountExceedsBalance =
+    parsedAmount.value !== null &&
+    usdcBalance !== undefined &&
+    parsedAmount.value > usdcBalance;
+
+  const noEthForGas = ethBalance !== undefined && ethBalance.value === 0n;
+
+  // --- Success: reflect confirmed tx once, then refresh balances ---
+  const confirmedHandled = useRef<Hash | undefined>(undefined);
+  useEffect(() => {
+    if (isConfirmed && txHash && confirmedHandled.current !== txHash) {
+      confirmedHandled.current = txHash;
+      // Refresh balances immediately rather than waiting for the next poll.
+      queryClient.invalidateQueries();
+    }
+  }, [isConfirmed, txHash, queryClient]);
+
+  useEffect(() => {
+    if (isReceiptError && txHash) {
+      setTxError("The transaction failed to confirm on-chain.");
+      setTxHash(undefined);
+    }
+  }, [isReceiptError, txHash]);
+
+  const amountUsd =
+    parsedAmount.value !== null
+      ? formatUsd(Number(formatUnits(parsedAmount.value, USDC_DECIMALS)))
+      : null;
+
+  // Whether the send action is allowed to fire.
+  const canSend =
+    isConnected &&
+    !wrongNetwork &&
+    resolution.address !== null &&
+    !resolution.isResolving &&
+    parsedAmount.value !== null &&
+    parsedAmount.value > 0n &&
+    !amountExceedsBalance &&
+    !noEthForGas;
+
+  const busy = isSubmitting || isConfirming;
+
+  async function handleSend() {
+    if (!canSend || !resolution.address || parsedAmount.value === null) return;
+    setTxError(null);
+    setSent(null);
+    setTxHash(undefined);
+    confirmedHandled.current = undefined;
+    setIsSubmitting(true);
+    try {
+      const hash = await writeContractAsync({
+        address: USDC_ADDRESS,
+        abi: erc20Abi,
+        functionName: "transfer",
+        args: [resolution.address, parsedAmount.value],
+      });
+      setTxHash(hash);
+      setSent({
+        hash,
+        to: resolution.address,
+        amount: formatTokenAmount(parsedAmount.value, USDC_DECIMALS, 2),
+      });
+      // Clear the form now that it's in-flight.
+      setRecipientInput("");
+      setAmount("");
+      setResolution({ address: null, isResolving: false });
+    } catch (e) {
+      setTxError(parseTxError(e));
+    } finally {
+      // Always release — even on wallet rejection (Rule 1).
+      setIsSubmitting(false);
+    }
+  }
+
+  function setMax() {
+    if (usdcBalance === undefined) return;
+    setAmount(formatUnits(usdcBalance, USDC_DECIMALS));
+  }
+
+  return (
+    <div className={styles.card}>
+      {!hasDedicatedRpc && (
+        <div className={`${styles.alert} ${styles.alertWarning}`} role="status">
+          <AlertIcon />
+          <span>
+            No dedicated RPC configured — using a public endpoint. Set{" "}
+            <code>NEXT_PUBLIC_MAINNET_RPC_URL</code> before production.
+          </span>
+        </div>
+      )}
+
+      <AddressField
+        value={recipientInput}
+        onChange={(v) => {
+          setRecipientInput(v);
+          if (txError) setTxError(null);
+        }}
+        onResolvedChange={setResolution}
+        disabled={busy}
+      />
+
+      <div className={styles.field}>
+        <label className={styles.label} htmlFor="amount">
+          Amount
+        </label>
+        <div className={styles.inputWrap}>
+          <input
+            id="amount"
+            className={`${styles.input} ${styles.amountInput} ${
+              amountExceedsBalance || parsedAmount.error ? styles.inputInvalid : ""
+            }`}
+            placeholder="0.00"
+            value={amount}
+            disabled={busy}
+            inputMode="decimal"
+            autoComplete="off"
+            aria-invalid={Boolean(amountExceedsBalance || parsedAmount.error)}
+            aria-describedby="amount-hint"
+            onChange={(e) => {
+              setAmount(sanitizeAmountInput(e.target.value));
+              if (txError) setTxError(null);
+            }}
+          />
+          <div className={styles.suffix}>
+            <button
+              type="button"
+              className={styles.maxBtn}
+              onClick={setMax}
+              disabled={busy || usdcBalance === undefined || usdcBalance === 0n}
+            >
+              MAX
+            </button>
+            {USDC_SYMBOL}
+          </div>
+        </div>
+        <div id="amount-hint" className={amountHintClass()} aria-live="polite">
+          {amountHint()}
+        </div>
+      </div>
+
+      <PrimaryAction />
+
+      {noEthForGas && isConnected && !wrongNetwork && (
+        <div className={`${styles.alert} ${styles.alertWarning}`} role="status">
+          <AlertIcon />
+          <span>
+            You have 0 ETH — you need some ETH to pay gas before you can send
+            USDC.
+          </span>
+        </div>
+      )}
+
+      {txError && (
+        <div className={`${styles.alert} ${styles.alertError}`} role="alert">
+          <AlertIcon />
+          <span>{txError}</span>
+        </div>
+      )}
+
+      {sent && (
+        <SuccessPanel sent={sent} isConfirming={isConfirming} confirmed={isConfirmed} />
+      )}
+    </div>
+  );
+
+  // ----- sub-renders -----
+
+  function PrimaryAction() {
+    // Rule 2: exactly one primary action, wrong-network checked before send.
+    if (!isConnected) {
+      return (
+        <button
+          type="button"
+          className={styles.actionBtn}
+          onClick={() => openConnectModal?.()}
+        >
+          Connect Wallet
+        </button>
+      );
+    }
+
+    if (wrongNetwork) {
+      return (
+        <button
+          type="button"
+          className={styles.actionBtn}
+          disabled={isSwitching}
+          onClick={() => switchChain({ chainId: mainnet.id })}
+        >
+          {isSwitching ? (
+            <>
+              <span className={styles.spinner} aria-hidden="true" />
+              Switching…
+            </>
+          ) : (
+            "Switch to Ethereum"
+          )}
+        </button>
+      );
+    }
+
+    return (
+      <button
+        type="button"
+        className={styles.actionBtn}
+        disabled={!canSend || busy}
+        onClick={handleSend}
+      >
+        {isSubmitting ? (
+          <>
+            <span className={styles.spinner} aria-hidden="true" />
+            Confirm in your wallet…
+          </>
+        ) : isConfirming ? (
+          <>
+            <span className={styles.spinner} aria-hidden="true" />
+            Sending USDC…
+          </>
+        ) : (
+          "Send USDC"
+        )}
+      </button>
+    );
+  }
+
+  function amountHint() {
+    if (parsedAmount.error) return parsedAmount.error;
+    if (amountExceedsBalance) return "Amount exceeds your USDC balance.";
+    if (amountUsd && parsedAmount.value! > 0n) return `≈ ${amountUsd}`;
+    return usdcBalance !== undefined
+      ? `Balance: ${formatTokenAmount(usdcBalance, USDC_DECIMALS, 2)} ${USDC_SYMBOL}`
+      : " ";
+  }
+
+  function amountHintClass() {
+    if (parsedAmount.error || amountExceedsBalance)
+      return `${styles.hint} ${styles.hintError}`;
+    return styles.hint;
+  }
+}
+
+function SuccessPanel({
+  sent,
+  isConfirming,
+  confirmed,
+}: {
+  sent: SentInfo;
+  isConfirming: boolean;
+  confirmed: boolean;
+}) {
+  const explorer = `https://etherscan.io/tx/${sent.hash}`;
+  return (
+    <div
+      className={`${styles.alert} ${confirmed ? styles.alertSuccess : styles.alertWarning}`}
+      role="status"
+      style={{ flexDirection: "column" }}
+    >
+      <div style={{ display: "flex", alignItems: "center", gap: 8, fontWeight: 700 }}>
+        {confirmed ? <CheckIcon /> : <span className={styles.spinner} aria-hidden="true" />}
+        {confirmed
+          ? `Sent ${sent.amount} USDC`
+          : `Sending ${sent.amount} USDC…`}
+      </div>
+      <div style={{ width: "100%", marginTop: 8 }}>
+        <div className={styles.summaryRow}>
+          <span className={styles.summaryLabel}>To</span>
+          <span className={styles.summaryValue}>
+            {truncateAddress(sent.to)}
+            <CopyButton value={sent.to} />
+          </span>
+        </div>
+        <div className={styles.summaryRow}>
+          <span className={styles.summaryLabel}>Transaction</span>
+          <a className={styles.explorerLink} href={explorer} target="_blank" rel="noopener noreferrer">
+            {truncateAddress(sent.hash, 6)}
+            <ExternalIcon />
+          </a>
+        </div>
+      </div>
+      {isConfirming && (
+        <span className={styles.hint} style={{ marginTop: 4 }}>
+          Waiting for on-chain confirmation…
+        </span>
+      )}
+    </div>
+  );
+}
+
+// --- amount parsing helpers ---
+
+type ParsedAmount = { value: bigint | null; error: string | null };
+
+function parseAmount(raw: string): ParsedAmount {
+  const trimmed = raw.trim();
+  if (!trimmed) return { value: null, error: null };
+  if (!/^\d*\.?\d*$/.test(trimmed) || trimmed === ".") {
+    return { value: null, error: "Enter a valid number." };
+  }
+  const [, fraction = ""] = trimmed.split(".");
+  if (fraction.length > USDC_DECIMALS) {
+    return { value: null, error: `USDC supports up to ${USDC_DECIMALS} decimals.` };
+  }
+  try {
+    const value = parseUnits(trimmed, USDC_DECIMALS);
+    if (value <= 0n) return { value: null, error: null };
+    return { value, error: null };
+  } catch {
+    return { value: null, error: "Enter a valid number." };
+  }
+}
+
+/** Keep only digits and a single decimal point as the user types. */
+function sanitizeAmountInput(raw: string): string {
+  let v = raw.replace(/[^\d.]/g, "");
+  const firstDot = v.indexOf(".");
+  if (firstDot !== -1) {
+    v = v.slice(0, firstDot + 1) + v.slice(firstDot + 1).replace(/\./g, "");
+  }
+  return v;
+}
