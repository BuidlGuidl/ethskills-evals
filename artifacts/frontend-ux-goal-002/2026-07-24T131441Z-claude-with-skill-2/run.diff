+# --- RPC (Rule 5: use a dedicated provider in production, not a public fallback) ---
+# An authenticated mainnet HTTP RPC endpoint (Alchemy, Infura, Ankr, etc.).
+# If unset, the app falls back to a public RPC — fine for local dev, NOT for production.
+NEXT_PUBLIC_MAINNET_RPC_URL="https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY"
+
+# --- WalletConnect ---
+# Required for WalletConnect-based wallets in RainbowKit.
+# Get one free at https://cloud.walletconnect.com
+NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID="YOUR_WALLETCONNECT_PROJECT_ID"
+
+# --- Metadata (Rule 8) ---
+# Absolute base URL of the deployed app, used for Open Graph / Twitter image URLs.
+NEXT_PUBLIC_APP_URL="https://usdc-pay.example.com"
