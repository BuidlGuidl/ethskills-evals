+import { getDefaultConfig } from "@rainbow-me/rainbowkit";
+import { http } from "wagmi";
+import { mainnet } from "wagmi/chains";
+
+// Dedicated RPC (Rule 5). Falls back to a public endpoint only for local dev —
+// ship with NEXT_PUBLIC_RPC_URL set to your own provider.
+const rpcUrl = process.env.NEXT_PUBLIC_RPC_URL || "https://cloudflare-eth.com";
+
+// WalletConnect needs a non-empty project id or getDefaultConfig throws. The
+// placeholder keeps builds and injected/browser wallets working locally; set
+// NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID from cloud.reown.com to enable the
+// WalletConnect/mobile-wallet flow in production.
+const walletConnectProjectId =
+  process.env.NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID ||
+  "00000000000000000000000000000000";
+
+export const wagmiConfig = getDefaultConfig({
+  appName: "USDC Pay",
+  projectId: walletConnectProjectId,
+  chains: [mainnet],
+  transports: {
+    [mainnet.id]: http(rpcUrl, {
+      // Batch multicalls so balance + price reads collapse into few requests.
+      batch: true,
+    }),
+  },
+  ssr: true,
+});
