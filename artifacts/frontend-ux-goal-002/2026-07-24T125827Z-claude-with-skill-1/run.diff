@@ -0,0 +1,46 @@
+import { formatUnits } from "viem";
+
+/** Compact, locale-aware token amount (e.g. "1,234.56"). */
+export function formatTokenAmount(
+  value: bigint,
+  decimals: number,
+  maxFractionDigits = 4,
+): string {
+  const num = Number(formatUnits(value, decimals));
+  return num.toLocaleString("en-US", {
+    minimumFractionDigits: 0,
+    maximumFractionDigits: maxFractionDigits,
+  });
+}
+
+/** USD string with a leading ~ to signal it is an estimate. */
+export function formatUsd(value: number): string {
+  if (!Number.isFinite(value)) return "";
+  return `~${value.toLocaleString("en-US", {
+    style: "currency",
+    currency: "USD",
+    minimumFractionDigits: 2,
+    maximumFractionDigits: 2,
+  })}`;
+}
+
+/**
+ * USD value of a raw token amount given a Chainlink price (8-decimal int).
+ * Returns a JS number — fine for display, never for onchain math.
+ */
+export function tokenToUsd(
+  rawAmount: bigint,
+  tokenDecimals: number,
+  priceAnswer: bigint,
+  priceDecimals: number,
+): number {
+  const amount = Number(formatUnits(rawAmount, tokenDecimals));
+  const price = Number(formatUnits(priceAnswer, priceDecimals));
+  return amount * price;
+}
+
+/** Truncate an address as 0x1234…abcd. */
+export function truncateAddress(address: string, chars = 4): string {
+  if (address.length < 2 + chars * 2) return address;
+  return `${address.slice(0, 2 + chars)}…${address.slice(-chars)}`;
+}
