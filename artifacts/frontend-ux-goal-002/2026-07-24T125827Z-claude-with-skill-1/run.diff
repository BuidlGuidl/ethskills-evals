index 0000000..f41a5ef
--- /dev/null
+++ b/lib/errors.ts
@@ -0,0 +1,48 @@
+import {
+  BaseError,
+  ContractFunctionRevertedError,
+  UserRejectedRequestError,
+} from "viem";
+
+/**
+ * Turn any wallet/RPC/contract error into a short, human-readable line.
+ * Never surface a raw revert selector or a 400-line stack to the user.
+ * See frontend-ux Rule 7.
+ */
+export function parseTxError(err: unknown): string {
+  if (!err) return "Something went wrong. Please try again.";
+
+  if (err instanceof BaseError) {
+    // User dismissed / rejected in wallet — most common, not an error state.
+    const rejected = err.walk((e) => e instanceof UserRejectedRequestError);
+    if (rejected) return "Transaction rejected in your wallet.";
+
+    // Solidity revert (custom error or reason string).
+    const reverted = err.walk((e) => e instanceof ContractFunctionRevertedError);
+    if (reverted instanceof ContractFunctionRevertedError) {
+      const name = reverted.data?.errorName ?? "";
+      const reason = reverted.reason ?? "";
+      if (/balance|insufficient/i.test(name + reason)) {
+        return "Insufficient USDC balance for this transfer.";
+      }
+      if (reason) return `Transfer reverted: ${reason}`;
+      if (name) return `Transfer reverted: ${name}`;
+      return "The transfer was reverted by the token contract.";
+    }
+
+    const short = err.shortMessage || err.message;
+    if (/insufficient funds/i.test(short)) {
+      return "Not enough ETH to cover gas for this transaction.";
+    }
+    if (/gas required exceeds|out of gas/i.test(short)) {
+      return "Gas estimation failed — the transaction would likely revert.";
+    }
+    if (/nonce/i.test(short)) {
+      return "Nonce error — a previous transaction may still be pending.";
+    }
+    return short || "The transaction failed. Please try again.";
+  }
+
+  if (err instanceof Error) return err.message;
+  return "Something went wrong. Please try again.";
+}
