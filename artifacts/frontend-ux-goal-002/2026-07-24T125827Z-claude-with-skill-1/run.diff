+"use client";
+
+import { ConnectButton } from "@rainbow-me/rainbowkit";
+import { useAccount } from "wagmi";
+import { Balances, hasLowGas } from "@/components/Balances";
+import { PayForm } from "@/components/PayForm";
+import { useBalances } from "@/hooks/useBalances";
+import { usePrices } from "@/hooks/usePrices";
+import styles from "./pay.module.css";
+
+export default function PayPage() {
+  const { address, isConnected } = useAccount();
+  const { ethBalance, usdcBalance, isLoading, refetch } = useBalances(address);
+  const { ethUsd, usdcUsd } = usePrices();
+
+  const lowGas = isConnected && hasLowGas(ethBalance);
+
+  return (
+    <div className={styles.page}>
+      <header className={styles.header}>
+        <div className={styles.brand}>
+          <Logo />
+          USDC Pay
+        </div>
+        <ConnectButton
+          accountStatus={{ smallScreen: "avatar", largeScreen: "full" }}
+          chainStatus="icon"
+          showBalance={false}
+        />
+      </header>
+
+      <main className={styles.main}>
+        <h1 className={styles.title}>Send USDC</h1>
+        <p className={styles.subtitle}>
+          Pay anyone on Ethereum mainnet. Amounts show live USD value so you
+          always know what you&apos;re sending.
+        </p>
+
+        {isConnected && (
+          <Balances
+            ethBalance={ethBalance}
+            usdcBalance={usdcBalance}
+            ethUsd={ethUsd}
+            usdcUsd={usdcUsd}
+            isLoading={isLoading}
+          />
+        )}
+
+        {lowGas && (
+          <div className={`${styles.banner} ${styles.bannerWarning}`} role="status">
+            <span aria-hidden>⛽</span>
+            <span>
+              Your ETH balance is very low. You need ETH to pay gas for a USDC
+              transfer, or it may fail.
+            </span>
+          </div>
+        )}
+
+        <PayForm usdcBalance={usdcBalance} usdcUsd={usdcUsd} onSuccess={refetch} />
+
+        {!isConnected && (
+          <p className={styles.connectNudge}>
+            Connect your wallet to see balances and send USDC.
+          </p>
+        )}
+      </main>
+
+      <footer className={styles.footer}>
+        USDC · Ethereum mainnet ·{" "}
+        <a
+          href="https://etherscan.io/token/0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48"
+          target="_blank"
+          rel="noopener noreferrer"
+        >
+          Verify the token contract ↗
+        </a>
+      </footer>
+    </div>
+  );
+}
+
+function Logo() {
+  return (
+    <svg className={styles.brandMark} viewBox="0 0 32 32" fill="none" aria-hidden>
+      <circle cx="16" cy="16" r="16" fill="#2775ca" />
+      <path
+        d="M16 7v2.2M16 22.8V25"
+        stroke="#fff"
+        strokeWidth="1.6"
+        strokeLinecap="round"
+      />
+      <path
+        d="M19.4 11.8c-.5-1.3-1.8-2-3.4-2-2 0-3.4 1-3.4 2.6 0 1.5 1.1 2.2 3.2 2.7 2 .5 3.4 1.1 3.4 2.9 0 1.7-1.5 2.8-3.6 2.8-1.9 0-3.3-.8-3.8-2.2"
+        stroke="#fff"
+        strokeWidth="1.6"
+        strokeLinecap="round"
+      />
+    </svg>
+  );
+}
