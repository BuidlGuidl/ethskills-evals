@@ -0,0 +1,80 @@
+"use client";
+
+import { formatUnits } from "viem";
+import styles from "@/app/pay/pay.module.css";
+import { CHAINLINK_DECIMALS, USDC_DECIMALS } from "@/lib/contracts";
+import { formatTokenAmount, formatUsd, tokenToUsd } from "@/lib/format";
+
+function Skeleton() {
+  return <span className={styles.skeleton} aria-hidden />;
+}
+
+/** ETH (for gas) and USDC balances, each with live USD context (Rule 4). */
+export function Balances({
+  ethBalance,
+  usdcBalance,
+  ethUsd,
+  usdcUsd,
+  isLoading,
+}: {
+  ethBalance?: bigint;
+  usdcBalance?: bigint;
+  ethUsd?: bigint;
+  usdcUsd?: bigint;
+  isLoading: boolean;
+}) {
+  const usdcUsdValue =
+    usdcBalance !== undefined && usdcUsd !== undefined
+      ? tokenToUsd(usdcBalance, USDC_DECIMALS, usdcUsd, CHAINLINK_DECIMALS)
+      : undefined;
+
+  const ethUsdValue =
+    ethBalance !== undefined && ethUsd !== undefined
+      ? tokenToUsd(ethBalance, 18, ethUsd, CHAINLINK_DECIMALS)
+      : undefined;
+
+  return (
+    <div className={styles.balances}>
+      <div className={styles.balanceCard}>
+        <div className={styles.balanceLabel}>
+          <span className={styles.tokenDot} style={{ background: "#2775ca" }} />
+          Your USDC
+        </div>
+        <div className={styles.balanceValue}>
+          {isLoading || usdcBalance === undefined ? (
+            <Skeleton />
+          ) : (
+            <>{formatTokenAmount(usdcBalance, USDC_DECIMALS, 2)}</>
+          )}
+        </div>
+        <div className={styles.balanceUsd}>
+          {usdcUsdValue !== undefined ? formatUsd(usdcUsdValue) : " "}
+        </div>
+      </div>
+
+      <div className={styles.balanceCard}>
+        <div className={styles.balanceLabel}>
+          <span className={styles.tokenDot} style={{ background: "#627eea" }} />
+          Your ETH (gas)
+        </div>
+        <div className={styles.balanceValue}>
+          {isLoading || ethBalance === undefined ? (
+            <Skeleton />
+          ) : (
+            <>{formatTokenAmount(ethBalance, 18, 4)}</>
+          )}
+        </div>
+        <div className={styles.balanceUsd}>
+          {ethUsdValue !== undefined ? formatUsd(ethUsdValue) : " "}
+        </div>
+      </div>
+    </div>
+  );
+}
+
+/** Rough "do you have enough ETH for gas" heuristic used for the warning. */
+export function hasLowGas(ethBalance?: bigint): boolean {
+  if (ethBalance === undefined) return false;
+  // ~0.001 ETH — below this a mainnet ERC-20 transfer may not confirm.
+  return Number(formatUnits(ethBalance, 18)) < 0.001;
+}
diff --git a/components/PayForm.tsx b/components/PayForm.tsx
new file mode 100644
index 0000000..2b29b23
--- /dev/null
+++ b/components/PayForm.tsx
@@ -0,0 +1,353 @@
+"use client";
+
+import { useConnectModal } from "@rainbow-me/rainbowkit";
+import { useEffect, useMemo, useState } from "react";
+import { type Hash, parseUnits } from "viem";
+import { mainnet } from "viem/chains";
+import {
+  useAccount,
+  useSwitchChain,
+  useWaitForTransactionReceipt,
+  useWriteContract,
+} from "wagmi";
+import styles from "@/app/pay/pay.module.css";
+import {
+  CHAINLINK_DECIMALS,
+  ERC20_ABI,
+  USDC_ADDRESS,
+  USDC_DECIMALS,
+} from "@/lib/contracts";
+import { parseTxError } from "@/lib/errors";
+import { formatTokenAmount, formatUsd, tokenToUsd, truncateAddress } from "@/lib/format";
+import { useRecipient } from "@/hooks/useRecipient";
+
+const EXPLORER = mainnet.blockExplorers.default.url;
+
+// Allow only a well-formed decimal with up to 6 fractional digits (USDC).
+const AMOUNT_RE = /^\d*\.?\d{0,6}$/;
+
+type Props = {
+  usdcBalance?: bigint;
+  usdcUsd?: bigint;
+  onSuccess: () => void;
+};
+
+export function PayForm({ usdcBalance, usdcUsd, onSuccess }: Props) {
+  const { address, isConnected, chainId } = useAccount();
+  const { openConnectModal } = useConnectModal();
+  const { switchChain, isPending: isSwitching } = useSwitchChain();
+
+  const [recipientInput, setRecipientInput] = useState("");
+  const [amountInput, setAmountInput] = useState("");
+  const [submitting, setSubmitting] = useState(false);
+  const [pendingHash, setPendingHash] = useState<Hash | undefined>();
+  const [successHash, setSuccessHash] = useState<Hash | undefined>();
+  const [txError, setTxError] = useState<string | null>(null);
+
+  const recipient = useRecipient(recipientInput);
+  const { writeContractAsync } = useWriteContract();
+
+  const receipt = useWaitForTransactionReceipt({
+    hash: pendingHash,
+    query: { enabled: !!pendingHash },
+  });
+  const isConfirming = !!pendingHash && receipt.isLoading;
+
+  // Resolve the amount once, reused for validation + USD preview + send.
+  const amount = useMemo(() => {
+    if (!amountInput || amountInput === ".") {
+      return { raw: undefined as bigint | undefined, error: undefined as string | undefined };
+    }
+    let raw: bigint;
+    try {
+      raw = parseUnits(amountInput, USDC_DECIMALS);
+    } catch {
+      return { raw: undefined, error: "Enter a valid amount." };
+    }
+    if (raw <= 0n) return { raw: undefined, error: "Amount must be greater than 0." };
+    if (usdcBalance !== undefined && raw > usdcBalance) {
+      return { raw: undefined, error: "Amount exceeds your USDC balance." };
+    }
+    return { raw, error: undefined };
+  }, [amountInput, usdcBalance]);
+
+  const amountUsd =
+    amount.raw !== undefined && usdcUsd !== undefined
+      ? tokenToUsd(amount.raw, USDC_DECIMALS, usdcUsd, CHAINLINK_DECIMALS)
+      : undefined;
+
+  const onRightChain = chainId === mainnet.id;
+  const canSend =
+    isConnected &&
+    onRightChain &&
+    recipient.isValid &&
+    !!recipient.address &&
+    amount.raw !== undefined &&
+    !submitting &&
+    !isConfirming;
+
+  // Editing after a completed send clears the old success banner.
+  function clearResult() {
+    if (successHash) setSuccessHash(undefined);
+    if (txError) setTxError(null);
+  }
+
+  // Watch the receipt: promote to success, or surface an onchain revert.
+  useEffect(() => {
+    if (!pendingHash || !receipt.data) return;
+    if (receipt.data.status === "success") {
+      setSuccessHash(pendingHash);
+      setTxError(null);
+      setAmountInput("");
+      onSuccess();
+    } else {
+      setTxError("The transfer was reverted onchain. No USDC was sent.");
+    }
+    setPendingHash(undefined);
+  }, [pendingHash, receipt.data, onSuccess]);
+
+  async function handleSend() {
+    if (!recipient.address || amount.raw === undefined) return;
+    setTxError(null);
+    setSuccessHash(undefined);
+    setSubmitting(true); // disable immediately (Rule 1)
+    try {
+      const hash = await writeContractAsync({
+        address: USDC_ADDRESS,
+        abi: ERC20_ABI,
+        functionName: "transfer",
+        args: [recipient.address, amount.raw],
+      });
+      setPendingHash(hash); // hands off to the confirming state
+    } catch (e) {
+      setTxError(parseTxError(e));
+    } finally {
+      setSubmitting(false); // always release — even on wallet rejection
+    }
+  }
+
+  function renderButton() {
+    if (!isConnected) {
+      return (
+        <button className={styles.action} onClick={openConnectModal} type="button">
+          Connect Wallet
+        </button>
+      );
+    }
+    if (!onRightChain) {
+      return (
+        <button
+          className={styles.action}
+          type="button"
+          disabled={isSwitching}
+          onClick={() => switchChain({ chainId: mainnet.id })}
+        >
+          {isSwitching ? (
+            <>
+              <span className={styles.spinner} /> Switching…
+            </>
+          ) : (
+            "Switch to Ethereum"
+          )}
+        </button>
+      );
+    }
+    if (submitting) {
+      return (
+        <button className={styles.action} type="button" disabled>
+          <span className={styles.spinner} /> Confirm in your wallet…
+        </button>
+      );
+    }
+    if (isConfirming) {
+      return (
+        <button className={styles.action} type="button" disabled>
+          <span className={styles.spinner} /> Sending USDC…
+        </button>
+      );
+    }
+    return (
+      <button
+        className={styles.action}
+        type="button"
+        disabled={!canSend}
+        onClick={handleSend}
+      >
+        {amount.raw !== undefined && recipient.isValid
+          ? `Send ${formatTokenAmount(amount.raw, USDC_DECIMALS, 2)} USDC`
+          : "Send USDC"}
+      </button>
+    );
+  }
+
+  return (
+    <div className={styles.card}>
+      {/* Recipient */}
+      <div className={styles.field}>
+        <div className={styles.fieldLabelRow}>
+          <label className={styles.label} htmlFor="recipient">
+            Recipient
+          </label>
+          <span className={styles.hint}>address or ENS</span>
+        </div>
+        <div
+          className={`${styles.inputWrap} ${
+            recipient.error ? styles.inputWrapError : ""
+          }`}
+        >
+          <input
+            id="recipient"
+            className={styles.input}
+            placeholder="0x… or name.eth"
+            value={recipientInput}
+            spellCheck={false}
+            autoComplete="off"
+            onChange={(e) => {
+              clearResult();
+              setRecipientInput(e.target.value);
+            }}
+          />
+        </div>
+        <div className={styles.subline}>
+          {recipient.isResolving && (
+            <span className={styles.usdPreview}>Resolving ENS…</span>
+          )}
+          {!recipient.isResolving && recipient.isValid && recipient.address && (
+            <span className={styles.resolved}>
+              <CheckIcon />
+              {recipient.isEns
+                ? `${recipient.ensName} → ${truncateAddress(recipient.address)}`
+                : recipient.ensName
+                  ? `${recipient.ensName} · ${truncateAddress(recipient.address)}`
+                  : truncateAddress(recipient.address, 6)}
+            </span>
+          )}
+          {!recipient.isResolving && recipient.error && (
+            <span className={styles.fieldError}>{recipient.error}</span>
+          )}
+        </div>
+      </div>
+
+      {/* Amount */}
+      <div className={styles.field}>
+        <div className={styles.fieldLabelRow}>
+          <label className={styles.label} htmlFor="amount">
+            Amount
+          </label>
+          <span className={styles.hint}>
+            Balance:{" "}
+            {usdcBalance !== undefined
+              ? `${formatTokenAmount(usdcBalance, USDC_DECIMALS, 2)} USDC`
+              : "—"}
+          </span>
+        </div>
+        <div
+          className={`${styles.inputWrap} ${
+            amount.error ? styles.inputWrapError : ""
+          }`}
+        >
+          <input
+            id="amount"
+            className={styles.input}
+            placeholder="0.00"
+            inputMode="decimal"
+            value={amountInput}
+            onChange={(e) => {
+              const v = e.target.value;
+              if (v === "" || AMOUNT_RE.test(v)) {
+                clearResult();
+                setAmountInput(v);
+              }
+            }}
+          />
+          <div className={styles.suffix}>
+            {usdcBalance !== undefined && usdcBalance > 0n && (
+              <button
+                type="button"
+                className={styles.maxBtn}
+                onClick={() => {
+                  clearResult();
+                  setAmountInput(formatTokenAmount(usdcBalance, USDC_DECIMALS, 6).replace(/,/g, ""));
+                }}
+              >
+                MAX
+              </button>
+            )}
+            USDC
+          </div>
+        </div>
+        <div className={styles.subline}>
+          <span className={styles.usdPreview}>
+            {amountUsd !== undefined ? formatUsd(amountUsd) : " "}
+          </span>
+          {amount.error && <span className={styles.fieldError}>{amount.error}</span>}
+        </div>
+      </div>
+
+      {/* Confirmation summary */}
+      {canSend && recipient.address && amount.raw !== undefined && (
+        <div className={styles.summary}>
+          <div className={styles.summaryRow}>
+            <span className={styles.summaryLabel}>Sending</span>
+            <span className={styles.summaryValue}>
+              {formatTokenAmount(amount.raw, USDC_DECIMALS, 2)} USDC
+              {amountUsd !== undefined ? ` (${formatUsd(amountUsd)})` : ""}
+            </span>
+          </div>
+          <div className={styles.summaryRow}>
+            <span className={styles.summaryLabel}>To</span>
+            <span className={styles.summaryValue}>
+              {recipient.isEns && recipient.ensName
+                ? `${recipient.ensName} (${truncateAddress(recipient.address)})`
+                : truncateAddress(recipient.address, 6)}
+            </span>
+          </div>
+        </div>
+      )}
+
+      <div style={{ marginTop: 16 }}>{renderButton()}</div>
+
+      {/* Feedback (Rule 7) */}
+      {txError && (
+        <div className={`${styles.banner} ${styles.bannerError}`} role="alert">
+          <WarnIcon />
+          <span>{txError}</span>
+        </div>
+      )}
+      {successHash && (
+        <div className={`${styles.banner} ${styles.bannerSuccess}`} role="status">
+          <CheckIcon />
+          <span>
+            USDC sent.{" "}
+            <a
+              className={styles.bannerLink}
+              href={`${EXPLORER}/tx/${successHash}`}
+              target="_blank"
+              rel="noopener noreferrer"
+            >
+              View on Etherscan ↗
+            </a>
+          </span>
+        </div>
+      )}
+    </div>
+  );
+}
+
+function CheckIcon() {
+  return (
+    <svg className={styles.bannerIcon} width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden>
+      <path d="M13.5 4.5L6.5 11.5L3 8" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" />
+    </svg>
+  );
+}
+
+function WarnIcon() {
+  return (
+    <svg className={styles.bannerIcon} width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden>
+      <path d="M8 1.5L15 14H1L8 1.5Z" stroke="currentColor" strokeWidth="1.5" strokeLinejoin="round" />
+      <path d="M8 6.5V9.5" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" />
+      <circle cx="8" cy="11.6" r="0.9" fill="currentColor" />
+    </svg>
+  );
+}
