+/** @type {import('next').NextConfig} */
+const nextConfig = {
+  reactStrictMode: true,
+  webpack: (config, { webpack }) => {
+    // Silence optional deps that wallet connectors pull in but we don't use.
+    // WalletConnect logs via pino; the Base Account connector references the
+    // optional @x402/* payment modules, which ship as optional peers.
+    config.externals.push("pino-pretty", "lokijs", "encoding");
+    config.plugins.push(
+      new webpack.IgnorePlugin({ resourceRegExp: /^@x402\// }),
+    );
+    return config;
+  },
+};
+
+export default nextConfig;
