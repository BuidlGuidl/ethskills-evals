+import type { Metadata } from "next";
+import { ReactNode } from "react";
+import { Providers } from "./providers";
+import "./globals.css";
+
+const siteUrl = process.env.NEXT_PUBLIC_SITE_URL || "https://usdc-pay.example";
+
+export const metadata: Metadata = {
+  metadataBase: new URL(siteUrl),
+  title: "USDC Pay — Send USDC on Ethereum",
+  description:
+    "Connect your wallet and send USDC to anyone on Ethereum mainnet. See your USDC and ETH balances with live USD value before you pay.",
+  applicationName: "USDC Pay",
+  icons: {
+    icon: [{ url: "/icon.svg", type: "image/svg+xml" }],
+    apple: [{ url: "/icon.svg" }],
+  },
+  openGraph: {
+    type: "website",
+    url: siteUrl,
+    siteName: "USDC Pay",
+    title: "USDC Pay — Send USDC on Ethereum",
+    description:
+      "Connect your wallet and send USDC to anyone on Ethereum mainnet, with live USD context.",
+    images: [
+      {
+        url: "/og.svg",
+        width: 1200,
+        height: 630,
+        alt: "USDC Pay — send USDC on Ethereum",
+      },
+    ],
+  },
+  twitter: {
+    card: "summary_large_image",
+    title: "USDC Pay — Send USDC on Ethereum",
+    description:
+      "Connect your wallet and send USDC to anyone on Ethereum mainnet, with live USD context.",
+    images: ["/og.svg"],
+  },
+};
+
+export default function RootLayout({ children }: { children: ReactNode }) {
+  return (
+    <html lang="en">
+      <body>
+        <Providers>{children}</Providers>
+      </body>
+    </html>
+  );
+}
