--- /dev/null
+++ b/hooks/useBalances.ts
@@ -0,0 +1,35 @@
+"use client";
+
+import { type Address } from "viem";
+import { useBalance, useReadContract } from "wagmi";
+import { ERC20_ABI, USDC_ADDRESS } from "@/lib/contracts";
+
+/**
+ * The account's ETH balance (for gas) and USDC balance. Both refetch on new
+ * blocks and expose a `refetch` so the UI can refresh right after a transfer
+ * confirms instead of waiting for the next poll.
+ */
+export function useBalances(address?: Address) {
+  const eth = useBalance({
+    address,
+    query: { enabled: !!address },
+  });
+
+  const usdc = useReadContract({
+    address: USDC_ADDRESS,
+    abi: ERC20_ABI,
+    functionName: "balanceOf",
+    args: address ? [address] : undefined,
+    query: { enabled: !!address },
+  });
+
+  return {
+    ethBalance: eth.data?.value,
+    usdcBalance: usdc.data as bigint | undefined,
+    isLoading: eth.isLoading || usdc.isLoading,
+    refetch: () => {
+      eth.refetch();
+      usdc.refetch();
+    },
+  };
+}
diff --git a/hooks/usePrices.ts b/hooks/usePrices.ts
new file mode 100644
index 0000000..03e1b56
--- /dev/null
+++ b/hooks/usePrices.ts
@@ -0,0 +1,49 @@
+"use client";
+
+import { useReadContracts } from "wagmi";
+import {
+  CHAINLINK_AGGREGATOR_ABI,
+  CHAINLINK_ETH_USD,
+  CHAINLINK_USDC_USD,
+} from "@/lib/contracts";
+
+/**
+ * ETH/USD and USDC/USD from Chainlink, read onchain. Returns the raw 8-decimal
+ * answers so callers can compute USD via tokenToUsd(). Refreshed periodically
+ * by wagmi's poller; prices move slowly so this stays cheap.
+ */
+export function usePrices() {
+  const query = useReadContracts({
+    allowFailure: true,
+    contracts: [
+      {
+        address: CHAINLINK_ETH_USD,
+        abi: CHAINLINK_AGGREGATOR_ABI,
+        functionName: "latestRoundData",
+      },
+      {
+        address: CHAINLINK_USDC_USD,
+        abi: CHAINLINK_AGGREGATOR_ABI,
+        functionName: "latestRoundData",
+      },
+    ],
+    query: {
+      // Prices drift slowly — no need to hammer the RPC every few seconds.
+      staleTime: 60_000,
+      refetchInterval: 60_000,
+    },
+  });
+
+  const ethAnswer =
+    query.data?.[0]?.status === "success"
+      ? (query.data[0].result[1] as bigint)
+      : undefined;
+
+  // USDC is a dollar stablecoin; if the feed hiccups, fall back to $1.00 (1e8).
+  const usdcAnswer =
+    query.data?.[1]?.status === "success"
+      ? (query.data[1].result[1] as bigint)
+      : 100_000_000n;
+
+  return { ethUsd: ethAnswer, usdcUsd: usdcAnswer, isLoading: query.isLoading };
+}
diff --git a/hooks/useRecipient.ts b/hooks/useRecipient.ts
new file mode 100644
index 0000000..ef0b633
--- /dev/null
+++ b/hooks/useRecipient.ts
@@ -0,0 +1,127 @@
+"use client";
+
+import { useMemo } from "react";
+import { type Address, getAddress, isAddress } from "viem";
+import { normalize } from "viem/ens";
+import { useEnsAddress, useEnsName } from "wagmi";
+import { mainnet } from "wagmi/chains";
+
+export type RecipientState = {
+  /** Checksummed address to send to, once resolved & valid. */
+  address?: Address;
+  /** ENS name (typed or reverse-resolved) for display. */
+  ensName?: string;
+  isEns: boolean;
+  isResolving: boolean;
+  /** True only when we have a concrete, sendable address. */
+  isValid: boolean;
+  error?: string;
+};
+
+/** Strip whitespace/hidden chars that survive a paste. */
+export function normalizeRecipientInput(raw: string): string {
+  return raw.replace(/\s+/g, "").trim();
+}
+
+/**
+ * Resolve a recipient from either a hex address or an ENS name.
+ * Handles validation, ENS forward + reverse resolution, and error messaging.
+ */
+export function useRecipient(rawInput: string): RecipientState {
+  const value = normalizeRecipientInput(rawInput);
+  const looksLikeEns = value.includes(".") && !value.startsWith("0x");
+  const looksLikeHex = value.startsWith("0x");
+
+  // Forward: name -> address.
+  let normalizedEns: string | undefined;
+  try {
+    normalizedEns = looksLikeEns ? normalize(value) : undefined;
+  } catch {
+    normalizedEns = undefined;
+  }
+
+  const ensAddress = useEnsAddress({
+    name: normalizedEns,
+    chainId: mainnet.id,
+    query: { enabled: !!normalizedEns },
+  });
+
+  const hexAddress =
+    looksLikeHex && isAddress(value) ? getAddress(value) : undefined;
+
+  // Reverse: address -> name (nice-to-have for display of a pasted hex).
+  const ensName = useEnsName({
+    address: hexAddress,
+    chainId: mainnet.id,
+    query: { enabled: !!hexAddress },
+  });
+
+  return useMemo<RecipientState>(() => {
+    if (!value) {
+      return { isEns: false, isResolving: false, isValid: false };
+    }
+
+    if (looksLikeHex) {
+      if (!isAddress(value)) {
+        return {
+          isEns: false,
+          isResolving: false,
+          isValid: false,
+          error: "That doesn't look like a valid address.",
+        };
+      }
+      return {
+        address: hexAddress,
+        ensName: ensName.data ?? undefined,
+        isEns: false,
+        isResolving: false,
+        isValid: true,
+      };
+    }
+
+    if (looksLikeEns) {
+      if (!normalizedEns) {
+        return {
+          isEns: true,
+          isResolving: false,
+          isValid: false,
+          error: "That ENS name isn't valid.",
+        };
+      }
+      if (ensAddress.isLoading) {
+        return { isEns: true, isResolving: true, isValid: false };
+      }
+      if (ensAddress.data) {
+        return {
+          address: ensAddress.data,
+          ensName: value,
+          isEns: true,
+          isResolving: false,
+          isValid: true,
+        };
+      }
+      return {
+        isEns: true,
+        isResolving: false,
+        isValid: false,
+        error: `No address is set for ${value}.`,
+      };
+    }
+
+    return {
+      isEns: false,
+      isResolving: false,
+      isValid: false,
+      error: "Enter an address (0x…) or ENS name.",
+    };
+  }, [
+    value,
+    looksLikeHex,
+    looksLikeEns,
+    hexAddress,
+    normalizedEns,
+    ensAddress.isLoading,
+    ensAddress.data,
+    ensName.data,
+  ]);
+}
diff --git a/lib/contracts.ts b/lib/contracts.ts
new file mode 100644
index 0000000..32cd22c
--- /dev/null
+++ b/lib/contracts.ts
@@ -0,0 +1,65 @@
+import { type Address } from "viem";
+import { mainnet } from "viem/chains";
+
+/** The one chain this app operates on. */
+export const APP_CHAIN = mainnet;
+
+/**
+ * Real USDC on Ethereum mainnet. 6 decimals — never assume 18.
+ * https://etherscan.io/token/0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
+ */
+export const USDC_ADDRESS: Address = "0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48";
+export const USDC_DECIMALS = 6;
+export const USDC_SYMBOL = "USDC";
+
+// Chainlink mainnet price feeds (8 decimals). Read onchain over the same RPC so
+// USD context needs no extra API key or third-party dependency.
+export const CHAINLINK_ETH_USD: Address = "0x5f4eC3Df9cbd43714FE2740f5E3616155c5b8419";
