+/* Semantic theme tokens — light default, dark via system preference.
+   No hardcoded full-page dark wrapper (frontend-ux Rule 6). */
+:root {
+  --bg: #f6f7f9;
+  --surface: #ffffff;
+  --surface-2: #f0f2f5;
+  --border: #e2e5ea;
+  --border-strong: #cbd1da;
+  --text: #0d1116;
+  --text-muted: #5b6472;
+  --text-faint: #8a93a1;
+
+  --primary: #2563eb;
+  --primary-hover: #1d4ed8;
+  --primary-fg: #ffffff;
+
+  --success: #15803d;
+  --success-bg: #e7f6ec;
+  --danger: #b42318;
+  --danger-bg: #fdeceb;
+  --warning: #92610a;
+  --warning-bg: #fdf4e3;
+
+  --radius: 14px;
+  --radius-sm: 10px;
+  --shadow: 0 1px 2px rgba(13, 17, 22, 0.04), 0 8px 24px rgba(13, 17, 22, 0.06);
+}
+
+@media (prefers-color-scheme: dark) {
+  :root {
+    --bg: #0b0e13;
+    --surface: #141922;
+    --surface-2: #1c222d;
+    --border: #262d38;
+    --border-strong: #333c49;
+    --text: #eef1f5;
+    --text-muted: #9aa4b2;
+    --text-faint: #6b7482;
+
+    --primary: #3b82f6;
+    --primary-hover: #60a5fa;
+    --primary-fg: #0b0e13;
+
+    --success: #4ade80;
+    --success-bg: #10231a;
+    --danger: #f87171;
+    --danger-bg: #2a1514;
+    --warning: #fbbf24;
+    --warning-bg: #241a0a;
+
+    --shadow: 0 1px 2px rgba(0, 0, 0, 0.4), 0 12px 32px rgba(0, 0, 0, 0.35);
+  }
+}
+
+* {
+  box-sizing: border-box;
+}
+
+html,
+body {
+  padding: 0;
+  margin: 0;
+}
+
+body {
+  background: var(--bg);
+  color: var(--text);
+  font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto,
+    Helvetica, Arial, sans-serif;
+  -webkit-font-smoothing: antialiased;
+  min-height: 100vh;
+}
