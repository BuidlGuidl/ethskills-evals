@@ -0,0 +1,81 @@
+"use client";
+
+import { formatTokenAmount } from "@/lib/format";
+
+type BalancesProps = {
+  symbol: string;
+  decimals: number;
+  usdcBalance: bigint | undefined;
+  ethBalance: { value: bigint; symbol: string; decimals: number } | undefined;
+  isLoading: boolean;
+};
+
+function BalanceTile({
+  label,
+  value,
+  sub,
+  emphasis,
+}: {
+  label: string;
+  value: string;
+  sub?: string;
+  emphasis?: "warning";
+}) {
+  return (
+    <div className="flex flex-col gap-1 rounded-xl border border-slate-200 bg-white p-4">
+      <span className="text-xs font-medium uppercase tracking-wide text-slate-500">
+        {label}
+      </span>
+      <span className="text-xl font-semibold tabular-nums text-slate-900">
+        {value}
+      </span>
+      {sub ? (
+        <span
+          className={
+            emphasis === "warning"
+              ? "text-xs font-medium text-amber-600"
+              : "text-xs text-slate-500"
+          }
+        >
+          {sub}
+        </span>
+      ) : null}
+    </div>
+  );
+}
+
+export function Balances({
+  symbol,
+  decimals,
+  usdcBalance,
+  ethBalance,
+  isLoading,
+}: BalancesProps) {
+  const usdcDisplay =
+    usdcBalance === undefined
+      ? isLoading
+        ? "…"
+        : "—"
+      : `${formatTokenAmount(usdcBalance, decimals, 2)} ${symbol}`;
+
+  const ethDisplay =
+    ethBalance === undefined
+      ? isLoading
+        ? "…"
+        : "—"
+      : `${formatTokenAmount(ethBalance.value, ethBalance.decimals, 4)} ${ethBalance.symbol}`;
+
+  const noEth = ethBalance !== undefined && ethBalance.value === 0n;
+
+  return (
+    <div className="grid grid-cols-2 gap-3">
+      <BalanceTile label={`${symbol} balance`} value={usdcDisplay} />
+      <BalanceTile
+        label="ETH balance"
+        value={ethDisplay}
+        sub={noEth ? "No ETH — you need some for gas" : "Used for gas"}
+        emphasis={noEth ? "warning" : undefined}
+      />
+    </div>
+  );
+}
diff --git a/components/PayForm.tsx b/components/PayForm.tsx
new file mode 100644
index 0000000..26ea6ef
--- /dev/null
+++ b/components/PayForm.tsx
@@ -0,0 +1,255 @@
+"use client";
+
+import { useEffect, useMemo, useState } from "react";
+import {
+  BaseError,
+  formatUnits,
+  getAddress,
+  isAddress,
+  type Address,
+} from "viem";
+import { useWaitForTransactionReceipt, useWriteContract } from "wagmi";
+
+import { formatTokenAmount, parseAmount, shortenAddress } from "@/lib/format";
+import { USDC_ADDRESS, usdcAbi } from "@/lib/usdc";
+
+type PayFormProps = {
+  owner: Address;
+  symbol: string;
+  decimals: number;
+  usdcBalance: bigint | undefined;
+  hasNoEth: boolean;
+  disabled?: boolean;
+  onConfirmed: () => void;
+};
+
+const ETHERSCAN_TX = "https://etherscan.io/tx/";
+
+export function PayForm({
+  owner,
+  symbol,
+  decimals,
+  usdcBalance,
+  hasNoEth,
+  disabled = false,
+  onConfirmed,
+}: PayFormProps) {
+  const [recipient, setRecipient] = useState("");
+  const [amount, setAmount] = useState("");
+  const [touched, setTouched] = useState(false);
+
+  const {
+    writeContract,
+    data: hash,
+    isPending,
+    error: writeError,
+    reset,
+  } = useWriteContract();
+
+  const {
+    isLoading: isConfirming,
+    isSuccess: isConfirmed,
+    error: receiptError,
+  } = useWaitForTransactionReceipt({ hash });
+
+  // Refetch balances and clear the form once the transfer confirms on-chain.
+  useEffect(() => {
+    if (isConfirmed) {
+      onConfirmed();
+      setRecipient("");
+      setAmount("");
+      setTouched(false);
+    }
+  }, [isConfirmed, onConfirmed]);
+
+  const recipientValid = isAddress(recipient);
+  const amountResult = useMemo(
+    () => parseAmount(amount, decimals),
+    [amount, decimals],
+  );
+
+  const insufficient =
+    amountResult.ok &&
+    usdcBalance !== undefined &&
+    amountResult.value > usdcBalance;
+
+  const isSelf =
+    recipientValid &&
+    owner !== undefined &&
+    getAddress(recipient) === getAddress(owner);
+
+  const recipientError =
+    touched && recipient && !recipientValid
+      ? "Enter a valid Ethereum address"
+      : undefined;
+
+  const amountError = touched && amount && !amountResult.ok
+    ? amountResult.error
+    : insufficient
+      ? `Amount exceeds your ${symbol} balance`
+      : undefined;
+
+  const inFlight = isPending || isConfirming;
+  const canSubmit =
+    !disabled &&
+    !inFlight &&
+    recipientValid &&
+    amountResult.ok &&
+    !insufficient;
+
+  function handleAmountChange(raw: string) {
+    // Keep only digits and a single decimal point.
+    const cleaned = raw.replace(/[^0-9.]/g, "");
+    const firstDot = cleaned.indexOf(".");
+    const normalized =
+      firstDot === -1
+        ? cleaned
+        : cleaned.slice(0, firstDot + 1) +
+          cleaned.slice(firstDot + 1).replace(/\./g, "");
+    setAmount(normalized);
+  }
+
+  function handleMax() {
+    if (usdcBalance !== undefined) {
+      setAmount(formatUnits(usdcBalance, decimals));
+    }
+  }
+
+  function handleSubmit(e: React.FormEvent) {
+    e.preventDefault();
+    setTouched(true);
+    if (!recipientValid || !amountResult.ok || insufficient) return;
+
+    writeContract({
+      address: USDC_ADDRESS,
+      abi: usdcAbi,
+      functionName: "transfer",
+      args: [getAddress(recipient), amountResult.value],
+    });
+  }
+
+  const submitLabel = isPending
+    ? "Confirm in wallet…"
+    : isConfirming
+      ? "Sending…"
+      : `Send ${symbol}`;
+
+  const txError = writeError ?? receiptError;
+
+  return (
+    <form onSubmit={handleSubmit} className="flex flex-col gap-4">
+      <div className="flex flex-col gap-1.5">
+        <label htmlFor="recipient" className="text-sm font-medium text-slate-700">
+          Recipient
+        </label>
+        <input
+          id="recipient"
+          inputMode="text"
+          autoComplete="off"
+          spellCheck={false}
+          placeholder="0x…"
+          value={recipient}
+          onChange={(e) => setRecipient(e.target.value.trim())}
+          onBlur={() => setTouched(true)}
+          disabled={disabled || inFlight}
+          className="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 font-mono text-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 disabled:bg-slate-50 disabled:text-slate-400"
+        />
+        {recipientError ? (
+          <p className="text-xs text-red-600">{recipientError}</p>
+        ) : isSelf ? (
+          <p className="text-xs text-amber-600">
+            This is your own address — you&apos;d be sending to yourself.
+          </p>
+        ) : null}
+      </div>
+
+      <div className="flex flex-col gap-1.5">
+        <div className="flex items-center justify-between">
+          <label htmlFor="amount" className="text-sm font-medium text-slate-700">
+            Amount
+          </label>
+          {usdcBalance !== undefined ? (
+            <button
+              type="button"
+              onClick={handleMax}
+              disabled={disabled || inFlight || usdcBalance === 0n}
+              className="text-xs font-medium text-blue-600 hover:text-blue-700 disabled:text-slate-400"
+            >
+              Max: {formatTokenAmount(usdcBalance, decimals, 2)} {symbol}
+            </button>
+          ) : null}
+        </div>
+        <div className="relative">
+          <input
+            id="amount"
+            inputMode="decimal"
+            autoComplete="off"
+            placeholder="0.00"
+            value={amount}
+            onChange={(e) => handleAmountChange(e.target.value)}
+            onBlur={() => setTouched(true)}
+            disabled={disabled || inFlight}
+            className="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 pr-16 text-sm tabular-nums outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 disabled:bg-slate-50 disabled:text-slate-400"
+          />
+          <span className="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-sm font-medium text-slate-400">
+            {symbol}
+          </span>
+        </div>
+        {amountError ? <p className="text-xs text-red-600">{amountError}</p> : null}
+      </div>
+
+      {hasNoEth ? (
+        <p className="rounded-lg bg-amber-50 px-3 py-2 text-xs text-amber-700">
+          You have no ETH to pay for gas. Add some ETH before sending.
+        </p>
+      ) : null}
+
+      <button
+        type="submit"
+        disabled={!canSubmit}
+        className="mt-1 w-full rounded-lg bg-blue-600 px-4 py-3 text-sm font-semibold text-white transition hover:bg-blue-700 disabled:cursor-not-allowed disabled:bg-slate-300"
+      >
+        {submitLabel}
+      </button>
+
+      {hash ? (
+        <div
+          className={`rounded-lg px-3 py-2.5 text-xs ${
+            isConfirmed
+              ? "bg-emerald-50 text-emerald-700"
+              : "bg-blue-50 text-blue-700"
+          }`}
+        >
+          <p className="font-medium">
+            {isConfirmed
+              ? "Payment confirmed"
+              : "Transaction submitted — waiting for confirmation…"}
+          </p>
+          <a
+            href={`${ETHERSCAN_TX}${hash}`}
+            target="_blank"
+            rel="noopener noreferrer"
+            className="font-mono underline underline-offset-2"
+          >
+            {shortenAddress(hash)}
+          </a>
+        </div>
+      ) : null}
+
+      {txError ? (
+        <p className="rounded-lg bg-red-50 px-3 py-2.5 text-xs text-red-700">
+          {txError instanceof BaseError
+            ? txError.shortMessage
+            : txError.message}
+          <button
+            type="button"
+            onClick={reset}
+            className="ml-2 font-medium underline"
+          >
+            Dismiss
+          </button>
+        </p>
+      ) : null}
+    </form>
+  );
+}
diff --git a/lib/format.ts b/lib/format.ts
new file mode 100644
index 0000000..6ab4e20
--- /dev/null
+++ b/lib/format.ts
@@ -0,0 +1,66 @@
+import { formatUnits, parseUnits } from "viem";
+
+/**
+ * Format a raw token amount (base units) for display, grouping thousands and
+ * capping the number of fractional digits shown without losing precision in the
+ * underlying value.
+ */
+export function formatTokenAmount(
+  value: bigint,
+  decimals: number,
+  maxFractionDigits = 6,
+): string {
+  const formatted = formatUnits(value, decimals);
+  const [whole, fraction = ""] = formatted.split(".");
+  const groupedWhole = BigInt(whole).toLocaleString("en-US");
+  const trimmedFraction = fraction.slice(0, maxFractionDigits).replace(/0+$/, "");
+  return trimmedFraction ? `${groupedWhole}.${trimmedFraction}` : groupedWhole;
+}
+
+export type AmountParseResult =
+  | { ok: true; value: bigint }
+  | { ok: false; error: string };
+
+/**
+ * Validate and parse a user-entered decimal amount string into base units.
+ * Rejects malformed input and amounts with more fractional digits than the
+ * token supports (USDC = 6), which would otherwise throw or silently truncate.
+ */
+export function parseAmount(
+  input: string,
+  decimals: number,
+): AmountParseResult {
+  const trimmed = input.trim();
+  if (!trimmed) return { ok: false, error: "Enter an amount" };
+
+  // A single well-formed decimal number, no signs or exponents.
+  if (!/^\d*\.?\d*$/.test(trimmed) || trimmed === ".") {
+    return { ok: false, error: "Enter a valid number" };
+  }
+
+  const [, fraction = ""] = trimmed.split(".");
+  if (fraction.length > decimals) {
+    return {
+      ok: false,
+      error: `USDC supports at most ${decimals} decimal places`,
+    };
+  }
+
+  let value: bigint;
+  try {
+    value = parseUnits(trimmed, decimals);
+  } catch {
+    return { ok: false, error: "Enter a valid number" };
+  }
+
+  if (value <= 0n) {
+    return { ok: false, error: "Amount must be greater than 0" };
+  }
+
+  return { ok: true, value };
+}
+
+/** Shorten an address for compact display: 0x1234…abcd. */
+export function shortenAddress(address: string): string {
+  return `${address.slice(0, 6)}…${address.slice(-4)}`;
+}
