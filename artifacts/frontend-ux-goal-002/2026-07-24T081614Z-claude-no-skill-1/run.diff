@@ -0,0 +1,30 @@
+import { getDefaultConfig } from "@rainbow-me/rainbowkit";
+import { http } from "wagmi";
+import { mainnet } from "wagmi/chains";
+
+// WalletConnect requires a project id. Injected wallets (MetaMask, Rabby, …)
+// work without it; the placeholder keeps getDefaultConfig from throwing when the
+// env var is missing so the app still builds and runs with injected wallets.
+const projectId =
+  process.env.NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID ?? "PLACEHOLDER_PROJECT_ID";
+
+const rpcUrl = process.env.NEXT_PUBLIC_MAINNET_RPC_URL;
+
+// This app deals in the real USDC contract, so it is intentionally locked to
+// Ethereum mainnet. Anything else and we ask the user to switch.
+export const config = getDefaultConfig({
+  appName: "USDC Pay",
+  projectId,
+  chains: [mainnet],
+  transports: {
+    // Falls back to the chain's public RPC when NEXT_PUBLIC_MAINNET_RPC_URL is unset.
+    [mainnet.id]: http(rpcUrl),
+  },
+  ssr: true,
+});
+
+declare module "wagmi" {
+  interface Register {
+    config: typeof config;
+  }
+}
