+import { erc20Abi, getAddress } from "viem";
+
+// Real USDC on Ethereum mainnet. getAddress normalises to the checksummed form
+// and throws at module load if the literal is ever mistyped.
+export const USDC_ADDRESS = getAddress(
+  "0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48",
+);
+
+// USDC is a standard ERC-20; viem's canonical ERC-20 ABI covers transfer,
+// balanceOf, decimals and symbol, which is everything this app needs.
+export const usdcAbi = erc20Abi;
+
+// USDC uses 6 decimals, NOT 18. We still read decimals() from the contract at
+// runtime and treat this only as a pre-load fallback so the UI never assumes
+// the wrong precision.
+export const USDC_DECIMALS_FALLBACK = 6;
