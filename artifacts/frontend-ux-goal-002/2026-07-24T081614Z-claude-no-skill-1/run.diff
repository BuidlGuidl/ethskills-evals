index 0000000..418141d
--- /dev/null
+++ b/lib/useUsdcAccount.ts
@@ -0,0 +1,56 @@
+"use client";
+
+import { useAccount, useBalance, useReadContracts } from "wagmi";
+import { mainnet } from "wagmi/chains";
+
+import { USDC_ADDRESS, usdcAbi, USDC_DECIMALS_FALLBACK } from "@/lib/usdc";
+
+const ZERO_ADDRESS = "0x0000000000000000000000000000000000000000" as const;
+
+/**
+ * Everything the /pay page needs about the connected account: USDC metadata,
+ * USDC balance, and ETH balance (for gas). Reads decimals/symbol from the token
+ * itself rather than hardcoding, and refetches both balances together after a
+ * successful transfer.
+ */
+export function useUsdcAccount() {
+  const { address, isConnected, chainId } = useAccount();
+  const onMainnet = chainId === mainnet.id;
+  const enabled = Boolean(address) && onMainnet;
+
+  const token = useReadContracts({
+    allowFailure: false,
+    contracts: [
+      { address: USDC_ADDRESS, abi: usdcAbi, functionName: "decimals" },
+      { address: USDC_ADDRESS, abi: usdcAbi, functionName: "symbol" },
+      {
+        address: USDC_ADDRESS,
+        abi: usdcAbi,
+        functionName: "balanceOf",
+        args: [address ?? ZERO_ADDRESS],
+      },
+    ],
+    query: { enabled },
+  });
+
+  const eth = useBalance({ address, query: { enabled } });
+
+  const [decimals, symbol, usdcBalance] = token.data ?? [];
+
+  return {
+    address,
+    isConnected,
+    chainId,
+    onMainnet,
+    decimals: decimals ?? USDC_DECIMALS_FALLBACK,
+    symbol: symbol ?? "USDC",
+    usdcBalance: usdcBalance as bigint | undefined,
+    ethBalance: eth.data,
+    isLoading: token.isLoading || eth.isLoading,
+    isError: token.isError || eth.isError,
+    refetch: () => {
+      void token.refetch();
+      void eth.refetch();
+    },
+  };
+}
