+/** @type {import('next').NextConfig} */
+const nextConfig = {
+  reactStrictMode: true,
+  webpack: (config, { webpack }) => {
+    // The Coinbase/Base-Account connector (pulled in transitively by
+    // RainbowKit's default wallet list) references the optional `@x402/*`
+    // payment-signing packages, which aren't published as resolvable modules.
+    // This app only does plain ERC-20 transfers and never touches that code
+    // path, so ignore the whole scope to let the bundle build.
+    config.plugins.push(
+      new webpack.IgnorePlugin({ resourceRegExp: /^@x402\// }),
+    );
+    // React-Native-only storage optionally referenced by the MetaMask SDK; not
+    // used in a browser build.
+    config.resolve.alias = {
+      ...config.resolve.alias,
+      "@react-native-async-storage/async-storage": false,
+    };
+    // Silence optional pretty-logger / native deps some wallet SDKs reference.
+    config.externals.push("pino-pretty", "lokijs", "encoding");
+    return config;
+  },
+};
+
+export default nextConfig;
