+}) {
+  return (
+    <div className="flex-1 rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
+      <p className="text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-400">
+        {label}
+      </p>
+      <div className="mt-1 text-2xl font-semibold tabular-nums text-slate-900 dark:text-slate-50">
+        {children}
+      </div>
+      {hint ? (
+        <p className="mt-1 text-xs text-slate-500 dark:text-slate-400">{hint}</p>
+      ) : null}
+    </div>
+  );
+}
+
+function Skeleton() {
+  return (
+    <span className="inline-block h-7 w-24 animate-pulse rounded bg-slate-200 align-middle dark:bg-slate-800" />
+  );
+}
+
+export function Balances({
+  usdc,
+  eth,
+  decimals,
+  isLoading,
+  hasError,
+}: {
+  usdc?: bigint;
+  eth?: bigint;
+  decimals: number;
+  isLoading: boolean;
+  hasError: boolean;
+}) {
+  return (
+    <div className="flex flex-col gap-3 sm:flex-row">
+      <Tile label="Your USDC">
+        {isLoading && usdc === undefined ? (
+          <Skeleton />
+        ) : usdc === undefined ? (
+          <span className="text-base font-normal text-slate-500">
+            {hasError ? "Unavailable" : "—"}
+          </span>
+        ) : (
+          <span title={`${formatAmountExact(usdc, decimals)} USDC`}>
+            {formatAmount(usdc, decimals)}{" "}
+            <span className="text-base font-medium text-slate-500 dark:text-slate-400">
+              USDC
+            </span>
+          </span>
+        )}
+      </Tile>
+
+      <Tile label="Your ETH" hint="Used to pay the network fee">
+        {isLoading && eth === undefined ? (
+          <Skeleton />
+        ) : eth === undefined ? (
+          <span className="text-base font-normal text-slate-500">
+            {hasError ? "Unavailable" : "—"}
+          </span>
+        ) : (
+          <span title={`${formatAmountExact(eth, 18)} ETH`}>
+            {formatEth(eth)}{" "}
+            <span className="text-base font-medium text-slate-500 dark:text-slate-400">
+              ETH
+            </span>
+          </span>
+        )}
+      </Tile>
+    </div>
+  );
+}
