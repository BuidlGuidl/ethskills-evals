+"use client";
+
+import { useSyncExternalStore } from "react";
+
+const subscribe = () => () => {};
+
+/**
+ * False during SSR and the hydration render, true afterwards.
+ *
+ * Wallet state lives in the browser (extensions, storage, an in-flight
+ * reconnect), so any UI that branches on "am I connected?" can disagree with
+ * the server-rendered HTML and blow up hydration. Rendering a stable
+ * placeholder until mounted makes that mismatch impossible.
+ */
+export function useIsMounted(): boolean {
+  return useSyncExternalStore(
+    subscribe,
+    () => true,
+    () => false,
+  );
+}
diff --git a/src/hooks/useRecipient.ts b/src/hooks/useRecipient.ts
new file mode 100644
index 0000000..3b615b7
--- /dev/null
+++ b/src/hooks/useRecipient.ts
@@ -0,0 +1,119 @@
+"use client";
+
+import { getAddress, isAddress, zeroAddress, type Address } from "viem";
+import { normalize } from "viem/ens";
+import { useAccount, useBytecode, useEnsAddress } from "wagmi";
+import { USDC_ADDRESS, USDC_CHAIN } from "@/lib/usdc";
+
+export type Recipient = {
+  /** Checksummed address, only set once the input is valid and resolved. */
+  address?: Address;
+  /** The ENS name the address came from, if any. */
+  ensName?: string;
+  isResolving: boolean;
+  /** Blocks sending. */
+  error?: string;
+  /** Worth a second look, but doesn't block. */
+  warning?: string;
+};
+
+const ADDRESS_SHAPE = /^0x[0-9a-fA-F]{40}$/;
+
+/**
+ * An EIP-7702 delegation leaves `0xef0100 || address` at an otherwise normal
+ * EOA. Plenty of ordinary wallets look like this now, so treating them as
+ * contracts would warn on most smart-account users for no reason.
+ */
+function isContract(bytecode?: string): boolean {
+  if (!bytecode || bytecode === "0x") return false;
+  return !bytecode.toLowerCase().startsWith("0xef0100");
+}
+
+/** Validates and resolves whatever the user typed into the recipient field. */
+export function useRecipient(input: string): Recipient {
+  const { address: account } = useAccount();
+  const value = input.trim();
+  const looksLikeEns = value.includes(".") && !value.startsWith("0x");
+
+  let ensQuery: string | undefined;
+  if (looksLikeEns) {
+    try {
+      ensQuery = normalize(value);
+    } catch {
+      ensQuery = undefined;
+    }
+  }
+
+  const ens = useEnsAddress({
+    name: ensQuery,
+    chainId: USDC_CHAIN.id,
+    query: { enabled: Boolean(ensQuery) },
+  });
+
+  const resolved: Address | undefined = looksLikeEns
+    ? (ens.data ?? undefined)
+    : isAddress(value)
+      ? getAddress(value)
+      : undefined;
+
+  const bytecode = useBytecode({
+    address: resolved,
+    chainId: USDC_CHAIN.id,
+    query: { enabled: Boolean(resolved) },
+  });
+
+  if (value === "") return { isResolving: false };
+
+  if (looksLikeEns) {
+    if (!ensQuery) return { isResolving: false, error: "That isn't a valid ENS name." };
+    if (ens.isLoading) return { isResolving: true };
+    if (ens.isError) {
+      return { isResolving: false, error: "Couldn't look up that ENS name. Try again." };
+    }
+    if (!resolved) {
+      return { isResolving: false, error: `${value} doesn't point to an address.` };
+    }
+  } else if (!resolved) {
+    if (ADDRESS_SHAPE.test(value)) {
+      // Right shape, wrong checksum — almost always a typo or a mangled copy.
+      return {
+        isResolving: false,
+        error: "That address failed its checksum. Re-copy it to be sure.",
+      };
+    }
+    return {
+      isResolving: false,
+      error: "Enter an Ethereum address (0x…) or an ENS name.",
+    };
+  }
+
+  const base = {
+    address: resolved,
+    ensName: looksLikeEns ? value : undefined,
+    isResolving: bytecode.isLoading,
+  };
+
+  if (resolved === zeroAddress) {
+    return { ...base, address: undefined, error: "USDC can't be sent to the zero address." };
+  }
+  if (resolved.toLowerCase() === USDC_ADDRESS.toLowerCase()) {
+    // A classic way to lose money: pasting the token address as the recipient.
+    return {
+      ...base,
+      address: undefined,
+      error: "That's the USDC contract itself. Tokens sent there are unrecoverable.",
+    };
+  }
+  if (account && resolved.toLowerCase() === account.toLowerCase()) {
+    return { ...base, warning: "This is your own address — you'd be paying yourself." };
+  }
+  if (isContract(bytecode.data)) {
+    return {
+      ...base,
+      warning:
+        "This address is a smart contract. Make sure it's meant to receive USDC.",
+    };
+  }
+
+  return base;
+}
diff --git a/src/hooks/useSendUsdc.ts b/src/hooks/useSendUsdc.ts
new file mode 100644
index 0000000..d036a60
--- /dev/null
+++ b/src/hooks/useSendUsdc.ts
@@ -0,0 +1,163 @@
+"use client";
+
+import { useQueryClient } from "@tanstack/react-query";
+import { useCallback, useEffect, useMemo } from "react";
+import { encodeFunctionData, type Address } from "viem";
+import {
+  useAccount,
+  useEstimateFeesPerGas,
+  useEstimateGas,
+  useSimulateContract,
+  useWaitForTransactionReceipt,
+  useWriteContract,
+} from "wagmi";
+import { USDC_ADDRESS, USDC_CHAIN, erc20Abi } from "@/lib/usdc";
+
+export type SendStatus =
+  | "idle" // nothing to do yet — form incomplete
+  | "checking" // simulating the transfer against the current chain state
+  | "ready" // simulation passed, safe to ask for a signature
+  | "signing" // waiting on the wallet
+  | "pending" // broadcast, waiting for a receipt
+  | "success"
+  | "reverted" // mined but failed on-chain
+  | "error";
+
+/**
+ * Drives one USDC transfer.
+ *
+ * Every send is simulated first: USDC can revert for reasons the UI cannot see
+ * from balances alone (blacklisted sender or recipient, token paused), and it's
+ * far better to catch that before the user signs than after they've paid gas.
+ */
+export function useSendUsdc({
+  to,
+  amount,
+}: {
+  to?: Address;
+  amount?: bigint;
+}) {
+  const { address, chainId } = useAccount();
+  const queryClient = useQueryClient();
+
+  const inputsReady = Boolean(address && to && amount && amount > 0n);
+  const onCorrectChain = chainId === USDC_CHAIN.id;
+
+  const simulation = useSimulateContract({
+    address: USDC_ADDRESS,
+    abi: erc20Abi,
+    functionName: "transfer",
+    args: to && amount ? [to, amount] : undefined,
+    account: address,
+    chainId: USDC_CHAIN.id,
+    query: { enabled: inputsReady, retry: false },
+  });
+
+  const calldata = useMemo(
+    () =>
+      to && amount
+        ? encodeFunctionData({
+            abi: erc20Abi,
+            functionName: "transfer",
+            args: [to, amount],
+          })
+        : undefined,
+    [to, amount],
+  );
+
+  const gas = useEstimateGas({
+    to: USDC_ADDRESS,
+    data: calldata,
+    account: address,
+    chainId: USDC_CHAIN.id,
+    query: { enabled: inputsReady && simulation.isSuccess, retry: false },
+  });
+
+  const fees = useEstimateFeesPerGas({
+    chainId: USDC_CHAIN.id,
+    query: { enabled: inputsReady },
+  });
+
+  /** Worst-case cost of this transfer: maxFeePerGas already prices in a base-fee spike. */
+  const maxFee =
+    gas.data && fees.data?.maxFeePerGas
+      ? gas.data * fees.data.maxFeePerGas
+      : undefined;
+
+  const {
+    writeContract,
+    data: hash,
+    isPending: isSigning,
+    error: writeError,
+    reset: resetWrite,
+  } = useWriteContract();
+
+  const receipt = useWaitForTransactionReceipt({
+    hash,
+    chainId: USDC_CHAIN.id,
+    confirmations: 1,
+  });
+
+  // A mined transfer moves USDC and always spends ETH, so refresh both — even
+  // when it reverted.
+  useEffect(() => {
+    if (!receipt.data) return;
+    queryClient.invalidateQueries({
+      predicate: (query) =>
+        query.queryKey[0] === "readContract" || query.queryKey[0] === "balance",
+    });
+  }, [receipt.data, queryClient]);
+
+  // Editing the form after a rejected/failed signature should clear the stale
+  // error — but never the hash of a transfer that's already in flight.
+  useEffect(() => {
+    if (writeError && !hash) resetWrite();
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [to, amount]);
+
+  const send = useCallback(() => {
+    if (!simulation.data?.request) return;
+    writeContract(simulation.data.request);
+  }, [simulation.data, writeContract]);
+
+  const reset = useCallback(() => {
+    resetWrite();
+  }, [resetWrite]);
+
+  const status: SendStatus = !hash
+    ? isSigning
+      ? "signing"
+      : writeError
+        ? "error"
+        : !inputsReady
+          ? "idle"
+          : simulation.isFetching
+            ? "checking"
+            : simulation.isError
+              ? "error"
+              : simulation.isSuccess
+                ? "ready"
+                : "idle"
+    : receipt.isSuccess
+      ? receipt.data.status === "success"
+        ? "success"
+        : "reverted"
+      : receipt.isError
+        ? "error"
+        : "pending";
+
+  return {
+    status,
+    send,
+    reset,
+    hash,
+    receipt: receipt.data,
+    /** Simulation failures are the useful ones — they explain *why* it'd fail. */
+    error: writeError ?? simulation.error ?? receipt.error ?? null,
+    // A rejected signature doesn't invalidate the simulation, so the user can
+    // simply click send again.
+    canSend: simulation.isSuccess && !isSigning && !hash && onCorrectChain,
+    gas: gas.data,
+    maxFee,
+  };
+}
