+++ b/src/components/TxStatus.tsx
@@ -0,0 +1,102 @@
+"use client";
+
+import type { Address } from "viem";
+import { formatAmount } from "@/lib/amount";
+import { explorerTx, shortAddress } from "@/lib/format";
+import type { SendStatus } from "@/hooks/useSendUsdc";
+import { Notice } from "./Notice";
+
+function ExplorerLink({ hash }: { hash: string }) {
+  return (
+    <a
+      className="font-medium underline underline-offset-2 hover:no-underline"
+      href={explorerTx(hash)}
+      target="_blank"
+      rel="noreferrer noopener"
+    >
+      View on Etherscan ({shortAddress(hash, 6)})
+    </a>
+  );
+}
+
+export function TxStatus({
+  status,
+  hash,
+  amount,
+  decimals,
+  to,
+  ensName,
+  onReset,
+}: {
+  status: SendStatus;
+  hash?: `0x${string}`;
+  amount?: bigint;
+  decimals: number;
+  to?: Address;
+  ensName?: string;
+  onReset: () => void;
+}) {
+  if (status === "pending") {
+    return (
+      <Notice variant="info" aria-live="polite">
+        <div className="flex items-center gap-2">
+          <span
+            className="h-3 w-3 shrink-0 animate-spin rounded-full border-2 border-slate-400 border-t-transparent"
+            aria-hidden
+          />
+          <span>Waiting for confirmation…</span>
+        </div>
+        {hash ? (
+          <p className="mt-1.5">
+            <ExplorerLink hash={hash} />
+          </p>
+        ) : null}
+      </Notice>
+    );
+  }
+
+  if (status === "success") {
+    return (
+      <Notice variant="success" aria-live="polite">
+        <p className="font-medium">
+          Sent{" "}
+          {amount !== undefined ? `${formatAmount(amount, decimals)} USDC` : "USDC"}
+          {to ? ` to ${ensName ?? shortAddress(to)}` : ""}.
+        </p>
+        <div className="mt-1.5 flex flex-wrap items-center gap-x-4 gap-y-1">
+          {hash ? <ExplorerLink hash={hash} /> : null}
+          <button
+            type="button"
+            onClick={onReset}
+            className="font-medium underline underline-offset-2 hover:no-underline"
+          >
+            Send another
+          </button>
+        </div>
+      </Notice>
+    );
+  }
+
+  if (status === "reverted") {
+    return (
+      <Notice variant="error" aria-live="polite">
+        <p className="font-medium">
+          The transaction was mined but failed — no USDC was sent (the network
+          fee was still charged).
+        </p>
+        <div className="mt-1.5 flex flex-wrap items-center gap-x-4 gap-y-1">
+          {hash ? <ExplorerLink hash={hash} /> : null}
+          <button
+            type="button"
+            onClick={onReset}
+            className="font-medium underline underline-offset-2 hover:no-underline"
+          >
+            Try again
+          </button>
+        </div>
+      </Notice>
+    );
+  }
+
+  return null;
+}
diff --git a/src/hooks/useBalances.ts b/src/hooks/useBalances.ts
new file mode 100644
index 0000000..90eb244
--- /dev/null
+++ b/src/hooks/useBalances.ts
@@ -0,0 +1,77 @@
+"use client";
+
+import { useQueryClient } from "@tanstack/react-query";
+import { useEffect } from "react";
+import type { Address } from "viem";
+import { useBalance, useBlockNumber, useReadContract } from "wagmi";
+import {
+  USDC_ADDRESS,
+  USDC_CHAIN,
+  USDC_FALLBACK_DECIMALS,
+  erc20Abi,
+} from "@/lib/usdc";
+
+/**
+ * USDC + ETH balances for `address`, refreshed on every new block.
+ * Reads are pinned to mainnet, so a wallet sitting on the wrong network still
+ * sees its real balances instead of blanks or another chain's numbers.
+ */
+export function useBalances(address?: Address) {
+  const queryClient = useQueryClient();
+  const enabled = Boolean(address);
+
+  const decimals = useReadContract({
+    address: USDC_ADDRESS,
+    abi: erc20Abi,
+    functionName: "decimals",
+    chainId: USDC_CHAIN.id,
+    query: { staleTime: Infinity, gcTime: Infinity },
+  });
+
+  const usdc = useReadContract({
+    address: USDC_ADDRESS,
+    abi: erc20Abi,
+    functionName: "balanceOf",
+    args: address ? [address] : undefined,
+    chainId: USDC_CHAIN.id,
+    query: { enabled },
+  });
+
+  const eth = useBalance({
+    address,
+    chainId: USDC_CHAIN.id,
+    query: { enabled },
+  });
+
+  const { data: blockNumber } = useBlockNumber({
+    chainId: USDC_CHAIN.id,
+    watch: enabled,
+  });
+
+  useEffect(() => {
+    if (!blockNumber || !enabled) return;
+    queryClient.invalidateQueries({ queryKey: usdc.queryKey });
+    queryClient.invalidateQueries({ queryKey: eth.queryKey });
+    // Re-run on each new block only; the query keys are stable per address.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [blockNumber, enabled, queryClient]);
+
+  return {
+    usdc: {
+      value: usdc.data,
+      decimals: decimals.data ?? USDC_FALLBACK_DECIMALS,
+      isLoading: usdc.isLoading,
+      error: usdc.error,
+      refetch: usdc.refetch,
+    },
+    eth: {
+      value: eth.data?.value,
+      symbol: eth.data?.symbol ?? "ETH",
+      isLoading: eth.isLoading,
+      error: eth.error,
+      refetch: eth.refetch,
+    },
+    /** True until we know the on-chain decimals, so we never parse with a guess. */
+    isReady: !enabled || decimals.isSuccess || decimals.isError,
+  };
+}
