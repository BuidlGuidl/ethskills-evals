+++ b/src/components/PayForm.tsx
@@ -0,0 +1,336 @@
+"use client";
+
+import { ConnectButton } from "@rainbow-me/rainbowkit";
+import { useState } from "react";
+import { formatUnits, type Address } from "viem";
+import { useAccount, useSwitchChain } from "wagmi";
+import { Balances } from "@/components/Balances";
+import { Notice } from "@/components/Notice";
+import { TxStatus } from "@/components/TxStatus";
+import { useBalances } from "@/hooks/useBalances";
+import { useDebouncedValue } from "@/hooks/useDebouncedValue";
+import { useIsMounted } from "@/hooks/useIsMounted";
+import { useRecipient } from "@/hooks/useRecipient";
+import { useSendUsdc } from "@/hooks/useSendUsdc";
+import { formatAmount, parseAmount } from "@/lib/amount";
+import { toFriendlyError } from "@/lib/errors";
+import { explorerAddress, formatEthFee, shortAddress } from "@/lib/format";
+import { USDC_CHAIN } from "@/lib/usdc";
+
+export function PayForm() {
+  const isMounted = useIsMounted();
+  const { address, isConnected, chainId } = useAccount();
+  const { switchChain, isPending: isSwitching } = useSwitchChain();
+
+  const [recipientInput, setRecipientInput] = useState("");
+  const [amountInput, setAmountInput] = useState("");
+  // What we actually broadcast, so the receipt keeps describing that transfer
+  // even if the form is edited afterwards.
+  const [sent, setSent] = useState<{
+    amount: bigint;
+    to: Address;
+    ensName?: string;
+  }>();
+
+  const balances = useBalances(address);
+  const decimals = balances.usdc.decimals;
+
+  const debouncedRecipientInput = useDebouncedValue(recipientInput);
+  const recipient = useRecipient(debouncedRecipientInput);
+
+  const parsed = parseAmount(amountInput, decimals);
+  const usdcBalance = balances.usdc.value;
+  const overBalance =
+    parsed.ok && usdcBalance !== undefined && parsed.value > usdcBalance;
+
+  const amountError =
+    amountInput.trim() === ""
+      ? undefined
+      : !parsed.ok
+        ? parsed.error
+        : overBalance
+          ? `That's more than your balance of ${formatAmount(usdcBalance!, decimals)} USDC.`
+          : undefined;
+
+  const amount = parsed.ok && !overBalance ? parsed.value : undefined;
+  const debouncedAmount = useDebouncedValue(amount);
+
+  const send = useSendUsdc({ to: recipient.address, amount: debouncedAmount });
+
+  /**
+   * The simulation lags the inputs by the debounce, and its result is what we
+   * hand to the wallet — so refuse to send until the two agree. Without this,
+   * typing a new amount and hitting enter within the debounce window would
+   * sign the *previous* amount.
+   */
+  const simulationMatchesForm =
+    debouncedAmount === amount && debouncedRecipientInput === recipientInput;
+
+  const wrongChain = isConnected && chainId !== USDC_CHAIN.id;
+  const busy = send.status === "signing" || send.status === "pending";
+  const ethBalance = balances.eth.value;
+  const noEth = ethBalance === 0n;
+  const feeLooksTight =
+    !noEth &&
+    ethBalance !== undefined &&
+    send.maxFee !== undefined &&
+    ethBalance < send.maxFee;
+
+  const canSend =
+    send.canSend && simulationMatchesForm && !noEth && balances.isReady;
+
+  function submit() {
+    if (!canSend || !amount || !recipient.address) return;
+    setSent({ amount, to: recipient.address, ensName: recipient.ensName });
+    send.send();
+  }
+
+  function resetForm() {
+    setRecipientInput("");
+    setAmountInput("");
+    setSent(undefined);
+    send.reset();
+  }
+
+  if (!isMounted) {
+    return (
+      <div
+        className="h-64 animate-pulse rounded-2xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900"
+        aria-hidden
+      />
+    );
+  }
+
+  if (!isConnected) {
+    return (
+      <div className="flex flex-col items-center gap-4 rounded-2xl border border-slate-200 bg-white px-6 py-12 text-center dark:border-slate-800 dark:bg-slate-900">
+        <div>
+          <h2 className="text-lg font-semibold text-slate-900 dark:text-slate-50">
+            Connect a wallet to get started
+          </h2>
+          <p className="mt-1 text-sm text-slate-600 dark:text-slate-400">
+            You&apos;ll be able to see your balances and send USDC on Ethereum
+            mainnet.
+          </p>
+        </div>
+        <ConnectButton />
+      </div>
+    );
+  }
+
+  return (
+    <div className="flex flex-col gap-5">
+      <Balances
+        usdc={balances.usdc.value}
+        eth={balances.eth.value}
+        decimals={decimals}
+        isLoading={balances.usdc.isLoading || balances.eth.isLoading}
+        hasError={Boolean(balances.usdc.error || balances.eth.error)}
+      />
+
+      {balances.usdc.error || balances.eth.error ? (
+        <Notice variant="warning">
+          Couldn&apos;t load your balances — the network may be busy.{" "}
+          <button
+            type="button"
+            className="font-medium underline underline-offset-2 hover:no-underline"
+            onClick={() => {
+              balances.usdc.refetch();
+              balances.eth.refetch();
+            }}
+          >
+            Retry
+          </button>
+        </Notice>
+      ) : null}
+
+      {wrongChain ? (
+        <Notice variant="warning">
+          <div className="flex flex-wrap items-center justify-between gap-2">
+            <span>
+              Your wallet is on another network. Switch to {USDC_CHAIN.name} to
+              send USDC.
+            </span>
+            <button
+              type="button"
+              onClick={() => switchChain({ chainId: USDC_CHAIN.id })}
+              disabled={isSwitching}
+              className="rounded-md bg-amber-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-amber-700 disabled:opacity-60"
+            >
+              {isSwitching ? "Switching…" : `Switch to ${USDC_CHAIN.name}`}
+            </button>
+          </div>
+        </Notice>
+      ) : null}
+
+      {noEth ? (
+        <Notice variant="warning">
+          You have no ETH. Ethereum charges the network fee in ETH, so you need
+          a small amount before you can send USDC.
+        </Notice>
+      ) : null}
+
+      <form
+        className="flex flex-col gap-4 rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900"
+        onSubmit={(event) => {
+          event.preventDefault();
+          submit();
+        }}
+      >
+        <div className="flex flex-col gap-1.5">
+          <label
+            htmlFor="recipient"
+            className="text-sm font-medium text-slate-700 dark:text-slate-300"
+          >
+            Recipient
+          </label>
+          <input
+            id="recipient"
+            name="recipient"
+            value={recipientInput}
+            onChange={(event) => setRecipientInput(event.target.value)}
+            placeholder="0x… or name.eth"
+            spellCheck={false}
+            autoComplete="off"
+            autoCorrect="off"
+            disabled={busy}
+            aria-invalid={Boolean(recipient.error)}
+            aria-describedby="recipient-help"
+            className="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 font-mono text-sm text-slate-900 outline-none placeholder:font-sans placeholder:text-slate-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/30 disabled:opacity-60 aria-invalid:border-red-400 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-50"
+          />
+          <p id="recipient-help" className="min-h-5 text-xs">
+            {recipient.error ? (
+              <span className="text-red-600 dark:text-red-400" role="alert">
+                {recipient.error}
+              </span>
+            ) : recipient.isResolving ? (
+              <span className="text-slate-500">Resolving…</span>
+            ) : recipient.address && recipient.ensName ? (
+              <span className="text-slate-500 dark:text-slate-400">
+                Resolves to{" "}
+                <a
+                  href={explorerAddress(recipient.address)}
+                  target="_blank"
+                  rel="noreferrer noopener"
+                  className="font-mono underline underline-offset-2 hover:no-underline"
+                >
+                  {recipient.address}
+                </a>
+              </span>
+            ) : null}
+          </p>
+        </div>
+
+        <div className="flex flex-col gap-1.5">
+          <div className="flex items-baseline justify-between">
+            <label
+              htmlFor="amount"
+              className="text-sm font-medium text-slate-700 dark:text-slate-300"
+            >
+              Amount
+            </label>
+            {usdcBalance !== undefined && usdcBalance > 0n ? (
+              <button
+                type="button"
+                disabled={busy}
+                onClick={() => setAmountInput(formatUnits(usdcBalance, decimals))}
+                className="text-xs font-medium text-blue-600 hover:underline disabled:opacity-60 dark:text-blue-400"
+              >
+                Use max
+              </button>
+            ) : null}
+          </div>
+          <div className="relative">
+            <input
+              id="amount"
+              name="amount"
+              value={amountInput}
+              onChange={(event) => setAmountInput(event.target.value)}
+              placeholder="0.00"
+              inputMode="decimal"
+              autoComplete="off"
+              disabled={busy}
+              aria-invalid={Boolean(amountError)}
+              aria-describedby="amount-help"
+              className="w-full rounded-lg border border-slate-300 bg-white py-2.5 pl-3 pr-16 text-sm tabular-nums text-slate-900 outline-none placeholder:text-slate-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/30 disabled:opacity-60 aria-invalid:border-red-400 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-50"
+            />
+            <span className="pointer-events-none absolute inset-y-0 right-3 flex items-center text-sm font-medium text-slate-500 dark:text-slate-400">
+              USDC
+            </span>
+          </div>
+          <p id="amount-help" className="min-h-5 text-xs">
+            {amountError ? (
+              <span className="text-red-600 dark:text-red-400" role="alert">
+                {amountError}
+              </span>
+            ) : send.maxFee !== undefined ? (
+              <span className="text-slate-500 dark:text-slate-400">
+                Estimated network fee: up to {formatEthFee(send.maxFee)} ETH
+              </span>
+            ) : null}
+          </p>
+        </div>
+
+        {recipient.warning ? (
+          <Notice variant="warning">{recipient.warning}</Notice>
+        ) : null}
+
+        {feeLooksTight ? (
+          <Notice variant="warning">
+            Your ETH balance may not cover the network fee for this transfer
+            (up to {formatEthFee(send.maxFee!)} ETH).
+          </Notice>
+        ) : null}
+
+        {send.status === "error" && send.error ? (
+          <Notice variant="error" role="alert">
+            {toFriendlyError(send.error)}
+          </Notice>
+        ) : null}
+
+        {amount !== undefined && recipient.address && !recipient.error ? (
+          <p className="text-sm text-slate-600 dark:text-slate-400">
+            Sending{" "}
+            <strong className="font-semibold text-slate-900 tabular-nums dark:text-slate-100">
+              {formatAmount(amount, decimals)} USDC
+            </strong>{" "}
+            to{" "}
+            <strong className="font-mono font-semibold text-slate-900 dark:text-slate-100">
+              {recipient.ensName ?? shortAddress(recipient.address, 6)}
+            </strong>
+          </p>
+        ) : null}
+
+        {send.status === "success" ? null : (
+          <button
+            type="submit"
+            disabled={!canSend}
+            className="rounded-lg bg-blue-600 px-4 py-3 text-sm font-semibold text-white transition-colors hover:bg-blue-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 disabled:cursor-not-allowed disabled:bg-slate-300 disabled:text-slate-500 dark:disabled:bg-slate-800 dark:disabled:text-slate-500"
+          >
+            {send.status === "checking" || !simulationMatchesForm
+              ? "Checking transfer…"
+              : send.status === "signing"
+                ? "Confirm in your wallet…"
+                : send.status === "pending"
+                  ? "Sending…"
+                  : "Send USDC"}
+          </button>
+        )}
+
+        <TxStatus
+          status={send.status}
+          hash={send.hash}
+          amount={sent?.amount}
+          decimals={decimals}
+          to={sent?.to}
+          ensName={sent?.ensName}
+          onReset={resetForm}
+        />
+      </form>
+
+      <p className="text-center text-xs text-slate-500 dark:text-slate-400">
+        Transfers are final. Double-check the recipient before sending.
+      </p>
+    </div>
+  );
+}
diff --git a/src/components/TxStatus.tsx b/src/components/TxStatus.tsx
