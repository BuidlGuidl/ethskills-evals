# Required. Dedicated Ethereum mainnet RPC (Alchemy, Infura, QuickNode, ...).
# The public RPC is only used as a last-resort fallback.
NEXT_PUBLIC_MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# Required. WalletConnect / Reown project id: https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Required in production. Public origin, used for absolute Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://pay.example.com
