diff --git a/src/components/PayForm.tsx b/src/components/PayForm.tsx
new file mode 100644
index 0000000..ef3e9db
--- /dev/null
+++ b/src/components/PayForm.tsx
@@ -0,0 +1,381 @@
+'use client'
+
+import { useEffect, useMemo, useState } from 'react'
+import { useConnectModal } from '@rainbow-me/rainbowkit'
+import { formatUnits, type Address } from 'viem'
+import {
+  useAccount,
+  useChainId,
+  useSimulateContract,
+  useSwitchChain,
+  useWaitForTransactionReceipt,
+  useWriteContract,
+} from 'wagmi'
+import { useGasCost } from '@/hooks/useGasCost'
+import { useRecipient } from '@/hooks/useRecipient'
+import { formatAmountText, formatEth, parseAmount, sanitizeAmountInput } from '@/lib/amount'
+import { targetChain } from '@/lib/chain'
+import { toFriendlyError } from '@/lib/errors'
+import { USDC_ADDRESS, usdcAbi } from '@/lib/usdc'
+import { TransferStatus } from './TransferStatus'
+import { Button, Card, Notice, Spinner, cx, truncateAddress } from './ui'
+
+type Props = {
+  usdcBalance?: bigint
+  ethBalance?: bigint
+  decimals: number
+  symbol: string
+  onTransferConfirmed: () => void
+}
+
+type Snapshot = {
+  amountText: string
+  recipient: Address
+  recipientLabel: string
+}
+
+export function PayForm({
+  usdcBalance,
+  ethBalance,
+  decimals,
+  symbol,
+  onTransferConfirmed,
+}: Props) {
+  const { address, isConnected } = useAccount()
+  const chainId = useChainId()
+  const { openConnectModal } = useConnectModal()
+  const { switchChain, isPending: isSwitching } = useSwitchChain()
+
+  const [recipientInput, setRecipientInput] = useState('')
+  const [amountInput, setAmountInput] = useState('')
+  const [touched, setTouched] = useState({ recipient: false, amount: false })
+  const [isReviewing, setIsReviewing] = useState(false)
+  const [snapshot, setSnapshot] = useState<Snapshot | null>(null)
+
+  const onWrongChain = isConnected && chainId !== targetChain.id
+  const recipient = useRecipient(recipientInput, address)
+
+  const parsed = useMemo(() => parseAmount(amountInput, decimals), [amountInput, decimals])
+  const amount = parsed.ok ? parsed.value : null
+
+  const overBalance =
+    amount !== null && usdcBalance !== undefined && amount > usdcBalance
+      ? `You only have ${formatAmountText(usdcBalance, decimals)} ${symbol}`
+      : null
+
+  const amountError = (!parsed.ok ? parsed.error : null) ?? overBalance
+  const showRecipientError = touched.recipient && recipient.error
+  const showAmountError = touched.amount && amountError
+
+  const isReady =
+    isConnected && !onWrongChain && Boolean(recipient.address) && amount !== null && !overBalance
+
+  // Dry-run against the real contract state: this is what catches a paused
+  // token, a blacklisted address, or a balance that changed under us — before
+  // the user is asked to sign anything.
+  const simulation = useSimulateContract({
+    address: USDC_ADDRESS,
+    abi: usdcAbi,
+    functionName: 'transfer',
+    args: recipient.address && amount !== null ? [recipient.address, amount] : undefined,
+    chainId: targetChain.id,
+    query: { enabled: isReady },
+  })
+
+  const gas = useGasCost({
+    account: address,
+    to: recipient.address,
+    value: amount,
+    enabled: isReady,
+  })
+
+  const { writeContract, data: hash, isPending: isSigning, error: writeError, reset } = useWriteContract()
+  const receipt = useWaitForTransactionReceipt({ hash, chainId: targetChain.id, confirmations: 1 })
+
+  useEffect(() => {
+    if (receipt.data?.status === 'success') onTransferConfirmed()
+  }, [receipt.data?.status, onTransferConfirmed])
+
+  const noEth = isConnected && ethBalance === 0n
+  const gasIsTight =
+    !noEth && ethBalance !== undefined && gas.maxCost !== null && ethBalance < gas.maxCost
+
+  const simulationError = isReady ? toFriendlyError(simulation.error) : null
+  const submitError = toFriendlyError(writeError)
+
+  const resetAll = () => {
+    reset()
+    setSnapshot(null)
+    setIsReviewing(false)
+    setRecipientInput('')
+    setAmountInput('')
+    setTouched({ recipient: false, amount: false })
+  }
+
+  const startReview = () => {
+    setTouched({ recipient: true, amount: true })
+    if (!isReady) return
+    setIsReviewing(true)
+  }
+
+  const confirmAndSend = () => {
+    if (!simulation.data || !recipient.address || amount === null) return
+    setSnapshot({
+      amountText: formatAmountText(amount, decimals, { minFractionDigits: 2 }),
+      recipient: recipient.address,
+      recipientLabel: recipient.ensName ?? '',
+    })
+    writeContract(simulation.data.request)
+  }
+
+  if (hash && snapshot) {
+    return (
+      <Card>
+        <TransferStatus
+          hash={hash}
+          status={
+            receipt.data?.status === 'reverted'
+              ? 'reverted'
+              : receipt.data?.status === 'success'
+                ? 'success'
+                : 'pending'
+          }
+          amountText={snapshot.amountText}
+          symbol={symbol}
+          recipient={snapshot.recipient}
+          recipientLabel={snapshot.recipientLabel}
+          lookupFailed={receipt.isError}
+          onReset={resetAll}
+        />
+      </Card>
+    )
+  }
+
+  if (isReviewing && recipient.address && amount !== null) {
+    return (
+      <Card>
+        <div className="flex flex-col gap-4">
+          <div>
+            <h2 className="text-base font-semibold">Confirm payment</h2>
+            <p className="mt-0.5 text-sm text-muted">
+              Transfers on Ethereum cannot be reversed. Check the address once more.
+            </p>
+          </div>
+
+          <dl className="flex flex-col gap-3 rounded-xl border border-card-border bg-white/[0.02] p-4 text-sm">
+            <div className="flex items-baseline justify-between gap-4">
+              <dt className="text-muted">Amount</dt>
+              <dd className="numeric text-base font-semibold">
+                {formatAmountText(amount, decimals, { minFractionDigits: 2 })} {symbol}
+              </dd>
+            </div>
+            <div className="flex items-baseline justify-between gap-4">
+              <dt className="text-muted">To</dt>
+              <dd className="text-right">
+                {recipient.ensName ? (
+                  <span className="block font-medium">{recipient.ensName}</span>
+                ) : null}
+                <span className="numeric break-all text-xs text-muted">{recipient.address}</span>
+              </dd>
+            </div>
+            <div className="flex items-baseline justify-between gap-4">
+              <dt className="text-muted">Network fee</dt>
+              <dd className="numeric text-right">
+                {gas.maxCost !== null ? (
+                  <>up to {formatEth(gas.maxCost)} ETH</>
+                ) : gas.isLoading ? (
+                  <span className="text-muted">estimating…</span>
+                ) : (
+                  <span className="text-muted">unavailable</span>
+                )}
+              </dd>
+            </div>
+          </dl>
+
+          {recipient.warning ? <Notice tone="warn">{recipient.warning}</Notice> : null}
+          {gasIsTight ? (
+            <Notice tone="warn">
+              Your ETH balance may not cover the network fee. Top up if the wallet
+              rejects the transaction.
+            </Notice>
+          ) : null}
+          {simulationError ? <Notice tone="error">{simulationError.message}</Notice> : null}
+          {submitError && !submitError.rejected ? (
+            <Notice tone="error">{submitError.message}</Notice>
+          ) : null}
+          {submitError?.rejected ? (
+            <Notice tone="info">{submitError.message}</Notice>
+          ) : null}
+
+          <div className="flex flex-col-reverse gap-2 sm:flex-row">
+            <Button
+              variant="ghost"
+              className="sm:w-auto sm:px-6"
+              onClick={() => {
+                reset()
+                setIsReviewing(false)
+              }}
+              disabled={isSigning}
+            >
+              Back
+            </Button>
+            <Button
+              onClick={confirmAndSend}
+              disabled={isSigning || !simulation.data || Boolean(simulationError)}
+            >
+              {isSigning ? (
+                <>
+                  <Spinner /> Confirm in your wallet
+                </>
+              ) : (
+                `Send ${formatAmountText(amount, decimals, { minFractionDigits: 2 })} ${symbol}`
+              )}
+            </Button>
+          </div>
+        </div>
+      </Card>
+    )
+  }
+
+  return (
+    <Card>
+      <form
+        className="flex flex-col gap-5"
+        onSubmit={(event) => {
+          event.preventDefault()
+          if (!isConnected) return openConnectModal?.()
+          if (onWrongChain) return switchChain({ chainId: targetChain.id })
+          startReview()
+        }}
+      >
+        <div>
+          <h1 className="text-base font-semibold">Send {symbol}</h1>
+          <p className="mt-0.5 text-sm text-muted">
+            Straight from your wallet to theirs on Ethereum mainnet.
+          </p>
+        </div>
+
+        {/* Recipient */}
+        <div className="flex flex-col gap-1.5">
+          <label htmlFor="recipient" className="text-sm font-medium">
+            Recipient
+          </label>
+          <div
+            className={cx(
+              'flex items-center gap-2 rounded-xl border bg-white/[0.02] px-3.5 focus-within:border-brand',
+              showRecipientError ? 'border-danger/60' : 'border-card-border',
+            )}
+          >
+            <input
+              id="recipient"
+              value={recipientInput}
+              onChange={(event) => setRecipientInput(event.target.value)}
+              onBlur={() => setTouched((prev) => ({ ...prev, recipient: true }))}
+              placeholder="0x… or name.eth"
+              autoComplete="off"
+              spellCheck={false}
+              inputMode="text"
+              aria-invalid={Boolean(showRecipientError)}
+              aria-describedby="recipient-help"
+              className="numeric h-12 w-full bg-transparent text-[15px] outline-none placeholder:text-muted/60"
+            />
+            {recipient.isResolving ? <Spinner className="text-muted" /> : null}
+          </div>
+          <p
+            id="recipient-help"
+            role={showRecipientError ? 'alert' : undefined}
+            className={cx(
+              'min-h-4 text-xs',
+              showRecipientError ? 'text-danger' : 'text-muted',
+            )}
+          >
+            {showRecipientError
+              ? recipient.error
+              : recipient.address && recipient.ensName
+                ? `${recipient.ensName} → ${truncateAddress(recipient.address, 6)}`
+                : ''}
+          </p>
+        </div>
+
+        {/* Amount */}
+        <div className="flex flex-col gap-1.5">
+          <div className="flex items-baseline justify-between">
+            <label htmlFor="amount" className="text-sm font-medium">
+              Amount
+            </label>
+            {usdcBalance !== undefined && usdcBalance > 0n ? (
+              <button
+                type="button"
+                onClick={() => {
+                  setAmountInput(formatUnits(usdcBalance, decimals))
+                  setTouched((prev) => ({ ...prev, amount: true }))
+                }}
+                className="text-xs font-semibold text-brand hover:underline"
+              >
+                Max
+              </button>
+            ) : null}
+          </div>
+          <div
+            className={cx(
+              'flex items-center gap-2 rounded-xl border bg-white/[0.02] px-3.5 focus-within:border-brand',
+              showAmountError ? 'border-danger/60' : 'border-card-border',
+            )}
+          >
+            <input
+              id="amount"
+              value={amountInput}
+              onChange={(event) =>
+                setAmountInput(sanitizeAmountInput(event.target.value, decimals))
+              }
+              onBlur={() => setTouched((prev) => ({ ...prev, amount: true }))}
+              placeholder="0.00"
+              inputMode="decimal"
+              autoComplete="off"
+              aria-invalid={Boolean(showAmountError)}
+              aria-describedby="amount-help"
+              className="numeric h-12 w-full bg-transparent text-[15px] outline-none placeholder:text-muted/60"
+            />
+            <span className="text-sm font-medium text-muted">{symbol}</span>
+          </div>
+          <p
+            id="amount-help"
+            role={showAmountError ? 'alert' : undefined}
+            className={cx('min-h-4 text-xs', showAmountError ? 'text-danger' : 'text-muted')}
+          >
+            {showAmountError ? amountError : ''}
+          </p>
+        </div>
+
+        {recipient.warning && !showRecipientError ? (
+          <Notice tone="warn">{recipient.warning}</Notice>
+        ) : null}
+
+        {noEth ? (
+          <Notice tone="warn">
+            You have no ETH. Ethereum charges gas in ETH, so this transfer cannot be
+            sent until you add some.
+          </Notice>
+        ) : null}
+
+        {onWrongChain ? (
+          <Notice tone="warn">
+            USDC lives on Ethereum mainnet. Switch networks to continue.
+          </Notice>
+        ) : null}
+
+        {simulationError ? <Notice tone="error">{simulationError.message}</Notice> : null}
+
+        <Button type="submit" disabled={isSwitching || (isConnected && !onWrongChain && !isReady)}>
+          {!isConnected
+            ? 'Connect wallet'
+            : onWrongChain
+              ? isSwitching
+                ? <><Spinner /> Switching…</>
+                : 'Switch to Ethereum'
+              : 'Review payment'}
+        </Button>
+      </form>
+    </Card>
+  )
+}
