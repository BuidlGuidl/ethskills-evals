+'use client'
+
+import { formatAmount, formatAmountText, formatEth } from '@/lib/amount'
+import { Card, Skeleton } from './ui'
+
+type Props = {
+  usdcBalance?: bigint
+  ethBalance?: bigint
+  decimals: number
+  symbol: string
+  isLoading: boolean
+  isConnected: boolean
+}
+
+function Tile({
+  label,
+  hint,
+  children,
+}: {
+  label: string
+  hint?: string
+  children: React.ReactNode
+}) {
+  return (
+    <Card className="flex-1">
+      <p className="text-xs font-medium uppercase tracking-wide text-muted">{label}</p>
+      <div className="mt-1.5 numeric text-2xl font-semibold">{children}</div>
+      {hint ? <p className="mt-1 text-xs text-muted">{hint}</p> : null}
+    </Card>
+  )
+}
+
+export function Balances({
+  usdcBalance,
+  ethBalance,
+  decimals,
+  symbol,
+  isLoading,
+  isConnected,
+}: Props) {
+  const placeholder = <span className="text-muted">—</span>
+
+  const usdc =
+    usdcBalance === undefined ? null : formatAmount(usdcBalance, decimals, { minFractionDigits: 2 })
+
+  const ethText = ethBalance === undefined ? null : formatEth(ethBalance, 5)
+
+  return (
+    <div className="flex flex-col gap-3 sm:flex-row">
+      <Tile label={`${symbol} balance`} hint={isConnected ? 'Available to send' : 'Connect your wallet'}>
+        {!isConnected ? (
+          placeholder
+        ) : usdc ? (
+          <span title={`${formatAmountText(usdcBalance!, decimals)} ${symbol}`}>
+            {usdc.text}
+            <span className="ml-1.5 text-sm font-medium text-muted">{symbol}</span>
+          </span>
+        ) : isLoading ? (
+          <Skeleton className="h-7 w-28 align-middle" />
+        ) : (
+          placeholder
+        )}
+      </Tile>
+
+      <Tile label="ETH balance" hint="Pays for gas">
+        {!isConnected ? (
+          placeholder
+        ) : ethText ? (
+          <span title={ethBalance !== undefined ? `${formatAmountText(ethBalance, 18)} ETH` : undefined}>
+            {ethText}
+            <span className="ml-1.5 text-sm font-medium text-muted">ETH</span>
+          </span>
+        ) : isLoading ? (
+          <Skeleton className="h-7 w-24 align-middle" />
+        ) : (
+          placeholder
+        )}
+      </Tile>
+    </div>
+  )
+}
