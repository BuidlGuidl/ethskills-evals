+import type { Metadata, Viewport } from 'next'
+import { headers } from 'next/headers'
+import { cookieToInitialState } from 'wagmi'
+import { Providers } from '@/components/Providers'
+import { serverConfig } from '@/lib/wagmi.base'
+import './globals.css'
+
+export const metadata: Metadata = {
+  title: 'USDC Pay',
+  description: 'Send USDC on Ethereum mainnet from your own wallet.',
+}
+
+export const viewport: Viewport = {
+  themeColor: '#0b0d12',
+}
+
+export default async function RootLayout({ children }: { children: React.ReactNode }) {
+  // Rehydrate the wallet connection on the server so a connected user never
+  // sees a "Connect wallet" flash on first paint.
+  const initialState = cookieToInitialState(serverConfig, (await headers()).get('cookie'))
+
+  return (
+    <html lang="en">
+      <body className="min-h-dvh font-sans antialiased">
+        <Providers initialState={initialState}>{children}</Providers>
+      </body>
+    </html>
+  )
+}
