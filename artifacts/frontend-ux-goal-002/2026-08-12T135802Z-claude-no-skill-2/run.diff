@@ -0,0 +1,32 @@
+'use client'
+
+import { useReadContracts } from 'wagmi'
+import { targetChain } from '@/lib/chain'
+import { USDC_ADDRESS, USDC_DECIMALS, USDC_SYMBOL, usdcAbi } from '@/lib/usdc'
+
+/**
+ * Token metadata straight from the contract. USDC's decimals have never
+ * changed, but reading them (instead of assuming 6) is what makes the amount
+ * maths correct by construction rather than by folklore.
+ */
+export function useUsdcMeta() {
+  const { data, isLoading } = useReadContracts({
+    allowFailure: false,
+    contracts: [
+      { address: USDC_ADDRESS, abi: usdcAbi, functionName: 'decimals', chainId: targetChain.id },
+      { address: USDC_ADDRESS, abi: usdcAbi, functionName: 'symbol', chainId: targetChain.id },
+    ],
+    query: {
+      // Immutable for the lifetime of the token.
+      staleTime: Infinity,
+      gcTime: Infinity,
+    },
+  })
+
+  return {
+    decimals: data ? Number(data[0]) : USDC_DECIMALS,
+    symbol: data ? data[1] : USDC_SYMBOL,
+    /** True until the on-chain values confirm the fallbacks above. */
+    isLoading,
+  }
+}
