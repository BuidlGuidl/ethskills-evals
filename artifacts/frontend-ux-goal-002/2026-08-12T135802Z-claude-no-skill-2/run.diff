+++ b/src/hooks/useBalances.ts
@@ -0,0 +1,53 @@
+'use client'
+
+import { useEffect } from 'react'
+import { useQueryClient } from '@tanstack/react-query'
+import { useAccount, useBalance, useBlockNumber, useReadContract } from 'wagmi'
+import { targetChain } from '@/lib/chain'
+import { USDC_ADDRESS, usdcAbi } from '@/lib/usdc'
+
+/**
+ * The user's USDC (for the payment) and ETH (for gas), both re-read on every
+ * new block so the numbers on screen match the chain even when funds move
+ * from somewhere else.
+ */
+export function useBalances() {
+  const { address } = useAccount()
+  const queryClient = useQueryClient()
+  const { data: blockNumber } = useBlockNumber({ chainId: targetChain.id, watch: true })
+
+  const usdc = useReadContract({
+    address: USDC_ADDRESS,
+    abi: usdcAbi,
+    functionName: 'balanceOf',
+    args: address ? [address] : undefined,
+    chainId: targetChain.id,
+    query: { enabled: Boolean(address) },
+  })
+
+  const eth = useBalance({
+    address,
+    chainId: targetChain.id,
+    query: { enabled: Boolean(address) },
+  })
+
+  useEffect(() => {
+    if (!blockNumber || !address) return
+    queryClient.invalidateQueries({ queryKey: usdc.queryKey })
+    queryClient.invalidateQueries({ queryKey: eth.queryKey })
+    // Re-reading is keyed on the block, not on the query objects themselves.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [blockNumber, address])
+
+  return {
+    usdcBalance: usdc.data,
+    ethBalance: eth.data?.value,
+    isLoading: usdc.isLoading || eth.isLoading,
+    /** Only true on a failed first load; refetches keep the last good value. */
+    error: usdc.error ?? eth.error ?? null,
+    refetch: () => {
+      void usdc.refetch()
+      void eth.refetch()
+    },
+  }
+}
