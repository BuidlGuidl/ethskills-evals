+++ b/src/hooks/useGasCost.ts
@@ -0,0 +1,52 @@
+'use client'
+
+import { type Address, encodeFunctionData } from 'viem'
+import { useEstimateFeesPerGas, useEstimateGas } from 'wagmi'
+import { targetChain } from '@/lib/chain'
+import { USDC_ADDRESS, usdcAbi } from '@/lib/usdc'
+
+type Params = {
+  account?: Address
+  to?: Address | null
+  value?: bigint | null
+  enabled?: boolean
+}
+
+/**
+ * What this transfer will cost in ETH, so we can tell the user *before* they
+ * sign that their gas balance is short — the most common way an otherwise
+ * valid USDC payment fails.
+ */
+export function useGasCost({ account, to, value, enabled = true }: Params) {
+  const ready = Boolean(enabled && account && to && value && value > 0n)
+
+  const data =
+    to && value
+      ? encodeFunctionData({ abi: usdcAbi, functionName: 'transfer', args: [to, value] })
+      : undefined
+
+  const gas = useEstimateGas({
+    account,
+    to: USDC_ADDRESS,
+    data,
+    chainId: targetChain.id,
+    query: { enabled: ready && Boolean(data) },
+  })
+
+  const fees = useEstimateFeesPerGas({
+    chainId: targetChain.id,
+    query: { enabled: ready, refetchInterval: 12_000 },
+  })
+
+  const pricePerGas = fees.data?.maxFeePerGas ?? fees.data?.gasPrice
+  // Wallets reserve maxFeePerGas up front, so that — not the base fee — is the
+  // number that decides whether the transaction can even be submitted.
+  const maxCost = gas.data && pricePerGas ? gas.data * pricePerGas : null
+
+  return {
+    gasLimit: gas.data ?? null,
+    maxFeePerGas: pricePerGas ?? null,
+    maxCost,
+    isLoading: ready && (gas.isLoading || fees.isLoading),
+  }
+}
diff --git a/src/hooks/useRecipient.ts b/src/hooks/useRecipient.ts
new file mode 100644
index 0000000..5acd153
--- /dev/null
+++ b/src/hooks/useRecipient.ts
@@ -0,0 +1,130 @@
+'use client'
+
+import { useMemo } from 'react'
+import { type Address, getAddress, isAddress } from 'viem'
+import { normalize } from 'viem/ens'
+import { useBytecode, useEnsAddress, useEnsName } from 'wagmi'
+import { targetChain } from '@/lib/chain'
+import { USDC_ADDRESS } from '@/lib/usdc'
+
+export type RecipientState = {
+  /** Checksummed address to send to, once we have one. */
+  address: Address | null
+  /** ENS name, whether typed by the user or reverse-resolved from an address. */
+  ensName: string | null
+  isResolving: boolean
+  /** Blocks the transfer. */
+  error: string | null
+  /** Worth showing, but the user may proceed. */
+  warning: string | null
+}
+
+const looksLikeEnsName = (value: string) => /^[^\s]+\.[a-z]{2,}$/i.test(value)
+
+/**
+ * EIP-7702 accounts are still EOAs — their "code" is just a 23-byte pointer
+ * (0xef0100 ‖ address) to the contract they delegate to. They receive ERC-20s
+ * exactly like any other wallet, so they must not trigger the contract warning.
+ */
+const isDelegatedEoa = (code: string) => code.length === 48 && code.startsWith('0xef0100')
+
+/**
+ * Accepts either a hex address or an ENS name and resolves it to something we
+ * are willing to send money to. Deliberately strict: an unresolvable name or a
+ * malformed address is an error, not a silent no-op, because the cost of
+ * getting this field wrong is an irreversible transfer.
+ */
+export function useRecipient(input: string, sender?: Address): RecipientState {
+  const value = input.trim()
+
+  const ensQuery = useMemo(() => {
+    if (!looksLikeEnsName(value)) return undefined
+    try {
+      return normalize(value)
+    } catch {
+      return undefined
+    }
+  }, [value])
+
+  const {
+    data: resolvedAddress,
+    isLoading: isResolvingName,
+    isError: ensLookupFailed,
+  } = useEnsAddress({
+    name: ensQuery,
+    chainId: targetChain.id,
+    query: { enabled: Boolean(ensQuery) },
+  })
+
+  const typedAddress = isAddress(value, { strict: false }) ? getAddress(value) : null
+  const address = typedAddress ?? resolvedAddress ?? null
+
+  // Reverse lookup is a confirmation aid for pasted addresses: seeing
+  // "vitalik.eth" under the field catches a wrong paste better than hex does.
+  const { data: reverseName } = useEnsName({
+    address: typedAddress ?? undefined,
+    chainId: targetChain.id,
+    query: { enabled: Boolean(typedAddress) },
+  })
+
+  // A contract that does not handle ERC-20 tokens will hold them forever.
+  const { data: bytecode } = useBytecode({
+    address: address ?? undefined,
+    chainId: targetChain.id,
+    query: { enabled: Boolean(address) },
+  })
+
+  return useMemo(() => {
+    const base = {
+      address,
+      ensName: ensQuery ? value : (reverseName ?? null),
+      isResolving: isResolvingName,
+    }
+
+    if (!value) return { ...base, error: null, warning: null }
+
+    if (!address) {
+      if (isResolvingName) return { ...base, error: null, warning: null }
+      if (ensQuery) {
+        return {
+          ...base,
+          error: ensLookupFailed
+            ? 'Could not look up that ENS name. Check your connection and try again.'
+            : `${value} does not resolve to an address`,
+          warning: null,
+        }
+      }
+      if (value.startsWith('0x') && value.length !== 42) {
+        return { ...base, error: 'An Ethereum address is 42 characters long', warning: null }
+      }
+      return { ...base, error: 'Enter a valid Ethereum address or ENS name', warning: null }
+    }
+
+    if (address === '0x0000000000000000000000000000000000000000') {
+      return { ...base, error: 'That is the zero address — the funds would be destroyed', warning: null }
+    }
+
+    if (address.toLowerCase() === USDC_ADDRESS.toLowerCase()) {
+      return {
+        ...base,
+        error: 'That is the USDC contract itself. Tokens sent there are unrecoverable.',
+        warning: null,
+      }
+    }
+
+    if (sender && address.toLowerCase() === sender.toLowerCase()) {
+      return { ...base, error: null, warning: 'This is your own address — you would only pay gas.' }
+    }
+
+    if (bytecode && bytecode !== '0x' && !isDelegatedEoa(bytecode)) {
+      return {
+        ...base,
+        error: null,
+        warning:
+          'This address is a smart contract. Make sure it can receive USDC, or the tokens may be stuck.',
+      }
+    }
+
+    return { ...base, error: null, warning: null }
+  }, [address, bytecode, ensLookupFailed, ensQuery, isResolvingName, reverseName, sender, value])
+}
