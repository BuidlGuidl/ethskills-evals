@@ -0,0 +1,87 @@
+'use client'
+
+import type { Address, Hash } from 'viem'
+import { explorerTxUrl } from '@/lib/chain'
+import { Button, Notice, Spinner, truncateAddress } from './ui'
+
+type Props = {
+  hash: Hash
+  status: 'pending' | 'success' | 'reverted'
+  amountText: string
+  symbol: string
+  recipient: Address
+  recipientLabel: string
+  /** The receipt lookup itself failed — the transaction may still be fine. */
+  lookupFailed?: boolean
+  onReset: () => void
+}
+
+export function TransferStatus({
+  hash,
+  status,
+  amountText,
+  symbol,
+  recipient,
+  recipientLabel,
+  lookupFailed = false,
+  onReset,
+}: Props) {
+  const to = recipientLabel || truncateAddress(recipient)
+
+  return (
+    <div className="flex flex-col gap-4">
+      {status === 'pending' && (
+        <Notice tone="info" className="flex items-start gap-3">
+          <Spinner className="mt-0.5 text-brand" />
+          <span>
+            <span className="block font-medium text-ink">Sending {amountText} {symbol}</span>
+            Waiting for the network to confirm. You can safely leave this page — the
+            transaction will go through either way.
+          </span>
+        </Notice>
+      )}
+
+      {status === 'pending' && lookupFailed && (
+        <Notice tone="warn">
+          We lost track of this transaction while waiting for confirmation. It was
+          submitted — check Etherscan below for the outcome.
+        </Notice>
+      )}
+
+      {status === 'success' && (
+        <Notice tone="success">
+          <span className="block font-medium">
+            Sent {amountText} {symbol} to {to}
+          </span>
+          <span className="text-ok/80">Confirmed on Ethereum mainnet.</span>
+        </Notice>
+      )}
+
+      {status === 'reverted' && (
+        <Notice tone="error">
+          <span className="block font-medium">The transfer failed on chain</span>
+          Your USDC was not sent, but the gas was spent. Check the transaction for
+          the reason before retrying.
+        </Notice>
+      )}
+
+      <div className="flex flex-col gap-2">
+        <a
+          href={explorerTxUrl(hash)}
+          target="_blank"
+          rel="noreferrer"
+          className="text-sm text-brand underline-offset-4 hover:underline"
+        >
+          View on Etherscan ↗
+        </a>
+        <p className="numeric break-all text-xs text-muted">{hash}</p>
+      </div>
+
+      {(status !== 'pending' || lookupFailed) && (
+        <Button variant="ghost" onClick={onReset}>
+          {status === 'success' ? 'Send another payment' : 'Start over'}
+        </Button>
+      )}
+    </div>
+  )
+}
