+'use client'
+
+import { useCallback } from 'react'
+import { useAccount } from 'wagmi'
+import { useBalances } from '@/hooks/useBalances'
+import { useUsdcMeta } from '@/hooks/useUsdcMeta'
+import { explorerAddressUrl } from '@/lib/chain'
+import { USDC_ADDRESS } from '@/lib/usdc'
+import { walletConnectEnabled } from '@/lib/wagmi'
+import { Balances } from './Balances'
+import { Header } from './Header'
+import { PayForm } from './PayForm'
+import { Notice, truncateAddress } from './ui'
+
+export function PayView() {
+  const { isConnected } = useAccount()
+  const { decimals, symbol } = useUsdcMeta()
+  const { usdcBalance, ethBalance, isLoading, error, refetch } = useBalances()
+
+  const onTransferConfirmed = useCallback(() => refetch(), [refetch])
+
+  return (
+    <main className="mx-auto flex w-full max-w-xl flex-col gap-6 px-4 py-8 sm:py-12">
+      <Header />
+
+      <Balances
+        usdcBalance={usdcBalance}
+        ethBalance={ethBalance}
+        decimals={decimals}
+        symbol={symbol}
+        isLoading={isLoading}
+        isConnected={isConnected}
+      />
+
+      {error ? (
+        <Notice tone="error">
+          Could not read your balances from the network. Check your connection — the
+          amounts shown may be out of date.
+        </Notice>
+      ) : null}
+
+      <PayForm
+        usdcBalance={usdcBalance}
+        ethBalance={ethBalance}
+        decimals={decimals}
+        symbol={symbol}
+        onTransferConfirmed={onTransferConfirmed}
+      />
+
+      <footer className="flex flex-col gap-1 text-xs text-muted">
+        <p>
+          Token:{' '}
+          <a
+            href={explorerAddressUrl(USDC_ADDRESS)}
+            target="_blank"
+            rel="noreferrer"
+            className="text-brand underline-offset-4 hover:underline"
+          >
+            USDC {truncateAddress(USDC_ADDRESS, 6)} ↗
+          </a>{' '}
+          · {decimals} decimals · Ethereum mainnet
+        </p>
+        {!walletConnectEnabled ? (
+          <p>
+            WalletConnect is disabled: set NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID to
+            enable mobile wallets.
+          </p>
+        ) : null}
+      </footer>
+    </main>
+  )
+}
