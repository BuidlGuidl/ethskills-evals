@@ -0,0 +1,34 @@
+import type { NextConfig } from 'next'
+
+/**
+ * The Coinbase / WalletConnect connectors that ship inside RainbowKit reach for
+ * a handful of optional, server-or-react-native-only packages (x402 payment
+ * signing, pino's pretty printer). None of them are used by this app, and they
+ * are not installed, so stub them out instead of letting webpack fail the build.
+ */
+const OPTIONAL_DEPS = [
+  '@x402/core/client',
+  '@x402/evm',
+  '@x402/evm/exact/client',
+  '@x402/evm/upto/client',
+  '@x402/svm/exact/client',
+  'pino-pretty',
+  'lokijs',
+  'encoding',
+]
+
+const nextConfig: NextConfig = {
+  reactStrictMode: true,
+  // This app is self-contained; pin tracing to it so a lockfile further up the
+  // tree cannot pull the inferred workspace root somewhere else.
+  outputFileTracingRoot: import.meta.dirname,
+  webpack: (config) => {
+    config.resolve.alias = {
+      ...config.resolve.alias,
+      ...Object.fromEntries(OPTIONAL_DEPS.map((dep) => [dep, false])),
+    }
+    return config
+  },
+}
+
+export default nextConfig
