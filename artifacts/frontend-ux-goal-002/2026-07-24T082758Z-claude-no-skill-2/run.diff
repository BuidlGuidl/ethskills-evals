+import { getDefaultConfig } from "@rainbow-me/rainbowkit";
+import { http } from "wagmi";
+import { mainnet } from "wagmi/chains";
+
+/**
+ * WalletConnect project id. RainbowKit needs one for WalletConnect-based
+ * wallets (mobile QR, etc). Without it those connectors are degraded, but
+ * injected wallets (MetaMask, Rabby, browser wallets) still work.
+ */
+const projectId =
+  process.env.NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID ?? "PLACEHOLDER_PROJECT_ID";
+
+const mainnetRpc = process.env.NEXT_PUBLIC_MAINNET_RPC_URL;
+
+/**
+ * Mainnet-only. This app deals with real USDC and real ETH; there is no
+ * testnet story here by design. If the connected wallet is on another
+ * network, the UI prompts the user to switch (see NetworkGuard).
+ */
+export const config = getDefaultConfig({
+  appName: "USDC Pay",
+  projectId,
+  chains: [mainnet],
+  transports: {
+    // Fall back to the chain's public RPC when no dedicated URL is provided.
+    [mainnet.id]: http(mainnetRpc),
+  },
+  ssr: true,
+});
