+import { erc20Abi, getAddress, type Address } from "viem";
+import { mainnet } from "wagmi/chains";
+
+/**
+ * Circle USDC on Ethereum mainnet.
+ * Checksummed via getAddress so it matches on-chain expectations exactly.
+ */
+export const USDC_ADDRESS: Address = getAddress(
+  "0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48",
+);
+
+/**
+ * USDC uses 6 decimals — NOT 18. Getting this wrong is the classic way to
+ * send someone 1,000,000,000,000x too much (or too little). We read the
+ * on-chain value at runtime too (see useUsdcMeta), but 6 is the correct
+ * constant for mainnet USDC and is used as the source of truth for parsing.
+ */
+export const USDC_DECIMALS = 6;
+
+export const USDC_SYMBOL = "USDC";
+
+/** The chain this app operates on. USDC here is the real mainnet token. */
+export const USDC_CHAIN = mainnet;
+
+/** Standard ERC-20 ABI is sufficient for balanceOf / decimals / transfer. */
+export const usdcAbi = erc20Abi;
