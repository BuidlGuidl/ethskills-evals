@@ -0,0 +1,65 @@
+import { formatUnits } from "viem";
+
+/**
+ * Format a raw token amount (bigint, base units) for display, trimming to a
+ * sensible number of fractional digits without losing precision silently.
+ */
+export function formatTokenAmount(
+  value: bigint,
+  decimals: number,
+  displayDecimals = 2,
+): string {
+  const full = formatUnits(value, decimals);
+  const num = Number(full);
+
+  // For very small non-zero balances, avoid showing a misleading "0.00".
+  if (num > 0 && num < 1 / 10 ** displayDecimals) {
+    return `<${1 / 10 ** displayDecimals}`;
+  }
+
+  return num.toLocaleString("en-US", {
+    minimumFractionDigits: 0,
+    maximumFractionDigits: displayDecimals,
+  });
+}
+
+/** Shorten an address to 0x1234…abcd for compact display. */
+export function shortenAddress(address: string): string {
+  if (address.length < 10) return address;
+  return `${address.slice(0, 6)}…${address.slice(-4)}`;
+}
+
+/**
+ * Validate a user-entered decimal amount string against a token's decimals.
+ * Returns a structured result so the UI can show precise errors.
+ */
+export function validateAmountInput(
+  raw: string,
+  decimals: number,
+): { ok: true } | { ok: false; reason: string } {
+  const trimmed = raw.trim();
+  if (trimmed === "") return { ok: false, reason: "Enter an amount." };
+
+  // Only digits with a single optional decimal point.
+  if (!/^\d*\.?\d*$/.test(trimmed)) {
+    return { ok: false, reason: "Amount must be a number." };
+  }
+  if (trimmed === "." || trimmed === "") {
+    return { ok: false, reason: "Enter an amount." };
+  }
+
+  const [, fraction = ""] = trimmed.split(".");
+  if (fraction.length > decimals) {
+    return {
+      ok: false,
+      reason: `USDC supports at most ${decimals} decimal places.`,
+    };
+  }
+
+  const num = Number(trimmed);
+  if (!Number.isFinite(num) || num <= 0) {
+    return { ok: false, reason: "Amount must be greater than zero." };
+  }
+
+  return { ok: true };
+}
