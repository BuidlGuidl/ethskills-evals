@@ -0,0 +1,44 @@
+import { useReadContract } from "wagmi";
+import type { Address } from "viem";
+import { USDC_ADDRESS, USDC_DECIMALS, usdcAbi } from "@/lib/usdc";
+
+/**
+ * Reads the connected account's USDC balance and the token's decimals from
+ * chain. We trust the on-chain `decimals()` when available and fall back to
+ * the known constant (6) so amount parsing is never blocked on an RPC read.
+ */
+export function useUsdcBalance(address?: Address) {
+  const balance = useReadContract({
+    address: USDC_ADDRESS,
+    abi: usdcAbi,
+    functionName: "balanceOf",
+    args: address ? [address] : undefined,
+    query: {
+      enabled: Boolean(address),
+      // USDC balances move often; refresh on a modest interval.
+      refetchInterval: 15_000,
+    },
+  });
+
+  const decimalsRead = useReadContract({
+    address: USDC_ADDRESS,
+    abi: usdcAbi,
+    functionName: "decimals",
+    query: {
+      // decimals never changes; cache it hard.
+      staleTime: Infinity,
+      gcTime: Infinity,
+    },
+  });
+
+  const decimals = decimalsRead.data ?? USDC_DECIMALS;
+
+  return {
+    value: balance.data,
+    decimals,
+    isLoading: balance.isLoading,
+    isError: balance.isError,
+    error: balance.error,
+    refetch: balance.refetch,
+  };
+}
