+++ b/src/components/BalancePanel.tsx
@@ -0,0 +1,91 @@
+"use client";
+
+import { useAccount, useBalance } from "wagmi";
+import { formatTokenAmount } from "@/lib/format";
+import { USDC_SYMBOL } from "@/lib/usdc";
+import { useUsdcBalance } from "@/hooks/useUsdcBalance";
+
+/**
+ * Shows the connected account's USDC balance (what they can send) and their
+ * native ETH balance (which they need to pay gas).
+ */
+export function BalancePanel() {
+  const { address } = useAccount();
+
+  const usdc = useUsdcBalance(address);
+  const eth = useBalance({
+    address,
+    query: { enabled: Boolean(address), refetchInterval: 15_000 },
+  });
+
+  const lowOnGas =
+    eth.data !== undefined && eth.data.value === 0n && address !== undefined;
+
+  return (
+    <div className="card">
+      <h2 className="card-title">Your balances</h2>
+      <p className="card-subtitle">On Ethereum mainnet</p>
+
+      <div className="balances">
+        <div className="balance-tile">
+          <div className="balance-label">
+            <TokenDot color="#2775ca" />
+            {USDC_SYMBOL}
+          </div>
+          <div className="balance-value">
+            {usdc.isLoading || usdc.value === undefined ? (
+              <span className="skeleton" aria-hidden />
+            ) : usdc.isError ? (
+              <span className="muted">—</span>
+            ) : (
+              formatTokenAmount(usdc.value, usdc.decimals, 2)
+            )}
+          </div>
+        </div>
+
+        <div className="balance-tile">
+          <div className="balance-label">
+            <TokenDot color="#627eea" />
+            ETH
+            <span className="field-hint">· for gas</span>
+          </div>
+          <div className="balance-value">
+            {eth.isLoading || eth.data === undefined ? (
+              <span className="skeleton" aria-hidden />
+            ) : eth.isError ? (
+              <span className="muted">—</span>
+            ) : (
+              formatTokenAmount(eth.data.value, eth.data.decimals, 4)
+            )}
+          </div>
+        </div>
+      </div>
+
+      {lowOnGas && (
+        <div className="alert alert-warn" style={{ marginTop: 16, marginBottom: 0 }}>
+          <span>⚠️</span>
+          <div>
+            <div className="alert-title">No ETH for gas</div>
+            You have 0 ETH. You need a small amount of ETH to pay the network
+            fee before you can send USDC.
+          </div>
+        </div>
+      )}
+    </div>
+  );
+}
+
+function TokenDot({ color }: { color: string }) {
+  return (
+    <span
+      aria-hidden
+      style={{
+        width: 10,
+        height: 10,
+        borderRadius: "50%",
+        background: color,
+        display: "inline-block",
+      }}
+    />
+  );
+}
