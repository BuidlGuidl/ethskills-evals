+              Connect your wallet to see your balances and send USDC to any
+              address.
+            </p>
+            <ConnectButton showBalance={false} />
+          </div>
+        </div>
+      )}
+
+      <p className="footnote">
+        Payments use the real USDC token on Ethereum mainnet
+        <br />
+        <code>{USDC_ADDRESS}</code>
+      </p>
+    </main>
+  );
+}
diff --git a/src/app/providers.tsx b/src/app/providers.tsx
