+"use client";
+
+import { useAccount, useSwitchChain } from "wagmi";
+import { USDC_CHAIN } from "@/lib/usdc";
+
+/**
+ * When connected to the wrong network, USDC here would not be the real token,
+ * so we block the flow and offer a one-click switch to mainnet.
+ */
+export function NetworkGuard() {
+  const { chainId, isConnected } = useAccount();
+  const { switchChain, isPending } = useSwitchChain();
+
+  if (!isConnected || chainId === undefined || chainId === USDC_CHAIN.id) {
+    return null;
+  }
+
+  return (
+    <div className="card">
+      <div className="alert alert-warn" style={{ marginBottom: 0 }}>
+        <span>⚠️</span>
+        <div style={{ width: "100%" }}>
+          <div className="alert-title">Wrong network</div>
+          <p style={{ margin: "2px 0 12px" }}>
+            You&apos;re connected to a different network. This app sends the real
+            USDC token on {USDC_CHAIN.name}.
+          </p>
+          <button
+            className="btn btn-primary"
+            onClick={() => switchChain({ chainId: USDC_CHAIN.id })}
+            disabled={isPending}
+          >
+            {isPending ? "Switching…" : `Switch to ${USDC_CHAIN.name}`}
+          </button>
+        </div>
+      </div>
+    </div>
+  );
+}
diff --git a/src/components/PayForm.tsx b/src/components/PayForm.tsx
new file mode 100644
index 0000000..dd1dab1
--- /dev/null
+++ b/src/components/PayForm.tsx
@@ -0,0 +1,282 @@
+"use client";
+
+import { FormEvent, useMemo, useState } from "react";
+import {
+  useAccount,
+  useWaitForTransactionReceipt,
+  useWriteContract,
+} from "wagmi";
+import {
+  formatUnits,
+  getAddress,
+  isAddress,
+  parseUnits,
+  type Address,
+} from "viem";
+import {
+  USDC_ADDRESS,
+  USDC_CHAIN,
+  USDC_SYMBOL,
+  usdcAbi,
+} from "@/lib/usdc";
+import {
+  formatTokenAmount,
+  shortenAddress,
+  validateAmountInput,
+} from "@/lib/format";
+import { useUsdcBalance } from "@/hooks/useUsdcBalance";
+
+const ZERO_ADDRESS = "0x0000000000000000000000000000000000000000";
+
+export function PayForm() {
+  const { address, chainId } = useAccount();
+  const usdc = useUsdcBalance(address);
+
+  const [recipient, setRecipient] = useState("");
+  const [amount, setAmount] = useState("");
+  const [submitted, setSubmitted] = useState(false);
+
+  const {
+    data: hash,
+    writeContract,
+    isPending: isSigning,
+    error: writeError,
+    reset: resetWrite,
+  } = useWriteContract();
+
+  const {
+    isLoading: isConfirming,
+    isSuccess: isConfirmed,
+    error: receiptError,
+  } = useWaitForTransactionReceipt({ hash });
+
+  // ---- Validation -------------------------------------------------------
+
+  const recipientError = useMemo(() => {
+    const value = recipient.trim();
+    if (value === "") return null; // don't nag before they type
+    if (!isAddress(value)) return "Not a valid Ethereum address.";
+    if (getAddress(value) === ZERO_ADDRESS)
+      return "Cannot send to the zero address.";
+    return null;
+  }, [recipient]);
+
+  const parsedAmount = useMemo(() => {
+    const check = validateAmountInput(amount, usdc.decimals);
+    if (!check.ok) return null;
+    try {
+      return parseUnits(amount.trim(), usdc.decimals);
+    } catch {
+      return null;
+    }
+  }, [amount, usdc.decimals]);
+
+  const amountError = useMemo(() => {
+    if (amount.trim() === "") return null;
+    const check = validateAmountInput(amount, usdc.decimals);
+    if (!check.ok) return check.reason;
+    if (parsedAmount !== null && usdc.value !== undefined) {
+      if (parsedAmount > usdc.value) return "Amount exceeds your USDC balance.";
+    }
+    return null;
+  }, [amount, usdc.decimals, parsedAmount, usdc.value]);
+
+  const onWrongNetwork = chainId !== undefined && chainId !== USDC_CHAIN.id;
+
+  const canSubmit =
+    Boolean(address) &&
+    !onWrongNetwork &&
+    recipient.trim() !== "" &&
+    recipientError === null &&
+    amount.trim() !== "" &&
+    amountError === null &&
+    parsedAmount !== null &&
+    parsedAmount > 0n &&
+    !isSigning &&
+    !isConfirming;
+
+  // ---- Actions ----------------------------------------------------------
+
+  function handleMax() {
+    if (usdc.value === undefined) return;
+    // formatUnits gives the exact full-precision string; safe to reparse.
+    setAmount(formatUnits(usdc.value, usdc.decimals));
+  }
+
+  function handleSubmit(e: FormEvent) {
+    e.preventDefault();
+    setSubmitted(true);
+    if (!canSubmit || parsedAmount === null) return;
+
+    writeContract({
+      address: USDC_ADDRESS,
+      abi: usdcAbi,
+      functionName: "transfer",
+      args: [getAddress(recipient.trim()) as Address, parsedAmount],
+    });
+  }
+
+  function handleReset() {
+    setRecipient("");
+    setAmount("");
+    setSubmitted(false);
+    resetWrite();
+  }
+
+  // ---- Derived UI state -------------------------------------------------
+
+  const submitError = writeError ?? receiptError;
+  const explorerBase = USDC_CHAIN.blockExplorers?.default.url;
+  const showRecipientError = (submitted || recipient.trim() !== "") && recipientError;
+  const showAmountError = (submitted || amount.trim() !== "") && amountError;
+
+  if (isConfirmed && hash) {
+    return (
+      <div className="card">
+        <div className="alert alert-success" style={{ marginBottom: 20 }}>
+          <span>✅</span>
+          <div>
+            <div className="alert-title">Payment sent</div>
+            You sent {formatTokenAmount(parsedAmount ?? 0n, usdc.decimals, 6)}{" "}
+            {USDC_SYMBOL} to {shortenAddress(getAddress(recipient.trim()))}.
+          </div>
+        </div>
+        {explorerBase && (
+          <p className="muted center" style={{ marginTop: 0 }}>
+            <a
+              href={`${explorerBase}/tx/${hash}`}
+              target="_blank"
+              rel="noreferrer"
+            >
+              View transaction on Etherscan ↗
+            </a>
+          </p>
+        )}
+        <button className="btn btn-primary" onClick={handleReset}>
+          Send another payment
+        </button>
+      </div>
+    );
+  }
+
+  return (
+    <div className="card">
+      <h2 className="card-title">Send USDC</h2>
+      <p className="card-subtitle">Transfer USDC to any Ethereum address.</p>
+
+      <form onSubmit={handleSubmit} noValidate>
+        <div className="field">
+          <div className="field-label">
+            <label htmlFor="recipient">Recipient address</label>
+          </div>
+          <div className="input-wrap">
+            <input
+              id="recipient"
+              className={`input ${showRecipientError ? "has-error" : ""}`}
+              placeholder="0x…"
+              autoComplete="off"
+              spellCheck={false}
+              value={recipient}
+              onChange={(e) => setRecipient(e.target.value)}
+            />
+          </div>
+          {showRecipientError && (
+            <div className="error-text">{recipientError}</div>
+          )}
+        </div>
+
+        <div className="field">
+          <div className="field-label">
+            <label htmlFor="amount">Amount</label>
+            {usdc.value !== undefined && (
+              <span className="field-hint">
+                Balance: {formatTokenAmount(usdc.value, usdc.decimals, 2)}{" "}
+                {USDC_SYMBOL}
+              </span>
+            )}
+          </div>
+          <div className="input-wrap">
+            <input
+              id="amount"
+              className={`input input-amount ${showAmountError ? "has-error" : ""}`}
+              placeholder="0.00"
+              inputMode="decimal"
+              autoComplete="off"
+              value={amount}
+              onChange={(e) => setAmount(e.target.value)}
+            />
+            {usdc.value !== undefined && usdc.value > 0n && (
+              <button type="button" className="max-btn" onClick={handleMax}>
+                MAX
+              </button>
+            )}
+            <span className="input-suffix">{USDC_SYMBOL}</span>
+          </div>
+          {showAmountError && <div className="error-text">{amountError}</div>}
+        </div>
+
+        {onWrongNetwork && (
+          <div className="alert alert-warn">
+            <span>⚠️</span>
+            <div>Switch your wallet to Ethereum mainnet to send USDC.</div>
+          </div>
+        )}
+
+        {submitError && (
+          <div className="alert alert-danger">
+            <span>⚠️</span>
+            <div>
+              <div className="alert-title">Transaction failed</div>
+              {friendlyError(submitError)}
+            </div>
+          </div>
+        )}
+
+        {(isSigning || isConfirming) && hash && explorerBase && (
+          <div className="alert alert-success">
+            <span className="spinner" style={{ borderTopColor: "#1a7f4b" }} />
+            <div>
+              Waiting for confirmation…{" "}
+              <a href={`${explorerBase}/tx/${hash}`} target="_blank" rel="noreferrer">
+                view on Etherscan ↗
+              </a>
+            </div>
+          </div>
+        )}
+
+        <button type="submit" className="btn btn-primary" disabled={!canSubmit}>
+          {isSigning ? (
+            <>
+              <span className="spinner" />
+              Confirm in your wallet…
+            </>
+          ) : isConfirming ? (
+            <>
+              <span className="spinner" />
+              Sending…
+            </>
+          ) : (
+            "Send payment"
+          )}
+        </button>
+      </form>
+    </div>
+  );
+}
+
+/** Turn common wallet/RPC errors into something a normal user can read. */
+function friendlyError(error: Error): string {
+  const msg = `${error.message ?? ""}`.toLowerCase();
+  if (msg.includes("user rejected") || msg.includes("user denied")) {
+    return "You rejected the request in your wallet.";
+  }
+  if (msg.includes("insufficient funds")) {
+    return "Not enough ETH to cover the gas fee.";
+  }
+  if (msg.includes("transfer amount exceeds balance")) {
+    return "The transfer amount exceeds your USDC balance.";
+  }
+  // Prefer viem's short message when present.
+  const short = (error as { shortMessage?: string }).shortMessage;
+  return short ?? "Something went wrong. Please try again.";
+}
