@@ -0,0 +1,235 @@
+"use client";
+
+import { FormEvent, useMemo, useState } from "react";
+import { Address as AddressComponent } from "@scaffold-ui/components";
+import type { NextPage } from "next";
+import type { Address } from "viem";
+import { useAccount } from "wagmi";
+import { ChatBubbleLeftRightIcon, PaperAirplaneIcon } from "@heroicons/react/24/outline";
+import {
+  useDeployedContractInfo,
+  useScaffoldEventHistory,
+  useScaffoldReadContract,
+  useScaffoldWriteContract,
+  useTargetNetwork,
+} from "~~/hooks/scaffold-eth";
+import { getParsedError, notification } from "~~/utils/scaffold-eth";
+
+const contractName = "YourContract";
+
+type GreetingChangeArgs = {
+  greetingSetter?: Address;
+  newGreeting?: string;
+};
+
+const formatCounter = (value: unknown) => {
+  if (typeof value === "bigint") {
+    return value.toString();
+  }
+
+  if (typeof value === "number") {
+    return value.toLocaleString();
+  }
+
+  return "0";
+};
+
+const formatTimestamp = (timestamp?: bigint) => {
+  if (!timestamp) {
+    return null;
+  }
+
+  return new Date(Number(timestamp) * 1000).toLocaleString();
+};
+
+const Greetings: NextPage = () => {
+  const { isConnected } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+  const [newGreeting, setNewGreeting] = useState("");
+
+  const { data: deployedContract, isLoading: isContractLoading } = useDeployedContractInfo({ contractName });
+  const isContractReady = Boolean(deployedContract);
+
+  const { data: greeting, isLoading: isGreetingLoading } = useScaffoldReadContract({
+    contractName,
+    functionName: "greeting",
+    query: {
+      enabled: isContractReady,
+    },
+  });
+
+  const { data: totalCounter, isLoading: isCounterLoading } = useScaffoldReadContract({
+    contractName,
+    functionName: "totalCounter",
+    query: {
+      enabled: isContractReady,
+    },
+  });
+
+  const { data: greetingEvents, isLoading: isEventsLoading } = useScaffoldEventHistory({
+    contractName,
+    eventName: "GreetingChange",
+    watch: true,
+    blockData: true,
+    enabled: isContractReady,
+  });
+
+  const { writeContractAsync, isMining } = useScaffoldWriteContract({ contractName });
+
+  const changes = useMemo(() => greetingEvents ?? [], [greetingEvents]);
+  const trimmedGreeting = newGreeting.trim();
+  const isSubmitDisabled = !isConnected || !isContractReady || isMining || trimmedGreeting.length === 0;
+
+  const handleSubmit = async (event: FormEvent<HTMLFormElement>) => {
+    event.preventDefault();
+
+    if (!trimmedGreeting) {
+      notification.warning("Enter a greeting first");
+      return;
+    }
+
+    try {
+      await writeContractAsync(
+        {
+          functionName: "setGreeting",
+          args: [trimmedGreeting],
+        },
+        {
+          onBlockConfirmation: () => {
+            notification.success("Greeting updated");
+            setNewGreeting("");
+          },
+        },
+      );
+    } catch (error) {
+      notification.error(getParsedError(error));
+    }
+  };
+
+  return (
+    <main className="grow bg-base-200">
+      <div className="mx-auto flex w-full max-w-5xl flex-col gap-8 px-6 py-8 lg:py-12">
+        <section className="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
+          <div>
+            <div className="flex items-center gap-2 text-sm font-medium text-primary">
+              <ChatBubbleLeftRightIcon className="h-5 w-5" />
+              <span>Greetings</span>
+            </div>
+            <h1 className="mt-2 text-4xl font-bold">Shared Greeting Board</h1>
+            <p className="mt-3 max-w-2xl text-base-content/70">
+              Read the latest message from YourContract and add the next onchain greeting.
+            </p>
+          </div>
+          <div className="stats stats-vertical border border-base-300 bg-base-100 shadow-sm sm:stats-horizontal">
+            <div className="stat">
+              <div className="stat-title">Total changes</div>
+              <div className="stat-value text-3xl">
+                {isCounterLoading || isContractLoading ? (
+                  <span className="loading loading-spinner loading-md" />
+                ) : (
+                  formatCounter(totalCounter)
+                )}
+              </div>
+            </div>
+          </div>
+        </section>
+
+        {!isContractLoading && !isContractReady && (
+          <div className="alert alert-warning border border-warning/40">
+            <span>
+              YourContract is not deployed on {targetNetwork.name}. Run the existing deploy flow to populate it.
+            </span>
+          </div>
+        )}
+
+        <section className="grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
+          <div className="rounded-box border border-base-300 bg-base-100 p-6 shadow-sm">
+            <div className="text-sm font-medium text-base-content/60">Current greeting</div>
+            <div className="mt-3 min-h-20 rounded-box bg-base-200 p-5 text-2xl font-semibold leading-snug">
+              {isGreetingLoading || isContractLoading ? (
+                <span className="loading loading-spinner loading-md" />
+              ) : (
+                <span className="break-words">{greeting || "No greeting found"}</span>
+              )}
+            </div>
+          </div>
+
+          <form className="rounded-box border border-base-300 bg-base-100 p-6 shadow-sm" onSubmit={handleSubmit}>
+            <label className="form-control w-full">
+              <span className="label pb-2">
+                <span className="label-text font-medium">New greeting</span>
+              </span>
+              <textarea
+                className="textarea textarea-bordered min-h-28 resize-none text-base"
+                maxLength={280}
+                onChange={event => setNewGreeting(event.target.value)}
+                placeholder="gm, builders"
+                value={newGreeting}
+              />
+            </label>
+            <div className="mt-4 flex items-center justify-between gap-3">
+              <span className="text-sm text-base-content/60">{newGreeting.length}/280</span>
+              <button className="btn btn-primary" disabled={isSubmitDisabled} type="submit">
+                {isMining ? (
+                  <span className="loading loading-spinner loading-sm" />
+                ) : (
+                  <PaperAirplaneIcon className="h-4 w-4" />
+                )}
+                Submit
+              </button>
+            </div>
+            {!isConnected && (
+              <p className="mt-3 text-sm text-base-content/60">Connect your wallet to submit a greeting.</p>
+            )}
+          </form>
+        </section>
+
+        <section className="rounded-box border border-base-300 bg-base-100 shadow-sm">
+          <div className="border-b border-base-300 px-6 py-4">
+            <h2 className="text-xl font-semibold">Past changes</h2>
+          </div>
+
+          {isEventsLoading || isContractLoading ? (
+            <div className="flex min-h-32 items-center justify-center">
+              <span className="loading loading-spinner loading-lg" />
+            </div>
+          ) : changes.length > 0 ? (
+            <div className="divide-y divide-base-300">
+              {changes.map(event => {
+                const args = event.args as GreetingChangeArgs | undefined;
+                const timestamp = formatTimestamp(event.blockData?.timestamp);
+                const key = `${event.transactionHash}-${event.logIndex?.toString()}`;
+
+                return (
+                  <article
+                    className="flex flex-col gap-3 px-6 py-5 md:flex-row md:items-center md:justify-between"
+                    key={key}
+                  >
+                    <div className="min-w-0">
+                      <div className="flex flex-wrap items-center gap-2 text-sm text-base-content/70">
+                        {args?.greetingSetter ? (
+                          <AddressComponent address={args.greetingSetter} chain={targetNetwork} />
+                        ) : (
+                          <span>Unknown sender</span>
+                        )}
+                        {timestamp && <span>{timestamp}</span>}
+                      </div>
+                      <p className="mt-2 break-words text-lg font-medium">{args?.newGreeting || "Empty greeting"}</p>
+                    </div>
+                    {event.blockNumber && (
+                      <div className="badge badge-neutral shrink-0">Block {event.blockNumber.toString()}</div>
+                    )}
+                  </article>
+                );
+              })}
+            </div>
+          ) : (
+            <div className="px-6 py-12 text-center text-base-content/60">No greeting changes yet.</div>
+          )}
+        </section>
+      </div>
+    </main>
+  );
+};
+
+export default Greetings;
