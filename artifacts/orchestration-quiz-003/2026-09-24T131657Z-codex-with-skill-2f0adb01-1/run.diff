+"use client";
+
+import { FormEvent, useMemo, useState } from "react";
+import { Address } from "@scaffold-ui/components";
+import type { NextPage } from "next";
+import { useAccount } from "wagmi";
+import { PaperAirplaneIcon } from "@heroicons/react/24/outline";
+import { useScaffoldEventHistory, useScaffoldReadContract, useScaffoldWriteContract } from "~~/hooks/scaffold-eth";
+import { getParsedError, notification } from "~~/utils/scaffold-eth";
+
+type GreetingChangeArgs = {
+  greetingSetter?: `0x${string}`;
+  newGreeting?: string;
+};
+
+const Greetings: NextPage = () => {
+  const { isConnected } = useAccount();
+  const [nextGreeting, setNextGreeting] = useState("");
+
+  const {
+    data: currentGreeting,
+    isLoading: isGreetingLoading,
+    refetch: refetchGreeting,
+  } = useScaffoldReadContract({
+    contractName: "YourContract",
+    functionName: "greeting",
+  });
+
+  const {
+    data: totalCounter,
+    isLoading: isTotalCounterLoading,
+    refetch: refetchTotalCounter,
+  } = useScaffoldReadContract({
+    contractName: "YourContract",
+    functionName: "totalCounter",
+  });
+
+  const {
+    data: greetingEvents,
+    isLoading: areEventsLoading,
+    refetch: refetchGreetingEvents,
+  } = useScaffoldEventHistory({
+    contractName: "YourContract",
+    eventName: "GreetingChange",
+    watch: true,
+  });
+
+  const { writeContractAsync, isMining } = useScaffoldWriteContract({
+    contractName: "YourContract",
+  });
+
+  const greetingChanges = useMemo(
+    () =>
+      (greetingEvents ?? []).map(event => {
+        const args = event.args as GreetingChangeArgs;
+
+        return {
+          id: `${event.transactionHash}-${event.logIndex}`,
+          greetingSetter: args.greetingSetter,
+          newGreeting: args.newGreeting,
+        };
+      }),
+    [greetingEvents],
+  );
+
+  const handleSubmit = async (event: FormEvent) => {
+    event.preventDefault();
+
+    const trimmedGreeting = nextGreeting.trim();
+
+    if (!trimmedGreeting) {
+      notification.warning("Enter a greeting before submitting.");
+      return;
+    }
+
+    try {
+      await writeContractAsync(
+        {
+          functionName: "setGreeting",
+          args: [trimmedGreeting],
+        },
+        {
+          onBlockConfirmation: () => {
+            setNextGreeting("");
+            void refetchGreeting();
+            void refetchTotalCounter();
+            void refetchGreetingEvents();
+          },
+        },
+      );
+    } catch (error) {
+      notification.error(getParsedError(error));
+    }
+  };
+
+  return (
+    <main className="grow bg-base-200 px-4 py-8 sm:px-6 lg:px-8">
+      <div className="mx-auto flex w-full max-w-5xl flex-col gap-6">
+        <section className="grid gap-4 md:grid-cols-[1fr_220px]">
+          <div className="bg-base-100 border border-base-300 p-6">
+            <p className="m-0 text-sm font-semibold uppercase text-base-content/60">Current greeting</p>
+            {isGreetingLoading ? (
+              <div className="skeleton mt-4 h-10 w-full max-w-xl" />
+            ) : (
+              <h1 className="mt-4 break-words text-3xl font-bold leading-tight sm:text-4xl">
+                {currentGreeting || "No greeting found"}
+              </h1>
+            )}
+          </div>
+
+          <div className="bg-base-100 border border-base-300 p-6">
+            <p className="m-0 text-sm font-semibold uppercase text-base-content/60">Times changed</p>
+            {isTotalCounterLoading ? (
+              <div className="skeleton mt-5 h-12 w-24" />
+            ) : (
+              <p className="m-0 mt-4 text-5xl font-bold leading-none">{totalCounter?.toString() ?? "0"}</p>
+            )}
+          </div>
+        </section>
+
+        <section className="bg-base-100 border border-base-300 p-6">
+          <form className="flex flex-col gap-3 sm:flex-row" onSubmit={handleSubmit}>
+            <input
+              aria-label="New greeting"
+              className="input input-bordered min-h-12 flex-1"
+              disabled={!isConnected || isMining}
+              maxLength={160}
+              onChange={event => setNextGreeting(event.target.value)}
+              placeholder={isConnected ? "Write a new greeting" : "Connect wallet to write a greeting"}
+              value={nextGreeting}
+            />
+            <button className="btn btn-primary min-h-12 sm:w-40" disabled={!isConnected || isMining} type="submit">
+              {isMining ? (
+                <span className="loading loading-spinner loading-sm" />
+              ) : (
+                <PaperAirplaneIcon className="h-5 w-5" />
+              )}
+              <span>{isMining ? "Submitting" : "Submit"}</span>
+            </button>
+          </form>
+        </section>
+
+        <section className="bg-base-100 border border-base-300">
+          <div className="border-b border-base-300 px-6 py-4">
+            <h2 className="m-0 text-xl font-bold">Greeting changes</h2>
+          </div>
+
+          {areEventsLoading ? (
+            <div className="flex flex-col gap-3 p-6">
+              <div className="skeleton h-16 w-full" />
+              <div className="skeleton h-16 w-full" />
+              <div className="skeleton h-16 w-full" />
+            </div>
+          ) : greetingChanges.length > 0 ? (
+            <ul className="m-0 list-none divide-y divide-base-300 p-0">
+              {greetingChanges.map(({ id, greetingSetter, newGreeting }) => (
+                <li className="grid gap-3 px-6 py-4 md:grid-cols-[260px_1fr] md:items-center" key={id}>
+                  <div className="min-w-0">
+                    {greetingSetter ? (
+                      <Address address={greetingSetter} />
+                    ) : (
+                      <span className="text-sm text-base-content/60">Unknown setter</span>
+                    )}
+                  </div>
+                  <p className="m-0 break-words text-base font-medium">{newGreeting || "Empty greeting"}</p>
+                </li>
+              ))}
+            </ul>
+          ) : (
+            <p className="m-0 px-6 py-10 text-center text-base-content/60">
+              No greeting changes have been recorded yet.
+            </p>
+          )}
+        </section>
+      </div>
+    </main>
+  );
+};
+
+export default Greetings;
