+"use client";
+
+import { useState } from "react";
+import { Address } from "@scaffold-ui/components";
+import type { NextPage } from "next";
+import { useAccount } from "wagmi";
+import { useScaffoldEventHistory, useScaffoldReadContract, useScaffoldWriteContract } from "~~/hooks/scaffold-eth";
+import { useTargetNetwork } from "~~/hooks/scaffold-eth";
+import { notification } from "~~/utils/scaffold-eth";
+
+const Greetings: NextPage = () => {
+  const [newGreeting, setNewGreeting] = useState("");
+  const { isConnected } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+
+  const { data: greeting, isLoading: isGreetingLoading } = useScaffoldReadContract({
+    contractName: "YourContract",
+    functionName: "greeting",
+  });
+
+  const { data: totalCounter } = useScaffoldReadContract({
+    contractName: "YourContract",
+    functionName: "totalCounter",
+  });
+
+  const { writeContractAsync, isMining } = useScaffoldWriteContract({ contractName: "YourContract" });
+
+  const { data: greetingChanges, isLoading: areChangesLoading } = useScaffoldEventHistory({
+    contractName: "YourContract",
+    eventName: "GreetingChange",
+    fromBlock: 0n,
+    watch: true,
+  });
+
+  const handleSubmit = async () => {
+    if (!newGreeting.trim()) {
+      notification.warning("Please enter a greeting first");
+      return;
+    }
+
+    try {
+      await writeContractAsync({
+        functionName: "setGreeting",
+        args: [newGreeting],
+      });
+      setNewGreeting("");
+    } catch (e) {
+      // useScaffoldWriteContract already surfaces the parsed error as a notification
+      console.error("Failed to set greeting", e);
+    }
+  };
+
+  // Event history comes back oldest-first; the feed shows the newest change at the top.
+  const feed = [...(greetingChanges ?? [])].reverse();
+
+  return (
+    <div className="flex flex-col items-center grow w-full px-4 py-10">
+      <div className="w-full max-w-2xl flex flex-col gap-6">
+        <div className="card bg-base-100 shadow-xl">
+          <div className="card-body items-center text-center">
+            <h2 className="card-title">Current Greeting</h2>
+            {isGreetingLoading ? (
+              <span className="loading loading-spinner loading-md" />
+            ) : (
+              <p className="text-2xl font-bold break-words max-w-full">{greeting}</p>
+            )}
+            <div className="stats bg-base-200 mt-2">
+              <div className="stat">
+                <div className="stat-title">Times changed</div>
+                <div className="stat-value text-primary">{totalCounter?.toString() ?? "0"}</div>
+              </div>
+            </div>
+          </div>
+        </div>
+
+        <div className="card bg-base-100 shadow-xl">
+          <div className="card-body">
+            <h2 className="card-title">Set a New Greeting</h2>
+            <input
+              type="text"
+              className="input input-bordered w-full"
+              placeholder="Building Unstoppable Apps!!!"
+              value={newGreeting}
+              onChange={e => setNewGreeting(e.target.value)}
+              disabled={!isConnected || isMining}
+            />
+            <div className="card-actions justify-end mt-2">
+              <button
+                className="btn btn-primary"
+                onClick={handleSubmit}
+                disabled={!isConnected || isMining || !newGreeting.trim()}
+              >
+                {isMining && <span className="loading loading-spinner loading-xs" />}
+                Set Greeting
+              </button>
+            </div>
+            {!isConnected && <p className="text-sm opacity-70">Connect your wallet to set a greeting.</p>}
+          </div>
+        </div>
+
+        <div className="card bg-base-100 shadow-xl">
+          <div className="card-body">
+            <h2 className="card-title">Greeting History</h2>
+            {areChangesLoading ? (
+              <div className="flex justify-center py-6">
+                <span className="loading loading-spinner loading-md" />
+              </div>
+            ) : feed.length === 0 ? (
+              <p className="opacity-70">No greetings have been set yet.</p>
+            ) : (
+              <div className="overflow-x-auto">
+                <table className="table">
+                  <thead>
+                    <tr>
+                      <th>Setter</th>
+                      <th>Greeting</th>
+                    </tr>
+                  </thead>
+                  <tbody>
+                    {feed.map(event => (
+                      <tr key={`${event.transactionHash}-${event.logIndex}`}>
+                        <td>
+                          <Address address={event.args.greetingSetter} chain={targetNetwork} size="sm" />
+                        </td>
+                        <td className="break-words">{event.args.newGreeting}</td>
+                      </tr>
+                    ))}
+                  </tbody>
+                </table>
+              </div>
+            )}
+          </div>
+        </div>
+      </div>
+    </div>
+  );
+};
+
+export default Greetings;
