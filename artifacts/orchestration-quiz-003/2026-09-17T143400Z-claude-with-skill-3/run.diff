@@ -0,0 +1,54 @@
+"use client";
+
+import { useState } from "react";
+import { useAccount } from "wagmi";
+import { RainbowKitCustomConnectButton } from "~~/components/scaffold-eth";
+import { useScaffoldWriteContract } from "~~/hooks/scaffold-eth";
+
+export const GreetingForm = () => {
+  const { isConnected } = useAccount();
+  const [newGreeting, setNewGreeting] = useState("");
+  const { writeContractAsync, isPending } = useScaffoldWriteContract({ contractName: "YourContract" });
+
+  const trimmedGreeting = newGreeting.trim();
+
+  const handleSubmit = async (e: React.FormEvent<HTMLFormElement>) => {
+    e.preventDefault();
+    if (!trimmedGreeting) return;
+    try {
+      // useScaffoldWriteContract already shows success/error notifications
+      await writeContractAsync({ functionName: "setGreeting", args: [trimmedGreeting] });
+      setNewGreeting("");
+    } catch (error) {
+      console.error("Error setting greeting", error);
+    }
+  };
+
+  return (
+    <div className="card bg-base-100 shadow">
+      <div className="card-body">
+        <h2 className="card-title">Set a new greeting</h2>
+        {isConnected ? (
+          <form onSubmit={handleSubmit} className="flex flex-col sm:flex-row gap-2">
+            <input
+              type="text"
+              className="input input-bordered grow"
+              placeholder="Say hello..."
+              value={newGreeting}
+              onChange={e => setNewGreeting(e.target.value)}
+              disabled={isPending}
+            />
+            <button type="submit" className="btn btn-primary" disabled={isPending || !trimmedGreeting}>
+              {isPending ? <span className="loading loading-spinner loading-sm" /> : "Set greeting"}
+            </button>
+          </form>
+        ) : (
+          <div className="flex flex-col items-start gap-2">
+            <p className="m-0">Connect your wallet to set a greeting.</p>
+            <RainbowKitCustomConnectButton />
+          </div>
+        )}
+      </div>
+    </div>
+  );
+};
