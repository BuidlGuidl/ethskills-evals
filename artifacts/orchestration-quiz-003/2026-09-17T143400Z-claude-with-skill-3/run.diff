+import { GreetingFeed } from "./_components/GreetingFeed";
+import { GreetingForm } from "./_components/GreetingForm";
+import { GreetingStatus } from "./_components/GreetingStatus";
+import type { NextPage } from "next";
+import { getMetadata } from "~~/utils/scaffold-eth/getMetadata";
+
+export const metadata = getMetadata({
+  title: "Greetings",
+  description: "Read, set and browse the history of YourContract greetings",
+});
+
+const Greetings: NextPage = () => {
+  return (
+    <div className="flex flex-col items-center grow gap-6 px-5 py-10">
+      <h1 className="text-4xl font-bold">Greetings</h1>
+      <div className="flex flex-col gap-6 w-full max-w-2xl">
+        <GreetingStatus />
+        <GreetingForm />
+        <GreetingFeed />
+      </div>
+    </div>
+  );
+};
+
+export default Greetings;
