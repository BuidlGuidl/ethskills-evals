+"use client";
+
+import { FormEvent, useMemo, useState } from "react";
+import { Address } from "@scaffold-ui/components";
+import type { NextPage } from "next";
+import { useAccount } from "wagmi";
+import { ArrowPathIcon, ChatBubbleBottomCenterTextIcon, PaperAirplaneIcon } from "@heroicons/react/24/outline";
+import {
+  useScaffoldEventHistory,
+  useScaffoldReadContract,
+  useScaffoldWriteContract,
+  useTargetNetwork,
+} from "~~/hooks/scaffold-eth";
+
+type GreetingChangeEvent = {
+  transactionHash: string;
+  logIndex: number;
+  blockNumber?: bigint;
+  args: {
+    greetingSetter: `0x${string}`;
+    newGreeting: string;
+  };
+};
+
+const GreetingsPage: NextPage = () => {
+  const [newGreeting, setNewGreeting] = useState("");
+  const { address: connectedAddress, isConnected } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+
+  const { data: greeting, isLoading: isGreetingLoading } = useScaffoldReadContract({
+    contractName: "YourContract",
+    functionName: "greeting",
+  });
+
+  const { data: totalCounter, isLoading: isTotalCounterLoading } = useScaffoldReadContract({
+    contractName: "YourContract",
+    functionName: "totalCounter",
+  });
+
+  const {
+    data: greetingEvents,
+    isLoading: isEventsLoading,
+    isFetchingNewEvent,
+  } = useScaffoldEventHistory({
+    contractName: "YourContract",
+    eventName: "GreetingChange",
+    watch: true,
+  });
+
+  const { writeContractAsync, isMining } = useScaffoldWriteContract({
+    contractName: "YourContract",
+  });
+
+  const trimmedGreeting = newGreeting.trim();
+  const greetingChanges = useMemo(() => (greetingEvents ?? []) as GreetingChangeEvent[], [greetingEvents]);
+  const isSubmitDisabled = !isConnected || trimmedGreeting.length === 0 || isMining;
+
+  const handleSubmit = async (event: FormEvent<HTMLFormElement>) => {
+    event.preventDefault();
+
+    if (isSubmitDisabled) {
+      return;
+    }
+
+    try {
+      const tx = await writeContractAsync({
+        functionName: "setGreeting",
+        args: [trimmedGreeting],
+      });
+
+      if (tx) {
+        setNewGreeting("");
+      }
+    } catch {
+      // The scaffold transaction hook already surfaces the readable error notification.
+    }
+  };
+
+  return (
+    <main className="grow bg-base-200">
+      <div className="mx-auto flex w-full max-w-5xl flex-col gap-8 px-4 py-8 sm:px-6 lg:px-8">
+        <section className="flex flex-col gap-6 rounded-box border border-base-300 bg-base-100 p-6 shadow-sm">
+          <div className="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
+            <div>
+              <div className="flex items-center gap-2 text-sm font-semibold uppercase text-primary">
+                <ChatBubbleBottomCenterTextIcon className="h-5 w-5" />
+                Greetings
+              </div>
+              <h1 className="mt-2 text-3xl font-bold">YourContract greeting board</h1>
+            </div>
+            {connectedAddress && (
+              <div className="rounded-box border border-base-300 bg-base-200 px-4 py-3">
+                <p className="mb-1 text-xs font-semibold uppercase text-base-content/60">Connected</p>
+                <Address address={connectedAddress} chain={targetNetwork} />
+              </div>
+            )}
+          </div>
+
+          <div className="grid gap-4 md:grid-cols-[minmax(0,1fr)_220px]">
+            <div className="rounded-box border border-base-300 bg-base-200 p-5">
+              <p className="text-sm font-semibold text-base-content/60">Current greeting</p>
+              <p className="mt-3 break-words text-2xl font-bold">
+                {isGreetingLoading ? (
+                  <span className="loading loading-dots loading-md" />
+                ) : (
+                  greeting || "No greeting yet"
+                )}
+              </p>
+            </div>
+            <div className="rounded-box border border-base-300 bg-base-200 p-5">
+              <p className="text-sm font-semibold text-base-content/60">Total changes</p>
+              <p className="mt-3 text-4xl font-bold">
+                {isTotalCounterLoading ? (
+                  <span className="loading loading-dots loading-md" />
+                ) : (
+                  (totalCounter ?? 0n).toString()
+                )}
+              </p>
+            </div>
+          </div>
+        </section>
+
+        <section className="rounded-box border border-base-300 bg-base-100 p-6 shadow-sm">
+          <form className="flex flex-col gap-3 sm:flex-row" onSubmit={handleSubmit}>
+            <label className="form-control grow">
+              <span className="label">
+                <span className="label-text font-semibold">New greeting</span>
+              </span>
+              <input
+                className="input input-bordered w-full"
+                disabled={isMining}
+                maxLength={140}
+                onChange={event => setNewGreeting(event.target.value)}
+                placeholder="Say something worth putting onchain"
+                value={newGreeting}
+              />
+            </label>
+            <div className="flex items-end">
+              <button className="btn btn-primary w-full sm:w-auto" disabled={isSubmitDisabled} type="submit">
+                {isMining ? (
+                  <span className="loading loading-spinner loading-sm" />
+                ) : (
+                  <PaperAirplaneIcon className="h-4 w-4" />
+                )}
+                <span>{isMining ? "Submitting" : "Submit"}</span>
+              </button>
+            </div>
+          </form>
+          {!isConnected && <p className="mt-3 text-sm text-warning">Connect your wallet to submit a greeting.</p>}
+        </section>
+
+        <section className="rounded-box border border-base-300 bg-base-100 p-6 shadow-sm">
+          <div className="mb-4 flex items-center justify-between gap-3">
+            <h2 className="text-xl font-bold">Past changes</h2>
+            {isFetchingNewEvent && <ArrowPathIcon className="h-5 w-5 animate-spin text-base-content/60" />}
+          </div>
+
+          {isEventsLoading ? (
+            <div className="flex min-h-32 items-center justify-center">
+              <span className="loading loading-spinner loading-lg" />
+            </div>
+          ) : greetingChanges.length > 0 ? (
+            <div className="divide-y divide-base-300 overflow-hidden rounded-box border border-base-300">
+              {greetingChanges.map(event => (
+                <article className="bg-base-100 p-4" key={`${event.transactionHash}-${event.logIndex}`}>
+                  <div className="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
+                    <Address address={event.args.greetingSetter} chain={targetNetwork} />
+                    <span className="text-sm text-base-content/60">Block {event.blockNumber?.toString()}</span>
+                  </div>
+                  <p className="mt-3 break-words text-lg font-semibold">&ldquo;{event.args.newGreeting}&rdquo;</p>
+                </article>
+              ))}
+            </div>
+          ) : (
+            <div className="rounded-box border border-dashed border-base-300 bg-base-200 p-8 text-center">
+              <p className="font-semibold">No greeting changes yet.</p>
+              <p className="mt-1 text-sm text-base-content/60">Submitted greetings will appear here newest first.</p>
+            </div>
+          )}
+        </section>
+      </div>
+    </main>
+  );
+};
+
+export default GreetingsPage;
