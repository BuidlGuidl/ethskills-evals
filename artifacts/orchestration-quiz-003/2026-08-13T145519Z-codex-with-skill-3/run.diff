+"use client";
+
+import { useState } from "react";
+import { Address } from "@scaffold-ui/components";
+import type { NextPage } from "next";
+import { useAccount } from "wagmi";
+import {
+  useScaffoldEventHistory,
+  useScaffoldReadContract,
+  useScaffoldWriteContract,
+  useTargetNetwork,
+} from "~~/hooks/scaffold-eth";
+import { getParsedError, notification } from "~~/utils/scaffold-eth";
+
+const GreetingsPage: NextPage = () => {
+  const [newGreeting, setNewGreeting] = useState("");
+  const { isConnected } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+  const { data: greeting, isLoading: isGreetingLoading } = useScaffoldReadContract({
+    contractName: "YourContract",
+    functionName: "greeting",
+  });
+  const { data: totalCounter, isLoading: isCounterLoading } = useScaffoldReadContract({
+    contractName: "YourContract",
+    functionName: "totalCounter",
+  });
+  const { data: greetingChanges, isLoading: isHistoryLoading } = useScaffoldEventHistory({
+    contractName: "YourContract",
+    eventName: "GreetingChange",
+    blockData: true,
+    watch: true,
+  });
+  const { writeContractAsync, isMining } = useScaffoldWriteContract({ contractName: "YourContract" });
+
+  const submitGreeting = async (event: React.FormEvent<HTMLFormElement>) => {
+    event.preventDefault();
+    const trimmedGreeting = newGreeting.trim();
+
+    if (!trimmedGreeting) {
+      notification.warning("Enter a greeting first.");
+      return;
+    }
+
+    try {
+      await writeContractAsync({
+        functionName: "setGreeting",
+        args: [trimmedGreeting],
+      });
+      setNewGreeting("");
+    } catch (error) {
+      notification.error(getParsedError(error));
+    }
+  };
+
+  return (
+    <main className="flex grow flex-col items-center bg-base-200 px-4 py-10">
+      <div className="w-full max-w-2xl space-y-8">
+        <div className="text-center">
+          <h1 className="text-4xl font-bold">Greetings</h1>
+          <p className="mt-2 text-base-content/70">A shared greeting, stored on-chain.</p>
+        </div>
+
+        <section className="stats stats-vertical w-full overflow-hidden border border-base-300 bg-base-100 shadow sm:stats-horizontal">
+          <div className="stat">
+            <div className="stat-title">Current greeting</div>
+            <div className="stat-value break-words text-2xl">
+              {isGreetingLoading ? (
+                <span className="loading loading-spinner loading-sm" />
+              ) : (
+                greeting || "No greeting yet"
+              )}
+            </div>
+          </div>
+          <div className="stat sm:max-w-48">
+            <div className="stat-title">Times changed</div>
+            <div className="stat-value text-primary">
+              {isCounterLoading ? (
+                <span className="loading loading-spinner loading-sm" />
+              ) : (
+                totalCounter?.toString() || "0"
+              )}
+            </div>
+          </div>
+        </section>
+
+        <section className="card border border-base-300 bg-base-100 shadow">
+          <div className="card-body">
+            <h2 className="card-title">Set a new greeting</h2>
+            <form className="flex flex-col gap-3 sm:flex-row" onSubmit={submitGreeting}>
+              <input
+                className="input input-bordered w-full"
+                disabled={!isConnected || isMining}
+                maxLength={280}
+                onChange={event => setNewGreeting(event.target.value)}
+                placeholder={isConnected ? "What would you like to say?" : "Connect a wallet to set a greeting"}
+                value={newGreeting}
+              />
+              <button
+                className="btn btn-primary sm:min-w-32"
+                disabled={!isConnected || isMining || !newGreeting.trim()}
+                type="submit"
+              >
+                {isMining ? <span className="loading loading-spinner loading-sm" /> : "Update greeting"}
+              </button>
+            </form>
+            {!isConnected && <p className="text-sm text-base-content/60">Connect your wallet to submit a greeting.</p>}
+          </div>
+        </section>
+
+        <section className="card border border-base-300 bg-base-100 shadow">
+          <div className="card-body">
+            <h2 className="card-title">Greeting history</h2>
+            {isHistoryLoading ? (
+              <div className="flex justify-center py-6">
+                <span className="loading loading-spinner loading-md" />
+              </div>
+            ) : greetingChanges?.length ? (
+              <ul className="divide-y divide-base-300">
+                {greetingChanges.map(change => {
+                  const args = change.args as { greetingSetter?: `0x${string}`; newGreeting?: string };
+                  const timestamp = change.blockData?.timestamp;
+
+                  return (
+                    <li className="py-4 first:pt-0 last:pb-0" key={`${change.transactionHash}-${change.logIndex}`}>
+                      <p className="break-words text-lg font-medium">{args.newGreeting}</p>
+                      <div className="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-base-content/65">
+                        <span>Set by</span>
+                        <Address address={args.greetingSetter} chain={targetNetwork} />
+                        {timestamp && <span>· {new Date(Number(timestamp) * 1000).toLocaleString()}</span>}
+                      </div>
+                    </li>
+                  );
+                })}
+              </ul>
+            ) : (
+              <p className="py-4 text-center text-base-content/60">No greeting changes have been recorded yet.</p>
+            )}
+          </div>
+        </section>
+      </div>
+    </main>
+  );
+};
+
+export default GreetingsPage;
