+"use client";
+
+import { useMemo, useState } from "react";
+import { Address } from "@scaffold-ui/components";
+import { formatEther } from "viem";
+import { useAccount } from "wagmi";
+import { RainbowKitCustomConnectButton } from "~~/components/scaffold-eth";
+import {
+  useScaffoldEventHistory,
+  useScaffoldReadContract,
+  useScaffoldWriteContract,
+  useTargetNetwork,
+} from "~~/hooks/scaffold-eth";
+
+export const Greetings = () => {
+  const [newGreeting, setNewGreeting] = useState("");
+  const { isConnected } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+
+  const { data: greeting, isLoading: isGreetingLoading } = useScaffoldReadContract({
+    contractName: "YourContract",
+    functionName: "greeting",
+  });
+
+  const { data: totalCounter, isLoading: isCounterLoading } = useScaffoldReadContract({
+    contractName: "YourContract",
+    functionName: "totalCounter",
+  });
+
+  const { writeContractAsync, isMining } = useScaffoldWriteContract({ contractName: "YourContract" });
+
+  // fromBlock is omitted on purpose: the hook falls back to the contract's deployedOnBlock.
+  const {
+    data: greetingChanges,
+    isLoading: areChangesLoading,
+    isFetchingNewEvent,
+  } = useScaffoldEventHistory({
+    contractName: "YourContract",
+    eventName: "GreetingChange",
+    watch: true,
+  });
+
+  const sortedChanges = useMemo(
+    () =>
+      [...(greetingChanges ?? [])].sort(
+        (a, b) => Number((b.blockNumber ?? 0n) - (a.blockNumber ?? 0n)) || (b.logIndex ?? 0) - (a.logIndex ?? 0),
+      ),
+    [greetingChanges],
+  );
+
+  const handleSubmit = async () => {
+    // The hook toasts its own errors and returns undefined when it bails out early,
+    // so only clear the input once a transaction actually went through.
+    const hash = await writeContractAsync({ functionName: "setGreeting", args: [newGreeting.trim()] });
+    if (hash) setNewGreeting("");
+  };
+
+  const isFeedLoading = areChangesLoading || isFetchingNewEvent;
+
+  return (
+    <div className="flex flex-col items-center grow pt-10 px-5 gap-8 w-full">
+      <div className="card bg-base-100 shadow-xl w-full max-w-2xl">
+        <div className="card-body items-center text-center">
+          <h2 className="card-title">Current greeting</h2>
+          {isGreetingLoading ? (
+            <span className="loading loading-spinner" />
+          ) : (
+            <p className="text-2xl font-bold break-words max-w-full">{greeting}</p>
+          )}
+          <div className="stats bg-base-200">
+            <div className="stat">
+              <div className="stat-title">Times changed</div>
+              <div className="stat-value text-2xl">
+                {isCounterLoading ? <span className="loading loading-spinner" /> : totalCounter?.toString()}
+              </div>
+            </div>
+          </div>
+        </div>
+      </div>
+
+      <div className="card bg-base-100 shadow-xl w-full max-w-2xl">
+        <form
+          className="card-body gap-4"
+          onSubmit={event => {
+            event.preventDefault();
+            void handleSubmit();
+          }}
+        >
+          <h2 className="card-title">Set a new greeting</h2>
+          <input
+            type="text"
+            className="input w-full"
+            placeholder="gm ser"
+            value={newGreeting}
+            onChange={event => setNewGreeting(event.target.value)}
+          />
+          {isConnected ? (
+            <button className="btn btn-primary" type="submit" disabled={isMining || !newGreeting.trim()}>
+              {isMining && <span className="loading loading-spinner loading-sm" />}
+              Set greeting
+            </button>
+          ) : (
+            <div className="flex justify-center">
+              <RainbowKitCustomConnectButton />
+            </div>
+          )}
+        </form>
+      </div>
+
+      <div className="w-full max-w-2xl pb-10">
+        <h2 className="text-xl font-bold mb-4">Past greetings</h2>
+        {isFeedLoading ? (
+          <span className="loading loading-spinner" />
+        ) : !sortedChanges.length ? (
+          <p className="text-base-content/70">No greetings have been set yet.</p>
+        ) : (
+          <div className="flex flex-col gap-3">
+            {sortedChanges.map(change => (
+              <div key={`${change.transactionHash}-${change.logIndex}`} className="card card-sm bg-base-100 shadow-md">
+                <div className="card-body gap-2">
+                  <div className="flex items-center gap-2 flex-wrap">
+                    <Address address={change.args.greetingSetter} chain={targetNetwork} size="sm" />
+                    {change.args.premium && (
+                      <span className="badge badge-secondary badge-sm">
+                        premium · {formatEther(change.args.value ?? 0n)} ETH
+                      </span>
+                    )}
+                  </div>
+                  <p className="break-words">{change.args.newGreeting}</p>
+                </div>
+              </div>
+            ))}
+          </div>
+        )}
+      </div>
+    </div>
+  );
+};
