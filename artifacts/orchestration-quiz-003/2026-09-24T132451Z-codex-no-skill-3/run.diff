+"use client";
+
+import { FormEvent, useMemo, useState } from "react";
+import { Address } from "@scaffold-ui/components";
+import type { NextPage } from "next";
+import { useAccount } from "wagmi";
+import {
+  useScaffoldEventHistory,
+  useScaffoldReadContract,
+  useScaffoldWriteContract,
+  useTargetNetwork,
+} from "~~/hooks/scaffold-eth";
+import { notification } from "~~/utils/scaffold-eth";
+
+type GreetingChangeEvent = {
+  args?: {
+    greetingSetter?: string;
+    newGreeting?: string;
+  };
+  blockNumber?: bigint;
+  logIndex?: number;
+  transactionHash?: string;
+};
+
+const Greetings: NextPage = () => {
+  const [newGreeting, setNewGreeting] = useState("");
+  const { address: connectedAddress, isConnected } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+
+  const { data: greeting, isLoading: isGreetingLoading } = useScaffoldReadContract({
+    contractName: "YourContract",
+    functionName: "greeting",
+  });
+
+  const { data: totalCounter, isLoading: isTotalCounterLoading } = useScaffoldReadContract({
+    contractName: "YourContract",
+    functionName: "totalCounter",
+  });
+
+  const { data: greetingEvents, isLoading: isEventsLoading } = useScaffoldEventHistory({
+    contractName: "YourContract",
+    eventName: "GreetingChange",
+    watch: true,
+    blockData: false,
+    transactionData: false,
+    receiptData: false,
+  });
+
+  const { writeContractAsync, isMining } = useScaffoldWriteContract({
+    contractName: "YourContract",
+  });
+
+  const sortedGreetingEvents = useMemo(() => {
+    return ([...(greetingEvents ?? [])] as GreetingChangeEvent[]).sort((a, b) => {
+      const aBlock = a.blockNumber ?? 0n;
+      const bBlock = b.blockNumber ?? 0n;
+
+      if (aBlock === bBlock) {
+        return (b.logIndex ?? 0) - (a.logIndex ?? 0);
+      }
+
+      return aBlock > bBlock ? -1 : 1;
+    });
+  }, [greetingEvents]);
+
+  const handleSubmitGreeting = async (event: FormEvent<HTMLFormElement>) => {
+    event.preventDefault();
+
+    const trimmedGreeting = newGreeting.trim();
+    if (!trimmedGreeting) {
+      notification.warning("Enter a greeting first.");
+      return;
+    }
+
+    try {
+      await writeContractAsync(
+        {
+          functionName: "setGreeting",
+          args: [trimmedGreeting],
+        },
+        {
+          onBlockConfirmation: () => {
+            notification.success("Greeting updated.");
+            setNewGreeting("");
+          },
+        },
+      );
+    } catch (error) {
+      console.error("Failed to update greeting", error);
+    }
+  };
+
+  return (
+    <div className="grow bg-base-200">
+      <div className="mx-auto flex w-full max-w-5xl flex-col gap-8 px-6 py-10">
+        <div className="flex flex-col gap-3">
+          <h1 className="text-4xl font-bold">Greetings</h1>
+          <p className="max-w-2xl text-base-content/70">
+            Read the live greeting from YourContract, change it from a connected wallet, and follow the onchain history.
+          </p>
+        </div>
+
+        <section className="grid gap-4 md:grid-cols-[1fr_220px]">
+          <div className="bg-base-100 border border-base-300 p-6">
+            <div className="text-sm font-medium text-base-content/60">Current greeting</div>
+            <div className="mt-3 min-h-12 break-words text-2xl font-semibold">
+              {isGreetingLoading ? <span className="loading loading-bars loading-md" /> : greeting?.toString() || "-"}
+            </div>
+          </div>
+
+          <div className="bg-base-100 border border-base-300 p-6">
+            <div className="text-sm font-medium text-base-content/60">Total changes</div>
+            <div className="mt-3 text-4xl font-bold">
+              {isTotalCounterLoading ? (
+                <span className="loading loading-bars loading-md" />
+              ) : (
+                totalCounter?.toString() || "0"
+              )}
+            </div>
+          </div>
+        </section>
+
+        <section className="bg-base-100 border border-base-300 p-6">
+          <div className="mb-5 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
+            <div>
+              <h2 className="text-xl font-semibold">Set a new greeting</h2>
+              {isConnected ? (
+                <div className="mt-2 flex items-center gap-2 text-sm text-base-content/70">
+                  <span>Connected as</span>
+                  <Address address={connectedAddress} chain={targetNetwork} size="sm" />
+                </div>
+              ) : (
+                <p className="mt-2 text-sm text-base-content/70">Connect a wallet to submit a greeting.</p>
+              )}
+            </div>
+          </div>
+
+          <form className="flex flex-col gap-3 sm:flex-row" onSubmit={handleSubmitGreeting}>
+            <input
+              className="input input-bordered min-w-0 flex-1"
+              disabled={!isConnected || isMining}
+              maxLength={140}
+              onChange={event => setNewGreeting(event.target.value)}
+              placeholder="gm, unstoppable app builders"
+              value={newGreeting}
+            />
+            <button
+              className="btn btn-primary sm:w-44"
+              disabled={!isConnected || isMining || !newGreeting.trim()}
+              type="submit"
+            >
+              {isMining ? <span className="loading loading-spinner loading-sm" /> : "Submit"}
+            </button>
+          </form>
+        </section>
+
+        <section className="bg-base-100 border border-base-300">
+          <div className="border-b border-base-300 px-6 py-4">
+            <h2 className="text-xl font-semibold">Past greeting changes</h2>
+          </div>
+
+          {isEventsLoading ? (
+            <div className="flex items-center justify-center px-6 py-12">
+              <span className="loading loading-bars loading-lg" />
+            </div>
+          ) : sortedGreetingEvents.length > 0 ? (
+            <div className="divide-y divide-base-300">
+              {sortedGreetingEvents.map((event, index) => (
+                <div
+                  className="grid gap-3 px-6 py-4 md:grid-cols-[220px_1fr]"
+                  key={`${event.transactionHash ?? "tx"}-${event.logIndex ?? index}`}
+                >
+                  <Address address={event.args?.greetingSetter} chain={targetNetwork} />
+                  <div className="min-w-0">
+                    <div className="break-words font-medium">{event.args?.newGreeting || "-"}</div>
+                    <div className="mt-1 text-xs text-base-content/50">
+                      Block {event.blockNumber?.toString() || "-"}
+                    </div>
+                  </div>
+                </div>
+              ))}
+            </div>
+          ) : (
+            <div className="px-6 py-12 text-center text-base-content/60">No greeting changes yet.</div>
+          )}
+        </section>
+      </div>
+    </div>
+  );
+};
+
+export default Greetings;
