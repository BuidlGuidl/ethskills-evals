@@ -0,0 +1,46 @@
+"use client";
+
+import { Address } from "@scaffold-ui/components";
+import { formatEther } from "viem";
+import { useScaffoldEventHistory } from "~~/hooks/scaffold-eth";
+
+export const GreetingFeed = () => {
+  // Events come back newest first from useScaffoldEventHistory
+  const { data: events, isLoading } = useScaffoldEventHistory({
+    contractName: "YourContract",
+    eventName: "GreetingChange",
+    fromBlock: 0n,
+    watch: true,
+  });
+
+  if (isLoading) {
+    return (
+      <div className="flex justify-center py-10">
+        <span className="loading loading-spinner loading-lg" />
+      </div>
+    );
+  }
+
+  if (!events?.length) {
+    return <p className="text-center py-10">No greetings yet. Be the first one to set it!</p>;
+  }
+
+  return (
+    <ul className="flex flex-col gap-3 w-full">
+      {events.map(event => (
+        <li key={`${event.transactionHash}-${event.logIndex}`} className="card bg-base-100 shadow-md">
+          <div className="card-body py-4 gap-2">
+            <div className="flex items-center justify-between gap-2 flex-wrap">
+              <Address address={event.args.greetingSetter} size="sm" />
+              <span className="text-xs opacity-70">block #{event.blockNumber?.toString()}</span>
+            </div>
+            <p className="m-0 break-words">{event.args.newGreeting}</p>
+            {event.args.premium && (
+              <div className="badge badge-secondary badge-sm">premium · {formatEther(event.args.value ?? 0n)} ETH</div>
+            )}
+          </div>
+        </li>
+      ))}
+    </ul>
+  );
+};
diff --git a/packages/nextjs/app/greetings/_components/GreetingForm.tsx b/packages/nextjs/app/greetings/_components/GreetingForm.tsx
new file mode 100644
index 0000000..c75922e
--- /dev/null
+++ b/packages/nextjs/app/greetings/_components/GreetingForm.tsx
@@ -0,0 +1,53 @@
+"use client";
+
+import { useState } from "react";
+import { useAccount } from "wagmi";
+import { useScaffoldWriteContract, useTargetNetwork } from "~~/hooks/scaffold-eth";
+
+export const GreetingForm = () => {
+  const [newGreeting, setNewGreeting] = useState("");
+  const { isConnected, chainId } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+  const { writeContractAsync, isMining } = useScaffoldWriteContract({ contractName: "YourContract" });
+
+  const isWrongNetwork = isConnected && chainId !== targetNetwork.id;
+  const trimmedGreeting = newGreeting.trim();
+
+  const handleSubmit = async () => {
+    try {
+      await writeContractAsync({ functionName: "setGreeting", args: [trimmedGreeting] });
+      setNewGreeting("");
+    } catch {
+      // errors are surfaced as notifications by useScaffoldWriteContract
+    }
+  };
+
+  return (
+    <div className="card bg-base-100 shadow-xl w-full">
+      <div className="card-body gap-4">
+        <h2 className="card-title">Set a new greeting</h2>
+        <input
+          type="text"
+          className="input input-bordered w-full"
+          placeholder="Building Unstoppable Apps!!!"
+          value={newGreeting}
+          onChange={event => setNewGreeting(event.target.value)}
+          disabled={!isConnected || isWrongNetwork || isMining}
+        />
+        {!isConnected ? (
+          <button className="btn btn-primary" disabled>
+            Connect your wallet to set a greeting
+          </button>
+        ) : isWrongNetwork ? (
+          <button className="btn btn-primary" disabled>
+            Switch to {targetNetwork.name}
+          </button>
+        ) : (
+          <button className="btn btn-primary" onClick={handleSubmit} disabled={isMining || !trimmedGreeting}>
+            {isMining ? <span className="loading loading-spinner loading-sm" /> : "Set Greeting"}
+          </button>
+        )}
+      </div>
+    </div>
+  );
+};
diff --git a/packages/nextjs/app/greetings/page.tsx b/packages/nextjs/app/greetings/page.tsx
new file mode 100644
index 0000000..0b7339c
--- /dev/null
+++ b/packages/nextjs/app/greetings/page.tsx
@@ -0,0 +1,52 @@
+"use client";
+
+import { GreetingFeed } from "./_components/GreetingFeed";
+import { GreetingForm } from "./_components/GreetingForm";
+import type { NextPage } from "next";
+import { useScaffoldReadContract } from "~~/hooks/scaffold-eth";
+
+const Greetings: NextPage = () => {
+  const { data: greeting, isLoading: isGreetingLoading } = useScaffoldReadContract({
+    contractName: "YourContract",
+    functionName: "greeting",
+    watch: true,
+  });
+  const { data: totalCounter, isLoading: isCounterLoading } = useScaffoldReadContract({
+    contractName: "YourContract",
+    functionName: "totalCounter",
+    watch: true,
+  });
+
+  return (
+    <div className="flex flex-col items-center grow w-full px-5 py-10 gap-8">
+      <div className="flex flex-col items-center gap-2 text-center">
+        <h1 className="text-4xl font-bold m-0">Greetings</h1>
+        {isGreetingLoading ? (
+          <span className="loading loading-spinner loading-md" />
+        ) : (
+          <p className="text-2xl m-0 break-words">&ldquo;{greeting}&rdquo;</p>
+        )}
+        <div className="stat-desc text-base">
+          Changed{" "}
+          {isCounterLoading ? (
+            <span className="loading loading-spinner loading-xs align-middle" />
+          ) : (
+            (totalCounter?.toString() ?? "0")
+          )}{" "}
+          times
+        </div>
+      </div>
+
+      <div className="w-full max-w-lg">
+        <GreetingForm />
+      </div>
+
+      <div className="w-full max-w-lg flex flex-col gap-3">
+        <h2 className="text-xl font-bold m-0">Past greetings</h2>
+        <GreetingFeed />
+      </div>
+    </div>
+  );
+};
+
+export default Greetings;
