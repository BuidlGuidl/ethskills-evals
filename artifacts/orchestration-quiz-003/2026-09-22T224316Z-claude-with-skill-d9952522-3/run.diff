+"use client";
+
+import { useState } from "react";
+import { Address } from "@scaffold-ui/components";
+import type { NextPage } from "next";
+import { formatEther } from "viem";
+import { useAccount } from "wagmi";
+import {
+  useScaffoldEventHistory,
+  useScaffoldReadContract,
+  useScaffoldWriteContract,
+  useTargetNetwork,
+} from "~~/hooks/scaffold-eth";
+import { notification } from "~~/utils/scaffold-eth";
+
+const Greetings: NextPage = () => {
+  const [newGreeting, setNewGreeting] = useState("");
+  const { isConnected } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+
+  const { data: greeting } = useScaffoldReadContract({
+    contractName: "YourContract",
+    functionName: "greeting",
+  });
+
+  const { data: totalCounter } = useScaffoldReadContract({
+    contractName: "YourContract",
+    functionName: "totalCounter",
+  });
+
+  const { writeContractAsync, isMining } = useScaffoldWriteContract({ contractName: "YourContract" });
+
+  const { data: greetingChanges, isLoading: isLoadingChanges } = useScaffoldEventHistory({
+    contractName: "YourContract",
+    eventName: "GreetingChange",
+    fromBlock: 0n,
+    watch: true,
+  });
+
+  const handleSubmit = async () => {
+    const trimmedGreeting = newGreeting.trim();
+    if (!trimmedGreeting) {
+      notification.warning("Please enter a greeting");
+      return;
+    }
+
+    try {
+      await writeContractAsync({ functionName: "setGreeting", args: [trimmedGreeting] });
+      setNewGreeting("");
+    } catch (e) {
+      // useScaffoldWriteContract already surfaces the error as a notification
+      console.error("Failed to set greeting", e);
+    }
+  };
+
+  // Event history comes back oldest-first, and the feed shows the newest change on top
+  const feed = greetingChanges ? [...greetingChanges].reverse() : [];
+
+  return (
+    <div className="flex flex-col items-center grow w-full px-5 py-10 gap-8">
+      <div className="card bg-base-100 shadow-xl w-full max-w-2xl">
+        <div className="card-body items-center text-center">
+          <h2 className="card-title">Current Greeting</h2>
+          <p className="text-2xl font-bold break-words break-all">{greeting ?? "Loading..."}</p>
+          <div className="stat-desc text-base">
+            Changed <span className="font-bold">{totalCounter?.toString() ?? "0"}</span> times
+          </div>
+        </div>
+      </div>
+
+      <div className="card bg-base-100 shadow-xl w-full max-w-2xl">
+        <div className="card-body gap-4">
+          <h2 className="card-title">Set a New Greeting</h2>
+          <input
+            type="text"
+            className="input input-bordered w-full"
+            placeholder="gm ser"
+            value={newGreeting}
+            onChange={e => setNewGreeting(e.target.value)}
+          />
+          <button className="btn btn-primary" disabled={!isConnected || isMining} onClick={handleSubmit}>
+            {isMining && <span className="loading loading-spinner loading-sm" />}
+            {isConnected ? "Set Greeting" : "Connect your wallet"}
+          </button>
+        </div>
+      </div>
+
+      <div className="card bg-base-100 shadow-xl w-full max-w-2xl">
+        <div className="card-body gap-4">
+          <h2 className="card-title">Past Greetings</h2>
+          {isLoadingChanges ? (
+            <span className="loading loading-spinner self-center" />
+          ) : feed.length === 0 ? (
+            <p className="text-center">No greetings yet. Be the first!</p>
+          ) : (
+            <ul className="flex flex-col gap-4">
+              {feed.map(({ args, blockNumber, logIndex }) => (
+                <li
+                  key={`${blockNumber}-${logIndex}`}
+                  className="flex flex-col gap-1 border-b border-base-300 pb-3 last:border-none last:pb-0"
+                >
+                  <Address address={args.greetingSetter} chain={targetNetwork} />
+                  <span className="font-medium break-words break-all">{args.newGreeting}</span>
+                  {args.premium && args.value !== undefined && (
+                    <span className="badge badge-secondary self-start">premium · {formatEther(args.value)} ETH</span>
+                  )}
+                </li>
+              ))}
+            </ul>
+          )}
+        </div>
+      </div>
+    </div>
+  );
+};
+
+export default Greetings;
