+"use client";
+
+import { useState } from "react";
+import { Address, EtherInput } from "@scaffold-ui/components";
+import type { NextPage } from "next";
+import { formatEther, parseEther } from "viem";
+import { useAccount } from "wagmi";
+import {
+  useScaffoldEventHistory,
+  useScaffoldReadContract,
+  useScaffoldWriteContract,
+  useTargetNetwork,
+} from "~~/hooks/scaffold-eth";
+import { notification } from "~~/utils/scaffold-eth";
+
+const Greetings: NextPage = () => {
+  const { address: connectedAddress } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+
+  const [newGreeting, setNewGreeting] = useState("");
+  const [tipAmount, setTipAmount] = useState("");
+  // EtherInput is uncontrolled; bumping this key clears it after a successful submit
+  const [tipInputKey, setTipInputKey] = useState(0);
+
+  const { data: greeting, isLoading: isGreetingLoading } = useScaffoldReadContract({
+    contractName: "YourContract",
+    functionName: "greeting",
+  });
+
+  const { data: totalCounter } = useScaffoldReadContract({
+    contractName: "YourContract",
+    functionName: "totalCounter",
+  });
+
+  const { writeContractAsync, isMining } = useScaffoldWriteContract({ contractName: "YourContract" });
+
+  const {
+    data: greetingEvents,
+    isLoading: areEventsLoading,
+    error: eventsError,
+  } = useScaffoldEventHistory({
+    contractName: "YourContract",
+    eventName: "GreetingChange",
+    watch: true,
+  });
+
+  const handleSubmit = async () => {
+    if (!newGreeting.trim()) {
+      notification.warning("Please enter a greeting first");
+      return;
+    }
+
+    try {
+      await writeContractAsync({
+        functionName: "setGreeting",
+        args: [newGreeting],
+        value: tipAmount ? parseEther(tipAmount) : undefined,
+      });
+      setNewGreeting("");
+      setTipAmount("");
+      setTipInputKey(key => key + 1);
+    } catch (e) {
+      // useScaffoldWriteContract already surfaces a notification with the parsed error
+      console.error("setGreeting failed", e);
+    }
+  };
+
+  return (
+    <div className="flex flex-col items-center grow w-full px-5 py-10 gap-8">
+      <div className="card bg-base-100 shadow-xl w-full max-w-2xl">
+        <div className="card-body items-center text-center">
+          <h1 className="card-title text-3xl">Greetings</h1>
+          {isGreetingLoading ? (
+            <span className="loading loading-spinner loading-md" />
+          ) : (
+            <p className="text-2xl font-bold break-words max-w-full">{greeting}</p>
+          )}
+          <div className="stats bg-base-200 mt-2">
+            <div className="stat place-items-center">
+              <div className="stat-title">Times changed</div>
+              <div className="stat-value text-2xl">{totalCounter !== undefined ? totalCounter.toString() : "…"}</div>
+            </div>
+          </div>
+        </div>
+      </div>
+
+      <div className="card bg-base-100 shadow-xl w-full max-w-2xl">
+        <div className="card-body gap-4">
+          <h2 className="card-title">Set a new greeting</h2>
+          <input
+            type="text"
+            className="input input-bordered w-full"
+            placeholder="Building Unstoppable Apps!!!"
+            value={newGreeting}
+            onChange={e => setNewGreeting(e.target.value)}
+            disabled={!connectedAddress || isMining}
+          />
+          <div>
+            <label className="label">
+              <span className="label-text">Optional tip (makes the greeting premium)</span>
+            </label>
+            <EtherInput
+              key={tipInputKey}
+              onValueChange={({ valueInEth }) => setTipAmount(valueInEth)}
+              disabled={!connectedAddress || isMining}
+            />
+          </div>
+          <button
+            className="btn btn-primary"
+            onClick={handleSubmit}
+            disabled={!connectedAddress || isMining || !newGreeting.trim()}
+          >
+            {isMining ? <span className="loading loading-spinner loading-sm" /> : "Set Greeting"}
+          </button>
+          {!connectedAddress && <p className="text-sm text-center m-0">Connect your wallet to set a greeting.</p>}
+        </div>
+      </div>
+
+      <div className="card bg-base-100 shadow-xl w-full max-w-2xl">
+        <div className="card-body gap-4">
+          <h2 className="card-title">Past greetings</h2>
+          {areEventsLoading ? (
+            <span className="loading loading-spinner loading-md self-center" />
+          ) : eventsError ? (
+            <p className="text-center m-0">Could not load the greeting history.</p>
+          ) : !greetingEvents?.length ? (
+            <p className="text-center m-0">No greetings yet. Be the first!</p>
+          ) : (
+            <ul className="flex flex-col gap-3 list-none p-0 m-0">
+              {greetingEvents.map(event => (
+                <li
+                  key={`${event.transactionHash}-${event.logIndex}`}
+                  className="flex flex-col gap-1 bg-base-200 rounded-box p-4"
+                >
+                  <div className="flex items-center gap-2 flex-wrap">
+                    <Address address={event.args.greetingSetter} chain={targetNetwork} size="sm" />
+                    {event.args.premium && (
+                      <span className="badge badge-secondary badge-sm">
+                        premium · {formatEther(event.args.value ?? 0n)} ETH
+                      </span>
+                    )}
+                  </div>
+                  <p className="m-0 break-words">{event.args.newGreeting}</p>
+                </li>
+              ))}
+            </ul>
+          )}
+        </div>
+      </div>
+    </div>
+  );
+};
+
+export default Greetings;
