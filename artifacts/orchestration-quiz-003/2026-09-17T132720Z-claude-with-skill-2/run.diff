+"use client";
+
+import { useState } from "react";
+import { Address } from "@scaffold-ui/components";
+import type { NextPage } from "next";
+import { formatEther } from "viem";
+import { useAccount } from "wagmi";
+import {
+  useScaffoldEventHistory,
+  useScaffoldReadContract,
+  useScaffoldWriteContract,
+  useTargetNetwork,
+} from "~~/hooks/scaffold-eth";
+
+const Greetings: NextPage = () => {
+  const { address: connectedAddress } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+  const [newGreeting, setNewGreeting] = useState("");
+
+  const { data: greeting } = useScaffoldReadContract({
+    contractName: "YourContract",
+    functionName: "greeting",
+  });
+
+  const { data: totalCounter } = useScaffoldReadContract({
+    contractName: "YourContract",
+    functionName: "totalCounter",
+  });
+
+  const { writeContractAsync, isPending } = useScaffoldWriteContract({ contractName: "YourContract" });
+
+  const { data: events, isLoading: isLoadingEvents } = useScaffoldEventHistory({
+    contractName: "YourContract",
+    eventName: "GreetingChange",
+    watch: true,
+  });
+
+  // Hook merges live and historical events; sort explicitly so newest is always first
+  const sortedEvents = [...(events ?? [])].sort((a, b) =>
+    a.blockNumber === b.blockNumber ? b.logIndex - a.logIndex : Number(b.blockNumber - a.blockNumber),
+  );
+
+  const handleSubmit = async (e: React.FormEvent<HTMLFormElement>) => {
+    e.preventDefault();
+    try {
+      await writeContractAsync({ functionName: "setGreeting", args: [newGreeting.trim()] });
+      setNewGreeting("");
+    } catch (err) {
+      // useTransactor already shows an error notification
+      console.error("Error setting greeting:", err);
+    }
+  };
+
+  return (
+    <div className="flex flex-col items-center grow pt-10 px-5 gap-6">
+      <h1 className="text-4xl font-bold">Greetings</h1>
+
+      <div className="stats stats-vertical sm:stats-horizontal shadow bg-base-100 w-full max-w-2xl">
+        <div className="stat">
+          <div className="stat-title">Current greeting</div>
+          <div className="stat-value text-2xl whitespace-normal break-words">{greeting ?? "…"}</div>
+        </div>
+        <div className="stat">
+          <div className="stat-title">Times changed</div>
+          <div className="stat-value">{totalCounter?.toString() ?? "…"}</div>
+        </div>
+      </div>
+
+      <form onSubmit={handleSubmit} className="card bg-base-100 shadow-xl w-full max-w-2xl">
+        <div className="card-body gap-4">
+          <h2 className="card-title">Set a new greeting</h2>
+          <input
+            type="text"
+            className="input input-bordered w-full"
+            placeholder="Write your greeting"
+            value={newGreeting}
+            onChange={e => setNewGreeting(e.target.value)}
+            disabled={!connectedAddress || isPending}
+          />
+          <div className="card-actions justify-end items-center">
+            {!connectedAddress && <span className="text-sm opacity-70">Connect your wallet to set a greeting</span>}
+            <button
+              type="submit"
+              className="btn btn-primary"
+              disabled={!connectedAddress || isPending || !newGreeting.trim()}
+            >
+              {isPending && <span className="loading loading-spinner loading-sm" />}
+              Send
+            </button>
+          </div>
+        </div>
+      </form>
+
+      <div className="w-full max-w-2xl pb-10">
+        <h2 className="text-2xl font-bold mb-4">History</h2>
+        {isLoadingEvents ? (
+          <div className="flex justify-center">
+            <span className="loading loading-spinner loading-lg" />
+          </div>
+        ) : sortedEvents.length === 0 ? (
+          <p className="text-center opacity-70">No greeting changes yet</p>
+        ) : (
+          <ul className="flex flex-col gap-3">
+            {sortedEvents.map(event => (
+              <li key={`${event.transactionHash}-${event.logIndex}`} className="card card-compact bg-base-100 shadow">
+                <div className="card-body">
+                  <div className="flex items-center justify-between gap-2 flex-wrap">
+                    <Address address={event.args.greetingSetter} chain={targetNetwork} />
+                    {event.args.premium && (
+                      <span className="badge badge-secondary">
+                        Premium · {formatEther(event.args.value ?? 0n)} {targetNetwork.nativeCurrency.symbol}
+                      </span>
+                    )}
+                  </div>
+                  <p className="break-words">{event.args.newGreeting}</p>
+                </div>
+              </li>
+            ))}
+          </ul>
+        )}
+      </div>
+    </div>
+  );
+};
+
+export default Greetings;
