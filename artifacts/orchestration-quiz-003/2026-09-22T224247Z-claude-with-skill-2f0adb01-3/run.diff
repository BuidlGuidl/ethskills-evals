+"use client";
+
+import { useState } from "react";
+import { Address } from "@scaffold-ui/components";
+import type { NextPage } from "next";
+import { useAccount } from "wagmi";
+import {
+  useScaffoldEventHistory,
+  useScaffoldReadContract,
+  useScaffoldWriteContract,
+  useTargetNetwork,
+} from "~~/hooks/scaffold-eth";
+import { notification } from "~~/utils/scaffold-eth";
+
+const Greetings: NextPage = () => {
+  const [newGreeting, setNewGreeting] = useState("");
+  const { isConnected } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+
+  const { data: greeting, isLoading: isGreetingLoading } = useScaffoldReadContract({
+    contractName: "YourContract",
+    functionName: "greeting",
+    watch: true,
+  });
+
+  const { data: totalCounter } = useScaffoldReadContract({
+    contractName: "YourContract",
+    functionName: "totalCounter",
+    watch: true,
+  });
+
+  const { writeContractAsync, isMining } = useScaffoldWriteContract({ contractName: "YourContract" });
+
+  // Returned newest first by the hook
+  const { data: greetingChanges, isLoading: areChangesLoading } = useScaffoldEventHistory({
+    contractName: "YourContract",
+    eventName: "GreetingChange",
+    watch: true,
+  });
+
+  const trimmedGreeting = newGreeting.trim();
+
+  const handleSubmit = async () => {
+    if (!trimmedGreeting) {
+      notification.warning("Write a greeting first");
+      return;
+    }
+
+    try {
+      await writeContractAsync({ functionName: "setGreeting", args: [trimmedGreeting] });
+      setNewGreeting("");
+    } catch {
+      // errors are surfaced as notifications by useScaffoldWriteContract
+    }
+  };
+
+  return (
+    <div className="flex flex-col items-center grow w-full px-5 py-10 gap-8">
+      <div className="card bg-base-100 shadow-xl w-full max-w-2xl">
+        <div className="card-body items-center text-center">
+          <h1 className="card-title text-3xl">Greetings</h1>
+          {isGreetingLoading ? (
+            <span className="loading loading-spinner" />
+          ) : (
+            <p className="text-2xl font-bold break-words max-w-full">&ldquo;{greeting}&rdquo;</p>
+          )}
+          <div className="stats bg-base-200">
+            <div className="stat">
+              <div className="stat-title">Times changed</div>
+              <div className="stat-value">{totalCounter !== undefined ? totalCounter.toString() : "…"}</div>
+            </div>
+          </div>
+        </div>
+      </div>
+
+      <div className="card bg-base-100 shadow-xl w-full max-w-2xl">
+        <div className="card-body gap-4">
+          <h2 className="card-title">Set a new greeting</h2>
+          <input
+            type="text"
+            className="input input-bordered w-full"
+            placeholder="Building Unstoppable Apps!!!"
+            value={newGreeting}
+            onChange={event => setNewGreeting(event.target.value)}
+            disabled={!isConnected || isMining}
+          />
+          <button
+            className="btn btn-primary"
+            onClick={handleSubmit}
+            disabled={!isConnected || isMining || !trimmedGreeting}
+          >
+            {isMining && <span className="loading loading-spinner loading-sm" />}
+            {isConnected ? "Set Greeting" : "Connect your wallet to set a greeting"}
+          </button>
+        </div>
+      </div>
+
+      <div className="card bg-base-100 shadow-xl w-full max-w-2xl">
+        <div className="card-body gap-4">
+          <h2 className="card-title">Past greetings</h2>
+          {areChangesLoading ? (
+            <span className="loading loading-spinner self-center" />
+          ) : !greetingChanges?.length ? (
+            <p className="text-center italic">No greetings have been set yet.</p>
+          ) : (
+            <ul className="flex flex-col gap-4">
+              {greetingChanges.map(change => (
+                <li
+                  key={`${change.transactionHash}-${change.logIndex}`}
+                  className="flex flex-col gap-2 border-b border-base-300 last:border-none pb-4 last:pb-0"
+                >
+                  <div className="flex items-center justify-between gap-2 flex-wrap">
+                    <Address address={change.args.greetingSetter} chain={targetNetwork} size="sm" />
+                    <span className="text-xs opacity-60">Block #{change.blockNumber?.toString()}</span>
+                  </div>
+                  <p className="break-words">&ldquo;{change.args.newGreeting}&rdquo;</p>
+                </li>
+              ))}
+            </ul>
+          )}
+        </div>
+      </div>
+    </div>
+  );
+};
+
+export default Greetings;
