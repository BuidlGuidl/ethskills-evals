+"use client";
+
+import { useState } from "react";
+import { Address, EtherInput } from "@scaffold-ui/components";
+import type { NextPage } from "next";
+import { formatEther, parseEther } from "viem";
+import { useAccount } from "wagmi";
+import {
+  useScaffoldEventHistory,
+  useScaffoldReadContract,
+  useScaffoldWriteContract,
+  useTargetNetwork,
+} from "~~/hooks/scaffold-eth";
+import { notification } from "~~/utils/scaffold-eth";
+
+const Greetings: NextPage = () => {
+  const { isConnected } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+
+  const [newGreeting, setNewGreeting] = useState("");
+  const [tipAmount, setTipAmount] = useState("");
+  // EtherInput is uncontrolled, so bump this key to clear it after a successful submit
+  const [tipInputKey, setTipInputKey] = useState(0);
+
+  const { data: greeting, isLoading: isGreetingLoading } = useScaffoldReadContract({
+    contractName: "YourContract",
+    functionName: "greeting",
+  });
+
+  const { data: totalCounter } = useScaffoldReadContract({
+    contractName: "YourContract",
+    functionName: "totalCounter",
+  });
+
+  const { writeContractAsync, isMining } = useScaffoldWriteContract({ contractName: "YourContract" });
+
+  const {
+    data: greetingChanges,
+    isLoading: areEventsLoading,
+    error: eventsError,
+  } = useScaffoldEventHistory({
+    contractName: "YourContract",
+    eventName: "GreetingChange",
+    watch: true,
+  });
+
+  const submitGreeting = async () => {
+    const trimmedGreeting = newGreeting.trim();
+    if (!trimmedGreeting) {
+      notification.warning("Please enter a greeting first");
+      return;
+    }
+
+    try {
+      await writeContractAsync({
+        functionName: "setGreeting",
+        args: [trimmedGreeting],
+        value: tipAmount ? parseEther(tipAmount) : undefined,
+      });
+      setNewGreeting("");
+      setTipAmount("");
+      setTipInputKey(key => key + 1);
+    } catch (e) {
+      // useScaffoldWriteContract already surfaces the parsed error as a notification
+      console.error("Failed to set greeting", e);
+    }
+  };
+
+  return (
+    <div className="flex flex-col items-center grow w-full px-4 py-10 gap-8">
+      <div className="card bg-base-100 shadow-xl w-full max-w-2xl">
+        <div className="card-body items-center text-center">
+          <h1 className="card-title text-3xl">Greetings</h1>
+          {isGreetingLoading ? (
+            <span className="loading loading-spinner loading-md" />
+          ) : (
+            <p className="text-xl font-medium break-words max-w-full">&ldquo;{greeting}&rdquo;</p>
+          )}
+          <div className="stats bg-base-200">
+            <div className="stat">
+              <div className="stat-title">Times changed</div>
+              <div className="stat-value text-2xl">{totalCounter !== undefined ? totalCounter.toString() : "—"}</div>
+            </div>
+          </div>
+        </div>
+      </div>
+
+      <div className="card bg-base-100 shadow-xl w-full max-w-2xl">
+        <div className="card-body gap-4">
+          <h2 className="card-title">Set a new greeting</h2>
+          <input
+            type="text"
+            className="input input-bordered w-full"
+            placeholder="Building Unstoppable Apps!!!"
+            value={newGreeting}
+            onChange={e => setNewGreeting(e.target.value)}
+            disabled={!isConnected || isMining}
+          />
+          <div>
+            <label className="label">
+              <span className="label-text">Optional tip (makes your greeting premium)</span>
+            </label>
+            <EtherInput
+              key={tipInputKey}
+              placeholder="0.00"
+              disabled={!isConnected || isMining}
+              onValueChange={({ valueInEth }) => setTipAmount(valueInEth)}
+            />
+          </div>
+          <button className="btn btn-primary" onClick={submitGreeting} disabled={!isConnected || isMining}>
+            {isMining && <span className="loading loading-spinner loading-sm" />}
+            {isConnected ? "Set Greeting" : "Connect your wallet to set a greeting"}
+          </button>
+        </div>
+      </div>
+
+      <div className="card bg-base-100 shadow-xl w-full max-w-2xl">
+        <div className="card-body gap-4">
+          <h2 className="card-title">Past greetings</h2>
+          {eventsError ? (
+            <p className="text-error">Could not load past greetings.</p>
+          ) : areEventsLoading ? (
+            <span className="loading loading-spinner loading-md self-center" />
+          ) : !greetingChanges?.length ? (
+            <p className="text-base-content/70">No greetings yet — be the first one.</p>
+          ) : (
+            <ul className="flex flex-col gap-3">
+              {greetingChanges.map(event => (
+                <li
+                  key={`${event.transactionHash}-${event.logIndex}`}
+                  className="flex flex-col gap-2 border border-base-300 rounded-box p-4"
+                >
+                  <div className="flex items-center justify-between gap-2 flex-wrap">
+                    <Address address={event.args.greetingSetter} chain={targetNetwork} />
+                    <span className="text-xs text-base-content/70">Block {event.blockNumber?.toString()}</span>
+                  </div>
+                  <p className="break-words">&ldquo;{event.args.newGreeting}&rdquo;</p>
+                  {event.args.premium && event.args.value !== undefined && (
+                    <span className="badge badge-secondary badge-sm w-fit">
+                      Premium · {formatEther(event.args.value)} ETH
+                    </span>
+                  )}
+                </li>
+              ))}
+            </ul>
+          )}
+        </div>
+      </div>
+    </div>
+  );
+};
+
+export default Greetings;
