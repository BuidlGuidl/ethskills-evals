+"use client";
+
+import { FormEvent, useMemo, useState } from "react";
+import { Address } from "@scaffold-ui/components";
+import { useAccount } from "wagmi";
+import { ArrowPathIcon, ChatBubbleBottomCenterTextIcon, PaperAirplaneIcon } from "@heroicons/react/24/outline";
+import {
+  useScaffoldEventHistory,
+  useScaffoldReadContract,
+  useScaffoldWriteContract,
+  useTargetNetwork,
+} from "~~/hooks/scaffold-eth";
+
+type GreetingChangeEvent = NonNullable<
+  ReturnType<typeof useScaffoldEventHistory<"YourContract", "GreetingChange">>["data"]
+>[number];
+
+const compareEventsNewestFirst = (left: GreetingChangeEvent, right: GreetingChangeEvent) => {
+  const leftBlock = left.blockNumber ?? 0n;
+  const rightBlock = right.blockNumber ?? 0n;
+
+  if (leftBlock !== rightBlock) {
+    return leftBlock > rightBlock ? -1 : 1;
+  }
+
+  return Number(right.logIndex ?? 0) - Number(left.logIndex ?? 0);
+};
+
+export const GreetingsClient = () => {
+  const [newGreeting, setNewGreeting] = useState("");
+  const { isConnected } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+
+  const {
+    data: greeting,
+    isLoading: isGreetingLoading,
+    refetch: refetchGreeting,
+  } = useScaffoldReadContract({
+    contractName: "YourContract",
+    functionName: "greeting",
+  });
+
+  const {
+    data: totalCounter,
+    isLoading: isCounterLoading,
+    refetch: refetchTotalCounter,
+  } = useScaffoldReadContract({
+    contractName: "YourContract",
+    functionName: "totalCounter",
+  });
+
+  const {
+    data: greetingEvents,
+    isLoading: areEventsLoading,
+    refetch: refetchGreetingEvents,
+  } = useScaffoldEventHistory({
+    contractName: "YourContract",
+    eventName: "GreetingChange",
+    fromBlock: 0n,
+    watch: true,
+  });
+
+  const { writeContractAsync, isMining } = useScaffoldWriteContract({
+    contractName: "YourContract",
+  });
+
+  const greetingChangeEvents = useMemo(
+    () => [...(greetingEvents ?? [])].filter(Boolean).sort(compareEventsNewestFirst),
+    [greetingEvents],
+  );
+
+  const trimmedGreeting = newGreeting.trim();
+  const isSubmitDisabled = !isConnected || isMining || trimmedGreeting.length === 0;
+
+  const refreshGreetingData = () => {
+    refetchGreeting();
+    refetchTotalCounter();
+    refetchGreetingEvents();
+  };
+
+  const handleSubmit = async (event: FormEvent<HTMLFormElement>) => {
+    event.preventDefault();
+
+    if (isSubmitDisabled) {
+      return;
+    }
+
+    try {
+      const transactionHash = await writeContractAsync(
+        {
+          functionName: "setGreeting",
+          args: [trimmedGreeting],
+        },
+        {
+          blockConfirmations: 1,
+          onBlockConfirmation: refreshGreetingData,
+        },
+      );
+
+      if (transactionHash) {
+        setNewGreeting("");
+      }
+    } catch (error) {
+      console.error("Failed to set greeting", error);
+    }
+  };
+
+  return (
+    <main className="flex-1 bg-base-200">
+      <div className="mx-auto flex w-full max-w-5xl flex-col gap-8 px-4 py-8 sm:px-6 lg:px-8">
+        <section className="flex flex-col gap-5 border-b border-base-300 pb-8">
+          <div>
+            <p className="mb-2 text-sm font-semibold uppercase tracking-wide text-base-content/70">YourContract</p>
+            <h1 className="text-3xl font-bold sm:text-4xl">Greetings</h1>
+          </div>
+
+          <div className="grid gap-4 md:grid-cols-[minmax(0,1fr)_14rem]">
+            <div className="bg-base-100 p-6 shadow-sm">
+              <div className="mb-3 flex items-center gap-2 text-sm font-semibold text-base-content/70">
+                <ChatBubbleBottomCenterTextIcon className="h-5 w-5" />
+                Current greeting
+              </div>
+              <p className="min-h-12 break-words text-2xl font-semibold leading-snug">
+                {isGreetingLoading ? "Loading..." : greeting}
+              </p>
+            </div>
+
+            <div className="bg-base-100 p-6 shadow-sm">
+              <p className="mb-3 text-sm font-semibold text-base-content/70">Total changes</p>
+              <p className="text-4xl font-bold">{isCounterLoading ? "..." : (totalCounter?.toString() ?? "0")}</p>
+            </div>
+          </div>
+        </section>
+
+        <section className="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,24rem)]">
+          <form className="flex flex-col gap-4 bg-base-100 p-6 shadow-sm" onSubmit={handleSubmit}>
+            <div>
+              <label htmlFor="new-greeting" className="label pb-2">
+                <span className="label-text text-base font-semibold">New greeting</span>
+              </label>
+              <textarea
+                id="new-greeting"
+                className="textarea textarea-bordered min-h-28 w-full resize-y text-base"
+                disabled={isMining}
+                maxLength={280}
+                onChange={event => setNewGreeting(event.target.value)}
+                placeholder="Write a new greeting"
+                value={newGreeting}
+              />
+              <div className="mt-2 flex items-center justify-between gap-3 text-sm text-base-content/60">
+                <span>{isConnected ? `Connected to ${targetNetwork.name}` : "Connect a wallet to submit"}</span>
+                <span>{newGreeting.length}/280</span>
+              </div>
+            </div>
+
+            <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
+              <button className="btn btn-primary w-full gap-2 sm:w-auto" disabled={isSubmitDisabled} type="submit">
+                {isMining ? (
+                  <span className="loading loading-spinner loading-sm" />
+                ) : (
+                  <PaperAirplaneIcon className="h-5 w-5" />
+                )}
+                {isMining ? "Submitting" : "Submit greeting"}
+              </button>
+              <button className="btn btn-ghost gap-2" onClick={refreshGreetingData} type="button">
+                <ArrowPathIcon className="h-5 w-5" />
+                Refresh
+              </button>
+            </div>
+          </form>
+
+          <aside className="bg-base-100 p-6 shadow-sm">
+            <p className="mb-3 text-sm font-semibold text-base-content/70">Latest change</p>
+            {greetingChangeEvents[0] ? (
+              <div className="flex flex-col gap-3">
+                <p className="break-words text-xl font-semibold leading-snug">
+                  {greetingChangeEvents[0].args.newGreeting}
+                </p>
+                <Address address={greetingChangeEvents[0].args.greetingSetter} chain={targetNetwork} />
+              </div>
+            ) : (
+              <p className="my-0 text-base-content/70">No changes have been recorded yet.</p>
+            )}
+          </aside>
+        </section>
+
+        <section className="bg-base-100 shadow-sm">
+          <div className="flex flex-col gap-1 border-b border-base-300 p-6 sm:flex-row sm:items-center sm:justify-between">
+            <div>
+              <h2 className="text-2xl font-bold">Past greeting changes</h2>
+              <p className="my-1 text-sm text-base-content/70">Newest first</p>
+            </div>
+            {areEventsLoading && <span className="loading loading-spinner loading-md" />}
+          </div>
+
+          {greetingChangeEvents.length > 0 ? (
+            <ul className="divide-y divide-base-300">
+              {greetingChangeEvents.map(event => (
+                <li
+                  className="grid gap-3 p-6 md:grid-cols-[minmax(0,1fr)_18rem]"
+                  key={`${event.transactionHash}-${event.logIndex}`}
+                >
+                  <div>
+                    <p className="my-0 break-words text-lg font-semibold">{event.args.newGreeting}</p>
+                    <p className="my-1 text-sm text-base-content/60">
+                      Block {event.blockNumber?.toString() ?? "pending"}
+                    </p>
+                  </div>
+                  <div className="flex items-start md:justify-end">
+                    <Address address={event.args.greetingSetter} chain={targetNetwork} />
+                  </div>
+                </li>
+              ))}
+            </ul>
+          ) : (
+            <div className="p-6 text-base-content/70">
+              {areEventsLoading ? "Loading greeting history..." : "No greeting changes found."}
+            </div>
+          )}
+        </section>
+      </div>
+    </main>
+  );
+};
