+"use client";
+
+import { useState } from "react";
+import { Address } from "@scaffold-ui/components";
+import type { NextPage } from "next";
+import { useAccount } from "wagmi";
+import {
+  useScaffoldEventHistory,
+  useScaffoldReadContract,
+  useScaffoldWriteContract,
+  useTargetNetwork,
+} from "~~/hooks/scaffold-eth";
+
+const Greetings: NextPage = () => {
+  const { address: connectedAddress } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+  const [newGreeting, setNewGreeting] = useState("");
+
+  const { data: greeting } = useScaffoldReadContract({
+    contractName: "YourContract",
+    functionName: "greeting",
+  });
+
+  const { data: totalCounter } = useScaffoldReadContract({
+    contractName: "YourContract",
+    functionName: "totalCounter",
+  });
+
+  const { writeContractAsync, isPending } = useScaffoldWriteContract({
+    contractName: "YourContract",
+  });
+
+  // Hook returns events newest first
+  const { data: greetingChanges, isLoading: isLoadingEvents } = useScaffoldEventHistory({
+    contractName: "YourContract",
+    eventName: "GreetingChange",
+    watch: true,
+  });
+
+  const handleSubmit = async (e: React.FormEvent<HTMLFormElement>) => {
+    e.preventDefault();
+    try {
+      await writeContractAsync({
+        functionName: "setGreeting",
+        args: [newGreeting],
+      });
+      setNewGreeting("");
+    } catch (err) {
+      // useTransactor already shows an error notification
+      console.error("Error setting greeting", err);
+    }
+  };
+
+  return (
+    <div className="flex flex-col items-center grow pt-10 px-4 gap-6">
+      <div className="card bg-base-100 shadow-xl w-full max-w-xl">
+        <div className="card-body">
+          <h1 className="card-title text-2xl">Current greeting</h1>
+          <p className="text-xl break-words">{greeting ?? <span className="loading loading-dots loading-sm" />}</p>
+          <div className="stat p-0">
+            <div className="stat-title">Times changed</div>
+            <div className="stat-value text-2xl">{totalCounter?.toString() ?? "-"}</div>
+          </div>
+        </div>
+      </div>
+
+      <div className="card bg-base-100 shadow-xl w-full max-w-xl">
+        <form className="card-body" onSubmit={handleSubmit}>
+          <h2 className="card-title">Set a new greeting</h2>
+          <input
+            type="text"
+            className="input input-bordered w-full"
+            placeholder="Your greeting"
+            value={newGreeting}
+            onChange={e => setNewGreeting(e.target.value)}
+            disabled={!connectedAddress || isPending}
+          />
+          <div className="card-actions justify-end">
+            <button
+              type="submit"
+              className="btn btn-primary"
+              disabled={!connectedAddress || !newGreeting.trim() || isPending}
+            >
+              {isPending ? <span className="loading loading-spinner loading-sm" /> : "Submit"}
+            </button>
+          </div>
+          {!connectedAddress && <p className="text-sm opacity-70">Connect your wallet to set a greeting.</p>}
+        </form>
+      </div>
+
+      <div className="card bg-base-100 shadow-xl w-full max-w-xl mb-10">
+        <div className="card-body">
+          <h2 className="card-title">Greeting history</h2>
+          {isLoadingEvents ? (
+            <span className="loading loading-spinner" />
+          ) : !greetingChanges?.length ? (
+            <p className="opacity-70">No greeting changes yet.</p>
+          ) : (
+            <ul className="flex flex-col gap-3">
+              {greetingChanges.map(event => (
+                <li
+                  key={`${event.transactionHash}-${event.logIndex}`}
+                  className="flex flex-col gap-1 border-b border-base-300 pb-3 last:border-none"
+                >
+                  <Address address={event.args.greetingSetter} chain={targetNetwork} />
+                  <p className="m-0 break-words">{event.args.newGreeting}</p>
+                </li>
+              ))}
+            </ul>
+          )}
+        </div>
+      </div>
+    </div>
+  );
+};
+
+export default Greetings;
