+"use client";
+
+import { useMemo, useState } from "react";
+import type { FormEvent } from "react";
+import { Address } from "@scaffold-ui/components";
+import type { NextPage } from "next";
+import type { Address as AddressType } from "viem";
+import { useAccount } from "wagmi";
+import { useScaffoldEventHistory, useScaffoldReadContract, useScaffoldWriteContract } from "~~/hooks/scaffold-eth";
+import { useTargetNetwork } from "~~/hooks/scaffold-eth";
+
+const CONTRACT_NAME = "YourContract";
+
+const Greetings: NextPage = () => {
+  const [newGreeting, setNewGreeting] = useState("");
+  const { isConnected } = useAccount();
+  const { targetNetwork } = useTargetNetwork();
+
+  const {
+    data: greeting,
+    isLoading: isGreetingLoading,
+    refetch: refetchGreeting,
+  } = useScaffoldReadContract({
+    contractName: CONTRACT_NAME,
+    functionName: "greeting",
+  });
+
+  const {
+    data: totalCounter,
+    isLoading: isCounterLoading,
+    refetch: refetchTotalCounter,
+  } = useScaffoldReadContract({
+    contractName: CONTRACT_NAME,
+    functionName: "totalCounter",
+  });
+
+  const {
+    data: greetingEvents,
+    isLoading: isEventsLoading,
+    refetch: refetchGreetingEvents,
+  } = useScaffoldEventHistory({
+    contractName: CONTRACT_NAME,
+    eventName: "GreetingChange",
+    watch: true,
+  });
+
+  const { writeContractAsync, isMining } = useScaffoldWriteContract({
+    contractName: CONTRACT_NAME,
+  });
+
+  const trimmedGreeting = newGreeting.trim();
+  const isSubmitDisabled = !isConnected || isMining || trimmedGreeting.length === 0;
+
+  const greetingChanges = useMemo(() => greetingEvents ?? [], [greetingEvents]);
+
+  const handleSubmit = async (event: FormEvent<HTMLFormElement>) => {
+    event.preventDefault();
+
+    if (isSubmitDisabled) return;
+
+    await writeContractAsync(
+      {
+        functionName: "setGreeting",
+        args: [trimmedGreeting],
+      },
+      {
+        onBlockConfirmation: () => {
+          setNewGreeting("");
+          refetchGreeting();
+          refetchTotalCounter();
+          refetchGreetingEvents();
+        },
+      },
+    );
+  };
+
+  return (
+    <main className="grow bg-base-200">
+      <div className="mx-auto flex w-full max-w-5xl flex-col gap-8 px-4 py-8 sm:px-6 lg:px-8">
+        <section className="flex flex-col gap-4">
+          <div>
+            <p className="text-sm font-semibold uppercase tracking-wide text-primary">YourContract</p>
+            <h1 className="text-3xl font-bold sm:text-4xl">Greetings</h1>
+          </div>
+
+          <div className="grid gap-4 md:grid-cols-[minmax(0,1fr)_12rem]">
+            <div className="rounded-box border border-base-300 bg-base-100 p-6 shadow-sm">
+              <p className="text-sm font-semibold text-base-content/70">Current greeting</p>
+              <p className="mt-3 break-words text-2xl font-semibold">
+                {isGreetingLoading ? <span className="loading loading-dots loading-md" /> : (greeting ?? "Unavailable")}
+              </p>
+            </div>
+
+            <div className="rounded-box border border-base-300 bg-base-100 p-6 shadow-sm">
+              <p className="text-sm font-semibold text-base-content/70">Total changes</p>
+              <p className="mt-3 text-4xl font-bold">{isCounterLoading ? "..." : (totalCounter?.toString() ?? "0")}</p>
+            </div>
+          </div>
+        </section>
+
+        <section className="rounded-box border border-base-300 bg-base-100 p-6 shadow-sm">
+          <form onSubmit={handleSubmit} className="flex flex-col gap-4">
+            <label className="form-control w-full">
+              <span className="label pb-2">
+                <span className="label-text font-semibold">New greeting</span>
+              </span>
+              <textarea
+                className="textarea textarea-bordered min-h-28 resize-y text-base"
+                disabled={!isConnected || isMining}
+                maxLength={280}
+                onChange={event => setNewGreeting(event.target.value)}
+                placeholder={isConnected ? "Write a new greeting" : "Connect your wallet to submit a greeting"}
+                value={newGreeting}
+              />
+            </label>
+
+            <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
+              <p className="text-sm text-base-content/70">{newGreeting.length}/280 characters</p>
+              <button className="btn btn-primary sm:min-w-40" disabled={isSubmitDisabled} type="submit">
+                {isMining ? <span className="loading loading-spinner loading-sm" /> : null}
+                Set greeting
+              </button>
+            </div>
+          </form>
+        </section>
+
+        <section className="flex flex-col gap-4">
+          <div className="flex items-center justify-between gap-4">
+            <h2 className="text-2xl font-bold">Past changes</h2>
+            {isEventsLoading ? <span className="loading loading-spinner loading-sm" /> : null}
+          </div>
+
+          {greetingChanges.length > 0 ? (
+            <div className="flex flex-col gap-3">
+              {greetingChanges.map(event => {
+                const greetingSetter = event.args.greetingSetter as AddressType | undefined;
+                const eventGreeting = event.args.newGreeting;
+                const eventKey = `${event.transactionHash}-${event.logIndex}`;
+
+                return (
+                  <article key={eventKey} className="rounded-box border border-base-300 bg-base-100 p-5 shadow-sm">
+                    <div className="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
+                      <div className="min-w-0">
+                        <p className="text-sm font-semibold text-base-content/70">Set by</p>
+                        <Address address={greetingSetter} chain={targetNetwork} />
+                      </div>
+                      {event.blockNumber ? (
+                        <p className="shrink-0 text-sm text-base-content/60">Block {event.blockNumber.toString()}</p>
+                      ) : null}
+                    </div>
+                    <p className="mt-4 break-words text-lg font-medium">{eventGreeting}</p>
+                  </article>
+                );
+              })}
+            </div>
+          ) : (
+            <div className="rounded-box border border-dashed border-base-300 bg-base-100 p-8 text-center text-base-content/70">
+              {isEventsLoading ? "Loading greeting changes..." : "No greeting changes yet."}
+            </div>
+          )}
+        </section>
+      </div>
+    </main>
+  );
+};
+
+export default Greetings;
