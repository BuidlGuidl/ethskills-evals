# --- Chain ---------------------------------------------------------------
# Base mainnet (8453) by default; use 84532 for Base Sepolia or 31337 for anvil.
CHAIN_ID=8453
# An RPC endpoint that supports eth_getLogs over historical ranges. A public
# endpoint works for a small backfill; use a provider (Alchemy/QuickNode/...)
# for months of history.
PONDER_RPC_URL_BASE=https://mainnet.base.org
# Requests per second Ponder is allowed to make during the backfill.
RPC_MAX_RPS=25

# --- Contract ------------------------------------------------------------
STREAK_ADDRESS=0x0000000000000000000000000000000000000000
# The block the contract was deployed in. The backfill starts here, which is
# what makes the feed/streaks/leaderboard cover the ENTIRE history.
STREAK_START_BLOCK=0

# --- Storage -------------------------------------------------------------
# Optional. Without it Ponder uses an embedded PGlite database under .ponder/,
# which is fine locally. Use Postgres for anything you deploy.
# DATABASE_URL=postgresql://user:pass@localhost:5432/streak
# Postgres schema the indexed tables live in. Required by `ponder start`
# (`ponder dev` defaults it). Use a new value per release for zero-downtime cutover.
# DATABASE_SCHEMA=streak_v1

# --- Server --------------------------------------------------------------
PORT=42069
# CORS_ORIGIN=https://streak.example.com
