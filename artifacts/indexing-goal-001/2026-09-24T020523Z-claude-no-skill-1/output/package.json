{
  "name": "streak",
  "private": true,
  "type": "module",
  "workspaces": [
    "indexer"
  ],
  "scripts": {
    "abi": "node scripts/generate-abi.mjs",
    "anvil": "anvil --silent --timestamp $(node -e \"process.stdout.write(String(Math.floor(Date.now()/1000)-400*86400))\")",
    "build:contracts": "forge build --root contracts",
    "test:contracts": "forge test --root contracts",
    "deploy": "forge script contracts/script/Deploy.s.sol:Deploy --root contracts",
    "seed": "npm run build:contracts && node scripts/seed-local.mjs",
    "dev": "npm run dev --workspace indexer",
    "start": "npm run start --workspace indexer",
    "typecheck": "npm run typecheck --workspace indexer"
  },
  "devDependencies": {
    "viem": "2.35.0"
  },
  "engines": {
    "node": ">=22"
  }
}
