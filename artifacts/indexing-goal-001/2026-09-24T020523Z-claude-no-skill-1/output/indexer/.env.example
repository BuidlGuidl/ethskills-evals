# --- Chain / contract -------------------------------------------------------
# Base mainnet. Use an RPC that serves eth_getLogs over the full history
# (Alchemy, QuickNode, Ankr, your own node); the public base.org endpoint
# rate-limits hard during the initial backfill.
PONDER_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
CHAIN_ID=8453
STREAK_ADDRESS=0xYourDeployedStreakAddress
# Block the contract was deployed in. Printed by contracts/script/Deploy.s.sol.
STREAK_START_BLOCK=0

# --- Storage ----------------------------------------------------------------
# Omit to use the bundled PGlite (local dev). Set to Postgres for anything real.
# DATABASE_URL=postgresql://user:pass@localhost:5432/streak
