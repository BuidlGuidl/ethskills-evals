{
  "name": "streak",
  "private": true,
  "type": "module",
  "scripts": {
    "contract:test": "forge test",
    "contract:deploy:base-sepolia": "forge script script/Deploy.s.sol:Deploy --rpc-url \"$BASE_SEPOLIA_RPC_URL\" --broadcast --verify",
    "contract:deploy:base": "forge script script/Deploy.s.sol:Deploy --rpc-url \"$BASE_RPC_URL\" --broadcast --verify",
    "subgraph:codegen": "graph codegen subgraph/subgraph.yaml",
    "subgraph:build": "graph build subgraph/subgraph.yaml",
    "read-api:dev": "tsx read-api/server.ts",
    "read-api:typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "express": "^4.19.2",
    "graphql": "^16.9.0",
    "graphql-request": "^7.1.0"
  },
  "devDependencies": {
    "@graphprotocol/graph-cli": "^0.97.1",
    "@graphprotocol/graph-ts": "^0.35.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
