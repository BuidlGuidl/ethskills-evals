{
  "name": "streak-onchain-checkin",
  "private": true,
  "type": "module",
  "scripts": {
    "contracts:build": "forge build",
    "contracts:deps": "forge install foundry-rs/forge-std --no-commit --no-git",
    "contracts:test": "forge test",
    "dev:api": "tsx watch src/server.ts",
    "dev:indexer": "tsx watch src/indexer.ts",
    "start:api": "tsx src/server.ts",
    "start:indexer": "tsx src/indexer.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "viem": "^2.21.58",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
