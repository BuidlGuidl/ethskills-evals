# Copy to .env.local. Ponder loads .env.local automatically.

# --- chain -------------------------------------------------------------------
# Base mainnet. Use 84532 for Base Sepolia, 31337 for a local anvil node.
CHAIN_ID=8453
# An RPC that supports eth_getLogs over wide block ranges. The public endpoint
# works but is rate limited; use Alchemy/QuickNode/etc. for a real backfill.
PONDER_RPC_URL_BASE=https://mainnet.base.org

# --- contract ----------------------------------------------------------------
STREAK_ADDRESS=0x0000000000000000000000000000000000000000
# The block Streak was deployed in. Both values are printed by the deploy script.
# This is what makes the app show the full history: indexing starts here, not at
# the current head.
STREAK_START_BLOCK=0

# --- database ----------------------------------------------------------------
# Optional. Unset -> PGlite in .ponder/pglite (fine for local dev).
# Required for production: Ponder keeps the indexed tables in Postgres.
# DATABASE_URL=postgresql://user:password@localhost:5432/streak
