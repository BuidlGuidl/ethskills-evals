    "test:unit": "vitest run"
  },
  "dependencies": {
    "hono": "^4.9.7",
    "ponder": "^0.17.10"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
