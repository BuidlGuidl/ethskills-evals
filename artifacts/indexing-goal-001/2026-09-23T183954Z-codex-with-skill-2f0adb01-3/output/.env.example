# Base mainnet RPC used by Ponder. PONDER_RPC_URL_8453 also works.
BASE_RPC_URL=https://mainnet.base.org

# Set these after deploying Streak.
STREAK_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
STREAK_START_BLOCK=0

# Keep 8453 for Base. For an Anvil fork/local chain, start Anvil with --chain-id 8453.
PONDER_CHAIN_ID=8453

# Optional for local Anvil development.
PONDER_DISABLE_CACHE=false
