{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"],
    "allowSyntheticDefaultImports": true,
    "noEmit": true
  },
  "include": [
    "abis/**/*.ts",
    "ponder.config.ts",
    "ponder.schema.ts",
    "ponder-env.d.ts",
    "src/**/*.ts"
  ]
}
