# --- Chain -------------------------------------------------------------------
# 8453 = Base mainnet, 84532 = Base Sepolia, 31337 = local anvil.
CHAIN_ID=8453

# RPC endpoint used for the historical backfill and for tailing new blocks.
# Use a paid endpoint (Alchemy, QuickNode, Base's paid tier): the backfill of
# months of history is thousands of eth_getLogs calls and public endpoints
# rate-limit it into the ground.
PONDER_RPC_URL_BASE=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# --- Contract ----------------------------------------------------------------
# Address of the deployed Streak contract, and the block it was deployed in.
# STREAK_START_BLOCK must be the deployment block: later truncates history,
# earlier wastes hours of backfill on empty blocks.
STREAK_ADDRESS=0x0000000000000000000000000000000000000000
STREAK_START_BLOCK=0

# --- Storage -----------------------------------------------------------------
# Postgres connection string. Required in production — without it Ponder falls
# back to a local PGlite database under .ponder/, which does not survive a
# redeploy and forces a full re-backfill on every restart.
DATABASE_URL=postgresql://user:password@host:5432/streak

# Namespace for the indexed tables. Ponder uses this for zero-downtime
# redeploys: a new version indexes into a fresh schema and only takes over
# serving once it has caught up.
# DATABASE_SCHEMA=streak_v1

# Port for the HTTP API.
PORT=42069
