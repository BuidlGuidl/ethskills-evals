# Which chain to index. `base` is the real deployment; `anvil` points the same
# indexer at a local node for developing handlers and API routes.
STREAK_CHAIN=base

# A Base mainnet RPC. Use a paid/dedicated endpoint for the backfill: the public
# endpoint will rate-limit a months-long historical sync.
PONDER_RPC_URL_8453=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# Only for STREAK_CHAIN=anvil.
# PONDER_RPC_URL_31337=http://127.0.0.1:8545

# Deployed Streak contract, and the block it was deployed in. The start block is
# the whole point: Ponder backfills from here, so the feed, streaks and
# leaderboard cover the contract's entire history.
STREAK_ADDRESS=0x0000000000000000000000000000000000000000
STREAK_START_BLOCK=0

# Omit locally to use the built-in PGlite store. Required in production so the
# backfill is paid once and survives restarts and redeploys.
# PONDER_DATABASE_URL=postgresql://user:pass@host:5432/streak

# Comma-separated allowed origins for the frontend. Defaults to *.
# CORS_ORIGIN=https://streak.example.com
