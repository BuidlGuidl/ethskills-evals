# Chain to index: base | baseSepolia | anvil
STREAK_CHAIN=base

# RPC endpoint for that chain. Use a paid/archive-capable provider for Base
# mainnet — backfilling months of history means a lot of eth_getLogs.
PONDER_RPC_URL=https://mainnet.base.org

# Deployed Streak contract.
STREAK_ADDRESS=0x0000000000000000000000000000000000000000

# The block the contract was deployed in. Indexing starts here, so the API
# covers the contract's complete history. Printed by script/Deploy.s.sol.
STREAK_START_BLOCK=0

# Optional: Postgres for anything other than local dev. Ponder falls back to
# an embedded PGlite database under .ponder/ when this is unset.
# DATABASE_URL=postgresql://user:pass@localhost:5432/streak
