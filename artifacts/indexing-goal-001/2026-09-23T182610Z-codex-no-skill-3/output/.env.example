# Base mainnet RPC URL. Use a Base Sepolia URL while testing.
RPC_URL=https://mainnet.base.org

# Filled in after deployment.
STREAK_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# The deployment block for the contract. The indexer starts here so it can replay
# every historical CheckIn event from the contract's first day.
STREAK_START_BLOCK=0

# Optional runtime settings.
DATABASE_PATH=./data/streak.json
PORT=3000
INDEX_CHUNK_SIZE=2000
INDEX_CONFIRMATIONS=2
INDEX_POLL_MS=12000

# Deploy script settings.
PRIVATE_KEY=0x...
CHAIN_ID=8453
