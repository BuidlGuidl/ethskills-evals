{
  "name": "streak-subgraph",
  "version": "1.0.0",
  "private": true,
  "description": "Subgraph indexing Streak check-ins on Base",
  "scripts": {
    "codegen": "graph codegen",
    "build": "graph build --network base",
    "build:sepolia": "graph build --network base-sepolia",
    "deploy": "graph deploy streak --network base",
    "deploy:sepolia": "graph deploy streak --network base-sepolia",
    "create:local": "graph create --node http://localhost:8020/ streak",
    "deploy:local": "graph deploy streak --node http://localhost:8020/ --ipfs http://localhost:5001 --network mainnet --version-label v0.0.1",
    "test": "graph test"
  },
  "dependencies": {
    "@graphprotocol/graph-cli": "0.97.1",
    "@graphprotocol/graph-ts": "0.38.1"
  },
  "devDependencies": {
    "matchstick-as": "0.6.0"
  }
}
