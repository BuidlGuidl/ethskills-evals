# Required — the deployed subgraph's GraphQL endpoint.
# Subgraph Studio:  https://api.studio.thegraph.com/query/<id>/streak/version/latest
# Local graph-node: http://localhost:8000/subgraphs/name/streak
STREAK_SUBGRAPH_URL=

# Optional — enables the feed's live tail and the onchain profile fallback.
BASE_RPC_URL=https://mainnet.base.org
STREAK_ADDRESS=

# Deploy-time only (contracts/).
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASESCAN_API_KEY=
