# ---------------------------------------------------------------------------
# Chain. Defaults target Base mainnet; override CHAIN_ID + PONDER_RPC_URL to
# point the indexer at Base Sepolia (84532) or a local anvil node (31337).
# ---------------------------------------------------------------------------
CHAIN_ID=8453
PONDER_RPC_URL=https://mainnet.base.org

# ---------------------------------------------------------------------------
# The deployed Streak contract, and the block it was deployed in. STREAK_START_BLOCK
# is what makes the backfill complete: Ponder reads every CheckedIn log from this
# block to the chain tip before it starts following new blocks. Set it to the
# deployment block (printed by script/Deploy.s.sol) — not to "recent".
# ---------------------------------------------------------------------------
STREAK_ADDRESS=0x0000000000000000000000000000000000000000
STREAK_START_BLOCK=0

# ---------------------------------------------------------------------------
# Storage. Omit for local development and Ponder uses an embedded PGlite
# database under .ponder/. Set it to a Postgres URL for anything you intend to
# keep or serve to users.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@localhost:5432/streak
