{
  "name": "streak-base",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "compile": "tsx scripts/compile.ts",
    "deploy": "tsx scripts/deploy.ts",
    "dev": "ponder dev",
    "start": "ponder start",
    "serve": "ponder serve",
    "typecheck": "STREAK_CONTRACT_ADDRESS=${STREAK_CONTRACT_ADDRESS:-0x0000000000000000000000000000000000000000} PONDER_START_BLOCK=${PONDER_START_BLOCK:-0} PONDER_RPC_URL_8453=${PONDER_RPC_URL_8453:-http://localhost:8545} ponder codegen && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.13.8",
    "ponder": "^0.17.10",
    "viem": "^2.56.8"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "solc": "^0.8.37",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
