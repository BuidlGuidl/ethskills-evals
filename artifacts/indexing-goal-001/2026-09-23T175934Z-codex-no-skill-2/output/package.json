{
  "name": "base-streak",
  "private": true,
  "type": "module",
  "scripts": {
    "api": "tsx src/server.ts",
    "compile": "XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-.data/xdg/config} XDG_DATA_HOME=${XDG_DATA_HOME:-.data/xdg/data} XDG_CACHE_HOME=${XDG_CACHE_HOME:-.data/xdg/cache} hardhat compile",
    "deploy:base": "npm run compile && tsx scripts/deploy.ts base",
    "deploy:base-sepolia": "npm run compile && tsx scripts/deploy.ts baseSepolia",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "viem": "^2.22.17",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "^3.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "hardhat": "^2.22.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
