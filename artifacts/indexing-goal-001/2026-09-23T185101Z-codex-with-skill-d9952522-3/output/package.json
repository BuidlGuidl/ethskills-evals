{
  "name": "streak",
  "private": true,
  "type": "module",
  "scripts": {
    "api": "tsx src/api/server.ts",
    "contract:build": "forge build",
    "db:migrate": "tsx src/db/migrate.ts",
    "deploy": "forge create contracts/Streak.sol:Streak --rpc-url \"$RPC_URL\" --private-key \"$DEPLOYER_PRIVATE_KEY\"",
    "indexer": "tsx src/indexer/index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "viem": "^2.23.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
