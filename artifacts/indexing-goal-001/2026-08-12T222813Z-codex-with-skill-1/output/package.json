{
  "name": "streak",
  "private": true,
  "type": "module",
  "scripts": {
    "codegen": "graph codegen subgraph/subgraph.yaml --output-dir subgraph/generated",
    "build:subgraph": "graph build subgraph/subgraph.yaml --output-dir generated/subgraph",
    "typecheck": "tsc --noEmit",
    "build:contract": "solcjs --bin --abi contracts/Streak.sol -o generated/solc",
    "test": "npm run typecheck && npm run build:contract && npm run codegen && npm run build:subgraph"
  },
  "devDependencies": {
    "@graphprotocol/graph-cli": "0.98.1",
    "@graphprotocol/graph-ts": "0.38.0",
    "solc": "0.8.24",
    "typescript": "5.8.3"
  }
}
