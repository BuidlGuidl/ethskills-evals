# Chain the contract is deployed to. 8453 = Base mainnet, 84532 = Base Sepolia,
# 31337 = local anvil.
CHAIN_ID=8453

# RPC endpoint. The public https://mainnet.base.org works but rate-limits hard;
# use a paid endpoint (Alchemy, QuickNode, ...) to backfill months of history
# in minutes instead of hours.
PONDER_RPC_URL=https://mainnet.base.org

# Deployed Streak contract, and the block it was deployed in. The start block is
# what makes the backfill cover the contract's entire history — set it to the
# deployment block, not to "recent".
STREAK_ADDRESS=
STREAK_START_BLOCK=

# Max block span per eth_getLogs request. Public Base RPCs allow ~1000; paid
# endpoints handle 10_000+ and backfill much faster.
PONDER_LOGS_BLOCK_RANGE=1000

# Postgres for anything other than local development. Omit it and Ponder uses
# an embedded PGlite database under .ponder/.
# DATABASE_URL=postgresql://user:password@localhost:5432/streak
