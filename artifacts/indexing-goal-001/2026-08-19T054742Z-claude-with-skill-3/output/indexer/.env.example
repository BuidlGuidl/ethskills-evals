# Chain: 8453 = Base mainnet, 84532 = Base Sepolia
CHAIN_ID=8453

# An RPC with archive access to the contract's full history. A public endpoint
# works for a small backfill; use a paid provider for months of history.
PONDER_RPC_URL=https://mainnet.base.org

# Deployed Streak contract, and the block it was deployed in. START_BLOCK is what
# makes the backfill cover the entire record -- do not set it to a recent block.
STREAK_ADDRESS=0x0000000000000000000000000000000000000000
STREAK_START_BLOCK=0

# Omit for local dev (Ponder falls back to an embedded PGlite database).
# Required in production -- this is the persistent store the backfill lands in.
# DATABASE_URL=postgres://user:pass@host:5432/streak
