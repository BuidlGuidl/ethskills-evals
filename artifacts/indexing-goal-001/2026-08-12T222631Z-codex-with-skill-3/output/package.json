{
  "name": "streak",
  "private": true,
  "scripts": {
    "codegen": "graph codegen --output-dir subgraph/generated subgraph/subgraph.yaml",
    "build:subgraph": "graph build subgraph/subgraph.yaml",
    "deploy:subgraph": "graph deploy --studio $SUBGRAPH_SLUG subgraph/subgraph.yaml",
    "dev:api": "tsx watch api/server.ts",
    "start:api": "tsx api/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@graphprotocol/graph-cli": "^0.97.0",
    "@graphprotocol/graph-ts": "^0.38.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "graphql-request": "^7.1.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "solc": "0.8.24",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
