# --- required ---------------------------------------------------------------
# An RPC for Base. A public endpoint will backfill months of history eventually,
# but a paid one (Alchemy/QuickNode/Ankr) is what you want for the initial sync.
PONDER_RPC_URL=https://mainnet.base.org

# The deployed Streak contract, and the block it was deployed in.
# STREAK_START_BLOCK is not optional and not a guess: the indexer backfills from
# it, so a value later than the real deployment block permanently loses history.
# `forge script Deploy` prints both.
STREAK_ADDRESS=0x0000000000000000000000000000000000000000
STREAK_START_BLOCK=0

# --- optional ---------------------------------------------------------------
# 8453 Base mainnet, 84532 Base Sepolia, 31337 anvil.
CHAIN_ID=8453

# Must equal the contract's immutable dayOffsetSeconds, or the read side's idea
# of "today" and "this month" will disagree with the chain's.
DAY_OFFSET_SECONDS=0

# Postgres for production. Omit it and Ponder uses PGlite on local disk, which
# is fine for development and wrong for a deployment (no durability, one process).
# DATABASE_URL=postgresql://user:pass@host:5432/streak

# Lock this down to your frontend's origin in production.
CORS_ORIGIN=*
