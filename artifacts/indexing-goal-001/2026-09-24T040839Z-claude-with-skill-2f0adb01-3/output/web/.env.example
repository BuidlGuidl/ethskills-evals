# GraphQL endpoint of the Streak subgraph (Subgraph Studio, the decentralized
# network, or http://localhost:8000/subgraphs/name/streak-local for local dev).
NEXT_PUBLIC_SUBGRAPH_URL=https://api.studio.thegraph.com/query/<id>/streak-base/version/latest

# Deployed Streak contract — used only for the check-in write.
NEXT_PUBLIC_STREAK_ADDRESS=0x0000000000000000000000000000000000000000
