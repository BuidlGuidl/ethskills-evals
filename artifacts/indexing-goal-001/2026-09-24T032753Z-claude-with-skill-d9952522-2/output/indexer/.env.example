# Base mainnet RPC. A public endpoint will technically work for the tail, but the
# months-long backfill needs a paid endpoint (Alchemy / QuickNode / Ankr) or it will
# rate-limit partway through. Ponder resumes, but it will be slow and noisy.
PONDER_RPC_URL_8453=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# Deployed Streak contract and the block it was deployed in. startBlock must be the
# deployment block (not "latest") — that is what makes the read side cover the
# contract's entire history.
STREAK_ADDRESS=0x0000000000000000000000000000000000000000
STREAK_START_BLOCK=0

# Persistent store. Required in production; omit locally and Ponder uses PGlite.
# DATABASE_URL=postgresql://user:pass@host:5432/streak

# Postgres schema the indexed tables live in. `ponder start` requires it.
# Give each deploy its own schema (e.g. a git sha) for zero-downtime cutovers:
# the new instance backfills into its own schema while the old one keeps serving.
DATABASE_SCHEMA=public
