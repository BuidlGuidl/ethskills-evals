{
  "name": "streak",
  "private": true,
  "type": "module",
  "scripts": {
    "build:contracts": "HOME=$PWD/.foundry-home forge build",
    "deploy:base": "HOME=$PWD/.foundry-home forge script script/Deploy.s.sol:Deploy --rpc-url \"$RPC_URL\" --private-key \"$DEPLOYER_PRIVATE_KEY\" --broadcast",
    "dev": "tsx watch src/read-model/server.ts",
    "start": "tsx src/read-model/server.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "test:contracts": "HOME=$PWD/.foundry-home forge test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "viem": "^2.21.19"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
