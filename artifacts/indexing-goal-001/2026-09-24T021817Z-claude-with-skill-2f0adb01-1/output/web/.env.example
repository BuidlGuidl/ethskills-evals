# --- Read side (subgraph) ---------------------------------------------------
# Server-side only: the URL the app queries for all historical data.
#
# Local graph-node:
#   SUBGRAPH_URL=http://localhost:8000/subgraphs/name/streak
# Subgraph Studio (dev):
#   SUBGRAPH_URL=https://api.studio.thegraph.com/query/<id>/streak/version/latest
# The Graph decentralised network (production) — note the API key is in the URL,
# which is exactly why this variable is NOT prefixed NEXT_PUBLIC_ and is only
# ever read on the server (see src/graphql/client.ts):
#   SUBGRAPH_URL=https://gateway.thegraph.com/api/<API_KEY>/subgraphs/id/<SUBGRAPH_ID>
SUBGRAPH_URL=http://localhost:8000/subgraphs/name/streak

# --- Write side (check-in button) -------------------------------------------
NEXT_PUBLIC_STREAK_ADDRESS=0x0000000000000000000000000000000000000000
# 8453 = Base mainnet, 84532 = Base Sepolia
NEXT_PUBLIC_CHAIN_ID=8453
