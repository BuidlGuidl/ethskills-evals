{
  "name": "streak",
  "private": true,
  "description": "Daily onchain check-ins for a community on Base.",
  "workspaces": ["subgraph", "web"],
  "scripts": {
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test",
    "abi:sync": "node scripts/sync-abi.mjs",
    "subgraph:configure": "node scripts/configure-subgraph.mjs",
    "stack:up": "docker compose up -d",
    "stack:down": "docker compose down -v",
    "seed:local": "./scripts/seed-local.sh",
    "dev": "npm run dev --workspace @streak/web"
  }
}
