# Base mainnet RPC. Use a private/paid endpoint for real size, not a public one.
RPC_URL=https://mainnet.base.org
# Hot key that holds the USDC. Never commit a funded key.
PRIVATE_KEY=0x...
# Clip size, in whole USDC.
AMOUNT_USDC=250000
# Max allowed shortfall vs the quote taken seconds earlier.
SLIPPAGE_BPS=20
# Abort if the full-size quote is worse than this vs the small-probe rate.
MAX_IMPACT_BPS=50
# Quote-only run: verifies everything, sends nothing.
DRY_RUN=true
# Split the clip across the two best pools when it beats the single best route.
ALLOW_SPLIT=true
MIN_SPLIT_GAIN_BPS=3
# Transaction deadline.
DEADLINE_SECONDS=120
# Override the router choice, substring match on the printed route label.
# FORCE_ROUTE=uniswap-v3 fee=3000
# Send the WETH somewhere other than the sender.
# RECIPIENT=0x...
