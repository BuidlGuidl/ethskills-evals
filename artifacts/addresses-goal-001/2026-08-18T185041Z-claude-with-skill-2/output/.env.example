# Required
RPC_URL=https://mainnet.base.org
PRIVATE_KEY=0x...                  # account holding the USDC (see NOTES.md before using a hot key)

# Trade
AMOUNT_USDC=500000                 # human units, 6dp
CLIPS=1                            # split the order into N sequential clips
RECIPIENT=                         # defaults to the signer

# Guards (all bps)
MAX_SLIPPAGE_BPS=30                # minOut = quote * (1 - this)
MAX_IMPACT_BPS=60                  # abort if quoted price impact vs marginal price exceeds this
CROSS_VENUE_TOLERANCE_BPS=10       # abort if a checked alternative venue beats the route by more than this
DEADLINE_SECONDS=120

# Safety
DRY_RUN=true                       # must be explicitly false to broadcast
