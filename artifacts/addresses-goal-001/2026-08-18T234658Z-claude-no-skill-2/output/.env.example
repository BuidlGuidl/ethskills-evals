# Base mainnet RPC. Use a paid/private endpoint — public ones time out on deep
# concentrated-liquidity quotes and rate-limit under a slicing run.
RPC_URL=https://mainnet.base.org

# Signer holding the USDC. See NOTES.md — a raw key is the weakest part of this tool.
PRIVATE_KEY=0x...

# Parent order size in whole USDC.
AMOUNT_USDC=500000

# Where the WETH lands (defaults to the signer).
# RECIPIENT=0x...

# Safety: anything other than "false" keeps the run read-only.
DRY_RUN=true

# Per-leg slippage tolerance against that leg's own fresh quote.
MAX_SLIPPAGE_BPS=30
# Abort if the best route prices this far below the Chainlink ETH/USD mid.
MAX_ORACLE_DEVIATION_BPS=100
# Abort if the Chainlink answer is older than this (feed heartbeat ~20 min).
MAX_ORACLE_AGE_SECONDS=3600

# Child orders and the pause between them.
SLICES=4
SLICE_DELAY_SECONDS=60

# Two-venue split search granularity, and the minimum gain that justifies a 2nd tx.
SPLIT_STEPS=10
SPLIT_MIN_GAIN_BPS=2

# Optional: restrict routing to matching venue labels.
# ONLY_VENUES=UniV3 0.05,Slipstream ts=100

CONFIRMATIONS=1
DEADLINE_SECONDS=180
RPC_TIMEOUT_MS=60000
RECEIPT_TIMEOUT_MS=300000
MIN_GAS_ETH=0.003
