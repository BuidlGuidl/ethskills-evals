PORT=3000

# Where USDC payments settle. Use an address you control.
PAY_TO=0x0000000000000000000000000000000000000000

# Default is Base Sepolia so you can test with faucet USDC.
# Use eip155:8453 for Base mainnet.
X402_NETWORK=eip155:84532
X402_PRICE=$0.02
X402_FACILITATOR_URL=https://x402.org/facilitator

# Base Sepolia explorer API by default. For Base mainnet use:
# https://base.blockscout.com/api/v2
BLOCKSCOUT_API_BASE=https://base-sepolia.blockscout.com/api/v2

# Client-only settings.
AGENT_PRIVATE_KEY=0xreplace_with_your_agent_wallet_private_key
API_URL=http://localhost:3000/v1/wallet-summary
WALLET_ADDRESS=0x0000000000000000000000000000000000000000
