# --- shared ---
# "base-sepolia" (default, free testnet facilitator) or "base" (real money)
CHAIN=base-sepolia

# --- server ---
PORT=4021
# Your wallet. Every settled call transfers USDC here.
PAY_TO_ADDRESS=0xYourReceivingAddress
PRICE=$0.02
# Only needed when CHAIN=base. Get keys at https://portal.cdp.coinbase.com
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# --- client (demo only; a real agent brings its own key) ---
CLIENT_PRIVATE_KEY=0xYourTestWalletPrivateKey
API_URL=http://localhost:4021
