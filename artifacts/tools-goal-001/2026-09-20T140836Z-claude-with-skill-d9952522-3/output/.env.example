# ---- server ----
# Address that receives the payments. Every settled call lands here.
PAY_TO=0x0000000000000000000000000000000000000000

# CAIP-2 network id. eip155:84532 = Base Sepolia, eip155:8453 = Base mainnet.
NETWORK=eip155:84532

# Price per call, as a dollar string. Settles in USDC on the network above.
PRICE=$0.02

PORT=4021

# Mainnet only: the public x402.org facilitator is testnet-only, so Base mainnet
# needs the Coinbase CDP facilitator. Get keys at https://portal.cdp.coinbase.com
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=

# ---- client ----
# Private key of the agent's wallet. Needs USDC on NETWORK to pay; it never
# needs ETH, since the facilitator broadcasts and pays gas.
PRIVATE_KEY=0x
RESOURCE_URL=http://localhost:4021
