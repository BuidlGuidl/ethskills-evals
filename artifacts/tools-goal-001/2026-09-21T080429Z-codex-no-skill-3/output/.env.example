# Server
PORT=3000
PAY_TO_ADDRESS=0xYourReceivingWalletAddress
PRICE_PER_CALL=$0.01

# Use eip155:84532 for Base Sepolia testing, or eip155:8453 for real Base mainnet USDC.
PAYMENT_NETWORK=eip155:84532
FACILITATOR_URL=https://facilitator.openx402.ai

# Wallet activity source. The public Base Blockscout explorer works without a key for light use.
BLOCKSCOUT_BASE_URL=https://base.blockscout.com/api/v2
BLOCKSCOUT_API_KEY=

# Client
API_BASE_URL=http://localhost:3000
AGENT_PRIVATE_KEY=0xYourAgentWalletPrivateKey
MAX_PAYMENT_PER_CALL=$0.05
