# --- which chain the payment settles on -------------------------------------
# base-sepolia (testnet, free public facilitator) or base (mainnet, needs CDP keys)
X402_NETWORK=base-sepolia

# --- server ------------------------------------------------------------------
# EVM address that receives the USDC. This is where your revenue lands.
PAY_TO=0xYourReceivingAddress
PRICE=$0.01
PORT=4021

# Required only when X402_NETWORK=base — https://portal.cdp.coinbase.com
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=

# --- client ------------------------------------------------------------------
# Private key of the agent wallet that pays. Needs USDC on the chosen network.
AGENT_PRIVATE_KEY=0xYourAgentPrivateKey
# API_URL=http://localhost:4021
# RPC_URL=
