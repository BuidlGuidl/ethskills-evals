# --- server ---
# Where every payment lands. Your wallet; funds arrive as USDC, no intermediary balance.
PAY_TO=0xYourReceivingAddress
# base-sepolia (default, free test USDC) or base (real money)
CHAIN=base-sepolia
PRICE=$0.02
PORT=4021

# Required only when CHAIN=base. Base mainnet settles via Coinbase's CDP
# facilitator; get keys at https://portal.cdp.coinbase.com
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# --- client ---
# Key of the paying agent wallet. Needs USDC on CHAIN (and nothing else —
# gas for settlement is paid by the facilitator).
PRIVATE_KEY=0x...
API_URL=http://localhost:4021
MAX_PER_CALL=$0.10
