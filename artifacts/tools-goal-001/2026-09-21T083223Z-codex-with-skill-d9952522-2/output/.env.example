# Server
PORT=3000
PAY_TO_ADDRESS=0xYourReceivingWallet
PAYMENT_PRICE=$0.02

# Use Base Sepolia while testing, then switch to eip155:8453 for Base mainnet.
PAYMENT_NETWORK=eip155:84532

# Coinbase x402 facilitator credentials are used by the server for verify/settle.
# Client callers do not need API keys or accounts with you.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Public facilitator works for Base Sepolia demos. Use Coinbase/CDP creds or
# another facilitator for production networks as needed.
FACILITATOR_URL=https://x402.org/facilitator

# Optional, only if you use a non-Base network and want to override Blockscout.
BLOCKSCOUT_BASE_URL=

# Client
API_BASE_URL=http://localhost:3000
CLIENT_PRIVATE_KEY=0xYourSpendingWalletPrivateKey
