# ---------- shared ----------
# "base-sepolia" (testnet, free facilitator) or "base" (mainnet, real money)
NETWORK=base-sepolia

# ---------- server ----------
# Your address. Every payment lands here as USDC.
ADDRESS_TO_PAY=0xYourReceivingAddress
PORT=4021
PRICE=$0.02

# Optional: your own Base RPC endpoint (defaults to the public one, which is rate limited)
RPC_URL=

# Required only when NETWORK=base. Get them from https://portal.cdp.coinbase.com
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# ---------- client ----------
# The agent's spending wallet. Needs USDC on NETWORK (and nothing else - gas is
# paid by the facilitator, not by the agent).
PRIVATE_KEY=0xYourAgentPrivateKey
API_URL=http://localhost:4021
MAX_PRICE_USDC=0.10
