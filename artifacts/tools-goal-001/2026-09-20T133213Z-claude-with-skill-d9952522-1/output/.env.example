# --- shared ---
# base-sepolia (default, free testnet USDC) or base (real money)
NETWORK=base-sepolia

# --- server ---
# Address that receives the payments. This is where your revenue lands.
PAY_TO=0xYourReceivingAddress
PRICE=$0.01
PORT=4021
# Only needed for NETWORK=base — Coinbase CDP facilitator credentials
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
# Override the testnet facilitator if you run your own
# FACILITATOR_URL=https://x402.org/facilitator

# --- client ---
# Private key of the agent's spending wallet (needs USDC on NETWORK)
CLIENT_PRIVATE_KEY=0x...
# Optional custom RPC
# RPC_URL=
API_URL=http://localhost:4021
