# ---- server ----
# Where your revenue lands. Payments transfer USDC directly to this address.
PAY_TO_ADDRESS=0xYourReceivingAddress

# Price per call, quoted in USD, charged in USDC.
PRICE=$0.01

# base-sepolia (test USDC, free faucet) or base (real money).
NETWORK=base-sepolia

PORT=4021

# Optional but recommended: Etherscan V2 key unlocks recent-transaction detail.
# https://etherscan.io/apis  (one key covers Base via chainid)
ETHERSCAN_API_KEY=

# Required only when NETWORK=base. https://portal.cdp.coinbase.com
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# ---- client (the paying agent) ----
# Funded with USDC on the same network. Test key only in this file.
CLIENT_PRIVATE_KEY=0x...
API_BASE_URL=http://localhost:4021
