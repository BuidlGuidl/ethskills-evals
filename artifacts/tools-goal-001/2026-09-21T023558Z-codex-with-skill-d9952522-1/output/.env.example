PORT=3000

# Receiver of settled x402 payments.
PAY_TO_ADDRESS=0xYourReceivingWallet

# Development default: Base Sepolia. Production Base mainnet is eip155:8453.
X402_NETWORK=eip155:84532
PRICE_USD=$0.02
FACILITATOR_URL=

# Coinbase facilitator verify/settle credentials. Required unless FACILITATOR_URL
# points at a facilitator that does not need these credentials.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Wallet used by the TypeScript client to pay.
CLIENT_PRIVATE_KEY=0xYourAgentWalletPrivateKey
API_BASE_URL=http://localhost:3000

# Optional override. Defaults are selected from X402_NETWORK.
BLOCKSCOUT_BASE_URL=
