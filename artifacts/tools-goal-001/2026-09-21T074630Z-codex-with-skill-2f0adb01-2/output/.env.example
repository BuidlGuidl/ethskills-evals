PORT=3000

# Your seller wallet. Paid calls settle to this address in USDC on X402_NETWORK.
PAY_TO=0xYourSellerWalletAddress
PAYMENT_PRICE=$0.03
X402_NETWORK=eip155:8453
FACILITATOR_URL=https://facilitator.openx402.ai

# Optional override for chain reads used by the x402 client.
BASE_RPC_URL=https://mainnet.base.org

# Client-side only. This wallet pays for calls and must hold USDC on Base.
AGENT_PRIVATE_KEY=0xYourAgentPrivateKey
API_URL=http://localhost:3000/api/wallet-summary
MAX_USD_PER_CALL=0.05
