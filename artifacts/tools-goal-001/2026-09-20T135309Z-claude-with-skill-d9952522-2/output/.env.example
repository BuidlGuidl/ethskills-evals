# --- server ---
# Address that receives the USDC. This is where the money lands.
PAY_TO=0xYourReceivingAddress
# base-sepolia (default, free test facilitator) or base (mainnet, real USDC)
CHAIN=base-sepolia
PRICE=$0.02
PORT=4021

# Mainnet only: Coinbase CDP facilitator credentials (https://portal.cdp.coinbase.com)
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=

# --- client ---
# Funded wallet the agent pays from (needs USDC on CHAIN; no gas needed).
AGENT_PRIVATE_KEY=0x...
SERVER_URL=http://localhost:4021
# Optional custom RPC; defaults to the public endpoint for CHAIN.
# RPC_URL=
