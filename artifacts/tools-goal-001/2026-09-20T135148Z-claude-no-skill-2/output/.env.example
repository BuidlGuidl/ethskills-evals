# ---------- server ----------
# Where the payment settles: "base-sepolia" (testnet) or "base" (mainnet).
NETWORK=base-sepolia

# Your wallet. Every call's USDC lands here, on the network above.
PAY_TO_ADDRESS=0xYourReceivingWalletHere

# Price per call, in USD, charged in USDC.
PRICE=$0.02

PORT=4021

# Mainnet only: x402.org's facilitator is testnet-only, so NETWORK=base needs
# Coinbase CDP credentials. https://portal.cdp.coinbase.com -> API keys
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=

# ---------- wallet-history source (optional but recommended) ----------
# Without one of these the summary is balance / nonce / EOA-vs-contract only.
#
# Preferred: an Alchemy Base URL. Free tier covers Base mainnet, and it doubles
# as the RPC endpoint. https://dashboard.alchemy.com
# BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
#
# Alternative: Etherscan V2. Free tier covers Base Sepolia but NOT Base mainnet
# (mainnet needs a paid plan). https://etherscan.io/myapikey
# ETHERSCAN_API_KEY=

# ---------- client ----------
# The agent's wallet, i.e. the one that pays. Needs USDC on NETWORK; it does
# not need ETH, because x402 uses gasless EIP-3009 transfers.
CLIENT_PRIVATE_KEY=0x...
API_URL=http://localhost:4021

# Most the client will auto-pay per call, in USDC base units (6 decimals).
# 100000 = $0.10. Anything pricier makes the call fail instead of paying.
# MAX_PAYMENT_BASE_UNITS=100000
