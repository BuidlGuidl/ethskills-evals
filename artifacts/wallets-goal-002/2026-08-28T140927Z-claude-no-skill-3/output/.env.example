# ── transport ──────────────────────────────────────────────────────────────
# Reads/simulation. Your own node, or a paid provider with a real SLA.
# A free public RPC will rate-limit you mid-trade and lie about `pending`.
RPC_URL=https://...

# Signed transactions. Private relay so $10-50k swaps are not sandwiched.
SUBMIT_RPC_URL=https://rpc.flashbots.net/fast

# ── signer ─────────────────────────────────────────────────────────────────
# Development only. For production use KMS — see DEPLOY.md §2.
HOT_KEY_PRIVATE_KEY=0x...

# ── risk limits (defaults shown; all are enforced before signing) ──────────
MAX_TRADE_NOTIONAL_USD=60000
MAX_DAILY_NOTIONAL_USD=250000
MAX_TRADES_PER_DAY=12
MIN_TRADE_NOTIONAL_USD=2000

MAX_POOL_ORACLE_DEVIATION_BPS=100
MAX_SLIPPAGE_BPS=30
ORACLE_FLOOR_BAND_BPS=90
MAX_ORACLE_AGE_SEC=4200

MAX_BASE_FEE_GWEI=80
PRIORITY_FEE_GWEI=2
MIN_ETH_BALANCE=0.15

MAX_PLAN_AGE_SEC=45
MAX_PLAN_DRIFT_BPS=25
DEADLINE_SEC=240
INCLUSION_TIMEOUT_SEC=300
CONFIRMATIONS=3

SLIPPAGE_WINDOW_TRADES=10
MAX_AVG_SLIPPAGE_BPS=60

# ── state (must be on a persistent volume, not ephemeral disk) ─────────────
JOURNAL_PATH=./state/journal.jsonl
HALT_FILE=./state/HALT
LOCK_FILE=./state/rebalance.lock
