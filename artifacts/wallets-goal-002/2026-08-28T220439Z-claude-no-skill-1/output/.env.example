# ---- Custody ---------------------------------------------------------------
EXECUTION_MODE=roles              # 'roles' (Safe + Zodiac) or 'eoa' (degraded)
SAFE_ADDRESS=
ROLES_MODIFIER=
ROLE_KEY=

# ---- Keys ------------------------------------------------------------------
# Inject from a secrets manager at process start. Do NOT commit a real .env.
AGENT_PRIVATE_KEY=

# ---- RPC -------------------------------------------------------------------
RPC_PRIMARY=                      # paid, dedicated
RPC_SECONDARY=                    # different company; used to cross-check
RPC_SUBMIT=https://rpc.flashbots.net/fast   # private relay; never a public RPC

# ---- Risk limits -----------------------------------------------------------
REBALANCE_BAND_BPS=300
MIN_TRADE_USD=10000
MAX_TRADE_USD=50000
MAX_DAILY_NOTIONAL_USD=200000     # mirror as an on-chain Roles allowance
MIN_SECONDS_BETWEEN_TRADES=900
SLIPPAGE_BPS=30
MAX_ORACLE_DIVERGENCE_BPS=100
MAX_BASE_FEE_GWEI=25
INCLUSION_DEADLINE_BLOCKS=25

# ---- Ops -------------------------------------------------------------------
STATE_DIR=./state
DRY_RUN=true                      # flip to false only after the §4 ramp
TARGET_WETH_BPS=5000              # replace getSignal() with your strategy
