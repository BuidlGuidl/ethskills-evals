# ── Chain access ──────────────────────────────────────────────
# Reads: a paid provider (Alchemy / Infura / QuickNode). Not a free public endpoint.
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# Writes: private, MEV-protected, revert-protected. Never the public mempool.
SEND_RPC_URL=https://rpc.flashbots.net/fast
# alternative: https://rpc.mevblocker.io

# ── Accounts / contracts (from your setup; see DEPLOY.md) ─────
SAFE_ADDRESS=0x...
ROLES_MODIFIER_ADDRESS=0x...
ROLE_KEY=treasury-rebalancer

# ── Signer ────────────────────────────────────────────────────
SIGNER=kms
KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/...
AWS_REGION=us-east-1
# (credentials come from the VM's instance role, NOT from this file)

# ── State + alerting ─────────────────────────────────────────
STATE_DIR=/var/lib/rebalancer
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...   # non-urgent
PAGE_WEBHOOK_URL=https://...                              # wakes you up (PagerDuty/Opsgenie/ntfy)

# ── Off-chain policy (on-chain Roles allowance is the hard backstop) ──
MAX_TRADE_USD=55000
MAX_DAILY_USD=150000
MAX_TRADES_PER_DAY=12
SLIPPAGE_BPS=30
MAX_ORACLE_DEVIATION_BPS=100
USDC_DEPEG_BPS=100
DEADLINE_SECONDS=180
MAX_BASE_FEE_GWEI=60
MAX_PRIORITY_FEE_GWEI=2
MIN_AGENT_ETH=0.05
